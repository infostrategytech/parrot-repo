<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ParrotWebBin Condition="'$(ParrotWebBin)' == ''">../../Parrot.Web/Parrot.Web/bin/Debug/net10.0/</ParrotWebBin>
  </PropertyGroup>
  <!-- Tests exercise the built frontend with controlled stores, never a local demo provider or real account. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Parrot.Web"><HintPath>$(ParrotWebBin)Parrot.Web.dll</HintPath></Reference>
    <Reference Include="Parrot.SharedComponents"><HintPath>$(ParrotWebBin)Parrot.SharedComponents.dll</HintPath></Reference>
  </ItemGroup>
</Project>
