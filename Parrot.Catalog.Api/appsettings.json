{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "ApplyMigrations": false,
    "ConnectionStrings": {
      "Migrator": "",
      "Writer": "",
      "Reader": "",
      "Relay": ""
    },
    "Cache": {
      "Provider": "Memory",
      "RedisConnectionString": "",
      "TtlSeconds": 300,
      "KeyPrefix": "catalog"
    },
    "Relay": {
      "InProcess": false,
      "Bus": "Kafka",
      "BootstrapServers": "localhost:9092",
      "Topic": "catalog.events",
      "ConsumerGroupId": "catalog-cache-invalidator",
      "PollIntervalMs": 1000,
      "BatchSize": 100,
      "RetentionDays": 7
    },
    "Auth": {
      "Mode": "Symmetric"
    },
    "RateLimits": {
      "ReadPerMinute": 600,
      "SearchPerMinute": 120,
      "WritePerMinute": 300,
      "AiPerMinute": 60,
      "TenantPerMinute": 3000
    }
  },
  "JwtSettings": {
    "Issuer": "ParrotApi",
    "Audience": "ParrotApp"
  },
  "OpenTelemetry": {
    "Endpoint": ""
  }
}
