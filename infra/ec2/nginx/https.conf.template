# Rendered by the nginx image when the container starts: ${APP_DOMAIN},
# ${API_DOMAIN} and ${GRPC_DOMAIN} come from its environment (.env).

# Docker's own DNS, asked again every 10 seconds. Each upstream below is held
# in a variable, which makes nginx look the container up when it proxies
# instead of once at start, so a recreated container is found at its new
# address without a reload.
resolver 127.0.0.11 valid=10s ipv6=off;

# Blazor's circuit and the messaging hub are WebSockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

http2 on;

ssl_certificate     /etc/letsencrypt/live/parrot/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/parrot/privkey.pem;

server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${APP_DOMAIN};

    location / {
        set $web http://parrot-web:8080;
        proxy_pass $web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    server_name ${API_DOMAIN};

    # Image uploads are capped at 5 MB by the API; nginx's own default is 1 MB.
    client_max_body_size 10m;

    # Uploaded images, read straight from the bucket in the minio container.
    location /media/ {
        set $minio http://minio:9000;
        rewrite ^/media/(.*)$ /parrot/$1 break;
        proxy_pass $minio;
        limit_except GET { deny all; }
    }

    # Prometheus scrapes parrot-api:8080/metrics on the internal network; never publicly.
    # Case-insensitive, with any trailing path: ASP.NET serves /Metrics and /metrics/ too.
    location ~* ^/metrics(/|$) { return 404; }

    location / {
        set $api http://parrot-api:8080;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    server_name ${GRPC_DOMAIN};

    location / {
        set $grpc grpc://parrot-grpc:8080;
        grpc_pass $grpc;
    }
}
