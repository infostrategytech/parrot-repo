@namespace Parrot.SharedComponents.Layout
@using Parrot.SharedComponents.Services
@implements IAsyncDisposable
@inject AppShellState Shell
@inject AuroraInterop Interop

@* The shell every product page renders inside: the rail, then everything
   else. It is Aurora's MainLayout with the host's session passed in, so the
   web app and the mobile app render one shell and each supplies who is signed
   in. The rail is rendered once here, and a page receives nothing. *@

<div class="app-shell @(Shell.Collapsed ? "is-collapsed" : null) @(UsePageBackground ? "app-shell--page-background" : null)">
    <NavSidebar BrandName="@BrandName"
                WorkspaceId="@WorkspaceId"
                WorkspaceName="@WorkspaceName"
                WorkspacePlan="@WorkspacePlan"
                WorkspaceLogoUrl="@WorkspaceLogoUrl"
                Workspaces="@Workspaces"
                OnWorkspaceSwitch="@OnWorkspaceSwitch"
                OnWorkspaceAdd="@OnWorkspaceAdd"
                WorkspaceSwitching="@WorkspaceSwitching"
                OnWorkspaceSetDefault="@OnWorkspaceSetDefault"
                BusinessMenu="@BusinessMenu"
                UserName="@UserName"
                UserRole="@UserRole"
                UserInitials="@UserInitials"
                UserSeed="@UserSeed"
                UserImageUrl="@UserImageUrl"
                InboxUnread="@InboxUnread"
                IsAllowed="@IsAllowed"
                TasksNeedYou="@TasksNeedYou"
                UserMenu="@UserMenu"
                RailNotifications="@RailNotifications" />

    @if (!Shell.Collapsed)
    {
        @* Expanding the compact rail is temporary and must not resize the page.
           This transparent layer dismisses it when the page is clicked. It is
           for the pointer only: out of the tab order and hidden from screen
           readers, which close the rail with Esc or its Collapse button. *@
        <button type="button"
                class="app-shell__nav-dismiss"
                tabindex="-1"
                aria-hidden="true"
                @onclick="Shell.Collapse"></button>
    }

    <main class="app-main">
        @ChildContent
    </main>

    <ToastHost />
    @if (ShowThemeToggle) { <ThemeToggle /> }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The floating light and dark switch. Off where the theme is a setting (web: Settings, Preferences).</summary>
    [Parameter] public bool ShowThemeToggle { get; set; } = true;

    /// <summary>Use the semantic page canvas. Opted into by web; the mobile host keeps its existing canvas until reviewed.</summary>
    [Parameter] public bool UsePageBackground { get; set; }

    [Parameter] public string BrandName { get; set; } = "yára";
    [Parameter] public string WorkspaceId { get; set; } = "";
    [Parameter] public string WorkspaceName { get; set; } = "";
    [Parameter] public string? WorkspacePlan { get; set; }
    [Parameter] public string? WorkspaceLogoUrl { get; set; }
    [Parameter] public IReadOnlyList<WorkspaceOption>? Workspaces { get; set; }
    [Parameter] public EventCallback<string> OnWorkspaceSwitch { get; set; }
    [Parameter] public EventCallback OnWorkspaceAdd { get; set; }
    [Parameter] public bool WorkspaceSwitching { get; set; }
    [Parameter] public EventCallback<string?> OnWorkspaceSetDefault { get; set; }
    /// <summary>Optional. Whether the person may open a rail entry; see NavEntry.AnyPermission.</summary>
    [Parameter] public Func<NavEntry, bool>? IsAllowed { get; set; }

    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string? UserRole { get; set; }
    [Parameter] public string UserInitials { get; set; } = "";
    [Parameter] public string UserSeed { get; set; } = "";
    [Parameter] public string? UserImageUrl { get; set; }
    [Parameter] public RenderFragment? UserMenu { get; set; }
    /// <summary>The host's notifications row (the web app's bell), drawn in the rail under Inbox.</summary>
    [Parameter] public RenderFragment? RailNotifications { get; set; }

    /// <summary>Rows about the business you're in, at the top of the workspace menu. Null shows none.</summary>
    [Parameter] public RenderFragment? BusinessMenu { get; set; }
    [Parameter] public int? InboxUnread { get; set; }
    [Parameter] public int? TasksNeedYou { get; set; }

    private DotNetObjectReference<AppShellState>? _shellRef;
    private IAsyncDisposable? _mediaSubscription;

    protected override void OnInitialized() => Shell.Changed += OnShellChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The rail collapses itself on a narrow window. A media query fires
        // twice in the life of the app; a resize listener would fire on every
        // pixel, which is what makes resize handlers feel expensive.
        _shellRef = DotNetObjectReference.Create(Shell);
        _mediaSubscription = await Interop.ObserveMediaAsync(
            AppShellState.NarrowQuery, _shellRef, nameof(AppShellState.SetViewportNarrow));
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Shell.Changed -= OnShellChanged;
        if (_mediaSubscription is not null) await _mediaSubscription.DisposeAsync();
        _shellRef?.Dispose();
    }
}
