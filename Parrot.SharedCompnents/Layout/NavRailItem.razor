@namespace Parrot.SharedComponents.Layout

@* One row of the rail. Was a RenderFragment built by hand inside NavSidebar,
   which is a component written the hard way — so it is a component. *@

@* A real link, so a page opens in a new tab the way it does on any site
   (Ctrl or Cmd and click, the middle button, the right-click menu) and the
   address shows on hover; a plain click is routed in place. A place with no
   page yet stays a disabled button. *@
@if (OnClick.HasDelegate)
{
    @* Opens something in place, such as notifications, rather than going to a page. *@
    <button type="button" class="@ClassName" aria-label="@Tooltip" aria-current="@(CurrentPage ? "page" : null)" aria-expanded="@((Expanded ?? IsActive) ? "true" : "false")" aria-haspopup="dialog" @onclick="OnClick" @ref="_button">@Content</button>
}
else if (IsPlaceholder)
{
    <button type="button" class="@ClassName" aria-label="@Tooltip" disabled aria-disabled="true">@Content</button>
}
else
{
    <a href="@Entry.Path" class="@ClassName" aria-label="@Tooltip" aria-current="@(IsActive ? "page" : null)">@Content</a>
}

@code {
    private RenderFragment Content => __builder =>
    {
        @* The icon's own pill: on the compact rail, hover and the current page light this, not the whole row. *@
        <span class="nav-item__glyph"><Icon Name="Entry.Glyph" Size="IconSize.Sm" /></span>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose Class="nav-item__label">
            @Entry.Label
        </Typography>
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="nav-item__compact-label">
            @(Entry.CompactLabel ?? Entry.Label)
        </Typography>
        if (Badge is > 0)
        {
            <Typography TextStyle="TextStyle.Small10Semibold"
                        As="em"
                        Class="@(AlertBadge ? "nav-item__count is-alert" : "nav-item__count")"
                        aria-label="@($"{Badge} {BadgeMeaning}")">
                @Badge
            </Typography>
        }
    };

    [Parameter, EditorRequired] public NavEntry Entry { get; set; } = default!;

    [Parameter] public bool IsActive { get; set; }

    /// <summary>A popup trigger may also represent the page being viewed. Keep that separate from whether its popup is open.</summary>
    [Parameter] public bool CurrentPage { get; set; }
    [Parameter] public bool? Expanded { get; set; }

    /// <summary>The inbox's unread messages, or the tasks that need you. Null hides it entirely.</summary>
    [Parameter] public int? Badge { get; set; }

    /// <summary>What the count is of, read out and shown on hover ("unread messages", "need you").</summary>
    [Parameter] public string BadgeMeaning { get; set; } = "unread messages";

    /// <summary>The count (or, on the compact rail, the dot) in alert red rather than the brand colour. Keep it rare:
    /// notifications sets it only while something that needs you is unread.</summary>
    [Parameter] public bool AlertBadge { get; set; }

    /// <summary>Compact rows for the footer group.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>A row that opens something in place (notifications). Expanded describes its popup; IsActive controls its visual highlight.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private bool IsPlaceholder => Entry.Path is null && !OnClick.HasDelegate;

    private ElementReference _button;

    /// <summary>Focus back on a row that opened something in place, when that closes.</summary>
    public ValueTask FocusAsync() => _button.Context is null ? ValueTask.CompletedTask : _button.FocusAsync();

    // What a screen reader says: the full name (the rail shows a short one) and what its count is of.
    private string Tooltip => IsPlaceholder
        ? Entry.Label + " — not in this demo"
        : Badge is > 0 ? $"{Entry.Label} · {Badge} {BadgeMeaning}" : Entry.Label;

    private string ClassName
    {
        get
        {
            var name = "nav-item";
            if (IsActive) name += " is-active";
            if (IsPlaceholder) name += " is-placeholder";
            if (Compact) name += " is-compact";
            return name;
        }
    }
}
