@namespace Parrot.SharedComponents.Layout

@* Which workspace you are working in. Its own component rather than forty lines
   inside the rail, because it owns state — an open menu — and the rail does
   not need to know about it.

   The host passes the workspaces it can switch between and is told which one
   was picked; switching itself is the host's business. A host that passes no
   list gets the current workspace alone, and no add button without OnAdd.

   One login reaches every business the person works in: their own workspaces
   come first, then each other business under its own heading, and every
   workspace is tagged with how they work there (Owner, or their role). *@

<div class="workspace">
    <button type="button"
            class="workspace__trigger"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            aria-haspopup="menu"
            data-tooltip="@Name"
            @onclick="() => _open = !_open">
        <PetalAvatar Seed="@Seed" Initials="@InitialsOrDefault" ImageUrl="@LogoUrl" />
        <span class="workspace__identity">
            <Typography TextStyle="TextStyle.Small10Medium" As="small" Class="workspace__eyebrow">Workspace</Typography>
            <Typography TextStyle="TextStyle.Small12Semibold" As="span" Prose Class="workspace__name">@Name</Typography>
        </span>
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="workspace__compact-label">Workspace</Typography>
        <span class="workspace__chevron"><Icon Name="IconName.RiArrowDownSLine" Size="IconSize.Sm" /></span>
    </button>

    @if (_open)
    {
        @* Same dismissal as FilterPopover: a transparent full-screen button,
           not a document listener that can outlive the component. *@
        <button type="button"
                class="workspace__dismiss"
                tabindex="-1"
                aria-hidden="true"
                @onclick="() => _open = false"></button>

        <div class="workspace__menu" role="menu" @onkeydown="OnKeyDown">
            @foreach (var group in Options.GroupBy(o => o.Group))
            {
            <Typography TextStyle="TextStyle.Small10Semibold" As="p" Class="workspace__menu-label ds-overline">
                @(group.Key ?? "Your workspaces")
            </Typography>

            @foreach (var option in group)
            {
                bool current = option.Id == Id;
                @* The row holds two buttons side by side (a button cannot hold another):
                   switch to it, and pin it as the workspace sign-in always opens. *@
                <div class="workspace__row">
                <button type="button"
                        role="menuitemradio"
                        aria-checked="@current.ToString().ToLowerInvariant()"
                        class="workspace__option @(current ? "is-active" : null)"
                        disabled="@(Switching && !current)"
                        @onclick="() => SelectAsync(option)">
                    <PetalAvatar Seed="@option.Id" Initials="@DesignSystem.Initials.From(option.Name)" ImageUrl="@option.LogoUrl" />
                    <span class="workspace__identity">
                        <Typography TextStyle="TextStyle.Small12Medium" As="strong">@option.Name</Typography>
                        @if (!string.IsNullOrWhiteSpace(option.Tag))
                        {
                            <Typography TextStyle="TextStyle.Small10Medium" As="small" Class="@($"workspace__tag {(option.Tag == "Owner" ? "is-owner" : null)}")">@option.Tag</Typography>
                        }
                        @if (current && !string.IsNullOrWhiteSpace(Plan))
                        {
                            <Typography TextStyle="TextStyle.Small10Regular" As="small" Class="workspace__eyebrow">@Plan</Typography>
                        }
                    </span>
                    @if (option.IsDefault)
                    {
                        <Typography TextStyle="TextStyle.Small10Medium" As="small" Class="workspace__default">Default</Typography>
                    }
                    @if (current)
                    {
                        <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                    }
                </button>
                @if (OnSetDefault.HasDelegate)
                {
                    <button type="button"
                            class="workspace__pin @(option.IsDefault ? "is-default" : null)"
                            aria-pressed="@option.IsDefault.ToString().ToLowerInvariant()"
                            aria-label="@(option.IsDefault ? $"Stop always opening {option.Name}; resume where you left off" : $"Always open {option.Name} when you sign in")"
                            title="@(option.IsDefault ? "Default on sign-in. Click to resume where you left off instead." : "Open this when you sign in")"
                            disabled="@Switching"
                            @onclick="() => SetDefaultAsync(option)">
                        <Icon Name="IconName.RiPushpin2Fill" Size="IconSize.Sm" />
                    </button>
                }
                </div>
            }
            }

            @if (OnAdd.HasDelegate)
            {
                <button type="button" class="workspace__add" role="menuitem" disabled="@Switching" @onclick="AddAsync">
                    <Icon Name="IconName.RiAddFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">Create workspace</Typography>
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>A stable id for the current workspace — never its display name.</summary>
    [Parameter] public string Id { get; set; } = "";

    [Parameter] public string Name { get; set; } = "";

    /// <summary>Optional. Omitted when the host has nothing true to say here.</summary>
    [Parameter] public string? Plan { get; set; }

    [Parameter] public string? Initials { get; set; }

    /// <summary>Optional. The business logo, shown in place of the initials.</summary>
    [Parameter] public string? LogoUrl { get; set; }

    /// <summary>Optional. Every workspace to offer, the current one among them.</summary>
    [Parameter] public IReadOnlyList<WorkspaceOption>? Workspaces { get; set; }

    /// <summary>Raised with the id of another workspace the person picked.</summary>
    [Parameter] public EventCallback<string> OnSwitch { get; set; }

    /// <summary>Raised by "Create workspace". Without it the button is not shown.</summary>
    [Parameter] public EventCallback OnAdd { get; set; }

    /// <summary>
    /// Raised to pin a workspace as the one sign-in always opens, with its id,
    /// or with null to unpin and resume where the person left off. Without it
    /// no pin is shown.
    /// </summary>
    [Parameter] public EventCallback<string?> OnSetDefault { get; set; }

    /// <summary>True while the host is switching; the other options are disabled meanwhile.</summary>
    [Parameter] public bool Switching { get; set; }

    private bool _open;

    private string Seed => string.IsNullOrWhiteSpace(Id) ? "workspace" : Id;

    private string InitialsOrDefault => Initials ?? DesignSystem.Initials.From(Name);

    // The list the host gave, or the current workspace alone when it gave none.
    private IReadOnlyList<WorkspaceOption> Options =>
        Workspaces is { Count: > 0 } list ? list : [new WorkspaceOption(Id, Name, LogoUrl)];

    private async Task SelectAsync(WorkspaceOption option)
    {
        _open = false;
        if (option.Id != Id && OnSwitch.HasDelegate) await OnSwitch.InvokeAsync(option.Id);
    }

    private async Task SetDefaultAsync(WorkspaceOption option) =>
        await OnSetDefault.InvokeAsync(option.IsDefault ? null : option.Id);

    private async Task AddAsync()
    {
        _open = false;
        await OnAdd.InvokeAsync();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _open = false;
    }
}
