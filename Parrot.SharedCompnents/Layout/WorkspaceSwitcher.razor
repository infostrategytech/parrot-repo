@namespace Parrot.SharedComponents.Layout

@* Which workspace you are working in. Its own component rather than forty lines
   inside the rail, because it owns state — an open menu — and the rail does
   not need to know about it.

   The host passes the workspaces it can switch between and is told which one
   was picked; switching itself is the host's business. A host that passes no
   list gets the current workspace alone, and no add button without OnAdd.

   One login reaches every business the person works in (designer, 9 November 2026): their own workspaces first,
   untagged (every one of them is theirs, so "Owner" on each says nothing), then the workspaces other businesses gave
   them, each with their role there and, where the names differ, the business. The menu is the app's dropdown: rows
   as PopoverOption's (a mark, a name, the tick on the one you're in, no fill), the panel as FilterPopover's. Where
   sign-in lands is said in words: a row "Opens on sign-in", and a last row to make it the one you're in. *@

<div class="workspace">
    <button type="button"
            class="workspace__trigger"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            aria-haspopup="menu"
            aria-label="@($"Workspace: {Name}")"
            @onclick="() => _open = !_open">
        <PetalAvatar Seed="@Seed" Initials="@InitialsOrDefault" ImageUrl="@LogoUrl" />
        <span class="workspace__identity">
            <Typography TextStyle="TextStyle.Small10Medium" As="small" Class="workspace__eyebrow">Workspace</Typography>
            <Typography TextStyle="TextStyle.Small12Semibold" As="span" Prose Class="workspace__name">@Name</Typography>
        </span>
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="workspace__compact-label">Workspace</Typography>
        <span class="workspace__chevron"><Icon Name="IconName.RiArrowDownSLine" Size="IconSize.Sm" /></span>
    </button>

    @if (_open)
    {
        @* Same dismissal as FilterPopover: a transparent full-screen button,
           not a document listener that can outlive the component. *@
        <button type="button"
                class="workspace__dismiss"
                tabindex="-1"
                aria-hidden="true"
                @onclick="() => _open = false"></button>

        <div class="workspace__menu" role="menu" aria-label="Workspaces" @onkeydown="OnKeyDown">
            @* The business you're in, first (designer, 11 November 2026): its settings, its team and inviting
               people, where you look when the question is about the business. Rows are the host's, as the account
               menu's are; picking one closes the menu. *@
            @if (BusinessMenu is not null)
            {
                <div class="workspace__business" @onclick="() => _open = false">
                    @BusinessMenu
                </div>
            }
            @* A team member with no business of their own (they joined from an invite) sees one list, "Workspaces":
               the ones they were given, each with their role. *@
            @if (Mine.Count == 0)
            {
                @Section(Theirs, "Workspaces")
            }
            else
            {
                @Section(Mine, Theirs.Count > 0 ? "Your workspaces" : "Workspaces")
                @if (Theirs.Count > 0)
                {
                    @Section(Theirs, "Other businesses")
                }
            }

            @if (ShowDefault || OnAdd.HasDelegate)
            {
                <div class="workspace__actions">
                    @if (ShowDefault)
                    {
                        @* Where sign-in lands, for the workspace you're in: on, it always opens here; off, you come back
                           where you left off. *@
                        <button type="button" role="menuitemcheckbox" class="workspace__action"
                                aria-checked="@CurrentIsDefault.ToString().ToLowerInvariant()" disabled="@Switching"
                                @onclick="ToggleDefaultAsync">
                            <Icon Name="IconName.RiPushpin2Fill" Size="IconSize.Sm" />
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="workspace__action-label">Open this workspace on sign-in</Typography>
                            @if (CurrentIsDefault)
                            {
                                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" Class="workspace__check" />
                            }
                        </button>
                    }
                    @if (OnAdd.HasDelegate)
                    {
                        <button type="button" role="menuitem" class="workspace__action" disabled="@Switching" @onclick="AddAsync">
                            <Icon Name="IconName.RiAddFill" Size="IconSize.Sm" />
                            @* For someone with none of their own, adding one starts their own business: say so. *@
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="workspace__action-label">@(Mine.Count == 0 ? "Create your own workspace" : "Add workspace")</Typography>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>A stable id for the current workspace — never its display name.</summary>
    [Parameter] public string Id { get; set; } = "";

    [Parameter] public string Name { get; set; } = "";

    /// <summary>Optional. Omitted when the host has nothing true to say here.</summary>
    [Parameter] public string? Plan { get; set; }

    [Parameter] public string? Initials { get; set; }

    /// <summary>Optional. The business logo, shown in place of the initials.</summary>
    [Parameter] public string? LogoUrl { get; set; }

    /// <summary>Optional. Every workspace to offer, the current one among them.</summary>
    [Parameter] public IReadOnlyList<WorkspaceOption>? Workspaces { get; set; }

    /// <summary>Raised with the id of another workspace the person picked.</summary>
    [Parameter] public EventCallback<string> OnSwitch { get; set; }

    /// <summary>Raised by "Add workspace". Without it the row is not shown.</summary>
    [Parameter] public EventCallback OnAdd { get; set; }

    /// <summary>
    /// Raised to make a workspace the one sign-in always opens, with its id,
    /// or with null to resume where the person left off. Without it the
    /// sign-in row is not shown.
    /// </summary>
    [Parameter] public EventCallback<string?> OnSetDefault { get; set; }

    /// <summary>True while the host is switching; the other options are disabled meanwhile.</summary>
    [Parameter] public bool Switching { get; set; }

    /// <summary>Rows about the business you're in (its settings, team, invites), above the workspaces. Null shows none.</summary>
    [Parameter] public RenderFragment? BusinessMenu { get; set; }

    private bool _open;

    private string Seed => string.IsNullOrWhiteSpace(Id) ? "workspace" : Id;

    private string InitialsOrDefault => Initials ?? DesignSystem.Initials.From(Name);

    // The list the host gave, or the current workspace alone when it gave none.
    private IReadOnlyList<WorkspaceOption> Options =>
        Workspaces is { Count: > 0 } list ? list : [new WorkspaceOption(Id, Name, LogoUrl)];

    private IReadOnlyList<WorkspaceOption> Mine => [.. Options.Where(o => o.Group is null)];
    private IReadOnlyList<WorkspaceOption> Theirs => [.. Options.Where(o => o.Group is not null)];

    private bool CurrentIsDefault => Options.Any(o => o.Id == Id && o.IsDefault);

    // Choosing where sign-in lands only means something with somewhere else to land.
    private bool ShowDefault => OnSetDefault.HasDelegate && Options.Count > 1;

    // A row's second line: your role in another business's workspace (and the business, when its name differs), the
    // plan of the one you're in, and whether sign-in opens it (said on the row itself only when it isn't this one:
    // for this one, the last row says it).
    private string? Detail(WorkspaceOption option)
    {
        var parts = new List<string>();
        if (option.Group is not null)
        {
            if (!string.IsNullOrWhiteSpace(option.Tag)) parts.Add(option.Tag);
            if (!string.Equals(option.Group, option.Name, StringComparison.OrdinalIgnoreCase)) parts.Add(option.Group);
        }
        if (option.Id == Id && !string.IsNullOrWhiteSpace(Plan)) parts.Add(Plan);
        if (option.IsDefault && option.Id != Id) parts.Add("Opens on sign-in");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private RenderFragment Section(IReadOnlyList<WorkspaceOption> options, string label) => __builder =>
    {
        <div class="workspace__section" role="group" aria-label="@label">
            <Typography TextStyle="TextStyle.Small10Semibold" As="p" Class="workspace__menu-label ds-overline">@label</Typography>
            @foreach (var option in options)
            {
                bool current = option.Id == Id;
                string? detail = Detail(option);
                <button type="button"
                        role="menuitemradio"
                        aria-checked="@current.ToString().ToLowerInvariant()"
                        class="workspace__option @(current ? "is-active" : null)"
                        disabled="@(Switching && !current)"
                        @onclick="() => SelectAsync(option)">
                    <PetalAvatar Seed="@option.Id" Initials="@DesignSystem.Initials.From(option.Name)" ImageUrl="@option.LogoUrl" Size="AvatarSize.Sm" />
                    <span class="workspace__identity">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong" Prose Class="workspace__option-name">@option.Name</Typography>
                        @if (detail is not null)
                        {
                            <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose Class="workspace__detail">@detail</Typography>
                        }
                    </span>
                    @if (current)
                    {
                        @* aria-checked already says which one you're in, so the tick is decorative. *@
                        <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" Class="workspace__check" />
                    }
                </button>
            }
        </div>
    };

    private async Task SelectAsync(WorkspaceOption option)
    {
        _open = false;
        if (option.Id != Id && OnSwitch.HasDelegate) await OnSwitch.InvokeAsync(option.Id);
    }

    private async Task ToggleDefaultAsync()
    {
        _open = false;
        await OnSetDefault.InvokeAsync(CurrentIsDefault ? null : Id);
    }

    private async Task AddAsync()
    {
        _open = false;
        await OnAdd.InvokeAsync();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _open = false;
    }
}
