@namespace Parrot.SharedComponents.Layout
@using Parrot.SharedComponents.Services
@implements IDisposable
@inject NavigationManager Nav
@inject AppShellState Shell
@inject AuroraInterop Interop

@* Composition only. Every row, the workspace switcher and the account card are
   components of their own; this decides what goes where and nothing else.

   Who is signed in and which business they are in arrive as parameters: the
   rail is shared by the web app and the mobile app, and only the host knows
   where its session lives. *@

@* Opened over the page, the rail takes the focus, so Esc closes it straight
   away and Tab moves through it. *@
<aside class="@(Shell.Collapsed ? "sidebar is-collapsed" : "sidebar")"
       tabindex="-1"
       @ref="_rail"
       @onkeydown="OnKeyDown">
    <div class="sidebar__brand">
        @if (Shell.Collapsed)
        {
            @* Compact: the logo is the way to open the full rail. *@
            <button type="button"
                    class="sidebar__brand-toggle"
                    aria-label="Expand sidebar"
                    @onclick="Shell.Toggle">
                <span class="sidebar__mark" aria-hidden="true"><CadenceMark Size="26" Tight /></span>
                <span class="sidebar__brand-toggle-icon" aria-hidden="true">
                    <Icon Name="IconName.RiMenuUnfoldFill" Size="IconSize.Sm" />
                </span>
            </button>
        }
        else
        {
            @* Open: the logo and name, with Collapse in plain sight. *@
            <span class="sidebar__mark" aria-hidden="true"><CadenceMark Size="26" Tight /></span>
            <Typography TextStyle="TextStyle.HeadingH4Semibold" As="span" Class="sidebar__wordmark cadence-wordmark">
                @BrandName
            </Typography>
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="sidebar__collapse"
                    aria-label="Collapse sidebar" title="Collapse sidebar (Esc)" @onclick="Shell.Collapse">
                <IconLeft><Icon Name="IconName.RiMenuFoldFill" /></IconLeft>
            </Button>
        }
    </div>

    @* A host with no session (the mobile app today) renders the rail without
       a workspace or an account card rather than with invented ones. *@
    @if (!string.IsNullOrWhiteSpace(WorkspaceName))
    {
        <WorkspaceSwitcher Id="@WorkspaceId" Name="@WorkspaceName" Plan="@WorkspacePlan" LogoUrl="@WorkspaceLogoUrl"
                           Workspaces="@Workspaces" OnSwitch="@OnWorkspaceSwitch" OnAdd="@OnWorkspaceAdd"
                           Switching="@WorkspaceSwitching" />
    }

    <nav class="sidebar__nav" aria-label="Primary navigation">
        <Typography TextStyle="TextStyle.Small10Semibold" As="p" Class="sidebar__group-label ds-overline">
            Workspace
        </Typography>

        @foreach (var entry in NavMap.Primary)
        {
            <NavRailItem Entry="entry"
                         IsActive="@(Current?.Label == entry.Label)"
                         Badge="@(entry.Label == "Inbox" ? InboxUnread : null)"
                         BadgeMeaning="unread messages" />
        }

        @* Knowledge, Help and Settings follow the pages in the same list and
           scroll with them; only the account stays at the foot. *@
        <div class="sidebar__divider" role="presentation"></div>
        @foreach (var entry in NavMap.Footer)
        {
            <NavRailItem Entry="entry" IsActive="@(Current?.Label == entry.Label)" Compact />
        }
    </nav>

    <div class="sidebar__footer">
        @if (!string.IsNullOrWhiteSpace(UserName))
        {
            <UserCard Name="@UserName" Role="@UserRole" Initials="@UserInitials" Seed="@UserSeed" ImageUrl="@UserImageUrl">
                @UserMenu
            </UserCard>
        }
    </div>
</aside>

@code {
    /// <summary>The wordmark beside the mark.</summary>
    [Parameter] public string BrandName { get; set; } = "OmniAI";

    /// <summary>A stable id for the business, so its avatar keeps one tint.</summary>
    [Parameter] public string WorkspaceId { get; set; } = "";

    [Parameter] public string WorkspaceName { get; set; } = "";

    /// <summary>Optional second line under the workspace name. Null hides it.</summary>
    [Parameter] public string? WorkspacePlan { get; set; }

    [Parameter] public string? WorkspaceLogoUrl { get; set; }

    /// <summary>Optional. The workspaces the switcher offers; see <see cref="WorkspaceSwitcher"/>.</summary>
    [Parameter] public IReadOnlyList<WorkspaceOption>? Workspaces { get; set; }

    [Parameter] public EventCallback<string> OnWorkspaceSwitch { get; set; }

    [Parameter] public EventCallback OnWorkspaceAdd { get; set; }

    [Parameter] public bool WorkspaceSwitching { get; set; }

    [Parameter] public string UserName { get; set; } = "";

    /// <summary>Optional second line under the person's name. Null hides it.</summary>
    [Parameter] public string? UserRole { get; set; }

    [Parameter] public string UserInitials { get; set; } = "";

    /// <summary>A stable id for the person, so their avatar keeps one tint.</summary>
    [Parameter] public string UserSeed { get; set; } = "";

    [Parameter] public string? UserImageUrl { get; set; }

    /// <summary>Rows for the account card's menu. Null means the card has no menu.</summary>
    [Parameter] public RenderFragment? UserMenu { get; set; }

    /// <summary>
    /// The inbox count. Null means no badge — which is also what "there is no
    /// count to show" means: a count is useful context but not worth
    /// interrupting navigation over.
    /// </summary>
    [Parameter] public int? InboxUnread { get; set; }

    private NavEntry? Current => NavMap.Match(new Uri(Nav.Uri).AbsolutePath);

    private ElementReference _rail;
    private bool _wasCollapsed = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Just opened: take the focus, so Esc and Tab work from the rail.
        if (_wasCollapsed && !Shell.Collapsed) await _rail.FocusAsync();
        _wasCollapsed = Shell.Collapsed;
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") Shell.Collapse();
    }

    protected override void OnInitialized()
    {
        Shell.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // Opening the full rail is for the moment: picking a page closes it.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            Shell.Collapse();
            StateHasChanged();
        });

    public void Dispose()
    {
        Shell.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
