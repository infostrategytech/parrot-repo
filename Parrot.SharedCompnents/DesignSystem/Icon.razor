@namespace Parrot.SharedComponents.DesignSystem

@* One <use> into the generated sprite. The glyph paints with currentColor, so
   an icon takes its colour from whatever it sits in and never needs styling.

   Accessibility is decided here rather than left to each call site, because
   React left it to each call site and the results were inconsistent: an icon
   with no Label is decorative and hidden from screen readers, an icon with a
   Label is announced. There is no third state to get wrong. *@

@if (Label is null)
{
    <svg class="@ClassName" aria-hidden="true" focusable="false">
        <use href="@Href" />
    </svg>
}
else
{
    <svg class="@ClassName" role="img" aria-label="@Label" focusable="false">
        <use href="@Href" />
    </svg>
}

@code {
    [Parameter, EditorRequired] public IconName Name { get; set; }

    /// <summary>
    /// What a screen reader should say. Leave it null when the icon only
    /// repeats adjacent text, which is most of the time.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Defaults to <see cref="IconSize.Inherit"/>, which scales with the surrounding text.</summary>
    [Parameter] public IconSize Size { get; set; } = IconSize.Inherit;

    [Parameter] public string? Class { get; set; }

    // The sprite is not fingerprinted, so a browser that cached an older one never sees icons added since. The
    // build id didn't help: builds are deterministic, so it stayed the same across releases and a browser kept a
    // sprite without the camera (7 November 2026). The version is now the sprite's own content, embedded at build:
    // it changes exactly when an icon does. The build id stays as a fallback.
    private static readonly string SpriteVersion = SpriteHash() ?? typeof(Icon).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];

    private static string? SpriteHash()
    {
        try
        {
            using var sprite = typeof(Icon).Assembly.GetManifestResourceStream("aurora-icons.svg");
            return sprite is null ? null : Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(sprite))[..8].ToLowerInvariant();
        }
        catch (Exception exception) when (exception is PlatformNotSupportedException or IOException) { return null; }
    }

    private string Href => "_content/Parrot.SharedComponents/icons/aurora-icons.svg?v=" + SpriteVersion + "#" + Name.ToSymbolId();

    private string ClassName
    {
        get
        {
            var name = "ds-icon ds-icon--" + Size.ToString().ToLowerInvariant();
            return string.IsNullOrWhiteSpace(Class) ? name : name + " " + Class;
        }
    }
}
