@namespace Parrot.SharedComponents.DesignSystem

@* A short flow's steps, in one quiet line above its heading (designer, 26 October 2026: "Select posts →
   Review → Add"): a number in a circle and the step's name, done ones ticked, the one now filled. For two to
   four steps; a longer flow wants its own progress. *@

<ol class="@($"ds-step-trail {Class}")" aria-label="@Label">
    @for (var index = 0; index < Steps.Count; index++)
    {
        // Copied for the step's own text, which renders after the loop has moved on.
        var name = Steps[index];
        var number = index + 1;
        var done = index < Current;
        var now = index == Current;
        <li class="@($"ds-step-trail__step is-{(done ? "done" : now ? "current" : "upcoming")}")" aria-current="@(now ? "step" : null)">
            <span class="ds-step-trail__mark @TextStyle.Small10Semibold.ToClassName()" aria-hidden="true">
                @if (done)
                {
                    <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                }
                else
                {
                    @number
                }
            </span>
            <Typography TextStyle="@(now ? TextStyle.Small12Semibold : TextStyle.Small12Medium)" As="span">@name</Typography>
            @if (done)
            {
                <span class="sr-only">, done</span>
            }
        </li>
    }
</ol>

@code {
    /// <summary>The steps' names, in order ("Select posts", "Review", "Add").</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Steps { get; set; } = [];

    /// <summary>The step now, from 0.</summary>
    [Parameter] public int Current { get; set; }

    [Parameter] public string Label { get; set; } = "Steps";

    [Parameter] public string? Class { get; set; }
}
