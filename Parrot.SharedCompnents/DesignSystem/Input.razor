@namespace Parrot.SharedComponents.DesignSystem
@inject AuroraInterop Interop
@implements IAsyncDisposable

@* The floating label is driven entirely by CSS. The input always carries a
   placeholder of one space, so :placeholder-shown is false the moment there is
   a value and the label lifts without any "is filled" state in C#. Remove that
   placeholder and the label stops moving — with no error anywhere.

   The field is uncontrolled: its value attribute is the starting value only,
   fixed at the first render and never re-rendered, so the field shows a
   prefill from its first moment and the server never writes over typing
   afterwards. Later text reaches it only when it changes from outside the
   keyboard (a reset, a value the page rewrites), and anything typed since
   wins over such a change still on its way. A server-rendered value races
   the keyboard: on a slow connection a render lands mid-typing with an older
   copy and eats characters or throws the caret around (seen in production on
   sign-in and sign-up). TextArea works the same way since fe79605.

   Typing does not wait for the page: what is typed or autofilled into the
   prerendered copy is kept (early-input.js) and taken over, with the focus
   and caret, when this live field first renders. The field needs an Id for
   that; the sign-in and sign-up fields have one. *@

<div class="@ClassName">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="field__label @TextStyle.Small12Medium.ToClassName()" for="@InputId" id="@LabelId">
            @if (LabelIconLeft is not null)
            {
                @LabelIconLeft
            }
            <span>@Label</span>
            @if (LabelIconRight is not null)
            {
                @LabelIconRight
            }
        </label>
    }

    @* The whole box is the input's label, so a click anywhere inside it --
       the padding above the value, the icons, the prefix -- focuses the input
       with no script. Buttons inside it (a password eye) still work: a label
       does not redirect clicks on its own interactive content. *@
    <label class="field__box" for="@InputId">
        @if (IconLeft is not null)
        {
            <span class="field__icon">@IconLeft</span>
        }

        @if (PrefixIcon is not null || !string.IsNullOrWhiteSpace(PrefixText))
        {
            <span class="field__prefix" id="@PrefixId">
                @if (PrefixIcon is not null)
                {
                    @PrefixIcon
                }
                @if (!string.IsNullOrWhiteSpace(PrefixText))
                {
                    <b class="@TextStyle.BodySmallMedium.ToClassName()">@PrefixText</b>
                }
            </span>
            <span class="field__divider"></span>
        }

        <span class="field__control">
            <input @ref="_input"
                   id="@InputId"
                   class="@TextStyle.BodySmallMedium.ToClassName()"
                   type="@InputType"
                   inputmode="@InputMode"
                   data-numeric-input="@(Numeric == NumericInputKind.None ? null : Numeric.ToString().ToLowerInvariant())"
                   value="@_initial"

                   placeholder=" "
                   disabled="@Disabled"
                   aria-labelledby="@LabelledBy"
                   aria-describedby="@(string.IsNullOrWhiteSpace(ShownHelper) ? null : HelperId)"
                   aria-invalid="@(Error || _numericError is not null ? "true" : null)"
                   @oninput="OnInput"
                   @attributes="AdditionalAttributes" />
            <span class="field__float" id="@FloatId">@FloatingLabel</span>
        </span>

        @if (IconRight is not null)
        {
            <span class="field__icon">@IconRight</span>
        }
    </label>

    @if (!string.IsNullOrWhiteSpace(ShownHelper))
    {
        <p class="field__helper @TextStyle.Small12Regular.ToClassName()" id="@HelperId">
            @if (HelperIconLeft is not null)
            {
                @HelperIconLeft
            }
            <span>@ShownHelper</span>
            @if (HelperIconRight is not null)
            {
                @HelperIconRight
            }
        </p>
    }
</div>

@code {
    private readonly string _generatedId = "field-" + Guid.NewGuid().ToString("N");
    private ElementReference _input;
    private IAsyncDisposable? _autofillBinding;
    private IAsyncDisposable? _numericBinding;
    private Microsoft.JSInterop.DotNetObjectReference<Input>? _numericTarget;
    private string? _numericError;
    private string? ShownHelper => _numericError ?? HelperText;

    /// <summary>Moves focus into the field (an edit opened in place, a table cell).</summary>
    public ValueTask FocusAsync() => _input.FocusAsync();

    /// <summary>
    /// Moves focus into the field with the caret after its text: something
    /// started for the person to finish (a profile link's instagram.com/).
    /// </summary>
    public async Task FocusAtEndAsync()
    {
        if (string.IsNullOrEmpty(Value)) await _input.FocusAsync();
        else await Interop.SetValueAsync(_input, Value, focus: true);
    }

    // The text the field already shows (last typed or last pushed), and text
    // waiting to be pushed to it after the next render.
    private string _shown = "";
    private string? _pending;

    // The starting value, rendered once as the attribute and never changed.
    private string? _initial;
    private bool _started;

    /// <summary>The label that sits in the field until it holds a value. Always required — a field with no name is not usable.</summary>
    [Parameter, EditorRequired] public string FloatingLabel { get; set; } = "";

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>An additional label above the field, for when the floating one is not enough.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public RenderFragment? LabelIconLeft { get; set; }
    [Parameter] public RenderFragment? LabelIconRight { get; set; }

    [Parameter] public string? HelperText { get; set; }

    [Parameter] public RenderFragment? HelperIconLeft { get; set; }
    [Parameter] public RenderFragment? HelperIconRight { get; set; }

    [Parameter] public bool Error { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public RenderFragment? IconLeft { get; set; }
    [Parameter] public RenderFragment? IconRight { get; set; }

    [Parameter] public RenderFragment? PrefixIcon { get; set; }
    [Parameter] public string? PrefixText { get; set; }

    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Restricts typing/paste in the browser, without server-side caret rewrites. Opt-in only.
    /// Callers must also validate with NumberText before saving; a keyboard filter is not validation.</summary>
    [Parameter] public NumericInputKind Numeric { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string InputId => Id ?? _generatedId;

    private string HelperId => InputId + "-helper";
    private string LabelId => InputId + "-label";
    private string PrefixId => InputId + "-prefix";
    private string FloatId => InputId + "-float";

    // Named from exactly its label text (and the prefix, so a phone field is
    // "Nigeria +234 Phone Number"). The box being a <label> would otherwise
    // fold in anything else inside it, such as a password eye's "Show password".
    private string LabelledBy => string.Join(" ", new[]
    {
        string.IsNullOrWhiteSpace(Label) ? null : LabelId,
        PrefixIcon is null && string.IsNullOrWhiteSpace(PrefixText) ? null : PrefixId,
        FloatId,
    }.Where(id => id is not null));

    // Text that differs from what the field shows came from outside the keyboard.
    protected override void OnParametersSet()
    {
        var text = Value ?? "";
        if (!_started)
        {
            _started = true;
            _initial = Value;
            _shown = text;
            return;
        }
        if (text == _shown) return;
        _shown = text;
        _pending = text;
    }

    // Typing wins over a change from the page that has not reached the field yet.
    private Task OnInput(ChangeEventArgs args)
    {
        _numericError = null;
        _pending = null;
        _shown = args.Value?.ToString() ?? "";
        return ValueChanged.InvokeAsync(_shown);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Numeric != NumericInputKind.None && _numericBinding is null)
        {
            _numericTarget = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            _numericBinding = await Interop.BindNumberInputAsync(_input, _numericTarget);
        }
        if (firstRender)
        {
            // Password managers can fill after Blazor renders without raising
            // a normal input event. Mirror that browser value into ValueChanged
            // so the form and the pixels never disagree.
            _autofillBinding = await Interop.BindAutofillAsync(_input);

            // Typed before the page was live: carry it on as if just typed here.
            if (await Interop.TakeEarlyAsync(_input) is { } early && early != _shown)
            {
                _pending = null;
                _shown = early;
                await ValueChanged.InvokeAsync(early);
            }
        }
        if (_pending is not null)
        {
            var text = _pending;
            _pending = null;
            await Interop.SetValueAsync(_input, text);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_numericBinding is not null) await _numericBinding.DisposeAsync();
        _numericTarget?.Dispose();
        if (_autofillBinding is not null) await _autofillBinding.DisposeAsync();
    }

    [Microsoft.JSInterop.JSInvokable]
    public Task NumberRejectedAsync(string shown)
    {
        if (_shown != shown && (Numeric != NumericInputKind.Decimal || NumberText.Decimal(_shown) != NumberText.Decimal(shown))) return Task.CompletedTask;
        _numericError = Numeric switch
        {
            NumericInputKind.Integer => "Use whole numbers only.",
            NumericInputKind.Phone => "Use numbers only, such as 0803 555 1234.",
            _ => "Use numbers only, such as 58,000 or 58,000.50.",
        };
        return InvokeAsync(StateHasChanged);
    }

    // Number entry keeps a text field (no spinner, no lost leading zeros); a phone number is "tel", so its keypad
    // and autofill are a phone's. The keypad follows the kind.
    private string InputType => Numeric switch
    {
        NumericInputKind.None => Type,
        NumericInputKind.Phone => "tel",
        _ => "text",
    };

    private string? InputMode => Numeric switch
    {
        NumericInputKind.Integer => "numeric",
        NumericInputKind.Decimal => "decimal",
        NumericInputKind.Phone => "tel",
        _ => null,
    };

    private string ClassName
    {
        get
        {
            var name = "field";
            if (Error || _numericError is not null) name += " is-error";
            if (Disabled) name += " is-disabled";
            return string.IsNullOrWhiteSpace(Class) ? name : name + " " + Class;
        }
    }
}
