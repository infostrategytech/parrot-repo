@namespace Parrot.SharedComponents.DesignSystem
@inject AuroraInterop Interop

@* The same new-password controls in signed-out recovery and in-app recovery. No service, token or route
   belongs in this presentation component; the feature supplies its real reset contract and state. *@
<div class="new-password-fields" @ref="_root">
    <PasswordInput Id="@($"{IdPrefix}-new-password")" FloatingLabel="New password" IsNew MaxLength="128"
                   Value="@Password" ValueChanged="PasswordChanged" ErrorText="@PasswordError"
                   ShowIcon="ShowIcons" Disabled="Disabled" HelperTextStyle="TextStyle.Small12Medium" />
    <PasswordInput Id="@($"{IdPrefix}-confirm-password")" FloatingLabel="Confirm new password" IsNew ShowStrength="false" MaxLength="128"
                   Value="@Confirmation" ValueChanged="ConfirmationChanged" ErrorText="@ConfirmationError"
                   ShowIcon="ShowIcons" Disabled="Disabled" HelperTextStyle="TextStyle.Small12Medium" />
</div>

@code {
    [Parameter] public string IdPrefix { get; set; } = "reset";
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? Confirmation { get; set; }
    [Parameter] public EventCallback<string?> PasswordChanged { get; set; }
    [Parameter] public EventCallback<string?> ConfirmationChanged { get; set; }
    [Parameter] public string? PasswordError { get; set; }
    [Parameter] public string? ConfirmationError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowIcons { get; set; }
    [Parameter] public int FocusRevision { get; set; }
    private int _focusedRevision;
    private ElementReference _root;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusRevision == _focusedRevision || Disabled) return;
        _focusedRevision = FocusRevision;
        var target = PasswordError is null && ConfirmationError is not null ? "confirm" : "new";
        try { await Interop.FocusWithinAsync(_root, $"{IdPrefix}-{target}-password"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException) { }
    }
}
