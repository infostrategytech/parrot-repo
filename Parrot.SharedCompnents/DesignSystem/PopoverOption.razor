@namespace Parrot.SharedComponents.DesignSystem

@* One row of a dropdown: a FilterPopover's or a SelectField's. Also duplicated byte for byte in React,
   alongside FilterPopover itself.

   A label only, never a second line (designer, 7 November 2026): a dropdown is a choice between things you
   already understand, so a description under each option costs attention every time it opens and makes rows
   uneven. There is no Description parameter, so no screen can add one back. Where a choice needs explaining,
   say it once beside the field (its helper text) or in the dialog, not under every option. *@

<button type="button"
        class="@ClassName"
        role="@(Multiple ? "menuitemcheckbox" : "menuitemradio")"
        aria-checked="@Active.ToString().ToLowerInvariant()"
        @onclick="OnSelect">
    @if (Leading is not null)
    {
        <span class="popover-option__leading" aria-hidden="true">@Leading</span>
    }
    <span class="popover-option__text">
        @if (Badge is not null)
        {
            <span class="popover-option__name">
                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@Label</Typography>
                <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="popover-option__badge">@Badge</Typography>
            </span>
        }
        else
        {
            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@Label</Typography>
        }
    </span>

    @if (Active)
    {
        @* aria-checked already announces the selection, so the tick is decorative. *@
        <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" Class="popover-option__check" />
    }
</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>A small label beside the name, for the one choice to suggest ("Recommended"). Optional.</summary>
    [Parameter] public string? Badge { get; set; }

    [Parameter] public RenderFragment? Leading { get; set; }

    [Parameter] public bool Active { get; set; }

    /// <summary>
    /// One of several that can be chosen together (the invite's workspaces): announced as a checkbox, not a radio.
    /// The menu stays open between picks; the caller decides that by not closing it.
    /// </summary>
    [Parameter] public bool Multiple { get; set; }

    [Parameter] public EventCallback OnSelect { get; set; }

    private string ClassName => Active ? "popover-option is-active" : "popover-option";
}
