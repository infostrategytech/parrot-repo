@namespace Parrot.SharedComponents.DesignSystem

@* The Cadence loaders, drawn exactly as the brand document draws them: the
   same geometry, the same SMIL timings and the same spline (.45 0 .25 1).

   Two things differ from the document, both deliberate:
   - Slate bars take --cadence-bar rather than a literal, so a loader on a
     dark surface draws in linen, as the brand's own dark cards do. The
     terracotta reply bar is a literal, because that colour never changes.
   - The relay dots' colour pass is drawn as a terracotta circle fading in
     over a currentColor dot rather than an animated fill, so the dots can
     sit on a button, a toast or a table cell in either theme.

   With reduced motion on, every loader rests as the static mark. *@

<span class="@ClassName" role="@(Label is null ? null : "status")" aria-label="@Label" aria-hidden="@(Label is null ? "true" : null)">
    <span class="cadence-loader__motion">
        @switch (Kind)
        {
            case CadenceLoaderKind.Thread:
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    <rect x="14" y="22" width="52" height="14" rx="7" style="fill:var(--cadence-bar)"><animate attributeName="width" values="14;52;52;14" keyTimes="0;.15;.9;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="2.4s" begin="-1.9s" repeatCount="indefinite"></animate></rect>
                    <rect x="14" y="29" width="7" height="7" style="fill:var(--cadence-bar)"></rect>
                    <rect x="34" y="43" width="52" height="14" rx="7" fill="#C8553D"><animate attributeName="width" values="14;14;52;52;14" keyTimes="0;.25;.45;.9;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="2.4s" begin="-1.9s" repeatCount="indefinite"></animate><animate attributeName="x" values="72;72;34;34;72" keyTimes="0;.25;.45;.9;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="2.4s" begin="-1.9s" repeatCount="indefinite"></animate></rect>
                    <rect x="79" y="50" width="7" height="7" fill="#C8553D"></rect>
                    <rect x="14" y="64" width="36" height="14" rx="7" style="fill:var(--cadence-bar)"><animate attributeName="width" values="14;14;36;36;14" keyTimes="0;.55;.7;.9;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="2.4s" begin="-1.9s" repeatCount="indefinite"></animate></rect>
                    <rect x="14" y="71" width="7" height="7" style="fill:var(--cadence-bar)"></rect>
                </svg>
                break;

            case CadenceLoaderKind.Typing:
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    <rect x="26" y="41" width="18" height="18" rx="9" fill="#C8553D"><animate attributeName="width" values="18;48;48;18" keyTimes="0;.45;.7;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.2s" begin="0s" repeatCount="indefinite"></animate></rect>
                    <rect x="35" y="50" width="9" height="9" fill="#C8553D"><animate attributeName="x" values="35;65;65;35" keyTimes="0;.45;.7;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.2s" begin="0s" repeatCount="indefinite"></animate></rect>
                </svg>
                break;

            case CadenceLoaderKind.Wave:
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    <g><animateTransform attributeName="transform" type="translate" values="0 0;6 0;0 0;0 0" keyTimes="0;.25;.5;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.6s" begin="0s" repeatCount="indefinite"></animateTransform><rect x="14" y="22" width="52" height="14" rx="7" style="fill:var(--cadence-bar)"></rect><rect x="14" y="29" width="7" height="7" style="fill:var(--cadence-bar)"></rect></g>
                    <g><animateTransform attributeName="transform" type="translate" values="0 0;6 0;0 0;0 0" keyTimes="0;.25;.5;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.6s" begin="0.16s" repeatCount="indefinite"></animateTransform><rect x="34" y="43" width="52" height="14" rx="7" fill="#C8553D"></rect><rect x="79" y="50" width="7" height="7" fill="#C8553D"></rect></g>
                    <g><animateTransform attributeName="transform" type="translate" values="0 0;6 0;0 0;0 0" keyTimes="0;.25;.5;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.6s" begin="0.32s" repeatCount="indefinite"></animateTransform><rect x="14" y="64" width="36" height="14" rx="7" style="fill:var(--cadence-bar)"></rect><rect x="14" y="71" width="7" height="7" style="fill:var(--cadence-bar)"></rect></g>
                </svg>
                break;

            case CadenceLoaderKind.RelayDots:
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    @foreach (var (cx, begin) in new[] { (26, "0s"), (50, "0.25s"), (74, "0.5s") })
                    {
                        <g>
                            <animateTransform attributeName="transform" type="translate" values="0 0;0 -6;0 0;0 0" keyTimes="0;.2;.4;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.5s" begin="@begin" repeatCount="indefinite"></animateTransform>
                            <circle cx="@cx" cy="50" r="7" fill="currentColor"></circle>
                            <circle cx="@cx" cy="50" r="7" fill="#C8553D" opacity="0"><animate attributeName="opacity" values="0;1;0;0" keyTimes="0;.2;.4;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="1.5s" begin="@begin" repeatCount="indefinite"></animate></circle>
                        </g>
                    }
                </svg>
                break;

            case CadenceLoaderKind.Turn:
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    <g><animateTransform attributeName="transform" type="rotate" values="0 50 50;0 50 50;90 50 50;90 50 50;180 50 50;180 50 50;270 50 50;270 50 50;360 50 50" keyTimes="0;.1;.25;.35;.5;.6;.75;.85;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="2.4s" repeatCount="indefinite"></animateTransform><path d="M50 41H79A9 9 0 0 1 79 59H50Z" fill="#C8553D"></path><rect x="41" y="41" width="18" height="18" fill="#C8553D"></rect></g>
                    <circle cx="50" cy="50" r="3" style="fill:var(--cadence-bar)"></circle>
                </svg>
                break;

            case CadenceLoaderKind.Progress:
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    <rect x="10" y="43" width="80" height="14" rx="7" style="fill:var(--cadence-track)"></rect>
                    <rect x="10" y="50" width="7" height="7" style="fill:var(--cadence-track)"></rect>
                    @if (Value is { } value)
                    {
                        @* Determinate: the fill follows real progress. *@
                        <rect x="10" y="43" width="@ProgressWidth(value)" height="14" rx="7" fill="#C8553D" style="transition: width var(--cadence-action) var(--cadence-ease)"></rect>
                    }
                    else
                    {
                        <rect x="10" y="43" width="14" height="14" rx="7" fill="#C8553D"><animate attributeName="width" values="14;80;80;14" keyTimes="0;.8;.9;1" calcMode="spline" keySplines=".45 0 .25 1;.45 0 .25 1;.45 0 .25 1" dur="3s" begin="-2s" repeatCount="indefinite"></animate></rect>
                    }
                    <rect x="10" y="50" width="7" height="7" fill="#C8553D"></rect>
                </svg>
                break;

            case CadenceLoaderKind.Assemble:
                @* Plays once: message, reply slides in, message — and ends on the static logo. *@
                <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                    <g opacity="0"><animate attributeName="opacity" values="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .25 1" dur="0.36s" begin="0s" fill="freeze"></animate><rect x="14" y="22" width="52" height="14" rx="7" style="fill:var(--cadence-bar)"></rect><rect x="14" y="29" width="7" height="7" style="fill:var(--cadence-bar)"></rect></g>
                    <g opacity="0"><animate attributeName="opacity" values="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .25 1" dur="0.36s" begin="0.6s" fill="freeze"></animate><animateTransform attributeName="transform" type="translate" values="8 0;0 0" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .25 1" dur="0.36s" begin="0.6s" fill="freeze"></animateTransform><rect x="34" y="43" width="52" height="14" rx="7" fill="#C8553D"></rect><rect x="79" y="50" width="7" height="7" fill="#C8553D"></rect></g>
                    <g opacity="0"><animate attributeName="opacity" values="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .25 1" dur="0.36s" begin="1.2s" fill="freeze"></animate><rect x="14" y="64" width="36" height="14" rx="7" style="fill:var(--cadence-bar)"></rect><rect x="14" y="71" width="7" height="7" style="fill:var(--cadence-bar)"></rect></g>
                </svg>
                break;
        }
    </span>

    <span class="cadence-loader__rest">
        @if (Kind == CadenceLoaderKind.RelayDots)
        {
            <svg width="@Size" height="@Size" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                <circle cx="26" cy="50" r="7" fill="currentColor"></circle>
                <circle cx="50" cy="50" r="7" fill="#C8553D"></circle>
                <circle cx="74" cy="50" r="7" fill="currentColor"></circle>
            </svg>
        }
        else
        {
            <CadenceMark Size="Size" />
        }
    </span>
</span>

@code {
    [Parameter] public CadenceLoaderKind Kind { get; set; } = CadenceLoaderKind.Thread;

    /// <summary>The box the loader is drawn in, in px. The document shows each at 150, 48, 32, 24 and 16.</summary>
    [Parameter] public int Size { get; set; } = 48;

    /// <summary>For <see cref="CadenceLoaderKind.Progress"/>: 0–1 to follow real progress; null loops.</summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>What a screen reader announces. Null keeps the loader decorative — right when the text beside it already says what is happening.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Class { get; set; }

    private string ClassName
    {
        get
        {
            var name = "cadence-loader cadence-loader--" + Kind.ToString().ToLowerInvariant();
            return string.IsNullOrWhiteSpace(Class) ? name : name + " " + Class;
        }
    }

    // The track runs from x=10 to x=90; the fill never drops below the 14px
    // that keeps the square corner attached.
    private static string ProgressWidth(double value) =>
        (14 + 66 * Math.Clamp(value, 0, 1)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
