@namespace Parrot.SharedComponents.DesignSystem

@* One row of an ActionMenu. *@
<button type="button" class="ds-action-menu-item" role="menuitem" disabled="@Disabled" @onclick="OnClick">
    @if (Glyph is { } glyph)
    {
        <Icon Name="glyph" Size="IconSize.Sm" />
    }
    <Typography TextStyle="TextStyle.BodySmallMedium" As="span">@Label</Typography>
</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public IconName? Glyph { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
