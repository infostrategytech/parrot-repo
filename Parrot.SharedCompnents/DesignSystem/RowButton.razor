@namespace Parrot.SharedComponents.DesignSystem

@* A whole row that is one control: a conversation in a list, a saved reply
   to insert, a value to copy. It brings the behaviour (a real button, a
   hover, the pointer); the caller lays out what is inside. *@
<button type="button" class="ds-row-button @Class" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>aria-current, aria-label and the like pass straight through.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
