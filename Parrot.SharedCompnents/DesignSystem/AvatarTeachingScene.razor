@namespace Parrot.SharedComponents.DesignSystem
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Original, responsive teaching illustration. Reuses the existing avatar artwork; accessories and the
   cane stay attached to their characters. This depicts learning, not a live agent or a voice recording. *@
<div class="avatar-teaching" data-running="false" data-playing="false" @ref="_root"
     role="@(Decorative ? null : "img")" aria-hidden="@(Decorative ? "true" : null)"
     aria-label="@(Decorative ? null : "An avatar teaches its AI teammate with a pointer and a board. Both avatars wear glasses.")">
    <svg class="avatar-teaching__ground" viewBox="0 0 512 440" aria-hidden="true">
        <ellipse cx="114" cy="390" rx="77" ry="10" />
        <ellipse cx="420" cy="400" rx="63" ry="8" />
        <path class="avatar-teaching__legs" d="M172 217l-23 85m217-85 23 85" />
    </svg>
    <div class="avatar-teaching__board" aria-hidden="true">
        <Typography TextStyle="TextStyle.Small12Semibold" As="p">Your business</Typography>
        <div class="avatar-teaching__board-row row-products"><Icon Name="IconName.RiShoppingBag3Fill" Size="IconSize.Sm" /><Typography TextStyle="TextStyle.Small12Medium" As="span">What you sell</Typography><Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" /></div>
        <div class="avatar-teaching__board-row row-prices"><Icon Name="IconName.RiBankCardFill" Size="IconSize.Sm" /><Typography TextStyle="TextStyle.Small12Medium" As="span">Your prices</Typography><Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" /></div>
        <div class="avatar-teaching__board-row row-delivery"><Icon Name="IconName.RiTruckFill" Size="IconSize.Sm" /><Typography TextStyle="TextStyle.Small12Medium" As="span">How you deliver</Typography><Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" /></div>
    </div>
    <svg class="avatar-teaching__pointer" viewBox="0 0 512 440" aria-hidden="true">
        <g class="avatar-teaching__cane">
            <path class="avatar-teaching__cane-shaft" d="M175 303 272 105" />
            <circle class="avatar-teaching__cane-tip" cx="272" cy="105" r="4" />
            <circle class="avatar-teaching__hand" cx="175" cy="303" r="9" />
        </g>
    </svg>
    <div class="avatar-teaching__character is-teacher" aria-hidden="true">
        <div class="avatar-teaching__teacher" data-teaching-teacher>
            <PresenceAvatar Direction="PresenceAvatarDirection.Pip" Tone="PresenceAvatarTone.Teal" State="PresenceAvatarState.Speaking" Size="PresenceAvatarSize.Fill" Glasses Paused Decorative />
        </div>
        <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="avatar-teaching__label">Your business</Typography>
    </div>
    <div class="avatar-teaching__character is-learner" aria-hidden="true">
        <div class="avatar-teaching__learner">
            <PresenceAvatar Direction="PresenceAvatarDirection.Bloom" Tone="PresenceAvatarTone.Violet" State="PresenceAvatarState.Listening" Size="PresenceAvatarSize.Fill" Glasses Paused Decorative />
        </div>
        <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="avatar-teaching__label">Your AI</Typography>
    </div>
</div>

@code {
    [Parameter] public bool Active { get; set; } = true;
    /// <summary>Change to replay the finite illustration, including when the selected feature is clicked again.</summary>
    [Parameter] public int Replay { get; set; }
    [Parameter] public bool Decorative { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module, _player;
    private (bool Active, int Replay)? _sent;
    private bool _binding, _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_binding || _disposed) return;
        _binding = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Parrot.SharedComponents/js/avatar-teaching-scene.js");
            if (_disposed) { await _module.DisposeAsync(); _module = null; return; }
            _player ??= await _module.InvokeAsync<IJSObjectReference>("bindTeachingScene", _root);
            if (_disposed) { await _player.InvokeVoidAsync("release"); await _player.DisposeAsync(); _player = null; return; }
            var state = (Active, Replay);
            if (_sent != state) { _sent = state; await _player.InvokeVoidAsync("update", state.Active, state.Replay); }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { }
        finally { _binding = false; }
        if (!_disposed && _player is not null && _sent != (Active, Replay)) await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_player is not null) { await _player.InvokeVoidAsync("release"); await _player.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { }
    }
}
