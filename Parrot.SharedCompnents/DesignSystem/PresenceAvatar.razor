@namespace Parrot.SharedComponents.DesignSystem
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Original, code-native character studies, not image assets or Grok artwork.
   One flat silhouette and two eyes; the eyes carry every expression (a brow
   was tried and dropped, designer, 9 November 2026: it read as unfinished).
   The eyes are white with a dark pupil that looks around inside them (designer, 10 November 2026;
   the earlier solid eyes were retired the same day).
   Each state has its own still face, so it reads with motion off; a Reactive avatar is
   brought to life by presence-avatar.js (springs, blinks, gaze, hover, press).
   State is input: this component never starts work or changes agent status. *@
<span class="presence-avatar presence-avatar--@Direction.ToString().ToLowerInvariant() presence-avatar--@Tone.ToString().ToLowerInvariant() presence-avatar--@Size.ToString().ToLowerInvariant() @(Paused ? "is-paused" : null) @(Reactive ? "is-reactive" : null) @(Floating ? "presence-avatar--floating" : null)"
      data-state="@StateName"
      role="@(Decorative ? null : "img")"
      aria-hidden="@(Decorative ? "true" : null)"
      aria-label="@(Decorative ? null : AccessibleLabel)" @ref="Element">
    <svg viewBox="0 0 128 128" aria-hidden="true" focusable="false">
        @if (Floating)
        {
            @* Its shadow on the ground: three soft layers, darkest in the middle, so it fades out without a filter. *@
            <g class="presence-avatar__shadow">
                <ellipse cx="64" cy="122" rx="34" ry="4.5" />
                <ellipse cx="64" cy="122" rx="25" ry="3.5" />
                <ellipse cx="64" cy="122" rx="16" ry="2.5" />
            </g>
        }
        <g class="presence-avatar__attention">
        <g class="presence-avatar__character">
            @* The turn: a new shape spins in and morphs from the old one (presence-avatar.js), body and face together. *@
            <g class="presence-avatar__turn">
            @if (Reactive)
            {
                @* Speaking: soft rings of its own shape that grow out on stressed words. *@
                <path class="presence-avatar__echo" d="@Style.BodyPath" />
                <path class="presence-avatar__echo" d="@Style.BodyPath" />
            }
            <path class="presence-avatar__body" d="@Style.BodyPath" />
            <g class="presence-avatar__face-anchor" transform="@Style.FacePosition">
                <g class="presence-avatar__gaze">
                <g class="presence-avatar__face">
                    <g class="presence-avatar__eyes">
                        @* Both looks are always drawn, so a change of state can blend from one to the other.
                           The eye blinks and turns; the eyeball inside it holds the expression. *@
                        <g class="presence-avatar__eye">
                            <g class="presence-avatar__eyeball">
                                <circle class="presence-avatar__white" cx="49" cy="61" r="13" />
                                <circle class="presence-avatar__pupil" cx="49" cy="61" r="7" />
                                <path class="presence-avatar__happy" d="M41 64q8-10 16 0" />
                            </g>
                        </g>
                        <g class="presence-avatar__eye presence-avatar__eye--right">
                            <g class="presence-avatar__eyeball">
                                <circle class="presence-avatar__white" cx="79" cy="61" r="13" />
                                <circle class="presence-avatar__pupil" cx="79" cy="61" r="7" />
                                <path class="presence-avatar__happy" d="M71 64q8-10 16 0" />
                            </g>
                        </g>
                    </g>
                </g>
                </g>
            </g>
            </g>
        </g>
        @if (Reactive)
        {
            @* Press and hold, and arriving at Done: it turns right round and lands, and sparkles pop around it. *@
            <g class="presence-avatar__sparkles">
                <g transform="translate(14 30)"><path class="presence-avatar__sparkle" d="M0-7Q1-1 7 0Q1 1 0 7Q-1 1-7 0Q-1-1 0-7Z" /></g>
                <g transform="translate(113 26)"><path class="presence-avatar__sparkle" d="M0-7Q1-1 7 0Q1 1 0 7Q-1 1-7 0Q-1-1 0-7Z" /></g>
                <g transform="translate(98 9)"><path class="presence-avatar__sparkle" d="M0-7Q1-1 7 0Q1 1 0 7Q-1 1-7 0Q-1-1 0-7Z" /></g>
                <g transform="translate(30 8) scale(.7)"><path class="presence-avatar__sparkle" d="M0-7Q1-1 7 0Q1 1 0 7Q-1 1-7 0Q-1-1 0-7Z" /></g>
                <g transform="translate(122 52) scale(.7)"><path class="presence-avatar__sparkle" d="M0-7Q1-1 7 0Q1 1 0 7Q-1 1-7 0Q-1-1 0-7Z" /></g>
            </g>
        }
        </g>
        @if (State is PresenceAvatarState.Done or PresenceAvatarState.Blocked or PresenceAvatarState.Waiting)
        {
            <g class="presence-avatar__badge">
                <circle cx="103" cy="100" r="12" />
                @if (State == PresenceAvatarState.Done)
                { <path d="m98 100 3 3 7-7" /> }
                else if (State == PresenceAvatarState.Blocked)
                { <path d="M103 94v7m0 4v1" /> }
                else
                { <path d="M103 94v6l4 2" /> }
            </g>
        }
    </svg>
</span>

@code {
    [Parameter] public PresenceAvatarDirection Direction { get; set; }
    [Parameter] public PresenceAvatarState State { get; set; }
    [Parameter] public PresenceAvatarTone Tone { get; set; }
    [Parameter] public PresenceAvatarSize Size { get; set; } = PresenceAvatarSize.Medium;
    [Parameter] public bool Paused { get; set; }
    /// <summary>Alive: blinks, follows the pointer, perks up on hover and squishes on press. Cosmetic and local.</summary>
    [Parameter] public bool Reactive { get; set; }
    /// <summary>Hovers over a soft shadow, gently rising and falling (with Reactive). For a presence, not a list.</summary>
    [Parameter] public bool Floating { get; set; }
    /// <summary>Changing it plays a small happy hop (a choice made, a replay).</summary>
    [Parameter] public int Replay { get; set; }
    /// <summary>A success moment: shown already Done, it plays the happy turn as soon as it appears (after CueDelay).</summary>
    [Parameter] public bool Celebrate { get; set; }
    /// <summary>Milliseconds to wait before a reaction, so a row of avatars can ripple.</summary>
    [Parameter] public int CueDelay { get; set; }
    /// <summary>Use when an adjacent label already names the agent and state.</summary>
    [Parameter] public bool Decorative { get; set; }
    /// <summary>Optional agent name. State remains part of the accessible name.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Compatible with VoiceInterop's --level (0–1) input; this component never requests a microphone.</summary>
    public ElementReference Element { get; private set; }
    private IJSObjectReference? _module, _live;
    private bool _disposed;
    // What the live engine was last told, so only real changes become reactions.
    private PresenceAvatarState _sentState;
    private PresenceAvatarDirection _sentDirection;
    private PresenceAvatarTone _sentTone;
    private int _sentReplay;
    private bool _binding;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (!Reactive || Paused)
            {
                await ReleaseAsync();
                return;
            }
            if (_live is null)
            {
                // One binding at a time: a render that lands while the script is still loading (a shape picked
                // at once) would bind the drawing twice, and two engines jitter it and never let go.
                if (_binding) return;
                _binding = true;
                try
                {
                    _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Parrot.SharedComponents/js/presence-avatar.js");
                    if (_disposed) { if (_module is not null) await _module.DisposeAsync(); _module = null; return; }
                    var bound = (State, Direction, Tone, Replay);
                    _live = await _module.InvokeAsync<IJSObjectReference>("bindPresence", Element, new { state = StateName, floating = Floating });
                    (_sentState, _sentDirection, _sentTone, _sentReplay) = bound;
                    if (Celebrate && bound.State == PresenceAvatarState.Done) await _live.InvokeVoidAsync("cue", "celebrate", CueDelay);
                    if (_disposed) { await ReleaseAsync(); return; }
                }
                finally { _binding = false; }
                // Anything picked while it was binding carries on below.
            }
            if (_sentState != State) { _sentState = State; await _live.InvokeVoidAsync("update", StateName); }
            // A new shape turns and morphs on its own (the script watches the drawing), so it needs no cue here;
            // a new colour is a little hop, and a replay plays the state's moment again (Done's happy turn).
            var replayed = _sentReplay != Replay && Replay != 0;
            var cue = _sentDirection != Direction ? null
                : replayed && State == PresenceAvatarState.Done ? "celebrate"
                : _sentTone != Tone || replayed ? "hop" : null;
            (_sentDirection, _sentTone, _sentReplay) = (Direction, Tone, Replay);
            if (cue is not null) await _live.InvokeVoidAsync("cue", cue, CueDelay);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { }
    }

    private async Task ReleaseAsync()
    {
        if (_live is null) return;
        var live = _live; _live = null;
        await live.InvokeVoidAsync("release");
        await live.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // A closed tab has no browser left to tidy up, so a disconnected circuit is fine here.
        try { await ReleaseAsync(); if (_module is not null) await _module.DisposeAsync(); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { }
    }

    private string StateName => State.ToString().ToLowerInvariant();
    private AvatarStyle Style => AvatarStyles.Of(Direction);
    private string AccessibleLabel => $"{(string.IsNullOrWhiteSpace(Name) ? Style.Name : Name)}, {PresenceAvatarWords.Label(State).ToLowerInvariant()}";
}
