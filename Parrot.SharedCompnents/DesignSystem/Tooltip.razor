@namespace Parrot.SharedComponents.DesignSystem
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Short, non-interactive help. Use Focusable for informational marks; leave it off around controls
   that already receive focus. The top-layer bubble never takes focus or blocks the page. *@
<span class="ds-tooltip" @ref="_root">
    <span class="ds-tooltip__trigger" tabindex="@(HasText && Focusable ? "0" : null)"
          aria-describedby="@(HasText ? _id : null)">@ChildContent</span>
    @if (HasText)
    {
        <span class="ds-tooltip__bubble" id="@_id" role="tooltip" popover="manual" hidden @ref="_bubble">
            <Typography TextStyle="TextStyle.Small12Medium" As="span">@Text</Typography>
        </span>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    /// <summary>For an informative icon with no existing focus target; never nest a button or link when true.</summary>
    [Parameter] public bool Focusable { get; set; }

    private readonly string _id = $"ds-tooltip-{Guid.NewGuid():N}";
    private bool HasText => !string.IsNullOrWhiteSpace(Text);
    private ElementReference _root, _bubble;
    private IJSObjectReference? _module, _binding;
    private bool _disposed, _bound;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (!HasText) { await ReleaseBindingAsync(); _bound = false; return; }
            if (_bound) return;
            _bound = true;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Parrot.SharedComponents/js/tooltip.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _binding = await _module.InvokeAsync<IJSObjectReference>("bindTooltip", _root, _bubble);
            if (_disposed) await ReleaseBindingAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task ReleaseBindingAsync()
    {
        if (_binding is null) return;
        await _binding.InvokeVoidAsync("release");
        await _binding.DisposeAsync();
        _binding = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await ReleaseBindingAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { }
    }
}
