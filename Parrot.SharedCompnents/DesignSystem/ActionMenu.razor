@namespace Parrot.SharedComponents.DesignSystem
@inject AuroraInterop Interop

@* An icon button that opens a short list of actions (a "more" menu), as the
   inbox's conversation toolbar uses it; with Text, a labelled button with a
   chevron ("Import"), for a page header. Items are ActionMenuItem; choosing
   one closes the menu. Escape and a click anywhere else close it too. *@
<div class="ds-action-menu" @onkeydown="OnKeyDown" @ref="_root">
    @* Two renderings, not one with an empty label: the Button builds an
       icon-only button from an omitted label. *@
    @if (Text is null)
    {
        <Button Variant="ButtonVariant.Secondary" Size="@Size"
                Class="@(_open ? "ds-action-menu__trigger is-open" : "ds-action-menu__trigger")"
                aria-label="@Label" title="@Label"
                aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <IconLeft><Icon Name="@Glyph" /></IconLeft>
        </Button>
    }
    else
    {
        <Button Variant="ButtonVariant.Secondary" Size="@Size"
                Class="@(_open ? "ds-action-menu__trigger is-open" : "ds-action-menu__trigger")"
                aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <IconLeft><Icon Name="@Glyph" /></IconLeft>
            <ChildContent>@Text</ChildContent>
            <IconRight><Icon Name="IconName.RiArrowDownSLine" /></IconRight>
        </Button>
    }

    @if (_open)
    {
        @* In the browser's top layer, placed against the trigger: below it or above it, wherever there is
           room, and never cut off by a list, a panel or a dialog that scrolls (see FilterPopover). *@
        <div class="ds-action-menu__layer" popover="manual" @ref="_layer">
            @* The click-away layer: a full-screen transparent button, the documented
               exception to building from components. *@
            <button type="button" class="ds-action-menu__dismiss" tabindex="-1" aria-hidden="true" data-float-dismiss @onclick="Close"></button>
            <div class="ds-action-menu__menu" role="menu" aria-label="@Label"
                 aria-describedby="@(!string.IsNullOrWhiteSpace(FooterText) ? _footerId : null)" @onclick="Close" @ref="_menu">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    @* Presentation only: aria-label already names the menu, so a
                       heading here would have screen readers say it twice. *@
                    <div class="ds-action-menu__title" aria-hidden="true">
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@Title</Typography>
                    </div>
                }
                <div class="ds-action-menu__items">
                    <CascadingValue Value="Dense" Name="ActionMenuDense" IsFixed="true">
                        <CascadingValue Value="_context" IsFixed="true">
                            @ChildContent
                        </CascadingValue>
                    </CascadingValue>
                </div>
                @if (!string.IsNullOrWhiteSpace(FooterText))
                {
                    <div class="ds-action-menu__footer" id="@_footerId">
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@FooterText</Typography>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>What the trigger is called, for screen readers and its tooltip.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public IconName Glyph { get; set; } = IconName.RiMore2Fill;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Small;

    /// <summary>A visible label on the trigger, beside the glyph. Null for an icon-only button.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>
    /// A heading above the actions, for a menu whose subject is not obvious from
    /// where it was opened. Optional; most menus do not need one.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>A quiet note under the actions ("5 items"). Optional.</summary>
    [Parameter] public string? FooterText { get; set; }

    /// <summary>
    /// Tighter rows, for a menu opened from a small control in a dense row —
    /// a table row's "more" button, a card's overflow. Same type and icons,
    /// less air. Figma's Compact drops the icons instead; icons are what make
    /// a short action list quick to scan, so this keeps them.
    /// </summary>
    [Parameter] public bool Dense { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open, _placing;
    private readonly string _footerId = $"action-menu-footer-{Guid.NewGuid():N}";
    private ElementReference _root, _layer, _menu;

    // Items declare their icons as they initialise, which happens after this
    // menu has drawn — so drawing again is how the reserved column appears.
    private readonly ActionMenuContext _context = new();

    protected override void OnInitialized() =>
        _context.Changed += () => InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        _open = !_open;
        _placing = _open;
    }

    // Once drawn, the menu is placed: upward when it would not fit below (the last rows of a list).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_placing) return;
        _placing = false;
        try { await Interop.FloatMenuAsync(_layer, _root, _menu); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }
    private void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _open = false;
    }
}
