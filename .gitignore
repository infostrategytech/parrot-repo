# .gitignore for .NET (including .NET MAUI, Blazor, WebAssembly)
# Recommended for Visual Studio, VS Code, Rider and dotnet CLI

# Build directories
bin/
obj/
out/
docker-compose.yaml

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
packages/
.nuget/
.nuget/packages/

# dotnet
project.lock.json
project.fragment.lock.json
artifacts/

# Publish outputs
publish/
*.Publish.xml

# Azure Functions
local.settings.json

# vscode
.vscode/

# ASP.NET/Blazor/WASM
wwwroot/_framework/
wwwroot/**/*.pdb
wwwroot/**/*.br
wwwroot/**/*.gz
wwwroot/**/*.map

# Node/npm (if using npm for front-end assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# MAUI / Mobile platform artifacts
# Android
*.apk
*.ap_ 
*.aab
.gradle/
**/obj/**/android/**
**/bin/**/android/**

# iOS
**/bin/**/ios/**
**/obj/**/ios/**
*.app
*.dSYM

# Mac
.DS_Store

# Windows
Thumbs.db

# Logs
*.log

# Rider and VS Code settings
.vscode/

# User secrets
secrets.json

# App settings (environment-specific and local appsettings files)
# Ignore common appsettings files at repo root and in subfolders
appsettings.json
appsettings.*.json
**/appsettings.json
**/appsettings.*.json

# Environment variable files (contain secrets)
.env
.env.*
!.env.example
!.env.docker.example
!.env.ec2.example

# Temporary files
*.tmp
*.temp
*~

# Coverage and test outputs
coverage/
*.coverage
*.coveragexml
TestResults/

# Generated files from build
*.db
*.db-shm
*.db-wal

# Other
*.class
*.psess
*.vsp

# End of .gitignore

# Markdown documentation stays local.
*.[mM][dD]


# The catalog service ships its README, ADRs and threat model with the code, and its
# appsettings hold only local-development defaults (like Parrot.Api's, which are tracked).
!docs/catalog/**/*.md
!Parrot.Catalog.Api/appsettings.json
!Parrot.Catalog.Api/appsettings.Development.json
!Parrot.Catalog.Relay/appsettings.json
!Parrot.Catalog.Tools/appsettings.json

# The monitoring setup guide (Prometheus, dashboard import, alert loading) ships with its config.
!monitoring/*.md

# The conversations and AI orchestrator setup/audit guides ship with the code they describe.
!docs/CONVERSATIONS.md
!docs/AI_INTEGRATION.md

# Nginx configuration
nginx.conf
