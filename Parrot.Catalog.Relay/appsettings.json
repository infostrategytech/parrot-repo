{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Catalog": {
    "ConnectionStrings": {
      "Relay": ""
    },
    "Cache": {
      "Provider": "Memory",
      "RedisConnectionString": ""
    },
    "Relay": {
      "Bus": "Kafka",
      "BootstrapServers": "localhost:9092",
      "Topic": "catalog.events",
      "ItemsTopic": "catalog.items",
      "ConsumerGroupId": "catalog-cache-invalidator",
      "PollIntervalMs": 1000,
      "BatchSize": 100,
      "RetentionDays": 7
    }
  }
}
