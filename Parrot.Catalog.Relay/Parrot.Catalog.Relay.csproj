  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parrot.Catalog.Application\Parrot.Catalog.Application.csproj" />
    <ProjectReference Include="..\Parrot.Catalog.Infrastructure\Parrot.Catalog.Infrastructure.csproj" />
