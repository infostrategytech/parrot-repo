@namespace Parrot.Web.Components.Layout.Landing

@* One public page to read: a title, when it last changed, a short opening, then its sections. *@
<article class="landing-document" aria-labelledby="landing-document-title">
    <header class="landing-document__head">
        <Typography TextStyle="TextStyle.DisplayBold" As="h1" Id="landing-document-title" Prose>@Title</Typography>
        @if (ShowUpdated)
        {
            @* A reviewed document can carry its own dates, and the day it takes effect (the Privacy Policy). *@
            <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="landing-document__muted">@(Effective is { } effective ? $"Effective {effective:d MMMM yyyy} · " : null)Last updated @((Updated ?? LandingCompany.DocumentsUpdated).ToString("d MMMM yyyy"))</Typography>
        }
        @if (Intro is not null)
        {
            <Typography TextStyle="TextStyle.BodyLargeMedium" As="p" Prose Class="landing-document__intro">@Intro</Typography>
        }
    </header>
    <div class="landing-document__body">@ChildContent</div>
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Intro { get; set; }
    [Parameter] public bool ShowUpdated { get; set; } = true;
    /// <summary>This document's own last change, when it differs from the other public documents'.</summary>
    [Parameter] public DateOnly? Updated { get; set; }
    /// <summary>When the document takes effect, for a reviewed legal document that states it.</summary>
    [Parameter] public DateOnly? Effective { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
