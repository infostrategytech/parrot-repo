@namespace Parrot.Web.Components.Layout.Landing
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Concept D's first screen (designer, 17 November 2026; Figma "Sign In · yára", 871:29). The words: chats, one
   inbox, an AI teammate. The picture says the same: the AI teammate standing at the centre of a circle, its
   shadow on the circle's middle, with the apps your customers write from travelling round it, passing behind it
   and coming round the front again. As the page arrives it says hello with the happy turn it does when you press
   and hold it, and the apps pop into orbit as it lands. Every few seconds it becomes another teammate, a new
   shape and colour, because every business gives theirs its own face. With less motion asked for, it stays as
   it is. The picture is decorative; the words say it all for a screen reader. *@
<div class="agent-hero">
    <div class="agent-hero__stage" aria-hidden="true">
        <span class="agent-hero__halo"></span>
        <span class="agent-hero__ring"></span>
        <span class="agent-hero__face">
            <PresenceAvatar Direction="Look.Direction" Tone="Look.Tone" Size="PresenceAvatarSize.Fill" Reactive Floating Greet CueDelay="250" Decorative />
        </span>
        @foreach (var (channel, index) in Channels.Select((c, i) => (c, i)))
        {
            <span class="agent-hero__spot spot-@index">
                <span class="agent-hero__app"><ChannelIcon Channel="@channel" Size="IconSize.Lg" /></span>
            </span>
        }
    </div>

    <div class="agent-hero__words">
        <Typography TextStyle="TextStyle.DisplayBold" As="h1" Prose Class="agent-hero__title">
            @* The teammate wears the agent's colour: as the agent changes, so do the words, and a hand-drawn line
               sweeps in under them once the hello has landed. *@
            One inbox. <span class="agent-hero__accent tone-@Look.Tone.ToString().ToLowerInvariant()">An <span class="agent-hero__mark">AI teammate.<svg class="agent-hero__swoosh" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 8.5C48 3.5 112 2.5 197 6.5" pathLength="1" /></svg></span></span><br />More time for your business.
        </Typography>
        <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose Class="agent-hero__lead">
            Bring your WhatsApp, Instagram, TikTok and Facebook chats together. Let your AI answer everyday questions,
            capture orders and bookings, and bring you in when needed.
        </Typography>
    </div>

    <div class="agent-hero__actions">
        @* The form beside this is already the way in, so the first button is the app, quieter than Create Account so the two never compete (designer, 17 November 2026).
           It opens a small menu of the two stores; until the app is published they say "Coming soon". *@
        @if (!HasPublishedApp)
        {
            <span class="agent-hero__download agent-hero__coming-soon">
                <span class="agent-hero__stores" aria-hidden="true">@AppleMark<i></i>@PlayMark</span>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="span">Mobile app coming soon</Typography>
            </span>
        }
        else
        {
        <span class="agent-hero__download">
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Medium" aria-haspopup="menu" aria-expanded="@(_appsOpen ? "true" : "false")" @onclick="() => _appsOpen = !_appsOpen">
                <span class="agent-hero__app-label"><span class="agent-hero__stores" aria-hidden="true">@AppleMark<i></i>@PlayMark</span>Download app</span>
            </Button>
            @if (_appsOpen)
            {
                @* A full-screen click-away behind the menu, as on the logo's menu. *@
                <button type="button" class="agent-hero__dismiss" tabindex="-1" aria-hidden="true" @onclick="() => _appsOpen = false"></button>
                <span class="agent-hero__stores-menu" role="menu" aria-label="Download the yára app" @onkeydown="@(e => { if (e.Key == "Escape") _appsOpen = false; })">
                    @StoreItem(AppleMark, "App Store", "iPhone and iPad", LandingCompany.AppStoreUrl)
                    @StoreItem(PlayMark, "Google Play", "Android phones", LandingCompany.PlayStoreUrl)
                </span>
            }
        </span>
        }
        @* The page's own address plus the section: a bare #link resolves against the site's base (/) and would leave. *@
        <a class="agent-hero__see" href="@(Nav.Uri.Split('#')[0])#meet-yara"><Typography TextStyle="TextStyle.BodyDefaultSemibold" As="span">See yára in action</Typography></a>
    </div>

    @* Who owns yára, on the first screen: the company's logo, where Meta's reviewer and every visitor sees it
       without scrolling. *@
    <div class="agent-hero__owner">
        <LandingOwner Large />
    </div>
</div>

@code {
    // Spaced evenly round the orbit and arriving in this order: WhatsApp leads, then Instagram (designer, 17 November 2026).
    private static readonly string[] Channels = ["whatsapp", "instagram", "tiktok", "facebook"];

    // The teammates it becomes, in turn: a new shape and a new colour each time, all bright enough to stand out
    // against the sky and the night.
    private static readonly AvatarAppearance[] Looks =
    [
        new(PresenceAvatarDirection.Pip, PresenceAvatarTone.Amber),
        new(PresenceAvatarDirection.Bloom, PresenceAvatarTone.Violet),
        new(PresenceAvatarDirection.Luma, PresenceAvatarTone.Coral),
        new(PresenceAvatarDirection.Dot, PresenceAvatarTone.Green),
        new(PresenceAvatarDirection.Fig, PresenceAvatarTone.Fuchsia),
        new(PresenceAvatarDirection.Bo, PresenceAvatarTone.Orange),
        new(PresenceAvatarDirection.Ripple, PresenceAvatarTone.Indigo),
        new(PresenceAvatarDirection.Echo, PresenceAvatarTone.Teal),
    ];

    // Long enough to watch it be itself for a moment; the first change waits for the hello to finish.
    private static readonly TimeSpan Every = TimeSpan.FromSeconds(6);

    private bool _appsOpen;
    private bool HasPublishedApp => !string.IsNullOrWhiteSpace(LandingCompany.AppStoreUrl)
        || !string.IsNullOrWhiteSpace(LandingCompany.PlayStoreUrl);

    // Apple's and Google Play's own marks: third-party brand marks, drawn as published, in the colour around them.
    private static RenderFragment AppleMark => @<svg class="agent-hero__store-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" /></svg>;
    private static RenderFragment PlayMark => @<svg class="agent-hero__store-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z" /></svg>;

    // One store in the menu: a link once the app is listed there, a quiet "Coming soon" until then.
    private static RenderFragment StoreItem(RenderFragment mark, string store, string devices, string? url) => url is not null
        ? @<a class="agent-hero__store" role="menuitem" href="@url" target="_blank" rel="noopener">@mark<span><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@store</Typography><Typography TextStyle="TextStyle.Small12Medium" As="small">@devices</Typography></span></a>
        : @<span class="agent-hero__store is-soon" role="menuitem" aria-disabled="true">@mark<span><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@store</Typography><Typography TextStyle="TextStyle.Small12Medium" As="small">Coming soon</Typography></span></span>;

    private int _look;
    private AvatarAppearance Look => Looks[_look];
    private CancellationTokenSource? _cycle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/landing.js");
            if (await module.InvokeAsync<bool>("prefersStill")) return;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException) { return; }
        _cycle = new CancellationTokenSource();
        _ = CycleAsync(_cycle.Token);
    }

    private async Task CycleAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(Every);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                _look = (_look + 1) % Looks.Length;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public ValueTask DisposeAsync()
    {
        _cycle?.Cancel();
        _cycle?.Dispose();
        return ValueTask.CompletedTask;
    }
}
