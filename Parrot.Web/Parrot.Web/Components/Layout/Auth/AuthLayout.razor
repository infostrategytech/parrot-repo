@inherits LayoutComponentBase

@* The signed-out stage for Sign In and Sign Up: the brand in the corner, the
   theme switch opposite it, and two columns. The left one rotates through what
   OmniAI does, with a glow that cross-fades in the matching colour; the right
   one is the page's form. Below 1180px the columns share the width, and on a
   phone the story moves above the form. *@

<main class="account-access-page">
    <AuthGlow />

    <header class="account-access-header">
        <LogoDownloadMenu>
            <a class="account-access-brand" href="/login" aria-label="OmniAI home">
                <CadenceMark Size="26" Tight />
                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="span">OmniAI</Typography>
            </a>
        </LogoDownloadMenu>
        <ThemeToggle Inline />
    </header>

    <section class="account-access-content">
        <div class="account-access-story" aria-label="What OmniAI helps your business do">
            <div class="account-access-story__rotation">
                <article class="account-access-story__item story-cyan">
                    <Typography TextStyle="TextStyle.DisplayBold" As="h2" Prose>
                        Turn Messages Into Clear Next Steps
                    </Typography>
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                        Capture orders, bookings and customer requests directly from every conversation.
                    </Typography>
                </article>

                <article class="account-access-story__item story-violet">
                    <Typography TextStyle="TextStyle.DisplayBold" As="h2" Prose>
                        Let AI Handle Repetitive Questions
                    </Typography>
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                        Give customers helpful answers using knowledge approved by your business.
                    </Typography>
                </article>

                <article class="account-access-story__item story-amber">
                    <Typography TextStyle="TextStyle.DisplayBold" As="h2" Prose>
                        Know When Your Attention Is Needed
                    </Typography>
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                        Bring payments, unanswered questions and important requests to the right person.
                    </Typography>
                </article>

                <article class="account-access-story__item story-pink">
                    <Typography TextStyle="TextStyle.DisplayBold" As="h2" Prose>
                        Keep Customer Conversations Together
                    </Typography>
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                        Manage WhatsApp, Instagram and Facebook messages from one shared inbox.
                    </Typography>
                </article>
            </div>

            <div class="account-access-story__progress" aria-hidden="true">
                <i></i><i></i><i></i><i></i>
            </div>
        </div>

        <div class="account-access-form-panel">
            @Body
        </div>
    </section>
</main>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
