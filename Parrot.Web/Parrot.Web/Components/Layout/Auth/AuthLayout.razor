@inherits LayoutComponentBase
@using Parrot.Web.Components.Layout.Landing
@inject NavigationManager Nav

@* Public yára website and existing sign-in/sign-up forms. Concept D is the
   production presentation; design comparisons and local reset tools stay local.
   Internal composition classes retain their existing CSS hooks. *@
<main class="account-access-page is-concept-b is-concept-d">
    <AuthGlow />
    <LandingSky />
    <LandingHeader Page="@Page" HasSections />

    <section class="account-access-content">
        <div class="account-access-story is-hero">
            <LandingAgentHero />
        </div>
        <div class="account-access-form-panel" data-landing-form>
            <CascadingValue TValue="bool" Name="HasMarketingHero" Value="true">@Body</CascadingValue>
        </div>
    </section>

    <LandingAgentIntroduction />
    <LandingBusinessKnowledge />
    <LandingWorkForward />
    <LandingHumanControl />
    <LandingHowItWorks />
    <LandingFaq />
    <LandingAgentClosing />
    <LandingFooter />
</main>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string Page => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/') is var path
        && (path.Length == 0 || path.StartsWith("register", StringComparison.OrdinalIgnoreCase)) ? "signup" : "signin";
}
