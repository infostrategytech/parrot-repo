@inherits LayoutComponentBase
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject NavigationManager Nav
@inject Parrot.Web.Services.InboxUnreadState Unread
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskStore Tasks
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskQuestions TaskQuestions
@inject Parrot.Web.Features.Dashboard.Workspace.WorkspaceClient Workspaces
@inject Parrot.Web.Features.Dashboard.Team.PendingInvite PendingInvite
@inject Parrot.Web.Features.Dashboard.Workspace.WorkspacePrompt WorkspacePrompt
@inject Parrot.SharedComponents.Services.ToastService Toasts
@inject Parrot.Web.Components.Pages.Dashboard.Settings.SettingsReturn SettingsReturn
@inject Parrot.Web.Features.Profile.IProfilePhoto Photo
@implements IDisposable

@* Aurora's shell, fed by Parrot's session. The rail, the workspace switcher
   and the account card come from the shared component library; this layout
   says who is signed in, which workspaces they can switch to, and what the
   account menu does. *@

<ActivityBar />

<AppShell BrandName="yára"
          UsePageBackground
          WorkspaceId="@(AuthState.CurrentUser?.CurrentWorkspaceId ?? "")"
          WorkspaceName="@(AuthState.CurrentUser?.BusinessName ?? "")"
          WorkspaceLogoUrl="@AuthState.CurrentUser?.LogoUrl"
          Workspaces="@_workspaces"
          OnWorkspaceSwitch="SwitchWorkspaceAsync"
          OnWorkspaceAdd="WorkspacePrompt.RequestCreate"
          WorkspaceSwitching="@_switching"
          OnWorkspaceSetDefault="SetDefaultWorkspaceAsync"
          IsAllowed="CanOpen"
          UserName="@(AuthState.CurrentUser?.Email ?? "")"
          UserInitials="@Initials.From(AuthState.CurrentUser?.Email)"
          UserSeed="@UserSeed"
          UserImageUrl="@Photo.Url"
          InboxUnread="@Unread.Total"
          TasksNeedYou="@_tasksNeedYou"
          ShowThemeToggle="false">
    <RailNotifications><Parrot.Web.Components.Layout.Notifications.NotificationsBell /></RailNotifications>
    <BusinessMenu>
        @* The business's own settings and people, under its name (designer, 11 November 2026). Each opens the one
           Settings page at its section; a teammate sees only what their role reaches. *@
        @if (CanBusiness)
        {
            <UserMenuItem Label="Business settings" Glyph="IconName.RiStore2Fill" Href="/dashboard/settings/business" />
        }
        @if (CanTeam)
        {
            <UserMenuItem Label="Team" Glyph="IconName.RiTeamFill" Href="/dashboard/settings/team" />
            <UserMenuItem Label="Invite people" Glyph="IconName.RiUserAddFill" Href="/dashboard/settings/team?invite=1" />
        }
        @if (CanBusiness)
        {
            <UserMenuItem Label="Plan & billing" Glyph="IconName.RiBankCardFill" Href="/dashboard/settings/billing" />
        }
    </BusinessMenu>
    <UserMenu>
        @* Who you are, and signing out (designer, 1 November 2026). The business's settings and people are under its
           name at the top (11 November 2026); Settings here opens the same page at your own sections. *@
        <UserMenuItem Label="Your profile" Glyph="IconName.RiUser3Fill" Href="/dashboard/settings/profile" />
        <UserMenuItem Label="Settings" Glyph="NavMap.Settings.Glyph" Href="@NavMap.Settings.Path" />
        @* Help moved here from the rail, to make room for notifications (designer, 3 November 2026). Not built yet. *@
        <UserMenuItem Label="Help Centre" Glyph="IconName.RiQuestionFill" Disabled />
        <UserMenuItem Label="@(_loggingOut ? "Signing out…" : "Sign out")"
                      Glyph="IconName.RiUserSharedFill"
                      Danger
                      Disabled="@_loggingOut"
                      OnClick="LogoutAsync" />
        @if (_logoutError is not null)
        {
            <InlineError Message="@_logoutError" />
        }
    </UserMenu>
    <ChildContent>
        @* Pages the person's role does not reach never get here: the router
           swaps them for the no-access screen (RequiresAccessAttribute). *@
        @Body
    </ChildContent>
</AppShell>
<Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="web-task-question-modal" />
@* The open chat's own dialog (Answer or correct the agent), apart from the task dialogs so both can exist at once. *@
<Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="web-chat-modal" />

@* New notifications pop up here, or come from the browser when yára is in another tab. *@
<Parrot.Web.Components.Layout.Notifications.NotificationPopupHost />

@* Naming a new account's workspace, and making another from the switcher. *@
<Parrot.Web.Components.Pages.Dashboard.Dashboard.WorkspaceWelcome />
@* Joined from an invite: the business welcomes them once. *@
<Parrot.Web.Components.Pages.Dashboard.Dashboard.TeamWelcome />

@* Before an agent: a channel for it to answer on, then, the first time, a
   few lines about the business. Teach your AI is "Teach more" from an agent. *@
<Parrot.Web.Components.Pages.Dashboard.AiAgents.AgentChannelGate />
<Parrot.Web.Components.Pages.Dashboard.TeachAi.BusinessIntroDialog />
<Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiOverlay />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _loggingOut;
    private string? _logoutError;
    private bool _switching;
    private IReadOnlyList<WorkspaceOption>? _workspaces;

    // A stable seed, so the person keeps one avatar tint everywhere they
    // appear. A workspace is seeded by its own id, in the switcher.
    private string UserSeed => AuthState.CurrentUser?.UserId ?? "user";

    protected override void OnInitialized()
    {
        AuthState.OnChange += AuthChanged;
        Unread.Changed += UnreadChanged;
        Tasks.Changed += TasksChanged;
        TaskQuestions.Changed += TasksChanged;
        // Where Settings' "Back to app" returns: the last page here before it opened.
        SettingsReturn.Remember(Nav.Uri);
        Nav.LocationChanged += Moved;
        // Your own photo on the account, kept current when Profile changes it.
        Photo.Changed += PhotoChanged;
        _ = Photo.ReadAsync().ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);
    }

    private void PhotoChanged() => _ = InvokeAsync(StateHasChanged);

    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => SettingsReturn.Remember(args.Location);

    // The rail's inbox badge is the number of unread customer messages. It is kept here, not by
    // the inbox page, so it is right on every dashboard page and moves on live pushes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // An invite opened before signing in: back to it, now that there is a session to accept it with.
        if (AuthState.IsAuthenticated && await PendingInvite.TakeAsync() is { } invite)
        {
            // "resume": they already chose Accept in the email, so the page joins on its own.
            Nav.NavigateTo($"/invite/{Uri.EscapeDataString(invite)}?resume=true", replace: true);
            return;
        }

        await RefreshAccessAsync();
        await Unread.StartAsync();
        await CountTasksAsync();
        await LoadWorkspacesAsync();
    }

    // The pin in the switcher: always open this workspace on sign-in, or (null) resume where you left off.
    private async Task SetDefaultWorkspaceAsync(string? workspaceId)
    {
        try
        {
            await Workspaces.SetDefaultAsync(workspaceId);
            string? name = _workspaces?.FirstOrDefault(w => w.Id == workspaceId)?.Name;
            Toasts.Show(name is null ? "You will come back where you left off" : $"{name} opens when you sign in");
            await LoadWorkspacesAsync();
        }
        catch (Exception)
        {
            Toasts.ShowError("We could not change where you sign in. Try again.");
        }
    }

    // The business menu's rows, by the same rules as the Settings sections they open.
    private bool CanBusiness => AuthState.CurrentUser?.Allows(AccessRules.Business) ?? false;
    private bool CanTeam => AuthState.CurrentUser?.Allows(AccessRules.Team) ?? false;

    // The owner opens everything; a member, what their role allows. The API
    // enforces the same rules; this keeps the rail to what can be used.
    private bool CanOpen(NavEntry entry) =>
        entry.AnyPermission is null
        || AuthState.CurrentUser is not { } user
        || user.IsOwner
        || entry.AnyPermission.Any(user.Can);

    // The token's copy of the role can be older than the grant: read the grant.
    private async Task RefreshAccessAsync()
    {
        if (!AuthState.IsAuthenticated) return;
        try
        {
            await Workspaces.RefreshAccessAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            // The rail keeps what the session already says; the API still checks each request.
        }
    }

    // The switcher's list. Unnamed workspaces are left out: one is only
    // unnamed until its welcome card is done, and that is the current one.
    private async Task LoadWorkspacesAsync()
    {
        if (!AuthState.IsAuthenticated) return;
        try
        {
            IReadOnlyList<Parrot.Web.Features.Dashboard.Workspace.WorkspaceSummary> listed = await Workspaces.ListAsync();

            // The session's workspace is no longer listed: the owner removed this person
            // from it. Move to one they can still reach rather than failing on every page.
            if (listed.Count > 0 && !listed.Any(w => w.IsCurrent) && !_switching)
            {
                Toasts.ShowError("You no longer have access to that workspace.");
                await SwitchWorkspaceAsync(listed[0].Id);
                return;
            }
            _workspaces = listed
                .Where(w => !string.IsNullOrWhiteSpace(w.Name))
                // Your own carry no tag (designer, 9 November 2026: "Owner" on every row said nothing); another
                // business's carry your role there, in the Team page's plain words.
                .Select(w => w.Role == "Owner"
                    ? new WorkspaceOption(w.Id, w.Name!, w.LogoUrl, null, null, w.IsDefault)
                    : new WorkspaceOption(w.Id, w.Name!, w.LogoUrl, Parrot.Web.Features.Dashboard.Team.TeamWords.RoleNameFromApi(w.Role), w.TeamName ?? w.Name!, w.IsDefault))
                .ToList();
            StateHasChanged();
        }
        catch (Exception)
        {
            // The switcher still shows the current workspace; it simply offers no others.
            _workspaces = null;
        }
    }

    private async Task SwitchWorkspaceAsync(string workspaceId)
    {
        if (_switching) return;
        _switching = true;
        try
        {
            await Workspaces.SwitchAsync(workspaceId);
            // A fresh circuit, so nothing the old workspace loaded (its inbox,
            // agents, channels, live connection) is carried into the new one.
            Nav.NavigateTo("/dashboard", forceLoad: true, replace: true);
        }
        catch (Exception)
        {
            _switching = false;
            Toasts.ShowError("We could not switch workspaces. Try again.");
        }
    }

    // The rail's Tasks badge: everything that needs the business now. Kept here for the same reason as the inbox's.
    private int? _tasksNeedYou;

    private async Task CountTasksAsync()
    {
        if (!Tasks.Available) return;
        try
        {
            // With a team, what's yours or nobody's yet; alone, everything that needs acting on.
            var team = await Tasks.TeamAsync();
            var me = Tasks.Me.Id;
            var questions = await TaskQuestions.ListAsync();
            var count = (await Tasks.ListAsync()).Count(task => (task.NeedsAction && (team.Count < 2 || task.Assignee is null || task.Assignee.Id == me))
                || questions.Any(q => q.TaskId == task.Id && q.Waits(me)));
            _tasksNeedYou = count == 0 ? null : count;
        }
        // A count that can't be read shows none: it must never take the page down with it.
        catch (Exception exception) when (Parrot.Web.Features.Dashboard.AiAgents.State.AiAgentsState.IsFailure(exception)) { _tasksNeedYou = null; }
        StateHasChanged();
    }

    private void TasksChanged() => _ = InvokeAsync(CountTasksAsync);

    private void UnreadChanged() => _ = InvokeAsync(StateHasChanged);

    // Signing in starts the count; signing out clears it. A renamed workspace
    // shows its new name in the list too.
    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        await Unread.StartAsync();
        if (!AuthState.IsAuthenticated) Unread.Set(0);
        await LoadWorkspacesAsync();
        StateHasChanged();
    });

    private async Task LogoutAsync()
    {
        if (_loggingOut) return;
        _loggingOut = true;
        _logoutError = null;
        try
        {
            // Remove persisted credentials before navigating so refresh cannot restore the session.
            await TokenStorage.ClearAsync();
            AuthState.ClearUser();
            // A fresh circuit also clears user-specific scoped dashboard state.
            Nav.NavigateTo("/login", forceLoad: true, replace: true);
        }
        catch (JSException)
        {
            _logoutError = "Could not clear your saved session. Please try signing out again.";
        }
        finally
        {
            _loggingOut = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= AuthChanged;
        Unread.Changed -= UnreadChanged;
        Tasks.Changed -= TasksChanged;
        TaskQuestions.Changed -= TasksChanged;
        Nav.LocationChanged -= Moved;
        Photo.Changed -= PhotoChanged;
    }
}
