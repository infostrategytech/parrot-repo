@inherits LayoutComponentBase
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject NavigationManager Nav
@inject Parrot.Web.Services.InboxUnreadState Unread
@inject Parrot.Web.Features.Dashboard.Workspace.WorkspaceCreationState WorkspaceCreation
@inject Parrot.Web.Features.Dashboard.Workspace.WorkspaceDirectoryState WorkspaceDirectory
@implements IDisposable

@* Aurora's shell, fed by Parrot's session. The rail, the workspace switcher
   and the account card come from the shared component library; this layout
   only says who is signed in and what the account menu does. *@

<ActivityBar />

<AppShell BrandName="OmniAI"
          WorkspaceId="@WorkspaceId"
          WorkspaceName="@WorkspaceName"
          WorkspaceLogoUrl="@WorkspaceLogoUrl"
          Workspaces="@WorkspaceDirectory.Workspaces"
          ActiveWorkspaceId="@WorkspaceDirectory.Active?.Id"
          OnSelectWorkspace="SelectWorkspace"
          OnAddWorkspace="OpenWorkspaceCreation"
          UserName="@(AuthState.CurrentUser?.Email ?? "")"
          UserInitials="@Initials.From(AuthState.CurrentUser?.Email)"
          UserSeed="@UserSeed"
          InboxUnread="@Unread.Total">
    <UserMenu>
        <UserMenuItem Label="Settings" Glyph="IconName.RiSettings4Fill" Href="/dashboard/settings" />
        <UserMenuItem Label="Team" Glyph="IconName.RiTeamFill" Href="/dashboard/team" />
        <UserMenuItem Label="Business setup" Glyph="IconName.RiStore2Fill" Href="/dashboard/business-setup" />
        <UserMenuItem Label="@(_loggingOut ? "Signing out…" : "Sign out")"
                      Glyph="IconName.RiUserSharedFill"
                      Danger
                      Disabled="@_loggingOut"
                      OnClick="LogoutAsync" />
        @if (_logoutError is not null)
        {
            <InlineError Message="@_logoutError" />
        }
    </UserMenu>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>

@* One workspace dialog for the whole dashboard. The rail can start it from
   any page, and first-time accounts see the same experience automatically. *@
<Parrot.Web.Components.Pages.Dashboard.Dashboard.WorkspaceWelcome />

@* Before an agent: a channel for it to answer on, then, the first time, a
   few lines about the business. Teach your AI is "Teach more" from an agent. *@
<Parrot.Web.Components.Pages.Dashboard.AiAgents.AgentChannelGate />
<Parrot.Web.Components.Pages.Dashboard.TeachAi.BusinessIntroDialog />
<Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiOverlay />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _loggingOut;
    private string? _logoutError;

    // Stable seeds, so the business and the person keep one avatar tint
    // everywhere they appear. The user id is the seed for the person; the
    // business has no id of its own in the session, so its name stands in.
    private string UserSeed => AuthState.CurrentUser?.UserId ?? "user";
    private string WorkspaceId => WorkspaceDirectory.Active?.Id ?? "workspace-" + (AuthState.CurrentUser?.BusinessName ?? "");
    private string WorkspaceName => WorkspaceDirectory.Active?.Name ?? AuthState.CurrentUser?.BusinessName ?? "";
    private string? WorkspaceLogoUrl => WorkspaceDirectory.Active?.LogoUrl ?? AuthState.CurrentUser?.LogoUrl;

    private void OpenWorkspaceCreation() => WorkspaceCreation.OpenAdditionalWorkspace();

    private void SelectWorkspace(string id)
    {
        if (WorkspaceDirectory.Select(id)) Nav.NavigateTo("/dashboard");
    }

    protected override void OnInitialized()
    {
        WorkspaceDirectory.Sync(AuthState.CurrentUser);
        AuthState.OnChange += AuthChanged;
        WorkspaceDirectory.Changed += WorkspaceChanged;
        Unread.Changed += UnreadChanged;
    }

    // The rail's inbox badge is the number of unread customer messages. It is kept here, not by
    // the inbox page, so it is right on every dashboard page and moves on live pushes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Unread.StartAsync();
    }

    private void UnreadChanged() => _ = InvokeAsync(StateHasChanged);

    private void WorkspaceChanged() => _ = InvokeAsync(StateHasChanged);

    // Signing in starts the count; signing out clears it.
    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        WorkspaceDirectory.Sync(AuthState.CurrentUser);
        await Unread.StartAsync();
        if (!AuthState.IsAuthenticated) Unread.Set(0);
        StateHasChanged();
    });

    private async Task LogoutAsync()
    {
        if (_loggingOut) return;
        _loggingOut = true;
        _logoutError = null;
        try
        {
            // Remove persisted credentials before navigating so refresh cannot restore the session.
            await TokenStorage.ClearAsync();
            AuthState.ClearUser();
            // A fresh circuit also clears user-specific scoped dashboard state.
            Nav.NavigateTo("/login", forceLoad: true, replace: true);
        }
        catch (JSException)
        {
            _logoutError = "Could not clear your saved session. Please try signing out again.";
        }
        finally
        {
            _loggingOut = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= AuthChanged;
        WorkspaceDirectory.Changed -= WorkspaceChanged;
        Unread.Changed -= UnreadChanged;
    }
}
