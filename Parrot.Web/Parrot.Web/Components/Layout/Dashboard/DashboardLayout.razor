@inherits LayoutComponentBase
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject NavigationManager Nav
@inject Parrot.Web.Services.InboxUnreadState Unread
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskStore Tasks
@inject Parrot.Web.Features.Dashboard.Workspace.WorkspaceClient Workspaces
@inject Parrot.Web.Features.Dashboard.Workspace.WorkspacePrompt WorkspacePrompt
@inject Parrot.SharedComponents.Services.ToastService Toasts
@implements IDisposable

@* Aurora's shell, fed by Parrot's session. The rail, the workspace switcher
   and the account card come from the shared component library; this layout
   says who is signed in, which workspaces they can switch to, and what the
   account menu does. *@

<ActivityBar />

<AppShell BrandName="OmniAI"
          WorkspaceId="@(AuthState.CurrentUser?.CurrentWorkspaceId ?? "")"
          WorkspaceName="@(AuthState.CurrentUser?.BusinessName ?? "")"
          WorkspaceLogoUrl="@AuthState.CurrentUser?.LogoUrl"
          Workspaces="@_workspaces"
          OnWorkspaceSwitch="SwitchWorkspaceAsync"
          OnWorkspaceAdd="WorkspacePrompt.RequestCreate"
          WorkspaceSwitching="@_switching"
          UserName="@(AuthState.CurrentUser?.Email ?? "")"
          UserInitials="@Initials.From(AuthState.CurrentUser?.Email)"
          UserSeed="@UserSeed"
          InboxUnread="@Unread.Total"
          TasksNeedYou="@_tasksNeedYou">
    <UserMenu>
        <UserMenuItem Label="Settings" Glyph="IconName.RiSettings4Fill" Href="/dashboard/settings" />
        <UserMenuItem Label="Team" Glyph="IconName.RiTeamFill" Href="/dashboard/team" />
        <UserMenuItem Label="Business setup" Glyph="IconName.RiStore2Fill" Href="/dashboard/business-setup" />
        <UserMenuItem Label="@(_loggingOut ? "Signing out…" : "Sign out")"
                      Glyph="IconName.RiUserSharedFill"
                      Danger
                      Disabled="@_loggingOut"
                      OnClick="LogoutAsync" />
        @if (_logoutError is not null)
        {
            <InlineError Message="@_logoutError" />
        }
    </UserMenu>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>

@* Naming a new account's workspace, and making another from the switcher. *@
<Parrot.Web.Components.Pages.Dashboard.Dashboard.WorkspaceWelcome />

@* Before an agent: a channel for it to answer on, then, the first time, a
   few lines about the business. Teach your AI is "Teach more" from an agent. *@
<Parrot.Web.Components.Pages.Dashboard.AiAgents.AgentChannelGate />
<Parrot.Web.Components.Pages.Dashboard.TeachAi.BusinessIntroDialog />
<Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiOverlay />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _loggingOut;
    private string? _logoutError;
    private bool _switching;
    private IReadOnlyList<WorkspaceOption>? _workspaces;

    // A stable seed, so the person keeps one avatar tint everywhere they
    // appear. A workspace is seeded by its own id, in the switcher.
    private string UserSeed => AuthState.CurrentUser?.UserId ?? "user";

    protected override void OnInitialized()
    {
        AuthState.OnChange += AuthChanged;
        Unread.Changed += UnreadChanged;
        Tasks.Changed += TasksChanged;
    }

    // The rail's inbox badge is the number of unread customer messages. It is kept here, not by
    // the inbox page, so it is right on every dashboard page and moves on live pushes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Unread.StartAsync();
        await CountTasksAsync();
        await LoadWorkspacesAsync();
    }

    // The switcher's list. Unnamed workspaces are left out: one is only
    // unnamed until its welcome card is done, and that is the current one.
    private async Task LoadWorkspacesAsync()
    {
        if (!AuthState.IsAuthenticated) return;
        try
        {
            IReadOnlyList<Parrot.Web.Features.Dashboard.Workspace.WorkspaceSummary> listed = await Workspaces.ListAsync();
            _workspaces = listed
                .Where(w => !string.IsNullOrWhiteSpace(w.Name))
                .Select(w => new WorkspaceOption(w.Id, w.Name!, w.LogoUrl))
                .ToList();
            StateHasChanged();
        }
        catch (Exception)
        {
            // The switcher still shows the current workspace; it simply offers no others.
            _workspaces = null;
        }
    }

    private async Task SwitchWorkspaceAsync(string workspaceId)
    {
        if (_switching) return;
        _switching = true;
        try
        {
            await Workspaces.SwitchAsync(workspaceId);
            // A fresh circuit, so nothing the old workspace loaded (its inbox,
            // agents, channels, live connection) is carried into the new one.
            Nav.NavigateTo("/dashboard", forceLoad: true, replace: true);
        }
        catch (Exception)
        {
            _switching = false;
            Toasts.ShowError("We could not switch workspaces. Try again.");
        }
    }

    // The rail's Tasks badge: everything that needs the business now. Kept here for the same reason as the inbox's.
    private int? _tasksNeedYou;

    private async Task CountTasksAsync()
    {
        if (!Tasks.Available) return;
        // With a team, what's yours or nobody's yet; alone, everything that needs acting on.
        var team = await Tasks.TeamAsync();
        var me = Tasks.Me.Id;
        var count = (await Tasks.ListAsync()).Count(task => task.NeedsAction && (team.Count < 2 || task.Assignee is null || task.Assignee.Id == me));
        _tasksNeedYou = count == 0 ? null : count;
        StateHasChanged();
    }

    private void TasksChanged() => _ = InvokeAsync(CountTasksAsync);

    private void UnreadChanged() => _ = InvokeAsync(StateHasChanged);

    // Signing in starts the count; signing out clears it. A renamed workspace
    // shows its new name in the list too.
    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        await Unread.StartAsync();
        if (!AuthState.IsAuthenticated) Unread.Set(0);
        await LoadWorkspacesAsync();
        StateHasChanged();
    });

    private async Task LogoutAsync()
    {
        if (_loggingOut) return;
        _loggingOut = true;
        _logoutError = null;
        try
        {
            // Remove persisted credentials before navigating so refresh cannot restore the session.
            await TokenStorage.ClearAsync();
            AuthState.ClearUser();
            // A fresh circuit also clears user-specific scoped dashboard state.
            Nav.NavigateTo("/login", forceLoad: true, replace: true);
        }
        catch (JSException)
        {
            _logoutError = "Could not clear your saved session. Please try signing out again.";
        }
        finally
        {
            _loggingOut = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= AuthChanged;
        Unread.Changed -= UnreadChanged;
        Tasks.Changed -= TasksChanged;
    }
}
