<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <script>
      // Set the theme before first paint so the app never flashes the wrong
      // colours on the way in. Settings, Preferences (and the sign-in pages'
      // ThemeToggle) change it from then on. "system" follows the device, also
      // while yára is open (designer, 1 November 2026).
      (function () {
        var key = "aurora-theme-preview", pick = "aurora-light";
        var dark = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
        var apply = function () {
          document.documentElement.dataset.theme = pick === "system" ? (dark && dark.matches ? "aurora-dark" : "aurora-light") : pick;
        };
        try { var saved = localStorage.getItem(key); if (saved) pick = saved; } catch (error) { }
        apply();
        if (dark && dark.addEventListener) dark.addEventListener("change", function () { if (pick === "system") apply(); });
        window.yaraTheme = {
          get: function () { return pick; },
          set: function (value) { pick = value; try { localStorage.setItem(key, value); } catch (error) { } apply(); }
        };
      })();
    </script>

    @* The two faces the first paint needs, requested alongside the CSS rather
       than after it is parsed: Figtree for the signed-out screens, Geist for
       the product. Paths must match the url() in the stylesheets exactly or
       the browser downloads each twice. The interop module is fetched early
       too, since the shell imports it on first render. *@
    <link rel="preload" as="font" type="font/woff2" crossorigin href="_content/Parrot.SharedComponents/cadence/fonts/figtree-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="_content/Parrot.SharedComponents/fonts/geist-latin-wght-normal.woff2" />
    <link rel="modulepreload" href="_content/Parrot.SharedComponents/js/aurora-interop.js" />

    @* Keeps what is typed or autofilled before the page is live, for the live
       fields to take over (see early-input.js). In the head, not deferred, so
       it is listening before the first key. *@
    <script src="@Assets["_content/Parrot.SharedComponents/js/early-input.js"]"></script>

    @* Tokens first: they define the variables everything else resolves against. *@
    <link rel="stylesheet" href="@Assets["_content/Parrot.SharedComponents/css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Parrot.SharedComponents/css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Parrot.SharedComponents/css/typography.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Parrot.SharedComponents/css/app.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Parrot.SharedComponents/css/cadence.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Parrot.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="alternate icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_content/Parrot.SharedComponents/js/nav-pending.js"]" defer></script>
    <script src="@Assets["_content/Parrot.SharedComponents/js/feedback.js"]" defer></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
