@inject NavigationManager Nav
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject PasswordResetSignOut ResetSignOut
@implements IDisposable

<WorkspaceCurrencyProvider>
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @if (IsPublicPath() || (_ready && !_endingSession && AuthState.IsAuthenticated))
        {
            @* A page the person's role does not reach is never rendered: the
               no-access screen takes its place, in the same layout. *@
            <RouteView RouteData="Permitted(routeData)" DefaultLayout="typeof(Layout.Dashboard.DashboardLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
        else
        {
            <SessionSplash />
        }
    </Found>
</Router>
</WorkspaceCurrencyProvider>

@code {
    private static readonly HashSet<string> PublicPaths =
    [
        "/", "/login", "/register", "/forgot-password", "/reset-password", PasswordResetSignOut.CompletePath,
        "/verify-email", "/sso-callback", "/error", "/not-found",
        // The two-factor code, between the password (or Google) and the session.
        "/verify-sign-in",
        // Sign Up links to these before anyone has an account.
        "/terms", "/privacy",
    ];
    private readonly CancellationTokenSource _lifetime = new();
    private bool _ready, _endingSession, _disposed;

    // The page's RequiresAccess rule, checked against the session before it renders.
    private RouteData Permitted(RouteData routeData)
    {
        if (System.Reflection.CustomAttributeExtensions.GetCustomAttribute<Parrot.Web.Features.Auth.RequiresAccessAttribute>(routeData.PageType) is not { } needs
            || AuthState.CurrentUser is not { } user
            || user.Allows(needs.Rule))
        {
            return routeData;
        }

        return new RouteData(typeof(Pages.NoAccess), new Dictionary<string, object?>());
    }

    private bool IsPublicPath() => PublicPaths.Contains(new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant())
        || new Uri(Nav.Uri).AbsolutePath == "/"
        // An invite link is opened before signing in; the page itself asks for it.
        || new Uri(Nav.Uri).AbsolutePath.StartsWith("/invite/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        AuthState.OnChange += AuthChanged;
        AuthState.SessionExpired += SessionExpired;
        Nav.LocationChanged += LocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (AuthState.CurrentUser is null)
        {
            AuthResponse? stored = await TokenStorage.LoadAsync();
            if (_disposed) return;
            if (stored is not null && AuthState.CurrentUser is null) AuthState.SetUser(stored);
        }
        _ready = true;
        if (TokenStorage.LastLoadExpired || (AuthState.CurrentUser is not null && !AuthState.IsAuthenticated))
        {
            await EndSessionAsync();
            return;
        }
        await EnforceSessionAsync();
        if (!_disposed)
        {
            string path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            if (AuthState.IsAuthenticated && (path == "" || path == "/login"))
                Nav.NavigateTo("/dashboard", replace: true);
            StateHasChanged();
            _ = MonitorExpiryAsync(_lifetime.Token);
        }
    }

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (AuthState.IsAuthenticated) _endingSession = false;
        await EnforceSessionAsync();
        StateHasChanged();
    });

    private void SessionExpired() => _ = InvokeAsync(EndSessionAsync);

    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        await EnforceSessionAsync();
        StateHasChanged();
    });

    private async Task EnforceSessionAsync()
    {
        if (!_ready || _disposed || _endingSession) return;
        if (!AuthState.IsAuthenticated && ResetSignOut.ConfirmationPending)
        {
            if (new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals(PasswordResetSignOut.CompletePath, StringComparison.OrdinalIgnoreCase))
                ResetSignOut.ReachedConfirmation();
            else
                Nav.NavigateTo(PasswordResetSignOut.CompletePath, replace: true);
            return;
        }
        if (AuthState.CurrentUser is not null && !AuthState.IsAuthenticated)
        {
            await EndSessionAsync();
        }
        else if (!AuthState.IsAuthenticated && !IsPublicPath())
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }

    private async Task MonitorExpiryAsync(CancellationToken cancellationToken)
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (!_disposed && AuthState.CurrentUser is not null && !AuthState.IsAuthenticated)
                        await EndSessionAsync();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task EndSessionAsync()
    {
        if (_endingSession || _disposed) return;
        // An expired sign-in must not throw away the email reset link. These recovery routes are already
        // public and still require server-verified reset credentials; every protected route keeps its guard.
        var keepRecovery = PasswordResetHandoff.IsRecoveryPath(new Uri(Nav.Uri).AbsolutePath);
        _endingSession = true;
        AuthState.ClearUser();
        StateHasChanged();
        try
        {
            await TokenStorage.ClearAsync();
            if (keepRecovery)
            {
                _endingSession = false;
                StateHasChanged();
                return;
            }
            // Reset the circuit's user-specific state as well as navigating to sign-in.
            Nav.NavigateTo("/login?sessionExpired=true", forceLoad: true, replace: true);
        }
        catch (JSException)
        {
            if (keepRecovery)
            {
                _endingSession = false;
                StateHasChanged();
                return;
            }
            // A disconnected browser cannot be navigated. Keep the circuit signed out;
            // restoration will reject the expired token when the browser reconnects/reloads.
            Nav.NavigateTo("/login?sessionExpired=true", replace: true);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        AuthState.OnChange -= AuthChanged;
        AuthState.SessionExpired -= SessionExpired;
        Nav.LocationChanged -= LocationChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
