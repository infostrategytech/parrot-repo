@page "/checkout/{Token}"
@layout BareLayout
@using System.Globalization
@using Parrot.Web.Features.Checkout
@inject CheckoutClient Checkouts
@inject NavigationManager Navigation
@inject UserClock Clock
@implements IDisposable

<PageTitle>@(_view is null ? "Checkout" : $"Checkout · {_view.Business}")</PageTitle>

@* The link an agent sends a customer in WhatsApp or Instagram: what they're buying from whom, what it costs now,
   and one button to pay. Opened on a phone, signed out (Routes lets /checkout/ through), so it is the business's
   page, not yára's: no app chrome. The prices come from the API as they are now; when they differ from what the
   business sent, the old one is struck through beside the new.
   After paying, Accelerate sends the customer back here with ?paid=1: the page then waits for the payment to be
   confirmed (the provider's webhook), rather than offering to pay again. *@
<main class="checkout">
    <div class="checkout__panel">
        @if (_invalid)
        {
            <EmptyState Title="This checkout link isn't valid" Glyph="IconName.RiLinksFill"
                        Description="Check you opened the whole link, or ask the business to send you a new one." />
        }
        else if (_view is null && _loadError is not null)
        {
            <EmptyState Title="We couldn't open this checkout" Glyph="IconName.RiErrorWarningFill" Description="@_loadError">
                <Action><Button Variant="ButtonVariant.Secondary" Busy="_loading" @onclick="LoadAsync">Try again</Button></Action>
            </EmptyState>
        }
        else if (_view is null)
        {
            <div class="checkout__loading" aria-busy="true" aria-label="Loading your checkout">
                <Skeleton Shape="SkeletonShape.Circle" Width="var(--spacing-4xl)" Height="var(--spacing-4xl)" />
                <Skeleton Shape="SkeletonShape.Line" Width="60%" Order="1" />
                <Skeleton Shape="SkeletonShape.Block" Order="2" />
                <Skeleton Shape="SkeletonShape.Line" Order="3" />
            </div>
        }
        else
        {
            var view = _view;
            <header class="checkout__head">
                @if (!string.IsNullOrWhiteSpace(view.LogoUrl))
                {
                    <img class="checkout__logo" src="@view.LogoUrl" alt="" />
                }
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1" Prose>@view.Business</Typography>
                @if (!string.IsNullOrWhiteSpace(view.CustomerName))
                {
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p">Hi @view.CustomerName</Typography>
                }
            </header>

            @if (_waiting)
            {
                <section class="checkout__status checkout__status--paying" role="status" aria-busy="true">
                    <span class="checkout__status-icon"><Icon Name="IconName.RiTimerFill" Size="IconSize.Lg" /></span>
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">Finishing your payment…</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>We're waiting for the payment to be confirmed. This usually takes a few seconds.</Typography>
                </section>
            }
            else if (Ended(view.State))
            {
                @* Paid, expired, replaced or no longer available: what happened is the page. A paid one keeps its
                   items, as a receipt. *@
                <section class="@($"checkout__status checkout__status--{view.State}")" role="status">
                    <span class="checkout__status-icon"><Icon Name="@StateGlyph(view.State)" Size="IconSize.Lg" /></span>
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">@StateTitle(view.State)</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@(view.Message ?? StateFallback(view.State))</Typography>
                </section>
            }

            @if (_unconfirmed && view.State != "paid")
            {
                <InlineError Tone="InlineErrorTone.Info" Message="We haven't had confirmation of your payment yet. If you've paid, don't pay again: the business will confirm it with you." />
            }

            @if (!Ended(view.State) || view.State == "paid")
            {
                <section class="checkout__card" aria-label="Your order">
                    <ul class="checkout__lines">
                        @foreach (var line in view.Lines)
                        {
                            <li class="checkout__line">
                                <div class="checkout__item">
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="p" Prose>@line.Name</Typography>
                                    @if (Detail(view, line) is { } detail)
                                    {
                                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="checkout__muted">@detail</Typography>
                                    }
                                </div>
                                <div class="checkout__price">
                                    @if (line.UnitPrice is not { } price)
                                    {
                                        <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Class="checkout__muted">@Money(line.QuotedUnitPrice)</Typography>
                                    }
                                    else
                                    {
                                        @if (line.PriceChanged)
                                        {
                                            <Typography TextStyle="TextStyle.Small12Medium" As="del" Class="checkout__was" aria-label="@($"Was {Money(line.QuotedUnitPrice)}")">@Money(line.QuotedUnitPrice)</Typography>
                                        }
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">@Money(price)</Typography>
                                        @if (line.Quantity > 1 && line.LineTotal is { } lineTotal)
                                        {
                                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="checkout__muted">@($"{Money(lineTotal)} for {line.Quantity}")</Typography>
                                        }
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(line.Problem))
                                {
                                    <div class="checkout__problem"><InlineError Message="@line.Problem" /></div>
                                }
                                @if (Editable(view, line))
                                {
                                    @* How many: down to one, up to what's left; out takes the item off. While a change is
                                       saving, every control waits for it, Pay included. *@
                                    <div class="checkout__qty" role="group" aria-label="@($"How many {line.Name}")">
                                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" aria-label="@($"One fewer {line.Name}")"
                                                disabled="@(_changing || line.Quantity <= 1)" @onclick="() => SetQuantityAsync(line, line.Quantity - 1)">
                                            <IconLeft><Icon Name="IconName.RiSubtractFill" Size="IconSize.Sm" /></IconLeft>
                                        </Button>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="checkout__qty-count" aria-live="polite">@line.Quantity</Typography>
                                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" aria-label="@($"One more {line.Name}")"
                                                title="@(line.Quantity >= line.MaxQuantity ? "No more available" : null)"
                                                disabled="@(_changing || line.Quantity >= line.MaxQuantity)" @onclick="() => SetQuantityAsync(line, line.Quantity + 1)">
                                            <IconLeft><Icon Name="IconName.RiAddFill" Size="IconSize.Sm" /></IconLeft>
                                        </Button>
                                        @if (view.Lines.Count > 1)
                                        {
                                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="checkout__remove" aria-label="@($"Remove {line.Name}")"
                                                    disabled="@_changing" @onclick="() => SetQuantityAsync(line, 0)">
                                                <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" Size="IconSize.Sm" /></IconLeft>
                                                <ChildContent>Remove</ChildContent>
                                            </Button>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>

                    <div class="checkout__total">
                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="span">@(view.State == "paid" ? "Paid" : "Total")</Typography>
                        <div class="checkout__price">
                            @if (view.PriceChanged)
                            {
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="del" Class="checkout__was" aria-label="@($"Was {Money(view.QuotedTotal)}")">@Money(view.QuotedTotal)</Typography>
                            }
                            <Typography TextStyle="TextStyle.HeadingH4Semibold" As="span">@Money(view.Total)</Typography>
                        </div>
                    </div>
                </section>
            }

            @if (!Ended(view.State) && !_waiting)
            {
                <div class="checkout__actions">
                    @* Why the last Pay didn't go through (the total changed, say): above everything else it bears on. *@
                    @if (_notice is not null)
                    {
                        <InlineError Tone="InlineErrorTone.Warning" Message="@_notice" />
                    }
                    @if (!string.IsNullOrWhiteSpace(view.Message) && view.Message != _notice)
                    {
                        <InlineError Tone="@(view.CanPay ? InlineErrorTone.Info : InlineErrorTone.Error)" Message="@view.Message" />
                    }
                    @if (_payError is not null)
                    {
                        <InlineError Message="@_payError" />
                    }

                    @if (view.State == "paying")
                    {
                        @if (!string.IsNullOrWhiteSpace(view.PaymentUrl))
                        {
                            <Button Size="ButtonSize.Large" FullWidth @onclick="() => Go(view.PaymentUrl)">
                                <IconLeft><Icon Name="IconName.RiLock2Fill" /></IconLeft>
                                <ChildContent>Continue to payment</ChildContent>
                            </Button>
                        }
                        else
                        {
                            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="checkout__note">Your payment is being prepared.</Typography>
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" FullWidth Busy="_loading" @onclick="LoadAsync">
                                <IconLeft><Icon Name="IconName.RiRefreshLine" /></IconLeft>
                                <ChildContent>Refresh</ChildContent>
                            </Button>
                        }
                    }
                    else
                    {
                        <Button Size="ButtonSize.Large" FullWidth Busy="_paying" disabled="@(!view.CanPay || _paying || _changing)" @onclick="PayAsync">
                            <IconLeft><Icon Name="IconName.RiLock2Fill" /></IconLeft>
                            <ChildContent>@($"Pay {Money(view.Total)}")</ChildContent>
                        </Button>
                        @if (view.ExpiresAt is { } expires)
                        {
                            <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="checkout__note">@OpenUntil(expires)</Typography>
                        }
                    }
                </div>
            }

            @* Back to the chat the link came in: to add something while it's open, or to ask for help or a new
               link once it isn't. The agent changes this same checkout, so the link stays the one to pay. *@
            @if (!_waiting && !string.IsNullOrWhiteSpace(view.ChatUrl))
            {
                <div class="checkout__actions">
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" FullWidth @onclick="() => Go(view.ChatUrl)">
                        <IconLeft><Icon Name="@ChatGlyph(view.ChatUrl)" /></IconLeft>
                        <ChildContent>@(view.State == "open" ? "Back to chat to add more" : $"Message {view.Business}")</ChildContent>
                    </Button>
                </div>
            }
        }
    </div>
</main>

@code {
    [Parameter] public string Token { get; set; } = "";

    // Set on the address Accelerate sends the customer back to after paying.
    [SupplyParameterFromQuery(Name = "paid")] public string? Paid { get; set; }

    // Back from paying: how often, and for how long, to look for the payment's confirmation.
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(3);
    private const int PollTimes = 40;

    private readonly CancellationTokenSource _stop = new();
    private bool _waiting, _unconfirmed;

    private CheckoutView? _view;
    private bool _invalid, _loading, _paying, _changing;
    private string? _loadError, _payError, _notice;

    // Read after the first render, as the invite page does: the browser's time zone is known only then.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Clock.ReadAsync();
        await LoadAsync();
        StateHasChanged();
        if (Paid == "1" && _view?.State is "paying" or "expired")
        {
            await WaitForPaymentAsync();
        }
    }

    // Back from the payment page before its webhook has arrived: look again every few seconds until it's paid.
    // A link that ran out on our side can still have been paid there, so an expired checkout is waited on too.
    private async Task WaitForPaymentAsync()
    {
        _waiting = true;
        StateHasChanged();
        try
        {
            for (int i = 0; i < PollTimes && _view?.State != "paid"; i++)
            {
                await Task.Delay(PollEvery, _stop.Token);
                await LoadAsync();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _waiting = false;
        _unconfirmed = _view?.State != "paid";
        StateHasChanged();
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true; _loadError = null; _payError = null;
        try
        {
            _view = await Checkouts.GetAsync(Token);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { _invalid = true; }
        catch (HttpRequestException exception) when (exception.StatusCode is null) { Failed("We couldn't reach the checkout. Check your internet connection and try again."); }
        catch (HttpRequestException) { Failed("Something went wrong on our side. Try again in a moment."); }
        finally { _loading = false; }
    }

    // On a refresh the checkout already shown stays, with the problem under it.
    private void Failed(string message)
    {
        if (_view is null) _loadError = message; else _payError = message;
    }

    // The total the customer is looking at goes with the request, so they never pay a total they weren't shown.
    private async Task PayAsync()
    {
        if (_view is not { CanPay: true } view || _paying) return;
        _paying = true; _payError = null; _notice = null;
        try
        {
            var result = await Checkouts.PayAsync(Token, view.Total);
            if (result.Checkout is { } changed)
            {
                _view = changed;
                _notice = result.Message;
            }
            else if (!string.IsNullOrWhiteSpace(result.PaymentUrl))
            {
                // Busy until the payment page loads.
                Go(result.PaymentUrl);
                return;
            }
            else
            {
                await LoadAsync();
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.TooManyRequests) { _payError = "Too many attempts. Wait a minute, then try again."; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { _view = null; _invalid = true; }
        catch (ApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable) { _payError = exception.UserMessage; }
        catch (HttpRequestException exception) when (exception.StatusCode is null) { _payError = "We couldn't reach the checkout. Check your internet connection and try again."; }
        catch (HttpRequestException) { _payError = "Something went wrong on our side. Try again in a moment."; }
        _paying = false;
    }

    // One item's new quantity (0 takes it out), sent with every other item as it is. The answer is the checkout as
    // it is now, priced again; when the change can't be made (not enough left), the checkout stays as it was and says why.
    private async Task SetQuantityAsync(CheckoutLine changed, int quantity)
    {
        if (_view is not { } view || _changing || _paying) return;
        _changing = true; _payError = null; _notice = null;
        try
        {
            var items = view.Lines.Where(l => l.ProductId is not null)
                .Select(l => new CheckoutItemChange(l.ProductId!.Value, l.VariantId, ReferenceEquals(l, changed) ? quantity : l.Quantity))
                .ToList();
            var result = await Checkouts.ChangeAsync(Token, items);
            _view = result.Checkout;
            _notice = result.Message;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.TooManyRequests) { _payError = "Too many changes. Wait a minute, then try again."; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { _view = null; _invalid = true; }
        catch (ApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable) { _payError = exception.UserMessage; }
        catch (HttpRequestException exception) when (exception.StatusCode is null) { _payError = "We couldn't reach the checkout. Check your internet connection and try again."; }
        catch (HttpRequestException) { _payError = "Something went wrong on our side. Try again in a moment."; }
        _changing = false;
    }

    // Open and not on its way to being paid: the customer can still change how many they want.
    private bool Editable(CheckoutView view, CheckoutLine line) =>
        view.State == "open" && !_waiting && line.ProductId is not null && line.MaxQuantity is not null;

    // A whole page load: the payment page is another site.
    private void Go(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url)) Navigation.NavigateTo(url, forceLoad: true);
    }

    private string Money(decimal amount) => CheckoutMoney.Format(amount, _view?.Currency);

    // The quantity is in the stepper while it can be changed; otherwise it's written here.
    private string? Detail(CheckoutView view, CheckoutLine line) =>
        Editable(view, line) ? (string.IsNullOrWhiteSpace(line.VariantName) ? null : line.VariantName)
        : string.IsNullOrWhiteSpace(line.VariantName) ? $"Qty {line.Quantity}" : $"{line.VariantName} · Qty {line.Quantity}";

    private static IconName ChatGlyph(string url) =>
        url.StartsWith("https://wa.me/", StringComparison.OrdinalIgnoreCase) ? IconName.RiWhatsappFill
        : url.StartsWith("https://ig.me/", StringComparison.OrdinalIgnoreCase) ? IconName.RiInstagramFill
        : url.StartsWith("https://m.me/", StringComparison.OrdinalIgnoreCase) ? IconName.RiFacebookCircleFill
        : IconName.RiChat3Fill;

    private static bool Ended(string state) => state is "paid" or "expired" or "replaced" or "unavailable";

    private static IconName StateGlyph(string state) => state switch
    {
        "paid" => IconName.RiCheckboxCircleFill,
        "expired" => IconName.RiTimerFill,
        "replaced" => IconName.RiExchangeBoxFill,
        _ => IconName.RiErrorWarningFill,
    };

    private static string StateTitle(string state) => state switch
    {
        "paid" => "Paid, thank you",
        "expired" => "This checkout has expired",
        "replaced" => "There's a newer checkout",
        _ => "This checkout can't be paid",
    };

    // Only when the API sends no message of its own.
    private static string StateFallback(string state) => state switch
    {
        "paid" => "The business has your payment.",
        "expired" => "Ask the business to send you a new one.",
        "replaced" => "The business sent you a newer checkout. Open that one instead.",
        _ => "Ask the business for help with your order.",
    };

    // In the customer's own time: "Open until 3:30 pm today", or the day when it isn't today.
    private string OpenUntil(DateTime expiresAt)
    {
        var local = Clock.ToLocal(expiresAt.Kind == DateTimeKind.Local ? expiresAt.ToUniversalTime() : expiresAt);
        var time = local.ToString("h:mm tt", CultureInfo.InvariantCulture).ToLowerInvariant();
        var day = DateOnly.FromDateTime(local) == Clock.Today ? "today" : "on " + local.ToString("ddd d MMM", CultureInfo.InvariantCulture);
        return $"Open until {time} {day}";
    }
}
