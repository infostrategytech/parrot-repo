@page "/terms"
@page "/privacy"
@namespace Parrot.Web.Components.Pages.Legal
@layout BareLayout
@inject NavigationManager Nav

@* A holding page, so the links on Sign Up go somewhere real today. Replace
   each with the published document when legal has written it. *@

<PageTitle>@Title · OmniAI</PageTitle>

<main class="legal-page">
    <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h1">@Title</Typography>
    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="legal-page__copy">
        Our @Title.ToLowerInvariant() will be published here before OmniAI launches.
        Questions in the meantime can go to
        <a class="@TextStyle.BodySmallSemibold.ToClassName()" href="mailto:support@omniai.ng">support@omniai.ng</a>.
    </Typography>
</main>

@code {
    private bool IsPrivacy => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("privacy", StringComparison.OrdinalIgnoreCase);

    private string Title => IsPrivacy ? "Privacy Policy" : "Terms of Service";
}
