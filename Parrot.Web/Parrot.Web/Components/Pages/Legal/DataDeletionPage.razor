@page "/data-deletion"
@namespace Parrot.Web.Components.Pages.Legal
@using Parrot.Web.Components.Layout.Landing
@layout LandingPageLayout

@* How to have your data deleted: Meta asks for this page for apps that use Facebook sign-in (designer,
   17 November 2026). Starter text, to be replaced by the reviewed version. *@
<LandingMetadata Title="Data deletion · yára" Description="Find out how to request deletion of your yára account and the information we hold about you." Path="/data-deletion" />

<LandingDocument Title="Delete your data"
                 Intro="You can ask us to delete your yára account and the information we hold about you at any time.">
    <LandingSection Title="How to ask">
        <ul>
            <li><strong>By email</strong>: write to <a href="mailto:@LandingCompany.Email?subject=Delete%20my%20data">@LandingCompany.Email</a> from the email address on your account, with the subject “Delete my data”.</li>
            <li><strong>If you signed in with Facebook</strong>: you can also remove yára in Facebook under Settings &amp; privacy → Settings → Apps and websites. Then email us as above so we delete what we hold.</li>
        </ul>
    </LandingSection>
    <LandingSection Title="What we delete">
        <p>Your account and profile, the conversations and customer details in your business's yára workspace (if you own it), your AI agent's knowledge, and your tasks and settings. Connected WhatsApp, Instagram, Facebook and TikTok accounts are disconnected.</p>
    </LandingSection>
    <LandingSection Title="How long it takes">
        <p>We confirm your request within 3 working days and complete the deletion within 30 days. Some records may be kept longer only where the law requires it, and then deleted.</p>
    </LandingSection>
    <LandingSection Title="If you're a customer of a business on yára">
        <p>Your messages belong to the business you talked to. Ask them first; if you can't reach them, email us and we'll help.</p>
    </LandingSection>
</LandingDocument>
