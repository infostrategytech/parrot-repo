@page "/forgot-password"
@layout AuthPanelLayout
@using Parrot.Web.Components.Pages.Auth
@inject IForgotPasswordService ForgotPasswordService
@inject AuthFormState Forms
@inject IPasswordResetPreview ResetPreview

<PageTitle>Reset Your Password · yára</PageTitle>

@* Step one: where to send the reset. The answer is the same whether or not an
   account exists, so this page cannot be used to find out who has one.

   Approved 8 November: keep the existing email-link verification, not a new code flow. The link opens
   /reset-password; a matching signed-in account continues in Settings, and signed-out users stay here. *@

@if (_sentTo is null)
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Reset Your Password</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            Enter the email you signed up with. We will send you a link to set a new password.
        </Typography>
    </div>

    <form class="account-panel__form" novalidate @onsubmit="SendAsync" @onsubmit:preventDefault="true">
        <Parrot.SharedComponents.DesignSystem.Input FloatingLabel="Email Address"
               Id="reset-identifier"
               @bind-Value="_email"
               Error="@(!string.IsNullOrEmpty(_emailError))"
               HelperText="@_emailError"
               autocomplete="username">
            <IconLeft>
                <Icon Name="IconName.RiUser3Fill" Size="IconSize.Sm" />
            </IconLeft>
        </Parrot.SharedComponents.DesignSystem.Input>

        @if (_error is not null)
        {
            <InlineError Message="@_error" Action="@(_canRetry ? TryAgain : null)" />
        }

        <Button Type="ButtonType.Submit" Size="ButtonSize.Large" Class="account-panel__primary" disabled="@_sending">
            @(_sending ? "Sending Link…" : "Send Reset Link")
        </Button>
    </form>

    <a class="account-panel__back @TextStyle.BodySmallMedium.ToClassName()" href="/login" @onclick="() => Forms.Remember(_email)">
        Back to Sign In
    </a>
}
else
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Check Your Email</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            If an account uses <strong>@AuthFormState.Mask(_sentTo)</strong>, we sent it a link to set a new password.
        </Typography>
    </div>

    @if (_resent && _error is null)
    {
        <InlineError Tone="InlineErrorTone.Info" Message="We sent you another reset link." />
    }
    @if (_error is not null)
    {
        <InlineError Message="@_error" />
    }
    @if (ResetPreview.LinkFor(null) is { } previewLink)
    {
        @* Demo mode has no email, so it offers the link the email would have held. *@
        <a class="account-panel__back @TextStyle.BodySmallSemibold.ToClassName()" href="@previewLink">
            Open the reset link (demo)
        </a>
    }

    <ResendButton Size="ButtonSize.Large" Variant="ButtonVariant.Secondary" Class="account-panel__primary"
                  SentRevision="_sentRevision" Busy="_sending" Label="Send the Link Again" OnResend="ResendAsync" />

    <a class="account-panel__back @TextStyle.BodySmallMedium.ToClassName()" href="/login">Back to Sign In</a>
}

@code {
    private string? _email;
    private string? _emailError;
    private string? _error;
    private string? _sentTo;
    private bool _canRetry;
    private bool _sending;
    private bool _resent;
    private int _sentRevision;

    private RenderFragment TryAgain => @<Button Type="ButtonType.Submit" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small">Try again</Button>;

    /// <summary>Whatever was typed on Sign In before "Forgot Password?".</summary>
    protected override void OnInitialized() => _email = Forms.EnteredEmail;

    private async Task SendAsync()
    {
        if (_sending) return;

        _error = null;
        var email = _email?.Trim() ?? "";
        _emailError = email.Length == 0
            ? "Enter your email address."
            : !email.Contains('@') ? "Enter a valid email address." : null;
        if (_emailError is not null) return;

        Forms.Remember(email);
        if (await RequestAsync(email)) _sentTo = email;
    }

    private async Task ResendAsync()
    {
        if (_sending || _sentTo is null) return;
        _resent = await RequestAsync(_sentTo);
    }

    private async Task<bool> RequestAsync(string email)
    {
        _sending = true;
        _error = null;
        _canRetry = false;
        try
        {
            await ForgotPasswordService.ForgotPasswordAsync(new ForgotPasswordRequest { Email = email });
            _sentRevision++;
            return true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _error = "Too many attempts. Wait a few minutes, then try again.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        {
            _error = "We could not reach yára. Check your internet connection.";
            _canRetry = true;
        }
        catch
        {
            _error = "Something went wrong on our side.";
            _canRetry = true;
        }
        finally
        {
            _sending = false;
        }
        return false;
    }
}
