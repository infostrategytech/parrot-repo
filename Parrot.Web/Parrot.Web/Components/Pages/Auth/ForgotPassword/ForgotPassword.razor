@page "/forgot-password"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@inject IForgotPasswordService ForgotPasswordService
@inject ForgotPasswordState ForgotPasswordState
@inject ToastService Toasts
@implements IDisposable

<PageTitle>Forgot password · OmniAI</PageTitle>

@* Forgot password, on the sign-up design's frame: one field, one button.
   Once the link is on its way the column becomes a "check your email" note
   with the address it went to and a way to send it again. *@

@if (!_isSubmitted)
{
    <AuthPanel Title="Reset Your Password">
        <Lede>Enter your email and we'll send you a link to set a new password.</Lede>
        <Notice>
            @if (!string.IsNullOrEmpty(ForgotPasswordState.ErrorMessage))
            {
                <p class="panel__alert" role="alert">@ForgotPasswordState.ErrorMessage</p>
            }
        </Notice>
        <ChildContent>
            <form class="forgot" @onsubmit="HandleSubmit" @onsubmit:preventDefault novalidate>
                <AuthField Id="email" Placeholder="Email Address" Glyph="IconName.RiMailFill"
                           Type="email" AutoComplete="email" Required
                           @bind-Value="_email" Error="@_emailError" Disabled="@ForgotPasswordState.IsLoading" />

                <button type="submit" class="panel__primary" disabled="@ForgotPasswordState.IsLoading" aria-busy="@(ForgotPasswordState.IsLoading ? "true" : null)">
                    @if (ForgotPasswordState.IsLoading)
                    {
                        <CadenceLoader Kind="CadenceLoaderKind.RelayDots" Size="22" />
                    }
                    <span>Send Reset Link</span>
                </button>
            </form>
        </ChildContent>
        <Footer>
            Remembered your password? <a href="/login">Back to Sign In</a>
        </Footer>
    </AuthPanel>
}
else
{
    <AuthPanel Title="Check Your Email" Glyph="IconName.RiMailFill">
        <Lede>
            We've sent a password reset link to <a href="mailto:@_submittedEmail">@_submittedEmail</a>. Follow it to set a new password.
        </Lede>
        <Notice>
            @if (!string.IsNullOrEmpty(ForgotPasswordState.ErrorMessage))
            {
                <p class="panel__alert" role="alert">@ForgotPasswordState.ErrorMessage</p>
            }
        </Notice>
        <ChildContent>
            <p class="panel__terms">Didn't get the email? Check your spam folder or send it again.</p>

            <button type="button" class="panel__secondary forgot__resend" disabled="@ForgotPasswordState.IsLoading" aria-busy="@(ForgotPasswordState.IsLoading ? "true" : null)" @onclick="HandleResend">
                @if (ForgotPasswordState.IsLoading)
                {
                    <CadenceLoader Kind="CadenceLoaderKind.RelayDots" Size="22" />
                }
                <span>Resend Email</span>
            </button>
        </ChildContent>
        <Footer>
            Remembered your password? <a href="/login">Back to Sign In</a>
        </Footer>
    </AuthPanel>
}

@code {
    private bool _isSubmitted;
    private string _submittedEmail = string.Empty;

    private string? _email;
    private string? _emailError;

    protected override void OnInitialized() => ForgotPasswordState.OnChange += StateHasChanged;

    private bool Validate()
    {
        var email = _email?.Trim() ?? "";
        _emailError = email.Length == 0
            ? "Enter your email address."
            : !email.Contains('@')
                ? "Enter a valid email address."
                : null;
        return _emailError is null;
    }

    private async Task HandleSubmit()
    {
        ForgotPasswordState.Reset();
        if (!Validate()) return;

        ForgotPasswordState.SetLoading(true);

        var email = _email!.Trim();

        try
        {
            await ForgotPasswordService.ForgotPasswordAsync(new ForgotPasswordRequest { Email = email });
            _submittedEmail = email;
            _isSubmitted = true;
            ShowSentToast();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            ForgotPasswordState.SetError("Too many attempts. Please wait and try again.");
        }
        catch
        {
            ForgotPasswordState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            ForgotPasswordState.SetLoading(false);
        }
    }

    private async Task HandleResend()
    {
        ForgotPasswordState.Reset();
        ForgotPasswordState.SetLoading(true);

        try
        {
            await ForgotPasswordService.ForgotPasswordAsync(new ForgotPasswordRequest { Email = _submittedEmail });
            ShowSentToast();
        }
        catch
        {
            ForgotPasswordState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            ForgotPasswordState.SetLoading(false);
        }
    }

    // The toast host in AuthLayout owns placement and the dismiss timer, the
    // same way the app shell's does.
    private void ShowSentToast() =>
        Toasts.Show("We've sent a password reset link to your email.", ToastStatus.Success);

    public void Dispose() => ForgotPasswordState.OnChange -= StateHasChanged;
}
