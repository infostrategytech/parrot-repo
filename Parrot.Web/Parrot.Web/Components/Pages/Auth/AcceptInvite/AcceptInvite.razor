@page "/invite/{Token}"
@layout AuthPanelLayout
@using Parrot.Web.Features.Dashboard.Team
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject TeamClient TeamApi
@inject PendingInvite Pending
@inject TokenStorageService TokenStorage
@implements IDisposable

<PageTitle>@(_preview is null ? "Join a Team · yára" : $"Join {_preview.TeamName} · yára")</PageTitle>

@* Where an invite email's link lands (designer, 10 November 2026). It says whose team it is and who invited
   them, before anyone signs in. The owner already entered their name
   and email, so neither is asked again, and there is no Google or Facebook here: the login is made for the
   invited address. One login works everywhere, so:
   - no account for the invited address: a code to that email first (VerifyEmail), then a password, and they are
     joined and signed in at once;
   - an account already: sign in (the link is remembered meanwhile, and the dashboard brings them back) and join
     with one click.
   Then the workspace welcomes them (TeamWelcome). Headings follow the other sign-in screens' Title Case. *@

@if (_preview is null && _error is null)
{
    <LoadingState />
}
else if (_preview is null)
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">This Invite Link Does Not Work</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@_error</Typography>
    </div>
    <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="@(() => Navigation.NavigateTo("/login"))">Go to Sign In</Button>
}
else if (_step == Step.Code)
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Check Your Email</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            We sent a 6-digit code to <strong>@_preview.Email</strong>. Enter it to confirm it's you.
        </Typography>
    </div>
    <CodeEntry Verify="VerifyCodeAsync" Resend="ResendCodeAsync" SubmitLabel="Verify Email" InputId="invite-code" />
}
else if (_step == Step.Password)
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Create Your Password</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            For <strong>@_preview.Email</strong>. You'll use it to sign in to yára, for @_preview.TeamName and any other team you join.
        </Typography>
    </div>
    <form class="account-panel__form" novalidate @onsubmit="SignUpAsync" @onsubmit:preventDefault="true">
        <PasswordInput FloatingLabel="Create Password" Id="invite-password" IsNew @bind-Value="_password" />
        <PasswordInput FloatingLabel="Confirm Password" Id="invite-confirm-password" ShowStrength="false" @bind-Value="_confirm"
                       ErrorText="@(_confirm is { Length: > 0 } && _confirm != _password ? "The passwords do not match." : null)" />
        @if (_error is not null)
        {
            <InlineError Message="@_error" />
        }
        <Button Size="ButtonSize.Large" Type="ButtonType.Submit" Class="account-panel__primary" Busy="@_accepting"
                disabled="@(!CanSignUp)">Create Password and Join</Button>
    </form>
}
else
{
    @* The invitation is the thing (designer, 10 November 2026): a big heading, who asked, nothing else. *@
    <div class="account-panel__intro accept-invite__intro">
        <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Join @_preview.TeamName</Typography>
        <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>@($"{_preview.InvitedBy} invited you to join their team.")</Typography>
    </div>

    @if (_preview.Status == "accepted" && AuthState.IsAuthenticated
         && string.Equals(AuthState.CurrentUser?.Email, _preview.Email, StringComparison.OrdinalIgnoreCase))
    {
        @* Opened again after joining: they're in already. *@
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>You've joined already.</Typography>
        <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Open @_preview.TeamName</Button>
    }
    else if (_preview.Status != "pending")
    {
        <InlineError Message="@StatusMessage(_preview.Status)" />
    }
    else if (!AuthState.IsAuthenticated && !_preview.HasAccount)
    {
        @* Who it's for, as the owner entered them: not asked again. *@
        <div class="accept-invite__who">
            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="p">@_preview.FullName</Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p">@_preview.Email</Typography>
        </div>
        @if (_error is not null)
        {
            <InlineError Message="@_error" />
        }
        <Button Size="ButtonSize.Large" Class="account-panel__primary" Busy="@_sending" @onclick="ContinueAsync">
            @(_preview.VerifyEmail ? "Verify Email" : "Continue")
        </Button>
        <div class="accept-invite__note">
            <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>@($"{DaysLeft(_preview.ExpiresAt)} Not you? Ask {_preview.InvitedBy} for a new invite.")</Typography>
        </div>
    }
    else if (!AuthState.IsAuthenticated)
    {
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            You already have a yára login for <strong>@_preview.Email</strong>. Sign in to join.
        </Typography>
        <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="@(() => GoAsync("/login"))">Sign In</Button>
    }
    else
    {
        @if (_error is not null)
        {
            <InlineError Message="@_error" />
        }
        @if (string.Equals(AuthState.CurrentUser?.Email, _preview.Email, StringComparison.OrdinalIgnoreCase))
        {
            <Button Size="ButtonSize.Large" Class="account-panel__primary" Busy="@_accepting" @onclick="AcceptAsync">Join @_preview.TeamName</Button>
        }
        else
        {
            @* Only the invited login can join, so this one isn't offered a Join that can't work. *@
            <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>
                You are signed in as @AuthState.CurrentUser?.Email. Only @_preview.Email can accept this invite.
            </Typography>
            <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="SignOutAsync">Sign In With Another Account</Button>
        }
    }
}

@code {
    [Parameter] public string Token { get; set; } = "";

    // Back from signing in after choosing Accept in the email.
    [SupplyParameterFromQuery] public bool Resume { get; set; }

    private enum Step { Invite, Code, Password }

    private InvitePreview? _preview;
    private Step _step;
    private string? _error;
    private bool _accepting, _sending;
    private string? _code;
    private string? _password;
    private string? _confirm;

    // The same three rules and limit as sign-up, password reset and change password.
    private bool CanSignUp => !_accepting && _password is { Length: > 0 and <= 128 } password
        && Parrot.Web.Features.Auth.Models.PasswordRules.MeetsAll(password) && _password == _confirm;

    // The session is restored from the browser after the first render, so the
    // page redraws once Routes has loaded it.
    protected override void OnInitialized() => AuthState.OnChange += Redraw;

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _preview = await TeamApi.PreviewAsync(Token);

            // They already said yes in the email: join now, if this is the invited login.
            if (Resume && _preview.Status == "pending" && AuthState.IsAuthenticated
                && string.Equals(AuthState.CurrentUser?.Email, _preview.Email, StringComparison.OrdinalIgnoreCase))
            {
                // On success the page reloads into the team; on failure the error is drawn below.
                await AcceptAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception)
        {
            _error = "We could not read this invite. Check the link, or ask for a new one.";
        }

        StateHasChanged();
    }

    // From the link's own expiry: the token is a JWT that says when it stops working.
    private static string DaysLeft(DateTime expiresAt)
    {
        int days = (int)Math.Ceiling((expiresAt - DateTime.UtcNow).TotalDays);
        return days <= 1 ? "This invite expires within a day." : $"This invite expires in {days} days.";
    }

    private static string StatusMessage(string status) => status switch
    {
        "accepted" => "This invite has already been used. Sign in to reach the team.",
        "revoked" => "This invite was withdrawn. Ask the owner for a new one.",
        "expired" => "This invite has expired. Ask the owner for a new one.",
        _ => "This invite cannot be used.",
    };

    // The email is proved first (designer, 10 November 2026), then the password; without that step from the API,
    // straight to the password.
    private async Task ContinueAsync()
    {
        _error = null;
        if (!_preview!.VerifyEmail) { _step = Step.Password; return; }
        _sending = true;
        try
        {
            await TeamApi.SendCodeAsync(Token);
            _step = Step.Code;
        }
        catch (ApiException ex) { _error = ex.UserMessage; }
        catch (Exception) { _error = "We could not send the code. Check your connection and try again."; }
        finally { _sending = false; }
    }

    private async Task<CodeEntry.Outcome> VerifyCodeAsync(string code, CancellationToken token)
    {
        try
        {
            await TeamApi.VerifyCodeAsync(Token, code);
            _code = code;
            _step = Step.Password;
            StateHasChanged();
            return CodeEntry.Outcome.Ok;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Only an expired code locks the boxes, as on Verify Your Account.
            var expired = ex.ErrorCode?.Contains("expired", StringComparison.OrdinalIgnoreCase) ?? false;
            return new CodeEntry.Outcome(ex.UserMessage, Locked: expired);
        }
        catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.TooManyRequests)
        {
            return new CodeEntry.Outcome(ex.UserMessage, Locked: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        {
            return new CodeEntry.Outcome("We could not reach yára. Check your internet connection and try again.");
        }
        catch
        {
            return new CodeEntry.Outcome("Something went wrong on our side. Try again in a moment.");
        }
    }

    private async Task<string?> ResendCodeAsync(CancellationToken token)
    {
        try
        {
            await TeamApi.SendCodeAsync(Token);
            return null;
        }
        catch (ApiException ex) { return ex.UserMessage; }
        catch { return "Something went wrong on our side. Try again in a moment."; }
    }

    // Kept in the browser, so the person comes back here after signing in, however long that takes.
    private async Task GoAsync(string path)
    {
        await Pending.RememberAsync(Token);
        Navigation.NavigateTo(path);
    }

    private async Task AcceptAsync()
    {
        _accepting = true;
        _error = null;
        try
        {
            await TeamApi.AcceptAsync(Token);
            // A fresh circuit in the team's workspace, as switching does; the workspace welcomes them.
            Navigation.NavigateTo("/dashboard?joined=1", forceLoad: true, replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception)
        {
            _error = "We could not add you to the team. Try again.";
        }
        finally
        {
            _accepting = false;
        }
    }

    private async Task SignUpAsync()
    {
        if (!CanSignUp) return;
        _accepting = true;
        _error = null;
        try
        {
            // The name the owner entered, as their login's name.
            string[] name = _preview!.FullName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            await TeamApi.SignUpAsync(Token, name.ElementAtOrDefault(0) ?? _preview.FullName, name.ElementAtOrDefault(1), _password!, _code);
            Navigation.NavigateTo("/dashboard?joined=1", forceLoad: true, replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception)
        {
            _error = "We could not create your login. Try again.";
        }
        finally
        {
            _accepting = false;
        }
    }

    private async Task SignOutAsync()
    {
        await TokenStorage.ClearAsync();
        AuthState.ClearUser();
        await GoAsync("/login");
    }

    public void Dispose() => AuthState.OnChange -= Redraw;
}
