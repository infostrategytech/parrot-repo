@namespace Parrot.Web.Components.Pages.Auth

@* "Continue with Facebook", shared by Sign In and Sign Up, under Google's.

   Meta's brand guidelines set this button: Facebook blue with the white "f"
   mark and the wording "Continue with Facebook". The blue is Meta's, already
   allowlisted in brand-literals.json, so it is a literal rather than a token. *@

<div class="facebook-signin-wrap">
    <Button Variant="ButtonVariant.Ghost"
            Type="ButtonType.Button"
            Size="ButtonSize.Large"
            Class="facebook-signin"
            disabled="@(Busy || Disabled)"
            @onclick="OnClick">
        <IconLeft>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
            </svg>
        </IconLeft>
        <ChildContent>@(Busy ? "Connecting to Facebook…" : "Continue with Facebook")</ChildContent>
    </Button>
</div>

@code {
    [Parameter] public bool Busy { get; set; }

    /// <summary>Set while another action on the page is in flight, so the two cannot run together.</summary>
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }
}
