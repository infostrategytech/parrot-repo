@page "/"
@page "/login"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@inject ILoginService LoginService
@inject AuthState AuthState
@inject AuthFormState Forms
@inject LoginState LoginState
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Sign In · OmniAI</PageTitle>

<div class="login-intro">
    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1" Id="login-title">
        Welcome Back
    </Typography>
    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="login-intro__copy">
        Sign in to continue managing your customer conversations.
    </Typography>
</div>

<form class="login-form" novalidate @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
    @* Why they are here, when it was not their choice. *@
    @if (_problem is null && SessionExpired)
    {
        <InlineError Tone="InlineErrorTone.Info" Message="Your session has expired. Sign in again to pick up where you left off." />
    }

    <div class="login-form__fields">
        <Input FloatingLabel="Email Address"
               Id="login-identifier"
               Type="email"
               @bind-Value="_email"
               Error="@(!string.IsNullOrEmpty(_emailError))"
               HelperText="@_emailError"
               autocomplete="username">
            <IconLeft>
                <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
            </IconLeft>
        </Input>

        <PasswordInput FloatingLabel="Password"
                       Id="login-password"
                       @bind-Value="_password"
                       ErrorText="@_passwordError" />
    </div>

    <div class="login-form__recovery">
        <button type="button"
                class="login-form__forgot @TextStyle.BodySmallSemibold.ToClassName()"
                disabled="@Busy"
                @onclick="ForgotPassword">
            Forgot Password?
        </button>
    </div>

    @if (_problem is { } problem)
    {
        <InlineError Message="@Message(problem)" Action="ActionFor(problem)" />
    }

    <Button Type="ButtonType.Submit"
            Size="ButtonSize.Large"
            Class="login-form__submit"
            disabled="@Busy">
        @(LoginState.IsLoading ? "Signing In…" : "Sign In")
    </Button>

    <div class="login-form__divider" aria-hidden="true">
        <span></span>
        <Typography TextStyle="TextStyle.Small12Medium" As="small">Or continue with</Typography>
        <span></span>
    </div>

    <GoogleSignInButton Busy="_googleBusy" Disabled="Busy" OnClick="ContinueWithGoogle" />

    <p class="login-form__signup @TextStyle.BodySmallMedium.ToClassName()">
        New to OmniAI?
        <a href="/register" @onclick="() => Forms.Remember(_email)">Create Account</a>
    </p>
</form>

@code {
    private enum Problem { Invalid, TooManyAttempts, GoogleFailed, Unreachable, Unknown }

    [SupplyParameterFromQuery(Name = "sessionExpired")]
    public bool SessionExpired { get; set; }

    [SupplyParameterFromQuery]
    private string? error { get; set; }

    private string? _email;
    private string? _password;
    private string? _emailError;
    private string? _passwordError;
    private Problem? _problem;
    private bool _googleBusy;

    /// <summary>One request at a time: every control is locked while any of them runs.</summary>
    private bool Busy => LoginState.IsLoading || _googleBusy;

    protected override void OnInitialized()
    {
        LoginState.OnChange += StateHasChanged;
        _email = Forms.EnteredEmail;

        // The API sends people back here with ?error= when Google sign-in fails.
        if (!string.IsNullOrEmpty(error)) _problem = Problem.GoogleFailed;
    }

    private static string Message(Problem problem) => problem switch
    {
        Problem.Invalid => "That email or password is not right. Check them and try again.",
        Problem.TooManyAttempts => "Too many attempts. Wait a few minutes, then try again.",
        Problem.GoogleFailed => "Google sign-in did not finish. Try again, or use your email and password.",
        Problem.Unreachable => "We could not reach OmniAI. Check your internet connection.",
        _ => "Something went wrong on our side."
    };

    /// <summary>The next step for a problem, or null when the message is enough.</summary>
    private RenderFragment? ActionFor(Problem problem) => problem switch
    {
        Problem.Invalid => @<button type="button" @onclick="ForgotPassword">Reset Password</button>,
        Problem.Unreachable or Problem.Unknown => @<button type="submit">Try Again</button>,
        _ => null
    };

    private bool Validate()
    {
        var email = _email?.Trim() ?? "";
        _emailError = email.Length == 0
            ? "Enter your email address."
            : !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email)
                ? "Enter a valid email address."
                : null;
        _passwordError = string.IsNullOrEmpty(_password) ? "Enter your password." : null;
        return _emailError is null && _passwordError is null;
    }

    private async Task HandleLogin()
    {
        if (Busy) return;

        _problem = null;
        LoginState.Reset();
        if (!Validate()) return;

        var email = _email!.Trim();
        Forms.Remember(email);
        LoginState.SetLoading(true);

        try
        {
            AuthResponse? response = await LoginService.LoginAsync(new LoginRequest
            {
                Identifier = email,
                Password = _password!,
            });

            if (response is not null)
            {
                AuthState.SetUser(response);
                await TokenStorage.SaveAsync(response);
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                                      && ex.UserMessage.Contains("locked", StringComparison.OrdinalIgnoreCase))
        {
            // The API sends a lockout as a 401 too. Saying "wrong password"
            // there would send them round the loop that locked them out.
            _problem = Problem.TooManyAttempts;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            _problem = Problem.Invalid;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            // Right password, unverified address: the API has just sent a fresh code.
            Forms.CodeSentTo(email);
            Navigation.NavigateTo("/verify-email?sent=true");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _problem = Problem.TooManyAttempts;
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        {
            // No response at all: the connection, not the account.
            _problem = Problem.Unreachable;
        }
        catch
        {
            _problem = Problem.Unknown;
        }
        finally
        {
            LoginState.SetLoading(false);
        }
    }

    private void ForgotPassword()
    {
        Forms.Remember(_email);
        Navigation.NavigateTo("/forgot-password");
    }

    // The SSO entry point lives on the API, so this is a full navigation away
    // from the circuit.
    private void ContinueWithGoogle()
    {
        if (Busy) return;
        _googleBusy = true;

        var apiBaseUrl = (Configuration["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
        Navigation.NavigateTo($"{apiBaseUrl}/api/auth/sso/google", forceLoad: true);
    }

    public void Dispose() => LoginState.OnChange -= StateHasChanged;
}
