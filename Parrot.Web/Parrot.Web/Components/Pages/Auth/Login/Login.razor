@page "/"
@page "/login"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@inject ILoginService LoginService
@inject AuthState AuthState
@inject LoginState LoginState
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation
@inject FeedbackService Feedback
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Sign in · OmniAI</PageTitle>

@* The sign-in screen, on the sign-up design's frame: the same fields, the
   same button, the same way in with Google. *@

<AuthPanel Title="Sign In">
    <Lede>Welcome back. Pick up your customer conversations where you left off.</Lede>
    <Notice>
        @if (SessionExpired)
        {
            <p class="panel__alert panel__alert--info" role="status">Your session has expired. Please sign in again.</p>
        }
        @if (!string.IsNullOrEmpty(LoginState.ErrorMessage))
        {
            <p class="panel__alert" role="alert">@LoginState.ErrorMessage</p>
        }
    </Notice>
    <ChildContent>
        <form class="login" @onsubmit="HandleLogin" @onsubmit:preventDefault novalidate>
            <AuthField Id="email" Placeholder="Email or Phone Number" Glyph="IconName.RiUser3Fill"
                       Type="email" AutoComplete="username" Required
                       @bind-Value="_email" Error="@_emailError" Disabled="@LoginState.IsLoading" />

            <AuthField Id="password" Placeholder="Password" Glyph="IconName.RiLockFill"
                       Type="password" AutoComplete="current-password" Required
                       @bind-Value="_password" Error="@_passwordError" Disabled="@LoginState.IsLoading" />

            <p class="panel__aside"><a href="/forgot-password">Forgot password?</a></p>

            <button type="submit" class="panel__primary" disabled="@LoginState.IsLoading" aria-busy="@(LoginState.IsLoading ? "true" : null)">
                @if (LoginState.IsLoading)
                {
                    <CadenceLoader Kind="CadenceLoaderKind.RelayDots" Size="22" />
                }
                <span>Sign In</span>
            </button>
        </form>

        <div class="panel__divider" role="separator" aria-label="Or continue with">Or continue with</div>

        <button type="button" class="panel__google" @onclick="ContinueWithGoogle">
            <GoogleMark />
            <span>Continue With Google</span>
        </button>
    </ChildContent>
    <Footer>
        Don't have an account? <a href="/register">Create Account</a>
    </Footer>
</AuthPanel>

@code {
    [SupplyParameterFromQuery(Name = "sessionExpired")]
    public bool SessionExpired { get; set; }

    [SupplyParameterFromQuery]
    private string? error { get; set; }

    private string? _email;
    private string? _password;
    private string? _emailError;
    private string? _passwordError;

    protected override void OnInitialized()
    {
        LoginState.OnChange += StateHasChanged;

        if (!string.IsNullOrEmpty(error))
        {
            LoginState.SetError("Google sign-in failed. Please try again or use email and password.");
        }
    }

    // The SSO entry point lives on the API, so this is a full navigation away
    // from the circuit.
    private void ContinueWithGoogle()
    {
        var apiBaseUrl = (Configuration["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
        Navigation.NavigateTo($"{apiBaseUrl}/api/auth/sso/google", forceLoad: true);
    }

    private bool Validate()
    {
        var email = _email?.Trim() ?? "";
        _emailError = email.Length == 0
            ? "Enter your email address."
            : !email.Contains('@')
                ? "Phone sign-in isn't available yet — use your email address."
                : null;
        _passwordError = string.IsNullOrEmpty(_password) ? "Enter your password." : null;
        return _emailError is null && _passwordError is null;
    }

    private async Task HandleLogin()
    {
        LoginState.Reset();
        if (!Validate()) return;

        LoginState.SetLoading(true);

        try
        {
            AuthResponse? response = await LoginService.LoginAsync(new LoginRequest
            {
                Email = _email!.Trim(),
                Password = _password!,
            });

            if (response is not null)
            {
                AuthState.SetUser(response);
                await TokenStorage.SaveAsync(response);
                Feedback.Play(FeedbackSound.Success);
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            LoginState.SetError("Invalid email or password.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            // Right password, unverified address: the API has just sent a fresh code.
            Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(_email!.Trim())}&sent=true");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            LoginState.SetError("Too many attempts. Please wait and try again.");
        }
        catch
        {
            LoginState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            LoginState.SetLoading(false);
        }
    }

    public void Dispose() => LoginState.OnChange -= StateHasChanged;
}
