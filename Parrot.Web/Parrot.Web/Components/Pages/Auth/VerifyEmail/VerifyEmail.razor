@page "/verify-email"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@inject NavigationManager Navigation
@inject IVerifyEmailService VerifyEmailService
@inject VerifyEmailState VerifyEmailState
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@implements IDisposable

<PageTitle>Verify email · OmniAI</PageTitle>

@* Verify email, on the sign-up design's frame. Four moments: the note that
   the link is on its way (with a way to send it again), the wait while a
   link from the query string is checked, and the two results. *@

@if (_state == "pending")
{
    <AuthPanel Title="Check Your Email">
        <Lede>We've sent a verification link to @_email. Follow it to verify your account.</Lede>
        <Notice>
            @if (!string.IsNullOrEmpty(VerifyEmailState.ErrorMessage))
            {
                <p class="panel__alert" role="alert">@VerifyEmailState.ErrorMessage</p>
            }
        </Notice>
        <ChildContent>
            <p class="panel__terms">Didn't get the email? Check your spam folder or send it again.</p>

            <button type="button" class="panel__secondary verify__resend" disabled="@_resending" aria-busy="@(_resending ? "true" : null)" @onclick="HandleResend">
                @if (_resending)
                {
                    <CadenceLoader Kind="CadenceLoaderKind.RelayDots" Size="22" />
                }
                <span>Resend Email</span>
            </button>
        </ChildContent>
        <Footer>
            Already verified? <a href="/login">Sign In</a>
        </Footer>
    </AuthPanel>
}
else if (_state == "verifying")
{
    <div class="verify" role="status" aria-live="polite">
        <CadenceLoader Kind="CadenceLoaderKind.Thread" Size="64" />
        <AuthPanel Title="Verifying your email…">
            <Lede>Please wait while we confirm your email address.</Lede>
        </AuthPanel>
    </div>
}
else if (_state == "success")
{
    <AuthPanel Title="Email Verified" Glyph="IconName.RiCheckboxCircleFill" GlyphTone="AuthPanel.MarkTone.Success">
        <Lede>Your email address is verified. You can sign in now.</Lede>
        <ChildContent>
            <button type="button" class="panel__secondary" @onclick="GoToSignIn">Go to Sign In</button>
        </ChildContent>
    </AuthPanel>
}
else if (_state == "error")
{
    <AuthPanel Title="Verification Failed" Glyph="IconName.RiErrorWarningFill" GlyphTone="AuthPanel.MarkTone.Destructive">
        <Lede>The verification link is invalid or has expired. Please request a new one.</Lede>
        <ChildContent>
            <button type="button" class="panel__secondary" @onclick="GoToSignIn">Back to Sign In</button>
        </ChildContent>
    </AuthPanel>
}

@code {
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private string _state = "pending";
    private string _email = "your email address";
    private bool _resending = false;

    protected override void OnInitialized()
    {
        VerifyEmailState.OnChange += StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(UserId) && !string.IsNullOrWhiteSpace(Token))
        {
            _state = "verifying";
            await VerifyEmailAsync();
        }
    }

    private void GoToSignIn() => Navigation.NavigateTo("/login");

    private async Task VerifyEmailAsync()
    {
        try
        {
            AuthResponse? response = await VerifyEmailService.VerifyEmailAsync(new VerifyEmailRequest
            {
                UserId = UserId!,
                Token = Token!,
            });

            _state = "success";

            if (response is not null)
            {
                AuthState.SetUser(response);
                await TokenStorage.SaveAsync(response);
            }
        }
        catch
        {
            _state = "error";
        }
    }

    private async Task HandleResend()
    {
        _resending = true;
        VerifyEmailState.SetError(null);
        StateHasChanged();

        try
        {
            await VerifyEmailService.ResendVerificationEmailAsync(
                new ResendVerificationEmailRequest { Email = _email });
        }
        catch
        {
            VerifyEmailState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            _resending = false;
        }
    }

    public void Dispose()
    {
        VerifyEmailState.OnChange -= StateHasChanged;
    }
}
