@page "/verify-email"
@layout AuthPanelLayout
@using Parrot.Web.Components.Pages.Auth
@using Parrot.Web.Services
@inject NavigationManager Navigation
@inject IVerifyEmailService VerifyEmailService
@inject AuthState AuthState
@inject AuthFormState Forms
@inject TokenStorageService TokenStorage

<PageTitle>Verify Your Account · yára</PageTitle>

@if (_email is null)
{
    @* Arrived without signing up first, or refreshed, which clears the address
       held in memory. Sign Up is where it is entered. *@
}
else if (_verified)
{
    <div class="account-panel__done" role="status">
        <span class="account-panel__done-icon" aria-hidden="true">
            <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Lg" />
        </span>
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Account Verified</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            Your account is ready. Next, we will set up the basics of your business.
        </Typography>
        <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="Continue">
            Continue
        </Button>
    </div>
}
else
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Check Your Email</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            We sent a 6-digit code to <strong>@AuthFormState.Mask(_email)</strong>. Enter it below to verify your account.
        </Typography>
    </div>

    <CodeEntry Verify="VerifyAsync"
               Resend="ResendAsync"
               OnChangeDestination="ChangeEmail"
               SubmitLabel="Verify Account"
               InputId="verification-code"
               JustSent="Sent"
               />
}

@code {
    /// <summary>A code has just gone out (sign-up, or sign-in with an unverified address).</summary>
    [SupplyParameterFromQuery]
    private bool Sent { get; set; }

    private string? _email;
    private bool _verified;

    protected override void OnInitialized()
    {
        _email = Forms.PendingVerificationEmail;
        if (_email is null) Navigation.NavigateTo("/register", replace: true);
    }

    private async Task<CodeEntry.Outcome> VerifyAsync(string code, CancellationToken token)
    {
        try
        {
            AuthResponse? response = await VerifyEmailService.VerifyEmailAsync(new VerifyEmailRequest
            {
                Email = _email!,
                Code = code,
            });

            if (response is not null)
            {
                AuthState.SetUser(response);
                await TokenStorage.SaveAsync(response);
            }

            Forms.Verified();
            _verified = true;

            // Called from inside CodeEntry as a plain delegate, which Blazor
            // does not treat as an event on this page, so ask for the redraw.
            StateHasChanged();
            return CodeEntry.Outcome.Ok;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Wrong or expired code, in the API's words. An expired one cannot
            // be retried, so the boxes lock until a new code is sent -- but only
            // when the API says so with an error code. Its message covers both
            // cases ("isn't right or has expired"), so reading the text would
            // lock the boxes on every typo.
            var expired = ex.ErrorCode?.Contains("expired", StringComparison.OrdinalIgnoreCase) ?? false;
            return new CodeEntry.Outcome(ex.UserMessage, Locked: expired);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // Too many wrong codes: the account is resting for a while.
            return new CodeEntry.Outcome(ex.UserMessage, Locked: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            return new CodeEntry.Outcome("Too many attempts. Wait a few minutes, then try again.", Locked: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        {
            return new CodeEntry.Outcome("We could not reach yára. Check your internet connection and try again.");
        }
        catch
        {
            return new CodeEntry.Outcome("Something went wrong on our side. Try again in a moment.");
        }
    }

    private async Task<string?> ResendAsync(CancellationToken token)
    {
        try
        {
            await VerifyEmailService.ResendVerificationEmailAsync(new ResendVerificationEmailRequest { Email = _email! });
            return null;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            return "Too many codes requested. Wait a few minutes, then try again.";
        }
        catch
        {
            return "Something went wrong on our side. Try again in a moment.";
        }
    }

    /// <summary>Sign Up reads the pending address back, so it is corrected rather than retyped.</summary>
    private void ChangeEmail() => Navigation.NavigateTo("/register");

    private void Continue() => Navigation.NavigateTo("/dashboard", replace: true);
}
