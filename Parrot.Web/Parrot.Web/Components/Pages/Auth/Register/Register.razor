@page "/register"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@using Parrot.Web.Services
@inject IRegisterService RegisterService
@inject RegisterState RegisterState
@inject AuthState AuthState
@inject AuthFormState Forms
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Create Your Account · OmniAI</PageTitle>

@* Sign-up asks for the least it can: an email and a password. The business
   name is asked for on the workspace welcome card once they are inside. *@

<div class="signup-intro">
    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1" Id="signup-title">
        Create Your Account
    </Typography>
    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="signup-intro__copy">
        Get started now. You can tell us about your business once you are inside.
    </Typography>
</div>

<form class="signup-form" novalidate @onsubmit="HandleRegistration" @onsubmit:preventDefault="true">
    <div class="signup-form__fields">
        <Input FloatingLabel="Email Address"
               Id="signup-identifier"
               Type="email"
               @bind-Value="_email"
               Error="@(!string.IsNullOrEmpty(_emailError))"
               HelperText="@_emailError"
               autocomplete="email">
            <IconLeft>
                <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
            </IconLeft>
        </Input>

        <div class="signup-form__password">
            <PasswordInput FloatingLabel="Create Password"
                           Id="signup-password"
                           IsNew
                           @bind-Value="_password"
                           ErrorText="@_passwordError" />
        </div>

        <div class="signup-form__password">
            <PasswordInput FloatingLabel="Confirm Password"
                           Id="signup-confirm-password"
                           IsNew
                           ShowStrength="false"
                           @bind-Value="_confirmPassword"
                           ErrorText="@ConfirmPasswordError" />
            @if (PasswordsMatch)
            {
                <p class="signup-form__password-match @TextStyle.Small12Medium.ToClassName()" aria-live="polite">
                    <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                    <span>Passwords match</span>
                </p>
            }
        </div>
    </div>

    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="signup-form__legal">
        @* New tabs, so reading the terms does not throw away the form. *@
        By creating an account, you agree to OmniAI's
        <a class="@TextStyle.Small12Semibold.ToClassName()" href="/terms" target="_blank" rel="noopener">Terms</a> and
        <a class="@TextStyle.Small12Semibold.ToClassName()" href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
    </Typography>

    @if (_problem is { } problem)
    {
        <InlineError Message="@Message(problem)" Action="ActionFor(problem)" />
    }

    <Button Type="ButtonType.Submit" Size="ButtonSize.Large" Class="signup-form__submit" disabled="@Busy">
        @(RegisterState.IsLoading ? "Creating Account…" : "Create Account")
    </Button>

    <div class="signup-form__divider" aria-hidden="true">
        <span></span>
        <Typography TextStyle="TextStyle.Small12Medium" As="small">Or continue with</Typography>
        <span></span>
    </div>

    <GoogleSignInButton Busy="_googleBusy" Disabled="Busy" OnClick="ContinueWithGoogle" />
    @if (FacebookEnabled)
    {
        <FacebookSignInButton Busy="_facebookBusy" Disabled="Busy" OnClick="ContinueWithFacebook" />
    }

    <p class="signup-form__signin @TextStyle.BodySmallMedium.ToClassName()">
        Already have an account?
        <a href="/login" @onclick="() => Forms.Remember(_email)">Sign In</a>
    </p>
</form>

@code {
    private enum Problem { AccountExists, TooManyAttempts, Rejected, Unreachable, Unknown }

    private string? _email;
    private string? _password;
    private string? _confirmPassword;
    private string? _emailError;
    private string? _passwordError;
    private bool _confirmAttempted;
    private Problem? _problem;
    private string? _apiMessage;
    private bool _googleBusy;
    private bool _facebookBusy;

    // Shown once a Facebook app is configured on the API (Sso:Facebook on this app says so).
    private bool FacebookEnabled => Configuration.GetValue<bool>("Sso:Facebook");

    private bool Busy => RegisterState.IsLoading || _googleBusy || _facebookBusy;

    private bool PasswordsMatch =>
        !string.IsNullOrEmpty(_confirmPassword) && _confirmPassword == _password;

    private string? ConfirmPasswordError => !_confirmAttempted
        ? null
        : string.IsNullOrEmpty(_confirmPassword)
            ? "Confirm your password."
            : !PasswordsMatch
                ? "Passwords do not match."
                : null;

    /// <summary>Back from Verify or across from Sign In: the address is put back. Never the password.</summary>
    protected override void OnInitialized()
    {
        RegisterState.OnChange += StateHasChanged;
        _email = Forms.PendingVerificationEmail ?? Forms.EnteredEmail;
    }

    private string Message(Problem problem) => problem switch
    {
        Problem.AccountExists => "An account already exists with these details.",
        Problem.TooManyAttempts => "Too many attempts. Wait a few minutes, then try again.",
        Problem.Rejected => _apiMessage ?? "We could not create that account.",
        Problem.Unreachable => "We could not reach OmniAI. Check your internet connection.",
        _ => "Something went wrong on our side."
    };

    private RenderFragment? ActionFor(Problem problem) => problem switch
    {
        Problem.AccountExists => @<button type="button" @onclick="SignInInstead">Sign In Instead</button>,
        Problem.Unreachable or Problem.Unknown => @<button type="submit">Try Again</button>,
        _ => null
    };

    private bool Validate()
    {
        var email = _email?.Trim() ?? "";
        _emailError = email.Length == 0
            ? "Enter your email address."
            : !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email)
                ? "Enter a valid email address."
                : null;
        _passwordError = PasswordRules.MeetsAll(_password)
            ? null
            : "Create a password that meets all three requirements.";
        _confirmAttempted = true;
        return _emailError is null && _passwordError is null && ConfirmPasswordError is null;
    }

    private async Task HandleRegistration()
    {
        if (Busy) return;

        _problem = null;
        RegisterState.Reset();
        if (!Validate()) return;

        var email = _email!.Trim();
        Forms.Remember(email);
        RegisterState.SetLoading(true);

        try
        {
            AuthResponse? response = await RegisterService.RegisterAsync(new RegisterRequest
            {
                Email = email,
                Password = _password!,
                ConfirmPassword = _confirmPassword!,
            });

            if (response is not null)
            {
                // Verification is switched off on this deployment: the account is live already.
                AuthState.SetUser(response);
                await TokenStorage.SaveAsync(response);
                Navigation.NavigateTo("/dashboard");
                return;
            }

            // Held in memory, not in the address, so the email never lands in
            // browser history or a server log.
            Forms.CodeSentTo(email);
            Navigation.NavigateTo("/verify-email?sent=true");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _problem = Problem.AccountExists;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _problem = Problem.TooManyAttempts;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // The API's own wording. A password message belongs under the field.
            if (ex.UserMessage.Contains("password", StringComparison.OrdinalIgnoreCase))
            {
                _passwordError = ex.UserMessage;
            }
            else
            {
                _apiMessage = ex.UserMessage;
                _problem = Problem.Rejected;
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        {
            _problem = Problem.Unreachable;
        }
        catch
        {
            _problem = Problem.Unknown;
        }
        finally
        {
            RegisterState.SetLoading(false);
        }
    }

    private void SignInInstead()
    {
        Forms.Remember(_email);
        Navigation.NavigateTo("/login");
    }

    private void ContinueWithFacebook()
    {
        if (Busy) return;
        _facebookBusy = true;

        var apiBaseUrl = (Configuration["ApiSettings:PublicBaseUrl"] ?? Configuration["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
        Navigation.NavigateTo($"{apiBaseUrl}/api/auth/sso/facebook", forceLoad: true);
    }

    private void ContinueWithGoogle()
    {
        if (Busy) return;
        _googleBusy = true;

        var apiBaseUrl = (Configuration["ApiSettings:PublicBaseUrl"] ?? Configuration["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
        Navigation.NavigateTo($"{apiBaseUrl}/api/auth/sso/google", forceLoad: true);
    }

    public void Dispose() => RegisterState.OnChange -= StateHasChanged;
}
