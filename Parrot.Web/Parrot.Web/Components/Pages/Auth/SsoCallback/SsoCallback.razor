@page "/sso-callback"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation

<PageTitle>Signing you in · OmniAI</PageTitle>

@* The landing after Google: the API sends the session back on the query
   string, the page stores it and moves on to the dashboard. The column
   waits with the thread loader and only speaks if something is missing. *@

@if (_error is null)
{
    <div class="sso" role="status" aria-live="polite">
        <CadenceLoader Kind="CadenceLoaderKind.Thread" Size="64" />
        <AuthPanel Title="Signing you in…">
            <Lede>Just a moment while we finish your Google sign-in.</Lede>
        </AuthPanel>
    </div>
}
else
{
    <AuthPanel Title="Sign-In Failed" Glyph="IconName.RiErrorWarningFill" GlyphTone="AuthPanel.MarkTone.Destructive">
        <Lede>@_error</Lede>
        <ChildContent>
            <button type="button" class="panel__secondary" @onclick="GoToSignIn">Back to Sign In</button>
        </ChildContent>
    </AuthPanel>
}

@code {
    [SupplyParameterFromQuery]
    private string? token { get; set; }

    [SupplyParameterFromQuery]
    private string? expiresAt { get; set; }

    [SupplyParameterFromQuery]
    private string? userId { get; set; }

    [SupplyParameterFromQuery]
    private string? email { get; set; }

    [SupplyParameterFromQuery]
    private string? businessName { get; set; }

    private string? _error;

    private void GoToSignIn() => Navigation.NavigateTo("/login");

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(email))
        {
            _error = "Google sign-in did not return the expected data. Please try again.";
            return;
        }

        if (!DateTime.TryParse(expiresAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out DateTime parsedExpiry))
        {
            _error = "Invalid session data received. Please try again.";
            return;
        }

        AuthResponse authResponse = new AuthResponse
        {
            Token = token,
            ExpiresAt = parsedExpiry,
            UserId = userId,
            Email = email,
            BusinessName = businessName ?? string.Empty,
        };

        AuthState.SetUser(authResponse);
        await TokenStorage.SaveAsync(authResponse);
        Navigation.NavigateTo("/dashboard");
    }
}
