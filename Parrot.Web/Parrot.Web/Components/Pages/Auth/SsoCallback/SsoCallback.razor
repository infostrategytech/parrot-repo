@page "/sso-callback"
@layout AuthPanelLayout
@using Parrot.Web.Components.Pages.Auth
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation

<PageTitle>Signing You In · OmniAI</PageTitle>

@* The landing after Google: the API sends the session back on the query
   string, the page stores it and moves on. It only speaks if something is
   missing. *@

@if (_error is null)
{
    <div class="account-panel__intro" role="status" aria-live="polite">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Signing You In…</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            Just a moment while we finish your Google sign-in.
        </Typography>
    </div>
}
else
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Google Sign-In Did Not Finish</Typography>
    </div>
    <InlineError Message="@_error" />
    <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="GoToSignIn">Back to Sign In</Button>
}

@code {
    [SupplyParameterFromQuery]
    private string? token { get; set; }

    [SupplyParameterFromQuery]
    private string? expiresAt { get; set; }

    [SupplyParameterFromQuery]
    private string? userId { get; set; }

    [SupplyParameterFromQuery]
    private string? email { get; set; }

    [SupplyParameterFromQuery]
    private string? businessName { get; set; }

    [SupplyParameterFromQuery]
    private string? logoUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? workspaceId { get; set; }

    [SupplyParameterFromQuery]
    private string? role { get; set; }

    // Comma-separated permission keys.
    [SupplyParameterFromQuery]
    private string? permissions { get; set; }

    private string? _error;
    private AuthResponse? _session;

    private void GoToSignIn() => Navigation.NavigateTo("/login");

    // Only reads the address. It runs during prerender too, where the browser
    // is not reachable yet, so it must not store anything.
    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(email))
        {
            _error = "Google did not send back what we needed. Try again, or sign in with your email and password.";
            return;
        }

        if (!DateTime.TryParse(expiresAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out DateTime parsedExpiry))
        {
            _error = "The sign-in details from Google were not valid. Try again.";
            return;
        }

        _session = new AuthResponse
        {
            Token = token,
            ExpiresAt = parsedExpiry,
            UserId = userId,
            Email = email,
            // An API from before workspaces sends none; the user's own id is
            // their first workspace, which is what the API falls back to as well.
            WorkspaceId = string.IsNullOrEmpty(workspaceId) ? userId : workspaceId,
            BusinessName = businessName,
            LogoUrl = string.IsNullOrEmpty(logoUrl) ? null : logoUrl,
            // An API from before teams sends neither: the session was its owner's.
            Role = string.IsNullOrEmpty(role) ? "Owner" : role,
            Permissions = [.. (permissions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)],
        };
    }

    // Storing the session is a browser call, so it waits until the page is
    // live. Doing it in OnInitializedAsync crashed the page on prerender.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _session is null) return;

        AuthState.SetUser(_session);
        await TokenStorage.SaveAsync(_session);
        // Replace, not push: this address carries the session token, and it
        // must not stay in the browser history for Back to reopen.
        Navigation.NavigateTo("/dashboard", replace: true);
    }
}
