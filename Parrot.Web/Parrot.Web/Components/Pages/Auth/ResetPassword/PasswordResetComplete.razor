@page "/reset-password/complete"
@layout AuthPanelLayout
@inject NavigationManager Navigation

<PageTitle>Password updated · yára</PageTitle>

@* Public confirmation only: no account data, credentials, automatic login or protected dashboard. *@
<div class="account-panel__done" role="status">
    <span class="account-panel__done-icon" aria-hidden="true"><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Lg" /></span>
    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Password updated</Typography>
    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Your password has been changed. Sign in with your new password to continue.</Typography>
    <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="SignIn">Sign in</Button>
</div>

@code {
    // A fresh circuit ensures the next sign-in cannot reuse the former account's scoped page state.
    private void SignIn() => Navigation.NavigateTo("/login", forceLoad: true, replace: true);
}
