@page "/reset-password"
@layout PasswordResetEntryLayout
@using Parrot.Web.Features.Auth.ResetPassword.State
@implements IDisposable
@inject IResetPasswordService ResetPasswordService
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject TokenStorageService TokenStorage
@inject PasswordResetHandoff Handoff
@inject PasswordResetSignOut ResetSignOut

<PageTitle>Choose a New Password · yára</PageTitle>

@* Signed-out links retain the auth flow. A matching signed-in account hands the exact email token into
   Settings in circuit memory, then replaces this URL. No token is copied into storage or another query. *@
@if (!_contextReady || _returning)
{
    <SessionSplash />
}
else
{
    <LayoutView Layout="typeof(AuthPanelLayout)">
        @if (AuthState.IsAuthenticated && !PasswordResetHandoff.IsSameAccount(AuthState.CurrentUser?.UserId, UserId))
        {
            <div class="account-panel__intro">
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">This link is for another account</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Open the link in a private window, or sign out before opening it again.</Typography>
            </div>
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" Class="account-panel__primary"
                    @onclick="BackToSettings">Back to your settings</Button>
        }
        else if (_flow is { Done: true })
        {
            <div class="account-panel__done" role="status">
                <span class="account-panel__done-icon" aria-hidden="true"><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Lg" /></span>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Password Updated</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Your password has been changed. Sign out here to continue with your new password.</Typography>
                @if (_completionError is not null) { <InlineError Message="@_completionError" /> }
                <Button Size="ButtonSize.Large" Class="account-panel__primary" Busy="_endingSession" @onclick="EndResetSessionAsync">Sign out and continue</Button>
            </div>
        }
        else if (_flow is not null)
        {
            <div class="account-panel__intro">
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Choose a New Password</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Use one you have not used on yára before.</Typography>
            </div>
            <form class="account-panel__form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                @if (!_flow.LinkSpent)
                {
                    <NewPasswordFields IdPrefix="reset" Password="@_flow.Password" PasswordChanged="_flow.SetPassword"
                                       Confirmation="@_flow.Confirmation" ConfirmationChanged="_flow.SetConfirmation"
                                       PasswordError="@_flow.PasswordError" ConfirmationError="@_flow.ConfirmationError"
                                       Disabled="_flow.Busy" ShowIcons FocusRevision="_flow.FocusRevision" />
                }
                @if (_flow.Error is not null)
                {
                    <InlineError Message="@_flow.Error">
                        <Action>
                            @if (_flow.LinkSpent)
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="RequestNewLink">Send a new link</Button>
                            }
                        </Action>
                    </InlineError>
                }
                @if (!_flow.LinkSpent)
                {
                    <Button Type="ButtonType.Submit" Size="ButtonSize.Large" Class="account-panel__primary" Busy="_flow.Busy">
                        @(_flow.Busy ? "Saving…" : "Save New Password")
                    </Button>
                }
            </form>
        }
    </LayoutView>
}

@code {
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }
    private PasswordResetFlow? _flow;
    private bool _contextReady, _returning, _disposed, _endingSession;
    private string? _completionError;
    private string? _lastUserId, _lastToken;
    protected override void OnInitialized() => AuthState.OnChange += AuthChanged;
    private void AuthChanged() => _ = InvokeAsync(() =>
    {
        if (!_contextReady || _disposed) return;
        if (!ReturnToSettings()) StateHasChanged();
    });
    protected override void OnParametersSet()
    {
        if (_flow is not null && _lastUserId == UserId && _lastToken == Token) return;
        _flow?.ClearSecrets(); _flow = new(ResetPasswordService, UserId, Token);
        _lastUserId = UserId; _lastToken = Token;
        if (_contextReady) ReturnToSettings();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (AuthState.CurrentUser is null)
        {
            try
            {
                var stored = await TokenStorage.LoadAsync();
                if (_disposed) return;
                if (stored is not null && AuthState.CurrentUser is null) AuthState.SetUser(stored);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException) { }
        }
        if (_disposed) return;
        _contextReady = true;
        if (!ReturnToSettings()) StateHasChanged();
    }
    private bool ReturnToSettings()
    {
        if (_disposed || _flow?.Done == true || !AuthState.IsAuthenticated || string.IsNullOrEmpty(Token)
            || !PasswordResetHandoff.IsSameAccount(AuthState.CurrentUser?.UserId, UserId)) return false;
        _returning = true;
        Handoff.Stage(UserId!, Token!);
        Navigation.NavigateTo("/dashboard/settings/security", replace: true);
        return true;
    }
    private async Task SaveAsync()
    {
        if (_flow is null || _endingSession || _disposed) return;
        await _flow.SubmitAsync();
        if (!_disposed && _flow.Done) await EndResetSessionAsync();
    }
    private async Task EndResetSessionAsync()
    {
        if (_endingSession || _disposed || _flow is not { Done: true }) return;
        _endingSession = true; _completionError = null;
        try { await ResetSignOut.CompleteAsync(); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        { _completionError = "Your password changed, but we couldn't clear this browser's saved sign-in. Try signing out again."; }
        finally { _endingSession = false; }
    }
    private void RequestNewLink() => Navigation.NavigateTo("/forgot-password");
    private void BackToSettings() => Navigation.NavigateTo("/dashboard/settings/security", replace: true);
    public void Dispose() { _disposed = true; AuthState.OnChange -= AuthChanged; _flow?.ClearSecrets(); _lastToken = Token = null; }
}
