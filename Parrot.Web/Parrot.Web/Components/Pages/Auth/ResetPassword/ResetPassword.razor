@page "/reset-password"
@layout AuthPanelLayout
@using Parrot.Web.Services
@using Parrot.Web.Components.Pages.Auth
@inject IResetPasswordService ResetPasswordService
@inject NavigationManager Navigation

<PageTitle>Choose a New Password · yára</PageTitle>

@* The page the reset email's link opens. The link's user and token arrive on
   the query string and go back with the request untouched. The new password
   is held to the same three rules as Sign Up, and typed twice: there is no
   code to fall back on, so a typo would lock them out of the account they are
   trying to get back into. It does not sign them in; signing in with the new
   password is the proof it worked. *@

@if (_done)
{
    <div class="account-panel__done" role="status">
        <span class="account-panel__done-icon" aria-hidden="true">
            <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Lg" />
        </span>
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Password Updated</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            Your password has been changed. Sign in with your new password to continue.
        </Typography>
        <Button Size="ButtonSize.Large" Class="account-panel__primary" @onclick="GoToSignIn">Sign In</Button>
    </div>
}
else
{
    <div class="account-panel__intro">
        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h1">Choose a New Password</Typography>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            Use one you have not used on yára before.
        </Typography>
    </div>

    <form class="account-panel__form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
        <PasswordInput FloatingLabel="New Password"
                       Id="reset-new-password"
                       IsNew
                       @bind-Value="_password"
                       ErrorText="@_passwordError" />

        <PasswordInput FloatingLabel="Confirm New Password"
                       Id="reset-confirm-password"
                       IsNew
                       ShowStrength="false"
                       @bind-Value="_confirmation"
                       ErrorText="@_confirmationError" />

        @if (_error is not null)
        {
            <InlineError Message="@_error" Action="@(_linkSpent ? StartAgain : _canRetry ? TryAgain : null)" />
        }

        <Button Type="ButtonType.Submit" Size="ButtonSize.Large" Class="account-panel__primary" disabled="@_saving">
            @(_saving ? "Saving…" : "Save New Password")
        </Button>
    </form>
}

@code {
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private string? _password;
    private string? _confirmation;
    private string? _passwordError;
    private string? _confirmationError;
    private string? _error;
    private bool _linkSpent;
    private bool _canRetry;
    private bool _saving;
    private bool _done;

    private bool HasLink => !string.IsNullOrEmpty(UserId) && !string.IsNullOrEmpty(Token);

    private RenderFragment StartAgain => @<button type="button" @onclick="RequestNewLink">Start Again</button>;
    private RenderFragment TryAgain => @<button type="submit">Try Again</button>;

    protected override void OnInitialized()
    {
        if (!HasLink) LinkProblem("This reset link is incomplete.");
    }

    private void LinkProblem(string message)
    {
        _error = message;
        _linkSpent = true;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;

        _error = null;
        _canRetry = false;
        if (!HasLink) { LinkProblem("This reset link is incomplete."); return; }

        _passwordError = PasswordRules.MeetsAll(_password)
            ? null
            : "Choose a password that meets all three requirements.";
        _confirmationError = string.IsNullOrEmpty(_confirmation)
            ? "Enter your new password again."
            : _confirmation != _password ? "The two passwords do not match." : null;
        if (_passwordError is not null || _confirmationError is not null) return;

        _saving = true;
        try
        {
            await ResetPasswordService.ResetPasswordAsync(new ResetPasswordRequest
            {
                UserId = UserId!,
                Token = Token!,
                NewPassword = _password!,
                ConfirmNewPassword = _confirmation!,
            });
            _done = true;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest && IsLinkProblem(ex))
        {
            // The API sends a spent or expired link as a field message too, so
            // tell it apart by what it is about, not by its shape.
            LinkProblem("This reset link has expired or has already been used.");
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest && ex.Errors.Count > 0)
        {
            // Anything else it rejects is the password policy.
            _passwordError = ex.UserMessage;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            LinkProblem("This reset link has expired.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            LinkProblem("We could not find the account this link is for.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        {
            _error = "We could not reach yára. Check your internet connection.";
            _canRetry = true;
        }
        catch
        {
            _error = "Something went wrong on our side.";
            _canRetry = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool IsLinkProblem(ApiException ex) =>
        ex.UserMessage.Contains("token", StringComparison.OrdinalIgnoreCase)
        || ex.UserMessage.Contains("link", StringComparison.OrdinalIgnoreCase)
        || (ex.ErrorCode?.Contains("token", StringComparison.OrdinalIgnoreCase) ?? false);

    private void RequestNewLink() => Navigation.NavigateTo("/forgot-password");

    private void GoToSignIn() => Navigation.NavigateTo("/login", replace: true);
}
