@page "/reset-password"
@layout AuthLayout
@using Parrot.Web.Components.Pages.Auth
@inject IResetPasswordService ResetPasswordService
@inject ResetPasswordState ResetPasswordState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Reset password · OmniAI</PageTitle>

@* Reset password, on the sign-up design's frame: the new password twice,
   then the result. The link's user and token arrive on the query string and
   go back with the request untouched. *@

@if (!ResetPasswordState.IsSuccess)
{
    <AuthPanel Title="Create a New Password">
        <Lede>Set a new password you'll remember.</Lede>
        <Notice>
            @if (!string.IsNullOrEmpty(ResetPasswordState.ErrorMessage))
            {
                <p class="panel__alert" role="alert">@ResetPasswordState.ErrorMessage</p>
            }
        </Notice>
        <ChildContent>
            <form class="reset" @onsubmit="HandleReset" @onsubmit:preventDefault novalidate>
                <AuthField Id="newPassword" Placeholder="New Password" Glyph="IconName.RiLockFill"
                           Type="password" AutoComplete="new-password" Required
                           @bind-Value="_password" Error="@_passwordError" Disabled="@ResetPasswordState.IsLoading" />

                <AuthField Id="confirmPassword" Placeholder="Confirm New Password" Glyph="IconName.RiLockFill"
                           Type="password" AutoComplete="new-password" Required
                           @bind-Value="_confirmPassword" Error="@ConfirmError" Disabled="@ResetPasswordState.IsLoading" />

                <button type="submit" class="panel__primary" disabled="@ResetPasswordState.IsLoading" aria-busy="@(ResetPasswordState.IsLoading ? "true" : null)">
                    @if (ResetPasswordState.IsLoading)
                    {
                        <CadenceLoader Kind="CadenceLoaderKind.RelayDots" Size="22" />
                    }
                    <span>Reset Password</span>
                </button>
            </form>
        </ChildContent>
        <Footer>
            Remembered your password? <a href="/login">Back to Sign In</a>
        </Footer>
    </AuthPanel>
}
else
{
    <AuthPanel Title="Password Updated" Glyph="IconName.RiCheckboxCircleFill" GlyphTone="AuthPanel.MarkTone.Success">
        <Lede>Your password has been reset. Sign in with your new one.</Lede>
        <ChildContent>
            <button type="button" class="panel__secondary" @onclick="GoToSignIn">Go to Sign In</button>
        </ChildContent>
    </AuthPanel>
}

@code {
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private string? _password;
    private string? _confirmPassword;
    private string? _passwordError;

    private bool HasLink => !string.IsNullOrEmpty(UserId) && !string.IsNullOrEmpty(Token);

    // Under the confirm field as the user types, the moment the two differ.
    private string? ConfirmError =>
        !string.IsNullOrEmpty(_confirmPassword) && _password != _confirmPassword ? "Password mismatch" : null;

    protected override void OnInitialized()
    {
        ResetPasswordState.OnChange += StateHasChanged;

        if (!HasLink)
        {
            ResetPasswordState.SetError("Invalid or missing reset link. Please request a new one.");
        }
    }

    private void GoToSignIn() => Navigation.NavigateTo("/login");

    private bool Validate()
    {
        _passwordError = string.IsNullOrEmpty(_password)
            ? "Create a new password."
            : _password.Length < 8
                ? "Use at least 8 characters."
                : null;
        return _passwordError is null;
    }

    private async Task HandleReset()
    {
        ResetPasswordState.Reset();

        if (!HasLink)
        {
            ResetPasswordState.SetError("Invalid or missing reset link. Please request a new one.");
            return;
        }

        if (!Validate()) return;

        if (_password != _confirmPassword)
        {
            ResetPasswordState.SetError("Passwords do not match.");
            return;
        }

        ResetPasswordState.SetLoading(true);

        try
        {
            await ResetPasswordService.ResetPasswordAsync(new ResetPasswordRequest
            {
                UserId = UserId!,
                Token = Token!,
                NewPassword = _password!,
                ConfirmNewPassword = _confirmPassword!,
            });

            ResetPasswordState.SetSuccess();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            ResetPasswordState.SetError("Invalid or expired reset link. Please request a new one.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            ResetPasswordState.SetError("Account not found. Please request a new reset link.");
        }
        catch
        {
            ResetPasswordState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            ResetPasswordState.SetLoading(false);
        }
    }

    public void Dispose() => ResetPasswordState.OnChange -= StateHasChanged;
}
