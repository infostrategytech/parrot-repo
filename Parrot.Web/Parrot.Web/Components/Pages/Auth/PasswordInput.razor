@namespace Parrot.Web.Components.Pages.Auth
@using Parrot.Web.Features.Auth.Models

@* A password field with a show and hide control, and, for a new password,
   the strength meter and the three rules it has to meet. Sign In, Sign Up and
   password reset all use it, so the rules read the same everywhere. *@

<Input FloatingLabel="@FloatingLabel"
       Id="@Id"
       Type="@(_visible ? "text" : "password")"
       Value="@Value"
       ValueChanged="ValueChanged"
       Error="@(!string.IsNullOrEmpty(ErrorText))"
       HelperText="@ErrorText"
       autocomplete="@(IsNew ? "new-password" : "current-password")">
    <IconLeft>
        <Icon Name="IconName.RiLock2Fill" Size="IconSize.Sm" />
    </IconLeft>
    <IconRight>
        <button type="button"
                class="password-input__toggle"
                aria-label="@(_visible ? "Hide password" : "Show password")"
                title="@(_visible ? "Hide password" : "Show password")"
                @onclick="() => _visible = !_visible">
            <Icon Name="@(_visible ? IconName.RiEyeOffFill : IconName.RiEyeFill)" Size="IconSize.Sm" />
        </button>
    </IconRight>
</Input>

@if (IsNew && ShowStrength && !string.IsNullOrEmpty(Value))
{
    <div class="password-strength strength-@Tone" aria-live="polite" aria-label="Password strength: @Label">
        <div class="password-strength__heading">
            <Typography TextStyle="TextStyle.Small12Medium" As="span">Password Strength</Typography>
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@Label</Typography>
        </div>
        <div class="password-strength__meter" aria-hidden="true">
            @for (var segment = 1; segment <= 4; segment++)
            {
                <i class="@(Score >= segment ? "is-active" : null)"></i>
            }
        </div>
        <ul class="password-strength__rules @TextStyle.Small12Medium.ToClassName()">
            <li class="@(PasswordRules.HasMinimumLength(Value) ? "is-met" : null)">
                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                At least @PasswordRules.MinimumLength characters
            </li>
            <li class="@(PasswordRules.HasMixedCase(Value) ? "is-met" : null)">
                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                Uppercase and lowercase letters
            </li>
            <li class="@(PasswordRules.HasNumber(Value) ? "is-met" : null)">
                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                At least one number
            </li>
        </ul>
    </div>
}

@code {
    private bool _visible;

    [Parameter, EditorRequired] public string FloatingLabel { get; set; } = "";

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? ErrorText { get; set; }

    /// <summary>A password being chosen rather than entered: shows the meter and tells the browser to suggest one.</summary>
    [Parameter] public bool IsNew { get; set; }

    /// <summary>Off for a confirmation field: the rules belong to the password, not to typing it twice.</summary>
    [Parameter] public bool ShowStrength { get; set; } = true;

    private int Score => PasswordRules.Score(Value);

    private string Label => Score switch
    {
        <= 1 => "Weak",
        2 => "Fair",
        3 => "Good",
        _ => "Strong"
    };

    private string Tone => Score switch
    {
        <= 1 => "weak",
        2 => "fair",
        3 => "good",
        _ => "strong"
    };
}
