@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong · OmniAI</PageTitle>

@* The unhandled-error page, drawn as Aurora's empty state: what happened,
   the request id for support, and the way back. *@

<div class="error-page">
    <EmptyState Glyph="IconName.RiAlertFill"
                Title="Something went wrong"
                Description="An error occurred while processing your request. If it keeps happening, share the request id below with support.">
        <Action>
            <Button Variant="ButtonVariant.Secondary" @onclick="@(() => Nav.NavigateTo("/dashboard", forceLoad: true))">
                Go to the overview
            </Button>
        </Action>
    </EmptyState>

    @if (ShowRequestId)
    {
        <CopyValue Label="Request ID" Value="@(RequestId!)" />
    }

    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="error-page__note">
        Swapping to the <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Development</Typography> environment
        shows more detail about the error. It should not be enabled for deployed applications, because it can display
        sensitive information to end users: set the
        <Typography TextStyle="TextStyle.Code14Regular" As="code">ASPNETCORE_ENVIRONMENT</Typography> variable to
        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Development</Typography> for local debugging only.
    </Typography>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
