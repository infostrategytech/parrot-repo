@page "/dashboard"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Dashboard
@using Parrot.Web.Components.Pages.Dashboard.Dashboard
@inject IJSRuntime JS
@inject AuroraInterop Interop
@inject NavigationManager Nav
@inject AuthState AuthState
@using Parrot.Web.Features.Dashboard.Channels.Services
@using Parrot.Web.Features.Dashboard.Channels.State
@inject ChannelStatusLoader ChannelStatus
@inject ChannelsState ChannelsState
@implements IAsyncDisposable

<PageTitle>Overview · OmniAI</PageTitle>

@* A new account names its business here first; the overview shows it once created. *@
<WorkspaceWelcome />

@* Which dashboard: until a channel is connected there is nothing for the
   overview's numbers to describe, so the page is the activation overview
   (GettingStarted): connect a channel, then set up an AI agent. Once one is
   connected it is the full overview below. *@
@if (_hasChannels is null)
{
    <LoadingState Glyph="IconName.RiHome5Fill" Title="Loading your workspace" />
}
else if (_hasChannels == false)
{
    <GettingStarted />
}
else
{
@* The overview. Aurora's Products frame; the welcome, the upgrade aside and
   the checklist are cards; the six numbers are Aurora's stat strip; the chart
   sits in a card of its own, drawn by chart.js in the chart tokens. *@

<div class="overview">
    <header class="overview__header">
        <div class="overview__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Overview</Typography>
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="overview__lede">
                @_greeting — here's a snapshot of how your AI is performing today.
            </Typography>
        </div>
    </header>

    <section class="overview__welcome" aria-label="Today">
        <div class="overview__welcome-text">
            <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="overview__welcome-meta">
                @_dateStr · @_clockStr
            </Typography>
            <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2" Prose>
                Welcome back@(string.IsNullOrWhiteSpace(WorkspaceName) ? "" : $", {WorkspaceName}")
            </Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
                Your agents handled 412 conversations this week.
            </Typography>
        </div>
        <div class="overview__pulse">
            <div class="overview__pulse-card">
                <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Live chats</Typography>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">23</Typography>
            </div>
            <div class="overview__pulse-card">
                <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Avg. response</Typography>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">1.2m</Typography>
            </div>
        </div>
    </section>

    <aside class="overview__upgrade">
        <span class="overview__upgrade-icon"><Icon Name="IconName.RiSparklingFill" Size="IconSize.Md" /></span>
        <div class="overview__upgrade-text">
            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Get more from your AI agent</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>
                Unlock advanced flows, QA insights, and higher conversation limits.
            </Typography>
        </div>
        <Button Variant="ButtonVariant.Secondary" @onclick="@(() => Nav.NavigateTo("/dashboard/pricing"))">
            <ChildContent>See pricing</ChildContent>
            <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
        </Button>
    </aside>

    <section class="overview__setup" aria-label="Workspace setup">
        <header class="overview__setup-header">
            <div class="overview__setup-titles">
                <Typography TextStyle="TextStyle.BodyDefaultBold" As="h2">Finish setting up your workspace</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
                    Tap each step as you complete it — your progress saves automatically.
                </Typography>
            </div>
            <StatusBadge Tone="@(_doneCount == _checklistLabels.Length ? StatusTone.Success : StatusTone.Brand)">
                @_doneCount of @_checklistLabels.Length completed
            </StatusBadge>
        </header>

        <div class="overview__progress" role="progressbar"
             aria-valuenow="@_doneCount" aria-valuemin="0" aria-valuemax="@_checklistLabels.Length">
            <i style="width: @(_doneCount * 100 / _checklistLabels.Length)%"></i>
        </div>

        <ol class="overview__checklist">
            @for (int i = 0; i < _checklistLabels.Length; i++)
            {
                var idx = i;
                var done = _done[idx];
                <li>
                    <button type="button"
                            class="@(done ? "overview__step is-done" : "overview__step")"
                            aria-pressed="@done.ToString().ToLowerInvariant()"
                            @onclick="() => HandleChecklistClick(idx)">
                        <span class="overview__step-marker">
                            @if (done)
                            {
                                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                            }
                            else
                            {
                                <Typography TextStyle="TextStyle.Small12Bold" As="span">@(idx + 1)</Typography>
                            }
                        </span>
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose>@_checklistLabels[idx]</Typography>
                        <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" />
                    </button>
                </li>
            }
        </ol>
    </section>

    <section class="overview__summary" aria-label="Workspace summary">
        @foreach (var s in _stats)
        {
            <article class="stat-tile">
                <span class="stat-tile__icon"><Icon Name="@s.Glyph" Size="IconSize.Md" /></span>
                <div class="stat-tile__body">
                    <div class="stat-tile__top">
                        <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@s.Title</Typography>
                        <StatusBadge Tone="@(s.TrendUp ? StatusTone.Success : StatusTone.Neutral)">@s.Trend</StatusBadge>
                    </div>
                    <div class="stat-tile__figure">
                        <Typography TextStyle="@(s.SmallValue ? TextStyle.HeadingH4Semibold : TextStyle.HeadingH3Semibold)" As="strong" Prose>
                            @s.Value
                        </Typography>
                        <svg class="stat-tile__spark" viewBox="0 0 60 24" aria-hidden="true">
                            <path d="@s.SparkPath" />
                        </svg>
                    </div>
                    <Typography TextStyle="TextStyle.Small10Regular" As="p" Prose Class="stat-tile__note">@s.Desc</Typography>
                </div>
            </article>
        }
    </section>

    <section class="overview__chart" aria-label="AI-handled conversations over time">
        <header class="overview__chart-header">
            <Typography TextStyle="TextStyle.BodyDefaultBold" As="h2">AI-handled conversations over time</Typography>
            <div class="overview__chart-controls">
                <div class="overview__periods" role="tablist" aria-label="Period">
                    @foreach (var p in Periods)
                    {
                        var period = p;
                        <button type="button"
                                role="tab"
                                aria-selected="@((_selectedPeriod == period).ToString().ToLowerInvariant())"
                                class="@(_selectedPeriod == period ? "overview__period is-active" : "overview__period")"
                                @onclick="() => SelectPeriod(period)">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">@period</Typography>
                        </button>
                    }
                </div>
                <StatusBadge Tone="StatusTone.Neutral" Glyph="IconName.RiRobot3Fill">Agent: @_selectedAgent</StatusBadge>
            </div>
        </header>
        <div class="overview__chart-wrap">
            <canvas id="convChart"></canvas>
        </div>
    </section>
</div>
}

@code {
    private static readonly string[] Periods = ["7d", "30d", "90d"];

    private System.Threading.Timer? _clockTimer;
    private DateTime _now = DateTime.Now;

    private string _greeting = "";
    private string _dateStr = "";
    private string _clockStr = "";

    private string? WorkspaceName => AuthState.CurrentUser?.BusinessName;

    private bool[] _done = [true, false, false, false];
    private int _doneCount => _done.Count(d => d);

    private readonly string[] _checklistLabels =
    [
        "Add workspace details",
        "Connect a channel",
        "Create your first AI agent",
        "Create your first playbook"
    ];

    private string _selectedPeriod = "30d";
    private string _selectedAgent = "Bakerbot";

    private record StatCard(string Title, string Value, string Trend, bool TrendUp, string Desc,
        IconName Glyph, string SparkPath, bool SmallValue = false);

    private List<StatCard> _stats = [];

    /// <summary>Null until channel status is known; then whether any channel is connected.</summary>
    private bool? _hasChannels;
    private bool _chartDrawn;
    private readonly CancellationTokenSource _lifetime = new();

    protected override void OnInitialized()
    {
        // The welcome card names the business through AuthState; redraw the
        // greeting when it does.
        AuthState.OnChange += OnAuthChanged;
        UpdateTime();
        _stats = BuildStats();
        _clockTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            UpdateTime();
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void UpdateTime()
    {
        _now = DateTime.Now;
        _greeting = _now.Hour < 12 ? "Good morning"
        : _now.Hour < 18 ? "Good afternoon"
        : "Good evening";
        _dateStr = _now.ToString("dddd, MMMM d");
        _clockStr = _now.ToString("hh:mm:ss tt");
    }

    private static readonly string?[] _checklistRoutes =
    [
        "/dashboard/business-setup",
        "/dashboard/channels",
        "/dashboard/ai-agents",
        "/dashboard/ai-agents"
    ];

    private void HandleChecklistClick(int idx)
    {
        var route = _checklistRoutes[idx];
        if (route is not null)
            Nav.NavigateTo(route);
        else
            _done[idx] = !_done[idx];
    }

    private static string Spark(int[] data)
    {
        const int w = 60, h = 24;
        var min = data.Min(); var max = data.Max();
        var range = max - min == 0 ? 1 : max - min;
        var pts = data.Select((v, i) => (
            x: (float)i / (data.Length - 1) * w,
            y: h - (float)(v - min) / range * (h - 4) - 2
        )).ToList();
        return string.Join(" ", pts.Select((p, i) => $"{(i == 0 ? "M" : "L")}{p.x:F1},{p.y:F1}"));
    }

    private static List<StatCard> BuildStats() =>
    [
        new("Contacts", "2,847", "+12%", true, "Total customers across all channels",
            IconName.RiContactsBook3Fill, Spark([30, 38, 34, 46, 50, 58])),
        new("AI Agents", "8", "+2", true, "Agents handling conversations",
            IconName.RiRobot3Fill, Spark([4, 5, 5, 6, 7, 8])),
        new("Connected Channels", "2", "+1", true, "Messaging platforms linked",
            IconName.RiLinksFill, Spark([1, 1, 1, 2, 2, 2])),
        new("Team", "7", "Stable", false, "People in your workspace",
            IconName.RiTeamFill, Spark([5, 5, 6, 6, 7, 7])),
        new("Pending Task Request", "12", "+5", true, "Tasks waiting for your review",
            IconName.RiClipboardFill, Spark([8, 10, 9, 14, 11, 12])),
        new("Collection Balance", "₦ 847,200", "+18%", true, "Total payments collected",
            IconName.RiRefund2Fill, Spark([40, 52, 60, 58, 70, 84]), SmallValue: true),
    ];

    private static readonly Dictionary<string, (string[] labels, double[] data)> _chartData = new()
    {
        ["7d"]  = (["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"], [42, 48, 40, 55, 60, 52, 68]),
        ["30d"] = (["Jan 1","Jan 8","Jan 15","Jan 22","Jan 29","Feb 5","Feb 12","Feb 19"], [40, 52, 46, 58, 50, 66, 60, 72]),
        ["90d"] = (["Oct", "Nov", "Dec", "Jan", "Feb", "Mar"], [35, 42, 50, 46, 58, 64]),
    };

    private async Task SelectPeriod(string period)
    {
        _selectedPeriod = period;
        var (labels, data) = _chartData[period];
        await JS.InvokeVoidAsync("eval", $$"""
            (function() {
                var c = document.getElementById('convChart');
                if (!c || !c._chartInstance) return;
                c._chartInstance.data.labels = {{System.Text.Json.JsonSerializer.Serialize(labels)}};
                c._chartInstance.data.datasets[0].data = {{System.Text.Json.JsonSerializer.Serialize(data)}};
                c._chartInstance.update();
            })();
        """);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (AuthState.CurrentUser?.Token is { Length: > 0 } token)
            {
                try { await ChannelStatus.RefreshAsync(token, _lifetime.Token); }
                catch (OperationCanceledException) { return; }
            }
            _hasChannels = ChannelsState.Workspace.ConnectedCount > 0;
            StateHasChanged();
            return;
        }

        // The chart's canvas only exists in the full overview, so it is drawn
        // the first time that view is on screen, not on the first render.
        if (_hasChannels == true && !_chartDrawn)
        {
            _chartDrawn = true;
            // Chart.js is only needed here, so it is fetched here rather than
            // on every page; the second visit reads it from cache.
            try
            {
                await Interop.EnsureScriptAsync(Assets["lib/chart/chart.umd.min.js"]);
            }
            catch (JSException)
            {
                return; // The rest of the dashboard is still useful without the chart.
            }

            var (labels, data) = _chartData[_selectedPeriod];
            // Every colour the chart draws is read from the design tokens at
            // the moment it is built, so it follows the theme rather than
            // carrying its own palette.
            await JS.InvokeVoidAsync("eval", $$"""
                (function() {
                    var ctx = document.getElementById('convChart');
                    if (!ctx || typeof Chart === 'undefined') return;
                    if (ctx._chartInstance) { ctx._chartInstance.destroy(); }
                    var css = getComputedStyle(document.documentElement);
                    var token = function(name) { return css.getPropertyValue(name).trim(); };
                    var line = token('--colors-chart-chart-1');
                    var fill = 'color-mix(in srgb, ' + line + ' 12%, transparent)';
                    ctx._chartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: {{System.Text.Json.JsonSerializer.Serialize(labels)}},
                            datasets: [{
                                data: {{System.Text.Json.JsonSerializer.Serialize(data)}},
                                borderColor: line,
                                backgroundColor: fill,
                                borderWidth: 2,
                                pointRadius: 0,
                                pointHoverRadius: 5,
                                pointHoverBackgroundColor: line,
                                pointHoverBorderColor: token('--colors-surface-card'),
                                pointHoverBorderWidth: 2,
                                fill: true,
                                tension: 0.45
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    mode: 'index', intersect: false,
                                    backgroundColor: token('--colors-surface-popover'),
                                    titleColor: token('--colors-text-primary'),
                                    bodyColor: token('--colors-text-secondary'),
                                    borderColor: token('--colors-surface-border'),
                                    borderWidth: 1,
                                    padding: 12, cornerRadius: 8,
                                    titleFont: { family: token('--typography-font-family-base'), weight: 600 },
                                    bodyFont: { family: token('--typography-font-family-base') }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    border: { display: false },
                                    ticks: { color: token('--colors-text-subtle'), font: { family: token('--typography-font-family-base'), size: 12 } }
                                },
                                y: {
                                    beginAtZero: false,
                                    ticks: { color: token('--colors-text-subtle'), font: { family: token('--typography-font-family-base'), size: 12 }, stepSize: 10 },
                                    grid: { color: token('--colors-surface-border') },
                                    border: { display: false }
                                }
                            }
                        }
                    });
                })();
            """);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        _clockTimer?.Dispose();
        AuthState.OnChange -= OnAuthChanged;
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var c=document.getElementById('convChart'); if(c&&c._chartInstance){c._chartInstance.destroy();}");
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; there is no chart left to release.
        }
    }
}
