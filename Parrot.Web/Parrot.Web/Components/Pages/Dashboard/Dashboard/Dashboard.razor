@page "/dashboard"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Dashboard
@using Parrot.Web.Features.Dashboard.AiAgents.State
@using Parrot.Web.Features.Dashboard.Channels.Services
@inject AuthState AuthState
@inject ChannelStatusLoader ChannelStatus
@inject AiAgentsState AgentsState
@implements IDisposable

<PageTitle>Overview · OmniAI</PageTitle>

@* The overview (designer, 15 October 2026; now the only one):
   one page that grows with the business rather than two dashboards, drawn by
   DashboardHome. Its channels and agents are read first, so it opens at the
   right stage instead of showing one and jumping to another. No figures: AI
   Operations has those. *@
@if (!_ready)
{
    <LoadingState Glyph="IconName.RiHome5Fill" Title="Loading your workspace" />
}
else
{
    <DashboardHome />
}

@code {
    private bool _ready;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (AuthState.CurrentUser?.Token is { Length: > 0 } token)
        {
            try { await ChannelStatus.RefreshAsync(token, _lifetime.Token); }
            catch (OperationCanceledException) { return; }
        }
        await AgentsState.LoadAsync();
        _ready = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
