@namespace Parrot.Web.Components.Pages.Dashboard.Dashboard
@using Parrot.Web.Features.Dashboard.Channels.State
@inject AuthState AuthState
@inject ChannelsState ChannelsState
@inject NavigationManager Nav
@inject AgentGate AgentGate
@implements IDisposable

@* The dashboard before any channel is connected (Aurora's activation
   overview): one clear next step, bring your conversations in, and the AI
   agent card waiting behind it. Once a channel is connected the dashboard
   shows the full overview instead.

   "is-live" once the business is named: the welcome card sits over this page
   until then, and the page's entrance and its one bit of motion wait for it
   rather than playing out unseen behind the card.

   No parameters on purpose: the dashboard redraws every second for its
   clock, and a component with none is not redrawn with it. *@

<div class="workspace-onboarding @(IsLive ? "is-live" : null)" aria-hidden="@(!IsLive)">
    <header class="workspace-onboarding__header">
        <Typography TextStyle="TextStyle.HeadingH1Semibold" As="h1">
            Good to see you, @WorkspaceDisplayName
        </Typography>
        <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
            It’s quiet for now. Bring in your customer messages and watch your workspace come to life.
        </Typography>
    </header>

    <section class="workspace-actions" aria-label="Get started with OmniAI">
        <article class="workspace-action workspace-action--channels">
            <div class="workspace-action__content">
                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">
                    Bring Your Conversations In
                </Typography>
                <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                    Connect WhatsApp, Instagram or Facebook and reply from one shared inbox.
                </Typography>
                <Button Size="ButtonSize.Large" @onclick="OpenChannels">Connect a Channel</Button>
            </div>

            <div class="workspace-channel-flow" aria-hidden="true">
                <div class="workspace-channel-flow__socials">
                    <span class="flow-whatsapp"><Icon Name="IconName.RiWhatsappFill" Size="IconSize.Md" /></span>
                    <span class="flow-instagram"><Icon Name="IconName.RiInstagramFill" Size="IconSize.Md" /></span>
                    <span class="flow-facebook"><Icon Name="IconName.RiFacebookCircleFill" Size="IconSize.Md" /></span>
                </div>
                <span class="workspace-channel-flow__line"><i></i></span>
                <span class="workspace-channel-flow__inbox"><Icon Name="IconName.RiInbox2Fill" Size="IconSize.Lg" /></span>
            </div>
        </article>

        <article class="workspace-action workspace-action--ai @(HasConnectedChannel ? "is-ready" : "is-locked")">
            <span class="workspace-action__icon" aria-hidden="true">
                <Icon Name="IconName.RiRobot3Fill" Size="IconSize.Lg" />
            </span>

            <div class="workspace-action__content">
                <div class="workspace-action__title-row">
                    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2">
                        Bring AI Into Your Conversations
                    </Typography>
                    @if (!HasConnectedChannel)
                    {
                        <span class="workspace-action__lock @TextStyle.Small12Semibold.ToClassName()">
                            <Icon Name="IconName.RiLock2Fill" Size="IconSize.Sm" />
                            Connect a Channel First
                        </span>
                    }
                </div>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
                    Set up an AI agent to handle routine questions and bring you in when needed.
                </Typography>
            </div>

            <Button Variant="@(HasConnectedChannel ? ButtonVariant.Primary : ButtonVariant.Secondary)"
                    disabled="@(!HasConnectedChannel)"
                    @onclick="OpenAiAgents">
                Set Up an AI Agent
            </Button>
        </article>
    </section>

    <div class="workspace-onboarding__hint">
        <Icon Name="IconName.RiSparkling2Fill" Size="IconSize.Sm" />
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
            You can explore the rest of OmniAI whenever you like.
        </Typography>
    </div>
</div>

@code {
    private string? BusinessName => AuthState.CurrentUser?.BusinessName;
    private bool IsLive => !string.IsNullOrWhiteSpace(BusinessName);
    private string WorkspaceDisplayName => IsLive ? BusinessName! : "Your Workspace";
    private bool HasConnectedChannel => ChannelsState.Workspace.ConnectedCount > 0;

    private void OpenChannels() => Nav.NavigateTo("/dashboard/channels");
    // An agent needs a connected channel, then knowledge the business has
    // approved ("Teach your AI"); then setup opens.
    private Task OpenAiAgents() => AgentGate.RequireAsync(() =>
    {
        Nav.NavigateTo("/ai-operations?new=1");
        return Task.CompletedTask;
    });

    // The welcome card names the business through AuthState; that is the
    // moment this page becomes live and plays its entrance.
    protected override void OnInitialized() => AuthState.OnChange += OnAuthChanged;
    private void OnAuthChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => AuthState.OnChange -= OnAuthChanged;
}
