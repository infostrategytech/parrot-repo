@namespace Parrot.Web.Components.Pages.Dashboard.Dashboard
@inject IJSRuntime JS
@inject AuroraInterop Interop
@inject NavigationManager Nav
@implements IAsyncDisposable

@* First-run welcome, in Aurora's Dialog. Shown once (remembered in local
   storage) and reachable again with Ctrl+Shift+O, exactly as before. *@

<Dialog Open="_visible"
        Title="Let's get you started"
        ConfirmLabel="Create your first AI agent"
        CancelLabel="Do this later"
        OnConfirm="@(() => GoTo("/dashboard/ai-agents"))"
        OnCancel="Dismiss">
    <GlyphContent><Icon Name="IconName.RiSparklingFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>
            Set up your workspace in a few simple steps.
        </Typography>
        <div class="onboarding__options">
            <button type="button" class="onboarding__option" @onclick="@(() => GoTo("/dashboard/ai-agents"))">
                <span class="onboarding__option-icon"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Md" /></span>
                <span class="onboarding__option-text">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Create your first AI agent</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>Give it a name, a voice and a job to do.</Typography>
                </span>
                <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" />
            </button>
            <button type="button" class="onboarding__option" @onclick="@(() => GoTo("/dashboard/channels"))">
                <span class="onboarding__option-icon"><Icon Name="IconName.RiLinksFill" Size="IconSize.Md" /></span>
                <span class="onboarding__option-text">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Connect a channel</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>WhatsApp, Instagram or Facebook.</Typography>
                </span>
                <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" />
            </button>
        </div>
        <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="onboarding__skip">
            You can always do this later from the overview.
        </Typography>
    </Body>
</Dialog>

@code {
    private const string StorageKey = "parrot_onboarded";

    private bool _visible = false;
    private DotNetObjectReference<OnboardingModal>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("eval", """
                window._parrotObRegister = function(ref) {
                    window._parrotObRef = ref;
                    if (!window._parrotObHandler) {
                        window._parrotObHandler = function(e) {
                            if (e.ctrlKey && e.shiftKey && e.key === 'O') {
                                e.preventDefault();
                                if (window._parrotObRef) window._parrotObRef.invokeMethodAsync('ShowModal');
                            }
                        };
                        document.addEventListener('keydown', window._parrotObHandler);
                    }
                };
            """);
            await JS.InvokeVoidAsync("window._parrotObRegister", _dotNetRef);

            var seen = await Interop.ReadStorageAsync(StorageKey);
            if (string.IsNullOrEmpty(seen))
            {
                _visible = true;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public void ShowModal()
    {
        _visible = true;
        StateHasChanged();
    }

    private async Task Dismiss()
    {
        _visible = false;
        await Interop.WriteStorageAsync(StorageKey, "1");
    }

    private async Task GoTo(string route)
    {
        await Dismiss();
        Nav.NavigateTo(route);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "window._parrotObRef = null; if(window._parrotObHandler){ document.removeEventListener('keydown', window._parrotObHandler); window._parrotObHandler = null; }");
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; there is no listener left to remove.
        }
        _dotNetRef?.Dispose();
    }
}
