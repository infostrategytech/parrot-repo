@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@using System.Globalization
@inject AuroraInterop Interop
@using Parrot.Web.Components.Pages.Dashboard.TaskRequests

@* A focused reference for the current conversation. Only details that help a
   teammate act are shown; speculative CRM metrics stay out. *@
<aside class="customer-panel" aria-label="Customer details">
    <header class="customer-panel__header">
        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">Customer details</Typography>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                aria-label="Close customer details" title="Close customer details" @onclick="OnClose">
            <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
        </Button>
    </header>

    <section class="customer-profile">
        <PetalAvatar Seed="@Conversation.Id" Initials="@Conversation.CustomerInitials" Size="AvatarSize.Lg" />
        <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h3">@Conversation.CustomerName</Typography>
        <div>
            <ChannelGlyph Channel="@Conversation.Channel" Compact />
            <Typography TextStyle="TextStyle.Small12Medium" As="span">@ChannelLabel(Conversation.Channel)</Typography>
            <span aria-hidden="true">·</span>
            <Typography TextStyle="TextStyle.Small12Regular" As="span">@(Conversation.Username is { Length: > 0 } ? "@" + Conversation.Username : Conversation.Sender)</Typography>
        </div>
        @* Their own chat app, one tap away, under who they are rather than as a section of its own. *@
        @if (Conversation.PlatformLink is { } link)
        {
            <a class="customer-profile__platform" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@($"{link.ButtonLabel} (opens in a new tab)")">
                <Typography TextStyle="TextStyle.Small12Medium" As="span">@link.ButtonLabel</Typography>
                <Icon Name="IconName.RiArrowRightLine" Size="IconSize.Sm" />
            </a>
        }
    </section>

    <div class="customer-panel__scroll">
        <CustomerTasks ConversationIds="@(new[] { Conversation.Id })" CustomerName="@Conversation.CustomerName" Open="Open" OnAddTask="OnAddTask" />

        <CustomerSection Title="Details">
            <div class="customer-contact-list">
                @* Each contact row copies its value; the whole row is intentionally the control. *@
                @if (Profile?.Email is { } email)
                {
                    <RowButton aria-label="@($"Copy email {email}")" OnClick='() => CopyAsync("email", email)'>
                        <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
                        <span><small>Email</small><strong>@email</strong></span>
                        <Icon Name="@(_copied == "email" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                    </RowButton>
                }
                @if (Phone is { } phone)
                {
                    <RowButton aria-label="@($"Copy phone {phone}")" OnClick='() => CopyAsync("phone", phone)'>
                        <Icon Name="IconName.RiPhoneFill" Size="IconSize.Sm" />
                        <span><small>Phone</small><strong>@phone</strong></span>
                        <Icon Name="@(_copied == "phone" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                    </RowButton>
                }
                @if (!string.IsNullOrWhiteSpace(Profile?.Location))
                {
                    <div>
                        <Icon Name="IconName.RiMapPin2Fill" Size="IconSize.Sm" />
                        <span><small>Location</small><strong>@Profile!.Location</strong></span>
                    </div>
                }
                <div>
                    <Icon Name="IconName.RiMessage2Fill" Size="IconSize.Sm" />
                    <span><small>Last message</small><strong>@DateTimeLabel(Conversation.UpdatedAt)</strong></span>
                </div>
                @if (Conversation.ReplyWindowEndsAt is { } windowEnd)
                {
                    <div>
                        <Icon Name="IconName.RiTimerFill" Size="IconSize.Sm" />
                        <span><small>Reply window</small><strong>@ReplyWindowLabel.Describe(windowEnd, DateTime.UtcNow)</strong></span>
                    </div>
                }
            </div>
        </CustomerSection>


        <CustomerMedia ConnectionId="Conversation.ConnectionId" Sender="@Conversation.Sender" Refresh="@MediaRefresh" Open="Open"
                       CustomerName="@Conversation.CustomerName" Seed="@Conversation.Id" Initials="@Conversation.CustomerInitials" OnPreview="OnPreview" />

        @if (LatestInternalNote is { } note)
        {
            <CustomerSection Title="Latest internal note">
                <article class="customer-latest-note">
                    <header>
                        <span><Icon Name="IconName.RiLock2Fill" Size="IconSize.Sm" /></span>
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@(note.Author?.Name ?? "Team member")</Typography>
                        <Typography TextStyle="TextStyle.Small10Regular" As="time">@NoteDate(note.ReceivedAt)</Typography>
                    </header>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@note.Text</Typography>
                </article>
            </CustomerSection>
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public ConversationItem Conversation { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Whether the drawer is showing. Its tasks and media are only read while it is, so closed panels cost no calls.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>A picture was chosen: the inbox opens it full screen, outside this scrolling drawer.</summary>
    [Parameter] public EventCallback<MediaViewerItem> OnPreview { get; set; }
    /// <summary>Add a task for this customer: the inbox opens its own form, over the whole app rather than inside this drawer.</summary>
    [Parameter] public EventCallback OnAddTask { get; set; }

    // Files that finish loading change the list without changing how many messages carry files.
    private string MediaRefresh => $"{Conversation.Messages.Count(m => m.Attachments.Count > 0)}:{Conversation.Messages.Sum(m => m.Attachments.Count(a => a.Status == "ready"))}";

    private static string DateTimeLabel(DateTime date) => date.ToLocalTime().ToString("d MMM yyyy, h:mm tt", CultureInfo.InvariantCulture);

    private string? _copied;
    private Parrot.Web.Services.InboxCustomerDto? Profile => Conversation.Customer;
    // WhatsApp's sender is the customer's number; on TikTok and Facebook it is an opaque id, not a phone.
    private string? Phone => Profile?.Phone ?? (Conversation.Channel == "whatsapp" ? Conversation.Sender : null);
    private ConvMessage? LatestInternalNote => Conversation.Messages
        .Where(message => message.Kind == MessageKind.Note)
        .OrderByDescending(message => message.ReceivedAt)
        .FirstOrDefault();

    private async Task CopyAsync(string field, string value)
    {
        await Interop.CopyAsync(value);
        _copied = field;
        await Task.Delay(1400);
        if (_copied == field) _copied = null;
    }

    private static string NoteDate(DateTime date) => date.ToLocalTime().ToString("d MMM, h:mm tt", CultureInfo.InvariantCulture);

    private static string ChannelLabel(string channel) => channel switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "tiktok" => "TikTok",
        "email" => "Email",
        "phone" => "Phone",
        _ => "Other"
    };
}
