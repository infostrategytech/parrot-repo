@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@using System.Globalization
@inject AuroraInterop Interop
@inject Parrot.Web.Services.ConversationClient Client
@implements IDisposable

@* A focused reference for the current conversation. Only details that help a
   teammate act are shown; speculative CRM metrics stay out. *@
<aside class="customer-panel" aria-label="Customer details">
    <header class="customer-panel__header">
        <div>
            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">Customer details</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="p">Useful details for this conversation</Typography>
        </div>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                aria-label="Close customer details" title="Close customer details" @onclick="OnClose">
            <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
        </Button>
    </header>

    <section class="customer-profile">
        <PetalAvatar Seed="@Conversation.Id" Initials="@Conversation.CustomerInitials" Size="AvatarSize.Lg" />
        <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h3">@Conversation.CustomerName</Typography>
        <div>
            <ChannelGlyph Channel="@Conversation.Channel" Compact />
            <Typography TextStyle="TextStyle.Small12Medium" As="span">@ChannelLabel(Conversation.Channel)</Typography>
            <span aria-hidden="true">·</span>
            <Typography TextStyle="TextStyle.Small12Regular" As="span">@Conversation.Sender</Typography>
        </div>
    </section>

    <div class="customer-panel__scroll">
        <CustomerSection Title="Contact">
            <div class="customer-contact-list">
                @* Each row copies its value; the whole row is intentionally the control. *@
                @if (Profile?.Email is { } email)
                {
                    <RowButton aria-label="@($"Copy email {email}")" OnClick='() => CopyAsync("email", email)'>
                        <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
                        <span><small>Email</small><strong>@email</strong></span>
                        <Icon Name="@(_copied == "email" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                    </RowButton>
                }
                @if (Phone is { } phone)
                {
                    <RowButton aria-label="@($"Copy phone {phone}")" OnClick='() => CopyAsync("phone", phone)'>
                        <Icon Name="IconName.RiPhoneFill" Size="IconSize.Sm" />
                        <span><small>Phone</small><strong>@phone</strong></span>
                        <Icon Name="@(_copied == "phone" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                    </RowButton>
                }
                @if (!string.IsNullOrWhiteSpace(Profile?.Location))
                {
                    <div>
                        <Icon Name="IconName.RiMapPin2Fill" Size="IconSize.Sm" />
                        <span><small>Location</small><strong>@Profile!.Location</strong></span>
                    </div>
                }
            </div>
        </CustomerSection>

        <CustomerSection Title="Conversation">
            <div class="customer-contact-list">
                <div>
                    <Icon Name="IconName.RiMessage2Fill" Size="IconSize.Sm" />
                    <span><small>Last message</small><strong>@DateTimeLabel(Conversation.UpdatedAt)</strong></span>
                </div>
                @if (FirstContact is { } first)
                {
                    <div>
                        <Icon Name="IconName.RiCalendarCheckFill" Size="IconSize.Sm" />
                        <span><small>@(Profile?.JoinedAt is null ? "First message" : "Customer since")</small><strong>@Date(first)</strong></span>
                    </div>
                }
                @if (Conversation.ReplyWindowEndsAt is { } windowEnd)
                {
                    <div>
                        <Icon Name="IconName.RiTimerFill" Size="IconSize.Sm" />
                        <span><small>Reply window</small><strong>@ReplyWindowLabel.Describe(windowEnd, DateTime.UtcNow)</strong></span>
                    </div>
                }
                @if (LocalTime is { } local)
                {
                    <div>
                        <Icon Name="IconName.RiGlobalFill" Size="IconSize.Sm" />
                        <span><small>Local time</small><strong>@local</strong></span>
                    </div>
                }
            </div>
            @if (Profile is { Tags.Count: > 0 })
            {
                <div class="customer-tags" aria-label="Tags">
                    @foreach (var tag in Profile.Tags)
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@tag</Typography>
                    }
                </div>
            }
        </CustomerSection>

        <CustomerSection Title="Media & files" Count="@(_loaded && _next is null ? _items.Count : null)">
            @if (_failed)
            {
                <div class="customer-media-state">
                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Media could not be loaded.</Typography>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => LoadMediaAsync(true)">Try again</Button>
                </div>
            }
            else if (!_loaded)
            {
                <div class="customer-media-grid" aria-busy="true">
                    @for (var i = 0; i < 6; i++)
                    {
                        <Skeleton Shape="SkeletonShape.Block" />
                    }
                </div>
            }
            else if (_items.Count == 0)
            {
                <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="customer-empty">Photos, videos, voice notes and documents this customer sends will appear here.</Typography>
            }
            else
            {
                <Tabs Label="Media type" Variant="TabsVariant.Segmented">
                    <Tab Selected="@(_tab == MediaTab.Media)" Count="@Visuals.Count().ToString()" OnClick="() => _tab = MediaTab.Media">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">Media</Typography>
                    </Tab>
                    <Tab Selected="@(_tab == MediaTab.Files)" Count="@Files.Count().ToString()" OnClick="() => _tab = MediaTab.Files">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">Files</Typography>
                    </Tab>
                    <Tab Selected="@(_tab == MediaTab.Links)" Count="@Links.Count().ToString()" OnClick="() => _tab = MediaTab.Links">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">Links</Typography>
                    </Tab>
                </Tabs>

                @if (_tab == MediaTab.Media)
                {
                    @if (!Visuals.Any())
                    {
                        <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="customer-empty">No photos or videos yet.</Typography>
                    }
                    else
                    {
                        <div class="customer-media-grid">
                            @foreach (var item in Visuals)
                            {
                                var file = item.Media;
                                @if (!file.Available)
                                {
                                    <span class="customer-media-tile is-unavailable" title="@($"{MediaLabels.Name(file)} could not be loaded")">
                                        <Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" />
                                    </span>
                                }
                                else if (file.Kind == "video")
                                {
                                    @* The thread's viewer shows pictures only; a video opens in the browser's player. *@
                                    <a class="customer-media-tile is-video" href="@file.Url" target="_blank" rel="noopener noreferrer"
                                       aria-label="@($"Play video from {Date(item.ReceivedAt)}")">
                                        <video src="@file.Url#t=0.1" preload="metadata" muted tabindex="-1" aria-hidden="true"></video>
                                        <span aria-hidden="true"><Icon Name="IconName.RiPlayFill" Size="IconSize.Sm" /></span>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="@($"customer-media-tile {(file.Kind == "sticker" ? "is-sticker" : null)}")"
                                            aria-label="@($"Open {MediaLabels.Name(file)} from {Date(item.ReceivedAt)}")"
                                            @onclick="() => PreviewAsync(item)">
                                        <img src="@file.Url" alt="" loading="lazy" />
                                    </button>
                                }
                            }
                        </div>
                    }
                }
                else if (_tab == MediaTab.Files)
                {
                    @if (!Files.Any())
                    {
                        <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="customer-empty">No documents or audio yet.</Typography>
                    }
                    else
                    {
                        <div class="customer-tasks">
                            @foreach (var item in Files)
                            {
                                var file = item.Media;
                                @if (file.Kind is "audio" or "voice" && file.Available)
                                {
                                    <div class="customer-audio">
                                        <Typography TextStyle="TextStyle.Small12Medium" As="small">@($"{MediaLabels.Name(file)} · {Date(item.ReceivedAt)}")</Typography>
                                        <audio controls preload="none" src="@file.Url" aria-label="@MediaLabels.Name(file)"></audio>
                                    </div>
                                }
                                else if (file.Available)
                                {
                                    <a href="@(file.Url + "?download=true")" download="@MediaLabels.Name(file)" aria-label="@($"Download {MediaLabels.Name(file)}")">
                                        <span><Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" /></span>
                                        <span>
                                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@MediaLabels.Name(file)</Typography>
                                            <Typography TextStyle="TextStyle.Small12Medium" As="small">@FileDetail(item)</Typography>
                                        </span>
                                        <span class="customer-task__arrow"><Icon Name="IconName.RiDownload2Fill" Size="IconSize.Sm" /></span>
                                    </a>
                                }
                                else
                                {
                                    <div class="customer-file-unavailable">
                                        <span><Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" /></span>
                                        <span>
                                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@MediaLabels.Name(file)</Typography>
                                            <Typography TextStyle="TextStyle.Small12Medium" As="small">Could not be loaded · @Date(item.ReceivedAt)</Typography>
                                        </span>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    @if (!Links.Any())
                    {
                        <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="customer-empty">No shared posts yet.</Typography>
                    }
                    else
                    {
                        <div class="customer-tasks">
                            @foreach (var item in Links)
                            {
                                <a href="@item.Media.Url" target="_blank" rel="noopener noreferrer" aria-label="Open shared post (opens in a new tab)">
                                    <span><Icon Name="IconName.RiLinksFill" Size="IconSize.Sm" /></span>
                                    <span>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Shared post</Typography>
                                        <Typography TextStyle="TextStyle.Small12Medium" As="small">@Date(item.ReceivedAt)</Typography>
                                    </span>
                                    <span class="customer-task__arrow"><Icon Name="IconName.RiArrowRightLine" Size="IconSize.Sm" /></span>
                                </a>
                            }
                        </div>
                    }
                }

                @if (_next is not null)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="customer-media-more" Busy="@_loadingMore" @onclick="() => LoadMediaAsync(false)">Show older</Button>
                }
            }
        </CustomerSection>

        @if (Conversation.PlatformLink is { } link)
        {
            <CustomerSection Title="Chat on their platform">
                <div class="customer-tasks">
                    <a href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@($"{link.ButtonLabel} (opens in a new tab)")">
                        <span><ChannelGlyph Channel="@Conversation.Channel" Compact /></span>
                        <span>
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@link.ButtonLabel</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="small">@link.Hint(Conversation.CustomerName)</Typography>
                        </span>
                        <span class="customer-task__arrow"><Icon Name="IconName.RiArrowRightLine" Size="IconSize.Sm" /></span>
                    </a>
                </div>
            </CustomerSection>
        }

        @if (LatestInternalNote is { } note)
        {
            <CustomerSection Title="Latest internal note">
                <article class="customer-latest-note">
                    <header>
                        <span><Icon Name="IconName.RiLock2Fill" Size="IconSize.Sm" /></span>
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@(note.Author?.Name ?? "Team member")</Typography>
                        <Typography TextStyle="TextStyle.Small10Regular" As="time">@NoteDate(note.ReceivedAt)</Typography>
                    </header>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@note.Text</Typography>
                </article>
            </CustomerSection>
        }

        @if (Profile is { RecentRequests.Count: > 0 })
        {
            <CustomerSection Title="Recent task requests" Count="@Profile.RecentRequests.Count">
                <div class="customer-tasks">
                    @foreach (var request in Profile.RecentRequests.Take(3))
                    {
                        <a href="@TaskUrl(request.Id)" aria-label="@($"Open task request {request.Id}")">
                            <span><Icon Name="IconName.RiShoppingBag3Fill" Size="IconSize.Sm" /></span>
                            <span>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@request.Id</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="small">@Date(request.PlacedAt)</Typography>
                            </span>
                            <span class="customer-task__arrow"><Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" /></span>
                        </a>
                    }
                </div>
            </CustomerSection>
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public ConversationItem Conversation { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Whether the drawer is showing. The media list is only read while it is, so closed panels cost no calls.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>A picture was chosen: the inbox opens it full screen, outside this scrolling drawer.</summary>
    [Parameter] public EventCallback<MediaViewerItem> OnPreview { get; set; }

    private enum MediaTab { Media, Files, Links }

    private MediaTab _tab = MediaTab.Media;
    private readonly List<InboxMediaItemDto> _items = [];
    private string? _next;
    private bool _loaded;
    private bool _failed;
    private bool _loadingMore;
    private string? _loadedFor;
    private CancellationTokenSource _cts = new();
    private IEnumerable<InboxMediaItemDto> Visuals => _items.Where(i => i.Media.IsVisual);
    private IEnumerable<InboxMediaItemDto> Files => _items.Where(i => !i.Media.IsVisual && !i.Media.IsLink);
    private IEnumerable<InboxMediaItemDto> Links => _items.Where(i => i.Media.IsLink);

    // Read again when the drawer opens on another customer, or when this thread gains a message with files.
    protected override async Task OnParametersSetAsync()
    {
        if (!Open) return;
        var key = $"{Conversation.Id}:{Conversation.Messages.Count(m => m.Attachments.Count > 0)}";
        if (key == _loadedFor) return;
        var sameCustomer = _loadedFor?.StartsWith(Conversation.Id + ":", StringComparison.Ordinal) == true;
        _loadedFor = key;
        if (!sameCustomer)
        {
            _items.Clear(); _next = null; _loaded = false; _failed = false; _tab = MediaTab.Media;
        }
        await LoadMediaAsync(true);
    }

    private async Task LoadMediaAsync(bool fromStart)
    {
        var token = _cts.Token;
        var forConversation = Conversation;
        try
        {
            _failed = false;
            if (!fromStart) _loadingMore = true;
            var page = await Client.MediaAsync(forConversation.ConnectionId, forConversation.Sender, fromStart ? null : _next, token);
            if (token.IsCancellationRequested || forConversation != Conversation) return;
            if (fromStart) _items.Clear();
            _items.AddRange(page.Items);
            _next = page.NextBefore;
            _loaded = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            if (!token.IsCancellationRequested) _failed = true;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private Task PreviewAsync(InboxMediaItemDto item) => OnPreview.InvokeAsync(new MediaViewerItem(
        item.Media.Url!, MediaLabels.Name(item.Media), Conversation.CustomerName, Conversation.Id, Conversation.CustomerInitials,
        DateTimeLabel(item.ReceivedAt)));

    private static string FileDetail(InboxMediaItemDto item) =>
        string.Join(" · ", new[] { MediaLabels.Type(item.Media), MediaLabels.Size(item.Media.SizeBytes), Date(item.ReceivedAt) }.Where(part => part.Length > 0));

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }

    // The customer's first message, when the whole thread is loaded (the earliest loaded one is not the first otherwise).
    private DateTime? FirstContact => Profile?.JoinedAt
        ?? (Conversation.HistoryLoaded && Conversation.NextBefore is null
            ? Conversation.Messages.Where(m => m.Kind != MessageKind.Note).Select(m => (DateTime?)m.ReceivedAt).Min()
            : null);

    private string? LocalTime
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Profile?.TimeZone)) return null;
            try { return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(Profile.TimeZone)).ToString("h:mm tt", CultureInfo.InvariantCulture); }
            catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException) { return null; }
        }
    }

    private static string DateTimeLabel(DateTime date) => date.ToLocalTime().ToString("d MMM yyyy, h:mm tt", CultureInfo.InvariantCulture);

    private string? _copied;
    private Parrot.Web.Services.InboxCustomerDto? Profile => Conversation.Customer;
    // WhatsApp's sender is the customer's number; on TikTok and Facebook it is an opaque id, not a phone.
    private string? Phone => Profile?.Phone ?? (Conversation.Channel == "whatsapp" ? Conversation.Sender : null);
    private ConvMessage? LatestInternalNote => Conversation.Messages
        .Where(message => message.Kind == MessageKind.Note)
        .OrderByDescending(message => message.ReceivedAt)
        .FirstOrDefault();

    private async Task CopyAsync(string field, string value)
    {
        await Interop.CopyAsync(value);
        _copied = field;
        await Task.Delay(1400);
        if (_copied == field) _copied = null;
    }

    private static string Date(DateTime date) => date.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    private static string NoteDate(DateTime date) => date.ToLocalTime().ToString("d MMM, h:mm tt", CultureInfo.InvariantCulture);
    private static string TaskUrl(string id) => $"/dashboard/task-requests/{Uri.EscapeDataString(id)}";

    private static string ChannelLabel(string channel) => channel switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "tiktok" => "TikTok",
        "email" => "Email",
        "phone" => "Phone",
        _ => "Other"
    };
}
