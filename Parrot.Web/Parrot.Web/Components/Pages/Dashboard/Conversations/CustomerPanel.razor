@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@using System.Globalization
@inject AuroraInterop Interop
@inject Parrot.Web.Services.ConversationClient Client
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskStore Tasks
@inject Parrot.Web.Features.Dashboard.AiAgents.State.AiAgentsState Agents
@inject Parrot.Web.Services.UserClock Clock
@inject ToastService Toasts
@inject Parrot.Web.Services.ICustomerLinks CustomerLinks
@using Parrot.Web.Components.Pages.Dashboard.Contacts
@using Parrot.Web.Features.Dashboard.TaskRequests
@using Parrot.Web.Components.Pages.Dashboard.TaskRequests
@implements IDisposable

@* Customer details: a focused reference for one customer. Only details that help a teammate act are
   shown; speculative CRM metrics stay out. One panel for the Inbox (the open conversation's customer, in its
   own drawer) and the Customers page (inside a side panel, Embedded) (designer, 21 October 2026). *@
<aside class="customer-panel @(Embedded ? "is-embedded" : null)" aria-label="Customer details">
    @if (!Embedded)
    {
        <header class="customer-panel__header">
            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">Customer details</Typography>
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                    aria-label="Close customer details" title="Close customer details" @onclick="OnClose">
                <IconLeft><Icon Name="IconName.RiCloseFill" Size="IconSize.Md" /></IconLeft>
            </Button>
        </header>
    }

    <section class="customer-profile">
        <PetalAvatar Seed="@Customer.Seed" Initials="@Customer.Initials" Size="AvatarSize.Lg" />
        <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h3">@Customer.Name</Typography>
        @if (Customer.Primary is { } primary)
        {
            <div>
                <ChannelGlyph Channel="@primary.Platform" Compact />
                <Typography TextStyle="TextStyle.Small12Medium" As="span">@ChannelLabel(primary.Platform)</Typography>
                <span aria-hidden="true">·</span>
                <Typography TextStyle="TextStyle.Small12Medium" As="span">@primary.Handle</Typography>
            </div>
        }
        @* Their own chat app, one tap away, under who they are rather than as a section of its own. *@
        @if (Customer.Primary?.PlatformLink is { } link)
        {
            <a class="customer-profile__platform" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@($"{link.ButtonLabel} (opens in a new tab)")">
                <Typography TextStyle="TextStyle.Small12Medium" As="span">@link.ButtonLabel</Typography>
                <Icon Name="IconName.RiArrowRightLine" Size="IconSize.Sm" />
            </a>
        }
    </section>

    <div class="customer-panel__scroll">
        @* What's open for this customer, and a way to add a task from here: the customer and the
           conversation come with it (designer, 20 October 2026). First, as what needs doing for them
           matters most here. Hidden until tasks can be kept. *@
        @if (Tasks.Available)
        {
            <CustomerSection Title="Tasks" Count="@(OpenTasks.Count == 0 ? null : OpenTasks.Count)">
                <div class="customer-task-list">
                    @if (_tasksError is not null)
                    {
                        <InlineError Message="@_tasksError">
                            <Action><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="LoadTasksAsync">Try again</Button></Action>
                        </InlineError>
                    }
                    @if (_tasksLoading)
                    {
                        <Skeleton Shape="SkeletonShape.Line" />
                    }
                    @foreach (var task in OpenTasks.Take(3))
                    {
                        <a href="@TaskUrl(task.Id)" class="customer-task" aria-label="@($"Open task: {task.Title}")">
                            <TaskKindMark Kind="task.Kind" Small />
                            <span class="customer-task__words">
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose Class="customer-task__title">@task.Title</Typography>
                                @* Who raised it at a glance: an agent with the look the business chose for it (designer, 21 October 2026). *@
                                <span class="customer-task__meta">
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span">@($"{TaskWords.Label(task.State)} · {(task.RaisedByAgent ? "Raised by" : "Added by")}")</Typography>
                                    @if (TaskWords.AgentLook(task, Agents.Agents) is { } look)
                                    {
                                        <span class="customer-task__look"><Parrot.Web.Components.Pages.Dashboard.AiAgents.AgentFace Look="@look" /></span>
                                    }
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span">@task.RaisedBy</Typography>
                                </span>
                            </span>
                            <span class="customer-task__arrow"><Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" /></span>
                        </a>
                    }
                    @if (OpenTasks.Count == 0 && !_tasksLoading && _tasksError is null)
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="customer-empty">@($"Nothing open for {Customer.Name}.")</Typography>
                    }
                    else if (OpenTasks.Count > 3)
                    {
                        <a href="@CustomerTaskScope.Url(Customer.Name, Customer.Channels.Where(channel => channel.HasConversation).Select(channel => channel.ConversationId))" class="customer-tasks__more">
                            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@($"See all {OpenTasks.Count} in Tasks")</Typography>
                        </a>
                    }
                    @if (Customer.CanCreateTask && OnAddTask.HasDelegate)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Class="customer-tasks__add" @onclick="OnAddTask">
                            <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                            <ChildContent>Add a task</ChildContent>
                        </Button>
                    }
                    else
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="customer-empty">You can link tasks after this customer's first conversation.</Typography>
                    }
                </div>
            </CustomerSection>
        }

        @* What the team knows about them, after what the team is doing for them: more use mid-conversation than
           their details or media (audit, 22 October 2026). *@
        @if (NotesLoading || NotesError is not null)
        {
            <CustomerSection Title="Latest internal note">
                @if (NotesLoading) { <Skeleton Shape="SkeletonShape.Line" /> }
                @if (NotesError is not null)
                {
                    <InlineError Message="@NotesError">
                        <Action><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OnRetryDetails">Try again</Button></Action>
                    </InlineError>
                }
            </CustomerSection>
        }
        else if (Customer.LatestNote is { } note)
        {
            <CustomerSection Title="Latest internal note">
                <article class="customer-latest-note">
                    <header>
                        <span><Icon Name="IconName.RiLock2Fill" Size="IconSize.Sm" /></span>
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@note.Author</Typography>
                        <Typography TextStyle="TextStyle.Small10Medium" As="time">@NoteDate(note.At)</Typography>
                    </header>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@note.Text</Typography>
                </article>
            </CustomerSection>
        }

        <CustomerSection Title="Details">
            @if (DetailsLoading)
            {
                <div class="customer-detail-loading" role="status" aria-label="Loading customer details">
                    <Skeleton Shape="SkeletonShape.Line" /><Skeleton Shape="SkeletonShape.Line" />
                </div>
            }
            @if (DetailsError is not null)
            {
                <InlineError Message="@DetailsError">
                    <Action><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OnRetryDetails">Try again</Button></Action>
                </InlineError>
            }
            <div class="customer-contact-list">
                @* Each contact row copies its value; the whole row is intentionally the control. *@
                @if (Customer.Email is { Length: > 0 } email)
                {
                    <RowButton aria-label="@($"Copy email {email}")" OnClick='() => CopyAsync("email", email)'>
                        <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
                        <span><Typography TextStyle="TextStyle.Small12Medium" As="small">Email</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@email</Typography></span>
                        <Icon Name="@(_copied == "email" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                    </RowButton>
                }
                @if (Customer.Phone is { Length: > 0 } stored)
                {
                    @* With its +, as the channel line above writes it (designer, 29 October 2026). *@
                    var phone = ContactText.Phone(stored).Number ?? stored;
                    <RowButton aria-label="@($"Copy phone {phone}")" OnClick='() => CopyAsync("phone", phone)'>
                        <Icon Name="IconName.RiPhoneFill" Size="IconSize.Sm" />
                        <span><Typography TextStyle="TextStyle.Small12Medium" As="small">Phone</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@phone</Typography></span>
                        <Icon Name="@(_copied == "phone" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                    </RowButton>
                }
                @if (Customer.Location is { Length: > 0 } location)
                {
                    <div>
                        <Icon Name="IconName.RiMapPin2Fill" Size="IconSize.Sm" />
                        <span><Typography TextStyle="TextStyle.Small12Medium" As="small">Location</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@location</Typography></span>
                    </div>
                }
                @if (Customer.LastMessageAt is { } lastAt)
                {
                    <div>
                        <Icon Name="IconName.RiMessage2Fill" Size="IconSize.Sm" />
                        <span><Typography TextStyle="TextStyle.Small12Medium" As="small">Last customer message</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@DateTimeLabel(lastAt)</Typography></span>
                    </div>
                }
                @if (Customer.ReplyWindowEndsAt is { } windowEnd)
                {
                    <div>
                        <Icon Name="IconName.RiTimerFill" Size="IconSize.Sm" />
                        <span><Typography TextStyle="TextStyle.Small12Medium" As="small">Reply window</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@ReplyWindowLabel.Describe(windowEnd, DateTime.UtcNow)</Typography></span>
                    </div>
                }
                @* Where a customer came from, when it wasn't a message: here rather than in the list (designer,
                   22 October 2026), so the list reads one fact a column, and it names the teammate once there's a team. *@
                @if (Customer.Added is { } added)
                {
                    <div>
                        <Icon Name="IconName.RiUserAddFill" Size="IconSize.Sm" />
                        <span><Typography TextStyle="TextStyle.Small12Medium" As="small">Added by</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@($"{added.By}, {Date(added.At)}")</Typography></span>
                    </div>
                }
            </div>
        </CustomerSection>

        @if (CustomerLinks.Available)
        {
            <CustomerProfiles Customer="Customer" Open="Open" OnOpenConversation="OnOpenConversation" OnChanged="OnProfilesChanged" />
        }
        else if (Customer.Channels.Count > 1)
        {
            <CustomerSection Title="Where they message you" Count="@Customer.Channels.Count">
                <div class="customer-contact-list">
                    @foreach (var channel in Customer.Channels)
                    {
                        var current = channel;
                        <div class="customer-channel">
                            <ChannelGlyph Channel="@current.Platform" Compact />
                            <span><Typography TextStyle="TextStyle.Small12Medium" As="small">@ChannelLabel(current.Platform)</Typography><Typography TextStyle="TextStyle.BodySmallMedium" As="strong">@current.Handle</Typography></span>
                            @if (OnOpenConversation.HasDelegate && current.HasConversation)
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="@($"Open the {ChannelLabel(current.Platform)} conversation")"
                                        @onclick="() => OnOpenConversation.InvokeAsync(current)">Open</Button>
                            }
                        </div>
                    }
                </div>
            </CustomerSection>
        }

        @if (Customer.Primary is { HasConversation: true })
        {
        <CustomerSection Title="Media & files" Count="@(_loaded && _next is null ? _items.Count : null)">
            @if (_failed)
            {
                <div class="customer-media-state">
                    <Typography TextStyle="TextStyle.Small12Medium" As="p">Media could not be loaded.</Typography>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => LoadMediaAsync(true)">Try again</Button>
                </div>
            }
            else if (!_loaded)
            {
                <div class="customer-media-grid" aria-busy="true">
                    @for (var i = 0; i < 6; i++)
                    {
                        <Skeleton Shape="SkeletonShape.Block" />
                    }
                </div>
            }
            else if (_items.Count == 0)
            {
                <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="customer-empty">Photos, videos, voice notes and documents this customer sends will appear here.</Typography>
            }
            else
            {
                <Tabs Label="Media type" Variant="TabsVariant.Segmented" Class="customer-media-tabs">
                    <Tab Selected="@(_tab == MediaTab.Media)" Count="@Visuals.Count().ToString()" OnClick="() => _tab = MediaTab.Media">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">Media</Typography>
                    </Tab>
                    <Tab Selected="@(_tab == MediaTab.Files)" Count="@Files.Count().ToString()" OnClick="() => _tab = MediaTab.Files">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">Files</Typography>
                    </Tab>
                    <Tab Selected="@(_tab == MediaTab.Links)" Count="@Links.Count().ToString()" OnClick="() => _tab = MediaTab.Links">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">Links</Typography>
                    </Tab>
                </Tabs>

                @if (_tab == MediaTab.Media)
                {
                    @if (!Visuals.Any())
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="customer-empty">No photos or videos yet.</Typography>
                    }
                    else
                    {
                        <div class="customer-media-grid">
                            @foreach (var item in Visuals)
                            {
                                var file = item.Media;
                                @if (!file.Available)
                                {
                                    <span class="customer-media-tile is-unavailable" title="@($"{MediaLabels.Name(file)}: {MediaLabels.Unavailable(file)}")">
                                        <Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" />
                                    </span>
                                }
                                else if (file.Kind == "video")
                                {
                                    @* The thread's viewer shows pictures only; a video opens in the browser's player. *@
                                    <a class="customer-media-tile is-video" href="@file.Url" target="_blank" rel="noopener noreferrer"
                                       aria-label="@($"Play video from {Date(item.ReceivedAt)}")">
                                        <video src="@file.Url#t=0.1" preload="metadata" muted tabindex="-1" aria-hidden="true"></video>
                                        <span aria-hidden="true"><Icon Name="IconName.RiPlayFill" Size="IconSize.Sm" /></span>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="@($"customer-media-tile {(file.Kind == "sticker" ? "is-sticker" : null)}")"
                                            aria-label="@($"Open {MediaLabels.Name(file)} from {Date(item.ReceivedAt)}")"
                                            @onclick="() => PreviewAsync(item)">
                                        <img src="@file.Url" alt="" loading="lazy" />
                                    </button>
                                }
                            }
                        </div>
                    }
                }
                else if (_tab == MediaTab.Files)
                {
                    @if (!Files.Any())
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="customer-empty">No documents or audio yet.</Typography>
                    }
                    else
                    {
                        <div class="customer-tasks">
                            @foreach (var item in Files)
                            {
                                var file = item.Media;
                                @if (file.Kind is "audio" or "voice" && file.Available)
                                {
                                    <div class="customer-audio">
                                        <Typography TextStyle="TextStyle.Small12Medium" As="small">@($"{MediaLabels.Name(file)} · {Date(item.ReceivedAt)}")</Typography>
                                        <audio controls preload="none" src="@file.Url" aria-label="@MediaLabels.Name(file)"></audio>
                                    </div>
                                }
                                else if (file.Available)
                                {
                                    <a href="@(file.Url + "?download=true")" download="@MediaLabels.Name(file)" aria-label="@($"Download {MediaLabels.Name(file)}")">
                                        <span><Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" /></span>
                                        <span>
                                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@MediaLabels.Name(file)</Typography>
                                            <Typography TextStyle="TextStyle.Small12Medium" As="small">@FileDetail(item)</Typography>
                                        </span>
                                        <span class="customer-task__arrow"><Icon Name="IconName.RiDownload2Fill" Size="IconSize.Sm" /></span>
                                    </a>
                                }
                                else
                                {
                                    <div class="customer-file-unavailable">
                                        <span><Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" /></span>
                                        <span>
                                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@MediaLabels.Name(file)</Typography>
                                            <Typography TextStyle="TextStyle.Small12Medium" As="small">Could not be loaded · @Date(item.ReceivedAt)</Typography>
                                        </span>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    @if (!Links.Any())
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="customer-empty">No shared posts yet.</Typography>
                    }
                    else
                    {
                        <div class="customer-tasks">
                            @foreach (var item in Links)
                            {
                                <a href="@item.Media.Url" target="_blank" rel="noopener noreferrer" aria-label="Open shared post (opens in a new tab)">
                                    <span><Icon Name="IconName.RiLinksFill" Size="IconSize.Sm" /></span>
                                    <span>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Shared post</Typography>
                                        <Typography TextStyle="TextStyle.Small12Medium" As="small">@Date(item.ReceivedAt)</Typography>
                                    </span>
                                    <span class="customer-task__arrow"><Icon Name="IconName.RiArrowRightLine" Size="IconSize.Sm" /></span>
                                </a>
                            }
                        </div>
                    }
                }

                @if (_next is not null)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="customer-media-more" Busy="@_loadingMore" @onclick="() => LoadMediaAsync(false)">Show older</Button>
                }
            }
        </CustomerSection>
        }


    </div>
</aside>


@code {
    /// <summary>Who: the open conversation's customer (CustomerView.From), or one from the customers API.</summary>
    [Parameter, EditorRequired] public CustomerView Customer { get; set; } = default!;

    /// <summary>Inside another panel that has its own heading and close (the Customers page): no drawer of its own.</summary>
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public bool DetailsLoading { get; set; }
    [Parameter] public string? DetailsError { get; set; }
    [Parameter] public bool NotesLoading { get; set; }
    [Parameter] public string? NotesError { get; set; }
    [Parameter] public EventCallback OnRetryDetails { get; set; }
    [Parameter] public EventCallback<Parrot.Web.Services.CustomerDetailDto> OnProfilesChanged { get; set; }

    /// <summary>Open one of their conversations (Customers, for a customer on more than one channel).</summary>
    [Parameter] public EventCallback<CustomerChannel> OnOpenConversation { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Whether the drawer is showing. The media list is only read while it is, so closed panels cost no calls.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>A picture was chosen: the inbox opens it full screen, outside this scrolling drawer.</summary>
    [Parameter] public EventCallback<MediaViewerItem> OnPreview { get; set; }
    /// <summary>Add a task for this customer: the inbox opens its own form, over the whole app rather than inside this drawer.</summary>
    [Parameter] public EventCallback OnAddTask { get; set; }

    private enum MediaTab { Media, Files, Links }

    private MediaTab _tab = MediaTab.Media;
    private readonly List<InboxMediaItemDto> _items = [];
    private string? _next;
    private bool _loaded;
    private bool _failed;
    private bool _loadingMore;
    private string? _loadedFor, _mediaFor;
    private CancellationTokenSource _cts = new();
    private IEnumerable<InboxMediaItemDto> Visuals => _items.Where(i => i.Media.IsVisual);
    private IEnumerable<InboxMediaItemDto> Files => _items.Where(i => !i.Media.IsVisual && !i.Media.IsLink);
    private IEnumerable<InboxMediaItemDto> Links => _items.Where(i => i.Media.IsLink);
    private bool _clockRead;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open || _clockRead) return;
        _clockRead = true;
        await Clock.ReadAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    // Read again when the drawer opens on another customer, or when this thread gains a message with files.
    protected override async Task OnParametersSetAsync()
    {
        if (!Open) { _loadedFor = null; _tasksFor = null; return; }
        if (Tasks.Available && _tasksFor != TasksKey)
        {
            _tasksFor = TasksKey;
            await LoadTasksAsync();
        }
        // Media is read for the conversation the panel is about; the key changes when its files do.
        if (Customer.Primary is not { HasConversation: true } primary) return;
        var key = Customer.MediaKey.Length > 0 ? Customer.MediaKey : primary.ConversationId;
        if (key == _loadedFor) return;
        var sameCustomer = _mediaFor == primary.ConversationId;
        _loadedFor = key;
        _mediaFor = primary.ConversationId;
        if (!sameCustomer)
        {
            _items.Clear(); _next = null; _loaded = false; _failed = false; _tab = MediaTab.Media;
        }
        await LoadMediaAsync(true);
    }

    private async Task LoadMediaAsync(bool fromStart)
    {
        if (_disposed) return;
        var token = _cts.Token;
        if (Customer.Primary is not { HasConversation: true } forChannel) return;
        try
        {
            _failed = false;
            if (!fromStart) _loadingMore = true;
            var page = await Client.MediaAsync(forChannel.ConnectionId, forChannel.Sender, fromStart ? null : _next, token);
            if (token.IsCancellationRequested || forChannel.ConversationId != Customer.Primary?.ConversationId) return;
            if (fromStart) _items.Clear();
            _items.AddRange(page.Items);
            _next = page.NextBefore;
            _loaded = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            if (!token.IsCancellationRequested) _failed = true;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private Task PreviewAsync(InboxMediaItemDto item) => OnPreview.InvokeAsync(new MediaViewerItem(
        item.Media.Url!, MediaLabels.Name(item.Media), Customer.Name, Customer.Seed, Customer.Initials,
        DateTimeLabel(item.ReceivedAt)));

    private string FileDetail(InboxMediaItemDto item) =>
        string.Join(" · ", new[] { MediaLabels.Type(item.Media), MediaLabels.Size(item.Media.SizeBytes), Date(item.ReceivedAt) }.Where(part => part.Length > 0));

    private bool _disposed;
    public void Dispose() { _disposed = true; _cts.Cancel(); _cts.Dispose(); Tasks.Changed -= TasksChanged; }

    // ── Tasks for this customer ──

    private IReadOnlyList<TaskRequest> OpenTasks { get; set; } = [];
    private bool _tasksLoading;
    private string? _tasksError;
    private string? _tasksFor;
    // Tasks for any of their conversations; for someone with none yet, the ones added for them by name.
    private string TasksKey => string.Join("|", Customer.Channels.Select(channel => channel.ConversationId)) + "#" + Customer.Name;
    private string? UnlinkedName => Customer.Channels.Any(channel => channel.HasConversation) ? null : Customer.Name;

    protected override void OnInitialized() => Tasks.Changed += TasksChanged;

    private void TasksChanged()
    {
        if (!Open || _disposed) return;
        _ = InvokeAsync(async () => { await LoadTasksAsync(); if (!_disposed) StateHasChanged(); });
    }

    private async Task LoadTasksAsync()
    {
        if (_disposed || !Tasks.Available) return;
        var token = _cts.Token;
        var key = TasksKey;
        var ids = Customer.Channels.Where(channel => channel.HasConversation).Select(channel => channel.ConversationId).ToHashSet();
        _tasksLoading = true; _tasksError = null; OpenTasks = [];
        try
        {
            try { await Agents.LoadAsync(); }
            catch (Exception exception) when (Parrot.Web.Features.Dashboard.AiAgents.State.AiAgentsState.IsFailure(exception)) { }
            var tasks = await Tasks.ListAsync(token);
            if (key != TasksKey || token.IsCancellationRequested) return;
            var unlinked = UnlinkedName;
            OpenTasks = tasks.Where(task => !task.IsClosed && TaskWords.IsFor(task, ids, unlinked))
                .OrderByDescending(task => task.Urgent).ThenByDescending(task => task.RaisedAt).ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            if (key == TasksKey) _tasksError = "Tasks couldn't be loaded.";
        }
        finally { if (key == TasksKey) _tasksLoading = false; }
    }

    private string DateTimeLabel(DateTime date) => Clock.ToLocal(date).ToString("d MMM yyyy, h:mm tt", CultureInfo.InvariantCulture);

    private string? _copied;

    private async Task CopyAsync(string field, string value)
    {
        try
        {
            await Interop.CopyAsync(value);
            _copied = field;
            Toasts.Show(field == "phone" ? "Phone number copied." : "Email copied.");
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1400, _cts.Token);
            if (_copied == field) _copied = null;
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            Toasts.Show("Couldn't copy. Try again.", ToastStatus.Error);
        }
    }

    private string Date(DateTime date) => Clock.ToLocal(date).ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    private string NoteDate(DateTime date) => Clock.ToLocal(date).ToString("d MMM, h:mm tt", CultureInfo.InvariantCulture);
    private static string TaskUrl(string id) => $"/dashboard/tasks/{Uri.EscapeDataString(id)}";

    private static string ChannelLabel(string channel) => channel switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "tiktok" => "TikTok",
        "email" => "Email",
        "phone" => "Phone",
        _ => "Other"
    };
}
