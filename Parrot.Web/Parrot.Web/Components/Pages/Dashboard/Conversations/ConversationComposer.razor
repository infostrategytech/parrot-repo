@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@using Parrot.Web.Services
@inject AuroraInterop Interop

@* React's composer. A reply goes through Parrot's send (SendReplyRequest:
   RequestId + Text), with the same request id kept for a safe retry. A picture
   or file (the paperclip, beside saved replies) goes through the attachments endpoint
   with the typed text as its caption. Saved replies and AI drafts have no
   endpoint yet: they are offered only when CanUseFeatures confirms API
   support, and otherwise left out. Internal notes have their own endpoints
   (CanAddNotes). *@
<div class="conversation-composer @ModeClass @(ReplyLocked || WindowClosed ? "is-reply-locked" : null)">
    <header>
        <Tabs Label="Message type" Variant="TabsVariant.Flat">
            <Tab Selected="@(Mode == ComposerMode.Reply)" OnClick="() => ChangeModeAsync(ComposerMode.Reply)">Reply</Tab>
            <Tab Selected="@(Mode == ComposerMode.Note)" Disabled="@(!CanAddNotes)"
                 Title="@(CanAddNotes ? null : "Internal notes are not available")"
                 OnClick="() => ChangeModeAsync(ComposerMode.Note)">Internal note</Tab>
        </Tabs>
    </header>

    @if (WindowClosed)
    {
        @* The channel would refuse a reply, so there is no reply box: the conversation continues on the customer's own platform. *@
        <ChannelHandoff Conversation="@Conversation" />
    }
    else
    {
        @if (Mode == ComposerMode.Note)
        {
            <div class="conversation-composer__disclosure is-note">
                <Icon Name="IconName.RiLock2Fill" />
                <Typography TextStyle="TextStyle.Small10Medium" As="span">Only your team sees this note. It's never sent to the customer.</Typography>
            </div>
        }
        else if (Conversation.Channel == "facebook" && !string.IsNullOrWhiteSpace(AttachmentName))
        {
            <div class="conversation-composer__disclosure">
                <Icon Name="IconName.RiAttachment2" />
                <Typography TextStyle="TextStyle.Small10Medium" As="span">Messenger sends a file on its own. Your text stays here to send next.</Typography>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(DraftedBy))
        {
            <div class="conversation-composer__disclosure">
                <Icon Name="IconName.RiRobot3Fill" />
                <Typography TextStyle="TextStyle.Small10Medium" As="span">Drafted by @DraftedBy. Review before sending.</Typography>
            </div>
        }

        @if (Mode == ComposerMode.Reply && !string.IsNullOrWhiteSpace(AttachmentName))
        {
            <div class="conversation-composer__attachment">
                <Icon Name="IconName.RiAttachment2" />
                <Typography TextStyle="TextStyle.Small10Medium" As="span">@AttachmentName</Typography>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Remove attachment" disabled="@InputDisabled"
                        @onclick="RemoveAttachmentAsync">
                    <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
                </Button>
            </div>
        }

        @if (Mode == ComposerMode.Reply && ReplyingTo is { } quote)
        {
            @* The message this reply quotes, above the box (designer, 19 October 2026): a quiet card with a reply
               arrow in the quoted side's colour, who wrote it ("You" for the business's own, as WhatsApp says),
               and up to two lines of what they said. ✕ or Esc sends a plain reply instead. *@
            <div class="@($"conversation-composer__quote {(quote.Outgoing ? "is-own" : null)}")" role="status">
                <span class="conversation-composer__quote-glyph" aria-hidden="true"><Icon Name="IconName.RiReplyFill" Size="IconSize.Sm" /></span>
                <div class="conversation-composer__quote-text">
                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong"><span class="sr-only">Replying to </span>@QuoteLabels.Author(quote, Conversation.CustomerName)</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="conversation-composer__quote-body">
                        @if (QuoteLabels.Glyph(quote) is { } glyph)
                        {
                            <Icon Name="glyph" Size="IconSize.Inherit" Class="conversation-composer__quote-media" />
                        }
                        @QuoteLabels.Text(quote)
                    </Typography>
                </div>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Cancel reply" title="Cancel reply (Esc)"
                        disabled="@Sending" @onclick="OnCancelReply">
                    <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
                </Button>
            </div>
        }

        <TextArea @ref="_field"
                  Value="@Text"
                  ValueChanged="OnTextChanged"
                  OnKeyDown="OnKeyDown"
                  Variant="TextAreaVariant.Plain"
                  TextStyle="TextStyle.BodyDefaultMedium"
                  AriaLabel="@(Mode == ComposerMode.Note ? "Internal note" : "Reply")"
                  Disabled="@InputDisabled"
                  Placeholder="@Placeholder"
                  MaxLength="4096"
                  Rows="3"
                  AutoGrow
                  SubmitOnEnter
                  FocusOnPush />

        <footer>
            <div class="conversation-composer__tools">
                @if (Mode == ComposerMode.Reply)
                {
                    @* The browser opens its file picker only for a click on a real
                       file input, so the button forwards one to this hidden input. *@
                    <InputFile @key="_fileKey" @ref="_file" class="sr-only" tabindex="-1" aria-hidden="true" accept="@Accept" OnChange="OnFileSelected" />
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="conversation-composer__tool"
                            aria-label="Attach a picture or file" title="@AttachTitle" disabled="@(InputDisabled || !CanAttach)" @onclick="PickFileAsync">
                        <IconLeft><Icon Name="IconName.RiAttachment2" /></IconLeft>
                    </Button>
                }
                @if (CanUseFeatures)
                {
                    <SavedRepliesMenu Disabled="@(InputDisabled || Mode == ComposerMode.Note)" OnSelect="SelectSavedReplyAsync" />
                }
                <EmojiPicker Class="conversation-composer__tool" Disabled="@InputDisabled" OnPick="InsertEmojiAsync" />
            </div>

            @if (CanDraft)
            {
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Busy="@Drafting" disabled="@Drafting" @onclick="OnDraft">
                    <IconLeft><Icon Name="IconName.RiSparklingFill" /></IconLeft>
                    <ChildContent>@(Drafting ? "Drafting" : $"Draft with {Conversation.AiAgent!.Name}")</ChildContent>
                </Button>
            }

            <span class="conversation-composer__hint">
                <Typography TextStyle="TextStyle.Small10Regular" As="span">@(Text.Length > 0 ? $"{Text.Length} characters" : "")</Typography>
                @* As WhatsApp Web: Enter sends, so only the less obvious key is shown. *@
                <kbd class="@TextStyle.Small10Semibold.ToClassName()">Shift</kbd><kbd class="@TextStyle.Small10Semibold.ToClassName()">Enter</kbd>
                <Typography TextStyle="TextStyle.Small10Regular" As="span">new line</Typography>
            </span>

            <Button Size="ButtonSize.Small" Busy="@Sending" disabled="@(!CanSend)" @onclick="OnSend">
                <IconLeft><Icon Name="IconName.RiSendPlaneFill" /></IconLeft>
                <ChildContent>@SendLabel</ChildContent>
            </Button>
        </footer>
    }
</div>

@code {
    [Parameter, EditorRequired] public ConversationItem Conversation { get; set; } = default!;
    [Parameter] public ComposerMode Mode { get; set; }
    [Parameter] public EventCallback<ComposerMode> ModeChanged { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public bool Sending { get; set; }
    /// <summary>A previous send did not confirm: the same text and request id are kept for a safe retry.</summary>
    [Parameter] public bool Retry { get; set; }
    /// <summary>Attachments, saved replies and AI drafts can be used.</summary>
    [Parameter] public bool CanUseFeatures { get; set; }
    /// <summary>Internal notes can be saved. They need no AI features: only the notes endpoints.</summary>
    [Parameter] public bool CanAddNotes { get; set; }
    [Parameter] public string? AttachmentName { get; set; }
    [Parameter] public EventCallback<InboxPendingFile?> OnAttachmentChanged { get; set; }
    /// <summary>The chosen file cannot be sent (too large, empty or the wrong type); the message says why.</summary>
    [Parameter] public EventCallback<string> OnAttachmentRejected { get; set; }

    [Parameter] public string? DraftedBy { get; set; }
    [Parameter] public bool Drafting { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }
    /// <summary>The message the reply quotes, or null for a plain reply.</summary>
    [Parameter] public InboxQuoteDto? ReplyingTo { get; set; }
    /// <summary>The quote was dismissed (✕ or Esc): the reply goes out without it.</summary>
    [Parameter] public EventCallback OnCancelReply { get; set; }

    /// <summary>Puts the cursor in the box, as choosing Reply on a message does.</summary>
    public void Focus()
    {
        _focusPending = true;
        StateHasChanged();
    }
    [Parameter] public EventCallback OnDraft { get; set; }

    private InputFile? _file;
    private TextArea? _field;

    // Whether this conversation's reply box was locked last render, so taking
    // over can put the caret in it: the reason to take over is to answer.
    private string? _lockSeenFor;
    private bool _wasLocked;
    private bool _focusPending;

    private bool ReplyLocked => Mode == ComposerMode.Reply && Conversation.ReplyLocked;

    // The channel would refuse the reply, so the box says so rather than letting it be typed first.
    // Not while a timed-out send waits for its check: the server answers that from the first request.
    private bool WindowClosed => Mode == ComposerMode.Reply && !Retry && Conversation.ReplyWindowClosed;
    private string ChannelLabel => Conversation.Channel switch { "facebook" => "Messenger", "tiktok" => "TikTok", "instagram" => "Instagram", _ => "WhatsApp" };
    private bool InputDisabled => Sending || Retry || ReplyLocked || WindowClosed;
    // A file can go without text; a note and a plain reply need some.
    private bool CanSend => !Sending && !ReplyLocked && !WindowClosed
        && (!string.IsNullOrWhiteSpace(Text) || (Mode == ComposerMode.Reply && !string.IsNullOrWhiteSpace(AttachmentName)));
    private bool CanAttach => Conversation.Channel is "whatsapp" or "facebook";
    private string AttachTitle => CanAttach ? "Attach a picture or file" : "Files cannot be sent on this channel yet";
    private const string Accept = ".jpg,.jpeg,.png,.pdf,.txt,.doc,.docx,.xls,.xlsx,.ppt,.pptx";
    private bool CanDraft => CanUseFeatures && Mode == ComposerMode.Reply && Conversation.HasAiAgent && !ReplyLocked && !WindowClosed;
    private string ModeClass => Mode == ComposerMode.Note ? "is-note" : "is-reply";
    private string Placeholder => Mode == ComposerMode.Note
        ? "Leave private context for your team..."
        : WindowClosed
            ? "Reply window closed"
            : ReplyLocked
                ? Conversation.RepliesAsTeam
                    ? $"{Conversation.TeamName} currently control customer replies"
                    : $"{Conversation.AiAgent?.Name ?? "The AI agent"} currently controls customer replies"
                : $"Reply to {Conversation.CustomerName}...";
    // "Send" holds while a send is in flight: the button's Busy state draws the
    // brand's relay dots in the icon slot rather than swapping the label.
    private string SendLabel => Retry ? "Check / retry" : Mode == ComposerMode.Note ? "Add note" : "Send";

    protected override void OnParametersSet()
    {
        if (Conversation.Id == _lockSeenFor && _wasLocked && !ReplyLocked) _focusPending = true;
        _lockSeenFor = Conversation.Id;
        _wasLocked = ReplyLocked;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _field is null) return;
        _focusPending = false;
        await _field.FocusAsync();
    }

    private Task OnTextChanged(string? value) => TextChanged.InvokeAsync(value ?? "");

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        // Enter sends and Shift+Enter breaks the line (the TextArea keeps Enter
        // from adding a newline). Enter that confirms an IME composition is ignored.
        if (args.Key == "Enter" && !args.ShiftKey && !args.IsComposing && CanSend) await OnSend.InvokeAsync();
        else if (args.Key == "Escape" && ReplyingTo is not null && !Sending) await OnCancelReply.InvokeAsync();
    }

    private async Task ChangeModeAsync(ComposerMode mode)
    {
        await ModeChanged.InvokeAsync(mode);
    }

    private async Task PickFileAsync()
    {
        if (_file?.Element is { } element) await Interop.ClickAsync(element);
    }

    // A new input each time, so choosing the same file again after removing it still raises a change.
    private int _fileKey;

    private static readonly HashSet<string> Extensions = new(Accept.Split(','), StringComparer.OrdinalIgnoreCase);

    private async Task RemoveAttachmentAsync()
    {
        _fileKey++;
        await OnAttachmentChanged.InvokeAsync(null);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        var picture = Path.GetExtension(file.Name).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png";
        var rejected =
            !Extensions.Contains(Path.GetExtension(file.Name)) ? "Attach a JPEG or PNG picture, or a PDF, Word, Excel, PowerPoint or text file."
            : file.Size == 0 ? "That file is empty."
            : picture && file.Size > 5 * 1024 * 1024 ? "Pictures can be up to 5 MB."
            : file.Size > InboxPendingFile.MaxBytes ? "Files can be up to 16 MB."
            : null;
        _fileKey++;
        if (rejected is not null)
        {
            await OnAttachmentRejected.InvokeAsync(rejected);
            return;
        }
        // Read now, once, into an array of the right size: a retry after a dropped connection must send the same bytes.
        var bytes = new byte[file.Size];
        await using (var stream = file.OpenReadStream(InboxPendingFile.MaxBytes)) await stream.ReadExactlyAsync(bytes);
        await OnAttachmentChanged.InvokeAsync(new InboxPendingFile(file.Name, file.ContentType, bytes));
    }

    // At the caret, as typing it would, not tacked on the end.
    private Task InsertEmojiAsync(string emoji) => _field?.InsertAsync(emoji) ?? Task.CompletedTask;

    private Task SelectSavedReplyAsync(string body) => TextChanged.InvokeAsync(body);
}
