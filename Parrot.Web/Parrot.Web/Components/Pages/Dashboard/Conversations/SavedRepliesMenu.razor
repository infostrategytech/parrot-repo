@namespace Parrot.Web.Components.Pages.Dashboard.Conversations

@* Parrot has no saved-replies endpoint. The menu opens to Aurora's empty
   state; creating a reply is drawn disabled because nothing could store it. *@
<div class="saved-replies">
    <button type="button" class="saved-replies__trigger" aria-label="Open saved replies" title="Saved replies"
            aria-haspopup="dialog" aria-expanded="@_open" disabled="@Disabled" @onclick="Toggle">
        <Icon Name="IconName.RiBookmarkFill" Size="IconSize.Sm" />
    </button>

    @if (_open)
    {
        <button type="button" class="saved-replies__dismiss" tabindex="-1" aria-hidden="true" @onclick="Close"></button>
        <section class="saved-replies__menu" role="dialog" aria-label="Saved replies">
            <header>
                <span><Icon Name="IconName.RiBookmarkFill" Size="IconSize.Sm" /></span>
                <div>
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Saved replies</Typography>
                    <Typography TextStyle="TextStyle.Small10Regular" As="small">Insert or create a reusable response</Typography>
                </div>
                <button type="button" class="saved-replies__new" disabled title="Saved replies are not available yet">
                    <Icon Name="IconName.RiAddFill" />
                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">New</Typography>
                </button>
            </header>

            <EmptyState Size="EmptyStateSize.Panel" Glyph="IconName.RiBookmarkFill"
                        Title="No saved replies yet" Description="Create one for answers your team sends often." />
        </section>
    }
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;
}
