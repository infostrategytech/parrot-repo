@page "/dashboard/conversations"
@page "/dashboard/conversations/{ConversationId}"
@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@layout DashboardLayout
@implements IDisposable
@inject Parrot.Web.Components.Pages.Dashboard.Conversations.ConversationsState ConversationsState
@inject Parrot.Web.Services.ConversationClient Client
@inject Parrot.Web.Services.IInboxFeatures Features
@inject AuthState AuthState
@inject NavigationManager Nav
@inject AuroraInterop Interop
@inject ToastService Toasts
@inject Parrot.Web.Services.FeedbackService Feedback
@inject Parrot.Web.Services.Realtime.RealtimeClient Realtime
@inject Parrot.Web.Services.InboxUnreadState Unread

<PageTitle>Inbox · OmniAI</PageTitle>

@* The React inbox (project aurora frontend) over Parrot's conversations.
   Parrot lists conversations in pages of 50, reads the selected thread, takes
   live pushes from the messaging hub, polls as a safety net (every 15 seconds
   while connected, 5 while not) and sends replies; it has no filter or search endpoint,
   so the queue is searched, filtered and sorted over the loaded list.

   Parts of the design need data the API does not send yet (channels other
   than WhatsApp, AI agents, assignment, status). Each part is
   drawn only when its data is present, so the real app shows what the API
   supports. See InboxContracts. *@
<div class="@($"inbox-workspace {(_selected is not null ? "is-thread-open" : "")}")">
    <section class="inbox-queue" aria-label="Unified inbox">
        <header class="inbox-queue__header">
            <div>
                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h1">Inbox</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>
                    Customer conversations across your connected channels.
                </Typography>
            </div>
            <Button Size="ButtonSize.Medium" Class="inbox-start" aria-label="Start conversation" title="Start conversation"
                    @onclick="StartConversation">
                <IconLeft><Icon Name="IconName.HiPlus" /></IconLeft>
            </Button>
        </header>

        <div class="inbox-search-wrap">
            <SearchField Value="@_filters.Search"
                         ValueChanged="OnSearchChanged"
                         AriaLabel="Search conversations"
                         Placeholder="Search people and messages"
                         ShortcutKey="k" />
        </div>

        <div class="inbox-scope-row">
            <Tabs Label="Inbox scope" Variant="TabsVariant.Segmented" Class="inbox-scopes">
                @foreach (var scope in ScopeOptions)
                {
                    <Tab Selected="@(_filters.Scope == scope.Value)"
                         Disabled="@(scope.Value != InboxScope.All && !HasAssignment)"
                         Title="@(scope.Value != InboxScope.All && !HasAssignment ? "Assignment is not available yet" : null)"
                         Count="@ScopeCount(scope.Value)"
                         OnClick="() => SetScope(scope.Value)">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">@scope.Label</Typography>
                    </Tab>
                }
            </Tabs>

            @* The count of filters in use sits on the icon; the label says it too. *@
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Medium"
                    Class="@($"inbox-filter-toggle {(_filtersOpen || ActiveFilterCount > 0 ? "is-active" : "")}")"
                    aria-label="@(ActiveFilterCount > 0 ? $"Toggle conversation filters, {ActiveFilterCount} in use" : "Toggle conversation filters")"
                    aria-expanded="@(_filtersOpen ? "true" : "false")"
                    @onclick="ToggleFilters">
                <IconLeft>
                    <Icon Name="IconName.HiAdjustmentsHorizontal" Size="IconSize.Sm" />
                    @if (ActiveFilterCount > 0)
                    {
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="inbox-filter-toggle__count">@ActiveFilterCount</Typography>
                    }
                </IconLeft>
            </Button>
        </div>

        @if (_filtersOpen)
        {
            <div class="inbox-filters">
                <FilterPopover Label="@ChannelLabel" Title="Social channels" Subtitle="Choose a connected inbox"
                               Open="@(_openFilter == "channel")" OpenChanged="@(open => SetOpenFilter("channel", open))">
                    <Leading>@ChannelMark(_filters.Channel)</Leading>
                    <ChildContent>
                        @foreach (var option in ChannelOptions)
                        {
                            <PopoverOption Label="@option.Label" Description="@option.Description" Active="@(_filters.Channel == option.Value)"
                                           OnSelect="() => SetChannel(option.Value)">
                                <Leading>@ChannelMark(option.Value)</Leading>
                            </PopoverOption>
                        }
                    </ChildContent>
                </FilterPopover>

                @if (HasStatus)
                {
                    <FilterPopover Label="@StatusLabel" Title="Conversation status" Subtitle="Choose a workflow stage" AlignEnd
                                   Open="@(_openFilter == "status")" OpenChanged="@(open => SetOpenFilter("status", open))">
                        <Leading>@StatusMark(_filters.Status)</Leading>
                        <ChildContent>
                            @foreach (var option in StatusOptions)
                            {
                                <PopoverOption Label="@option.Label" Description="@option.Description" Active="@(_filters.Status == option.Value)"
                                               OnSelect="() => SetStatus(option.Value)">
                                    <Leading>@StatusMark(option.Value)</Leading>
                                </PopoverOption>
                            }
                        </ChildContent>
                    </FilterPopover>
                }

                @if (HasAiData)
                {
                    <FilterPopover Label="@AgentLabel" Title="AI specialists" Subtitle="Filter by who is handling it"
                                   Open="@(_openFilter == "agent")" OpenChanged="@(open => SetOpenFilter("agent", open))">
                        <Leading>@AgentMark(_filters.AgentId)</Leading>
                        <ChildContent>
                            <PopoverOption Label="All AI agents" Description="Every specialist" Active="@(_filters.AgentId is null)"
                                           OnSelect="() => SetAgent(null)">
                                <Leading>@AgentMark(null)</Leading>
                            </PopoverOption>
                            @foreach (var agent in Agents)
                            {
                                <PopoverOption Label="@agent.Name" Description="@AgentRole(agent.Id)" Active="@(_filters.AgentId == agent.Id)"
                                               OnSelect="() => SetAgent(agent.Id)">
                                    <Leading>@AgentMark(agent.Id)</Leading>
                                </PopoverOption>
                            }
                        </ChildContent>
                    </FilterPopover>
                }

                <FilterPopover Label="@SortLabel" Title="Sort conversations" Subtitle="Choose the queue order" AlignEnd Class="inbox-filter-sort"
                               Open="@(_openFilter == "sort")" OpenChanged="@(open => SetOpenFilter("sort", open))">
                    <Leading>@SortMark(_filters.Sort)</Leading>
                    <ChildContent>
                        @foreach (var option in SortOptions)
                        {
                            <PopoverOption Label="@option.Label" Description="@option.Description" Active="@(_filters.Sort == option.Value)"
                                           OnSelect="() => SetSort(option.Value)">
                                <Leading>@SortMark(option.Value)</Leading>
                            </PopoverOption>
                        }
                    </ChildContent>
                </FilterPopover>

                @if (ActiveFilterCount > 0)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="inbox-filters__clear" @onclick="ClearFilters">
                        Clear
                    </Button>
                }
            </div>
        }

        <div class="inbox-queue__summary">
            <Typography TextStyle="TextStyle.Small12Medium" As="span">@Items.Count in this view</Typography>
        </div>

        <div class="inbox-list" aria-busy="@(_busy && _initialLoad)">
            @if (_initialLoad && ConversationsState.Conversations.Count == 0 && _error is null)
            {
                @for (var index = 0; index < 6; index++)
                {
                    <div class="inbox-list__skeleton">
                        <Skeleton Shape="SkeletonShape.Circle" Width="32px" Order="@(index * 3)" />
                        <span><Skeleton Width="58%" Order="@(index * 3)" /><Skeleton Width="88%" Order="@(index * 3 + 1)" /><Skeleton Width="44%" Order="@(index * 3 + 2)" /></span>
                    </div>
                }
            }
            else
            {
                @if (_error is not null)
                {
                    <InlineError Message="@_error" OnDismiss="() => _error = null" />
                }

                @if (ConversationsState.Conversations.Count == 0)
                {
                    @if (_error is null)
                    {
                        <EmptyState Size="EmptyStateSize.Panel"
                                    Title="No messages yet"
                                    Description="Send a WhatsApp message to your connected business number.">
                            <GlyphContent><img class="inbox-mascot" src="assets/images/mascot/empty-inbox.png" alt="" /></GlyphContent>
                        </EmptyState>
                    }
                }
                else if (Items.Count == 0)
                {
                    <EmptyState Size="EmptyStateSize.Panel"
                                Title="No conversations found"
                                Description="Try adjusting your search or filters.">
                        <GlyphContent><img class="inbox-mascot" src="assets/images/mascot/empty-inbox.png" alt="" /></GlyphContent>
                    </EmptyState>
                }
                else
                {
                    @foreach (var conversation in Items)
                    {
                        <ConversationRow @key="conversation.Id"
                                         Conversation="conversation"
                                         Selected="@(conversation.Id == _selected?.Id)"
                                         OnSelect="() => SelectConversationAsync(conversation.Id)" />
                    }

                    @if (_more)
                    {
                        <div class="inbox-list__more">
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@_busy" @onclick="LoadMoreAsync">
                                Load more conversations
                            </Button>
                        </div>
                    }
                }
            }
        </div>
    </section>

    <section class="inbox-conversation" aria-label="Conversation">
        @if (_selected is null)
        {
            <div class="inbox-stage">
                <img class="inbox-stage__mascot" src="assets/images/mascot/empty-inbox.png" alt="" />
                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Select a conversation</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="inbox-stage__copy">
                    Choose an item from the inbox to see the complete customer conversation.
                </Typography>
            </div>
        }
        else
        {
            <header class="inbox-conversation__header">
                @* Phones show one pane at a time; this returns to the list. Hidden on wider screens. *@
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="inbox-back"
                        aria-label="Back to inbox" title="Back to inbox" @onclick="BackToList">
                    <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                </Button>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="inbox-customer-trigger"
                        aria-label="View customer details" title="View customer details"
                        aria-controls="customer-details-panel" aria-expanded="@_customerOpen"
                        @onclick="OpenCustomerDetailsAsync">
                    <ChildContent>
                        <PetalAvatar Seed="@_selected.Id" Initials="@_selected.CustomerInitials" Size="AvatarSize.Md" />
                        <span class="inbox-conversation__identity">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">@_selected.CustomerName</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="inbox-conversation__meta">
                                <ChannelGlyph Channel="@_selected.Channel" Tile Compact />
                                @ChannelName(_selected.Channel)
                                @if (_selected.ReplyWindowEndsAt is not null)
                                {
                                    <span aria-hidden="true">·</span>
                                    <ReplyWindowChip Conversation="@_selected" />
                                }
                                @if (_selected.Status is { } status)
                                {
                                    <span aria-hidden="true">·</span>
                                    <strong class="inbox-status is-@status.ToString().ToLowerInvariant()">@status</strong>
                                }
                            </Typography>
                        </span>
                    </ChildContent>
                </Button>
                <div class="inbox-conversation__actions">
                    @if (_selected.HasAiAgent)
                    {
                        <span class="inbox-agent-presence is-@_selected.AiState.ToString()!.ToLowerInvariant()">
                            <Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" />
                            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@_selected.AiAgent!.Name</Typography>
                            <i aria-hidden="true"></i>
                            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@_selected.AiState</Typography>
                        </span>
                    }
                    @if (_selected.Assignee is { } assignee)
                    {
                        <span class="inbox-ownership">
                            <PetalAvatar Seed="@assignee.Id" Initials="@Initials.From(assignee.Name)" Size="AvatarSize.Sm" />
                            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@assignee.Name</Typography>
                        </span>
                    }
                    else if (Features.Available && _selected.HasAiAgent)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" disabled="@_acting"
                                @onclick="() => ActAsync(conversation => Features.AssignToMeAsync(conversation.ConnectionId, conversation.Sender))">
                            <IconLeft><Icon Name="IconName.RiUserAddFill" /></IconLeft>
                            <ChildContent>Assign to me</ChildContent>
                        </Button>
                    }
                    <ActionMenu Label="More actions" Glyph="IconName.RiMore2Fill">
                        @if (Features.Available && _selected.HasAiAgent)
                        {
                            @if (_selected.Assignee is not null)
                            {
                                <ActionMenuItem Label="Unassign conversation" Glyph="IconName.RiUserUnfollowFill"
                                                OnClick="() => ActAsync(conversation => Features.UnassignAsync(conversation.ConnectionId, conversation.Sender))" />
                            }
                            @if (_selected.AiState != AiState.Active)
                            {
                                <ActionMenuItem Label="@($"Return to {_selected.AiAgent!.Name}")" Glyph="IconName.RiRobot3Fill"
                                                OnClick="() => ActAsync(conversation => Features.ReturnToAiAsync(conversation.ConnectionId, conversation.Sender))" />
                            }
                            else
                            {
                                <ActionMenuItem Label="Pause AI and assign to me" Glyph="IconName.RiRobot3Fill"
                                                OnClick="() => ActAsync(conversation => Features.PauseAiAsync(conversation.ConnectionId, conversation.Sender))" />
                            }
                        }
                        @if (Features.Available && _selected.UnreadCount is not null)
                        {
                            <ActionMenuItem Label="Mark as unread" Glyph="IconName.RiMailFill" OnClick="MarkUnreadAsync" />
                        }
                        <ActionMenuItem Label="Copy conversation ID" Glyph="IconName.RiFileCopyFill" OnClick="CopyConversationIdAsync" />
                    </ActionMenu>
                </div>
            </header>
            <div class="inbox-conversation__content">
                <div class="inbox-conversation__body">
                    <ConversationTimeline @key="_selected.Id" Conversation="@_selected"
                                          AuthorName="@AuthorName" AuthorSeed="@AuthorSeed" Busy="@_busy"
                                          OnLoadOlder="LoadOlderAsync" OnSent="RefreshAsync" OnChanged="RefreshAsync"
                                          OnCustomerDetails="OpenCustomerDetailsAsync" />
                </div>

                @* A raw full-area button is intentional: it is the drawer's
                   click-away surface, not a reusable application action. *@
                <button type="button" tabindex="-1" aria-hidden="true"
                        class="@($"inbox-customer-scrim {(_customerOpen ? "is-open" : "")}")"
                        @onclick="CloseCustomerDetailsAsync"></button>
                <div id="customer-details-panel"
                     class="@($"inbox-customer {(_customerOpen ? "is-open" : "")}")"
                     aria-hidden="@(!_customerOpen)" inert="@(!_customerOpen)">
                    <CustomerPanel Conversation="@_selected" OnClose="CloseCustomerDetailsAsync" />
                </div>
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public string? ConversationId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly ConversationFilters _filters = new();
    private ConversationItem? _selected;
    private string? _error;
    private string? _openFilter;
    private bool _filtersOpen;
    private bool _customerOpen;
    private bool _initialLoad = true;
    private bool _busy, _more, _disposed, _acting;
    private int _loaded = 50;
    private DotNetObjectReference<Conversations>? _self;
    private IAsyncDisposable? _customerEscape;

    private static readonly (InboxScope Value, string Label)[] ScopeOptions =
        [(InboxScope.All, "All"), (InboxScope.Mine, "Mine"), (InboxScope.Unassigned, "Unassigned")];

    private static readonly (ConversationStatus? Value, string Label, string Description)[] StatusOptions =
        [(null, "Any status", "Open and pending conversations"),
         (ConversationStatus.Open, "Open", "Active conversations"),
         (ConversationStatus.Pending, "Pending", "Waiting for an action")];

    private IReadOnlyList<ConversationItem> Loaded => ConversationsState.Conversations;

    // What the loaded conversations carry decides which parts of the design
    // are drawn; today's API sends none of these optional fields.
    private bool HasAiData => Loaded.Any(c => c.HasAiAgent);
    private bool HasAssignment => HasAiData;
    private bool HasStatus => Loaded.Any(c => c.Status is not null);
    private bool HasPriority => Loaded.Any(c => c.Priority is not null);

    /// <summary>WhatsApp always; the other social channels once a conversation arrives on one.</summary>
    private IEnumerable<(string? Value, string Label, string Description)> ChannelOptions
    {
        get
        {
            var channels = Loaded.Select(c => c.Channel).ToHashSet();
            var social = new[] { "whatsapp", "instagram", "facebook", "tiktok" }.Where(c => c == "whatsapp" || channels.Contains(c)).ToList();
            var names = social.Select(ChannelName).ToList();
            yield return (null, "All social", social.Count > 1 ? $"{string.Join(", ", names[..^1])} & {names[^1]}" : "Every connected inbox");
            foreach (var channel in social) yield return (channel, ChannelName(channel), $"{ChannelName(channel)} conversations");
        }
    }

    private IEnumerable<(ConversationSort Value, string Label, string Description)> SortOptions
    {
        get
        {
            yield return (ConversationSort.Newest, "Newest first", "Most recent activity");
            yield return (ConversationSort.Oldest, "Oldest first", "Longest waiting first");
            if (HasPriority) yield return (ConversationSort.Priority, "Priority first", "Urgent conversations first");
        }
    }

    private IEnumerable<Parrot.Web.Services.InboxPersonDto> Agents =>
        Loaded.Where(c => c.AiAgent is not null).Select(c => c.AiAgent!).DistinctBy(a => a.Id).OrderBy(a => a.Name);

    private int ActiveFilterCount => (_filters.Channel is not null ? 1 : 0) + (_filters.Status is not null ? 1 : 0) +
                                     (_filters.AgentId is not null ? 1 : 0) + (_filters.Sort != ConversationSort.Newest ? 1 : 0);
    private string ChannelLabel => ChannelOptions.First(option => option.Value == _filters.Channel).Label;
    private string StatusLabel => StatusOptions.First(option => option.Value == _filters.Status).Label;
    private string AgentLabel => Agents.FirstOrDefault(agent => agent.Id == _filters.AgentId)?.Name ?? "All AI agents";
    private string SortLabel => SortOptions.FirstOrDefault(option => option.Value == _filters.Sort).Label ?? "Newest first";

    // Outbound replies are sent from the business's WhatsApp number, so the
    // business is their author when the API does not name a teammate.
    private string AuthorName => string.IsNullOrWhiteSpace(AuthState.CurrentUser?.BusinessName) ? "You" : AuthState.CurrentUser!.BusinessName;
    private string AuthorSeed => "workspace-" + (AuthState.CurrentUser?.BusinessName ?? "");

    /// <summary>The loaded list, searched, filtered and sorted client-side.</summary>
    private IReadOnlyList<ConversationItem> Items
    {
        get
        {
            IEnumerable<ConversationItem> list = Loaded;
            var query = _filters.Search.Trim();
            if (query.Length > 0)
            {
                list = list.Where(item =>
                    item.CustomerName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    item.LastMessage.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    item.Sender.Contains(query, StringComparison.OrdinalIgnoreCase));
            }
            list = _filters.Scope switch
            {
                InboxScope.Mine => list.Where(item => item.Assignee?.IsMe == true),
                InboxScope.Unassigned => list.Where(item => item.HasAiAgent && item.Assignee is null),
                _ => list
            };
            if (_filters.Channel is { } channel) list = list.Where(item => item.Channel == channel);
            if (_filters.Status is { } status) list = list.Where(item => item.Status == status);
            if (_filters.AgentId is { } agent) list = list.Where(item => item.AiAgent?.Id == agent);
            list = _filters.Sort switch
            {
                ConversationSort.Oldest => list.OrderBy(item => item.UpdatedAt),
                ConversationSort.Priority => list.OrderByDescending(item => item.Priority ?? ConversationPriority.Normal).ThenByDescending(item => item.UpdatedAt),
                _ => list
            };
            return list.ToList();
        }
    }

    protected override void OnInitialized()
    {
        ConversationsState.Clear();
        AuthState.OnChange += AuthChanged;
        Realtime.MessageReceived += OnMessagePushed;
        Realtime.ReceiptsChanged += OnReceiptsChanged;
        Realtime.Reconnected += OnRealtimeReconnected;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Inbox from the sidebar (no id in the route): nothing is open, the page shows "Select a conversation".
        if (string.IsNullOrWhiteSpace(ConversationId))
        {
            if (_selected is not null)
            {
                await CloseCustomerDetailsAsync();
                _selected = null;
            }
            return;
        }

        // Deep link: /dashboard/conversations/{id}. The list may not be loaded
        // yet on first render; RefreshAsync honours the route then.
        if (ConversationId == _selected?.Id) return;
        var item = ConversationsState.GetConversation(ConversationId);
        if (item is null) return;
        await CloseCustomerDetailsAsync();
        _selected = item;
        await RunAsync(() => ReadSelectedAsync(false));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await RefreshAsync();
        await Realtime.StartAsync();
        _ = PollAsync();
    }

    // A push is a message already in MongoDB. A conversation the list has
    // shown takes it in place, with no read; only a new customer, or a reply
    // whose send status the push does not carry, needs one.
    private Task OnMessagePushed(Parrot.Application.Messaging.StoredMessage message) => InvokeAsync(async () =>
    {
        if (_disposed || !AuthState.IsAuthenticated) return;
        var item = ConversationsState.FindForPush(message);
        if (item is null)
        {
            await RefreshAsync();
            return;
        }

        ConversationsState.Touch(item, message);
        if (item == _selected && item.HistoryLoaded)
        {
            if (message.Outgoing)
            {
                if (item.Messages.All(m => m.Id != message.MessageId)) await RunAsync(() => ReadSelectedAsync(false));
            }
            else if (ConversationsState.MergePushed(item, message))
            {
                Feedback.Play(Parrot.Web.Services.FeedbackSound.Incoming);

                // Counted, then read straight away if the agent is looking at it.
                item.UnreadCount = (item.UnreadCount ?? 0) + 1;
                await TryMarkReadAsync(item, message.MessageId);
            }
        }
        else if (!message.Outgoing)
        {
            item.UnreadCount = (item.UnreadCount ?? 0) + 1;
        }
        StateHasChanged();
    });

    // A channel reported delivered or read for replies. Only the open thread shows them, so only it is
    // read again; if a read is already running, the next poll catches the change.
    private Task OnReceiptsChanged(Parrot.Application.Messaging.ReceiptsChanged change) => InvokeAsync(async () =>
    {
        if (_disposed || _selected is not { } open || !change.Concerns(open.ConnectionId, open.Sender)) return;
        await RunAsync(() => ReadSelectedAsync(false));
    });

    // Pushes sent while the connection was down were missed. The thread read
    // pages back until it meets a message it already has, so it fills the gap.
    private Task OnRealtimeReconnected() => InvokeAsync(RefreshAsync);

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        await CloseCustomerDetailsAsync();
        ConversationsState.Clear(); _selected = null; _loaded = 50; _initialLoad = true;
        await RefreshAsync();
        await Realtime.StartAsync();
        StateHasChanged();
    });

    // Pushes carry new messages while the hub is connected, so polling is the
    // safety net: slow then, fast while pushes cannot arrive. Replies are not
    // pushed, so the slow poll is also how another agent's reply shows.
    private static readonly TimeSpan ConnectedPoll = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan DisconnectedPoll = TimeSpan.FromSeconds(5);

    private async Task PollAsync()
    {
        try
        {
            while (!_lifetime.IsCancellationRequested)
            {
                var connected = Realtime.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
                await Task.Delay(connected ? ConnectedPoll : DisconnectedPoll, _lifetime.Token);
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy || _disposed || !AuthState.IsAuthenticated) return;
        _busy = true;
        try { await action(); _error = null; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        { _error = ex is HttpRequestException ? ex.Message : "Could not load messages. Retrying shortly."; }
        finally { _busy = false; _initialLoad = false; if (!_disposed) StateHasChanged(); }
    }

    private Task RefreshAsync() => RunAsync(async () =>
    {
        var token = AuthState.CurrentUser?.Token;
        var summaries = new List<Parrot.Web.Services.InboxConversationDto>();
        for (int skip = 0; skip < _loaded; skip += 50)
        {
            var page = await Client.ListAsync(skip, _lifetime.Token);
            summaries.AddRange(page); _more = page.Count == 50;
            if (!_more) break;
        }
        if (token != AuthState.CurrentUser?.Token || _disposed) return;
        // A conversation the list has never shown is a new customer writing in.
        // The first load is excluded, or opening the inbox would chime.
        var known = ConversationsState.Conversations.Select(c => c.Id).ToHashSet();
        ConversationsState.Apply(summaries);
        if (!_initialLoad && ConversationsState.Conversations.Any(c => !known.Contains(c.Id)))
            Feedback.Play(Parrot.Web.Services.FeedbackSound.Incoming);
        // Nothing opens by itself: opening a conversation reads it, so only a click or a deep link does.
        _selected ??= ConversationId is null ? null : ConversationsState.GetConversation(ConversationId);
        if (_selected is not null) await ReadSelectedAsync(false);
    });

    private async Task SelectConversationAsync(string id)
    {
        var item = ConversationsState.GetConversation(id);
        if (item is null) return;
        await CloseCustomerDetailsAsync();
        _selected = item;
        Nav.NavigateTo($"/dashboard/conversations/{Uri.EscapeDataString(id)}");
        // If a refresh is in flight the next poll reads the new selection.
        await RunAsync(() => ReadSelectedAsync(false));
    }

    private void BackToList() => Nav.NavigateTo("/dashboard/conversations");

    private Task LoadOlderAsync() => RunAsync(() => ReadSelectedAsync(true));

    private async Task ReadSelectedAsync(bool older)
    {
        var item = _selected;
        var token = AuthState.CurrentUser?.Token;
        if (item is null) return;
        var page = await Client.ReadAsync(item.ConnectionId, item.Sender, older ? item.NextBefore : null, _lifetime.Token);
        if (token != AuthState.CurrentUser?.Token || _disposed) return;
        var messages = page.Messages.ToList();
        var cursor = page.NextBefore;
        // Catch up across multiple pages after a burst without leaving gaps in loaded history.
        if (!older && item.HistoryLoaded && item.Messages.Count > 0)
        {
            var known = item.Messages.Select(m => m.Id).ToHashSet();
            while (cursor is not null && !messages.Any(m => known.Contains(m.Id)))
            {
                var previous = await Client.ReadAsync(item.ConnectionId, item.Sender, cursor, _lifetime.Token);
                if (token != AuthState.CurrentUser?.Token || _disposed) return;
                messages.AddRange(previous.Messages);
                cursor = previous.NextBefore;
            }
        }
        // New incoming messages in the open thread get the bubble; the agent's
        // own replies and a first load of the history do not.
        var seen = item.Messages.Select(m => m.Id).ToHashSet();
        var wasLoaded = item.HistoryLoaded;
        ConversationsState.Merge(item, messages);
        if (!older && wasLoaded && item.Messages.Any(m => m.Kind == MessageKind.Customer && !seen.Contains(m.Id)))
            Feedback.Play(Parrot.Web.Services.FeedbackSound.Incoming);
        if (older || !item.HistoryLoaded) item.NextBefore = page.NextBefore;
        item.HistoryLoaded = true;
        // Reading a thread reads its messages, up to the newest this read returned.
        if (!older && item.UnreadCount > 0 && page.Messages.LastOrDefault() is { } newest)
            await TryMarkReadAsync(item, newest.Id);
    }

    // Tells the server the agent has seen the thread up to a message, so the count survives a refresh
    // and a sign-in on another device. Only while the page is on screen: a message that arrives in a
    // background tab stays unread, and the next poll marks it once the tab is back. The counts drop
    // at once; the server's answer then replaces them. A failed call puts them back and the next
    // poll tries again.
    private async Task TryMarkReadAsync(ConversationItem item, string upToMessageId)
    {
        if (item != _selected || _disposed) return;
        try { if (!await Interop.IsPageVisibleAsync()) return; }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException) { return; }

        int before = item.UnreadCount ?? 0;
        item.UnreadCount = 0;
        Unread.Adjust(-before);
        try
        {
            var result = await Client.MarkReadAsync(item.ConnectionId, item.Sender, upToMessageId, _lifetime.Token);
            if (_disposed) return;
            item.UnreadCount = result.ConversationUnread;
            Unread.Set(result.Total);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        {
            item.UnreadCount = before;
            Unread.Adjust(before);
        }
    }

    private async Task LoadMoreAsync() { _loaded += 50; await RefreshAsync(); }

    /// <summary>An inbox action, then a fresh read so the change arrives the same way every change does.</summary>
    private async Task ActAsync(Func<ConversationItem, Task> action)
    {
        if (_selected is not { } conversation || _acting) return;
        _acting = true;
        try { await action(conversation); }
        catch (Exception ex) when (ex is InvalidOperationException or NotSupportedException) { Toasts.ShowError(ex.Message); }
        finally { _acting = false; }
        await RefreshAsync();
    }

    /// <summary>
    /// Marks it unread and closes it, as mail and WhatsApp do: kept open, the
    /// next read would mark it read again. The row keeps its unread badge.
    /// </summary>
    private async Task MarkUnreadAsync()
    {
        if (_selected is not { } conversation) return;
        try { await Features.MarkUnreadAsync(conversation.ConnectionId, conversation.Sender); }
        catch (Exception ex) when (ex is InvalidOperationException or NotSupportedException) { Toasts.ShowError(ex.Message); return; }
        await CloseCustomerDetailsAsync();
        _selected = null;
        Nav.NavigateTo("/dashboard/conversations");
        await RefreshAsync();
    }

    private async Task CopyConversationIdAsync()
    {
        if (_selected is null) return;
        await Interop.CopyAsync(_selected.Id);
        Toasts.Show("Conversation ID copied");
    }

    private async Task OpenCustomerDetailsAsync()
    {
        if (_customerOpen || _selected is null) return;
        _customerOpen = true;
        if (_self is not null)
            _customerEscape = await Interop.BindEscapeAsync(_self, nameof(CloseCustomerDetailsAsync));
    }

    [JSInvokable]
    public async Task CloseCustomerDetailsAsync()
    {
        if (!_customerOpen && _customerEscape is null) return;
        _customerOpen = false;
        if (_customerEscape is not null)
        {
            await _customerEscape.DisposeAsync();
            _customerEscape = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void StartConversation() =>
        Toasts.Show("Starting a conversation is not available yet", ToastStatus.Info,
            "Customers start conversations by messaging your connected channels.");

    private void OnSearchChanged(string? value) => _filters.Search = value ?? "";

    private void SetScope(InboxScope scope) => _filters.Scope = scope;
    private void SetChannel(string? channel) { _filters.Channel = channel; _openFilter = null; }
    private void SetStatus(ConversationStatus? status) { _filters.Status = status; _openFilter = null; }
    private void SetAgent(string? agent) { _filters.AgentId = agent; _openFilter = null; }
    private void SetSort(ConversationSort sort) { _filters.Sort = sort; _openFilter = null; }

    private void ClearFilters()
    {
        _filters.Channel = null;
        _filters.Status = null;
        _filters.AgentId = null;
        _filters.Sort = ConversationSort.Newest;
        _openFilter = null;
    }

    private void ToggleFilters()
    {
        _filtersOpen = !_filtersOpen;
        if (!_filtersOpen) _openFilter = null;
    }

    private Task SetOpenFilter(string name, bool open)
    {
        _openFilter = open ? name : null;
        return Task.CompletedTask;
    }

    // Counts describe the whole loaded inbox, never the current filter.
    // Without assignment data Mine and Unassigned have no count to show.
    private string ScopeCount(InboxScope scope) => scope switch
    {
        InboxScope.All => Loaded.Count.ToString(),
        _ when !HasAssignment => "—",
        InboxScope.Mine => Loaded.Count(c => c.Assignee?.IsMe == true).ToString(),
        _ => Loaded.Count(c => c.HasAiAgent && c.Assignee is null).ToString()
    };

    // Aurora's three specialists; an agent the design does not know shows no role.
    private static string AgentRole(string id) => id switch
    {
        "kora" => "Sales & growth",
        "nia" => "Support & care",
        "tobi" => "Orders & products",
        _ => "AI agent"
    };

    // React's filter marks: a filled circle per option (the agent's colour, the
    // status's tone), or the channel's own mark. Drawn here, because they are
    // this page's vocabulary; FilterPopover only lays them out.
    private static RenderFragment Mark(string tone, IconName glyph) =>
        @<span class="inbox-mark is-@tone"><Icon Name="glyph" Size="IconSize.Sm" /></span>;

    private static RenderFragment ChannelMark(string? channel) => channel is null
        ? Mark("brand", IconName.RiChat3Fill)
        : @<span class="inbox-mark is-channel"><ChannelGlyph Channel="@channel" /></span>;

    private static RenderFragment StatusMark(ConversationStatus? status) => status switch
    {
        ConversationStatus.Open => Mark("open", IconName.RiChat3Fill),
        ConversationStatus.Pending => Mark("pending", IconName.RiTimerFill),
        _ => Mark("all", IconName.RiInbox2Fill)
    };

    private static RenderFragment AgentMark(string? agent) => Mark(agent ?? "all", IconName.RiRobot3Fill);

    private static RenderFragment SortMark(ConversationSort sort) => sort switch
    {
        ConversationSort.Oldest => Mark("oldest", IconName.RiTimer2Fill),
        ConversationSort.Priority => Mark("priority", IconName.RiArrowUpDownFill),
        _ => Mark("newest", IconName.RiTimerFill)
    };

    private static IconName ChannelIcon(string? channel) => channel switch
    {
        "whatsapp" => IconName.RiWhatsappFill,
        "instagram" => IconName.RiInstagramFill,
        "facebook" => IconName.RiFacebookCircleFill,
        "tiktok" => IconName.RiTiktokFill,
        _ => IconName.RiChat3Fill
    };

    private static string ChannelName(string channel) => channel switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "tiktok" => "TikTok",
        _ => channel
    };

    public void Dispose()
    {
        _disposed = true; AuthState.OnChange -= AuthChanged;
        Realtime.MessageReceived -= OnMessagePushed; Realtime.ReceiptsChanged -= OnReceiptsChanged; Realtime.Reconnected -= OnRealtimeReconnected;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (_customerEscape is not null) _ = _customerEscape.DisposeAsync().AsTask().ContinueWith(_ => _self?.Dispose());
        else _self?.Dispose();
    }
}
