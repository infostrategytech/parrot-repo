@page "/dashboard/inbox"
@page "/dashboard/inbox/{ConversationId}"
@attribute [RequiresAccess(AccessRules.Inbox)]
@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@layout DashboardLayout
@implements IDisposable
@inject Parrot.Web.Components.Pages.Dashboard.Conversations.ConversationsState ConversationsState
@inject Parrot.Web.Services.ConversationClient Client
@inject Parrot.Web.Services.IInboxFeatures Features
@inject AuthState AuthState
@inject NavigationManager Nav
@inject AuroraInterop Interop
@inject ToastService Toasts
@inject Parrot.Web.Services.FeedbackService Feedback
@inject Parrot.Web.Services.Realtime.RealtimeClient Realtime
@inject Parrot.Web.Services.InboxUnreadState Unread
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskStore Tasks
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskQuestions TaskQuestions
@inject Parrot.Web.Features.Dashboard.AiAgents.State.AiAgentsState AgentSetup

<PageTitle>Inbox · yára</PageTitle>

@* The React inbox (project aurora frontend) over Parrot's conversations.
   Parrot lists conversations in pages of 50, reads the selected thread, takes
   live pushes from the messaging hub, polls as a safety net (every 15 seconds
   while connected, 5 while not) and sends replies; it has no filter or search endpoint,
   so the queue is searched, filtered and sorted over the loaded list.

   Parts of the design need data the API does not send yet (channels other
   than WhatsApp, AI agents, assignment, status). Each part is
   drawn only when its data is present, so the real app shows what the API
   supports. See InboxContracts. *@
<div class="inbox-workspace @(Reading ? "is-reading" : null)">
    <section class="inbox-queue" aria-label="Unified inbox">
        <header class="inbox-queue__header">
            <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h1">Inbox</Typography>
            <Button Size="ButtonSize.Medium" Class="inbox-start" aria-label="Start conversation" title="Start conversation"
                    @onclick="StartConversation">
                <IconLeft><Icon Name="IconName.HiPlus" /></IconLeft>
            </Button>
        </header>

        <div class="inbox-search-wrap">
            <SearchField Value="@_filters.Search"
                         ValueChanged="OnSearchChanged"
                         AriaLabel="Search conversations"
                         Placeholder="Search people and messages"
                         ShortcutKey="k" />
        </div>

        <div class="inbox-scope-row">
            <Tabs Label="Inbox scope" Variant="TabsVariant.Segmented" Class="inbox-scopes">
                @foreach (var scope in ScopeOptions)
                {
                    <Tab Selected="@(_filters.Scope == scope.Value)"
                         Count="@ScopeCount(scope.Value)"
                         OnClick="() => SetScope(scope.Value)">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">@scope.Label</Typography>
                    </Tab>
                }
            </Tabs>

            @* The count of filters in use sits on the icon; the label says it too. *@
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Medium"
                    Class="@($"inbox-filter-toggle {(_filtersOpen || ActiveFilterCount > 0 ? "is-active" : "")}")"
                    aria-label="@(ActiveFilterCount > 0 ? $"Toggle conversation filters, {ActiveFilterCount} in use" : "Toggle conversation filters")"
                    aria-expanded="@(_filtersOpen ? "true" : "false")"
                    @onclick="ToggleFilters">
                <IconLeft>
                    <Icon Name="IconName.HiAdjustmentsHorizontal" Size="IconSize.Sm" />
                    @if (ActiveFilterCount > 0)
                    {
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="inbox-filter-toggle__count">@ActiveFilterCount</Typography>
                    }
                </IconLeft>
            </Button>
        </div>

        @if (_filtersOpen)
        {
            <div class="inbox-filters">
                <FilterPopover Label="@ChannelLabel" Title="Social channels" Subtitle="Choose a connected inbox"
                               Open="@(_openFilter == "channel")" OpenChanged="@(open => SetOpenFilter("channel", open))">
                    <Leading>@ChannelMark(_filters.Channel)</Leading>
                    <ChildContent>
                        @foreach (var option in ChannelOptions)
                        {
                            <PopoverOption Label="@option.Label" Active="@(_filters.Channel == option.Value)"
                                           OnSelect="() => SetChannel(option.Value)">
                                <Leading>@ChannelMark(option.Value)</Leading>
                            </PopoverOption>
                        }
                    </ChildContent>
                </FilterPopover>

                @if (HasStatus)
                {
                    <FilterPopover Label="@StatusLabel" Title="Conversation status" Subtitle="Choose a workflow stage" AlignEnd
                                   Open="@(_openFilter == "status")" OpenChanged="@(open => SetOpenFilter("status", open))">
                        <Leading>@StatusMark(_filters.Status)</Leading>
                        <ChildContent>
                            @foreach (var option in StatusOptions)
                            {
                                <PopoverOption Label="@option.Label" Active="@(_filters.Status == option.Value)"
                                               OnSelect="() => SetStatus(option.Value)">
                                    <Leading>@StatusMark(option.Value)</Leading>
                                </PopoverOption>
                            }
                        </ChildContent>
                    </FilterPopover>
                }

                @if (HasAiData)
                {
                    <FilterPopover Label="@AgentLabel" Title="AI specialists" Subtitle="Filter by who is handling it"
                                   Open="@(_openFilter == "agent")" OpenChanged="@(open => SetOpenFilter("agent", open))">
                        <Leading>@AgentMark(_filters.AgentId)</Leading>
                        <ChildContent>
                            <PopoverOption Label="All AI agents" Active="@(_filters.AgentId is null)"
                                           OnSelect="() => SetAgent(null)">
                                <Leading>@AgentMark(null)</Leading>
                            </PopoverOption>
                            @foreach (var agent in Agents)
                            {
                                @* No role line: "All AI agents" above carries none, and a
                                   filter picks by name. The roles belong on the agents page. *@
                                <PopoverOption Label="@agent.Name" Active="@(_filters.AgentId == agent.Id)"
                                               OnSelect="() => SetAgent(agent.Id)">
                                    <Leading>@AgentMark(agent.Id)</Leading>
                                </PopoverOption>
                            }
                        </ChildContent>
                    </FilterPopover>
                }

                <FilterPopover Label="@SortLabel" Title="Sort conversations" Subtitle="Choose the queue order" AlignEnd Class="inbox-filter-sort"
                               Open="@(_openFilter == "sort")" OpenChanged="@(open => SetOpenFilter("sort", open))">
                    <Leading>@SortMark(_filters.Sort)</Leading>
                    <ChildContent>
                        @foreach (var option in SortOptions)
                        {
                            <PopoverOption Label="@option.Label" Active="@(_filters.Sort == option.Value)"
                                           OnSelect="() => SetSort(option.Value)">
                                <Leading>@SortMark(option.Value)</Leading>
                            </PopoverOption>
                        }
                    </ChildContent>
                </FilterPopover>

                @if (ActiveFilterCount > 0)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="inbox-filters__clear" @onclick="ClearFilters">
                        Clear
                    </Button>
                }
            </div>
        }

        <div class="inbox-queue__summary">
            <Typography TextStyle="TextStyle.Small12Medium" As="span">@(_onlyAiQuestions ? $"{Items.Count} {(Items.Count == 1 ? "conversation" : "conversations")} · AI questions" : $"{Items.Count} in this view")</Typography>
            @if (_onlyAiQuestions)
            {
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="ClearFilters">Clear</Button>
            }
        </div>

        <div class="inbox-list" aria-busy="@(_busy && _initialLoad)">
            @if (_initialLoad && ConversationsState.Conversations.Count == 0 && _error is null)
            {
                @for (var index = 0; index < 6; index++)
                {
                    <div class="inbox-list__skeleton">
                        <Skeleton Shape="SkeletonShape.Circle" Width="32px" Order="@(index * 3)" />
                        <span><Skeleton Width="58%" Order="@(index * 3)" /><Skeleton Width="88%" Order="@(index * 3 + 1)" /><Skeleton Width="44%" Order="@(index * 3 + 2)" /></span>
                    </div>
                }
            }
            else
            {
                @if (_error is not null)
                {
                    <InlineError Message="@_error" OnDismiss="() => _error = null" />
                }

                @if (ConversationsState.Conversations.Count == 0)
                {
                    @if (_error is null)
                    {
                        <EmptyState Size="EmptyStateSize.Panel"
                                    Title="No messages yet"
                                    Description="Send a WhatsApp message to your connected business number.">
                            <GlyphContent><img class="inbox-mascot" src="assets/images/mascot/empty-inbox.png" alt="" /></GlyphContent>
                        </EmptyState>
                    }
                }
                else if (Items.Count == 0)
                {
                    <EmptyState Size="EmptyStateSize.Panel"
                                Title="@(_filters.Scope == InboxScope.NeedsYou && ActiveFilterCount == 0 && string.IsNullOrWhiteSpace(_filters.Search) ? "You're all caught up" : "No conversations found")"
                                Description="@(_filters.Scope == InboxScope.NeedsYou && ActiveFilterCount == 0 && string.IsNullOrWhiteSpace(_filters.Search) ? "Conversations waiting for your reply, answer or approval appear here." : "Try adjusting your search or filters.")">
                        <GlyphContent><img class="inbox-mascot" src="assets/images/mascot/empty-inbox.png" alt="" /></GlyphContent>
                    </EmptyState>
                }
                else
                {
                    @foreach (var conversation in Items)
                    {
                        <ConversationRow @key="conversation.Id"
                                         Conversation="conversation"
                                         AttentionLabel="@(_filters.Scope == InboxScope.NeedsYou ? InboxAttentionRules.Label(Need(conversation)) : null)"
                                         Selected="@(conversation.Id == _selected?.Id)"
                                         OnSelect="() => SelectConversationAsync(conversation.Id)"
                                         OnTogglePin="() => TogglePinAsync(conversation)"
                                         OnToggleUnread="() => ToggleMarkedUnreadAsync(conversation)"
                                         AgentLook="@AgentLookup.Look(conversation.AiAgent?.Id, conversation.AiAgent?.Name, AgentSetup.Agents)"
                                         ChannelLooks="@ChannelLooks(conversation)" />
                    }

                    @if (_more)
                    {
                        <div class="inbox-list__more">
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@_busy" @onclick="LoadMoreAsync">
                                Load more conversations
                            </Button>
                        </div>
                    }
                }
            }
        </div>
    </section>

    <section class="inbox-conversation" aria-label="Conversation">
        @if (_selected is null)
        {
            <div class="inbox-stage">
                <img class="inbox-stage__mascot" src="assets/images/mascot/empty-inbox.png" alt="" />
                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Select a conversation</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="inbox-stage__copy">
                    Choose an item from the inbox to see the complete customer conversation.
                </Typography>
            </div>
        }
        else
        {
            <header class="inbox-conversation__header">
                <span class="inbox-back">
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" aria-label="Back to conversations" title="Back to conversations"
                            @onclick="BackToListAsync">
                        <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                    </Button>
                </span>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="inbox-customer-trigger"
                        aria-label="View customer details" title="View customer details"
                        aria-controls="customer-details-panel" aria-expanded="@_customerOpen.ToString().ToLowerInvariant()"
                        @onclick="OpenCustomerDetailsAsync">
                    <ChildContent>
                        <PetalAvatar Seed="@_selected.Id" Initials="@_selected.CustomerInitials" Size="AvatarSize.Md" />
                        <span class="inbox-conversation__identity">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">@_selected.CustomerName</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="inbox-conversation__meta">
                                <ChannelGlyph Channel="@_selected.Channel" Tile Compact />
                                @ChannelName(_selected.Channel)
                                @if (_selected.ReplyWindowEndsAt is not null)
                                {
                                    <span aria-hidden="true">·</span>
                                    <ReplyWindowChip Conversation="@_selected" />
                                }
                                @if (_selected.Status is { } status)
                                {
                                    <span aria-hidden="true">·</span>
                                    <strong class="inbox-status is-@status.ToString().ToLowerInvariant()">@status</strong>
                                }
                            </Typography>
                        </span>
                    </ChildContent>
                </Button>
                <div class="inbox-conversation__actions">
                    @* Who is replying is said once, on the takeover card above the reply box (designer, 23 November 2026): the
                       header no longer repeats it. The escalation chip stays: only it says that. *@
                    @if (_selected.HasAiAgent && _selected.ActiveEscalation is { } esc)
                    {
                        <span class="inbox-escalation-chip" title="@(esc.Problem is { Length: > 0 } p ? p : null)">
                            <Icon Name="IconName.RiAlarmWarningFill" Size="IconSize.Sm" />
                            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@HeaderEscalationText(esc)</Typography>
                        </span>
                    }
                    <ActionMenu Label="More actions" Glyph="IconName.RiMore2Fill">
                        @if (_selected.HasChannelAgent && _selected.AiState != AiState.Active)
                        {
                            <ActionMenuItem Label="@ResponseControl.ReturnWords(_selected, _selected.AiAgent?.Name ?? _selected.ChannelAgent?.Name ?? "the AI agent")" Glyph="IconName.RiRobot3Fill"
                                            OnClick="() => ActAsync(conversation => Client.ReturnToAiAsync(conversation.ConnectionId, conversation.Sender, _lifetime.Token))" />
                        }
                        <ActionMenuItem Label="@(_selected.Pinned ? "Unpin" : "Pin to top")" Glyph="IconName.RiPushpin2Fill"
                                        OnClick="() => TogglePinAsync(_selected)" />
                        <ActionMenuItem Label="Mark as unread" Glyph="IconName.RiMailFill" OnClick="MarkSelectedUnreadAsync" />
                        <ActionMenuItem Label="Copy conversation ID" Glyph="IconName.RiFileCopyFill" OnClick="CopyConversationIdAsync" />
                        @if (Tasks.Available)
                        {
                            <ActionMenuItem Label="Create task" Glyph="IconName.RiClipboardFill" OnClick="StartTask" />
                        }
                    </ActionMenu>
                </div>
            </header>
            <div class="inbox-conversation__content">
                <div class="inbox-conversation__body">
                    <ConversationTimeline @key="_selected.Id" Conversation="@_selected"
                                          AuthorName="@AuthorName" AuthorSeed="@AuthorSeed" Busy="@_busy"
                                          OnLoadOlder="LoadOlderAsync" OnSent="RefreshAsync" OnChanged="RefreshAsync"
                                          OnCustomerDetails="OpenCustomerDetailsAsync" FocusMessageId="@FocusMessage"
                                          AgentLook="@AgentLookup.Look(_selected.AiAgent?.Id, _selected.AiAgent?.Name, AgentSetup.Agents)"
                                          OnOpenTask="OpenTaskAsync" />
                </div>

                @* A raw full-area button is intentional: it is the drawer's
                   click-away surface, not a reusable application action. *@
                <button type="button" tabindex="-1" aria-hidden="true"
                        class="@($"inbox-customer-scrim {(_customerOpen ? "is-open" : "")}")"
                        @onclick="CloseCustomerDetailsAsync"></button>
                <div id="customer-details-panel"
                     class="@($"inbox-customer {(_customerOpen ? "is-open" : "")}")"
                     role="region" aria-label="Customer details" tabindex="-1" @ref="_customerPanel"
                     aria-hidden="@((!_customerOpen).ToString().ToLowerInvariant())" inert="@(!_customerOpen)">
                    <CustomerPanel Customer="@CustomerView.From(_selected)" Open="@_customerOpen" OnClose="CloseCustomerDetailsAsync"
                                   OnPreview="item => _panelMedia = item" OnAddTask="StartTask" OnOpenConversation="OpenProfileConversation" />
                </div>
            </div>
        }
    </section>
</div>

@* Outside the drawer: it scrolls and slides, and would confine a full-screen viewer to itself. *@
<MediaViewer Item="_panelMedia" OnClose="() => _panelMedia = null" />

@* A task for the open conversation: from its menu, or from the customer details. *@
@if (_selected is not null)
{
    <Parrot.Web.Components.Pages.Dashboard.TaskRequests.NewTaskDialog Open="_taskOpen" Customer="TaskCustomer(_selected)"
                                                                      OnClose="() => _taskOpen = false" OnCreated="TaskAddedAsync" />
}


@* A chat's task, over the chat: its details, status and actions without leaving the Inbox. *@
<Parrot.Web.Components.Pages.Dashboard.TaskRequests.TaskPanel Item="OpenTask" Team="_taskTeam" Now="DateTime.UtcNow"
    Look="@(OpenTask is { } shown ? Parrot.Web.Features.Dashboard.TaskRequests.TaskWords.AgentLook(shown, AgentSetup.Agents) : null)"
    OnClose="() => _openTaskId = null" OnReply="() => _openTaskId = null" />

@code {
    private bool _taskOpen;
    private void StartTask() => _taskOpen = true;

    private static Parrot.Web.Features.Dashboard.TaskRequests.TaskCustomer TaskCustomer(ConversationItem conversation) =>
        new(conversation.CustomerName, conversation.Channel,
            conversation.Username is { Length: > 0 } username ? "@" + username : conversation.Sender, conversation.Id);

    private Task TaskAddedAsync(Parrot.Web.Features.Dashboard.TaskRequests.TaskRequest task)
    {
        _taskOpen = false;
        Toasts.Show(new ToastMessage("Task added.", ActionLabel: "View", OnAction: () => Nav.NavigateTo($"/dashboard/tasks/{Uri.EscapeDataString(task.Id)}")));
        return Task.CompletedTask;
    }

    [Parameter] public string? ConversationId { get; set; }

    /// <summary>Opened at one line of the thread (a task's Reply: where the task was raised), brought into view and lit.</summary>
    [SupplyParameterFromQuery(Name = "message")] public string? FocusMessage { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? RequestedView { get; set; }
    [SupplyParameterFromQuery(Name = "questions")] public bool QuestionsOnly { get; set; }
    [SupplyParameterFromQuery(Name = "agent")] public string? RequestedAgent { get; set; }
    private bool _onlyAiQuestions;
    private string? _questionRoute;
    private string QuestionQueueQuery => _onlyAiQuestions
        ? Parrot.Web.Features.Dashboard.AiAgents.InboxQuestionLinks.Queue(_filters.AgentId)["/dashboard/inbox".Length..] : "";

    private readonly CancellationTokenSource _lifetime = new();
    private readonly ConversationFilters _filters = new();
    private ConversationItem? _selected;
    private MediaViewerItem? _panelMedia;
    private string? _error;
    private string? _openFilter;
    private bool _filtersOpen;
    private bool _customerOpen;
    private bool _initialLoad = true;
    private bool _busy, _more, _disposed, _acting;
    private int _loaded = 50;
    private DotNetObjectReference<Conversations>? _self;
    private IAsyncDisposable? _customerEscape;
    private IAsyncDisposable? _customerFocus;
    private ElementReference _customerPanel;
    private bool _customerFocusPending;

    // The faces of the agents on a conversation's channel, in its order (several agents: the list and the chip).
    private IReadOnlyList<string?> ChannelLooks(ConversationItem conversation) => conversation.ChannelAgents.Count < 2 ? []
        : [.. conversation.ChannelAgents.Select(agent => AgentLookup.Look(agent.Id, agent.Name, AgentSetup.Agents))];

    private static readonly (InboxScope Value, string Label)[] ScopeOptions =
        [(InboxScope.All, "All"), (InboxScope.Unread, "Unread"), (InboxScope.NeedsYou, "Needs you")];

    // Needs you is conversation input, not every open/urgent task. Task context remains available in the chat.
    private IReadOnlyList<Parrot.Web.Features.Dashboard.TaskRequests.TaskQuestion> _taskQuestions = [];
    // A chat's task, opened over the chat (designer, 15 November 2026): the Tasks page stays where it is.
    private IReadOnlyList<Parrot.Web.Features.Dashboard.TaskRequests.TaskRequest> _allTasks = [];
    private IReadOnlyList<Parrot.Web.Features.Dashboard.TaskRequests.TaskPerson> _taskTeam = [];
    private string? _openTaskId;
    private Parrot.Web.Features.Dashboard.TaskRequests.TaskRequest? OpenTask => _openTaskId is null ? null : _allTasks.FirstOrDefault(t => t.Id == _openTaskId);
    private async Task OpenTaskAsync(string id)
    {
        if (_taskTeam.Count == 0) { try { _taskTeam = await Tasks.TeamAsync(_lifetime.Token); } catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { } }
        if (_allTasks.All(t => t.Id != id)) await LoadQuestionsAsync();
        _openTaskId = id;
    }
    private int _questionsGeneration;
    private InboxNeed Need(ConversationItem conversation) => InboxAttentionRules.Reason(conversation, Tasks.Me.Id, _taskQuestions, AnswersAgents);
    // The people the agents' waiting questions are for; the API only flags questions for them, and a pushed approval is checked here too.
    private bool AnswersAgents => AuthState.CurrentUser?.Can(Parrot.Application.Teams.WorkspacePermissions.ConversationsTakeOver) == true;
    // What the banner's "questions need your answer" counts: agents' questions and the approvals they wait on.
    private static bool HasAgentQuestion(ConversationItem item) => item.NeedsAnswer || item.PendingApproval is not null;
    private bool NeedsMe(ConversationItem conversation) => Need(conversation) != InboxNeed.None;
    private void QuestionsChanged() { if (!_disposed) _ = InvokeAsync(async () => { await LoadQuestionsAsync(); await RefreshAsync(); StateHasChanged(); }); }
    private async Task LoadQuestionsAsync()
    {
        var generation = ++_questionsGeneration;
        try
        {
            var questions = TaskQuestions.Available ? await TaskQuestions.ListAsync(_lifetime.Token) : [];
            var tasks = Tasks.Available ? await Tasks.ListAsync(_lifetime.Token) : [];
            if (_disposed || generation != _questionsGeneration) return;
            _taskQuestions = questions;
            _allTasks = tasks;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { if (!_disposed && generation == _questionsGeneration) { _taskQuestions = []; _error = "Your tasks couldn't load. Refresh to check what needs you."; } }
    }

    // Filters are labels only: FilterPopover draws no second line (7 November 2026). "Pending" is the weak
    // one — it does not say whose move it is — but that is a label to settle, not a line to explain it away.
    private static readonly (ConversationStatus? Value, string Label)[] StatusOptions =
        [(null, "Any status"),
         (ConversationStatus.Open, "Open"),
         (ConversationStatus.Pending, "Pending")];

    private IReadOnlyList<ConversationItem> Loaded => ConversationsState.Conversations;

    // What the loaded conversations carry decides which parts of the design
    // are drawn; today's API sends none of these optional fields.
    private bool HasAiData => Loaded.Any(c => c.HasAiAgent || c.HasChannelAgent);
    private bool HasAssignment => HasAiData;
    private bool HasStatus => Loaded.Any(c => c.Status is not null);
    private bool HasPriority => Loaded.Any(c => c.Priority is not null);

    /// <summary>WhatsApp always; the other social channels once a conversation arrives on one.</summary>
    private IEnumerable<(string? Value, string Label)> ChannelOptions
    {
        get
        {
            var channels = Loaded.Select(c => c.Channel).ToHashSet();
            var social = new[] { "whatsapp", "instagram", "facebook", "tiktok" }.Where(c => c == "whatsapp" || channels.Contains(c)).ToList();
            yield return (null, "All social");
            foreach (var channel in social) yield return (channel, ChannelName(channel));
        }
    }

    private IEnumerable<(ConversationSort Value, string Label)> SortOptions
    {
        get
        {
            yield return (ConversationSort.Newest, "Newest first");
            yield return (ConversationSort.Oldest, "Oldest first");
            if (HasPriority) yield return (ConversationSort.Priority, "Priority first");
        }
    }

    private IEnumerable<Parrot.Web.Services.InboxPersonDto> Agents =>
        Loaded.Where(c => c.AiAgent is not null).Select(c => c.AiAgent!).DistinctBy(a => a.Id).OrderBy(a => a.Name);

    private int ActiveFilterCount => (_onlyAiQuestions ? 1 : 0) + (_filters.Channel is not null ? 1 : 0) + (_filters.Status is not null ? 1 : 0) +
                                     (_filters.AgentId is not null ? 1 : 0) + (_filters.Sort != ConversationSort.Newest ? 1 : 0);
    private string ChannelLabel => ChannelOptions.First(option => option.Value == _filters.Channel).Label;
    private string StatusLabel => StatusOptions.First(option => option.Value == _filters.Status).Label;
    private string AgentLabel => Agents.FirstOrDefault(agent => agent.Id == _filters.AgentId)?.Name ?? "All AI agents";
    private string SortLabel => SortOptions.FirstOrDefault(option => option.Value == _filters.Sort).Label ?? "Newest first";

    // Outbound replies are sent from the business's WhatsApp number, so the
    // business is their author when the API does not name a teammate.
    private string AuthorName => string.IsNullOrWhiteSpace(AuthState.CurrentUser?.BusinessName) ? "You" : AuthState.CurrentUser!.BusinessName;
    private string AuthorSeed => "workspace-" + (AuthState.CurrentUser?.BusinessName ?? "");

    /// <summary>The loaded list, searched, filtered and sorted client-side.</summary>
    private IReadOnlyList<ConversationItem> Items
    {
        get
        {
            IEnumerable<ConversationItem> list = Loaded;
            var query = _filters.Search.Trim();
            if (query.Length > 0)
            {
                list = list.Where(item =>
                    item.CustomerName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    item.LastMessage.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    item.Sender.Contains(query, StringComparison.OrdinalIgnoreCase));
            }
            list = _filters.Scope switch
            {
                InboxScope.Mine => list.Where(item => item.Assignee?.IsMe == true),
                InboxScope.Unassigned => list.Where(item => item.HasAiAgent && item.Assignee is null),
                InboxScope.Unread => list.Where(item => item.UnreadCount > 0 || item.MarkedUnread),
                InboxScope.NeedsYou => list.Where(NeedsMe),
                _ => list
            };
            if (_onlyAiQuestions) list = list.Where(HasAgentQuestion);
            if (_filters.Channel is { } channel) list = list.Where(item => item.Channel == channel);
            if (_filters.Status is { } status) list = list.Where(item => item.Status == status);
            if (_filters.AgentId is { } agent) list = list.Where(item => item.AiAgent?.Id == agent);
            list = ConversationsState.Order(list, _filters.Sort);
            return list.ToList();
        }
    }

    protected override void OnInitialized()
    {
        // Agents' looks for their avatars; until they load, each keeps a look of its own.
        _ = InvokeAsync(async () => { try { await AgentSetup.LoadAsync(); } catch (Exception) { } if (!_disposed) StateHasChanged(); });
        ConversationsState.Clear();
        AuthState.OnChange += AuthChanged;
        TaskQuestions.Changed += QuestionsChanged; Tasks.Changed += QuestionsChanged;
        QuestionsChanged();
        Realtime.MessageReceived += OnMessagePushed;
        Realtime.ReceiptsChanged += OnReceiptsChanged;
        Realtime.MediaChanged += OnMediaChanged;
        Realtime.Reconnected += OnRealtimeReconnected;
        Realtime.AgentActivityReceived += OnAgentActivityPushed;
    }

    protected override async Task OnParametersSetAsync()
    {
        var questionRoute = $"{RequestedView}|{QuestionsOnly}|{RequestedAgent}";
        if (questionRoute != _questionRoute)
        {
            var hadQuestionFilter = _onlyAiQuestions;
            _questionRoute = questionRoute;
            _onlyAiQuestions = QuestionsOnly;
            if (RequestedView == "needs-you") _filters.Scope = InboxScope.NeedsYou;
            if (QuestionsOnly || hadQuestionFilter) _filters.AgentId = RequestedAgent;
        }
        // Inbox from the sidebar (no id in the route): nothing is open, the page shows "Select a conversation".
        if (string.IsNullOrWhiteSpace(ConversationId))
        {
            if (_selected is not null)
            {
                await CloseCustomerDetailsAsync();
                _selected = null;
            }
            return;
        }

        // Deep link: /dashboard/inbox/{id}. The list may not be loaded
        // yet on first render; RefreshAsync honours the route then.
        if (ConversationId == _selected?.Id) return;
        var item = ConversationsState.GetConversation(ConversationId);
        if (item is null) return;
        await CloseCustomerDetailsAsync();
        _selected = item;
        await ReadSelectedSoonAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_customerFocusPending && _customerOpen)
        {
            _customerFocusPending = false;
            await Interop.FocusWhenInteractiveAsync(_customerPanel);
        }
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await RefreshAsync();
        await Realtime.StartAsync();
        _ = PollAsync();
    }

    // A push is a message already in MongoDB. A conversation the list has
    // shown takes it in place, with no read; only a new customer, or a reply
    // whose send status the push does not carry, needs one.
    private Task OnMessagePushed(Parrot.Application.Messaging.StoredMessage message) => InvokeAsync(async () =>
    {
        if (_disposed || !AuthState.IsAuthenticated) return;
        var item = ConversationsState.FindForPush(message);
        if (item is null)
        {
            await RefreshAsync();
            return;
        }

        ConversationsState.Touch(item, message);

        // Track the AI turn lifecycle: an inbound message starts a turn; an outbound AI reply ends it.
        if (item.AiState == AiState.Active)
        {
            if (!message.Outgoing) item.AiTurnInProgress = true;
            else if (message.Outgoing) item.AiTurnInProgress = false;
        }

        if (item == _selected && item.HistoryLoaded)
        {
            if (message.Outgoing)
            {
                if (item.Messages.All(m => m.Id != message.MessageId)) await ReadSelectedSoonAsync();
            }
            else if (ConversationsState.MergePushed(item, message))
            {
                Feedback.Play(Parrot.Web.Services.FeedbackSound.Incoming);

                // Counted, then read straight away if the agent is looking at it.
                item.UnreadCount = (item.UnreadCount ?? 0) + 1;
                await TryMarkReadAsync(item, message.MessageId);

                // Its files are readable only by an address the API signs when it reads the thread.
                if (message.Attachments is { Count: > 0 }) await ReadSelectedSoonAsync();
            }
        }
        else if (!message.Outgoing)
        {
            item.UnreadCount = (item.UnreadCount ?? 0) + 1;
        }
        StateHasChanged();
    });

    // A channel reported delivered or read for replies. Only the open thread shows them, so only it is
    // read again; if a read is already running, the next poll catches the change.
    private Task OnReceiptsChanged(Parrot.Application.Messaging.ReceiptsChanged change) => InvokeAsync(async () =>
    {
        if (_disposed || _selected is not { } open || !change.Concerns(open.ConnectionId, open.Sender)) return;
        await ReadSelectedSoonAsync();
    });

    // A file finished loading. Several often finish together (a message with five pictures), so the reads are
    // folded into one a moment later, and it waits out a read already running instead of being dropped by it:
    // that read may have started before the file was settled.
    private CancellationTokenSource? _mediaRefresh;

    private Task OnMediaChanged(Parrot.Application.Messaging.MediaChanged change) => InvokeAsync(() =>
    {
        if (_disposed || _selected is not { } open || !change.Concerns(open.ConnectionId, open.Sender)) return;
        _mediaRefresh?.Cancel();
        _mediaRefresh = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _ = RefreshAfterMediaAsync(_mediaRefresh.Token);
    });

    private async Task RefreshAfterMediaAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(300, ct);
            for (var waits = 0; _busy && waits < 25; waits++) await Task.Delay(200, ct);
            await InvokeAsync(ReadSelectedSoonAsync);
        }
        catch (OperationCanceledException) { }
    }

    // Pushes sent while the connection was down were missed. The thread read
    // pages back until it meets a message it already has, so it fills the gap.
    // Turn-in-progress state driven by pushes cannot be trusted after a gap: clear it so the indicator
    // doesn't stay frozen, then let the refresh bring back the authoritative AiState.
    private Task OnRealtimeReconnected() => InvokeAsync(() =>
    {
        foreach (ConversationItem conversation in ConversationsState.Conversations)
            conversation.AiTurnInProgress = false;
        return RefreshAsync();
    });

    // An orchestrator event: a turn ended, the AI asked for approval, or it escalated.
    // The event carries enough to update approval / escalation state without a network call.
    // A change to the conversation's AiState badge (escalated / failed turns, new escalations)
    // still needs a list refresh because that value lives on the server.
    private Task OnAgentActivityPushed(Parrot.Application.Agents.AgentActivityEvent activity) => InvokeAsync(async () =>
    {
        if (_disposed || !AuthState.IsAuthenticated) return;

        ConversationItem? item = ConversationsState.FindByConversationKey(activity.ConversationKey);

        if (item is null)
        {
            // The conversation is not loaded yet — refresh the list if the event changes visible state.
            if (NeedsListRefresh(activity)) await RefreshAsync();
            return;
        }

        ConversationsState.ApplyAgentActivity(item, activity);

        if (NeedsListRefresh(activity))
        {
            await RefreshAsync();
            return;
        }

        // A completed turn may have produced an AI reply; that reply arrives separately via messagePersisted,
        // so no extra fetch is needed unless the thread is open and already missed it.
        StateHasChanged();
    });

    private static bool NeedsListRefresh(Parrot.Application.Agents.AgentActivityEvent activity) =>
        activity.Type == Parrot.Application.Agents.AgentActivityTypes.EscalationOpened ||
        (activity.Type == Parrot.Application.Agents.AgentActivityTypes.TurnCompleted &&
         activity.Status is Parrot.Application.Agents.AgentActivityTypes.TurnStatus.Escalated
                         or Parrot.Application.Agents.AgentActivityTypes.TurnStatus.Failed);

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        await CloseCustomerDetailsAsync();
        ConversationsState.Clear(); _selected = null; _loaded = 50; _initialLoad = true;
        _taskQuestions = []; await LoadQuestionsAsync();
        await RefreshAsync();
        await Realtime.StartAsync();
        StateHasChanged();
    });

    // Pushes carry new messages while the hub is connected, so polling is the
    // safety net: slow then, fast while pushes cannot arrive. Replies are not
    // pushed, so the slow poll is also how another agent's reply shows.
    private static readonly TimeSpan ConnectedPoll = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan DisconnectedPoll = TimeSpan.FromSeconds(5);

    private async Task PollAsync()
    {
        try
        {
            while (!_lifetime.IsCancellationRequested)
            {
                var connected = Realtime.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
                await Task.Delay(connected ? ConnectedPoll : DisconnectedPoll, _lifetime.Token);
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy || _disposed || !AuthState.IsAuthenticated) return;
        _busy = true;
        try { await action(); _error = null; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        { _error = ex is HttpRequestException ? ex.Message : "Could not load messages. Retrying shortly."; }
        finally
        {
            _busy = false; _initialLoad = false;
            if (!_disposed) StateHasChanged();
            if (_readQueued && !_disposed) { _readQueued = false; _ = InvokeAsync(() => RunAsync(() => ReadSelectedAsync(false))); }
        }
    }

    // A read of the open conversation asked for while another load is in flight is not dropped: it runs as
    // soon as that one is done. It used to wait for the next poll (up to 15 seconds), so a conversation opened
    // during a refresh could sit on its loading placeholders.
    private bool _readQueued;
    private Task ReadSelectedSoonAsync()
    {
        if (_busy) { _readQueued = true; return Task.CompletedTask; }
        return RunAsync(() => ReadSelectedAsync(false));
    }

    private Task RefreshAsync() => RunAsync(async () =>
    {
        var token = AuthState.CurrentUser?.Token;
        var summaries = new List<Parrot.Web.Services.InboxConversationDto>();
        for (int skip = 0; skip < _loaded; skip += 50)
        {
            var page = await Client.ListAsync(skip, _lifetime.Token);
            summaries.AddRange(page); _more = page.Count >= 50; // the first page also carries pins older than it
            if (!_more) break;
        }
        if (token != AuthState.CurrentUser?.Token || _disposed) return;
        // A conversation the list has never shown is a new customer writing in.
        // The first load is excluded, or opening the inbox would chime.
        var known = ConversationsState.Conversations.Select(c => c.Id).ToHashSet();
        ConversationsState.Apply(summaries);
        if (!_initialLoad && ConversationsState.Conversations.Any(c => !known.Contains(c.Id)))
            Feedback.Play(Parrot.Web.Services.FeedbackSound.Incoming);
        // Nothing opens by itself: opening a conversation reads it, so only a click or a deep link does.
        _selected ??= ConversationId is null ? null : ConversationsState.GetConversation(ConversationId);
        if (_selected is not null) await ReadSelectedAsync(false);
    });

    // A conversation the person opened (its address), not the one shown first
    // by default: on a tablet it replaces the list until they go back.
    private bool Reading => !string.IsNullOrWhiteSpace(ConversationId) && _selected?.Id == ConversationId;

    private async Task BackToListAsync()
    {
        await CloseCustomerDetailsAsync();
        Nav.NavigateTo("/dashboard/inbox" + QuestionQueueQuery);
    }

    private async Task SelectConversationAsync(string id)
    {
        var item = ConversationsState.GetConversation(id);
        if (item is null) return;
        await CloseCustomerDetailsAsync();
        _selected = item;
        Nav.NavigateTo($"/dashboard/inbox/{Uri.EscapeDataString(id)}" + QuestionQueueQuery);
        // If a refresh is in flight, the new selection is read as soon as it is done.
        await ReadSelectedSoonAsync();
    }

    private Task LoadOlderAsync() => RunAsync(() => ReadSelectedAsync(true));

    private async Task ReadSelectedAsync(bool older)
    {
        var item = _selected;
        var token = AuthState.CurrentUser?.Token;
        if (item is null) return;
        var page = await Client.ReadAsync(item.ConnectionId, item.Sender, older ? item.NextBefore : null, _lifetime.Token);
        if (token != AuthState.CurrentUser?.Token || _disposed) return;
        var messages = page.Messages.ToList();
        var cursor = page.NextBefore;
        // Catch up across multiple pages after a burst without leaving gaps in loaded history.
        if (!older && item.HistoryLoaded && item.Messages.Count > 0)
        {
            var known = item.Messages.Select(m => m.Id).ToHashSet();
            // An agent's question rides on every newest page, so it never proves the pages meet.
            while (cursor is not null && !messages.Any(m => m.Kind != "ai_question" && known.Contains(m.Id)))
            {
                var previous = await Client.ReadAsync(item.ConnectionId, item.Sender, cursor, _lifetime.Token);
                if (token != AuthState.CurrentUser?.Token || _disposed) return;
                messages.AddRange(previous.Messages);
                cursor = previous.NextBefore;
            }
        }
        // New incoming messages in the open thread get the bubble; the agent's
        // own replies and a first load of the history do not.
        var seen = item.Messages.Select(m => m.Id).ToHashSet();
        var wasLoaded = item.HistoryLoaded;
        if (!older) ConversationsState.DropClosedQuestions(item, page.Messages);
        ConversationsState.Merge(item, messages);
        if (!older && wasLoaded && item.Messages.Any(m => m.Kind == MessageKind.Customer && !seen.Contains(m.Id)))
            Feedback.Play(Parrot.Web.Services.FeedbackSound.Incoming);
        if (older || !item.HistoryLoaded) item.NextBefore = page.NextBefore;
        item.HistoryLoaded = true;
        if (!older) await LoadNotesAsync(item);
        if (!older) await ClearMarkedUnreadAsync(item);
        // Reading a thread reads its messages, up to the newest this read returned.
        // Up to the newest message, not an agent's question: the channel knows nothing of those.
        if (!older && item.UnreadCount > 0 && page.Messages.LastOrDefault(m => m.Kind != "ai_question") is { } newest)
            await TryMarkReadAsync(item, newest.Id);
    }

    // The notes come with the thread and are read again with it, so a note added on another device appears.
    // They are not messages: a failed read leaves the notes shown as they were and never blocks the thread.
    private async Task LoadNotesAsync(ConversationItem item)
    {
        try
        {
            var notes = await Client.NotesAsync(item.ConnectionId, item.Sender, _lifetime.Token);
            if (!_disposed) ConversationsState.ApplyNotes(item, notes);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException) { }
    }

    // Tells the server the agent has seen the thread up to a message, so the count survives a refresh
    // and a sign-in on another device. Only while the page is on screen: a message that arrives in a
    // background tab stays unread, and the next poll marks it once the tab is back. The counts drop
    // at once; the server's answer then replaces them. A failed call puts them back and the next
    // poll tries again.
    private async Task TryMarkReadAsync(ConversationItem item, string upToMessageId)
    {
        if (item != _selected || _disposed) return;
        try { if (!await Interop.IsPageVisibleAsync()) return; }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException) { return; }

        int before = item.UnreadCount ?? 0;
        item.UnreadCount = 0;
        Unread.Adjust(-before);
        try
        {
            var result = await Client.MarkReadAsync(item.ConnectionId, item.Sender, upToMessageId, _lifetime.Token);
            if (_disposed) return;
            item.UnreadCount = result.ConversationUnread;
            Unread.Set(result.Total);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        {
            item.UnreadCount = before;
            Unread.Adjust(before);
        }
    }

    private async Task LoadMoreAsync() { _loaded += 50; await RefreshAsync(); }

    /// <summary>An inbox action, then a fresh read so the change arrives the same way every change does.</summary>
    private async Task ActAsync(Func<ConversationItem, Task> action)
    {
        if (_selected is not { } conversation || _acting) return;
        _acting = true;
        try { await action(conversation); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or NotSupportedException) { Toasts.ShowError(ex.Message); }
        finally { _acting = false; }
        await RefreshAsync();
    }

    // Pins are stored on the server per user, so they survive a reload and follow the user to another
    // device. The row moves at once; a failed save puts it back.
    private async Task TogglePinAsync(ConversationItem item)
    {
        bool pinned = !item.Pinned;
        item.Pinned = pinned;
        item.PinSaving = true;
        ConversationsState.Resort();
        try { await Client.SetPinnedAsync(item.ConnectionId, item.Sender, pinned, _lifetime.Token); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        {
            item.Pinned = !pinned;
            ConversationsState.Resort();
            Toasts.ShowError(pinned ? "Could not pin this conversation. Try again." : "Could not unpin this conversation. Try again.");
        }
        finally { item.PinSaving = false; }

        // A read that started before the save may have landed after it; reading again settles on what the server holds.
        await RefreshAsync();
    }

    private Task MarkSelectedUnreadAsync() => _selected is { } item && !item.MarkedUnread ? ToggleMarkedUnreadAsync(item) : Task.CompletedTask;

    /// <summary>
    /// Marks a conversation unread to come back to (the row then shows "!" in place of the count), or clears
    /// the mark. The open conversation is closed once marked: kept open, the next read would clear it again.
    /// </summary>
    private async Task ToggleMarkedUnreadAsync(ConversationItem item)
    {
        bool marked = !item.MarkedUnread;
        item.MarkedUnread = marked;
        try
        {
            var result = await Client.SetMarkedUnreadAsync(item.ConnectionId, item.Sender, marked, _lifetime.Token);
            if (_disposed) return;
            Unread.Set(result.Total);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        {
            item.MarkedUnread = !marked;
            Toasts.ShowError("Could not update this conversation. Try again.");
            return;
        }

        if (marked && item == _selected)
        {
            await CloseCustomerDetailsAsync();
            _selected = null;
            Nav.NavigateTo("/dashboard/inbox");
        }
    }

    // Opening a conversation the agent marked unread is looking at it: the mark lifts. Only while the page is
    // on screen, like a read, and the poll never sets the mark, only this clears it.
    private async Task ClearMarkedUnreadAsync(ConversationItem item)
    {
        if (item != _selected || !item.MarkedUnread || _disposed) return;
        try { if (!await Interop.IsPageVisibleAsync()) return; }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException) { return; }

        item.MarkedUnread = false;
        try
        {
            var result = await Client.SetMarkedUnreadAsync(item.ConnectionId, item.Sender, false, _lifetime.Token);
            if (!_disposed) Unread.Set(result.Total);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        {
            item.MarkedUnread = true;
        }
    }

    private async Task CopyConversationIdAsync()
    {
        if (_selected is null) return;
        await Interop.CopyAsync(_selected.Id);
        Toasts.Show("Conversation ID copied");
    }

    private async Task OpenCustomerDetailsAsync()
    {
        if (_selected is null) return;
        if (_customerOpen) { await CloseCustomerDetailsAsync(); return; }
        _customerFocus = await Interop.RememberFocusAsync();
        _customerOpen = true;
        _customerFocusPending = true;
        if (_self is not null)
            _customerEscape = await Interop.BindEscapeAsync(_self, nameof(CloseCustomerDetailsAsync), _customerPanel);
    }

    private void OpenProfileConversation(CustomerChannel channel) =>
        Nav.NavigateTo($"/dashboard/inbox/{Uri.EscapeDataString(channel.ConversationId)}");

    [JSInvokable]
    public async Task CloseCustomerDetailsAsync()
    {
        if (!_customerOpen && _customerEscape is null) return;
        _customerOpen = false;
        _customerFocusPending = false;
        if (_customerEscape is not null)
        {
            await _customerEscape.DisposeAsync();
            _customerEscape = null;
        }
        if (_customerFocus is not null)
        {
            await _customerFocus.DisposeAsync();
            _customerFocus = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void StartConversation() =>
        Toasts.Show("Starting a conversation is not available yet", ToastStatus.Info,
            "Customers start conversations by messaging your connected channels.");

    private void OnSearchChanged(string? value) => _filters.Search = value ?? "";

    private void SetScope(InboxScope scope)
    {
        _filters.Scope = scope;
        if (scope != InboxScope.NeedsYou) _onlyAiQuestions = false;
    }
    private void SetChannel(string? channel) { _filters.Channel = channel; _openFilter = null; }
    private void SetStatus(ConversationStatus? status) { _filters.Status = status; _openFilter = null; }
    private void SetAgent(string? agent) { _filters.AgentId = agent; _openFilter = null; }
    private void SetSort(ConversationSort sort) { _filters.Sort = sort; _openFilter = null; }

    private void ClearFilters()
    {
        _onlyAiQuestions = false;
        _filters.Channel = null;
        _filters.Status = null;
        _filters.AgentId = null;
        _filters.Sort = ConversationSort.Newest;
        _openFilter = null;
        if (QuestionsOnly || RequestedAgent is not null)
            Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["questions"] = null, ["agent"] = null }), replace: true);
    }

    private void ToggleFilters()
    {
        _filtersOpen = !_filtersOpen;
        if (!_filtersOpen) _openFilter = null;
    }

    private Task SetOpenFilter(string name, bool open)
    {
        _openFilter = open ? name : null;
        return Task.CompletedTask;
    }

    // Counts describe the whole loaded inbox, never the current filter.
    // Without assignment data Mine and Unassigned have no count to show.
    private string ScopeCount(InboxScope scope) => scope switch
    {
        InboxScope.All => Loaded.Count.ToString(),
        InboxScope.Unread => Loaded.Count(c => c.UnreadCount > 0 || c.MarkedUnread).ToString(),
        InboxScope.NeedsYou => Loaded.Count(NeedsMe).ToString(),
        _ when !HasAssignment => "—",
        InboxScope.Mine => Loaded.Count(c => c.Assignee?.IsMe == true).ToString(),
        _ => Loaded.Count(c => c.HasAiAgent && c.Assignee is null).ToString()
    };

    // Aurora's three specialists; an agent the design does not know shows no role.
    private static string AgentRole(string id) => id switch
    {
        "kora" => "Sales & growth",
        "nia" => "Support & care",
        "tobi" => "Orders & products",
        _ => "AI agent"
    };

    // React's filter marks: a filled circle per option (the agent's colour, the
    // status's tone), or the channel's own mark. Drawn here, because they are
    // this page's vocabulary; FilterPopover only lays them out.
    private static RenderFragment Mark(string tone, IconName glyph) =>
        @<span class="inbox-mark is-@tone"><Icon Name="glyph" Size="IconSize.Sm" /></span>;

    private static RenderFragment ChannelMark(string? channel) => channel is null
        ? Mark("brand", IconName.RiChat3Fill)
        : @<span class="inbox-mark is-channel"><ChannelGlyph Channel="@channel" /></span>;

    private static RenderFragment StatusMark(ConversationStatus? status) => status switch
    {
        ConversationStatus.Open => Mark("open", IconName.RiChat3Fill),
        ConversationStatus.Pending => Mark("pending", IconName.RiTimerFill),
        _ => Mark("all", IconName.RiInbox2Fill)
    };

    private static RenderFragment AgentMark(string? agent) => Mark(agent ?? "all", IconName.RiRobot3Fill);

    private static RenderFragment SortMark(ConversationSort sort) => sort switch
    {
        ConversationSort.Oldest => Mark("oldest", IconName.RiTimer2Fill),
        ConversationSort.Priority => Mark("priority", IconName.RiArrowUpDownFill),
        _ => Mark("newest", IconName.RiTimerFill)
    };

    private static IconName ChannelIcon(string? channel) => channel switch
    {
        "whatsapp" => IconName.RiWhatsappFill,
        "instagram" => IconName.RiInstagramFill,
        "facebook" => IconName.RiFacebookCircleFill,
        "tiktok" => IconName.RiTiktokFill,
        _ => IconName.RiChat3Fill
    };

    private static string ChannelName(string channel) => channel switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "tiktok" => "TikTok",
        _ => channel
    };

    private static string HeaderEscalationText(AgentEscalationInfo esc) =>
        esc.Priority is { Length: > 0 } priority ? $"Escalated · {priority}" : "Escalated";

    public void Dispose()
    {
        TaskQuestions.Changed -= QuestionsChanged; Tasks.Changed -= QuestionsChanged;
        _disposed = true; AuthState.OnChange -= AuthChanged;
        Realtime.MessageReceived -= OnMessagePushed; Realtime.ReceiptsChanged -= OnReceiptsChanged; Realtime.MediaChanged -= OnMediaChanged; _mediaRefresh?.Cancel(); Realtime.Reconnected -= OnRealtimeReconnected; Realtime.AgentActivityReceived -= OnAgentActivityPushed;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (_customerFocus is not null) _ = _customerFocus.DisposeAsync();
        if (_customerEscape is not null) _ = _customerEscape.DisposeAsync().AsTask().ContinueWith(_ => _self?.Dispose());
        else _self?.Dispose();
    }
}
