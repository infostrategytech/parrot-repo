@page "/dashboard/conversations"
@layout DashboardLayout
@implements IDisposable
@inject ConversationsState ConversationsState
@inject Parrot.Web.Services.ConversationClient Client
@inject AuthState AuthState
@using Parrot.Web.Components.Pages.Dashboard.Conversations

@if (_error is not null) { <p role="alert">@_error</p> }
<div class="cv-page">
    <div class="conversation-sidebar-container">
        <ConvSidebar Conversations="ConversationsState.Conversations" SelectedId="@(_selected?.Id ?? "")" OnSelect="SelectAsync" />
        @if (_more) { <button @onclick="LoadMoreAsync" disabled="@_busy">Load more conversations</button> }
    </div>
    @if (_selected is not null)
    {
        <ConvChat @key="_selected.Id" Conv="_selected" OnLoadOlder="LoadOlderAsync" OnSent="RefreshAsync" />
        <aside class="cv-details">
            <h2>Conversation details</h2>
            <p>@_selected.CustomerName</p>
            <p>WhatsApp: @_selected.Sender</p>
            <p>Manual replies</p>
        </aside>
    }
    else
    {
        <div class="cv-empty-state"><p>@(_busy ? "Loading conversations…" : "No messages yet. Send a WhatsApp message to your connected business number.")</p></div>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private ConversationItem? _selected;
    private string? _error;
    private bool _busy, _more, _disposed;
    private int _loaded = 50;

    protected override void OnInitialized()
    {
        ConversationsState.Clear();
        AuthState.OnChange += AuthChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAsync();
        _ = PollAsync();
    }
    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        ConversationsState.Clear(); _selected = null; _loaded = 50;
        await RefreshAsync();
        StateHasChanged();
    });
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(RefreshAsync); }
        catch (OperationCanceledException) { }
    }
    private async Task RunAsync(Func<Task> action)
    {
        if (_busy || _disposed || !AuthState.IsAuthenticated) return;
        _busy = true;
        try { await action(); _error = null; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        { _error = ex is HttpRequestException ? ex.Message : "Could not load messages. Retrying shortly."; }
        finally { _busy = false; if (!_disposed) StateHasChanged(); }
    }
    private Task RefreshAsync() => RunAsync(async () =>
    {
        var token = AuthState.CurrentUser?.Token;
        var summaries = new List<Parrot.Application.Conversations.ConversationSummary>();
        for (int skip = 0; skip < _loaded; skip += 50)
        {
            var page = await Client.ListAsync(skip, _lifetime.Token);
            summaries.AddRange(page); _more = page.Count == 50;
            if (!_more) break;
        }
        if (token != AuthState.CurrentUser?.Token || _disposed) return;
        ConversationsState.Apply(summaries);
        _selected ??= ConversationsState.Conversations.FirstOrDefault();
        if (_selected is not null) await ReadSelectedAsync(false);
    });
    private async Task SelectAsync(string id)
    {
        if (_busy) return;
        _selected = ConversationsState.GetConversation(id);
        await RunAsync(() => ReadSelectedAsync(false));
    }
    private Task LoadOlderAsync() => RunAsync(() => ReadSelectedAsync(true));
    private async Task ReadSelectedAsync(bool older)
    {
        var item = _selected;
        var token = AuthState.CurrentUser?.Token;
        if (item is null) return;
        var page = await Client.ReadAsync(item.ConnectionId, item.Sender, older ? item.NextBefore : null, _lifetime.Token);
        if (token != AuthState.CurrentUser?.Token || _disposed) return;
        var messages = page.Messages.ToList();
        var cursor = page.NextBefore;
        // Catch up across multiple pages after a burst without leaving gaps in loaded history.
        if (!older && item.HistoryLoaded && item.Messages.Count > 0)
        {
            var known = item.Messages.Select(m => m.Id).ToHashSet();
            while (cursor is not null && !messages.Any(m => known.Contains(m.Id)))
            {
                var previous = await Client.ReadAsync(item.ConnectionId, item.Sender, cursor, _lifetime.Token);
                if (token != AuthState.CurrentUser?.Token || _disposed) return;
                messages.AddRange(previous.Messages);
                cursor = previous.NextBefore;
            }
        }
        ConversationsState.Merge(item, messages);
        if (older || !item.HistoryLoaded) item.NextBefore = page.NextBefore;
        item.HistoryLoaded = true;
    }
    private async Task LoadMoreAsync() { _loaded += 50; await RefreshAsync(); }
    public void Dispose()
    {
        _disposed = true; AuthState.OnChange -= AuthChanged;
        _lifetime.Cancel(); _lifetime.Dispose();
    }
}
