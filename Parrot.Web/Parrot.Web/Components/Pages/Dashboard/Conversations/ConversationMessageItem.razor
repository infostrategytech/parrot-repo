@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@using System.Globalization
@using Parrot.Web.Components.Pages.Dashboard.AiAgents
@inject AuroraInterop Interop
@inject ToastService Toasts

@* The React inbox's message kinds. Today's API sends the customer's messages
   and replies from the business's number only, so real mode draws the first
   and last branches; AI replies, notes, system lines and AI questions arrive
   when the API sends a message kind. *@
@if (Message.Kind == MessageKind.System)
{
    @* A divider across the thread: what kind of event it is, what happened,
       and when, together between two rules. *@
    <div class="message-system @(_highlighted ? "is-highlighted" : null)" role="note" @ref="_element">
        <span class="message-system__event">
            <span class="message-system__glyph" aria-hidden="true"><Icon Name="@SystemGlyph" Size="IconSize.Sm" /></span>
            @* The words and their time as one run of text, so the time follows the last word wherever it wraps. *@
            <span class="message-system__words">
                <Typography TextStyle="TextStyle.Small12Medium" As="span">@Message.Text</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="time">@TimeLabel</Typography>
            </span>
        </span>
    </div>
}
else if (Message.Kind == MessageKind.AiQuestion)
{
    <article class="message-question @(Message.Answered || TaskDone ? "is-answered" : null)">
        <header>
            <span class="message-question__icon"><Icon Name="IconName.RiQuestionAnswerFill" Size="IconSize.Sm" /></span>
            <div>
                @* The same item as its task (designer, 15 November 2026): it says whose it is while it waits. Once
                   answered it just says what the agent asked; no "team", knowledge base or task words, so it reads
                   the same for a business of one. *@
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@(Resolved ? $"{AuthorLabel} asked" : $"{AuthorLabel} needs your answer")</Typography>
                @if (!Resolved)
                {
                    <Typography TextStyle="TextStyle.Small12Regular" As="small">@(TaskNote is { } note ? $"{note} · No approved answer yet" : "The AI could not find an approved answer")</Typography>
                }
            </div>
        </header>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="message-question__body">@Message.Text</Typography>
        @if (Resolved && string.IsNullOrWhiteSpace(Message.Answer))
        {
            @* Answered in the chat by a person, or closed in Tasks: nothing was learned, so it doesn't say so. *@
            <div class="message-question__answer">
                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose>@(Message.Answered ? "Answered in the chat" : "Closed in Tasks")</Typography>
            </div>
        }
        else if (Message.Answered)
        {
            <div class="message-question__answer">
                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                <span>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose>@Message.Answer</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="small">@($"{AuthorLabel} will know this next time.")</Typography>
                </span>
            </div>
        }
        else
        {
            <footer>
                <Typography TextStyle="TextStyle.Small10Regular" As="time">@TimeLabel</Typography>
                @if (CanTeach)
                {
                    <Button Size="ButtonSize.Small" @onclick="() => OnAnswer.InvokeAsync(Message)">Answer @AuthorLabel</Button>
                }
            </footer>
        }
    </article>
}
else if (Message.Kind == MessageKind.Note)
{
    <article class="message-note">
        <PetalAvatar Seed="@AvatarSeed" Initials="@AvatarInitials" Size="AvatarSize.Md" />
        <div class="message-note__card">
            <header>
                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@AuthorLabel</Typography>
                <span class="message-note__private">
                    <Icon Name="IconName.RiLock2Fill" />
                    <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Private</Typography>
                </span>
                <Typography TextStyle="TextStyle.Small10Regular" As="time">@NoteTimeLabel</Typography>
                @if (_confirmingDelete)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="message-note__delete is-confirming"
                            @onclick="DeleteNoteAsync">Delete note?</Button>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="message-note__delete"
                            @onclick="() => _confirmingDelete = false">Keep</Button>
                }
                else
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="message-note__delete"
                            aria-label="Delete note" title="Delete note" @onclick="() => _confirmingDelete = true">
                        <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
                    </Button>
                }
            </header>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="message-note__body">@Message.Text</Typography>
        </div>
    </article>
}
else
{
    @* As WhatsApp Web: double-click the empty space beside a message (its row, not the message) to reply to it. *@
    <div class="message-row @DirectionClass" @ondblclick="ReplyAsync">
    <article class="message-bubble @DirectionClass @KindClass @(_highlighted ? "is-highlighted" : null)" @ref="_element" @ondblclick:stopPropagation>
        @if (Message.Kind == MessageKind.Ai)
        {
            @if ((AgentLook ?? AgentMascot) is { } look)
            {
                <span class="message-bubble__ai-face"><Parrot.Web.Components.Pages.Dashboard.AiAgents.AgentFace Look="@look" /></span>
            }
            else
            {
                <span class="message-bubble__ai-avatar"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" /></span>
            }

        }
        else if (Message.Kind == MessageKind.Customer)
        {
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="message-customer-trigger"
                    aria-label="@($"View {CustomerName}'s details")" title="View customer details"
                    @onclick="OnCustomerDetails">
                <IconLeft><PetalAvatar Seed="@AvatarSeed" Initials="@AvatarInitials" Size="AvatarSize.Md" /></IconLeft>
            </Button>
        }
        else
        {
            <PetalAvatar Seed="@AvatarSeed" Initials="@AvatarInitials" Size="AvatarSize.Md" />
        }

        <div class="message-bubble__content">
            <header>
                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@AuthorLabel</Typography>
            </header>

            @* The message itself (its quote, words and files): hovered, it shows its arrow. *@
            <div class="message-bubble__box">
            @if (Message.ReplyTo is { } quote)
            {
                @* The message this replies to; choosing it scrolls to the original when the thread has it. *@
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="@($"message-quote {(quote.Outgoing ? "is-own" : null)}")"
                        disabled="@(quote.Id is null)" aria-label="@($"Replying to {QuoteLabels.Author(quote, CustomerName)}: {QuoteLabels.Text(quote)}")"
                        title="@(quote.Id is null ? null : "Go to the original message")"
                        @onclick="() => OnJumpTo.InvokeAsync(quote.Id!)">
                    <ChildContent>
                        <span class="message-quote__glyph" aria-hidden="true"><Icon Name="IconName.RiReplyFill" Size="IconSize.Sm" /></span>
                        <span class="message-quote__text">
                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@QuoteLabels.Author(quote, CustomerName)</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">@QuoteLabels.Text(quote)</Typography>
                        </span>
                    </ChildContent>
                </Button>
            }

            @if (Message.Text.Length > 0)
            {
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="message-bubble__body">@Message.Text</Typography>
            }

            @if (Message.Attachment is { } attachment)
            {
                @if (attachment.Type == "image" && attachment.Url is not null)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="message-image"
                            aria-label="@($"Preview {attachment.Name}")" @onclick="() => OpenImage(attachment)">
                        <ChildContent>
                            <img src="@AssetUrl(attachment.Url)" alt="" />
                            <span class="message-image__caption"><Icon Name="IconName.RiAttachment2" />@attachment.Name</span>
                        </ChildContent>
                    </Button>
                }
                else
                {
                    <div class="message-attachment">
                        <Icon Name="IconName.RiAttachment2" />
                        <Typography TextStyle="TextStyle.Small10Medium" As="span">@attachment.Name</Typography>
                    </div>
                }
            }

            @if (Message.Attachments.Count > 0)
            {
                <div class="message-files">
                    @foreach (var file in Message.Attachments)
                    {
                        @if (file.IsLink)
                        {
                            @* A shared post is an address to open, never media to load here. *@
                            <a class="message-file" href="@file.Url" target="_blank" rel="noopener noreferrer">
                                <Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" />
                                <span><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Shared post</Typography>
                                      <Typography TextStyle="TextStyle.Small10Medium" As="small">Opens in a new tab</Typography></span>
                            </a>
                        }
                        else if (file.IsPending && file.IsVisual)
                        {
                            <div class="message-pending message-pending--image" role="status" aria-label="@($"{MediaLabels.Name(file)} loading")">
                                <Skeleton Shape="SkeletonShape.Block" Height="var(--ds-message-image-height)" />
                                <span class="message-image__caption"><Icon Name="@MediaLabels.Glyph(file)" />@MediaLabels.Name(file)</span>
                            </div>
                        }
                        else if (file.IsPending)
                        {
                            <div class="message-attachment message-pending" role="status" aria-label="@($"{MediaLabels.Name(file)} loading")">
                                <Icon Name="@MediaLabels.Glyph(file)" />
                                <Typography TextStyle="TextStyle.Small10Medium" As="span">@MediaLabels.Name(file)</Typography>
                                <Skeleton Shape="SkeletonShape.Line" Width="var(--ds-message-pending-line)" />
                            </div>
                        }
                        else if (!file.Available)
                        {
                            <div class="@($"message-file is-unavailable {(file.IsPending ? "is-pending" : null)}")" aria-busy="@(file.IsPending ? "true" : null)">
                                <Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" />
                                <span><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@MediaLabels.Name(file)</Typography>
                                      <Typography TextStyle="TextStyle.Small10Medium" As="small">@MediaLabels.Unavailable(file)</Typography></span>
                            </div>
                        }
                        else if (file.Kind is "image" or "gif" or "sticker")
                        {
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                    Class="@($"message-media {(file.Kind == "sticker" ? "is-sticker" : null)}")"
                                    aria-label="@($"Open {MediaLabels.Name(file)}")" @onclick="() => OnPreviewMedia.InvokeAsync(new MediaPreview(Message, file))">
                                <ChildContent><img src="@file.Url" alt="@MediaLabels.Name(file)" loading="lazy" /></ChildContent>
                            </Button>
                        }
                        else if (file.Kind == "video")
                        {
                            <video class="message-video" controls preload="metadata" src="@file.Url" aria-label="@MediaLabels.Name(file)"></video>
                        }
                        else if (file.Kind is "audio" or "voice")
                        {
                            <audio class="message-audio" controls preload="none" src="@file.Url" aria-label="@MediaLabels.Name(file)"></audio>
                        }
                        else
                        {
                            <a class="message-file" href="@(file.Url + "?download=true")" download="@MediaLabels.Name(file)">
                                <Icon Name="@MediaLabels.Glyph(file)" Size="IconSize.Sm" />
                                <span><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@MediaLabels.Name(file)</Typography>
                                      <Typography TextStyle="TextStyle.Small10Medium" As="small">@FileDetail(file)</Typography></span>
                                <Icon Name="IconName.RiDownload2Fill" Size="IconSize.Sm" />
                            </a>
                        }
                    }
                </div>
            }

                @* WhatsApp's arrow: in the bubble's top-right corner, shown while the message is pointed at
                   or reached by keyboard (always, on a touch screen). *@
                @if (Replyable || Message.Text.Length > 0)
                {
                    <div class="message-actions">
                        <ActionMenu Label="Message options" Glyph="IconName.RiArrowDownSLine">
                            @if (Replyable)
                            {
                                <ActionMenuItem Label="Reply" OnClick="ReplyAsync" />
                            }
                            @if (Message.Text.Length > 0)
                            {
                                <ActionMenuItem Label="Copy" OnClick="CopyAsync" />
                            }
                        </ActionMenu>
                    </div>
                }
            </div>

            <footer>
                <Typography TextStyle="TextStyle.Small10Regular" As="time">@TimeLabel</Typography>
                @if (Outbound)
                {
                    <span class="message-delivery @(IsFailed ? "is-failed" : IsRead ? "is-read" : null)" title="@DeliveryTitle">
                        <Icon Name="@DeliveryGlyph" />
                        <Typography TextStyle="TextStyle.Small10Regular" As="span">@DeliveryLabel</Typography>
                    </span>
                }
                @if (Message.KnowledgeUpdated)
                {
                    <span class="message-learning">
                        <Icon Name="IconName.RiBookAiFill" />
                        <Typography TextStyle="TextStyle.Small10Medium" As="span">Knowledge updated</Typography>
                    </span>
                }
                else if (Message.Kind == MessageKind.Ai && CanTeach)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="message-correction"
                            @onclick="() => OnCorrect.InvokeAsync(Message)">
                        <IconLeft><Icon Name="IconName.RiFeedbackFill" /></IconLeft>
                        <ChildContent><Typography TextStyle="TextStyle.Small12Semibold" As="span">Correct for next time</Typography></ChildContent>
                    </Button>
                }
            </footer>
        </div>
    </article>
    </div>
}

@code {
    [Parameter, EditorRequired] public ConvMessage Message { get; set; } = default!;
    [Parameter, EditorRequired] public string CustomerName { get; set; } = "";
    [Parameter, EditorRequired] public string CustomerSeed { get; set; } = "";
    [Parameter] public string? CustomerInitials { get; set; }
    /// <summary>Who replies are shown as when the API does not name the teammate: the business.</summary>
    [Parameter, EditorRequired] public string AuthorName { get; set; } = "";
    [Parameter, EditorRequired] public string AuthorSeed { get; set; } = "";
    /// <summary>The agent's saved look ("look:pip:violet" or a mascot name). When set, shown instead of the robot icon on AI messages.</summary>
    [Parameter] public string? AgentMascot { get; set; }
    /// <summary>The corrections and answers that teach the AI can be saved.</summary>
    [Parameter] public bool CanTeach { get; set; }
    /// <summary>The conversation agent's saved look, for its bubbles.</summary>
    [Parameter] public string? AgentLook { get; set; }
    /// <summary>An AI question's task: "Task for you", "Task for Chinedu", "Task done".</summary>
    [Parameter] public string? TaskNote { get; set; }
    [Parameter] public bool TaskDone { get; set; }
    private bool Resolved => Message.Answered || TaskDone;
    [Parameter] public EventCallback<ConvMessage> OnCorrect { get; set; }
    [Parameter] public EventCallback<ConvMessage> OnAnswer { get; set; }
    [Parameter] public EventCallback<ConvMessage> OnDeleteNote { get; set; }
    [Parameter] public EventCallback OnCustomerDetails { get; set; }
    /// <summary>This message's image was chosen: the thread opens it full screen.</summary>
    [Parameter] public EventCallback<ConvMessage> OnPreviewImage { get; set; }
    /// <summary>A picture, GIF or sticker the customer sent was chosen: the thread opens it full screen.</summary>
    [Parameter] public EventCallback<MediaPreview> OnPreviewMedia { get; set; }
    /// <summary>The thread can send a quoting reply here (the channel supports it and the reply window is open).</summary>
    [Parameter] public bool CanReply { get; set; }
    /// <summary>Reply to this message: the composer quotes it.</summary>
    [Parameter] public EventCallback<ConvMessage> OnReply { get; set; }
    /// <summary>Tasks can be kept: a customer's message offers to become one.</summary>
    /// <summary>A quote was chosen: the thread scrolls to the quoted message, by its id.</summary>
    [Parameter] public EventCallback<string> OnJumpTo { get; set; }

    private ElementReference _element;
    private bool _highlighted;

    private bool Replyable => CanReply && QuoteLabels.CanQuote(Message);

    private async Task ReplyAsync()
    {
        if (!Replyable) return;
        // A double-click also selects a word; quoting it should leave nothing highlighted.
        try { await Interop.ClearSelectionAsync(); } catch (JSException) { }
        await OnReply.InvokeAsync(Message);
    }

    private async Task CopyAsync()
    {
        await Interop.CopyAsync(Message.Text);
        Toasts.Show("Message copied");
    }

    /// <summary>Brings this message into view and marks it for a moment, as WhatsApp does when a quote is chosen.</summary>
    /// <summary>Brought into view and lit: at the top ("start"), or "center" with what came before it above.</summary>
    public async Task ShowAsync(string block = "start")
    {
        await Interop.ScrollIntoViewAsync(_element, block);
        _highlighted = true;
        StateHasChanged();
        // Again once photos above it have loaded and pushed it down.
        await Task.Delay(450);
        try { await Interop.ScrollIntoViewAsync(_element, block); }
        catch (JSException) { }
        await Task.Delay(1150);
        _highlighted = false;
        // The thread may have moved on (another conversation) in the meantime.
        try { StateHasChanged(); }
        catch (ObjectDisposedException) { }
    }

    private static string FileDetail(InboxMediaDto file) =>
        string.Join(" · ", new[] { MediaLabels.Type(file), MediaLabels.Size(file.SizeBytes) }.Where(part => part.Length > 0));


    private bool Outbound => Message.Kind is MessageKind.Ai or MessageKind.Human;
    private string DirectionClass => Outbound ? "is-outbound" : "is-inbound";
    private string KindClass => Message.Kind switch
    {
        MessageKind.Ai => "is-ai",
        MessageKind.Human => "is-human",
        _ => "is-customer"
    };

    private string AuthorLabel => Message.Kind == MessageKind.Customer
        ? CustomerName
        : Message.Author?.Name ?? AuthorName;
    private string AvatarSeed => Message.Kind == MessageKind.Customer
        ? CustomerSeed
        : Message.Author?.Id ?? AuthorSeed;
    private string AvatarInitials => Message.Kind == MessageKind.Customer && CustomerInitials is { } initials
        ? initials
        : Initials.From(AuthorLabel);
    private bool _confirmingDelete;

    private async Task DeleteNoteAsync()
    {
        _confirmingDelete = false;
        await OnDeleteNote.InvokeAsync(Message);
    }

    // The notes list has no day dividers, so each note carries its date.
    private string NoteTimeLabel => Message.ReceivedAt.ToLocalTime().ToString("d MMM, h:mm tt", CultureInfo.InvariantCulture);
    private string TimeLabel => Message.ReceivedAt.ToLocalTime().ToString("h:mm tt", CultureInfo.InvariantCulture);

    // The kind of event, read from what happened: AI hand-offs, a teammate
    // taking or giving back the conversation, knowledge, or a task request.
    private IconName SystemGlyph => Message.Text switch
    {
        var t when t.Contains("task request", StringComparison.OrdinalIgnoreCase) || t.Contains("raised a task", StringComparison.OrdinalIgnoreCase) => IconName.RiClipboardFill,
        var t when t.Contains("knowledge", StringComparison.OrdinalIgnoreCase) => IconName.RiBookAiFill,
        var t when t.Contains("resumed", StringComparison.OrdinalIgnoreCase) || t.Contains("returned", StringComparison.OrdinalIgnoreCase) => IconName.RiRobot3Fill,
        var t when t.Contains("assign", StringComparison.OrdinalIgnoreCase) || t.Contains("took over", StringComparison.OrdinalIgnoreCase)
            || t.Contains("handed", StringComparison.OrdinalIgnoreCase) || t.Contains("paused", StringComparison.OrdinalIgnoreCase) => IconName.RiUserSharedFill,
        _ => IconName.RiInformationFill
    };

    private bool IsFailed => string.Equals(Message.Status, "failed", StringComparison.OrdinalIgnoreCase);
    private bool IsRead => string.Equals(Message.Status, "read", StringComparison.OrdinalIgnoreCase);

    // What the channel has told us. "Read" appears only when the customer's channel sent it: a customer
    // can turn read receipts off, so a reply that shows Delivered may well have been read.
    private string? DeliveryTitle => Message.Status.ToLowerInvariant() switch
    {
        "read" => "The customer has read this reply",
        "delivered" => "Delivered to the customer's device",
        "accepted" => "Accepted by the channel; no delivery report yet",
        _ => null
    };
    // "Read", "Sent", "Failed": React capitalises the delivery state.
    private string DeliveryLabel => Message.Status.Length == 0 ? "" : char.ToUpperInvariant(Message.Status[0]) + Message.Status[1..].ToLowerInvariant();

    private IconName DeliveryGlyph => Message.Status.ToLowerInvariant() switch
    {
        "failed" => IconName.RiErrorWarningFill,
        "pending" or "unknown" => IconName.RiTimeFill,
        "accepted" => IconName.RiCheckFill,
        _ => IconName.RiCheckDoubleFill
    };

    private Task OpenImage(InboxAttachmentDto attachment) => OnPreviewImage.InvokeAsync(Message);

    // Attachment links may be absolute API URLs or app-relative paths.
    internal static string AssetUrl(string value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var absolute) && (absolute.Scheme == Uri.UriSchemeHttp || absolute.Scheme == Uri.UriSchemeHttps)
            ? absolute.ToString()
            : value.TrimStart('/');
}
