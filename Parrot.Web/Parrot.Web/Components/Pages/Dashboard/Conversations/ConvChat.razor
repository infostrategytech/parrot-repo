@using Parrot.Web.Components.Pages.Dashboard.Conversations
@using Parrot.Application.Conversations
@inject Parrot.Web.Services.ConversationClient Client

<div class="cv-chat">
    <div class="cv-chat-header">
        <div><strong class="cv-chat-name">@Conv.CustomerName</strong><p>WhatsApp · Manual replies</p></div>
    </div>
    <div class="cv-messages">
        @if (Conv.NextBefore is not null) { <button @onclick="() => OnLoadOlder.InvokeAsync()">Load older messages</button> }
        @foreach (var msg in Conv.Messages)
        {
            <div @key="msg.Id" class="cv-msg @(msg.IsOutgoing ? "cv-msg--ai" : "cv-msg--customer")">
                <div>
                    <div class="cv-msg-bubble @(msg.IsOutgoing ? "cv-msg-bubble--ai" : "cv-msg-bubble--customer")">@msg.Text</div>
                    <small>@msg.ReceivedAt.ToLocalTime().ToString("g") @(msg.IsOutgoing ? " · " + StatusLabel(msg.Status) : "")</small>
                </div>
            </div>
        }
    </div>
    @if (Conv.SendError is not null) { <p role="alert">@Conv.SendError</p> }
    <div class="cv-input-bar">
        <input class="cv-input" aria-label="Reply" placeholder="Enter message here…" maxlength="4096"
               @bind="Conv.Draft" @bind:event="oninput" disabled="@(Conv.Sending || Conv.DraftRequestId.HasValue)" @onkeydown="OnKeyDown" />
        <button class="cv-send-btn" aria-label="Send reply" disabled="@(Conv.Sending || string.IsNullOrWhiteSpace(Conv.Draft))" @onclick="SendAsync">
            @(Conv.Sending ? "Sending…" : Conv.DraftRequestId.HasValue ? "Check / retry" : "Send")
        </button>
    </div>
</div>

@code {
    [Parameter] public ConversationItem Conv { get; set; } = default!;
    [Parameter] public EventCallback OnLoadOlder { get; set; }
    [Parameter] public EventCallback OnSent { get; set; }

    private async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SendAsync(); }
    private async Task SendAsync()
    {
        var item = Conv;
        if (item.Sending || string.IsNullOrWhiteSpace(item.Draft)) return;
        item.Sending = true;
        item.SendError = null;
        item.DraftRequestId ??= Guid.NewGuid();
        try
        {
            var result = await Client.SendAsync(item.ConnectionId, item.Sender,
                new SendReplyRequest(item.DraftRequestId.Value, item.Draft), CancellationToken.None);
            ConversationsState.Merge(item, new[] { result });
            item.SendError = result.Status switch
            {
                "failed" => "WhatsApp rejected this reply. Check the recipient and server credentials before sending a new message.",
                "unknown" or "pending" => "Delivery is uncertain or still processing. Check the recipient’s phone before composing the same reply again; it will not be resent automatically.",
                _ => null,
            };
            item.Draft = ""; item.DraftRequestId = null;
            await OnSent.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            item.SendError = ex.Message;
            if (ex.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict
                or System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Unauthorized)
                item.DraftRequestId = null;
            // Transport errors retain the same text and request ID for a safe retry.
        }
        catch (Exception ex) when (ex is OperationCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        { item.SendError = "Could not confirm this send. Check / retry uses the same request and will not send it twice."; }
        finally { item.Sending = false; }
    }
    private static string StatusLabel(string status) => status switch
    {
        "accepted" => "Accepted by WhatsApp", "pending" => "Processing / unconfirmed",
        "failed" => "Failed", "unknown" => "Outcome unknown", _ => status,
    };
}
