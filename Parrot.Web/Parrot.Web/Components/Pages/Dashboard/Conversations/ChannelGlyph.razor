@namespace Parrot.Web.Components.Pages.Dashboard.Conversations

<span class="channel-glyph channel-glyph--@Channel.ToLowerInvariant() @(Tile ? "is-tile" : null) @(Compact ? "is-compact" : null)"
      title="@ChannelLabel"
      aria-label="@ChannelLabel">
    <Icon Name="Glyph" Size="IconSize.Sm" />
</span>

@code {
    /// <summary>whatsapp, instagram, facebook or tiktok; anything else draws a neutral chat mark.</summary>
    [Parameter] public string Channel { get; set; } = "whatsapp";
    [Parameter] public bool Tile { get; set; }
    /// <summary>The small mark that sits inline with text, as in the conversation header.</summary>
    [Parameter] public bool Compact { get; set; }

    private string ChannelLabel => Channel.ToLowerInvariant() switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "tiktok" => "TikTok",
        "email" => "Email",
        "phone" => "Phone",
        _ => "Web"
    };

    private IconName Glyph => Channel.ToLowerInvariant() switch
    {
        "whatsapp" => IconName.RiWhatsappFill,
        "instagram" => IconName.RiInstagramFill,
        "facebook" => IconName.RiFacebookCircleFill,
        "tiktok" => IconName.RiTiktokFill,
        _ => IconName.RiChat3Fill
    };
}
