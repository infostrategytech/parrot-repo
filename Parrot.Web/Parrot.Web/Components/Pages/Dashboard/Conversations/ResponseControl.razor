@namespace Parrot.Web.Components.Pages.Dashboard.Conversations

@* Who answers the customer right now. With an AI agent on the conversation
   this is React's control bar: the agent is responding and
   a person can take over, for a while or until they hand it back. Without
   one, which is every conversation the API sends today, a person always
   answers, so there is nothing to take over and no agent to return to. *@
@if (!Conversation.HasAiAgent || !CanAct)
{
    <div class="response-control human-has-control">
        <div class="response-control__row">
            <span class="response-control__copy">
                <span>
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">You control customer replies</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>Messages you send go directly to this customer.</Typography>
                </span>
            </span>
        </div>
    </div>
}
else
{
    @* Escape closes the take-over choice while focus is in the bar (it is on
       the Take over button once that has been pressed). *@
    <div class="response-control @ControlClass @(_expanded ? "is-expanded" : null) @_settle" @onkeydown="OnKeyDown">
        @* Keyed on who is in control, so a change redraws the row and it fades in. *@
        <div class="response-control__row @(_settle is null ? null : "is-arriving")" @key="Conversation.AiState">
            <span class="response-control__copy">
                @if (Conversation.AiState == AiState.Active)
                {
                    <Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" />
                }
                <span>
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@Title</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>
                        @if (Conversation.AiState != AiState.Active && Countdown is not null)
                        {
                            <b class="response-control__countdown">@Countdown</b> @($" until {Agent} resumes")
                        }
                        else
                        {
                            @Description
                        }
                    </Typography>
                </span>
            </span>

            @if (Conversation.AiState == AiState.Active)
            {
                <Button Size="ButtonSize.Small" Class="response-control__action" Busy="@(Busy && !_choosing)"
                        aria-controls="takeover-options" aria-expanded="@(_expanded ? "true" : "false")"
                        disabled="@(Busy || _choosing)" @onclick="ToggleAsync">
                    <IconLeft><Icon Name="IconName.RiUserAddFill" /></IconLeft>
                    <ChildContent>Take over</ChildContent>
                </Button>
            }
            else
            {
                <Button Size="ButtonSize.Small" Class="response-control__action is-return" Busy="@Busy"
                        disabled="@Busy" @onclick="OnReturn">
                    <IconLeft><Icon Name="IconName.RiRobot3Fill" /></IconLeft>
                    <ChildContent>Return to @Agent</ChildContent>
                </Button>
            }
        </div>

        <div class="response-control__disclosure" id="takeover-options" aria-hidden="@(!_expanded)">
            <div class="response-control__panel">
                <Typography TextStyle="TextStyle.Small12Semibold" As="span">@(_reason ?? "Take over for how long?")</Typography>
                <div class="response-control__options">
                    @* The chosen length holds the spinner until the switch is done, so
                       the choice never looks as if it was cancelled. *@
                    @foreach (var option in Durations)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                Busy="@(_choosing && _chosen == option.Minutes)"
                                disabled="@(Busy || _choosing || !_expanded)" tabindex="@(_expanded ? 0 : -1)"
                                @onclick="() => ChooseAsync(option.Minutes)">@option.Label</Button>
                    }
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="response-control__cancel"
                            disabled="@(_choosing || !_expanded)" tabindex="@(_expanded ? 0 : -1)" @onclick="CollapseAsync">Cancel</Button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ConversationItem Conversation { get; set; } = default!;
    /// <summary>The take-over actions exist when supported; otherwise the bar only states who replies.</summary>
    [Parameter] public bool CanAct { get; set; }
    [Parameter] public string? Countdown { get; set; }
    [Parameter] public bool Busy { get; set; }
    /// <summary>Minutes to take over for; null means until the person hands it back.</summary>
    [Parameter] public EventCallback<int?> OnTakeOver { get; set; }
    [Parameter] public EventCallback OnReturn { get; set; }
    /// <summary>The take-over choice closed without taking over (Cancel, Escape, or Take over pressed again).</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    private static readonly (int? Minutes, string Label)[] Durations =
        [(15, "15 min"), (30, "30 min"), (60, "1 hour"), (null, "Until I return")];

    private bool _expanded;
    // Why the choice opened when something else asked (Reply): it says so in place of its title.
    private string? _reason;
    private bool _choosing;
    private int? _chosen;

    // Which conversation and state the bar last showed, so a change of hands
    // on the same conversation can be marked, and opening another cannot.
    private string? _shownId;
    private AiState? _shownState;
    private string? _settle;
    private string Agent => Conversation.AiAgent?.Name ?? "the AI agent";
    private string ControlClass => Conversation.AiState == AiState.Active ? "ai-has-control" : "human-has-control";
    private string Title => Conversation.AiState == AiState.Active ? $"{Agent} is responding" : "You control customer replies";
    private string Description => Conversation.AiState == AiState.Active
        ? "Human reply is locked to prevent a duplicate response."
        : $"{Agent} will not send while you are in control.";

    protected override void OnParametersSet()
    {
        if (Conversation.Id != _shownId) _settle = null;
        else if (_shownState is { } before && before != Conversation.AiState)
            _settle = Conversation.AiState == AiState.Active ? "is-settling-ai" : "is-settling-human";
        _shownId = Conversation.Id;
        _shownState = Conversation.AiState;
    }

    /// <summary>Opens the take-over choice for something that needs it, saying why ("Take over to reply…").</summary>
    public void Offer(string reason)
    {
        if (Conversation.AiState != AiState.Active || !CanAct) return;
        _reason = reason;
        _expanded = true;
        StateHasChanged();
    }

    private Task ToggleAsync()
    {
        if (!_expanded) { _reason = null; _expanded = true; return Task.CompletedTask; }
        return CollapseAsync();
    }

    private async Task CollapseAsync()
    {
        if (_choosing || !_expanded) return;
        _expanded = false;
        _reason = null;
        await OnDismiss.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CollapseAsync();
    }

    private async Task ChooseAsync(int? minutes)
    {
        _choosing = true;
        _chosen = minutes;
        try { await OnTakeOver.InvokeAsync(minutes); }
        finally
        {
            _choosing = false;
            _expanded = false;
            _reason = null;
        }
    }
}
