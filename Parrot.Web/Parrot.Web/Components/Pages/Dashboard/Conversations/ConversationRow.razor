@namespace Parrot.Web.Components.Pages.Dashboard.Conversations

@* The whole row is one control that opens the conversation. The wrapper
   takes no space; it lets this component's styles reach the RowButton. *@
<div class="conversation-row-host">
<RowButton Class="@ClassName" aria-current="@(Selected ? "true" : null)" OnClick="OnSelect">
    <ChannelGlyph Channel="@Conversation.Channel" Tile />

    <span class="conversation-row__copy">
        <span class="conversation-row__heading">
            <span class="conversation-row__name">
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@Conversation.CustomerName</Typography>
                @if (Conversation.Pinned)
                {
                    <Icon Name="IconName.RiPushpin2Fill" Size="IconSize.Sm" Label="Pinned" Class="conversation-row__pin" />
                }
            </span>
            <Typography TextStyle="TextStyle.Small12Medium" As="time">@RelativeTime</Typography>
        </span>

        <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Class="conversation-row__preview">
            @Conversation.LastMessage
        </Typography>

        <span class="conversation-row__meta @StateClass">
            <Icon Name="StateGlyph" Size="IconSize.Inherit" />
            <Typography TextStyle="TextStyle.Small12Medium" As="span">@StateLabel</Typography>
        </span>
    </span>

    @if (Conversation.UnreadCount > 0)
    {
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="conversation-row__unread"
                    aria-label="@($"{Conversation.UnreadCount} unread")">
            @Conversation.UnreadCount
        </Typography>
    }
    else if (Conversation.MarkedUnread)
    {
        @* Kept as unread by the agent: a mark to come back to, not a count: the same solid badge, with a bold "!". *@
        <Typography TextStyle="TextStyle.BodySmallBold" As="span" Class="conversation-row__unread is-marked"
                    aria-label="Marked as unread">!</Typography>
    }
</RowButton>

@* A sibling of the row, not inside it: a menu button cannot sit within another button. *@
<div class="conversation-row__menu">
    <ActionMenu Label="@($"Options for {Conversation.CustomerName}")" Glyph="IconName.RiMore2Fill">
        <ActionMenuItem Label="@(Conversation.Pinned ? "Unpin" : "Pin to top")" Glyph="IconName.RiPushpin2Fill"
                        OnClick="OnTogglePin" />
        @if (Conversation.MarkedUnread)
        {
            <ActionMenuItem Label="Clear unread mark" Glyph="IconName.RiCheckFill" OnClick="OnToggleUnread" />
        }
        else
        {
            <ActionMenuItem Label="Mark as unread" Glyph="IconName.RiMailFill" OnClick="OnToggleUnread" />
        }
    </ActionMenu>
</div>
</div>

@code {
    [Parameter, EditorRequired] public ConversationItem Conversation { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback OnTogglePin { get; set; }
    [Parameter] public EventCallback OnToggleUnread { get; set; }

    private string ClassName => $"conversation-row{(Selected ? " is-selected" : "")}{(Conversation.UnreadCount > 0 || Conversation.MarkedUnread ? " has-unread" : "")}";

    private string RelativeTime
    {
        get
        {
            var elapsed = DateTime.UtcNow - Conversation.UpdatedAt.ToUniversalTime();
            if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
            if (elapsed.TotalMinutes < 60) return $"{Math.Max(1, (int)Math.Round(elapsed.TotalMinutes))}m";
            if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h";
            return $"{(int)elapsed.TotalDays}d";
        }
    }

    // Without an AI agent (today's API) every conversation is answered by
    // hand, which is the design's human-has-control state.
    private IconName StateGlyph => !Conversation.HasAiAgent
        ? IconName.RiUserReceived2Fill
        : Conversation.NeedsAnswer
            ? IconName.RiQuestionAnswerFill
            : Conversation.AiState switch
            {
                AiState.Paused => IconName.RiPauseCircleFill,
                AiState.Handoff => IconName.RiUserReceived2Fill,
                _ => IconName.RiRobot3Fill
            };

    private string StateLabel => !Conversation.HasAiAgent
        ? "Manual replies"
        : Conversation.NeedsAnswer
            ? $"{Conversation.AiAgent!.Name} needs answer"
            : $"{Conversation.AiAgent!.Name} · {Conversation.AiState}";

    private string StateClass => !Conversation.HasAiAgent
        ? "state-handoff"
        : Conversation.NeedsAnswer
            ? "state-needs-answer"
            : $"state-{Conversation.AiState.ToString()!.ToLowerInvariant()}";
}
