@namespace Parrot.Web.Components.Pages.Dashboard.Conversations
@using System.Globalization
@using Parrot.Web.Components.Pages.Dashboard.AiAgents
@implements IDisposable
@inject Parrot.Web.Services.ConversationClient Client
@inject Parrot.Web.Services.IInboxFeatures Features
@inject AuroraInterop Interop
@inject Parrot.Web.Services.FeedbackService Feedback
@inject Parrot.Web.Features.Dashboard.AiAgents.State.AiAgentsState AgentsState
@inject Parrot.Web.Features.Dashboard.TaskRequests.TaskReplyDraft ReplyDraft
@inject Parrot.Web.Features.Dashboard.TaskRequests.ITaskStore Tasks
@inject ToastService Toasts
@inject AuthState Auth
@inject Parrot.Web.Features.Dashboard.Knowledge.OmniKnowledgeMemory Knowledge


@* The page owns the conversation data (it polls the list and reads the
   selected thread every 5 seconds); this component draws React's timeline
   over that data and owns the composer: the draft, the send with its
   request id, and the per-conversation send error.

   The actions the API has no endpoint for yet (taking over, notes, AI drafts,
   teaching the AI) go through IInboxFeatures, and after each the page reads
   the conversation again, so every change arrives the same way. *@
<div class="conversation-timeline">
    @if (!Conversation.HistoryLoaded)
    {
        <div class="conversation-timeline__loading">
            @for (var index = 0; index < 5; index++)
            {
                <div class="conversation-timeline__skeleton @(index % 2 == 0 ? null : "is-outbound")">
                    <Skeleton Shape="SkeletonShape.Circle" Width="32px" Order="@index" />
                    <Skeleton Shape="SkeletonShape.Block" Width="@($"{52 + index * 5}%")" Height="72px" Order="@index" />
                </div>
            }
        </div>
    }
    else
    {
        @* The tabs float over the thread, which fades out beneath them (a mask on
           the scroll area), so the messages read as fading into the top. *@
        <div class="conversation-timeline__tabs">
            <Tabs Label="Conversation content" Variant="TabsVariant.Floating">
                <Tab Selected="@(_view == ThreadView.Messages)" OnClick="() => SetView(ThreadView.Messages)">
                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">Messages</Typography>
                </Tab>
                <Tab Selected="@(_view == ThreadView.Notes)" Count="@NoteCount.ToString(CultureInfo.InvariantCulture)" OnClick="() => SetView(ThreadView.Notes)">
                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">Internal notes</Typography>
                </Tab>
            </Tabs>
        </div>

        <section class="conversation-timeline__scroll" aria-live="polite" @ref="_scrollElement">
            <div class="conversation-timeline__messages @(_view == ThreadView.Messages ? "is-chat" : null)">
                @if (_view == ThreadView.Notes)
                {
                    <div class="conversation-timeline__notes-heading">
                        <Icon Name="IconName.RiLock2Fill" Size="IconSize.Sm" />
                        <span>
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Internal notes</Typography>
                            <Typography TextStyle="TextStyle.Small12Regular" As="small">Private workspace for your team</Typography>
                        </span>
                    </div>
                }
                else if (Conversation.NextBefore is not null)
                {
                    <div class="conversation-timeline__older">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@Busy" @onclick="OnLoadOlder">
                            Load older messages
                        </Button>
                    </div>
                }

                @{ DateOnly? renderedDate = null; }
                @foreach (var message in VisibleMessages)
                {
                    var messageDate = DateOnly.FromDateTime(message.ReceivedAt.ToLocalTime());
                    if (_view == ThreadView.Messages && messageDate != renderedDate)
                    {
                        <div class="conversation-timeline__date">
                            <Typography TextStyle="TextStyle.Small10Semibold" As="span">@DateLabel(messageDate)</Typography>
                        </div>
                        renderedDate = messageDate;
                    }

                    <ConversationMessageItem @key="message.Id" @ref="_items[message.Id]" Message="message"
                                             CustomerName="@Conversation.CustomerName" CustomerSeed="@Conversation.Id"
                                             CustomerInitials="@Conversation.CustomerInitials"
                                             AuthorName="@(message.Kind == MessageKind.Ai ? LegacyAiReplyName : AuthorName)" AuthorSeed="@AuthorSeed"
                                             CanTeach="@Features.Available" AgentLook="@MessageAgentLook(message)" AgentAvatars="@MessageAgentAvatars(message)"
                                             OnDeleteNote="DeleteNoteAsync"
                                             OnCorrect="OpenCorrection"
                                             OnCustomerDetails="OnCustomerDetails"
                                             OnPreviewImage="OpenMedia" OnPreviewMedia="OpenFile"
                                             CanReply="@CanQuoteReplies" OnReply="ReplyTo" OnJumpTo="JumpToAsync" />
                }

                @if (_view == ThreadView.Notes && NoteCount == 0)
                {
                    <EmptyState Size="EmptyStateSize.Panel" Glyph="IconName.RiLock2Fill"
                                Title="No internal notes yet"
                                Description="Add private context for teammates from the composer." />
                }

                @if (_view == ThreadView.Messages && Conversation.AiTurnInProgress
                     && Conversation.AiState == AiState.Active && Conversation.PendingApproval is null)
                {
                    <div class="ai-typing-indicator" role="status"
                         aria-label="@(Conversation.HasSharedAgentCoverage ? Conversation.SharedAgentStatus : $"{Conversation.AiAgent?.Name ?? "AI agent"} is replying")">
                        <span class="ai-typing-indicator__avatar" aria-hidden="true">
                            @if (Conversation.HasSharedAgentCoverage)
                            {
                                <Icon Name="IconName.RiGroupFill" Size="IconSize.Sm" />
                            }
                            else if (AiAgentMascot is not null)
                            {
                                <AgentFace Look="@AiAgentMascot" Size="Parrot.SharedComponents.DesignSystem.PresenceAvatarSize.Small" />
                            }
                            else
                            {
                                <Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" />
                            }
                        </span>
                        <div class="ai-typing-indicator__dots" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                }

                @if (_view == ThreadView.Messages && Conversation.PendingApproval is { } approval)
                {
                    <div class="approval-card @(_approvalDecision is not null ? $"is-{_approvalDecision}" : null)" role="region"
                         aria-label="Approval request from AI agent">
                        <div class="approval-card__icon">
                            <Icon Name="@ApprovalIcon(_approvalDecision)" Size="IconSize.Sm" />
                        </div>
                        <div class="approval-card__body">
                            @if (_approvalDecision is null)
                            {
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">
                                    @(Conversation.AiAgent?.Name ?? "AI agent") needs approval
                                </Typography>
                                @if (approval.Reason is { Length: > 0 } reason)
                                {
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@reason</Typography>
                                }
                                @if (approval.Tool is { Length: > 0 } tool)
                                {
                                    <Typography TextStyle="TextStyle.Small12Medium" As="code" Class="approval-card__tool">@tool</Typography>
                                }
                                @if (_approvalError is not null)
                                {
                                    <InlineError Message="@_approvalError" OnDismiss="() => _approvalError = null" />
                                }
                                <div class="approval-card__actions">
                                    <Button Size="ButtonSize.Small" disabled="@_deciding"
                                            @onclick="ApproveAsync">
                                        <ChildContent>Approve</ChildContent>
                                    </Button>
                                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" disabled="@_deciding"
                                            @onclick="DenyAsync">
                                        <ChildContent>Deny</ChildContent>
                                    </Button>
                                </div>
                            }
                            else
                            {
                                (string Title, string Note) outcome = ApprovalOutcome.Describe(_approvalDecision, _approvalStatus, Conversation.AiAgent?.Name);
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@outcome.Title</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p">@outcome.Note</Typography>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <footer class="conversation-timeline__composer" @ref="_composerElement">
            @* What needs someone here, one card at a time: unanswered AI questions, a teammate's question or
               answer, then this chat's open tasks (why it is in Needs you). More than
               one: a small "1 of 3" to step through, so cards never pile up over the conversation. The place is
               counted as part of the reply box, so the last message always sits above it. *@
            <div class="conversation-timeline__attention @(SlotCount == 0 ? "is-empty" : null)" data-footer-extra>
                @if (SlotCount > 1)
                {
                    <div class="conversation-timeline__pager">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Previous" disabled="@(Slot == 0)" @onclick="() => _slot = Slot - 1">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                        </Button>
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@($"{Slot + 1} of {SlotCount}")</Typography>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Next" disabled="@(Slot >= SlotCount - 1)" @onclick="() => _slot = Slot + 1">
                            <IconLeft><Icon Name="IconName.RiArrowRightLine" /></IconLeft>
                        </Button>
                    </div>
                }
                @if (Slot < TeamQuestionStart && PendingAgentQuestions.ElementAtOrDefault(Slot) is { } question)
                {
                    var questionAgent = question.Author?.Name ?? Conversation.AiAgent?.Name ?? "An agent";
                    <div class="conversation-timeline__task conversation-timeline__agent-question" data-agent-question-prompt="@question.Id"
                         role="region" aria-label="@($"{questionAgent} needs your answer")">
                        <span class="conversation-timeline__task-copy">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="conversation-timeline__task-who">@questionAgent needs your answer</Typography>
                            <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Class="conversation-timeline__agent-question-text">@question.Text</Typography>
                        </span>
                        @* The API only sends questions to people who can answer them, so whoever sees one can act on it.
                           Once the reply window has closed nothing can be sent from here: they answer on the customer's
                           own app (the handoff below) and mark it done. *@
                        <span class="conversation-timeline__agent-actions">
                            @if (!Conversation.ReplyWindowClosed)
                            {
                                <Button Size="ButtonSize.Small" disabled="@(_savingLearning || _resolving)" aria-label="@($"Answer {LearningAgent}")"
                                        @onclick="() => OpenAnswer(question)">Answer</Button>
                            }
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Busy="_resolving" disabled="@_savingLearning"
                                    @onclick="() => MarkAgentQuestionDoneAsync(question)">Done</Button>
                        </span>
                    </div>
                }
                <Parrot.Web.Components.Pages.Dashboard.TaskRequests.TaskQuestions ConversationId="@Conversation.Id" Compact OnUseAnswer="UseAnswer"
                    Only="@(Slot >= TeamQuestionStart && Slot < TaskStart ? Slot - TeamQuestionStart : -1)" OnCount="count => _questionCount = count" />
                @if (Slot >= TaskStart && ChatTasks.ElementAtOrDefault(Slot - TaskStart) is { } task)
                {
                    <div class="conversation-timeline__task">
                        <Parrot.Web.Components.Pages.Dashboard.TaskRequests.TaskKindMark Kind="task.Kind" />
                        <span class="conversation-timeline__task-copy">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="conversation-timeline__task-who">@TaskOwner(task) · @(Parrot.Web.Features.Dashboard.TaskRequests.TaskWords.Label(task.Kind))</Typography>
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="conversation-timeline__task-title">@task.Title</Typography>
                        </span>
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="() => OnOpenTask.InvokeAsync(task.Id)">View task</Button>
                    </div>
                }
            </div>
            @if (Conversation.SendError is not null)
            {
                <InlineError Message="@Conversation.SendError" OnDismiss="() => Conversation.SendError = null" />
            }
            @if (_actionError is not null)
            {
                <InlineError Message="@_actionError" OnDismiss="() => _actionError = null" />
            }

            @if (Conversation.Status == ConversationStatus.Resolved)
            {
                <div class="conversation-timeline__resolved">
                    <Icon Name="IconName.RiCheckFill" />
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">This conversation is resolved. Reopen it to reply.</Typography>
                </div>
            }
            else
            {
                <ResponseControl @ref="_control" Conversation="@Conversation" CanAct="@Conversation.HasChannelAgent" AgentLook="@AgentLook" ChannelAvatars="@ChannelAgentAvatars" Countdown="@CountdownLabel"
                                 Busy="@_acting" OnTakeOver="TakeOverAsync" OnReturn="ReturnToAiAsync" OnDismiss="() => _quoteOnTakeOver = null" />
            }

            <ConversationComposer @ref="_composer" Conversation="@Conversation"
                                  Mode="@_composerMode" ModeChanged="ChangeComposerMode"
                                  Text="@Conversation.Draft" TextChanged="OnComposerTextChanged"
                                  Sending="@Conversation.Sending" Retry="@Conversation.DraftRequestId.HasValue"
                                  CanUseFeatures="@Features.Available" CanAddNotes
                                  AttachmentName="@Conversation.PendingFile?.Name" OnAttachmentChanged="OnAttachmentChosen" OnAttachmentRejected="message => Conversation.SendError = message"
                                  DraftedBy="@_draftedBy" Drafting="@_drafting"
                                  OnSend="SendAsync" OnDraft="DraftAsync"
                                  ReplyingTo="@(Conversation.ReplyingTo is { } replying ? QuoteLabels.From(replying) : null)"
                                  OnCancelReply="CancelReply" />
        </footer>
    }
</div>

@* The host only lets this page shape its own dialog (React's width, the
   header hairline); the dialog itself is fixed to the window. *@
@* Outside the thread: its scroll area is masked and its column transformed,
   and either would confine a full-screen viewer to it. *@
<MediaViewer Item="_media" OnClose="() => _media = null" />

@* Answer the agent, or correct it for next time (designer, 15 November 2026): plain words, the agent's question as
   its own chat bubble, one box. The shared content modal, rendered at the layout so it covers the whole window. *@
<Microsoft.AspNetCore.Components.Sections.SectionContent SectionName="web-chat-modal">
    <ContentModal Open="@(_learningMessage is not null)" Title="@LearningTitle" Busy="@_savingLearning" OnClose="CloseLearning" Footer="LearningFooter">
        @if (_learningMessage is { } learningMessage)
        {
            <div class="learning-dialog">
                @* On the agent's side, as its messages are in the chat. *@
                <div class="learning-dialog__bubble">
                    <span class="learning-dialog__avatar" aria-hidden="true">
                        @if (IsSharedCorrection) { <Icon Name="IconName.RiGroupFill" Size="IconSize.Sm" /> }
                        else if ((MessageAgentLook(learningMessage) ?? AgentLook) is { } look) { <Parrot.Web.Components.Pages.Dashboard.AiAgents.AgentFace Look="@look" /> }
                        else { <Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" /> }
                    </span>
                    <div class="learning-dialog__said">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@(IsSharedCorrection ? "Reply from your agents" : _learningMode == LearningMode.Correction ? $"{LearningAgent} said" : $"{LearningAgent} asked")</Typography>
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@learningMessage.Text</Typography>
                    </div>
                </div>
                <TextArea Value="@_learningText" ValueChanged="value => _learningText = value ?? string.Empty"
                          AriaLabel="@LearningPrompt" Rows="4" AutoGrow Placeholder="@LearningPrompt" />
                <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="learning-dialog__note">@LearningCommitment</Typography>
                @* Above the save option, so a refusal is in view without scrolling the dialog. *@
                @if (_learningError is not null)
                {
                    <InlineError Message="@_learningError" OnDismiss="() => _learningError = null" />
                }
                @if (_learningMode == LearningMode.Answer && CanSaveForNextTime)
                {
                    @* Off unless chosen: many answers are about this customer only (an order, a delivery date), and what is
                       saved is used with every customer from the next message. *@
                    <Checkbox State="@(_saveForNextTime ? CheckboxState.Checked : CheckboxState.Unchecked)" StateChanged="SetSaveForNextTime"
                              Label="Save for next time"
                              Description="@($"{CapitalisedAgent} will use it with every customer. Leave it off for an answer about this customer only, like their order.")" />
                    @if (_saveForNextTime)
                    {
                        <TextArea Value="@RememberText" ValueChanged="value => _rememberText = value ?? string.Empty"
                                  AriaLabel="@($"What {LearningAgent} should know")" Rows="3" AutoGrow
                                  Placeholder="For example: We deliver to Ibadan for 3,500 naira, in 2 days." />
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="learning-dialog__note">Write it so it makes sense without the question.</Typography>
                    }
                }
            </div>
        }
    </ContentModal>
</Microsoft.AspNetCore.Components.Sections.SectionContent>

@code {
    [Parameter, EditorRequired] public ConversationItem Conversation { get; set; } = default!;
    /// <summary>The conversation agent's saved look, for its face on its bubbles.</summary>
    [Parameter] public string? AgentLook { get; set; }
    /// <summary>Open one of this chat's tasks over the chat.</summary>
    [Parameter] public EventCallback<string> OnOpenTask { get; set; }
    /// <summary>Who outbound replies are shown as when the API does not name a teammate: the business.</summary>
    [Parameter, EditorRequired] public string AuthorName { get; set; } = "";
    [Parameter, EditorRequired] public string AuthorSeed { get; set; } = "";
    /// <summary>The page is already talking to the API; older-history paging waits for it.</summary>
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnLoadOlder { get; set; }
    [Parameter] public EventCallback OnSent { get; set; }
    /// <summary>An inbox action changed the conversation; the page reads it again.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnCustomerDetails { get; set; }

    /// <summary>A line to open at, instead of the newest: brought into view with what came before it above, and lit, once.</summary>
    [Parameter] public string? FocusMessageId { get; set; }
    private string? _focused;

    private string? AiAgentMascot =>
        Conversation.AiAgent?.Id is { } agentId
            ? AgentsState.Agents.FirstOrDefault(a => a.Id == agentId)?.Mascot
            : null;

    private string LegacyAiReplyName => Conversation.HasSharedAgentCoverage ? "AI reply" : Conversation.AiAgent?.Name ?? AuthorName;

    private string? MessageAgentLook(ConvMessage message)
    {
        if (message.Kind != MessageKind.Ai) return null;
        var agent = message.AgentsInvolved.Count == 1 ? message.AgentsInvolved[0] : message.Author;
        return AgentLookup.Look(agent?.Id, agent?.Name, AgentsState.Agents)
            ?? (Conversation.HasSharedAgentCoverage ? null : AgentLook ?? AiAgentMascot);
    }

    // The agents on the conversation's channel, for the takeover card (several agents only).
    private IReadOnlyList<AgentAvatarStackItem> ChannelAgentAvatars => Conversation.ChannelAgents.Count < 2 ? [] :
        [.. Conversation.ChannelAgents.Select(agent => new AgentAvatarStackItem(agent.Name,
            AgentLooks.Of(AgentLookup.Look(agent.Id, agent.Name, AgentsState.Agents))))];

    private IReadOnlyList<AgentAvatarStackItem> MessageAgentAvatars(ConvMessage message) => message.AgentsInvolved.Count < 2 ? [] :
        [.. message.AgentsInvolved.Select(agent => new AgentAvatarStackItem(agent.Name,
            AgentLooks.Of(AgentLookup.Look(agent.Id, agent.Name, AgentsState.Agents))))];

    private readonly CancellationTokenSource _lifetime = new();
    private ElementReference _scrollElement;
    private ElementReference _composerElement;
    // Room under the thread for the reply area, which floats over it.
    private IAsyncDisposable? _reserve;
    private string? _tailId;
    private bool _scrollPending;
    private bool _forceScrollPending = true;
    private ComposerMode _composerMode = ComposerMode.Reply;
    private ThreadView _view = ThreadView.Messages;
    private string? _draftedBy;
    private MediaViewerItem? _media;
    private bool _drafting;
    private bool _acting;
    private string? _actionError;
    private DateTime? _clockFor;

    // Approval card state: the approval id we last saw, the decision sent, and any send error.
    private string? _pendingApprovalId;
    private string? _approvalDecision;
    private string? _approvalStatus;
    private string? _approvalError;
    private bool _deciding;

    private ConvMessage? _learningMessage;
    private LearningMode _learningMode;
    private string _learningText = "";
    private string? _learningError;
    private bool _saveForNextTime;
    // Null until the person edits what to remember: until then it is the answer, as it is typed.
    private string? _rememberText;
    private string RememberText => _rememberText ?? _learningText.Trim();

    // Saving an answer as knowledge: when the AI service keeps it, and for people who may change it (as on the Knowledge page).
    private bool CanSaveForNextTime => Knowledge.Enabled
        && Auth.CurrentUser?.Allows(Parrot.SharedComponents.Layout.AccessRules.Knowledge) == true;

    private void SetSaveForNextTime(CheckboxState state)
    {
        _saveForNextTime = state == CheckboxState.Checked;
        _learningError = null;
    }
    private bool _savingLearning;

    // Questions stay as state for the attention strip; their completion is a real conversation event,
    // not a second amber card (and never a fabricated event at the original question's timestamp).
    private IEnumerable<ConvMessage> VisibleMessages => Conversation.Messages.Where(message =>
        _view == ThreadView.Notes ? message.Kind == MessageKind.Note : message.Kind is not (MessageKind.Note or MessageKind.AiQuestion));
    private int NoteCount => Conversation.Messages.Count(message => message.Kind == MessageKind.Note);

    protected override void OnParametersSet()
    {
        if (_tasksFor != Conversation.Id)
        {
            _tasksFor = Conversation.Id; _chatTasks = []; _slot = 0; _questionCount = 0;
            _ = InvokeAsync(async () => { await LoadChatTasksAsync(); StateHasChanged(); });
        }
        // A reply waiting on Take over belongs to the conversation it was asked in.
        if (_quoteOnTakeOver is { } waiting && !Conversation.Messages.Any(m => m.Id == waiting.Id)) _quoteOnTakeOver = null;

        // First load opens at the latest message. Later arrivals follow only when the reader
        // is still at the end; paging/reading older history must not jump to the newest reply.
        var tail = Conversation.HistoryLoaded ? Conversation.Messages.LastOrDefault()?.Id ?? "" : null;
        if (tail != _tailId)
        {
            _tailId = tail;
            if (tail is not null) _scrollPending = true;
        }

        // A new approval card scrolls into view, and resets the decision for a fresh request.
        string? incomingApprovalId = Conversation.PendingApproval?.ApprovalId;
        if (incomingApprovalId != _pendingApprovalId)
        {
            _pendingApprovalId = incomingApprovalId;
            _approvalDecision = null;
            _approvalStatus = null;
            _approvalError = null;
            if (incomingApprovalId is not null) _scrollPending = true;
        }

        // A timed take-over counts down in the control bar.
        if (Conversation.ControlUntil != _clockFor)
        {
            _clockFor = Conversation.ControlUntil;
            if (_clockFor is not null) _ = TickAsync(_clockFor.Value);
        }
    }

    // Only the image chosen opens, with who sent it and when.
    private void OpenMedia(ConvMessage message)
    {
        if (message.Attachment is not { Type: "image", Url: { } url } image) return;
        var sender = message.Kind == MessageKind.Customer ? Conversation.CustomerName : message.Author?.Name ?? AuthorName;
        _media = new MediaViewerItem(
            ConversationMessageItem.AssetUrl(url),
            image.Name,
            sender,
            message.Kind == MessageKind.Customer ? Conversation.Id : message.Author?.Id ?? AuthorSeed,
            message.Kind == MessageKind.Customer ? Conversation.CustomerInitials : Initials.From(sender),
            SentLabel(message.ReceivedAt));
    }

    // A picture, GIF or sticker the customer sent.
    private void OpenFile(MediaPreview preview)
    {
        if (preview.Media.Url is not { } url) return;
        _media = new MediaViewerItem(url, MediaLabels.Name(preview.Media), Conversation.CustomerName, Conversation.Id,
            Conversation.CustomerInitials, SentLabel(preview.Message.ReceivedAt));
    }

    // "Today at 3:00 PM", as WhatsApp labels a viewed image.
    private static string SentLabel(DateTime at)
    {
        var local = at.ToLocalTime();
        var day = DateOnly.FromDateTime(local);
        var today = DateOnly.FromDateTime(DateTime.Now);
        var date = day == today ? "Today" : day == today.AddDays(-1) ? "Yesterday" : local.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
        return $"{date} at {local.ToString("h:mm tt", CultureInfo.InvariantCulture)}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // "Use in reply" on a task: the answer is waiting in the reply box when the chat opens.
        if (ReplyDraft.Take(Conversation.Id) is { } waiting) { UseAnswer(waiting); StateHasChanged(); }
        await AfterRenderAsync();
    }

    private async Task AfterRenderAsync()
    {
        // The thread is drawn once its history has loaded; bind when it exists,
        // so an error above the reply box never covers the last message.
        if (_reserve is null && !string.IsNullOrEmpty(_scrollElement.Id) && !string.IsNullOrEmpty(_composerElement.Id))
        {
            try { _reserve = await Interop.ReserveUnderAsync(_scrollElement, _composerElement, "--ds-timeline-composer-reserve"); }
            catch (JSException) { _reserve = NoReserve.Instance; }
        }
        // Opened at one line (where a task was raised): there, not the newest.
        // An unanswered AI question now lives above the composer, not in the history. A task/notification
        // link to its old message selects that persistent card instead; the answer modal is still explicit.
        if (FocusMessageId is { } questionFocus && questionFocus != _focused)
        {
            var pending = PendingAgentQuestions.ToList().FindIndex(m => m.Id == questionFocus);
            if (pending >= 0)
            {
                _focused = questionFocus;
                _slot = pending;
                StateHasChanged();
            }
        }
        if (FocusMessageId is { } focus && focus != _focused && _items.TryGetValue(focus, out var target) && VisibleMessages.Any(m => m.Id == focus))
        {
            _focused = focus;
            _scrollPending = false;
            _forceScrollPending = false;
            _ = target.ShowAsync("center");
            return;
        }
        if (!_scrollPending) return;
        // The thread isn't on the page while it loads (an approval card can ask for the scroll then): scroll once it is.
        // An empty reference reaches the script as a plain object, and the circuit fails.
        if (string.IsNullOrEmpty(_scrollElement.Id)) return;
        _scrollPending = false;
        var force = _forceScrollPending;
        _forceScrollPending = false;
        await Interop.ScrollToBottomAsync(_scrollElement, force);
    }

    private async Task TickAsync(DateTime until)
    {
        try
        {
            while (_clockFor == until && !_lifetime.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
                if (DateTime.UtcNow >= DateTime.SpecifyKind(until, DateTimeKind.Utc))
                {
                    // The timed window is over: clear the takeover server-side so the AI picks up the next message,
                    // then refresh the conversation so the control bar switches back immediately.
                    try { await Client.ReturnToAiAsync(Conversation.ConnectionId, Conversation.Sender, _lifetime.Token); }
                    catch (Exception ex) when (ex is not OperationCanceledException)
                    {
                        // Best-effort: the backend already expired it via ControlUntil; the refresh will catch up.
                    }
                    await InvokeAsync(() => OnChanged.InvokeAsync());
                    return;
                }
                await Task.Delay(TimeSpan.FromSeconds(1), _lifetime.Token);
            }
        }
        catch (OperationCanceledException) { }
    }

    private string? CountdownLabel
    {
        get
        {
            if (Conversation.ControlUntil is not { } until) return null;
            var remaining = DateTime.SpecifyKind(until, DateTimeKind.Utc) - DateTime.UtcNow;
            if (remaining <= TimeSpan.Zero) return "00:00";
            return remaining.TotalHours >= 1
                ? $"{(int)remaining.TotalHours}:{remaining.Minutes:00}:{remaining.Seconds:00}"
                : $"{remaining.Minutes:00}:{remaining.Seconds:00}";
        }
    }

    // The tabs above the thread and the composer's own tabs are one choice: Messages is Reply, Internal notes
    // is Internal note. Either one moves the other, so the box below always matches what is shown above.
    private void SetView(ThreadView view) =>
        ChangeComposerMode(view == ThreadView.Notes ? ComposerMode.Note : ComposerMode.Reply);

    private void ChangeComposerMode(ComposerMode mode)
    {
        _composerMode = mode;
        _view = mode == ComposerMode.Note ? ThreadView.Notes : ThreadView.Messages;
        _draftedBy = null;
        _scrollPending = true;
        _forceScrollPending = true;
    }

    private void OnComposerTextChanged(string value)
    {
        Conversation.Draft = value;
        _draftedBy = null;
    }

    private void OnAttachmentChosen(Parrot.Web.Services.InboxPendingFile? file)
    {
        Conversation.SendError = null;
        Conversation.PendingFile = file;
        // The same request id belongs to the same message: a different file is a new one.
        Conversation.DraftRequestId = null;
    }

    private Task SendAsync() => _composerMode == ComposerMode.Note ? AddNoteAsync() : SendReplyAsync();

    // Replying to a message, as WhatsApp Web: the composer quotes it and takes the cursor.
    private readonly Dictionary<string, ConversationMessageItem> _items = new();
    private ConversationComposer? _composer;

    // Reply is offered wherever a quoting reply can be sent (designer, 18 October 2026, as WhatsApp): while the
    // AI agent is answering, Reply leads through Take over (19 October), so it needs the take-over actions.
    // Not after the window closes, once resolved, or on TikTok (which cannot show a quote).
    private bool CanQuoteReplies => Conversation.Channel != "tiktok" && !Conversation.ReplyWindowClosed
        && Conversation.Status != ConversationStatus.Resolved && (!Conversation.ReplyLocked || Features.Available);

    private ResponseControl? _control;
    // The message Reply asked for while the AI agent had the conversation: quoted once it is taken over.
    private ConvMessage? _quoteOnTakeOver;

    private void ReplyTo(ConvMessage message)
    {
        if (!CanQuoteReplies) return;
        if (Conversation.ReplyLocked)
        {
            // Never a quote in a locked box: the take-over choice opens, and the quote follows it.
            _quoteOnTakeOver = message;
            _control?.Offer("Take over to reply. For how long?");
            return;
        }
        Quote(message);
    }

    private void Quote(ConvMessage message)
    {
        if (_composerMode != ComposerMode.Reply) ChangeComposerMode(ComposerMode.Reply);
        // A different quote is a different message: a pending retry's request id does not carry over.
        if (Conversation.ReplyingTo?.Id != message.Id) Conversation.DraftRequestId = null;
        Conversation.ReplyingTo = message;
        Conversation.SendError = null;
        _composer?.Focus();
    }

    // A teammate's answer, into the reply box to read over and send (after anything already typed). While the agent is
    // replying, the take-over choice opens, as Reply does; the words wait in the box.
    private void UseAnswer(string text)
    {
        if (_composerMode != ComposerMode.Reply) ChangeComposerMode(ComposerMode.Reply);
        Conversation.Draft = string.IsNullOrWhiteSpace(Conversation.Draft) ? text : $"{Conversation.Draft.TrimEnd()}\n{text}";
        Conversation.DraftRequestId = null;
        Conversation.SendError = null;
        _draftedBy = null;
        if (Conversation.ReplyLocked) _control?.Offer("Take over to send it. For how long?");
        else _composer?.Focus();
    }

    private void CancelReply()
    {
        if (Conversation.ReplyingTo is null) return;
        Conversation.ReplyingTo = null;
        Conversation.DraftRequestId = null;
        _composer?.Focus();
    }

    // The quoted message, when the thread has it loaded.
    private async Task JumpToAsync(string messageId)
    {
        if (_items.TryGetValue(messageId, out var item) && VisibleMessages.Any(m => m.Id == messageId)) await item.ShowAsync();
    }

    private async Task SendReplyAsync()
    {
        var item = Conversation;
        if (item.Sending || item.ReplyLocked || (item.ReplyWindowClosed && item.DraftRequestId is null)
            || (string.IsNullOrWhiteSpace(item.Draft) && item.PendingFile is null)) return;
        item.Sending = true;
        item.SendError = null;
        item.DraftRequestId ??= Guid.NewGuid();
        try
        {
            // Messenger cannot carry text with a file: the file goes alone and the text stays to be sent next.
            var keepText = item.PendingFile is not null && item.Channel == "facebook";
            var replyTo = item.ReplyingTo?.Id;
            var result = item.PendingFile is { } file
                ? await Client.SendFileAsync(item.ConnectionId, item.Sender, item.DraftRequestId.Value, keepText ? null : item.Draft, file, CancellationToken.None, replyTo)
                : await Client.SendAsync(item.ConnectionId, item.Sender,
                    new Parrot.Web.Services.InboxReplyDto(item.DraftRequestId.Value, item.Draft) { ReplyToMessageId = replyTo }, CancellationToken.None);
            ConversationsState.Merge(item, new[] { result });
            ConversationsState.SettleReplyNeed(item, result);
            ConversationsState.SettleAgentQuestions(item, result);
            item.SendError = result.Status switch
            {
                "failed" => "WhatsApp rejected this reply. Check the recipient and server credentials before sending a new message.",
                "unknown" or "pending" => "Delivery is uncertain or still processing. Check the recipient’s phone before composing the same reply again; it will not be resent automatically.",
                _ => null,
            };
            Feedback.Play(item.SendError is null ? Parrot.Web.Services.FeedbackSound.Send : Parrot.Web.Services.FeedbackSound.Error);
            if (!keepText) item.Draft = "";
            item.DraftRequestId = null;
            item.PendingFile = null;
            // Messenger's file goes alone and its text after it: the quote stays for the text.
            if (!keepText) item.ReplyingTo = null;
            _draftedBy = null;
            _scrollPending = true;
            await OnSent.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            Feedback.Play(Parrot.Web.Services.FeedbackSound.Error);
            item.SendError = ex.Message;
            if (ex.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict
                or System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Unauthorized)
                item.DraftRequestId = null;
            // Transport errors retain the same text and request ID for a safe retry.
        }
        catch (Exception ex) when (ex is OperationCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        { item.SendError = "Could not confirm this send. Check / retry uses the same request and will not send it twice."; }
        finally { item.Sending = false; }
    }

    private async Task AddNoteAsync()
    {
        var item = Conversation;
        if (item.Sending || string.IsNullOrWhiteSpace(item.Draft)) return;
        item.Sending = true;
        _actionError = null;
        try
        {
            // Saved on its own, not sent: the customer never receives a note.
            var note = await Client.AddNoteAsync(item.ConnectionId, item.Sender, item.Draft, CancellationToken.None);
            ConversationsState.ApplyNotes(item, item.Messages.Where(m => m.Kind == MessageKind.Note).Select(m => new Parrot.Web.Services.InboxNoteDto(
                m.Id, m.Text, m.Author?.Id ?? "", m.Author?.Name ?? "", m.ReceivedAt)).Append(note));
            item.Draft = "";
            _scrollPending = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        { _actionError = ex is HttpRequestException ? ex.Message : "Could not save this note. Try again."; }
        finally { item.Sending = false; }
    }

    private async Task DeleteNoteAsync(ConvMessage note)
    {
        var item = Conversation;
        _actionError = null;
        try
        {
            await Client.DeleteNoteAsync(item.ConnectionId, item.Sender, note.Id, CancellationToken.None);
            item.Messages = item.Messages.Where(m => m.Id != note.Id).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
        { _actionError = ex is HttpRequestException ? ex.Message : "Could not delete this note. Try again."; }
    }

    private async Task DraftAsync()
    {
        if (_drafting || Conversation.ReplyLocked) return;
        _drafting = true;
        _actionError = null;
        try
        {
            var draft = await Features.DraftReplyAsync(Conversation.ConnectionId, Conversation.Sender);
            _composerMode = ComposerMode.Reply;
            _view = ThreadView.Messages;
            Conversation.Draft = draft.Text;
            _draftedBy = draft.AgentName;
        }
        catch (Exception ex) when (ex is InvalidOperationException or NotSupportedException) { _actionError = ex.Message; }
        finally { _drafting = false; }
    }

    private async Task TakeOverAsync(int? minutes)
    {
        await ActAsync(() => Client.TakeOverAsync(Conversation.ConnectionId, Conversation.Sender, minutes, _lifetime.Token));
        // Taken over from Reply: the message it asked for is quoted, ready to type under.
        if (_quoteOnTakeOver is { } message && _actionError is null) Quote(message);
        _quoteOnTakeOver = null;
    }

    private async Task ReturnToAiAsync()
    {
        await ActAsync(() => Client.ReturnToAiAsync(Conversation.ConnectionId, Conversation.Sender, _lifetime.Token));
        _composerMode = ComposerMode.Reply;
        Conversation.Draft = "";
        _draftedBy = null;
        Conversation.PendingFile = null;
    }

    private async Task ActAsync(Func<Task> action)
    {
        if (_acting) return;
        _acting = true;
        _actionError = null;
        try
        {
            await action();
            _scrollPending = true;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or NotSupportedException)
        { _actionError = ex.Message; }
        finally { _acting = false; }
    }

    private void OpenCorrection(ConvMessage message) => OpenLearning(LearningMode.Correction, message);
    private void OpenAnswer(ConvMessage message) => OpenLearning(LearningMode.Answer, message);

    private void OpenLearning(LearningMode mode, ConvMessage message)
    {
        _learningMode = mode;
        _learningMessage = message;
        _learningText = "";
        _learningError = null;
        _saveForNextTime = false;
        _rememberText = null;
    }

    private void CloseLearning()
    {
        if (_savingLearning) return;
        _learningMessage = null;
        _learningText = "";
        _learningError = null;
    }

    private async Task SaveLearningAsync()
    {
        if (_learningMessage is null || string.IsNullOrWhiteSpace(_learningText) || _savingLearning) return;
        _savingLearning = true;
        _learningError = null;
        try
        {
            if (_learningMode == LearningMode.Correction)
            {
                await Features.CorrectAsync(Conversation.ConnectionId, Conversation.Sender, _learningMessage.Id, _learningText);
            }
            else
            {
                // Saved first: if the AI service refuses it, the dialog stays open with the reason and nothing has moved.
                if (_saveForNextTime && CanSaveForNextTime && string.IsNullOrWhiteSpace(RememberText))
                {
                    _learningError = $"Write what {LearningAgent} should know, or untick Save for next time.";
                    return;
                }
                if (_saveForNextTime && CanSaveForNextTime)
                {
                    await Knowledge.AddStatementAsync(RememberText, _lifetime.Token);
                    Toasts.Show("Saved for next time.", description: $"{CapitalisedAgent} will use it from the next customer message.");
                }

                // The answer waits in the reply box to be checked; sending it is what closes the question (the AI
                // service takes a team reply as the answer). While the agent is replying, the take-over choice opens.
                _view = ThreadView.Messages;
                UseAnswer(_learningText.Trim());
            }
            _learningMessage = null;
            _learningText = "";
            _scrollPending = true;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or NotSupportedException
            or Parrot.Web.Features.Dashboard.Knowledge.KnowledgeSaveRefusedException) { _learningError = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException || (ex is OperationCanceledException && !_lifetime.IsCancellationRequested))
        {
            // Refused in a way the store has no words for, or the AI service took too long.
            _learningError = "We couldn't save it for next time. Try again, or untick Save for next time.";
        }
        finally { _savingLearning = false; }
    }

    // A reply several agents wrote together is corrected for all of them.
    private bool IsSharedCorrection => _learningMode == LearningMode.Correction && _learningMessage?.AgentsInvolved.Count > 1;
    // The agent that wrote the message; else the conversation's, by the workspace's own name for it when its list has it (the API may only know it by id).
    private string LearningAgent => IsSharedCorrection ? "your agents"
        : _learningMessage?.AgentsInvolved.FirstOrDefault()?.Name ?? _learningMessage?.Author?.Name
        ?? (Conversation.AiAgent is { } agent ? AgentsState.GetAgent(agent.Id)?.Name ?? agent.Name : null) ?? "the AI agent";
    // The same, starting a sentence.
    private string CapitalisedAgent => LearningAgent.Length == 0 ? LearningAgent : char.ToUpperInvariant(LearningAgent[0]) + LearningAgent[1..];
    private string LearningTitle => _learningMode == LearningMode.Correction ? "Correct for next time" : $"Answer {LearningAgent}";
    private RenderFragment<string> LearningFooter => _ => @<div class="learning-dialog__footer">
        <Button Variant="ButtonVariant.Secondary" disabled="@_savingLearning" @onclick="CloseLearning">Cancel</Button>
        <Button Busy="@_savingLearning" disabled="@string.IsNullOrWhiteSpace(_learningText)" @onclick="SaveLearningAsync">@LearningConfirmLabel</Button>
    </div>;
    private string LearningConfirmLabel => _learningMode == LearningMode.Correction ? "Save correction" : "Add to reply";
    private string LearningPrompt => _learningMode == LearningMode.Correction
        ? $"What should {LearningAgent} use next time?"
        : "Type the answer";
    private string LearningCommitment => IsSharedCorrection ? "What was already sent stays as it is. Your agents will use this next time."
        : _learningMode == LearningMode.Correction
        ? $"What was already sent stays as it is. {LearningAgent} will use this next time."
        : Conversation.ReplyLocked
            ? $"It goes into your reply box. Take over to send it to {Conversation.CustomerName}. Sending it closes the question."
            : $"It goes into your reply box, so you can check it before it goes to {Conversation.CustomerName}. Sending it closes the question.";

    private static string DateLabel(DateOnly date)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        if (date == today) return "Today";
        if (date == today.AddDays(-1)) return "Yesterday";
        return date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    }

    private Task ApproveAsync() => DecideAsync("approved");
    private Task DenyAsync() => DecideAsync("denied");

    private async Task DecideAsync(string decision)
    {
        if (_deciding || Conversation.PendingApproval is not { } approval) return;
        _deciding = true;
        _approvalError = null;
        try
        {
            Parrot.Application.Agents.ApprovalDecisionResponse result = await Client.DecideApprovalAsync(approval.ApprovalId, decision, null, _lifetime.Token);
            _approvalStatus = result.Status;
            _approvalDecision = ApprovalOutcome.State(decision, result.Status);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // Decided by someone else, or expired, since the card was shown: there is nothing left to decide here.
            _approvalDecision = ApprovalOutcome.Gone;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
        { _approvalError = ex is HttpRequestException ? ex.Message : "Could not send the decision. Try again."; }
        finally { _deciding = false; }
    }

    private static IconName ApprovalIcon(string? decision) => decision switch
    {
        "approved" => IconName.RiCheckFill,
        "denied" => IconName.RiCloseFill,
        _ => IconName.RiRobot3Fill,
    };

    // ── The agent's questions as tasks (designer, 15 November 2026) ──────────────────────────────────────────
    // Unknown AI answers are Inbox questions only. Ordinary tasks/teammate consultations remain independent.
    private string? _tasksFor;
    private bool _resolving, _watchingTasks;

    // Every open task here but the agent's questions: yours and nobody's first.
    private IReadOnlyList<Parrot.Web.Features.Dashboard.TaskRequests.TaskRequest> _chatTasks = [];
    // Only what makes this chat your move (as Needs you counts it): to do, not waiting on the customer, yours or nobody's.
    private IEnumerable<Parrot.Web.Features.Dashboard.TaskRequests.TaskRequest> ChatTasks => _chatTasks
        .Where(t => t.NeedsAction && t.Kind != Parrot.Web.Features.Dashboard.TaskRequests.TaskKind.Question && (t.Assignee is null || t.Assignee.Id == Tasks.Me.Id))
        .OrderByDescending(t => t.Urgent).ThenBy(t => t.DueAt ?? DateTime.MaxValue);
    private int _slot, _questionCount;
    private bool IsPendingAgentQuestion(ConvMessage message) => message.Kind == MessageKind.AiQuestion
        && !message.Answered;
    private IEnumerable<ConvMessage> PendingAgentQuestions => Conversation.Messages
        .Where(IsPendingAgentQuestion)
        .OrderBy(message => message.ReceivedAt);
    private int TeamQuestionStart => PendingAgentQuestions.Count();
    private int TaskStart => TeamQuestionStart + _questionCount;
    private int SlotCount => TaskStart + ChatTasks.Count();
    private int Slot => SlotCount == 0 ? 0 : Math.Clamp(_slot, 0, SlotCount - 1);
    private string TaskOwner(Parrot.Web.Features.Dashboard.TaskRequests.TaskRequest task) => task.Assignee switch
    {
        null => "Task for anyone",
        { } who when who.Id == Tasks.Me.Id => "Task for you",
        { } who => $"{who.Name.Split(' ')[0]}'s task",
    };

    private async Task LoadChatTasksAsync()
    {
        if (!Tasks.Available) return;
        if (!_watchingTasks) { _watchingTasks = true; Tasks.Changed += ChatTasksChanged; }
        var id = Conversation.Id;
        try
        {
            var tasks = await Tasks.ListAsync(_lifetime.Token);
            if (id != Conversation.Id) return;
            _chatTasks = tasks.Where(t => t.Customer?.ConversationId == id).ToArray();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or OperationCanceledException) { }
    }

    private void ChatTasksChanged() => _ = InvokeAsync(async () => { await LoadChatTasksAsync(); StateHasChanged(); });

    // Done clears this Inbox question only. It never creates/settles a task, learns or sends a customer reply.
    private async Task MarkAgentQuestionDoneAsync(ConvMessage question)
    {
        if (_resolving || _savingLearning || !IsPendingAgentQuestion(question)) return;
        _resolving = true;
        var conversation = Conversation;
        try
        {
            await Client.MarkQuestionDoneAsync(conversation.ConnectionId, conversation.Sender, question.Id, _lifetime.Token);
            // The list row and Needs you follow straight away, without waiting for the next refresh.
            question.Answered = true;
            conversation.ClosedQuestions.Add(question.Id);
            conversation.NeedsAnswer = conversation.Messages.Any(m => m.Kind == MessageKind.AiQuestion && !m.Answered);
            Toasts.Show("Marked as done.");
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException e) when (e.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // Someone else closed it, or a reply did, since this chat was read: it is no longer waiting either way.
            question.Answered = true;
            conversation.ClosedQuestions.Add(question.Id);
            conversation.NeedsAnswer = conversation.Messages.Any(m => m.Kind == MessageKind.AiQuestion && !m.Answered);
            Toasts.Show("This question was already closed.");
            await OnChanged.InvokeAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _actionError = "Couldn't mark the question done. Try again.";
        }
        finally { _resolving = false; }
    }


    public void Dispose()
    {
        if (_watchingTasks) Tasks.Changed -= ChatTasksChanged;
        if (_reserve is not null) _ = _reserve.DisposeAsync().AsTask();
        _clockFor = null;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    // Keeping room is a nicety: when it cannot bind, the thread still works.
    private sealed class NoReserve : IAsyncDisposable
    {
        public static readonly NoReserve Instance = new();
        public ValueTask DisposeAsync() => ValueTask.CompletedTask;
    }

    private enum ThreadView { Messages, Notes }
    private enum LearningMode { Correction, Answer }
}
