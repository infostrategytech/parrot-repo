@page "/dashboard/knowledge"
@attribute [RequiresAccess(AccessRules.Knowledge)]
@layout DashboardLayout
@inject Parrot.Web.Features.Dashboard.Knowledge.IKnowledgeMemory Memory
@inject Parrot.Web.Features.Dashboard.Knowledge.KnowledgePreview Preview
@inject Parrot.Web.Features.Dashboard.Knowledge.OmniKnowledgeMemory Omni

<PageTitle>Knowledge · yára</PageTitle>

@* What the business's AI knows (designer, 20 October 2026: Concept B is the page now): what needs a decision,
   telling it something, and a summary per section to rewrite. With no knowledge store behind it (real mode
   today), the placeholder is the honest screen, unless the preview is on: the page, empty, kept in this
   browser, saying so. *@
@if (Memory.Available)
{
    <KnowledgeMemory />
}
else if (Omni.Enabled)
{
    @* What the AI service knows, read-only until it says who may change it. *@
    <KnowledgeMemory Store="Omni" />
}
else if (Preview.Enabled)
{
    <KnowledgeMemory Store="Preview" />
}
else
{
    <ComingInPhase Title="Knowledge" Phase="6" Glyph="IconName.RiBookOpenFill" Summary="What your agents know, and the questions they could not answer." />
}
