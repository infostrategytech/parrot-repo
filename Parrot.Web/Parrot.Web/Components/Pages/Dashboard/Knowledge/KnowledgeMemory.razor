@namespace Parrot.Web.Components.Pages.Dashboard.Knowledge
@using Parrot.Web.Features.Dashboard.Knowledge
@using Parrot.Web.Services
@inject IKnowledgeMemory Memory
@inject AuthState AuthState
@inject ToastService Toasts
@inject NavigationManager Nav

@* What the business's AI knows (designer, 20 October 2026; was Concept B): three jobs, in order. What needs a
   decision; telling it something, which goes into the section it belongs to; and what it knows, one summary
   per section, which the owner can rewrite whenever something changes. How each detail was added is not shown:
   the summary is the thing. *@

<main class="knowledge">
    <header class="knowledge__header">
        <div class="knowledge__heading">
            <div class="knowledge__title">
                <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Knowledge</Typography>
                @if (Knowledge.IsPreview)
                {
                    <StatusBadge Tone="StatusTone.Info">Preview</StatusBadge>
                }
            </div>
            <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose Class="knowledge__lede">
                @($"What your AI knows about {Business}, and uses when it replies to customers.")
            </Typography>
            @if (Knowledge.IsPreview)
            {
                @* Said plainly, so nobody thinks their agents have learnt it (designer, 20 October 2026). *@
                <div class="knowledge__preview-note" role="note">
                    <Icon Name="IconName.RiInformationFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>A preview: what you save here stays in this browser, and your AI doesn't use it yet.</Typography>
                </div>
            }
        </div>
        <Button Variant="ButtonVariant.Secondary" Class="ds-no-shrink" @onclick="() => _testOpen = true">
            <IconLeft><Icon Name="IconName.RiChat3Fill" /></IconLeft>
            <ChildContent>Test as a customer</ChildContent>
        </Button>
    </header>

    @if (_loading)
    {
        <LoadingState Title="Getting what your AI knows" />
    }
    else
    {
        @if (ReviewCount > 0)
        {
            <section class="knowledge__review" aria-label="Details waiting for review">
                <span class="knowledge__review-icon"><Icon Name="IconName.RiCheckDoubleFill" Size="IconSize.Md" /></span>
                <div class="knowledge__review-copy">
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">
                        @(ReviewCount == 1 ? "1 thing to check" : $"{ReviewCount} things to check")
                    </Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="knowledge__muted">
                        Found on your channels, and questions your AI couldn't answer. About a minute; nothing is used until you say yes.
                    </Typography>
                </div>
                <Button Class="ds-no-shrink" @onclick="() => _reviewOpen = true">Check them</Button>
            </section>
        }

        <section class="knowledge__composer" aria-labelledby="knowledge-add-title">
            <div class="knowledge__composer-title">
                <span class="knowledge__composer-icon"><Icon Name="IconName.RiSparkling2Fill" Size="IconSize.Sm" /></span>
                <div>
                    <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="knowledge-add-title">Tell your AI something</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="knowledge__muted">Write it the way you'd explain it to a new team member. It goes into the right section.</Typography>
                </div>
            </div>

            @if (_forQuestion is not null)
            {
                <div class="knowledge__question-context">
                    <Icon Name="IconName.RiQuestionAnswerFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@($"A customer asked: “{_forQuestion}”")</Typography>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Clear customer question" @onclick="ClearQuestion">
                        <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
                    </Button>
                </div>
            }

            <TextArea @ref="_box"
                      Value="@_draft"
                      ValueChanged="value => _draft = value"
                      Placeholder="@(_forQuestion is not null ? "Write the answer in your own words" : "For example: We deliver across Lagos in 1 to 2 days.")"
                      AriaLabel="Tell your AI something"
                      Rows="2"
                      MaxLength="1200"
                      AutoGrow
                      SubmitOnEnter
                      OnKeyDown="AddKeyAsync"
                      Disabled="_adding" />

            <div class="knowledge__composer-actions">
                <div class="knowledge__add-options">
                    @if (Knowledge.CanReadLinks)
                    {
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OpenLinkDialog">
                            <IconLeft><Icon Name="IconName.RiLinksFill" /></IconLeft>
                            <ChildContent>Add from a link</ChildContent>
                        </Button>
                    }
                    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="knowledge__hint">Press Enter to save</Typography>
                </div>
                <Button Busy="_adding" disabled="@(string.IsNullOrWhiteSpace(_draft) || _adding)" @onclick="AddAsync">Save</Button>
            </div>

            @if (_justSaved is { Count: > 0 } saved)
            {
                <div class="knowledge__saved" role="status">
                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>@SavedLine(saved)</Typography>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="UndoAddAsync">Undo</Button>
                </div>
            }
        </section>

        <section class="knowledge__memory" aria-labelledby="knowledge-list-title">
            <div class="knowledge__memory-head">
                <div>
                    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2" id="knowledge-list-title">What your AI knows</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="knowledge__muted">A summary of each part of your business. Edit one whenever something changes.</Typography>
                </div>
                @if (KnownFacts.Count > 0)
                {
                    <SearchField Value="@_search"
                                 ValueChanged="value => _search = value"
                                 Placeholder="Search knowledge"
                                 AriaLabel="Search what your AI knows"
                                 Class="knowledge__search" />
                }
            </div>

            @if (KnownFacts.Count == 0)
            {
                <EmptyState Glyph="IconName.RiBookOpenFill"
                            Size="EmptyStateSize.Panel"
                            Title="Nothing saved yet"
                            Description="@(Knowledge.IsPreview ? "Tell your AI something above. Each detail goes into its section." : "Tell your AI something above, or review what was found for you.")" />
            }
            else if (VisibleSections.Count == 0)
            {
                <EmptyState Glyph="IconName.RiSearch2Fill"
                            Size="EmptyStateSize.Panel"
                            Title="Nothing matches"
                            Description="Try another word." />
            }
            else
            {
                @* One row per section: its icon, its name, the summary, when it last changed, and Edit. *@
                <ul class="knowledge__sections">
                    @foreach (var section in VisibleSections)
                    {
                        var current = section;
                        var editing = _editing == current.Label;
                        <li class="@($"knowledge__section{(_freshLabels.Contains(current.Label) ? " is-fresh" : null)}{(editing ? " is-editing" : null)}")" @key="current.Label">
                            <span class="@($"knowledge__topic-icon {TopicTone(current.Topic)}")" aria-hidden="true">
                                <Icon Name="@KnowledgeTopics.Icon(current.Topic)" Size="IconSize.Sm" />
                            </span>
                            <div class="knowledge__section-body">
                                <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h3" id="@SectionId(current)">@current.Label</Typography>
                                @if (editing)
                                {
                                    <TextArea Value="@_editText"
                                              ValueChanged="value => _editText = value"
                                              AriaLabel="@($"{current.Label}: what your AI knows")"
                                              TextStyle="TextStyle.BodySmallMedium"
                                              Rows="3"
                                              AutoGrow
                                              MaxLength="1200"
                                              Disabled="_savingEdit" />
                                    <div class="knowledge__edit-actions">
                                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="_savingEdit" @onclick="CancelEdit">Cancel</Button>
                                        <Button Size="ButtonSize.Small" Busy="_savingEdit" disabled="@(string.IsNullOrWhiteSpace(_editText) || _savingEdit)" @onclick="() => SaveSummaryAsync(current)">Save</Button>
                                    </div>
                                }
                                else
                                {
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="knowledge__summary">@current.Summary</Typography>
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="knowledge__updated">@UpdatedLine(current.Latest)</Typography>
                                }
                            </div>
                            @if (!editing)
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="knowledge__edit" aria-describedby="@SectionId(current)" disabled="@(_editing is not null)" @onclick="() => StartEditing(current)">
                                    <IconLeft><Icon Name="IconName.RiPencilFill" /></IconLeft>
                                    <ChildContent>Edit</ChildContent>
                                </Button>
                            }
                        </li>
                    }
                </ul>
            }

            @* What it knows from Products & Services, kept there: a way there, and a reminder that it counts. *@
            <div class="knowledge__catalog-link">
                <span class="knowledge__catalog-icon"><Icon Name="IconName.RiShoppingBag3Fill" Size="IconSize.Sm" /></span>
                <div>
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="p">Products and prices</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="knowledge__muted">Your AI also knows your items, prices and availability from Products &amp; Services.</Typography>
                </div>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OpenCatalog">
                    <ChildContent>Open Products &amp; Services</ChildContent>
                    <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                </Button>
            </div>
        </section>
    }
</main>

<KnowledgeReview Store="Knowledge" Open="_reviewOpen" Snapshot="_snapshot" OnClose="() => _reviewOpen = false" OnChanged="ReloadAsync"
                 OnTest="() => { _reviewOpen = false; _testOpen = true; }" />
<KnowledgeTest Open="_testOpen" Facts="KnownFacts" OnClose="() => _testOpen = false" OnTeach="TeachFromTest" />

<Dialog Open="_linkOpen"
        Title="Add knowledge from a link"
        Subtitle="yára finds the useful details and asks you to approve them."
        ConfirmLabel="Check link"
        Busy="_readingLink"
        BusyLabel="Checking link…"
        ConfirmDisabled="@string.IsNullOrWhiteSpace(_link)"
        Dismissible
        OnConfirm="ReadLinkAsync"
        OnCancel="CloseLinkDialog">
    <Body>
        <Input FloatingLabel="Website or social link"
               Value="@_link"
               ValueChanged="value => _link = value"
               Placeholder="https://yourbusiness.com"
               autocomplete="url"
               disabled="@_readingLink" />
    </Body>
</Dialog>

@code {
    /// <summary>The store to use instead of the app's (the preview, before the knowledge store exists).</summary>
    [Parameter] public IKnowledgeMemory? Store { get; set; }

    private IKnowledgeMemory Knowledge => Store ?? Memory;

    private KnowledgeSnapshot _snapshot = new([], [], []);
    private bool _loading = true, _adding, _reviewOpen, _testOpen, _focusBox;
    private bool _linkOpen, _readingLink, _savingEdit;
    private string? _draft, _forQuestion, _link, _search, _editing, _editText;
    private List<KnowledgeFact>? _justSaved;
    private IReadOnlyCollection<string> _freshLabels = [];
    private TextArea? _box;

    private sealed record SummarySection(string Label, KnowledgeTopic Topic, string Summary, KnowledgeFact Latest);

    private static readonly string[] Usual =
        ["About the business", "Prices and offers", "Delivery", "Payment", "Hours and contact", "Policies"];

    private string Business => AuthState.CurrentUser?.BusinessName is { Length: > 0 } name ? name : "your business";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
        if (new Uri(Nav.Uri).Query.TrimStart('?').Split('&').Contains("review=1") && ReviewCount > 0) _reviewOpen = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBox && _box is not null)
        {
            _focusBox = false;
            await _box.FocusAsync();
        }
    }

    private async Task LoadAsync() => _snapshot = await Knowledge.ListAsync();

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private IReadOnlyList<KnowledgeFact> KnownFacts => [.. _snapshot.Facts.Where(fact => fact.State == FactState.Known)];
    private int ReviewCount => _snapshot.Conflicts.Count + _snapshot.Questions.Count + _snapshot.Facts.Count(fact => fact.State == FactState.ToConfirm);

    private static int Order(string label) => label == "Other" ? int.MaxValue : Array.IndexOf(Usual, label) is var index and >= 0 ? index : Usual.Length;

    private IReadOnlyList<SummarySection> SummarySections =>
    [
        .. KnownFacts.GroupBy(fact => fact.Label)
            .Select(group =>
            {
                var facts = group.OrderBy(fact => fact.UpdatedAt).ToList();
                var latest = facts[^1];
                return new SummarySection(group.Key, latest.Topic, Summarise(facts), latest);
            })
            .OrderBy(section => Order(section.Label))
            .ThenBy(section => section.Label, StringComparer.CurrentCultureIgnoreCase),
    ];

    private bool Searching => !string.IsNullOrWhiteSpace(_search);

    private IReadOnlyList<SummarySection> VisibleSections =>
    [
        .. SummarySections.Where(section =>
            !Searching ||
            section.Label.Contains(_search!.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
            section.Summary.Contains(_search!.Trim(), StringComparison.CurrentCultureIgnoreCase)),
    ];

    // The demo's summary: the section's details, as one paragraph. The knowledge service writes this (see the backend requests).
    private static string Summarise(IReadOnlyList<KnowledgeFact> facts) =>
        string.Join(" ", facts.Select(fact => fact.Text.Trim()).Where(text => text.Length > 0).Distinct(StringComparer.CurrentCultureIgnoreCase));

    private static string SectionId(SummarySection section) => "knowledge-section-" + string.Concat(section.Label.Where(char.IsLetterOrDigit)).ToLowerInvariant();

    private static string TopicTone(KnowledgeTopic topic) => topic switch
    {
        KnowledgeTopic.Prices or KnowledgeTopic.Payment => "is-amber",
        KnowledgeTopic.Delivery or KnowledgeTopic.Hours => "is-teal",
        KnowledgeTopic.Returns or KnowledgeTopic.Handover => "is-violet",
        _ => "is-cyan",
    };

    private static string UpdatedLine(KnowledgeFact fact) => $"Updated {Ago(fact.UpdatedAt)}";

    private static string SavedLine(IReadOnlyList<KnowledgeFact> saved)
    {
        var labels = saved.Select(fact => fact.Label).Distinct().ToList();
        var where = labels.Count == 1 ? labels[0] : string.Join(", ", labels[..^1]) + " and " + labels[^1];
        return $"Added to {where}.";
    }

    private static string Ago(DateTimeOffset when)
    {
        var days = (int)Math.Floor((DateTimeOffset.UtcNow - when).TotalDays);
        return days switch { <= 0 => "today", 1 => "yesterday", < 7 => $"{days} days ago", < 14 => "last week", _ => when.ToString("d MMM") };
    }

    private async Task AddKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey) await AddAsync();
    }

    // Told something: it goes into the section it belongs to, and that section lights for a moment.
    private async Task AddAsync()
    {
        var text = _draft?.Trim();
        if (string.IsNullOrEmpty(text) || _adding) return;
        _adding = true;
        try
        {
            _justSaved = [.. await Knowledge.AddAsync(text)];
            _freshLabels = [.. _justSaved.Select(fact => fact.Label)];
            _draft = null;
            _forQuestion = null;
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Toasts.ShowError("We couldn't save that. Check your connection and try again.");
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task UndoAddAsync()
    {
        if (_justSaved is null) return;
        foreach (var fact in _justSaved) await Knowledge.DeleteAsync(fact.Id);
        _justSaved = null;
        _freshLabels = [];
        await LoadAsync();
    }

    private void TeachFromTest(string question)
    {
        _testOpen = false;
        _forQuestion = question;
        _focusBox = true;
    }

    private void ClearQuestion()
    {
        _forQuestion = null;
        _focusBox = true;
    }

    private void OpenLinkDialog()
    {
        _link = null;
        _linkOpen = true;
    }

    private void OpenCatalog() => Nav.NavigateTo("/dashboard/products");

    // Editing a section: its summary, in place.
    private void StartEditing(SummarySection section)
    {
        _editing = section.Label;
        _editText = section.Summary;
    }

    private void CancelEdit()
    {
        _editing = null;
        _editText = null;
    }

    // Saved: the section becomes the summary they wrote (one entry; the details it was made from are let go),
    // with Undo, which brings those back as they were.
    private async Task SaveSummaryAsync(SummarySection section)
    {
        var text = _editText?.Trim();
        if (string.IsNullOrEmpty(text) || _savingEdit) return;
        if (text == section.Summary) { CancelEdit(); return; }
        _savingEdit = true;
        var before = KnownFacts.Where(fact => fact.Label == section.Label).ToList();
        try
        {
            var keep = before.OrderByDescending(fact => fact.UpdatedAt).First();
            await Knowledge.UpdateAsync(keep.Id, text);
            foreach (var other in before.Where(fact => fact.Id != keep.Id)) await Knowledge.DeleteAsync(other.Id);
            await LoadAsync();
            CancelEdit();
            _freshLabels = [section.Label];
            Toasts.Show(new ToastMessage($"{section.Label} updated. Your AI uses it from now on.", null, ToastStatus.Success, "Undo",
                () => InvokeAsync(() => UndoSummaryAsync(before))));
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Toasts.ShowError("We couldn't save that. Check your connection and try again.");
        }
        finally
        {
            _savingEdit = false;
        }
    }

    private async Task UndoSummaryAsync(IReadOnlyList<KnowledgeFact> before)
    {
        foreach (var fact in before)
        {
            await Knowledge.DeleteAsync(fact.Id);
            await Knowledge.RestoreAsync(fact);
        }
        _freshLabels = [];
        await LoadAsync();
        StateHasChanged();
    }

    private Task CloseLinkDialog()
    {
        if (!_readingLink) _linkOpen = false;
        return Task.CompletedTask;
    }

    private async Task ReadLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_link) || _readingLink) return;
        _readingLink = true;
        try
        {
            var found = await Knowledge.ReadWebsiteAsync(_link.Trim());
            await LoadAsync();
            _linkOpen = false;
            if (found.Count > 0)
            {
                Toasts.Show(found.Count == 1 ? "1 detail is ready to review" : $"{found.Count} details are ready to review");
                _reviewOpen = true;
            }
            else
            {
                Toasts.Show("This link is already added");
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Toasts.ShowError("We couldn't read that link. Check it and try again.");
        }
        finally
        {
            _readingLink = false;
        }
    }
}
