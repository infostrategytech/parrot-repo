@namespace Parrot.Web.Components.Pages.Dashboard.Settings

@* Password, two-factor, sessions and the danger zone. Each password field
   carries a reveal control in Aurora's Input icon slot. *@

<SettingsCard Title="Change password" Description="Ensure your account is using a strong, unique password.">
    <ChildContent>
        @* Input is self-closing in Razor (it shares its name with the HTML
           void element), so the reveal control travels as a fragment. *@
        <div class="security__fields">
            <Input FloatingLabel="Current password"
                   Type="@(_showCurrent ? "text" : "password")"
                   IconRight="@Reveal(_showCurrent, () => _showCurrent = !_showCurrent)"
                   @bind-Value="_current" />
            <Input FloatingLabel="New password"
                   Type="@(_showNew ? "text" : "password")"
                   HelperText="Create a secure password"
                   IconRight="@Reveal(_showNew, () => _showNew = !_showNew)"
                   @bind-Value="_new" />
            <Input FloatingLabel="Confirm new password"
                   Type="@(_showConfirm ? "text" : "password")"
                   IconRight="@Reveal(_showConfirm, () => _showConfirm = !_showConfirm)"
                   @bind-Value="_confirm" />
        </div>
    </ChildContent>
    <Footer>
        <Button>Update password</Button>
    </Footer>
</SettingsCard>

<SettingsCard Title="Two-factor authentication" Description="Add an extra layer of security.">
    <Toggle @bind-Checked="_twoFa"
            Label="Two-factor authentication"
            Description="Add an extra layer of security to your account by requiring a verification code from your mobile device." />
</SettingsCard>

<SettingsCard Title="Active sessions" Description="Logged-in devices and current locations.">
    <HeaderAction>
        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Log out of all sessions</Button>
    </HeaderAction>
    <ChildContent>
        <div class="security__sessions">
            @foreach (var s in _sessions)
            {
                <article class="security__session">
                    <span class="security__session-icon"><Icon Name="IconName.RiComputerFill" Size="IconSize.Md" /></span>
                    <div class="security__session-info">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong" Prose>@s.Device · @s.Browser</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>@s.Location</Typography>
                        @if (s.IsCurrent)
                        {
                            <StatusBadge Tone="StatusTone.Success" Glyph="IconName.RiCheckFill">@s.Time</StatusBadge>
                        }
                        else
                        {
                            <Typography TextStyle="TextStyle.Small10Regular" As="time">@s.Time</Typography>
                        }
                    </div>
                    @if (!s.IsCurrent)
                    {
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="End this session">
                            <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
                        </Button>
                    }
                </article>
            }
        </div>
    </ChildContent>
</SettingsCard>

<SettingsCard Title="Danger zone" Description="Irreversible actions that affect your entire workspace." Danger>
    <div class="security__danger">
        <div class="security__danger-text">
            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Delete workspace</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Permanently delete this workspace and all its data.</Typography>
        </div>
        <Button Variant="ButtonVariant.Destructive">
            <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
            <ChildContent>Delete account</ChildContent>
        </Button>
    </div>
</SettingsCard>

@code {
    bool _showCurrent, _showNew, _showConfirm, _twoFa;
    string _current = string.Empty, _new = string.Empty, _confirm = string.Empty;

    // The sprite has no eye-off glyph, so a revealed field shows a lock instead.
    private RenderFragment Reveal(bool shown, Action toggle) =>
        @<button type="button" class="security__reveal"
                 aria-label="@(shown ? "Hide password" : "Show password")"
                 @onclick="toggle">
            <Icon Name="@(shown ? IconName.RiLock2Fill : IconName.RiEyeFill)" Size="IconSize.Sm" />
        </button>;

    record SessionItem(string Device, string Browser, string Location, string Time, bool IsCurrent);

    List<SessionItem> _sessions =
    [
        new("Macbook Pro", "Chrome", "Lagos, Nigeria", "Current session", true),
        new("Macbook Pro", "Chrome", "Lagos, Nigeria", "2 hours ago", false),
        new("Macbook Pro", "Chrome", "Lagos, Nigeria", "2 hours ago", false),
    ];
}
