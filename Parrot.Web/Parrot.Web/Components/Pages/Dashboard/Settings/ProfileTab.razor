@namespace Parrot.Web.Components.Pages.Dashboard.Settings
@using Parrot.Web.Features.Profile
@inject AuthState AuthState
@inject ProfileClient Profile
@inject IProfilePhoto Photo
@inject ToastService Toasts
@inject NavigationManager Navigation

@* The person who's signed in, and nothing of the business (designer, 4 November 2026). You at the top, centred,
   as an agent is shown when it's made: your photo or initials, with a camera to change it, and your name as you
   type it. Then your name and number across the card, saved together, and the email you sign in with, changed
   in place with a code to the new address. Names are optional for the owner; a teammate gives theirs when they
   join. A photo is kept apart from the business logo, so outside the demo it waits for its own API field. *@
<SettingsCard>
    <ChildContent>
        <div class="profile">
            <div class="profile__you">
                <AvatarPicker Seed="@(AuthState.CurrentUser?.UserId ?? "user")" Initials="@AvatarInitials" ImageUrl="@Photo.Url" Class="profile__photo"
                              Label="@(Photo.Url is null ? "Add a photo" : "Change photo")" Accept="@PhotoRules.Accept" CanChange="Photo.Available"
                              Busy="_photoBusy" Disabled="@(!_photoLoaded)" OnChange="PhotoPickedAsync" />
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="p" Class="@(HasName ? "profile__name" : "profile__name is-empty")">@(HasName ? FullName : "Your name")</Typography>
                @if (Photo.Available && Photo.Url is not null)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@(_photoBusy || !_photoLoaded)" @onclick="RemovePhotoAsync">Remove photo</Button>
                }
                @if (_photoError is not null)
                {
                    @if (!_photoLoaded)
                    {
                        <InlineError Message="@_photoError">
                            <Action>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Busy="_photoBusy" @onclick="LoadPhotoAsync">Retry photo</Button>
                            </Action>
                        </InlineError>
                    }
                    else
                    {
                        <InlineError Message="@_photoError" />
                    }
                }
                <span class="sr-only" role="status">@_photoStatus</span>
            </div>

            @if (_loading)
            {
                <Skeleton Shape="SkeletonShape.Line" />
            }
            else if (!_loaded)
            {
                <InlineError Message="@(_loadError ?? "We couldn't load your profile. Try again before making changes.")">
                    <Action><Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="LoadProfileAsync">Retry</Button></Action>
                </InlineError>
            }
            else
            {
                <div class="profile__form">
                    <div class="profile__pair">
                        <Input FloatingLabel="First name" Value="@_firstName" ValueChanged="value => _firstName = value" maxlength="80" autocomplete="given-name" />
                        <Input FloatingLabel="Last name" Value="@_lastName" ValueChanged="value => _lastName = value" maxlength="80" autocomplete="family-name" />
                    </div>

                    <div class="profile__phone">
                        <SelectField FloatingLabel="Country" Value="@(_country == PhoneCountries.Unlisted ? "Other" : $"+{_country.Code}")" Open="_countryOpen" OpenChanged="open => _countryOpen = open">
                            @if (_savedCountry == PhoneCountries.Unlisted)
                            {
                                <PopoverOption Label="Keep saved number" Active="@(_country == PhoneCountries.Unlisted)" OnSelect="KeepSavedPhone" />
                            }
                            @foreach (var country in PhoneCountries.All)
                            {
                                var current = country;
                                <PopoverOption Label="@current.Name" Badge="@($"+{current.Code}")" Active="@(current == _country)" OnSelect="() => ChooseCountry(current)" />
                            }
                        </SelectField>
                        <Input FloatingLabel="Phone number" Type="tel" Numeric="NumericInputKind.Phone" Value="@_phone" ValueChanged="value => { _phone = value; _phoneProblem = null; }"
                               maxlength="20" autocomplete="tel-national" Disabled="@(_country == PhoneCountries.Unlisted)" Error="@(_phoneProblem is not null)"
                               HelperText="@(_phoneProblem ?? (_country == PhoneCountries.Unlisted ? "Your saved number is kept as-is. Choose a country to change it." : null))" />
                    </div>

                    <EmailChangeRow Email="@(_email ?? "")" OnChanged="EmailChanged" />
                </div>
            }
        </div>
    </ChildContent>
</SettingsCard>

<NavigationLock ConfirmExternalNavigation="@(_loaded && Changed && !_allowNavigation)" OnBeforeInternalNavigation="CheckNavigationAsync" />
<Dialog Open="_confirmLeave" Title="Leave without saving?" ConfirmLabel="Leave without saving" CancelLabel="Keep editing"
        OnConfirm="Leave" OnCancel="KeepEditing">
    <Body><Typography TextStyle="TextStyle.BodySmallMedium" As="p">Your name and phone changes haven't been saved.</Typography></Body>
</Dialog>

@* Where sign-in lands: the last workspace, or one chosen to always open (the backend team's, 22 October 2026). *@
<SignInPreference />

@* Name and phone wait for the shared save bar, as Business profile's details do (designer, 7 November 2026): one
   way to save across Settings. It appears once something changes, as the page's last child; the photo and the
   email keep saving on their own. *@
@if (_loaded && Changed)
{
    <SaveBar Error="@_saveError" Saving="_saving" OnDiscard="Discard" OnSave="SaveAsync" />
}

@code {
    private string? _firstName, _lastName, _phone, _email;
    private PhoneCountry _country = PhoneCountries.Home;
    // As last loaded or saved, so Save only lights up for a real change.
    private string? _savedFirst, _savedLast, _savedPhone;
    private PhoneCountry _savedCountry = PhoneCountries.Home;

    private bool _loading = true, _loaded, _saving, _countryOpen, _photoBusy, _photoLoaded;
    private bool _confirmLeave, _allowNavigation;
    private string? _loadError, _saveError, _phoneProblem, _photoError, _photoStatus, _navigationTarget;

    private bool HasName => !string.IsNullOrWhiteSpace(_firstName) || !string.IsNullOrWhiteSpace(_lastName);
    private string FullName => $"{_firstName?.Trim()} {_lastName?.Trim()}".Trim();

    // The person's own initials once there is a name; the email's until then.
    private string AvatarInitials => HasName ? Initials.From(FullName) : Initials.From(_email);

    private bool Changed =>
        (_firstName?.Trim() ?? "") != (_savedFirst?.Trim() ?? "")
        || (_lastName?.Trim() ?? "") != (_savedLast?.Trim() ?? "")
        || !PhoneCountries.Same(_country, _phone, _savedCountry, _savedPhone);

    protected override async Task OnInitializedAsync()
    {
        _email = AuthState.CurrentUser?.Email;
        // Photo loading is optional and independent: its failure must never hide the person's details.
        await Task.WhenAll(LoadProfileAsync(), LoadPhotoAsync());
    }

    private async Task LoadProfileAsync()
    {
        _loading = true; _loaded = false; _loadError = null;
        try
        {
            Show(await Profile.GetAsync());
            _loaded = true;
        }
        catch (Exception)
        {
            _loadError = "We couldn't load your profile. Try again before making changes.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPhotoAsync()
    {
        if (!Photo.Available) return;
        if (_photoBusy) return;
        _photoBusy = true; _photoError = null;
        try { await Photo.ReadAsync(); _photoLoaded = true; }
        catch (Exception) { _photoError = "We couldn't load your photo. Try again."; }
        finally { _photoBusy = false; StateHasChanged(); }
    }

    private void ChooseCountry(PhoneCountry country)
    {
        if (_saving) return;
        if (_country == PhoneCountries.Unlisted) _phone = string.Empty;
        _country = country; _countryOpen = false; _phoneProblem = null;
    }

    // Back to what was last loaded or saved.
    private void Discard()
    {
        if (_saving) return;
        _firstName = _savedFirst; _lastName = _savedLast; _country = _savedCountry; _phone = _savedPhone;
        _phoneProblem = null; _saveError = null; _countryOpen = false;
    }

    private void KeepSavedPhone()
    {
        if (_saving) return;
        _country = _savedCountry; _phone = _savedPhone; _countryOpen = false; _phoneProblem = null;
    }

    private void Show(UserProfile profile)
    {
        _firstName = _savedFirst = profile.FirstName;
        _lastName = _savedLast = profile.LastName;
        (_country, _phone) = PhoneCountries.Split(profile.PhoneNumber);
        (_savedCountry, _savedPhone) = (_country, _phone);
        _email = profile.Email;
    }

    // A photo is kept as soon as it's picked: nothing to remember to save.
    private async Task PhotoPickedAsync(InputFileChangeEventArgs args)
    {
        if (_photoBusy || !_photoLoaded || !Photo.Available) return;
        _photoError = null;
        var file = args.File;
        if (PhotoRules.Problem(file.ContentType, file.Size) is { } problem) { _photoError = problem; return; }
        _photoBusy = true; _photoStatus = "Uploading your photo";
        try
        {
            await using var stream = file.OpenReadStream(PhotoRules.MaxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await Photo.SaveAsync(file.ContentType, memory.ToArray());
            _photoStatus = "Photo updated";
            Toasts.Show("Photo updated");
        }
        catch (Exception ex) when (ex is IOException or HttpRequestException or ApiException)
        {
            _photoStatus = null;
            _photoError = ex is ApiException api ? api.UserMessage : "Your photo couldn't be uploaded. Try again.";
        }
        finally { _photoBusy = false; }
    }

    private async Task RemovePhotoAsync()
    {
        if (_photoBusy || !_photoLoaded || !Photo.Available) return;
        _photoError = null; _photoBusy = true;
        try { await Photo.RemoveAsync(); _photoStatus = "Photo removed"; Toasts.Show("Photo removed"); }
        catch (Exception ex) when (ex is HttpRequestException or ApiException) { _photoError = "Your photo couldn't be removed. Try again."; }
        finally { _photoBusy = false; }
    }

    private async Task SaveAsync()
    {
        if (!_loaded || _loading || _saving || !Changed) return;
        _saveError = null;
        var phoneChanged = !PhoneCountries.Same(_country, _phone, _savedCountry, _savedPhone);
        if (phoneChanged && string.IsNullOrWhiteSpace(_phone))
        {
            // The API keeps a number once there is one: it can be changed, not taken off.
            _phoneProblem = "A number can be changed but not removed yet.";
            return;
        }
        _phoneProblem = phoneChanged ? PhoneCountries.Problem(_country, _phone) : null;
        if (_phoneProblem is not null) return;

        _saving = true;
        try
        {
            // Only changed fields go: a name intentionally cleared is empty, while unseen/unchanged values stay untouched.
            Show(await Profile.UpdateAsync(new UserProfileUpdate
            {
                FirstName = (_firstName?.Trim() ?? "") != (_savedFirst?.Trim() ?? "") ? _firstName?.Trim() ?? "" : null,
                LastName = (_lastName?.Trim() ?? "") != (_savedLast?.Trim() ?? "") ? _lastName?.Trim() ?? "" : null,
                CountryCode = phoneChanged ? _country.Code : null,
                Number = phoneChanged ? PhoneCountries.National(_country, _phone!) : null,
            }));
            Toasts.Show("Profile saved");
        }
        catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Conflict)
        {
            _phoneProblem = ex.UserMessage;
        }
        catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.BadRequest)
        {
            if (phoneChanged && ex.UserMessage.Contains("phone", StringComparison.OrdinalIgnoreCase)) _phoneProblem = ex.UserMessage;
            else _saveError = ex.UserMessage;
        }
        catch (Exception)
        {
            _saveError = "We couldn't save your profile. Try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void EmailChanged(string email)
    {
        _email = email;
        Toasts.Show("Email changed");
    }

    private Task CheckNavigationAsync(LocationChangingContext context)
    {
        if (_allowNavigation || !_loaded || !Changed) return Task.CompletedTask;
        context.PreventNavigation();
        if (!_saving) { _navigationTarget = context.TargetLocation; _confirmLeave = true; StateHasChanged(); }
        return Task.CompletedTask;
    }

    private void KeepEditing() { _confirmLeave = false; _navigationTarget = null; }

    private void Leave()
    {
        if (_saving || _navigationTarget is null) return;
        _allowNavigation = true; _confirmLeave = false;
        Navigation.NavigateTo(_navigationTarget);
    }
}
