@namespace Parrot.Web.Components.Pages.Dashboard.Settings
@inject AuthState AuthState

@* Who is signed in. Parrot's session carries an email and a user id, so the
   avatar and the email are real; the name fields wait for a value. *@

<SettingsCard Title="Profile information" Description="Update your personal account details.">
    <ChildContent>
        <div class="profile__avatar-row">
            <PetalAvatar Seed="@(AuthState.CurrentUser?.UserId ?? "user")"
                         Initials="@Initials.From(AuthState.CurrentUser?.Email)"
                         Size="AvatarSize.Lg" />
            <div class="profile__avatar-actions">
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Upload image</Button>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small">Remove</Button>
            </div>
            <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose Class="profile__hint">
                JPG, GIF or PNG. 1MB max.
            </Typography>
        </div>

        <div class="profile__grid">
            <Input FloatingLabel="First name" @bind-Value="_firstName" maxlength="80" />
            <Input FloatingLabel="Last name" @bind-Value="_lastName" maxlength="80" />
            <div class="profile__full">
                <Input FloatingLabel="Email address" Type="email" @bind-Value="_email" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button>Save</Button>
    </Footer>
</SettingsCard>

@code {
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;

    protected override void OnInitialized()
    {
        _email = AuthState.CurrentUser?.Email ?? string.Empty;
    }
}
