@namespace Parrot.Web.Components.Pages.Dashboard.Settings

@* Plan, usage, upgrades and invoices. The usage strip is Aurora's summary
   card divided into cells; the plan cards are its editor kind cards; the
   invoice list is its grid table. *@

<SettingsCard Title="Your plan">
    <div class="billing__plan">
        <div class="billing__plan-text">
            <div class="billing__plan-name">
                <Typography TextStyle="TextStyle.BodyDefaultBold" As="strong">Growth</Typography>
                <StatusBadge Tone="StatusTone.Success" Glyph="IconName.RiCheckFill">Active</StatusBadge>
            </div>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
                Best for growing teams managing customer conversations with AI agents.
            </Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>
                Monthly billing · Next renewal: Mar 1, 2026
            </Typography>
        </div>
        <div class="billing__plan-actions">
            <Button>Upgrade plan</Button>
            <Button Variant="ButtonVariant.Secondary">Manage payment</Button>
        </div>
    </div>

    <section class="billing__usage" aria-label="Usage overview">
        <div class="billing__usage-titles">
            <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Usage overview</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Current billing period usage.</Typography>
        </div>
        <div class="billing__usage-label">
            <Typography TextStyle="TextStyle.Small12Medium" As="span">Conversations</Typography>
            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">24,400 / 50,000</Typography>
        </div>
        <div class="billing__progress" role="progressbar" aria-valuenow="24400" aria-valuemin="0" aria-valuemax="50000">
            <i style="width: 48.8%"></i>
        </div>
        <div class="billing__stats">
            @foreach (var stat in UsageStats)
            {
                <div class="billing__stat">
                    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong" Prose>@stat.Value</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@stat.Label</Typography>
                </div>
            }
        </div>
    </section>
</SettingsCard>

<SettingsCard Title="Plans & upgrades" Description="Choose the plan that fits your team.">
    <HeaderAction>
        <div class="billing__cycle">
            @* The shared two-way switch, as Appearance's theme uses (designer, 7 November 2026: components, not raw buttons). *@
            <SegmentedControl TValue="bool" Label="Billing cycle" Options="Cycles" Value="_yearly" ValueChanged="yearly => _yearly = yearly" />
            <StatusBadge Tone="StatusTone.Success">Save 20%</StatusBadge>
        </div>
    </HeaderAction>
    <ChildContent>
        <div class="billing__plans">
            @foreach (var plan in Plans)
            {
                <article class="@(plan.Current ? "billing__plan-card is-current" : "billing__plan-card")">
                    <div class="billing__plan-card-top">
                        <Typography TextStyle="TextStyle.BodyDefaultBold" As="h3">@plan.Name</Typography>
                        @if (plan.Current)
                        {
                            <StatusBadge Tone="StatusTone.Brand">Recommended</StatusBadge>
                        }
                    </div>
                    <div class="billing__plan-price">
                        <Typography TextStyle="TextStyle.HeadingH2Bold" As="strong">@plan.Price</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="span">/month</Typography>
                    </div>
                    <Typography TextStyle="TextStyle.Small12Regular" As="small" Class="billing__plan-billing">Billed annually</Typography>
                    <ul class="billing__features">
                        @foreach (var feature in plan.Features)
                        {
                            <li>
                                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                                <Typography TextStyle="TextStyle.Small12Regular" As="span" Prose>@feature</Typography>
                            </li>
                        }
                    </ul>
                    @if (plan.Current)
                    {
                        <Button Variant="ButtonVariant.Secondary" Class="billing__plan-action" disabled>Current plan</Button>
                    }
                    else if (plan.Primary)
                    {
                        <Button Class="billing__plan-action">Upgrade plan</Button>
                    }
                    else
                    {
                        <Button Variant="ButtonVariant.Secondary" Class="billing__plan-action">Downgrade plan</Button>
                    }
                </article>
            }
        </div>
    </ChildContent>
</SettingsCard>

<SettingsCard Title="Payment history" Description="A record of billing and payment activity.">
    <div class="billing__invoices" role="table" aria-label="Invoices">
        <div class="billing__invoices-head" role="row">
            @foreach (var column in InvoiceColumns)
            {
                <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline" role="columnheader">@column</Typography>
            }
            <span role="columnheader" aria-label="Actions"></span>
        </div>
        @foreach (var inv in _invoices)
        {
            <div class="billing__invoice" role="row">
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong" role="cell">@inv.Id</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="span" role="cell">@inv.Amount</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="span" Class="billing__invoice-date" role="cell">@inv.Date</Typography>
                <div role="cell">
                    <StatusBadge Tone="@(inv.StatusClass == "paid" ? StatusTone.Success : StatusTone.Warning)">@inv.Status</StatusBadge>
                </div>
                <div class="billing__invoice-actions" role="cell">
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="@($"Download {inv.Id}")">
                        <IconLeft><Icon Name="IconName.RiFileTextFill" /></IconLeft>
                        <ChildContent>Download</ChildContent>
                    </Button>
                </div>
            </div>
        }
        <footer class="billing__invoices-footer">
            <Typography TextStyle="TextStyle.Small12Regular" As="span">Showing 1–@_invoices.Count of @_invoices.Count</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="span">Page 1 of 1</Typography>
        </footer>
    </div>
</SettingsCard>

@code {
    private static readonly string[] InvoiceColumns = ["Invoice ID", "Amount", "Date created", "Status"];

    private sealed record UsageStat(string Value, string Label);
    private static readonly UsageStat[] UsageStats =
    [
        new("24,300", "Conversations used"),
        new("25,600", "Remaining"),
        new("8", "Active flows"),
        new("5", "Active AI agents")
    ];

    private sealed record Plan(string Name, string Price, string[] Features, bool Current = false, bool Primary = false);
    private static readonly Plan[] Plans =
    [
        new("Starter", "₦800,000",
            ["Up to 2 AI agents", "5,000 conversations/month", "Whatsapp channel only", "1,000 CRM contacts", "Basic automation flows", "Standard support"]),
        new("Growth", "₦2,000,000",
            ["Up to 10 AI agents", "50,000 conversations/month", "Multi-channel inbox", "10,000 CRM contacts", "Advanced automation flows", "Priority support"],
            Current: true),
        new("Scale", "₦3,500,000",
            ["Unlimited AI agents", "250,000 conversations/month", "Omnichannel support", "Unlimited CRM contacts", "Custom automation logic", "Dedicated account manager"],
            Primary: true)
    ];

    bool _yearly = true;
    private static readonly IReadOnlyList<SegmentedOption<bool>> Cycles = [new(false, "Monthly"), new(true, "Yearly")];

    record Invoice(string Id, string Amount, string Date, string Status, string StatusClass);

    List<Invoice> _invoices =
    [
        new("INV-2024-012", "₦7,000", "10 Oct, 2025 • 10:30 AM", "Pending", "pending"),
        new("INV-2024-011", "₦5,000", "12 Oct, 2025 • 10:30 AM", "Paid", "paid"),
        new("INV-2024-010", "₦15,000", "12 Oct, 2025 • 10:30 AM", "Paid", "paid"),
    ];
}
