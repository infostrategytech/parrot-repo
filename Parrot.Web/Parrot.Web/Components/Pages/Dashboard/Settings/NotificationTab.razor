@namespace Parrot.Web.Components.Pages.Dashboard.Settings

@* Which updates reach the inbox and which appear in the product. Each row
   is Aurora's Toggle with its label and description. *@
@inject Parrot.Web.Services.FeedbackService Feedback

<SettingsCard Title="Email notifications" Description="Choose which updates should be sent to your email.">
    <ChildContent>
        <div class="notifications__list">
            @foreach (var item in _emailNotifs)
            {
                <div class="notifications__row">
                    <Toggle Checked="@item.Enabled"
                            CheckedChanged="@(value => item.Enabled = value)"
                            Label="@item.Label"
                            Description="@item.Sub" />
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button>Save preference</Button>
    </Footer>
</SettingsCard>

<SettingsCard Title="In-app alerts" Description="Control alerts that appear inside your dashboard.">
    <ChildContent>
        <div class="notifications__list">
            <div class="notifications__row">
                @* Kept in this browser (localStorage) and applied at once, so it
                   needs no Save. *@
                <Toggle Checked="@_sounds"
                        CheckedChanged="SetSoundsAsync"
                        Label="Sounds &amp; haptics"
                        Description="Soft sounds for actions, new messages and results, with vibration on supported phones." />
            </div>
            @foreach (var item in _inAppNotifs)
            {
                <div class="notifications__row">
                    <Toggle Checked="@item.Enabled"
                            CheckedChanged="@(value => item.Enabled = value)"
                            Label="@item.Label"
                            Description="@item.Sub" />
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button>Save preference</Button>
    </Footer>
</SettingsCard>

@code {
    private bool _sounds = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _sounds = await Feedback.IsEnabledAsync();
        StateHasChanged();
    }

    private async Task SetSoundsAsync(bool value)
    {
        _sounds = value;
        await Feedback.SetEnabledAsync(value);
    }

    class NotifItem
    {
        public string Label { get; set; } = ""; public string Sub { get; set; } = ""; public bool Enabled
        {
            get; set;
        }
    }

    List<NotifItem> _emailNotifs =
    [
        new() { Label = "Weekly performance summary", Sub = "A digest of your AI agents performance and conversion metrics.",
Enabled = true },
        new() { Label = "Task request updates", Sub = "Alerts when new task requests are created by your AI.", Enabled = true },
        new() { Label = "Channel connection alerts", Sub = "Instant warnings if any of your connected channels disconnect.",Enabled = false },
        new() { Label = "Usage limit approaching", Sub = "Get notified when you are close to your conversation limit.", Enabled
= true },
        new() { Label = "Payment & billing updates", Sub = "Receive important billing and subscription notifications.", Enabled
= true },
    ];

    List<NotifItem> _inAppNotifs =
    [
        new() { Label = "Enable real-time alerts", Sub = "Show alerts inside the platform when important events occur.", Enabled
= true },
    ];
}
