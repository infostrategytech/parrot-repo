@page "/dashboard/settings"
@page "/dashboard/settings/{Tab}"
@layout Parrot.Web.Components.Layout.Settings.SettingsLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Settings

<PageTitle>@($"{Current.Label} · Settings · yára")</PageTitle>

@* One section at a time in Settings' own space (designer, 1 November 2026). Its name is the page's heading; the
   sections themselves are designed one by one next. *@
<header class="settings__head">
    <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@Current.Label</Typography>
    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@Current.Description</Typography>
</header>

<div class="settings__body">
    @switch (Current.Id)
    {
        case "appearance": <PreferencesSection />
            break;
        case "notifications": <NotificationsSection />
            break;
        case "security": <SecuritySection />
            break;
        case "business": <BusinessSection />
            break;
        case "team": <Parrot.Web.Components.Pages.Dashboard.Team.Team />
            break;
        case "payments": <PaymentsSection />
            break;
        case "billing": <BillingTab />
            break;
        case "activity": <ActivityLogSection />
            break;
        default: <ProfileTab />
            break;
    }
</div>

@code {
    [Parameter] public string? Tab { get; set; }
    [Inject] private AuthState AuthState { get; set; } = default!;

    // A section the person may not open (the business's, for a team member), even by its address, shows Profile.
    private SettingsSection Current => SettingsSections.For(Tab, rule => AuthState.CurrentUser?.Allows(rule) ?? false);
}
