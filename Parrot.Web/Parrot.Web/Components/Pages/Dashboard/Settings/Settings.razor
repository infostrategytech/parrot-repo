@page "/dashboard/settings"
@page "/dashboard/settings/{Tab}"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Settings
@using Parrot.Web.Components.Pages.Dashboard.Settings

<PageTitle>Settings · OmniAI</PageTitle>

@* Settings, one tab at a time. The tab tray is the same raised-pill control
   Aurora's Products page uses for its status filters. *@

<div class="settings">
    <header class="settings__header">
        <div class="settings__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Settings</Typography>
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="settings__lede">
                Your account, your workspace and how the product behaves for everyone in it.
            </Typography>
        </div>
    </header>

    <nav class="settings__tabs" role="tablist" aria-label="Settings sections">
        @foreach (var tab in Tabs)
        {
            var id = tab.Id;
            <button type="button"
                    role="tab"
                    aria-selected="@((ActiveTab == id).ToString().ToLowerInvariant())"
                    class="@(ActiveTab == id ? "settings__tab is-active" : "settings__tab")"
                    @onclick="() => SetTab(id)">
                <Icon Name="@tab.Glyph" Size="IconSize.Sm" />
                <Typography TextStyle="TextStyle.Small12Medium" As="span" Prose>@tab.Label</Typography>
            </button>
        }
    </nav>

    <div class="settings__body">
        @if (ActiveTab == "profile")
        {
            <ProfileTab />
        }
        @if (ActiveTab == "workspace")
        {
            <WorkspaceTab />
        }
        @if (ActiveTab == "automation")
        {
            <AutomationTab />
        }
        @if (ActiveTab == "security")
        {
            <SecurityTab />
        }
        @if (ActiveTab == "notification")
        {
            <NotificationTab />
        }
        @if (ActiveTab == "billing")
        {
            <BillingTab />
        }
    </div>
</div>

@code {
    [Parameter] public string? Tab { get; set; }

    private sealed record SettingsTab(string Id, string Label, IconName Glyph);

    private static readonly SettingsTab[] Tabs =
    [
        new("profile", "Profile", IconName.RiUser3Fill),
        new("workspace", "Workspace", IconName.RiStore2Fill),
        new("automation", "Automation", IconName.RiFlashlightFill),
        new("security", "Security", IconName.RiShieldCheckFill),
        new("notification", "Notification", IconName.RiAlarmWarningFill),
        new("billing", "Billing & Usage", IconName.RiRefund2Fill)
    ];

    string ActiveTab = "profile";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Tab)) ActiveTab = Tab.ToLower();
    }

    void SetTab(string tab) => ActiveTab = tab;
}
