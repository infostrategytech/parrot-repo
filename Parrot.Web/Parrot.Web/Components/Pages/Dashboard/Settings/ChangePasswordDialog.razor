@namespace Parrot.Web.Components.Pages.Dashboard.Settings
@using Parrot.Web.Features.Profile
@using Parrot.Web.Features.Settings
@using Parrot.Web.Features.Auth.ForgotPassword.Models
@using Parrot.Web.Features.Auth.ForgotPassword.Services
@using Parrot.Web.Features.Auth.ResetPassword.Services
@using Parrot.Web.Features.Auth.ResetPassword.State
@implements IDisposable
@inject ProfileClient Profile
@inject IForgotPasswordService ResetLinks
@inject IResetPasswordService ResetPasswords
@inject IPasswordResetPreview ResetPreview
@inject PasswordResetSignOut ResetSignOut
@inject AuroraInterop Interop
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject ToastService Toasts

@* Current-password change and email-verified recovery share a content surface, not a signed-out route.
   The email token is still required and checked by the same reset endpoint as the login-side flow. *@
<ContentModal Open="Open" Title="@ModalTitle" Subtitle="@(_sentTo is not null && _reset is null ? null : ModalSubtitle)" TitleVisuallyHidden="@(_sentTo is not null && _reset is null)"
              Busy="Busy" InitialFocusId="@InitialFocusId" FocusKey="@_focusRevision.ToString()"
              OnSubmit="ConfirmAsync" OnClose="CloseAsync">
    <ChildContent>
        <div class="password-change">
            @if (_reset is { Done: true })
            {
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose role="status">Your password has been changed. Sign out here to continue with your new password.</Typography>
            }
            else if (_reset is not null)
            {
                @if (!_reset.LinkSpent)
                {
                    <NewPasswordFields IdPrefix="security-reset" Password="@_reset.Password" PasswordChanged="_reset.SetPassword"
                                       Confirmation="@_reset.Confirmation" ConfirmationChanged="_reset.SetConfirmation"
                                       PasswordError="@_reset.PasswordError" ConfirmationError="@_reset.ConfirmationError" Disabled="Busy" />
                }
                @if (_reset.Error is not null)
                {
                    <div id="security-reset-error" tabindex="-1"><InlineError Message="@_reset.Error" /></div>
                }
            }
            else if (_sentTo is null)
            {
                <div class="password-change__current">
                    <PasswordInput Id="security-current-password" FloatingLabel="Current password" Value="@_current" ValueChanged="SetCurrent"
                                   ShowIcon="false" Disabled="Busy" ErrorText="@_currentError" HelperTextStyle="TextStyle.Small12Medium" />
                    <div class="password-change__forgot">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Busy="_sending" disabled="Busy" @onclick="SendResetAsync">Forgot your password?</Button>
                    </div>
                </div>
                <PasswordInput Id="security-new-password" FloatingLabel="New password" Value="@_new" ValueChanged="SetNew"
                               IsNew MaxLength="128" ShowIcon="false" Disabled="Busy" ErrorText="@_newError" HelperTextStyle="TextStyle.Small12Medium" />
                <PasswordInput Id="security-confirm-password" FloatingLabel="Confirm new password" Value="@_confirm" ValueChanged="SetConfirmation"
                               IsNew ShowStrength="false" MaxLength="128" ShowIcon="false" Disabled="Busy" ErrorText="@_confirmError" HelperTextStyle="TextStyle.Small12Medium" />
            }
            else
            {
                @* Sent (designer, 8 November 2026): the shared success layout, as Invite sent, with an envelope: the
                   inbox is the next step. Sending again, and the demo's link, sit quietly under it. *@
                <SuccessMessage Title="Check your email" TitleAs="p" Mark="IconName.RiMailFill"
                                Message="@($"We sent a link to {_sentTo}. Open it to choose a new password.")">
                    <div class="password-change__sent">
                        @if (_resent && _error is null)
                        {
                            <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="password-change__note" role="status">We sent you another reset link.</Typography>
                        }
                        <ResendButton SentRevision="_sentRevision" Busy="_sending" OnResend="SendResetAsync" Variant="ButtonVariant.Secondary" />
                        @if (ResetPreview.LinkFor(AuthState.CurrentUser?.UserId) is { } previewLink)
                        {
                            <div class="password-change__preview">
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => Navigation.NavigateTo(previewLink)">Open reset link</Button>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => CopyPreviewLinkAsync(previewLink)">Copy reset link</Button>
                            </div>
                        }
                    </div>
                </SuccessMessage>
            }
            @if (_error is not null) { <InlineError Message="@_error" /> }
        </div>
    </ChildContent>
    <Footer Context="formId">
        @if (_sentTo is null && _reset is not { Done: true })
        {
            <Button Variant="ButtonVariant.Secondary" disabled="Busy" @onclick="CloseAsync">Cancel</Button>
        }
        <Button id="@(_sentTo is not null || _reset is { Done: true } ? "password-reset-done" : "password-change-submit")"
                Type="ButtonType.Submit" form="@formId" Busy="@(_saving || _endingSession || _reset?.Busy == true || (_reset?.LinkSpent == true && _sending))" disabled="Busy">
            @SubmitLabel
        </Button>
    </Footer>
</ContentModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public PasswordResetLink? RecoveryLink { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string _current = "", _new = "", _confirm = "";
    private string? _error, _currentError, _newError, _confirmError, _sentTo;
    private bool _saving, _sending, _resent, _wasOpen, _disposed, _endingSession;
    private int _sentRevision;
    private PasswordResetFlow? _reset;
    private string _focusId = "security-current-password";
    private int _focusRevision;
    private bool Busy => _saving || _sending || _endingSession || _reset?.Busy == true;
    private string? Email => AuthState.CurrentUser?.Email is { Length: > 0 } email ? email : null;
    private string ModalTitle => _reset is { Done: true } ? "Password updated" : _reset is not null ? "Choose a new password" : _sentTo is null ? "Change password" : "Check your email";
    private string ModalSubtitle => _reset is { Done: true } ? "Sign in again with your new password." : _reset is not null ? "Use a password you don't use elsewhere."
        : _sentTo is null ? "Choose a password you don't use elsewhere." : $"We sent a link to {_sentTo}. Open it to choose a new password in yára.";
    private string InitialFocusId => _reset is { Done: true } || _sentTo is not null ? "password-reset-done" : _focusId;
    private string SubmitLabel => _endingSession ? "Signing out…" : _reset?.LinkSpent == true && _sending ? "Sending…" : _saving ? "Changing…" : _reset?.Busy == true ? "Saving…"
        : _reset is { Done: true } ? "Sign out and continue" : _sentTo is not null ? "Done" : _reset is { LinkSpent: true } ? "Send a new link" : _reset is not null ? "Save new password" : "Change password";
    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            Reset();
            if (RecoveryLink is { } link && PasswordResetHandoff.IsSameAccount(AuthState.CurrentUser?.UserId, link.UserId))
            {
                _reset = new(ResetPasswords, link.UserId, link.Token);
                _focusId = _reset.LinkSpent ? "security-reset-error" : "security-reset-new-password";
            }
        }
        if (!Open && !Busy) Reset();
        _wasOpen = Open;
    }
    private void Reset()
    {
        _current = _new = _confirm = ""; _reset?.ClearSecrets(); _reset = null;
        _sentTo = null; _resent = false; _sentRevision = 0; _focusId = "security-current-password"; ClearErrors();
    }
    private void ClearErrors() => _error = _currentError = _newError = _confirmError = null;
    private void SetCurrent(string? value) { if (Busy) return; if (_new == _current) _newError = null; _current = value ?? ""; _currentError = _error = null; }
    private void SetNew(string? value) { if (Busy) return; _new = value ?? ""; _newError = _confirmError = _error = null; }
    private void SetConfirmation(string? value) { if (Busy) return; _confirm = value ?? ""; _confirmError = _error = null; }
    private void Focus(string id) { _focusId = id; _focusRevision++; }
    private async Task CloseAsync() { if (Busy) return; if (_reset is { Done: true }) { await EndResetSessionAsync(); return; } Reset(); await OnClose.InvokeAsync(); }
    private Task ConfirmAsync() => _reset is { Done: true } ? EndResetSessionAsync() : _sentTo is not null ? CloseAsync()
        : _reset is { LinkSpent: true } ? SendResetAsync() : _reset is not null ? ResetPasswordAsync() : ChangeAsync();

    private async Task SendResetAsync()
    {
        if (Busy || _disposed) return;
        if (Email is not { } email) { _error = "Sign in again to reset your password."; return; }
        _sending = true; _error = null;
        var again = _sentTo is not null;
        try
        {
            await ResetLinks.ForgotPasswordAsync(new ForgotPasswordRequest { Email = email });
            if (_disposed) return;
            _current = _new = _confirm = ""; _reset?.ClearSecrets(); _reset = null;
            _currentError = _newError = _confirmError = null; _sentTo = email; _resent = again; _sentRevision++;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        { _error = "Too many attempts. Wait a few minutes, then try again."; }
        catch (HttpRequestException ex) when (ex.StatusCode is null)
        { _error = "We could not reach yára. Check your internet connection and try again."; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        { _error = "The link couldn't be sent. Try again in a moment."; }
        finally { _sending = false; }
    }
    private async Task CopyPreviewLinkAsync(string link)
    {
        try
        {
            if (await Interop.TryCopyAsync(Navigation.ToAbsoluteUri(link).AbsoluteUri)) { _error = null; Toasts.Show("Reset link copied"); }
            else _error = "The link couldn't be copied. Use Open reset link instead.";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        { _error = "The link couldn't be copied. Use Open reset link instead."; }
    }
    private async Task ResetPasswordAsync()
    {
        var flow = _reset;
        if (flow is null || Busy || _disposed) return;
        await flow.SubmitAsync();
        if (_disposed) { flow.ClearSecrets(); return; }
        if (flow.Done) { await EndResetSessionAsync(); return; }
        Focus(flow.LinkSpent || flow.Error is not null ? "security-reset-error"
            : flow.PasswordError is not null ? "security-reset-new-password" : "security-reset-confirm-password");
    }
    private async Task EndResetSessionAsync()
    {
        if (Busy || _disposed || _reset is not { Done: true }) return;
        _endingSession = true; _error = null;
        try { await ResetSignOut.CompleteAsync(); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        { _error = "Your password changed, but we couldn't clear this browser's saved sign-in. Try signing out again."; Focus("password-reset-done"); }
        finally { _endingSession = false; }
    }
    private async Task ChangeAsync()
    {
        if (Busy || !Open || _disposed) return;
        ClearErrors();
        if (SecurityText.NewPasswordProblem(_current, _new, _confirm) is { } problem)
        {
            if (_current.Length == 0) { _currentError = problem; Focus("security-current-password"); }
            else if (!SecurityText.NewPasswordMeetsRules(_new)) { _newError = problem; Focus("security-new-password"); }
            else if (_new != _confirm) { _confirmError = problem; Focus("security-confirm-password"); }
            else { _newError = problem; Focus("security-new-password"); }
            return;
        }
        _saving = true;
        try
        {
            await Profile.ChangePasswordAsync(_current, _new, _confirm);
            Reset();
            if (_disposed) return;
            Toasts.Show("Password changed"); await OnClose.InvokeAsync();
        }
        catch (ApiException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.BadRequest &&
                (ex.UserMessage.Equals("Current password is incorrect.", StringComparison.OrdinalIgnoreCase)
                 || ex.UserMessage.Equals("Your current password isn't right.", StringComparison.OrdinalIgnoreCase)
                 || ex.ErrorCode == "PasswordMismatch"))
            { _currentError = ex.UserMessage; Focus("security-current-password"); }
            else _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        { _error = "Your password couldn't be changed. Check your connection and try again."; }
        finally { _saving = false; }
    }
    public void Dispose() { _disposed = true; _current = _new = _confirm = ""; _reset?.ClearSecrets(); _reset = null; }
}
