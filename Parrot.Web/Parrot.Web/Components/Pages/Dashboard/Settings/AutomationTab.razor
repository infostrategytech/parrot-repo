@namespace Parrot.Web.Components.Pages.Dashboard.Settings

@* System-wide automation limits. Three sub-sections in muted wells, each
   with one SelectField, as Aurora's editor groups related fields. *@

<SettingsCard Title="Automation" Description="Control system-wide automation behavior.">
    <ChildContent>
        <div class="automation__sections">
            <section class="automation__section">
                <div class="automation__titles">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Conversation limits</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Prevent excessive usage from a single customer.</Typography>
                </div>
                <SelectField FloatingLabel="Max messages per customer per day"
                             Value="@_maxMessages"
                             HelperText="Prevents a single customer from consuming excessive conversations."
                             Open='@(_openMenu == "messages")'
                             OpenChanged="@(open => _openMenu = open ? "messages" : null)">
                    @foreach (var option in MaxMessagesOptions)
                    {
                        <PopoverOption Label="@option"
                                       Active="@(_maxMessages == option)"
                                       OnSelect="@(() => { _maxMessages = option; _openMenu = null; })" />
                    }
                </SelectField>
            </section>

            <section class="automation__section">
                <div class="automation__titles">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Conversation timeout</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Automatically close idle conversations.</Typography>
                </div>
                <SelectField FloatingLabel="Close conversation after inactivity (minutes)"
                             Value="@_timeout"
                             Open='@(_openMenu == "timeout")'
                             OpenChanged="@(open => _openMenu = open ? "timeout" : null)">
                    @foreach (var option in TimeoutOptions)
                    {
                        <PopoverOption Label="@option"
                                       Active="@(_timeout == option)"
                                       OnSelect="@(() => { _timeout = option; _openMenu = null; })" />
                    }
                </SelectField>
            </section>

            <section class="automation__section">
                <div class="automation__titles">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Usage protection</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Pause AI responses when approaching limits.</Typography>
                </div>
                <SelectField FloatingLabel="Pause AI responses when workspace reaches (% of conversation limit)"
                             Value="@_pauseAt"
                             Open='@(_openMenu == "pause")'
                             OpenChanged="@(open => _openMenu = open ? "pause" : null)">
                    @foreach (var option in PauseOptions)
                    {
                        <PopoverOption Label="@option"
                                       Active="@(_pauseAt == option)"
                                       OnSelect="@(() => { _pauseAt = option; _openMenu = null; })" />
                    }
                </SelectField>
            </section>
        </div>
    </ChildContent>
    <Footer>
        <Button>Save changes</Button>
    </Footer>
</SettingsCard>

@code {
    private static readonly string[] MaxMessagesOptions = ["51", "25", "100"];
    private static readonly string[] TimeoutOptions = ["30", "15", "60"];
    private static readonly string[] PauseOptions = ["80", "70", "90"];

    private string _maxMessages = MaxMessagesOptions[0];
    private string _timeout = TimeoutOptions[0];
    private string _pauseAt = PauseOptions[0];
    private string? _openMenu;
}
