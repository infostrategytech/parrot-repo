@page "/dashboard/business-setup"
@attribute [RequiresAccess(AccessRules.Business)]
@layout Parrot.Web.Components.Layout.Dashboard.DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.BusinessSetup
@using Parrot.Web.Components.Pages.Dashboard.AiAgents
@using Parrot.Web.Components.Pages.Dashboard.BusinessSetup.Services
@using Parrot.Web.Features.Auth.State
@inject NavigationManager Nav
@inject AgentGate AgentGate
@inject IBusinessSetupService BusinessSetupService
@inject AuthState AuthState

<PageTitle>Business setup · yára</PageTitle>

@* Three steps in one full-page card: Aurora's guided setup shell (header
   with a counter, a progress bar, a body held to a reading width, a footer
   with the one next thing to do), with Parrot's business form inside it. *@

<div class="setup">
    @if (_done)
    {
        <section class="guided">
            <div class="guided__body guided__body--centred">
                <span class="guided__success-icon"><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Lg" /></span>
                <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@_org.Name is ready!</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                    Your organization has been set up@(_org.EmployedAgents.Count > 0
                        ? $" with {_org.EmployedAgents.Count} agent{(_org.EmployedAgents.Count == 1 ? "" : "s")} employed"
                        : "").
                    Head to the overview or start managing your agents.
                </Typography>
                <div class="guided__success-actions">
                    <Button Variant="ButtonVariant.Secondary" @onclick="@(() => Nav.NavigateTo("/dashboard"))">Go to overview</Button>
                    <Button @onclick="@(() => Nav.NavigateTo("/dashboard/ai-operations"))">
                        <ChildContent>View AI agents</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="guided">
            <header class="guided__header">
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="Back">
                    <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                    <ChildContent>@(_step == 1 ? "Back to overview" : "Back")</ChildContent>
                </Button>
                <div class="guided__counter">
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">Business setup · @GetStepLabel(_step)</Typography>
                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Step @_step of 3</Typography>
                </div>
            </header>

            <div class="guided__progress" role="progressbar" aria-valuenow="@_step" aria-valuemin="1" aria-valuemax="3">
                <i style="width: @(_step * 100 / 3)%"></i>
            </div>

            @* ── Step 1: Business information ── *@
            @if (_step == 1)
            {
                <div class="guided__body">
                    <Typography TextStyle="TextStyle.Small10Semibold" As="p" Class="guided__eyebrow ds-overline">Organization details</Typography>
                    <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Tell us about your business</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        So we can personalize your workspace and let agents greet customers with the right context.
                    </Typography>

                    <div class="setup__grid">
                        <Input FloatingLabel="Organization name"
                               @bind-Value="_org.Name"
                               maxlength="120"
                               required
                               Error="@(_showErrors && string.IsNullOrWhiteSpace(_org.Name))"
                               HelperText="@(_showErrors && string.IsNullOrWhiteSpace(_org.Name) ? "Organization name is required." : null)" />

                        <SelectField FloatingLabel="Industry"
                                     Value="@(string.IsNullOrEmpty(_org.Industry) ? null : _org.Industry)"
                                     Error="@(_showErrors && string.IsNullOrWhiteSpace(_org.Industry))"
                                     HelperText="@(_showErrors && string.IsNullOrWhiteSpace(_org.Industry) ? "Industry is required." : null)"
                                     Open='@(_openMenu == "industry")'
                                     OpenChanged="@(open => _openMenu = open ? "industry" : null)">
                            @foreach (var ind in BusinessIndustries.All)
                            {
                                <PopoverOption Label="@ind" Active="@(_org.Industry == ind)"
                                               OnSelect="@(() => { _org.Industry = ind; _openMenu = null; })" />
                            }
                        </SelectField>

                        <SelectField FloatingLabel="Business size"
                                     Value="@(string.IsNullOrEmpty(_org.Size) ? null : _org.Size)"
                                     Open='@(_openMenu == "size")'
                                     OpenChanged="@(open => _openMenu = open ? "size" : null)">
                            @foreach (var sz in BusinessSizes.All)
                            {
                                <PopoverOption Label="@sz" Active="@(_org.Size == sz)"
                                               OnSelect="@(() => { _org.Size = sz; _openMenu = null; })" />
                            }
                        </SelectField>

                        <SelectField FloatingLabel="Country / Region"
                                     Value="@(string.IsNullOrEmpty(_org.Country) ? null : _org.Country)"
                                     Open='@(_openMenu == "country")'
                                     OpenChanged="@(open => _openMenu = open ? "country" : null)">
                            @foreach (var c in _countries)
                            {
                                <PopoverOption Label="@c" Active="@(_org.Country == c)"
                                               OnSelect="@(() => { _org.Country = c; _openMenu = null; })" />
                            }
                        </SelectField>

                        <label class="setup__full">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Business description <Typography TextStyle="TextStyle.Small12Regular" As="small" Class="setup__optional">(Optional)</Typography></Typography>
                            <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                                      rows="3"
                                      placeholder="Brief overview of what your business does and who you serve…"
                                      value="@_org.Description"
                                      @oninput="e => _org.Description = e.Value?.ToString() ?? string.Empty" />
                        </label>

                        <Input FloatingLabel="Business email" Type="email" maxlength="200" @bind-Value="_org.BusinessEmail"
                               Error="@(EmailAdvice is not null)" HelperText="@EmailAdvice" />
                        <Input FloatingLabel="Phone number" Numeric="NumericInputKind.Phone" maxlength="20" @bind-Value="_org.PhoneNumber"
                               Error="@(PhoneAdvice is not null)" HelperText="@PhoneAdvice" />

                        <div class="setup__full">
                            <Input FloatingLabel="Website" Type="url" @bind-Value="_org.Website" />
                        </div>
                    </div>

                    <section class="setup__social">
                        <button type="button" class="setup__social-toggle" aria-expanded="@_showSocial.ToString().ToLowerInvariant()"
                                @onclick="() => _showSocial = !_showSocial">
                            <span class="setup__social-icon"><Icon Name="IconName.RiGlobalFill" Size="IconSize.Sm" /></span>
                            <span class="setup__social-text">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Social media presence</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>Optional — we use these to pull context for your profile.</Typography>
                            </span>
                            <Icon Name="@(_showSocial ? IconName.RiArrowDownSLine : IconName.RiArrowRightSLine)" Size="IconSize.Sm" />
                        </button>

                        @if (_showSocial)
                        {
                            <div class="setup__grid setup__social-grid">
                                @* Input is self-closing in Razor (it shares its name with the
                                   HTML void element), so the marks travel as fragments. *@
                                <Input FloatingLabel="Facebook" PrefixText="facebook.com/" IconLeft="FacebookMark" @bind-Value="_org.SocialMedia.Facebook" />
                                <Input FloatingLabel="Instagram" PrefixText="@("@")" IconLeft="InstagramMark" @bind-Value="_org.SocialMedia.Instagram" />
                                <Input FloatingLabel="X (Twitter)" PrefixText="@("@")" IconLeft="GlobeMark" @bind-Value="_org.SocialMedia.TwitterX" />
                                <Input FloatingLabel="LinkedIn" PrefixText="linkedin.com/company/" IconLeft="GlobeMark" @bind-Value="_org.SocialMedia.LinkedIn" />
                                <Input FloatingLabel="WhatsApp Business" PrefixText="+" Numeric="NumericInputKind.Phone" maxlength="20" IconLeft="WhatsappMark" @bind-Value="_org.SocialMedia.WhatsApp"
                                       Error="@(WhatsAppAdvice is not null)" HelperText="@WhatsAppAdvice" />
                                <Input FloatingLabel="YouTube" PrefixText="@("youtube.com/@")" IconLeft="GlobeMark" @bind-Value="_org.SocialMedia.YouTube" />
                                <Input FloatingLabel="TikTok" PrefixText="@("@")" IconLeft="GlobeMark" @bind-Value="_org.SocialMedia.TikTok" />
                            </div>
                        }
                    </section>

                    <aside class="guided__aside">
                        <Icon Name="IconName.RiInformationFill" Size="IconSize.Sm" />
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>
                            Your business details help personalize AI responses, set your workspace timezone, and let agents greet
                            customers with the right context. You can update these anytime from
                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Settings → Business profile</Typography>.
                        </Typography>
                    </aside>
                </div>

                <footer class="guided__footer">
                    <Button Variant="ButtonVariant.Secondary" disabled="@_enriching" @onclick="@(() => Nav.NavigateTo("/dashboard"))">Cancel</Button>
                    <div class="guided__footer-actions">
                        @* Enrichment is a network call that can outlast a glance, so
                           what is happening is said beside the button while it waits;
                           the button itself keeps its label and draws the brand's
                           relay dots. *@
                        @if (_enriching)
                        {
                            <Typography TextStyle="TextStyle.Small12Regular" As="span" Class="guided__footer-note" role="status">
                                Pulling context from your website &amp; socials…
                            </Typography>
                        }
                        <Button Busy="@_enriching" @onclick="GoToStep2">
                            <ChildContent>Continue — Review profile</ChildContent>
                            <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                        </Button>
                    </div>
                </footer>
            }

            @* ── Step 2: Review business profile ── *@
            @if (_step == 2)
            {
                <div class="guided__body">
                    <Typography TextStyle="TextStyle.Small10Semibold" As="p" Class="guided__eyebrow ds-overline">Review profile</Typography>
                    <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Review your business profile</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        We pulled this from @(_org.Name)'s website and social profiles. Check it over and edit anything before continuing.
                    </Typography>

                    @if (_enrichmentResult is not null && _enrichmentResult.SourcesUsed.Count > 0)
                    {
                        <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="setup__sources">
                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Pulled from:</Typography>
                            @string.Join(", ", _enrichmentResult.SourcesUsed)
                        </Typography>
                    }
                    @if (_enrichmentResult is not null)
                    {
                        @foreach (var warning in _enrichmentResult.Warnings)
                        {
                            <InlineError Message="@warning" Tone="InlineErrorTone.Warning" />
                        }
                    }

                    <div class="setup__grid">
                        <label class="setup__full">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Business description</Typography>
                            <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                                      rows="3"
                                      placeholder="Brief overview of what your business does and who it serves…"
                                      value="@_org.Description"
                                      @oninput="e => _org.Description = e.Value?.ToString() ?? string.Empty" />
                        </label>

                        <div class="setup__field">
                            <SelectField FloatingLabel="Industry"
                                         Value="@(string.IsNullOrEmpty(_org.Industry) ? null : _org.Industry)"
                                         Open='@(_openMenu == "industry")'
                                         OpenChanged="@(open => _openMenu = open ? "industry" : null)">
                                @foreach (var ind in BusinessIndustries.All)
                                {
                                    <PopoverOption Label="@ind" Active="@(_org.Industry == ind)"
                                                   OnSelect="@(() => { _org.Industry = ind; _openMenu = null; })" />
                                }
                            </SelectField>
                            @if (!string.IsNullOrWhiteSpace(_enrichmentResult?.SuggestedIndustry) && _enrichmentResult.SuggestedIndustry != _org.Industry)
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => _org.Industry = _enrichmentResult.SuggestedIndustry">
                                    <IconLeft><Icon Name="IconName.RiSparklingFill" /></IconLeft>
                                    <ChildContent>AI suggests "@_enrichmentResult.SuggestedIndustry" — use this</ChildContent>
                                </Button>
                            }
                        </div>

                        <div class="setup__field">
                            <SelectField FloatingLabel="Business size"
                                         Value="@(string.IsNullOrEmpty(_org.Size) ? null : _org.Size)"
                                         Open='@(_openMenu == "size")'
                                         OpenChanged="@(open => _openMenu = open ? "size" : null)">
                                @foreach (var sz in BusinessSizes.All)
                                {
                                    <PopoverOption Label="@sz" Active="@(_org.Size == sz)"
                                                   OnSelect="@(() => { _org.Size = sz; _openMenu = null; })" />
                                }
                            </SelectField>
                            @if (!string.IsNullOrWhiteSpace(_enrichmentResult?.SuggestedSize) && _enrichmentResult.SuggestedSize != _org.Size)
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => _org.Size = _enrichmentResult.SuggestedSize">
                                    <IconLeft><Icon Name="IconName.RiSparklingFill" /></IconLeft>
                                    <ChildContent>AI suggests "@_enrichmentResult.SuggestedSize" — use this</ChildContent>
                                </Button>
                            }
                        </div>

                        <div class="setup__full">
                            <Input FloatingLabel="Brand voice" HelperText="Optional — e.g. friendly and casual, professional and concise" @bind-Value="_org.BrandVoice" />
                        </div>

                        @if (_org.KeyFacts.Count > 0)
                        {
                            <div class="setup__full setup__facts-wrap">
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Key facts</Typography>
                                <ul class="setup__facts">
                                    @foreach (var fact in _org.KeyFacts.ToList())
                                    {
                                        <li class="setup__fact">
                                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Prose>@fact</Typography>
                                            <button type="button" class="setup__fact-remove" aria-label="@($"Remove {fact}")" @onclick="() => _org.KeyFacts.Remove(fact)">
                                                <Icon Name="IconName.RiCloseFill" Size="IconSize.Sm" />
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <label class="setup__full">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Additional context <Typography TextStyle="TextStyle.Small12Regular" As="small" Class="setup__optional">(Optional)</Typography></Typography>
                            <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                                      rows="3"
                                      placeholder="Anything else your agents should know — promotions, policies, FAQs, tone guidance…"
                                      value="@_org.ExtraContext"
                                      @oninput="e => _org.ExtraContext = e.Value?.ToString() ?? string.Empty" />
                        </label>
                    </div>
                </div>

                <footer class="guided__footer">
                    <Button Variant="ButtonVariant.Secondary" @onclick="() => _step = 1">
                        <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                        <ChildContent>Back</ChildContent>
                    </Button>
                    <Button @onclick="() => _step = 3">
                        <ChildContent>Continue — Employ agents</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                </footer>
            }

            @* ── Step 3: Employ agents ── *@
            @if (_step == 3)
            {
                <div class="guided__body">
                    <Typography TextStyle="TextStyle.Small10Semibold" As="p" Class="guided__eyebrow ds-overline">Employ agents</Typography>
                    <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Employ agents under @_org.Name</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        Assign AI agents to handle conversations for this organization. You can add more later.
                    </Typography>

                    <div class="setup__agents">
                        @foreach (var agent in _availableAgents)
                        {
                            var a = agent;
                            var isSelected = _selectedAgentIds.Contains(a.Id);
                            <button type="button"
                                    class="@(isSelected ? "setup__agent is-selected" : "setup__agent")"
                                    aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                                    @onclick="() => ToggleAgent(a.Id)">
                                <PetalAvatar Seed="@a.Id" Initials="@Initials.From(a.Name)" Size="AvatarSize.Md" />
                                <span class="setup__agent-text">
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@a.Name</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="small">@a.Mascot</Typography>
                                </span>
                                <StatusBadge Tone="@(a.IsActive ? StatusTone.Success : StatusTone.Neutral)">@(a.IsActive ? "Live" : "Draft")</StatusBadge>
                                @if (isSelected)
                                {
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                }
                            </button>
                        }

                        <button type="button" class="setup__agent setup__agent--new" @onclick="CreateNewAgent">
                            <span class="setup__agent-new-icon"><Icon Name="IconName.RiAddFill" Size="IconSize.Md" /></span>
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Create new agent</Typography>
                        </button>
                    </div>

                    @if (_selectedAgentIds.Count > 0)
                    {
                        <section class="setup__roles">
                            <div class="setup__roles-titles">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Assign roles</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Define what each agent is responsible for within this organization.</Typography>
                            </div>
                            <div class="setup__role-list">
                                @foreach (var id in _selectedAgentIds)
                                {
                                    var agentId = id;
                                    var agentName = _availableAgents.FirstOrDefault(a => a.Id == agentId)?.Name ?? agentId;
                                    if (!_agentRoles.ContainsKey(agentId)) _agentRoles[agentId] = string.Empty;
                                    <div class="setup__role">
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@agentName</Typography>
                                        <SelectField FloatingLabel="Role"
                                                     Value="@(string.IsNullOrEmpty(_agentRoles[agentId]) ? null : _agentRoles[agentId])"
                                                     Open='@(_openMenu == "role-" + agentId)'
                                                     OpenChanged="@(open => _openMenu = open ? "role-" + agentId : null)">
                                            @foreach (var role in AgentRoles.All)
                                            {
                                                <PopoverOption Label="@role" Active="@(_agentRoles[agentId] == role)"
                                                               OnSelect="@(() => { _agentRoles[agentId] = role; _openMenu = null; })" />
                                            }
                                        </SelectField>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    else
                    {
                        <aside class="guided__aside">
                            <Icon Name="IconName.RiInformationFill" Size="IconSize.Sm" />
                            <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>
                                Select one or more agents above to assign them to <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@_org.Name</Typography>.
                                You can also skip this step and add agents later from the Agents page.
                            </Typography>
                        </aside>
                    }
                </div>

                <footer class="guided__footer">
                    <Button Variant="ButtonVariant.Secondary" disabled="@_saving" @onclick="() => _step = 2">
                        <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                        <ChildContent>Back</ChildContent>
                    </Button>
                    <div class="guided__footer-actions">
                        <Button Variant="ButtonVariant.Ghost" disabled="@_saving" @onclick="SkipAndFinish">Skip for now</Button>
                        <Button Busy="@_saving" disabled="@(_selectedAgentIds.Count == 0)" @onclick="Finish">
                            <ChildContent>Finish setup</ChildContent>
                            <IconRight><Icon Name="IconName.RiCheckFill" /></IconRight>
                        </Button>
                    </div>
                </footer>
            }
        </section>
    }
</div>

@code {
    private int _step = 1;
    private bool _done;
    private bool _saving;
    private bool _showErrors;
    private bool _showSocial;
    private bool _enriching;
    private string? _openMenu;
    private BusinessEnrichmentResult? _enrichmentResult;

    private BusinessOrganization _org = new();
    private HashSet<string> _selectedAgentIds = new();
    private Dictionary<string, string> _agentRoles = new();

    private readonly List<AiAgent> _availableAgents = new()
    {
        new AiAgent { Id = "1", Name = "Bakerbot",  Mascot = "Nova",  IsActive = true,  MessagesToday = 38 },
        new AiAgent { Id = "2", Name = "SalesBot",  Mascot = "Atlas", IsActive = true,  MessagesToday = 12 },
        new AiAgent { Id = "3", Name = "SupportAI", Mascot = "Bolt",  IsActive = false, MessagesToday = 0  },
        new AiAgent { Id = "4", Name = "LeadGen",   Mascot = "Aegis", IsActive = true,  MessagesToday = 7  },
        new AiAgent { Id = "5", Name = "Buzzy",     Mascot = "Buzz",  IsActive = false, MessagesToday = 0  },
        new AiAgent { Id = "6", Name = "LunaBot",   Mascot = "Luna",  IsActive = true,  MessagesToday = 21 },
    };

    private static readonly string[] _countries =
    [
        "Nigeria", "Ghana", "Kenya", "South Africa", "United States", "United Kingdom",
        "Canada", "Australia", "India", "Germany", "France", "Brazil", "Singapore", "Other"
    ];

    // Brand marks for the social fields. X, LinkedIn, YouTube and TikTok have
    // no glyph in the sprite, so they share the globe.
    private static readonly RenderFragment FacebookMark = @<Icon Name="IconName.RiFacebookCircleFill" Class="setup__brand-facebook" />;
    private static readonly RenderFragment InstagramMark = @<Icon Name="IconName.RiInstagramFill" Class="setup__brand-instagram" />;
    private static readonly RenderFragment WhatsappMark = @<Icon Name="IconName.RiWhatsappFill" Class="setup__brand-whatsapp" />;
    private static readonly RenderFragment GlobeMark = @<Icon Name="IconName.RiGlobalFill" />;

    private static string GetStepLabel(int step) => step switch
    {
        1 => "Business info",
        2 => "Review profile",
        _ => "Employ agents",
    };

    private void Back()
    {
        if (_step == 1) Nav.NavigateTo("/dashboard");
        else _step--;
    }

    // The contact details, checked as every screen checks them (ContactText): only when filled in, and only
    // once Continue is pressed (designer, 28 October 2026).
    private string? EmailAdvice => _showErrors && !string.IsNullOrWhiteSpace(_org.BusinessEmail) && !ContactText.IsEmail(_org.BusinessEmail) ? ContactText.EmailAdvice : null;
    private string? PhoneAdvice => _showErrors ? ContactText.Phone(_org.PhoneNumber).Advice : null;
    // The field shows its own +, so the number in it is read with one.
    private string? WhatsAppAdvice => _showErrors && !string.IsNullOrWhiteSpace(_org.SocialMedia.WhatsApp)
        ? ContactText.Phone("+" + _org.SocialMedia.WhatsApp.Trim().TrimStart('+')).Advice : null;

    private async Task GoToStep2()
    {
        _showErrors = true;
        if (string.IsNullOrWhiteSpace(_org.Name) || string.IsNullOrWhiteSpace(_org.Industry)
            || EmailAdvice is not null || PhoneAdvice is not null || WhatsAppAdvice is not null)
            return;
        _showErrors = false;

        string? token = AuthState.CurrentUser?.Token;
        if (!string.IsNullOrEmpty(token) && HasAnyEnrichmentSource())
        {
            _enriching = true;
            StateHasChanged();

            try
            {
                BusinessEnrichmentRequest request = new()
                {
                    Website = _org.Website,
                    Facebook = _org.SocialMedia.Facebook,
                    Instagram = _org.SocialMedia.Instagram,
                    TwitterX = _org.SocialMedia.TwitterX,
                    LinkedIn = _org.SocialMedia.LinkedIn,
                    YouTube = _org.SocialMedia.YouTube,
                    TikTok = _org.SocialMedia.TikTok,
                };

                _enrichmentResult = await BusinessSetupService.EnrichAsync(request, token);
                ApplyEnrichmentResult();
            }
            catch (Exception)
            {
                _enrichmentResult = new BusinessEnrichmentResult
                {
                    Warnings = { "Couldn't reach the enrichment service — you can still fill this in manually." },
                };
            }
            finally
            {
                _enriching = false;
            }
        }

        _step = 2;
    }

    private bool HasAnyEnrichmentSource() =>
        !string.IsNullOrWhiteSpace(_org.Website) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.Facebook) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.Instagram) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.TwitterX) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.LinkedIn) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.YouTube) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.TikTok);

    private void ApplyEnrichmentResult()
    {
        if (_enrichmentResult is null)
            return;

        if (string.IsNullOrWhiteSpace(_org.Description) && !string.IsNullOrWhiteSpace(_enrichmentResult.Description))
            _org.Description = _enrichmentResult.Description;

        _org.BrandVoice = _enrichmentResult.BrandVoice;
        _org.KeyFacts = new List<string>(_enrichmentResult.KeyFacts);
    }

    private void ToggleAgent(string id)
    {
        if (!_selectedAgentIds.Add(id))
            _selectedAgentIds.Remove(id);
    }

    // As on the dashboard: a connected channel, then "Teach your AI", then setup.
    private Task CreateNewAgent() => AgentGate.RequireAsync(() =>
    {
        Nav.NavigateTo("/dashboard/ai-operations?new=1");
        return Task.CompletedTask;
    });

    private async Task Finish()
    {
        _saving = true;
        StateHasChanged();
        await Task.Delay(800);

        foreach (var id in _selectedAgentIds)
        {
            var agent = _availableAgents.FirstOrDefault(a => a.Id == id);
            if (agent is null) continue;
            _org.EmployedAgents.Add(new EmployedAgent
            {
                AgentId   = id,
                AgentName = agent.Name,
                Mascot    = agent.Mascot,
                Role      = _agentRoles.TryGetValue(id, out var r) ? r : string.Empty
            });
        }

        _saving = false;
        _done   = true;
    }

    private void SkipAndFinish() => _done = true;
}
