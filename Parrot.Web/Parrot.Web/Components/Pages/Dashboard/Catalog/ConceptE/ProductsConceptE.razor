    private async Task<string?> SaveComposedAsync(CatalogEntry entry, bool asDraft)
    {
        if (!asDraft && CatalogReadiness.Issue(entry) is { } issue) return issue;
        if (string.IsNullOrWhiteSpace(entry.Name)) return "Give it a name.";
        entry.Status = asDraft ? CatalogStatus.Draft : CatalogStatus.Live;
        if (!asDraft) entry.EditorDraft = null;
        var isNew = string.IsNullOrEmpty(entry.Id) || _items.All(item => item.Id != entry.Id);
        try
        {
            if (isNew) entry = await Store.CreateAsync(entry);
            else await Store.SaveAsync(entry);
            await AddCategoryAsync(entry.Group);
            await LoadAsync();
        }
        catch (CatalogPhotoException)
        {
            // A photo that couldn't go with it: the form says which, and marks it.
            throw;
        }
        catch (ApiException exception) when (exception.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.Forbidden)
        {
            // The service's own reason (a price missing, no permission to make it live) says what to fix.
            return exception.UserMessage;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            return $"We couldn't save {entry.Name}. Check your connection and try again.";
        }

        BackToList();
        _search = _category = null;
        ChangeView(asDraft ? ItemView.Drafts : ItemView.All);
        Toasts.Show(asDraft
            ? $"{entry.Name} is saved in Drafts. Your agent won't use it yet."
            : isNew ? $"{entry.Name} is added." : $"{entry.Name} is updated.");
        StateHasChanged();
        return null;
    }

    /// <summary>One reviewed item: saved (or the item it updates), staying on the review until all are.</summary>
    private async Task<string?> SaveReviewedAsync(CatalogEntry entry, bool asDraft)
    {
        if (CatalogReadiness.Issue(entry) is { } issue) return issue;
        entry.Status = CatalogStatus.Live;
        entry.EditorDraft = null;
        var isNew = string.IsNullOrEmpty(entry.Id) || _items.All(item => item.Id != entry.Id);
        try
        {
            if (isNew) entry = await Store.CreateAsync(entry);
            else await Store.SaveAsync(entry);
            if (isNew) _justAdded.Add(entry.Id);
            else _justUpdated.Add(entry.Id);
            await AddCategoryAsync(entry.Group);
            await LoadAsync();
        }
        catch (CatalogPhotoException photo)
        {
            // Said on the review queue, by item and photo, so it can be opened and the photo removed.
            return $"{entry.Name}: photo {photo.Number} couldn't be saved. {photo.Reason}";
        }
        catch (ApiException exception) when (exception.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.Forbidden)
        {
            // The service's own reason (a price missing, no permission to make it live) says what to fix.
            return exception.UserMessage;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            return $"We couldn't save {entry.Name}. Check your connection and try again.";
        }
        return null;
    }

    private async Task ReviewDoneAsync(IReadOnlyList<CatalogEntry> saved)
    {
        BackToList();
        await LoadAsync();
        var updated = saved.Count(entry => entry.Id.Length > 0);
        Done(saved.Count - updated, updated);
        StateHasChanged();
    }

    // All items have been reviewed and are complete before entering the catalogue.
    private void Done(int added, int updated)
    {
        var parts = new List<string>();
        if (added > 0) parts.Add($"{Plural(added)} added");
        if (updated > 0) parts.Add($"{Plural(updated)} updated");
        if (parts.Count == 0) parts.Add("Nothing added");
        var line = string.Join(", ", parts) + ".";
        line = char.ToUpperInvariant(line[0]) + line[1..];
        ChangeView(ItemView.All);
        Toasts.Show(line);
    }

    // ── Deleting ───────────────────────────────────────────────────────────

    private string DeleteTitle => _pendingDelete switch
    {
        { Count: 1 } one => $"Delete {one[0].Name}?",
        { Count: > 1 } many => $"Delete {many.Count} items?",
        _ => "Delete?",
    };

    private async Task DeleteAsync()
    {
        if (_pendingDelete is not { Count: > 0 } items || _deleting) return;
        _deleting = true;
        try
        {
            foreach (var item in items) await Store.DeleteAsync(item.Id);
            await LoadAsync();
            _selected.ExceptWith(items.Select(item => item.Id));
            _pendingDelete = null;
            if (_mode == Mode.Compose) BackToList();
            Toasts.Show(items.Count == 1 ? $"{items[0].Name} is deleted." : $"{items.Count} items are deleted.");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            await LoadAsync();
            Toasts.ShowError("We couldn't delete them all. Try again.");
        }
        finally
        {
            _deleting = false;
        }
    }
