    private static string Plural(int count) => count == 1 ? "1 item" : $"{count} items";

    // ── Choosing items for a change to many ───────────────────────────────

    private List<CatalogEntry> Chosen => [.. _items.Where(item => _selected.Contains(item.Id))];

    private CheckboxState PageCheckState => SectionCheckState(Shown);

    private CheckboxState SectionCheckState(IReadOnlyCollection<CatalogEntry> items) =>
        items.Count > 0 && items.All(item => _selected.Contains(item.Id)) ? CheckboxState.Checked
        : items.Any(item => _selected.Contains(item.Id)) ? CheckboxState.Indeterminate
        : CheckboxState.Unchecked;

    private void Choose(string id, bool on)
    {
        if (on) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void ChoosePage(CheckboxState state) => ChooseSection(Shown);

    private void ChooseSection(IReadOnlyCollection<CatalogEntry> items)
    {
        if (items.All(item => _selected.Contains(item.Id))) _selected.ExceptWith(items.Select(item => item.Id));
        else _selected.UnionWith(items.Select(item => item.Id));
    }

    private void ChooseAllInView() => _selected.UnionWith(Visible.Select(item => item.Id));

    private async Task MarkManyAsync(Mark mark)
    {
        _markOpen = false;
        var items = Chosen.Where(Live).ToList();
        if (items.Count == 0 || _bulkBusy) return;
        _bulkBusy = true;
        try
        {
            foreach (var item in items)
            {
                var changed = item.Copy();
                changed.IsHidden = mark == Mark.Hidden;
                if (mark != Mark.Hidden) changed.IsAvailable = mark == Mark.Available;
                await Store.SaveAsync(changed);
            }
            await LoadAsync();
            ClearChosen();
            var one = items.Count == 1;
            var stillOut = mark == Mark.Available
                ? _items.Count(item => items.Any(chosen => chosen.Id == item.Id) && !ItemGuide.InStock(item))
                : 0;
            var done = items.Count - stillOut;
            Toasts.Show(mark switch
            {
                Mark.Available when stillOut > 0 => $"{Plural(done)} {(done == 1 ? "is" : "are")} available. {Plural(stillOut)} {(stillOut == 1 ? "stays" : "stay")} sold out until you add how many are left.",
                Mark.Available => $"{Plural(items.Count)} {(one ? "is" : "are")} available.",
                Mark.SoldOut => $"{Plural(items.Count)} {(one ? "is" : "are")} unavailable.",
                _ => $"{Plural(items.Count)} {(one ? "is" : "are")} hidden. Customers won't be offered {(one ? "it" : "them")}.",
            });
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            await LoadAsync();
            Toasts.ShowError("We couldn't change them all. Check your connection and try again.");
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task MoveManyAsync(string category)
    {
        _moveOpen = false;
        var items = Chosen;
        if (items.Count == 0 || _bulkBusy) return;
        _bulkBusy = true;
        try
        {
            foreach (var item in items)
            {
                var moved = item.Copy();
                moved.Group = category;
                await Store.SaveAsync(moved);
            }
            await LoadAsync();
            ClearChosen();
            Toasts.Show(category.Length > 0 ? $"{Plural(items.Count)} moved to {category}." : $"{Plural(items.Count)} {(items.Count == 1 ? "has" : "have")} no category now.");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            await LoadAsync();
            Toasts.ShowError("We couldn't move them all. Check your connection and try again.");
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    /// <summary>Many prices at once, said back with an Undo that puts every one back.</summary>
    private async Task<string?> ChangePricesAsync(IReadOnlyList<CatalogEntry> changed)
    {
        if (changed.Count == 0 || _bulkBusy) return "Choose items with prices to change.";
        var before = changed.Select(item => _items.First(existing => existing.Id == item.Id).Copy()).ToList();
        _bulkBusy = true;
        try
        {
            foreach (var item in changed) await Store.SaveAsync(item);
            await LoadAsync();
            ClearChosen();
            Toasts.Show(new ToastMessage(
                changed.Count == 1 ? $"{changed[0].Name} is {PriceWords.For(changed[0]).Main} now." : $"New prices for {Plural(changed.Count)}.",
                "Customers are told the new prices from now on.",
                ToastStatus.Success,
                "Undo",
                () => InvokeAsync(() => PutBackAsync(before))));
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            await LoadAsync();
            Toasts.ShowError("We couldn't change them all. Check your connection and try again.");
            return "Some prices may have changed. Check the list before retrying.";
        }
        finally
        {
            _bulkBusy = false;
        }
        // Called by the Change prices panel (not an event of this page's own), so the page draws itself again.
        StateHasChanged();
        return null;
    }

    private async Task PutBackAsync(IReadOnlyList<CatalogEntry> before)
    {
        try
        {
            foreach (var item in before) await Store.SaveAsync(item);
            await LoadAsync();
            Toasts.Show(before.Count == 1 ? $"{before[0].Name} is back to {PriceWords.For(before[0]).Main}." : $"{Plural(before.Count)} are back to their prices.");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            await LoadAsync();
            Toasts.ShowError("We couldn't put them all back. Check your connection and try again.");
        }
        StateHasChanged();
    }

    // ── Changes in a cell ──────────────────────────────────────────────────

    /// <summary>A price, category or availability changed in the table, said back in plain words; a price with an Undo.</summary>
    private async Task<string?> SaveCellAsync(CatalogEntry changed)
    {
        var before = _items.FirstOrDefault(item => item.Id == changed.Id)?.Copy();
        // A draft's category can change here; approval must still happen on its form.
        if (before is not null && CatalogReadiness.IsDraft(before)) changed.Status = CatalogStatus.Draft;
        else if (CatalogReadiness.Issue(changed) is { } issue) return issue;
        try
        {
            await Store.SaveAsync(changed);
            await AddCategoryAsync(changed.Group);
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Toasts.ShowError($"We couldn't change {changed.Name}. Try again.");
            return "Not saved.";
        }

        if (before is not null)
        {
            var wasPrice = PriceWords.For(before);
            var nowPrice = PriceWords.For(changed);
            if (wasPrice != nowPrice || PriceWords.PriceList(before).SequenceEqual(PriceWords.PriceList(changed)) is false)
                Toasts.Show(new ToastMessage(
                    $"{changed.Name} is {nowPrice.Main}{(nowPrice.Detail is { } detail ? $", {detail.ToLowerInvariant()}" : string.Empty)} now.",
                    wasPrice.Missing ? "Your agent can offer it now." : "Customers are told the new price from now on.",
                    ToastStatus.Success,
                    "Undo",
                    () => InvokeAsync(() => PutBackAsync([before]))));
            else if (!string.Equals(before.Group, changed.Group, StringComparison.CurrentCulture))
                Toasts.Show(changed.Group.Length > 0 ? $"{changed.Name} is in {changed.Group} now." : $"{changed.Name} has no category now.");
            else if (before.IsHidden != changed.IsHidden)
                Toasts.Show(changed.IsHidden ? $"{changed.Name} is hidden. Customers won't be offered it." : $"{changed.Name} is offered to customers again.");
            else if (before.Stock != changed.Stock)
                Toasts.Show((changed.Stock ?? 0) > 0 ? $"{changed.Name}: {changed.Stock} in stock." : $"{changed.Name} is sold out.");
            else if (ItemGuide.InStock(before) != ItemGuide.InStock(changed))
                Toasts.Show(changed.Kind == CatalogKind.Service
                    ? (ItemGuide.InStock(changed) ? $"{changed.Name} is taking bookings." : $"{changed.Name} isn't taking bookings for now.")
                    : (ItemGuide.InStock(changed) ? $"{changed.Name} is available." : $"{changed.Name} is sold out."));
            else
                Toasts.Show($"Saved. {changed.Name} is up to date.");
        }
        StateHasChanged();
        return null;
    }

    private async Task AddCategoryAsync(string category)
    {
        if (category.Length == 0 || _categories.Any(existing => string.Equals(existing, category, StringComparison.CurrentCultureIgnoreCase))) return;
        await Store.SaveCategoriesAsync([.. _categories, category]);
        _categories = [.. _categories, category];
    }

    private async Task<string?> CreateCategoryAsync(string name)
    {
        try
        {
            await AddCategoryAsync(name);
            StateHasChanged();
            return null;
        }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException)
        { return "We couldn't create this category. Check your connection and try again."; }
    }

    private async Task<string?> ApplyCategoriesAsync(CategoryChanges changes)
    {
        try
        {
            foreach (var item in _items)
            {
                var from = changes.Moves.Keys.FirstOrDefault(name => InCategory(item, name));
                if (from is null) continue;
                var moved = item.Copy();
                moved.Group = changes.Moves[from];
                await Store.SaveAsync(moved);
            }
            await Store.SaveCategoriesAsync(changes.Order);
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            await LoadAsync();
            return "We couldn't save every change. Check your connection and try again.";
        }
        _manageOpen = false;
        Toasts.Show("Categories saved.");
        StateHasChanged();
        return null;
    }

