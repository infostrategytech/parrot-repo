@namespace Parrot.Web.Components.Pages.Dashboard.Catalog.ConceptE
@using Parrot.Web.Features.Dashboard.Catalog
@using Parrot.Web.Features.Dashboard.Catalog.ConceptE
@inject ICatalogStore Store
@inject IOfferingDiscovery Discovery
@inject IPriceListReader PriceLists
@inject ToastService Toasts
@inject NavigationManager Nav
@inject Parrot.Web.Features.Dashboard.Channels.State.ChannelsState ChannelState
@inject Parrot.Web.Features.Dashboard.Channels.Services.ChannelStatusLoader ChannelStatus
@inject AuthState AuthState
@implements IDisposable

@* Products & Services, Concept E (designer, 25–26 October 2026), kept clean and simple. It's what the agent
   knows about what the business sells and for how much, so it can answer, suggest and take payment; not a
   shop listing, so nothing is "on sale": an item is added, and one without a price is kept until it has one.
   Most owners already post on Instagram and TikTok, so the main way in is their posts: chosen the first
   time, then new posts are offered to review as they're found. The post is read, and what's read is put
   where it belongs on an ordinary item for the owner to check. From research into how Nigerian Instagram
   and TikTok vendors price.

   - Posts lead directly through Add From Posts (designer, 26 October 2026). Other Ways to Add groups
     manual entry, a post link and price lists without asking owners to choose one or many items first.
     Posts are selected and read on a page (PostPicker); price lists in a small window (PriceListDialog).
     Both open one review page (ItemReview). Manual entry opens ItemForm; a link opens LinkDialog,
     then the same form filled in beside its post.
   - The connected channels lead: only their posts, tabs and marks show (PostChannels).
   - A price that changes with a choice (UK 6–12 and 14–20, 8 or 14 inches) goes in as a price for each choice;
     the same price for every choice stays one price.
   - The list is Concept C's table: the item with its category and its choices, its price said once in one
     shape (the amount, then what it depends on), and whether customers can have it now. Amounts change in
     the table, with a check for a price ten times off and an Undo; how something is priced changes on the
     item. Many prices move at once (Change prices), as they do with inflation.
   - Drafts: explicitly saved unfinished items, outside the main catalogue and unavailable to the agent.

   The Products & Services page (designer, 28 October 2026). *@

@if (_mode == Mode.Compose)
{
    <ItemForm @key="@(_linked?.Post.Id ?? _composing?.Id ?? "new")"
              Item="@(_linked?.Item ?? _composing)"
              Source="_linked?.Post"
              Checks="@(_linked?.Checks ?? [])"
              Match="_linked?.Match"
              Categories="_categories"
              CreateCategory="CreateCategoryAsync"
              Save="SaveComposedAsync"
              OnBack="BackToList"
              OnDelete="item => _pendingDelete = [item]" />
}
else if (_mode == Mode.Posts)
{
    <PostPicker Channels="ConnectedSocial"
                Items="_items"
                Brought="_brought"
                Reconnect="ReconnectSocial"
                DemoPreview="@Query("posts")"
                OnReconnect="_ => Nav.NavigateTo(ChannelsUrl)"
                OnLink="() => { BackToList(); _linkOpen = true; }"
                OnClose="BackToList"
                OnRead="PostsRead" />
}
else if (_mode == Mode.Review)
{
    <ItemReview Drafts="_review"
                Source="_reviewSource"
                Categories="_categories"
                CreateCategory="CreateCategoryAsync"
                Save="SaveReviewedAsync"
                OnBrought="id => _brought.Add(id)"
                OnBack="BackToList"
                OnDone="ReviewDoneAsync" />
}
else
{
<main class="products-e">
    <header class="products-e__header">
        <div class="products-e__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Products &amp; Services</Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="products-e__lede">
                Keep what you sell, its price and availability in one place.
            </Typography>
        </div>
        @if (_mode == Mode.List && _items.Count > 0)
        {
            @AddActions
        }
    </header>

    @if (_loading)
    {
        <DataTable Label="Loading your items" Busy>
            <Message>
                @for (var index = 0; index < 6; index++)
                {
                    <div class="products-e__skeleton">
                        <Skeleton Shape="SkeletonShape.Block" Width="var(--ds-products-e-photo)" Height="var(--ds-products-e-photo)" Order="@(index * 2)" />
                        <Skeleton Shape="SkeletonShape.Line" Order="@(index * 2 + 1)" />
                    </div>
                }
            </Message>
        </DataTable>
    }
    else if (_loadFailed)
    {
        <EmptyState Glyph="IconName.RiErrorWarningFill"
                    Size="EmptyStateSize.Page"
                    Title="We couldn't load your items"
                    Description="Check your connection and try again.">
            <Action><Button @onclick="LoadAsync">Try again</Button></Action>
        </EmptyState>
    }
    else if (_items.Count == 0)
    {
        @* One calm invitation, with the same posts-first actions as the populated list. *@
        <section class="products-e__start" aria-labelledby="products-e-start-title">
            @SocialMarks
            <div class="products-e__start-head">
                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2" id="products-e-start-title">Add What You Sell</Typography>
                <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>Start with your social posts. Review the details before adding them.</Typography>
            </div>
            @AddActions
        </section>
    }
    else
    {
        @if (_selected.Count == 0 && NewPosts is { Count: > 0 } fresh)
        {
            @* New posts found on the connected channels: review them, or dismiss them (they stay on Select posts). *@
            <section class="products-e__new" aria-label="New posts">
                <span class="products-e__channels" aria-hidden="true">
                    @foreach (var channel in Social.Where(channel => fresh.Any(post => post.Channel == channel)))
                    {
                        <ChannelIcon Channel="@channel" Size="IconSize.Sm" />
                    }
                </span>
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="p" role="status">@NewLine(fresh)</Typography>
                <div class="products-e__new-actions">
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => _seen.UnionWith(fresh.Select(post => post.Id))">Dismiss</Button>
                    <Button Size="ButtonSize.Small" @onclick="BringPosts">Review posts</Button>
                </div>
            </section>
        }

        @if (_selected.Count == 0 && NeedingLook is { Count: > 0 } needing)
        {
            @* Items the agent couldn't fully use (designer, 23 November 2026): said once, above the list, with one
               way to see just them. Rows that are fine say nothing. *@
            <section class="products-e__look" aria-label="Items that need a look">
                <span class="products-e__look-mark" aria-hidden="true"><Icon Name="IconName.RiErrorWarningFill" Size="IconSize.Sm" /></span>
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="p" role="status">@AgentKnowledge.NeedsLookLine(needing)</Typography>
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="ToggleNeedsLook">
                    @(_needsLook ? "Show all items" : needing.Count == 1 ? "Show it" : "Show them")
                </Button>
            </section>
        }

        @if (_selected.Count > 0)
        {
            @* Items chosen: the toolbar becomes what can be done to them. *@
            <section class="products-e__bulk" aria-label="Change the chosen items">
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="p" role="status">@($"{_selected.Count} items selected")</Typography>
                @if (Visible.Count > _selected.Count)
                {
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="ChooseAllInView">@($"Select all {Visible.Count}")</Button>
                }
                <div class="products-e__bulk-actions">
                    @if (_view != ItemView.Drafts)
                    {
                    <ChangePrices Items="Chosen" Apply="ChangePricesAsync" Busy="_bulkBusy" />
                    <FilterPopover Label="Mark as" Title="Mark as" Open="_markOpen" OpenChanged="open => _markOpen = open">
                        <PopoverOption Label="Available" OnSelect="() => MarkManyAsync(Mark.Available)" />
                        <PopoverOption Label="Unavailable" OnSelect="() => MarkManyAsync(Mark.SoldOut)" />
                        <PopoverOption Label="Hidden" OnSelect="() => MarkManyAsync(Mark.Hidden)" />
                    </FilterPopover>
                    }
                    <FilterPopover Label="Move to category" Title="Move to category" Open="_moveOpen" OpenChanged="open => _moveOpen = open">
                        @foreach (var category in _categories)
                        {
                            var current = category;
                            <PopoverOption Label="@current" OnSelect="() => MoveManyAsync(current)" />
                        }
                        <PopoverOption Label="No category" OnSelect="() => MoveManyAsync(string.Empty)" />
                    </FilterPopover>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@_bulkBusy" @onclick="() => _pendingDelete = Chosen">
                        <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
                        <ChildContent>Delete</ChildContent>
                    </Button>
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="ClearChosen">Clear</Button>
                </div>
            </section>
        }
        else
        {
            <section class="products-e__toolbar" aria-label="Find items">
                <Tabs Label="Show items" Variant="TabsVariant.Tray" Class="products-e__views">
                    @foreach (var view in Views.Where(view => view is ItemView.All or ItemView.Available or ItemView.Drafts || Count(view) > 0 || _view == view))
                    {
                        var current = view;
                        <Tab Selected="@(_view == current)" Count="@Count(current).ToString()" OnClick="() => ChangeView(current)">
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">@ViewLabel(current)</Typography>
                        </Tab>
                    }
                </Tabs>
                <div class="products-e__find">
                    <SearchField Value="@_search" ValueChanged="Search" Placeholder="Search products or services" AriaLabel="Search products and services" />
                    <FilterPopover Label="@(_category ?? "All categories")" Title="Categories" Subtitle="Narrow the list by category" AlignEnd Open="_categoryOpen" OpenChanged="open => _categoryOpen = open">
                        <PopoverOption Label="All categories" Active="@(_category is null)" OnSelect="() => PickCategory(null)" />
                        @foreach (var category in _categories)
                        {
                            var current = category;
                            <PopoverOption Label="@current" Active="@(_category == current)" OnSelect="() => PickCategory(current)" />
                        }
                        <div class="products-e__category-tools">
                            <Toggle Checked="_byCategory" CheckedChanged="on => { _byCategory = on; _page = 1; }" Size="ToggleSize.Sm" Label="Group the list by category" />
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" FullWidth @onclick="() => { _categoryOpen = false; _manageOpen = true; }">
                                <IconLeft><Icon Name="IconName.RiSettings4Fill" /></IconLeft>
                                <ChildContent>Manage categories</ChildContent>
                            </Button>
                        </div>
                    </FilterPopover>
                </div>
            </section>
        }

        @if (_view == ItemView.Drafts)
        {
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Class="products-e__draft-note">Drafts aren't used by your agent. Finish the basics and choose Add item when you're ready.</Typography>
        }

        @if (Visible.Count == 0 && string.IsNullOrWhiteSpace(_search) && _category is null && _view == ItemView.Drafts)
        {
            <DataTable Label="Your items">
                <Message>
                    <EmptyState Glyph="IconName.RiFileList3Fill" Size="EmptyStateSize.Panel" Title="No drafts yet"
                                Description="Save an unfinished item as a draft and return to it here." />
                </Message>
            </DataTable>
        }
        else if (Visible.Count == 0 && string.IsNullOrWhiteSpace(_search) && _category is null && _view == ItemView.All && Count(ItemView.Drafts) > 0)
        {
            <DataTable Label="Your items">
                <Message>
                    <EmptyState Glyph="IconName.RiShoppingBag3Fill" Size="EmptyStateSize.Panel" Title="Your items are still in Drafts"
                                Description="Finish their details before your agent can use them.">
                        <Action><Button Variant="ButtonVariant.Secondary" @onclick="() => ChangeView(ItemView.Drafts)">View drafts</Button></Action>
                    </EmptyState>
                </Message>
            </DataTable>
        }
        else if (Visible.Count == 0)
        {
            <DataTable Label="Your items">
                <Message>
                    <EmptyState Glyph="IconName.RiSearch2Fill"
                                Size="EmptyStateSize.Panel"
                                Title="Nothing matches"
                                Description="Try another word, or show all your items.">
                        <Action><Button Variant="ButtonVariant.Secondary" @onclick="ShowAll">Show all items</Button></Action>
                    </EmptyState>
                </Message>
            </DataTable>
        }
        else
        {
            <DataTable Label="Your items" aria-rowcount="@(Visible.Count + 1)" aria-colcount="4">
                <ChildContent>
                    <OfferRow Head HeadState="PageCheckState" OnSelectAll="() => ChoosePage(PageCheckState)" />

                    @if (_byCategory)
                    {
                        @foreach (var section in Sections)
                        {
                            var current = section;
                            <div class="products-e__section" role="rowgroup" aria-label="@current.Name">
                                <div class="products-e__section-head" role="row">
                                    <div role="cell" class="products-e__section-select">
                                        <Checkbox State="@SectionCheckState(current.Items)" StateChanged="_ => ChooseSection(current.Items)" AriaLabel="@($"Choose everything in {current.Name}")" />
                                    </div>
                                    <div role="cell" class="products-e__section-title">
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@current.Name</Typography>
                                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@Plural(current.Items.Count)</Typography>
                                    </div>
                                </div>
                                @foreach (var item in current.Items)
                                {
                                    @Row(item)
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div role="rowgroup">
                            @foreach (var item in PagedItems)
                            {
                                @Row(item)
                            }
                        </div>
                    }
                </ChildContent>
                @* The count, always; the pages when there are more than one (grouped by category, everything shows). *@
                <Footer>
                    <Pagination Page="@(_byCategory ? 1 : CurrentPage)" PageChanged="page => _page = page" Total="Visible.Count"
                                PageSize="@(_byCategory ? Math.Max(1, Visible.Count) : PageSize)" AriaLabel="Pages of items" />
                </Footer>
            </DataTable>
        }
    }
</main>
}

<LinkDialog Open="_linkOpen" Items="_items" OnClose="() => _linkOpen = false" OnRead="LinkReadAsync" />

<Dialog Open="_connectOpen"
        Title="Connect a channel first"
        ConfirmLabel="Go to Channels"
        OnCancel="() => _connectOpen = false"
        OnConfirm="() => Nav.NavigateTo(ChannelsUrl)">
    <GlyphContent><Icon Name="IconName.RiLinksFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>Connect Instagram, Facebook or TikTok to select items from your posts.</p>
    </Body>
</Dialog>

<PriceListDialog Open="_listOpen"
                 Source="_importSource"
                 Items="_items"
                 OnClose="() => _listOpen = false"
                 OnRead="ListRead" />

<CategoryManager Open="_manageOpen"
                 Categories="_categories"
                 Counts="CategoryCounts"
                 OnClose="() => _manageOpen = false"
                 Save="ApplyCategoriesAsync" />

<Dialog Open="@(_pendingDelete is { Count: > 0 })"
        Type="DialogType.Destructive"
        Title="@DeleteTitle"
        ConfirmLabel="Delete"
        Busy="_deleting"
        BusyLabel="Deleting…"
        OnCancel="() => _pendingDelete = null"
        OnConfirm="DeleteAsync">
    <GlyphContent><Icon Name="IconName.RiDeleteBin6Fill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>@(_pendingDelete is { Count: > 1 } ? "They're removed from your list. To stop offering something for a while, hide it instead." : "It's removed from your list. To stop offering it for a while, hide it instead.")</p>
    </Body>
</Dialog>

@code {
    private enum Mode { List, Compose, Posts, Review }
    private enum ItemView { All, Available, SoldOut, Hidden, Drafts }
    private enum Mark { Available, SoldOut, Hidden }

    private sealed record Section(string Name, List<CatalogEntry> Items);

    private static readonly ItemView[] Views = [ItemView.All, ItemView.Available, ItemView.SoldOut, ItemView.Hidden, ItemView.Drafts];
    private const int PageSize = 25;

    private List<CatalogEntry> _items = [];
    private List<string> _categories = [];
    private Mode _mode = Mode.List;
    private ItemView _view = ItemView.All;
    private bool _byCategory, _needsLook;
    private string? _search, _category;
    private int _page = 1;
    private readonly HashSet<string> _selected = [];
    private bool _loading = true, _loadFailed, _categoryOpen, _moveOpen, _markOpen, _importOpen, _linkOpen, _manageOpen, _bulkBusy, _deleting;
    private CatalogEntry? _composing;
    // Posts already brought in, left out the next time posts are chosen.
    private readonly HashSet<string> _brought = [];
    private PostDraft? _linked;
    // New posts: found on the connected channels, offered to review; put off ones aren't offered again.
    private List<SocialPost> _recentPosts = [];
    // Posts the owner has seen (shown on Select posts, reviewed or dismissed): not offered again as new.
    private readonly HashSet<string> _seen = [];
    // Just added or updated from a review: said on their rows, and shown first.
    private readonly HashSet<string> _justAdded = [], _justUpdated = [];
    private bool _connectOpen;
    private ImportSource _importSource = ImportSource.Photo;
    private bool _listOpen;
    // What's being reviewed, and where it came from.
    private List<ReviewDraft> _review = [];
    private ReviewSource _reviewSource = new(null, []);
    private List<CatalogEntry>? _pendingDelete;

    // Posts are the direct primary action; the alternatives share one quieter menu.
    private RenderFragment AddActions => @<div class="products-e__actions">
        @OtherWaysMenu
        <Button @onclick="SocialPosts">
            <IconLeft><Icon Name="IconName.RiImageFill" /></IconLeft>
            <ChildContent>Import from posts</ChildContent>
        </Button>
    </div>;

    private RenderFragment OtherWaysMenu => @<Popover Title="Other Ways to Add" Role="menu" AlignEnd Wide Open="_importOpen" OpenChanged="open => _importOpen = open" Class="products-e__import">
        <Anchor>
            <Button Variant="ButtonVariant.Secondary" aria-haspopup="menu" aria-expanded="@(_importOpen ? "true" : "false")" @onclick="() => _importOpen = !_importOpen">
                <ChildContent>Other Ways to Add</ChildContent>
                <IconRight><Icon Name="IconName.RiArrowDownSLine" /></IconRight>
            </Button>
        </Anchor>
        <ChildContent>
            <PopoverOption Label="Enter Manually" OnSelect="Compose">
                <Leading><span class="products-e__way-mark is-one"><Icon Name="IconName.RiPencilFill" Size="IconSize.Sm" /></span></Leading>
            </PopoverOption>
            <PopoverOption Label="Use a Post Link" OnSelect="OpenLink">
                <Leading><span class="products-e__way-mark is-link"><Icon Name="IconName.RiLinksFill" Size="IconSize.Sm" /></span></Leading>
            </PopoverOption>
            @* Price lists are one way in (designer, 27 October 2026): the window's own tabs choose a photo, a file
               or pasted words, so the menu says it once. *@
            <PopoverOption Label="Import a Price List"
                           OnSelect="() => Import(PriceLists.CanReadPhotos ? ImportSource.Photo : ImportSource.Sheet)">
                <Leading><span class="products-e__way-mark is-list"><Icon Name="IconName.RiFileList3Fill" Size="IconSize.Sm" /></span></Leading>
            </PopoverOption>
            @if (HasChannelCatalogue)
            {
                <PopoverOption Label="Import from Channel's Catalogue"
                               OnSelect="OpenChannelCatalogue">
                    <Leading><span class="products-e__way-mark is-channel"><Icon Name="IconName.RiShoppingBag3Fill" Size="IconSize.Sm" /></span></Leading>
                </PopoverOption>
            }
        </ChildContent>
    </Popover>;

    private RenderFragment Row(CatalogEntry item) => @<OfferRow @key="item.Id"
                                                               Item="item"
                                                               Categories="_categories"
                                                               Selected="@_selected.Contains(item.Id)"
                                                               Save="SaveCellAsync"
                                                               OnSelect="on => Choose(item.Id, on)"
                                                               OnOpen="() => Open(item)" />;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await FindNewPostsAsync();
    }

    // Which channels are connected is read here too, not only when the Channels
    // page ran: the "Import from Channel's Catalogue" option has to know whether
    // WhatsApp is connected before it can be offered at all.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (AuthState.CurrentUser?.Token is { Length: > 0 } token)
        {
            try { await ChannelStatus.RefreshAsync(token, CancellationToken.None); }
            catch (OperationCanceledException) { return; }
            StateHasChanged();
        }
    }

    // The demo: posts not yet seen, not added and not over 3 months old. For real, the backend finds new posts
    // on the connected channels and keeps which the owner has seen or dismissed (catalog-backend-requests).
    private async Task FindNewPostsAsync()
    {
        if (!SocialConnected) return;
        try
        {
            var recent = await Discovery.ListRecentPostsAsync();
            _recentPosts = [.. recent.Concat(DemoPosts.More).Where(post => ConnectedSocial.Contains(post.Channel)).OrderBy(post => post.DaysAgo)];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException)
        {
            _recentPosts = [];
        }
    }

    private List<SocialPost> NewPosts => [.. _recentPosts.Where(post => PostDraft.IsNew(post, _items, [.. _brought, .. _seen]))];

    private static string NewLine(IReadOnlyList<SocialPost> posts)
    {
        return posts.Count == 1 ? "We found 1 new post. Want to add it?"
            : $"We found {posts.Count} new posts. Want to add them?";
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _items = [.. await Store.ListAsync()];
            _categories = [.. await Store.ListCategoriesAsync()];
            _selected.IntersectWith(_items.Select(item => item.Id));
            if (_category is not null && !_categories.Contains(_category)) _category = null;
            WatchAgent();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // ── What shows ─────────────────────────────────────────────────────────

    private static bool InCategory(CatalogEntry item, string category) => string.Equals(item.Group, category, StringComparison.CurrentCultureIgnoreCase);

    private int CountIn(string category) => _items.Count(item => InCategory(item, category));

    private IReadOnlyDictionary<string, int> CategoryCounts => _categories.ToDictionary(category => category, CountIn);

    private static bool Live(CatalogEntry item) => !CatalogReadiness.IsDraft(item);

    private int Count(ItemView view) => _items.Count(item => Matches(item, view));

    private static bool Matches(CatalogEntry item, ItemView view) => view switch
    {
        ItemView.Available => Live(item) && !item.IsHidden && ItemGuide.InStock(item),
        ItemView.SoldOut => Live(item) && !item.IsHidden && !ItemGuide.InStock(item),
        ItemView.Hidden => Live(item) && item.IsHidden,
        ItemView.Drafts => CatalogReadiness.IsDraft(item),
        _ => Live(item),
    };

    private static string ViewLabel(ItemView view) => view switch
    {
        ItemView.Available => "Available",
        ItemView.SoldOut => "Unavailable",
        ItemView.Hidden => "Hidden",
        ItemView.Drafts => "Drafts",
        _ => "All",
    };

    private List<CatalogEntry> Visible
    {
        get
        {
            var query = (_search ?? string.Empty).Trim();
            var items = _items
                .Where(item => Matches(item, _view))
                .Where(item => !NeedsLookOn || AgentKnowledge.NeedsLook(item))
                .Where(item => _category is null || InCategory(item, _category))
                .Where(item => query.Length == 0 || $"{item.Name} {item.Description} {item.Group} {string.Join(" ", item.OtherNames)}".Contains(query, StringComparison.CurrentCultureIgnoreCase));
            return [.. items.OrderBy(item => _justAdded.Contains(item.Id) || _justUpdated.Contains(item.Id) ? 0 : 1).ThenBy(item => item.Status == CatalogStatus.Draft ? 0 : 1).ThenBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)];
        }
    }

    private List<Section> Sections
    {
        get
        {
            var visible = Visible;
            var sections = _categories
                .Select(category => new Section(category, [.. visible.Where(item => InCategory(item, category))]))
                .Where(section => section.Items.Count > 0)
                .ToList();
            var loose = visible.Where(item => item.Group.Length == 0 || !_categories.Any(category => InCategory(item, category))).ToList();
            if (loose.Count > 0) sections.Add(new Section("No category", loose));
            return sections;
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Visible.Count / (double)PageSize));
    private int CurrentPage => Math.Clamp(_page, 1, TotalPages);
    private List<CatalogEntry> PagedItems => [.. Visible.Skip((CurrentPage - 1) * PageSize).Take(PageSize)];
    private List<CatalogEntry> Shown => _byCategory ? Visible : PagedItems;

    private void ChangeView(ItemView view)
    {
        _needsLook = false;
        _view = view;
        _page = 1;
        _selected.Clear();
    }

    private void Search(string? value)
    {
        _search = value;
        _page = 1;
        _selected.Clear();
    }

    private void PickCategory(string? category)
    {
        _category = category;
        _categoryOpen = false;
        _page = 1;
        _selected.Clear();
    }

    private void ClearChosen()
    {
        _selected.Clear();
        _markOpen = _moveOpen = false;
    }

    // ── Where the agent is ─────────────────────────────────────────────────

    // Live items the agent couldn't fully use. Drafts and hidden items are out of its search anyway.
    private List<CatalogEntry> NeedingLook => [.. _items.Where(item => Live(item) && !item.IsHidden && AgentKnowledge.NeedsLook(item))];

    // Showing only those; it lets go by itself once none are left.
    private bool NeedsLookOn => _needsLook && NeedingLook.Count > 0;

    private void ToggleNeedsLook()
    {
        _needsLook = !NeedsLookOn;
        if (_needsLook)
        {
            _view = ItemView.All;
            _search = null;
            _category = null;
        }
        _page = 1;
        _selected.Clear();
    }

    // While the agent is catching up on a save, the list reads its report again now and then, so "Updating your
    // agent…" goes (or turns into what needs a look) without a reload. Only the agent's part of each item is
    // taken, so nothing being edited on the page moves. It stops when nothing is updating, or after two minutes.
    private CancellationTokenSource? _watch;
    private static readonly TimeSpan WatchEvery = TimeSpan.FromSeconds(4), WatchFor = TimeSpan.FromMinutes(2);

    private void WatchAgent()
    {
        if (_watch is not null || !_items.Any(item => item.Ai == AiProgress.Updating)) return;
        var watch = _watch = new CancellationTokenSource(WatchFor);
        _ = WatchAgentAsync(watch);
    }

    private async Task WatchAgentAsync(CancellationTokenSource watch)
    {
        try
        {
            while (_items.Any(item => item.Ai == AiProgress.Updating))
            {
                await Task.Delay(WatchEvery, watch.Token);
                var fresh = (await Store.ListAsync(watch.Token)).ToDictionary(item => item.Id);
                foreach (var item in _items)
                {
                    if (fresh.TryGetValue(item.Id, out var latest)) AgentKnowledge.TakeReport(item, latest);
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or System.Text.Json.JsonException)
        {
            // Stopped, or the read failed: the next save or visit picks it up.
        }
        finally
        {
            if (ReferenceEquals(_watch, watch)) _watch = null;
            watch.Dispose();
        }
    }

    public void Dispose() => _watch?.Cancel();

