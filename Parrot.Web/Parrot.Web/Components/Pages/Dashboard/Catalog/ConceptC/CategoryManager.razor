@namespace Parrot.Web.Components.Pages.Dashboard.Catalog.ConceptC
@using Parrot.Web.Features.Dashboard.Catalog

@* The business's categories in one place (what A never had): their order,
   which is the order of a menu's sections and of the list by category;
   renaming, where a name that already exists merges the two; adding one
   before anything is in it; and deleting, which first asks where its items
   go. Nothing changes until Save. *@

<SidePanel Open="Open" Title="Categories" Glyph="IconName.RiArchive2Fill" Busy="_saving" OnClose="OnClose">
    <ChildContent>
        <div class="category-manager">
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="category-manager__muted">Their order is the order your list and menu show them in. Rename one to the name of another to merge them.</Typography>

            <ol class="category-manager__list" aria-label="Your categories">
                @for (var index = 0; index < _rows.Count; index++)
                {
                    var row = _rows[index];
                    var position = index;
                    <li class="@($"category-manager__row{(row.Deleting ? " is-deleting" : null)}")" @key="row.Key">
                        @* The icon set has no up arrow: the down chevron, turned. *@
                        <div class="category-manager__move">
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="category-manager__up" aria-label="@($"Move {row.Name} up")" disabled="@(position == 0)" @onclick="() => Move(position, -1)">
                                <IconLeft><Icon Name="IconName.RiArrowDownSLine" /></IconLeft>
                            </Button>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="@($"Move {row.Name} down")" disabled="@(position == _rows.Count - 1)" @onclick="() => Move(position, 1)">
                                <IconLeft><Icon Name="IconName.RiArrowDownSLine" /></IconLeft>
                            </Button>
                        </div>
                        <Input FloatingLabel="@(row.Original is null ? "New category" : "Name")"
                               maxlength="40"
                               Value="@row.Name"
                               ValueChanged="value => row.Name = value ?? string.Empty"
                               Error="@(row.Name.Trim().Length == 0)"
                               HelperText="@Note(row)" />
                        <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="category-manager__count">@Count(row)</Typography>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="@($"Delete {row.Name}")" @onclick="() => StartDelete(row)">
                            <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
                        </Button>

                        @if (row.Deleting)
                        {
                            <div class="category-manager__delete">
                                <Typography TextStyle="TextStyle.Small12Semibold" As="p">@($"Move its {ItemsIn(row)} {(ItemsIn(row) == 1 ? "item" : "items")} to")</Typography>
                                <FilterPopover Label="@(row.MoveTo.Length > 0 ? row.MoveTo : "No category")" Title="Move to" Open="@(_moveOpen == row.Key)" OpenChanged="open => _moveOpen = open ? row.Key : null">
                                    @foreach (var other in _rows.Where(other => other != row && !other.Deleting && other.Name.Trim().Length > 0))
                                    {
                                        var target = other.Name.Trim();
                                        <PopoverOption Label="@target" Active="@(row.MoveTo == target)" OnSelect="() => { row.MoveTo = target; _moveOpen = null; }" />
                                    }
                                    <PopoverOption Label="No category" Active="@(row.MoveTo.Length == 0)" OnSelect="() => { row.MoveTo = string.Empty; _moveOpen = null; }" />
                                </FilterPopover>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => row.Deleting = false">Keep it</Button>
                            </div>
                        }
                    </li>
                }
            </ol>

            <Button Variant="ButtonVariant.Secondary" @onclick="AddRow">
                <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                <ChildContent>Add a category</ChildContent>
            </Button>

            @if (_error is not null)
            {
                <InlineError Message="@_error" OnDismiss="() => _error = null" />
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Ghost" disabled="@_saving" @onclick="OnClose">Cancel</Button>
        <Button Busy="_saving" disabled="@(_saving || _rows.Any(row => !row.Deleting && row.Name.Trim().Length == 0))" @onclick="SaveAsync">Save categories</Button>
    </Footer>
</SidePanel>

@code {
    [Parameter, EditorRequired] public bool Open { get; set; }

    /// <summary>The business's categories, in its order.</summary>
    [Parameter] public IReadOnlyList<string> Categories { get; set; } = [];

    /// <summary>How many items each category holds.</summary>
    [Parameter] public IReadOnlyDictionary<string, int> Counts { get; set; } = new Dictionary<string, int>();

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Applies the changes: null when saved, or what went wrong.</summary>
    [Parameter, EditorRequired] public Func<CategoryChanges, Task<string?>> Save { get; set; } = _ => Task.FromResult<string?>(null);

    private sealed class Row
    {
        public string Key { get; } = Guid.NewGuid().ToString("N");
        public string? Original { get; init; }
        public string Name { get; set; } = "";
        public bool Deleting { get; set; }
        public string MoveTo { get; set; } = "";
    }

    private List<Row> _rows = [];
    private bool _wasOpen, _saving;
    private string? _error, _moveOpen;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _rows = [.. Categories.Select(category => new Row { Original = category, Name = category })];
            _error = _moveOpen = null;
        }
        _wasOpen = Open;
    }

    private int ItemsIn(Row row) => row.Original is { } name && Counts.TryGetValue(name, out var count) ? count : 0;

    private string Count(Row row) => ItemsIn(row) switch
    {
        0 => "Empty",
        1 => "1 item",
        var count => $"{count} items",
    };

    // A rename to a name another row has: the two become one.
    private string? Note(Row row)
    {
        var name = row.Name.Trim();
        if (name.Length == 0) return "Give it a name, or delete it";
        if (name.Length > 40 && name != row.Original) return "Keep the name to 40 characters or fewer";
        var other = _rows.FirstOrDefault(other => other != row && !other.Deleting && string.Equals(other.Name.Trim(), name, StringComparison.CurrentCultureIgnoreCase));
        if (other is null) return row.Original is not null && name != row.Original ? $"Was {row.Original}" : null;
        return _rows.IndexOf(other) < _rows.IndexOf(row) ? $"Joins {other.Name.Trim()}" : null;
    }

    private void Move(int index, int by)
    {
        var to = index + by;
        if (to < 0 || to >= _rows.Count) return;
        (_rows[index], _rows[to]) = (_rows[to], _rows[index]);
    }

    private void StartDelete(Row row)
    {
        // Empty or new: nothing to move, so it just goes.
        if (ItemsIn(row) == 0) { _rows.Remove(row); return; }
        row.Deleting = true;
        row.MoveTo = string.Empty;
    }

    private void AddRow() => _rows.Add(new Row());

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (_rows.Any(row => !row.Deleting && (string.IsNullOrWhiteSpace(row.Name)
            || row.Name.Trim().Length > 40 && row.Name.Trim() != row.Original)))
        { _error = "Use category names of 1 to 40 characters."; return; }
        _saving = true;
        _error = null;
        // Moves for deleted ones, renames for the rest; the order is what is left.
        var moves = new Dictionary<string, string>(StringComparer.CurrentCulture);
        foreach (var row in _rows.Where(row => row.Original is not null))
        {
            var target = row.Deleting ? row.MoveTo : row.Name.Trim();
            if (target != row.Original) moves[row.Original!] = target;
        }
        foreach (var removed in Categories.Where(category => _rows.All(row => row.Original != category)))
            moves[removed] = string.Empty;
        var order = _rows.Where(row => !row.Deleting).Select(row => row.Name.Trim()).Where(name => name.Length > 0)
            .Distinct(StringComparer.CurrentCultureIgnoreCase).ToList();
        try { _error = await Save(new CategoryChanges(order, moves)); }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException)
        { _error = "We couldn't save your categories. Check your connection and try again."; }
        finally { _saving = false; }
    }
}
