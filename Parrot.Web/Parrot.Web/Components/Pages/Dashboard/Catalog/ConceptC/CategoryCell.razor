@namespace Parrot.Web.Components.Pages.Dashboard.Catalog.ConceptC
@using Parrot.Web.Features.Dashboard.Catalog

@* An item's category, changed in the table: the business's categories in
   its own order, "No category", and a new one made right there (A made new
   categories only inside its form). A name that already exists, in any case,
   is the same category. *@

<div class="category-cell-wrap">
    <FilterPopover Label="@(Item.Group.Length > 0 ? Item.Group : "Add category")" Title="Category" Busy="_saving" Open="_open" OpenChanged="Opened" Class="@(Item.Group.Length > 0 ? "category-cell" : "category-cell is-empty")">
        @foreach (var category in Categories)
        {
            var current = category;
            <PopoverOption Label="@current" Active="@string.Equals(Item.Group, current, StringComparison.CurrentCultureIgnoreCase)" OnSelect="() => ChooseAsync(current)" />
        }
        <PopoverOption Label="No category" Active="@(Item.Group.Length == 0)" OnSelect="() => ChooseAsync(string.Empty)" />
        <div class="category-cell__new">
            <Input FloatingLabel="New category"
                   maxlength="40"
                   Value="@_new"
                   ValueChanged="value => { _new = value; _error = null; }"
                   @onkeydown="KeyAsync" />
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Busy="_saving" disabled="@(string.IsNullOrWhiteSpace(_new))" @onclick="AddAsync">Add</Button>
        </div>
        @if (_error is not null) { <InlineError Message="@_error" /> }
    </FilterPopover>

</div>

@code {
    [Parameter, EditorRequired] public CatalogEntry Item { get; set; } = default!;

    /// <summary>The business's categories, in its order.</summary>
    [Parameter] public IReadOnlyList<string> Categories { get; set; } = [];

    /// <summary>Saves the item in a category (new or not): null when saved, or what went wrong.</summary>
    [Parameter, EditorRequired] public Func<CatalogEntry, Task<string?>> Save { get; set; } = _ => Task.FromResult<string?>(null);

    private bool _open, _saving;
    private string? _new, _error;

    private void Opened(bool open)
    {
        _open = open;
        _new = null;
        _error = null;
    }

    private async Task KeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await AddAsync();
    }

    private Task AddAsync()
    {
        var name = (_new ?? string.Empty).Trim();
        if (name.Length == 0) return Task.CompletedTask;
        // Typed again with other capitals: the existing one.
        name = Categories.FirstOrDefault(category => string.Equals(category, name, StringComparison.CurrentCultureIgnoreCase)) ?? name;
        return ChooseAsync(name);
    }

    private async Task ChooseAsync(string category)
    {
        if (_saving) return;
        if (string.Equals(Item.Group, category, StringComparison.CurrentCulture)) return;
        if (category.Length > 40 && !Categories.Contains(category)) { _error = "Keep category names to 40 characters or fewer."; return; }
        var changed = Item.Copy();
        changed.Group = category;
        _saving = true; _error = null;
        try { _error = await Save(changed); if (_error is null) _open = false; }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException)
        { _error = "We couldn't save this category. Check your connection and try again."; }
        finally { _saving = false; }
    }
}
