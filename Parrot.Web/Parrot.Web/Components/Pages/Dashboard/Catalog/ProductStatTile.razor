@namespace Parrot.Web.Components.Pages.Dashboard.Catalog

@* One number from the summary strip. A component because there are three of
   them and they differ only in glyph, number and words.

   The icon and the text are two explicit columns, and everything textual sits
   in ONE of them. Relying on grid auto-placement to drop the note into the
   second column is what made it land in the 40px icon column and wrap onto
   four lines — a layout that depends on placement rules is a layout that
   breaks when a row is added. *@

<article class="@(Attention ? "stat-tile has-attention" : "stat-tile")">
    <span class="stat-tile__icon"><Icon Name="Glyph" Size="IconSize.Md" /></span>

    <div class="stat-tile__body">
        <div class="stat-tile__figure">
            @* An em dash while loading rather than a zero, which would read as
               a real count of none. *@
            <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong" Prose>
                @(Value?.ToString() ?? "—")
            </Typography>
            <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@Label</Typography>
        </div>

        @if (!string.IsNullOrWhiteSpace(Note))
        {
            <Typography TextStyle="TextStyle.Small10Regular" As="p" Prose Class="stat-tile__note">
                @Note
            </Typography>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public IconName Glyph { get; set; }

    /// <summary>Null while the workspace is still loading.</summary>
    [Parameter] public int? Value { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string? Note { get; set; }

    /// <summary>Colours the tile when the number is one somebody should act on.</summary>
    [Parameter] public bool Attention { get; set; }
}
