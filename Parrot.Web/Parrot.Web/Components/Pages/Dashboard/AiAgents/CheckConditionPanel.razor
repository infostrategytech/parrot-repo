@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<div class="step-two-col">
    <SelectField FloatingLabel="Field to check"
                 Value="@FieldLabel(Step.ConditionField)"
                 Open='@(_open == "field")'
                 OpenChanged='@(open => _open = open ? "field" : null)'>
        @foreach (var field in Fields)
        {
            var current = field;
            <PopoverOption Label="@current.Label" Active="@(Step.ConditionField == current.Id)"
                           OnSelect="async () => { Step.ConditionField = current.Id; _open = null; await OnChanged.InvokeAsync(); }" />
        }
    </SelectField>
    <SelectField FloatingLabel="Operator"
                 Value="@OperatorLabel(Step.ConditionOperator)"
                 Open='@(_open == "operator")'
                 OpenChanged='@(open => _open = open ? "operator" : null)'>
        @foreach (var op in Operators)
        {
            var current = op;
            <PopoverOption Label="@current.Label" Active="@(Step.ConditionOperator == current.Id)"
                           OnSelect="async () => { Step.ConditionOperator = current.Id; _open = null; await OnChanged.InvokeAsync(); }" />
        }
    </SelectField>
</div>

<Input FloatingLabel="Value"
       HelperText="Comparison value"
       Value="@Step.ConditionValue"
       ValueChanged="value => Step.ConditionValue = value ?? string.Empty" />

<div class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Path</Typography>

    <div class="step-path step-path--yes">
        <div class="step-path-head">
            <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">Yes path</Typography>
        </div>
        <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="step-hint">When condition is true</Typography>
        <SelectField FloatingLabel="Action"
                     Value="@ActionLabel(Step.YesAction)"
                     Open='@(_open == "yes")'
                     OpenChanged='@(open => _open = open ? "yes" : null)'>
            <PopoverOption Label="Continue to next step" Active='@(Step.YesAction == "continue")' OnSelect='() => { Step.YesAction = "continue"; _open = null; }' />
            <PopoverOption Label="End flow" Active='@(Step.YesAction == "end")' OnSelect='() => { Step.YesAction = "end"; _open = null; }' />
        </SelectField>
    </div>

    <div class="step-path step-path--no">
        <div class="step-path-head">
            <Icon Name="IconName.RiCloseFill" Size="IconSize.Sm" />
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">No path</Typography>
        </div>
        <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="step-hint">When condition is false</Typography>
        <SelectField FloatingLabel="Action"
                     Value="@ActionLabel(Step.NoAction)"
                     Open='@(_open == "no")'
                     OpenChanged='@(open => _open = open ? "no" : null)'>
            <PopoverOption Label="Continue to next step" Active='@(Step.NoAction == "continue")' OnSelect='() => { Step.NoAction = "continue"; _open = null; }' />
            <PopoverOption Label="End flow" Active='@(Step.NoAction == "end")' OnSelect='() => { Step.NoAction = "end"; _open = null; }' />
        </SelectField>
    </div>
</div>

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _open;

    private sealed record Choice(string Id, string Label);

    private static readonly Choice[] Fields =
    [
        new("CustomerName", "Customer name"),
        new("CustomerOrder", "Customer order"),
        new("SelectedItems", "Selected items"),
        new("OrderTotal", "Order total")
    ];

    private static readonly Choice[] Operators =
    [
        new("equals", "Equals"),
        new("notequals", "Does not equal"),
        new("contains", "Contains"),
        new("gt", "Greater than"),
        new("lt", "Less than"),
        new("isempty", "Is empty"),
        new("isnotempty", "Is not empty")
    ];

    private static string FieldLabel(string id) => Fields.FirstOrDefault(f => f.Id == id)?.Label ?? string.Empty;
    private static string OperatorLabel(string id) => Operators.FirstOrDefault(o => o.Id == id)?.Label ?? string.Empty;

    private static string ActionLabel(string id) => id switch
    {
        "continue" => "Continue to next step",
        "end" => "End flow",
        _ => string.Empty
    };
}
