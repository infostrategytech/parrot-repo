    // Its job description as one summary, a sentence at a time underneath: those just added lit for a moment,
    // one to change marked, and (aloud) each one reached as it is read.
    private RenderFragment JobSummary(AgentBrief brief, IReadOnlyCollection<string> fresh, string? focus, bool aloud = false) => __builder =>
    {
        var sentences = brief.Sentences();
        RenderFragment text = __builder =>
        {
            var at = 0;
            <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                @foreach (var sentence in sentences)
                {
                    var start = at;
                    at += sentence.Length + 1;
                    <span data-at="@start" class="@(fresh.Contains(sentence) ? "is-new" : focus == sentence ? "is-focus" : null)">@(sentence + " ")</span>
                }
            </Typography>
        };
        if (aloud)
        {
            <div class="@($"agent-detail__job-summary{(_hearing ? " is-reading" : null)}")" @ref="_summaryText" @key="_readKey">@text</div>
        }
        else
        {
            <div class="agent-detail__job-summary">@text</div>
        }
    };

