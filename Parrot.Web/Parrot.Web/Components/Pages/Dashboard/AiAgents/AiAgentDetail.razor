    // The save in flight, so leaving and turning it on can wait for it rather than race it.
    private Task? _saveTask;
    private async Task SettleAsync() { if (_saveTask is { IsCompleted: false } running) await running; }

    private Task SaveAsync(AiAgent agent, string? said = null, bool quiet = false) => _saveTask = SaveCoreAsync(agent, said, quiet);

    // The changes go onto a copy; the agent shown changes only once saved.
    private async Task SaveCoreAsync(AiAgent agent, string? said, bool quiet)
    {
        _tried = true;
        if (_form is null || !_form.HasName || !_form.HasRoleName || _saving) return;
        var changed = AiAgentsState.Copy(agent);
        _form.ApplyTo(changed);
        // What is being saved, as it is now: anything changed while it saves is saved next.
        var saving = _form.Snapshot();
        _saving = true;
        _saveError = null;
        try
        {
            await AiAgentsState.SaveAsync(changed);
            _saved = saving;
            _tried = false;
            if (!quiet) Toasts.Show(said ?? $"Saved. {changed.Name} works this way from now on.");
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            // The API's own reason when it gave one (a channel in another workspace, a currency it can't keep);
            // the connection only when it didn't.
            _saveError = exception is ApiException { UserMessage: { Length: > 0 } reason } ? reason
                : "We couldn't save your changes. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private bool _confirmingLeave, _leaving;
    private string? _leaveTo;

    // Leaving: a change still waiting is saved first; only one that can't be saved asks.
    private async Task OnNavigatingAsync(LocationChangingContext context)
    {
        if (!Dirty || _leaving) return;
        // A save already on its way finishes first, then whatever is left is saved.
        await SettleAsync();
        if (AiAgentsState.GetAgent(AgentId) is { } agent && CanAutosave) await AutosaveNowAsync(agent);
        await SettleAsync();
        if (!Dirty) return;
        context.PreventNavigation();
        _leaveTo = context.TargetLocation;
        // Asking about the channels already: that answer decides, and one question is enough.
        if (_confirmingNoChannel) return;
        _confirmingLeave = true;
    }

    private void Leave()
    {
        _confirmingLeave = false;
        _leaving = true;
        if (_leaveTo is { } to) Nav.NavigateTo(to);
    }

    // ── Every setting saves itself (designer, 11 November 2026) ──────────────
    // A change is saved a moment after it's made (typing waits for a pause), quietly: no Save changes, and no status
    // in a corner. A failed save keeps the change and says so in a message with Try again; an agent with no name
    // shows that at its name and isn't saved until it has one. Changes made close together go in one save, one
    // after another, never two at once. The one change that asks first: a live agent left with no channel.

    private enum Autosave { Idle, Saving, Failed, Blocked }
    private Autosave _autosave;
    private const int AutosaveDelayMs = 800;
    private CancellationTokenSource? _autosaveTimer;
    private string? _scheduled, _failed;
    private bool _confirmingNoChannel, _noChannelAgreed;

    private bool CanAutosave => _form is { HasName: true, HasRoleName: true };

    private string BlockedNote => _form is { HasRoleName: false } ? "It needs its job named before it can be saved." : "It needs a name before it can be saved.";

    // After every render: a change not saved yet is saved a moment later (each further change restarts the wait).
    private void ScheduleAutosave()
    {
        if (_form is null || _telling || _leaving || _confirmingNoChannel || AiAgentsState.GetAgent(AgentId) is not { } agent) return;
        var snapshot = _form.Snapshot();
        if (snapshot == _saved)
        {
            _scheduled = null;
            if (_autosave == Autosave.Blocked) _autosave = Autosave.Idle;
            return;
        }
        if (!CanAutosave)
        {
            // Shown at the name (and the job's name), as a missing answer is.
            if (!_tried) { _tried = true; StateHasChanged(); }
            _autosave = Autosave.Blocked;
            return;
        }
        if (_autosave == Autosave.Blocked) _autosave = Autosave.Idle;
        // A failed save waits for Try again, or for the next change, rather than retrying on its own.
        if (snapshot == _scheduled || _saving || (_autosave == Autosave.Failed && snapshot == _failed)) return;
        _scheduled = snapshot;
        _autosaveTimer?.Cancel();
        _autosaveTimer = new CancellationTokenSource();
        _ = SaveSoonAsync(agent, _autosaveTimer.Token);
    }

    private async Task SaveSoonAsync(AiAgent agent, CancellationToken token)
    {
        try { await Task.Delay(AutosaveDelayMs, token); }
        catch (TaskCanceledException) { return; }
        await InvokeAsync(() => AutosaveNowAsync(agent));
    }

    private async Task AutosaveNowAsync(AiAgent agent)
    {
        _autosaveTimer?.Cancel();
        // Turning it on or off: saved once that's done (the next render schedules it), never alongside it.
        if (_switching) { _scheduled = null; return; }
        if (_form is null || _saving || !CanAutosave || _form.Snapshot() == _saved) return;
        // A live agent about to answer nowhere: asked first.
        if (agent.IsActive && !agent.IsDraft && _form.Channels.Count == 0 && agent.Channels.Any(c => c.IsEnabled) && !_noChannelAgreed)
        {
            _confirmingNoChannel = true;
            StateHasChanged();
            return;
        }
        _noChannelAgreed = false;
        var attempt = _form.Snapshot();
        _autosave = Autosave.Saving;
        await SaveAsync(agent, quiet: true);
        _scheduled = null;
        if (_saveError is null) _autosave = Autosave.Idle;
        else
        {
            _autosave = Autosave.Failed;
            _failed = attempt;
            Toasts.Show(new ToastMessage($"We couldn't save that change to {agent.Name}.", $"{_saveError} Your change is still here.", ToastStatus.Error,
                "Try again", () => _ = InvokeAsync(() => AutosaveNowAsync(agent))));
        }
        StateHasChanged();
    }

    private async Task ConfirmNoChannelAsync()
    {
        _confirmingNoChannel = false;
        _noChannelAgreed = true;
        if (AiAgentsState.GetAgent(AgentId) is { } agent) await AutosaveNowAsync(agent);
        // They were leaving when it asked: saved, so on they go.
        if (_leaveTo is { } to && !Dirty) { _leaving = true; Nav.NavigateTo(to); }
    }

    // Kept a channel: the ones it answers on now come back.
    private void KeepChannels()
    {
        _confirmingNoChannel = false;
        _scheduled = null;
        _leaveTo = null;
        if (_form is null || AiAgentsState.GetAgent(AgentId) is not { } agent) return;
        foreach (var channel in agent.Channels.Where(c => c.IsEnabled)) _form.Channels.Add(channel.Key);
    }

    // Turned on from the end of its orientation: back on its page, which then shows it on.
    private async Task TurnOnFromTellingAsync(AiAgent agent)
    {
        await CloseTellingAsync(agent);
        await SetLiveAsync(agent, true);
    }

    private async Task SetLiveAsync(AiAgent agent, bool on)
    {
        if (_switching) return;
        _switching = true;
        try
        {
            // A settings save on its way puts its copy of the agent back when it lands; let it land first.
            await SettleAsync();
            agent = AiAgentsState.GetAgent(agent.Id) ?? agent;
            await AiAgentsState.SetLiveAsync(agent, on);
            Toasts.Show(on ? $"{agent.Name} is on." : $"{agent.Name} is off. It won't answer customers until you turn it on.");
        }
        // Refused with a reason (the AI service, while orientation isn't finished): its words rather than
        // "Try again", and its progress read again so the page agrees. A 401 here is not the owner's to fix.
        catch (ApiException exception) when (on && exception.ErrorCode is not null
                                              && exception.StatusCode is { } status && (int)status is >= 400 and < 500 and not 401)
        {
            Toasts.ShowError(exception.UserMessage);
            await LoadOrientationAsync(agent.Id);
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            Toasts.ShowError(on ? $"We couldn't turn {agent.Name} on. Try again." : $"We couldn't turn {agent.Name} off. Try again.");
        }
        finally
        {
            _switching = false;
        }
    }

