@page "/dashboard/ai-agents/{AgentId}"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@inject AiAgentsState AiAgentsState
@inject NavigationManager Nav
@inject ToastService Toasts

@* One agent, in Aurora's list-page idiom: a header with the identity, a tab
   tray, and a card per section. Parrot has no Aurora screen for this, so the
   structure is Parrot's and the dress is Aurora's. *@

@{
    var agent = AiAgentsState.GetAgent(AgentId);
}

<PageTitle>@(agent?.Name ?? "Agent") · AI Operations · OmniAI</PageTitle>

@if (agent is null)
{
    <main class="agent-detail">
        <EmptyState Glyph="IconName.RiRobot3Fill"
                    Title="Agent not found"
                    Description="This agent does not exist or has been deleted.">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick="BackToAgents">Back to agents</Button>
            </Action>
        </EmptyState>
    </main>
}
else
{
    <main class="agent-detail" @onclick="CloseMenus">
        <header class="agent-detail__header">
            <button type="button" class="agent-detail__back" @onclick="BackToAgents">
                <Icon Name="IconName.RiArrowLeftLine" Size="IconSize.Md" />
                <Typography TextStyle="TextStyle.Small12Semibold" As="span">Back to agents</Typography>
            </button>

            <div class="agent-detail__identity">
                <span class="agent-detail__avatar agent-tone-slate">
                    <img src="@AgentBuilderCopy.MascotImage(agent.Mascot)" alt="" />
                </span>
                <div class="agent-detail__titles">
                    <div class="agent-detail__name-row">
                        <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@agent.Name</Typography>
                        <StatusBadge Tone="@(agent.IsActive ? StatusTone.Success : StatusTone.Neutral)">
                            @(agent.IsActive ? "Active" : "Deactivated")
                        </StatusBadge>
                    </div>
                    <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="agent-detail__lede">
                        @(string.IsNullOrWhiteSpace(agent.Description) ? "—" : agent.Description)
                    </Typography>
                </div>
                <div class="agent-detail__actions">
                    <Button Variant="ButtonVariant.Secondary" @onclick="GoToBuilderCanvas">
                        <IconLeft><Icon Name="IconName.RiSparkling2Fill" /></IconLeft>
                        <ChildContent>Builder canvas</ChildContent>
                    </Button>
                    <Button @onclick="GoToOrientation">
                        <IconLeft><Icon Name="IconName.RiChatSmile3Fill" /></IconLeft>
                        <ChildContent>Give orientation</ChildContent>
                    </Button>
                </div>
            </div>
        </header>

        <div class="agent-detail__tabs" role="tablist" aria-label="Agent sections">
            @foreach (var tab in Tabs)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@((_activeTab == tab.Id).ToString().ToLowerInvariant())"
                        class="@(_activeTab == tab.Id ? "is-active" : null)"
                        @onclick="() => _activeTab = tab.Id">
                    <Icon Name="@tab.Glyph" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">@tab.Label</Typography>
                </button>
            }
        </div>

        @if (_activeTab == "overview")
        {
            <section class="agent-detail__stats" aria-label="Agent summary">
                @foreach (var stat in OverviewStats)
                {
                    <article>
                        <span class="agent-detail__stat-icon"><Icon Name="@stat.Glyph" Size="IconSize.Md" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">@stat.Value</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">@stat.Label</Typography>
                        </div>
                    </article>
                }
            </section>

            <section class="agent-detail__card">
                <header class="agent-detail__card-head">
                    <div>
                        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2">Default behaviour</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="p">Control how this agent handles conversations and automation.</Typography>
                    </div>
                </header>
                <div class="agent-detail__row">
                    <div class="agent-detail__row-text">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Human takeover</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>Allow a team member to step in and continue the conversation.</Typography>
                    </div>
                    <StatusBadge Tone="@(agent.HumanTakeover ? StatusTone.Success : StatusTone.Neutral)">
                        @(agent.HumanTakeover ? "Active" : "Inactive")
                    </StatusBadge>
                </div>
            </section>
        }

        @if (_activeTab == "playbooks")
        {
            @if (!agent.Playbooks.Any())
            {
                <section class="agent-detail__card agent-detail__empty">
                    <EmptyState Glyph="IconName.RiBookOpenFill"
                                Title="Create your first playbook"
                                Description="Playbooks define how this agent handles specific customer requests. Create structured workflows to guide conversations, collect information, and automate actions like orders, bookings, or notifications.">
                        <Action>
                            <Button @onclick="CreateNewPlaybook">
                                <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                                <ChildContent>Create playbook</ChildContent>
                            </Button>
                        </Action>
                    </EmptyState>
                    <div class="agent-detail__capabilities">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="p">What can a playbook do?</Typography>
                        <ul>
                            @foreach (var item in _playbookCapabilities)
                            {
                                <li>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                    <Typography TextStyle="TextStyle.Small12Regular" As="span" Prose>@item</Typography>
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            }
            else
            {
                <header class="agent-detail__section-head">
                    <div>
                        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2">Automation playbooks</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="p">Playbooks define how this agent handles specific customer requests.</Typography>
                    </div>
                    <Button @onclick="CreateNewPlaybook">
                        <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                        <ChildContent>Create playbook</ChildContent>
                    </Button>
                </header>

                <section class="agent-detail__table-wrap">
                    <div class="agent-detail__table" role="table" aria-label="Playbooks">
                        <div class="agent-detail__table-head" role="row">
                            @foreach (var column in PlaybookColumns)
                            {
                                <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline" role="columnheader">@column</Typography>
                            }
                            <span role="columnheader" aria-label="Actions"></span>
                        </div>
                        @foreach (var pb in agent.Playbooks)
                        {
                            var playbook = pb;
                            <div class="agent-detail__table-row" role="row" @onclick="() => OpenPlaybook(playbook.Id)">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" role="cell" Class="agent-detail__cell-title">@playbook.Title</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="span" role="cell" Class="agent-detail__cell-muted">@(string.IsNullOrWhiteSpace(playbook.Description) ? "—" : TruncateText(playbook.Description, 55))</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="span" role="cell">@playbook.StepCount</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="span" role="cell">@playbook.Execution</Typography>
                                <span role="cell">
                                    <StatusBadge Tone="@(playbook.Status == "Active" ? StatusTone.Success : StatusTone.Neutral)">@playbook.Status</StatusBadge>
                                </span>
                                <Typography TextStyle="TextStyle.Small12Regular" As="span" role="cell" Class="agent-detail__cell-muted">@playbook.DateCreated.ToString("dd MMM, yyyy • hh:mm tt")</Typography>
                                <span role="cell" class="agent-detail__row-menu" @onclick:stopPropagation="true">
                                    <Button Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Small"
                                            aria-label="@($"Actions for {playbook.Title}")"
                                            @onclick="() => TogglePbMenu(playbook.Id)">
                                        <IconLeft><Icon Name="IconName.RiMore2Fill" /></IconLeft>
                                    </Button>
                                    @if (_openPbMenu == playbook.Id)
                                    {
                                        <div class="agent-detail__menu" role="menu">
                                            <PopoverOption Label="Edit details" Description="Open the playbook builder" OnSelect="() => OpenPlaybook(playbook.Id)" />
                                            <PopoverOption Label="Duplicate" Description="Copy this playbook" OnSelect="() => DuplicatePlaybook(playbook)" />
                                            <PopoverOption Label="@(playbook.Status == "Active" ? "Deactivate" : "Activate")"
                                                           Description="@(playbook.Status == "Active" ? "Stop running this playbook" : "Start running this playbook")"
                                                           OnSelect="() => TogglePlaybookStatus(playbook)" />
                                        </div>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                    <footer class="agent-detail__pagination">
                        <Typography TextStyle="TextStyle.Small12Regular" As="span">Showing 1–@agent.Playbooks.Count of @agent.Playbooks.Count</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="span">Page 1 of 1</Typography>
                    </footer>
                </section>
            }
        }

        @if (_activeTab == "channels")
        {
            <section class="agent-detail__card">
                <header class="agent-detail__card-head">
                    <div>
                        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2">Connected channels</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="p">Assign messaging channels to this agent.</Typography>
                    </div>
                </header>
                @foreach (var ch in agent.Channels)
                {
                    var channel = ch;
                    <div class="agent-detail__row">
                        <AgentChannelGlyph Key="@channel.Key" />
                        <div class="agent-detail__row-text">
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@channel.Name</Typography>
                            <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>@channel.Description</Typography>
                        </div>
                        <Toggle AriaLabel="@($"Toggle {channel.Name}")"
                                Checked="channel.IsEnabled"
                                CheckedChanged="value => channel.IsEnabled = value" />
                    </div>
                }
            </section>
        }

        @if (_activeTab == "analytics")
        {
            <header class="agent-detail__section-head">
                <div>
                    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2">Agent performance</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Track how this AI agent is performing across conversations, tasks, and customer interaction.</Typography>
                </div>
            </header>

            <section class="agent-detail__stats" aria-label="Agent performance">
                @foreach (var stat in AnalyticsStats)
                {
                    <article>
                        <span class="agent-detail__stat-icon"><Icon Name="@stat.Glyph" Size="IconSize.Md" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">@stat.Value</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">@stat.Label</Typography>
                        </div>
                    </article>
                }
            </section>

            <div class="agent-detail__charts">
                <section class="agent-detail__card">
                    <header class="agent-detail__card-head">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Conversations over time</Typography>
                    </header>
                    <div class="agent-detail__hbars" role="img" aria-label="Conversations per day this week">
                        @foreach (var day in _convByDay)
                        {
                            <div class="agent-detail__hbar">
                                <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="agent-detail__hbar-label">@day.Day</Typography>
                                <div class="agent-detail__hbar-track"><div class="agent-detail__hbar-fill" style="width: @(Math.Round(day.Count * 100.0 / 200))%"></div></div>
                                <Typography TextStyle="TextStyle.Small12Semibold" As="span" Class="agent-detail__hbar-value">@day.Count</Typography>
                            </div>
                        }
                    </div>
                </section>

                <section class="agent-detail__card">
                    <header class="agent-detail__card-head">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Most triggered playbook</Typography>
                    </header>
                    <div class="agent-detail__vbars" role="img" aria-label="Runs per playbook">
                        <div class="agent-detail__vbar-axis">
                            @for (var tick = 700; tick >= 0; tick -= 100)
                            {
                                <Typography TextStyle="TextStyle.Small10Regular" As="span">@tick</Typography>
                            }
                        </div>
                        <div class="agent-detail__vbar-area">
                            <div class="agent-detail__vbar-plot">
                                <div class="agent-detail__vbar-grid">
                                    @for (var line = 0; line < 8; line++)
                                    {
                                        <div class="agent-detail__vbar-gridline"></div>
                                    }
                                </div>
                                <div class="agent-detail__vbar-columns">
                                    @foreach (var pb in _triggeredPlaybooks)
                                    {
                                        <div class="agent-detail__vbar-column">
                                            <div class="agent-detail__vbar-fill" style="height: @(Math.Round(pb.Count * 100.0 / 700))%"></div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="agent-detail__vbar-labels">
                                @foreach (var pb in _triggeredPlaybooks)
                                {
                                    <Typography TextStyle="TextStyle.Small10Regular" As="span">@pb.Name</Typography>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="agent-detail__donuts">
                @foreach (var share in _channelShare)
                {
                    <section class="agent-detail__card agent-detail__donut-card">
                        <div class="agent-detail__donut" style="--ds-donut-value: @share.Percent; --ds-donut-colour: var(@share.Token);">
                            <div class="agent-detail__donut-hole">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">@share.Percent%</Typography>
                            </div>
                        </div>
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@share.Label</Typography>
                    </section>
                }
            </div>
        }
    </main>
}

@code {
    [Parameter] public string AgentId { get; set; } = string.Empty;

    private sealed record Tab(string Id, string Label, IconName Glyph);
    private sealed record Stat(string Label, string Value, IconName Glyph);
    private sealed record DayCount(string Day, int Count);
    private sealed record PbCount(string Name, int Count);
    private sealed record ChannelShare(string Label, int Percent, string Token);

    private string _activeTab = "overview";
    private string _openPbMenu = string.Empty;

    private static readonly Tab[] Tabs =
    [
        new("overview", "Overview", IconName.RiHome5Fill),
        new("playbooks", "Playbooks", IconName.RiBookOpenFill),
        new("channels", "Channels", IconName.RiLinksFill),
        new("analytics", "Analytics", IconName.RiBarChartBoxFill)
    ];

    private static readonly string[] PlaybookColumns = ["Title", "Description", "Steps", "Execution", "Status", "Date created"];

    // The figures below are the ones Parrot's page already showed; Parrot has
    // no analytics source behind them yet.
    private static readonly Stat[] OverviewStats =
    [
        new("Conversations handled", "1,247", IconName.RiChat3Fill),
        new("Tasks created", "389", IconName.RiTaskFill),
        new("Avg response time", "1.2s", IconName.RiTimerFlashFill),
        new("Satisfaction score", "4.6 / 5", IconName.RiEmotionHappyFill)
    ];

    private static readonly Stat[] AnalyticsStats =
    [
        new("Conversations handled", "1,247", IconName.RiChat3Fill),
        new("Tasks created", "389", IconName.RiTaskFill),
        new("Avg response time", "1.2s", IconName.RiTimerFlashFill),
        new("Completion rate", "94%", IconName.RiBarChartBoxFill)
    ];

    private readonly string[] _playbookCapabilities =
    [
        "Trigger when customers send specific messages",
        "Ask questions and collect information",
        "Select items from your catalog",
        "Send confirmations and notifications",
        "Request payment or complete tasks"
    ];

    private readonly List<DayCount> _convByDay = new()
    {
        new("Mon", 163), new("Tue", 100), new("Wed", 120),
        new("Thu", 120), new("Fri", 120), new("Sat", 120), new("Sun", 45)
    };

    private readonly List<PbCount> _triggeredPlaybooks = new()
    {
        new("Place food order", 350),
        new("Delivery tracking", 590),
        new("Refund request", 640),
        new("Book table", 640)
    };

    private readonly List<ChannelShare> _channelShare = new()
    {
        new("WhatsApp Business", 62, "--colors-chart-chart-1"),
        new("Instagram", 62, "--colors-chart-chart-2"),
        new("facebook Marketplace", 62, "--colors-chart-chart-3")
    };

    private void CloseMenus() => _openPbMenu = string.Empty;

    private void TogglePbMenu(string id) => _openPbMenu = _openPbMenu == id ? string.Empty : id;

    private void BackToAgents() => Nav.NavigateTo("/dashboard/ai-agents");

    private void GoToOrientation() => Nav.NavigateTo($"/dashboard/ai-agents/{AgentId}/orientation");

    private void GoToBuilderCanvas() => Nav.NavigateTo($"/dashboard/ai-agents/{AgentId}/builder");

    private void OpenPlaybook(string pbId) => Nav.NavigateTo($"/dashboard/ai-agents/{AgentId}/playbooks/{pbId}");

    private void CreateNewPlaybook()
    {
        var agent = AiAgentsState.GetAgent(AgentId);
        if (agent is null) return;
        var pb = new Playbook { Id = Guid.NewGuid().ToString(), Title = "New Playbook", Status = "Draft" };
        agent.Playbooks.Add(pb);
        Nav.NavigateTo($"/dashboard/ai-agents/{AgentId}/playbooks/{pb.Id}");
    }

    private void DuplicatePlaybook(Playbook source)
    {
        var agent = AiAgentsState.GetAgent(AgentId);
        if (agent is null) return;
        agent.Playbooks.Add(new Playbook
        {
            Title = $"{source.Title} (copy)",
            Description = source.Description,
            StepCount = source.StepCount,
            Status = "Draft",
            TriggerPhrases = source.TriggerPhrases.ToList()
        });
        _openPbMenu = string.Empty;
        Toasts.Show($"{source.Title} was duplicated.");
    }

    private void TogglePlaybookStatus(Playbook playbook)
    {
        playbook.Status = playbook.Status == "Active" ? "Draft" : "Active";
        _openPbMenu = string.Empty;
    }

    private static string TruncateText(string text, int max) =>
        text.Length <= max ? text : text[..max] + "...";
}
