    private async Task LoadOrientationAsync(string agentId)
    {
        // Another agent: the last one's progress is not shown for it while this one's is read.
        if (_orientationFor != agentId) _orientation = null;
        _orientationFor = agentId;
        if (!OnAiOrientation) return;
        OrientationProgress? progress;
        try { progress = await Orientation.GetProgressAsync(agentId); }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception)) { progress = null; }
        // Another agent opened meanwhile: this one's answer is not its.
        if (_orientationFor == agentId) _orientation = progress;
    }

