@page "/ai-operations/{AgentId}"
@page "/dashboard/ai-agents/{AgentId}"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@using Parrot.Web.Features.Dashboard.AiAgents
@inject AiAgentsState AiAgentsState
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IBusinessKnowledge Knowledge
@inject AuthState AuthState
@inject AgentGate Gate
@inject IAiOperationsFeed Feed
@inject IAgentCapabilities Capabilities
@inject Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiState TeachAi
@inject Parrot.Web.Components.Pages.Dashboard.TeachAi.BusinessIntroState Intro
@inject Parrot.Web.Features.Dashboard.Knowledge.IKnowledgeMemory Memory
@inject IAgentBriefing Briefing
@implements IDisposable

@* One agent: who it is and whether it is on, then its day (what it did,
   what it needs from you, what it said), then how it is set up; the figures
   link to where the work is. (Playbooks are parked: see the project's
   playbooks research.)

   (13 October 2026): one row of tabs instead of Settings,
   each a part of how it works (Job description, Knowledge, Channels,
   Personality, Handover & safety), with one save bar across them.
   Revised 14 October (designer): the tabs are the page's sections, left
   under the name and pinned as it scrolls; every tab one column at the
   page's width; Test as a customer and Turn on in the header, for a draft
   too, and no checklist (business knowledge comes before the first agent);
   a draft opens on Overview.
   Revised again (designer, after an audit, 14 October): five tabs, each
   thing said once where it is changed. Overview has where it answers;
   Job has its job, its job description and what it can do; Knowledge is
   what it knows, shared with every agent (on its own, so business knowledge
   never reads as part of the job description); Personality; Handover &
   safety has when it brings you in and its limits. No Channels or Playbooks tabs, and no
   word of Playbooks on Overview either (designer). *@

@{
    var agent = AiAgentsState.GetAgent(AgentId);
}

<PageTitle>@(agent?.Name ?? "Agent") · AI Operations · OmniAI</PageTitle>

@if (!AiAgentsState.IsLoaded && !AiAgentsState.LoadFailed)
{
    <main class="agent-detail">
        <LoadingState Glyph="IconName.RiRobot3Fill" Title="Opening your agent" Description="Loading its day and settings." />
    </main>
}
else if (agent is null && AiAgentsState.LoadFailed)
{
    <main class="agent-detail">
        <EmptyState Glyph="IconName.RiErrorWarningFill"
                    Title="We couldn't load this agent"
                    Description="Check your connection and try again.">
            <Action>
                <Button Busy="AiAgentsState.IsLoading" @onclick="RetryLoadAsync">Try again</Button>
            </Action>
        </EmptyState>
    </main>
}
else if (agent is null)
{
    <main class="agent-detail">
        <EmptyState Glyph="IconName.RiRobot3Fill"
                    Title="Agent not found"
                    Description="This agent does not exist or has been deleted.">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick="BackToAgents">Back to agents</Button>
            </Action>
        </EmptyState>
    </main>
}
else
{
    <main class="agent-detail">
        <header class="agent-detail__header">
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="agent-detail__back" @onclick="BackToAgents">
                <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                <ChildContent>Back to agents</ChildContent>
            </Button>

            <div class="agent-detail__identity">
                <span class="agent-detail__avatar agent-tone-slate">
                    <img src="@AgentBuilderCopy.MascotImage(agent.Mascot)" alt="" />
                </span>
                <div class="agent-detail__titles">
                    <div class="agent-detail__name-row">
                        <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@agent.Name</Typography>
                        <StatusBadge Tone="@StatusToneOf(agent)">@StatusOf(agent)</StatusBadge>
                    </div>
                    @* Its job and where it answers, as the channels' marks so any
                       number of them stays one line; the description is in Settings. *@
                    <div class="agent-detail__job">
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Class="agent-detail__lede">
                            @AgentRole.NameOf(agent.Settings) · @(agent.ChannelCount == 0 ? "Not answering anywhere yet" : "Answers on")
                        </Typography>
                        @if (agent.ChannelCount > 0)
                        {
                            <ChannelStack Channels="ChannelKeys(agent)" />
                        }
                    </div>
                </div>
                @* On or off is the one thing an owner does here most; Edit opens Settings.
                   Test as a customer and Turn on, always here. *@
                <div class="agent-detail__actions">
                    @if (Briefing.CanTry)
                    {
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => _testing = true">
                            <IconLeft><Icon Name="IconName.RiChat3Fill" /></IconLeft>
                            <ChildContent>Test as a customer</ChildContent>
                        </Button>
                    }
                    @if (agent.IsActive && !agent.IsDraft)
                    {
                        <Button Variant="ButtonVariant.Secondary" Busy="_switching" @onclick="() => SetLiveAsync(agent, false)">Turn off</Button>
                    }
                    else if (Capabilities.CanReply)
                    {
                        <Button disabled="@(agent.ChannelCount == 0)" Busy="_switching"
                                title="@TurnOnTitle(agent)"
                                @onclick="() => SetLiveAsync(agent, true)">Turn on</Button>
                    }
                </div>
            </div>
        </header>

        @* Just turned on from setup: one line, where it is live, and what next. *@
        @if (Live == "1" && agent.IsActive && agent.ChannelCount > 0 && !_liveDismissed && _activeTab == "overview")
        {
            <section class="agent-detail__live" aria-labelledby="agent-live-title">
                <span class="agent-detail__live-icon"><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Md" /></span>
                <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-live-title" Class="agent-detail__live-title">
                    @agent.Name is live on <ChannelStack Channels="ChannelKeys(agent)" />
                </Typography>
                <div class="agent-detail__live-actions">
                    <Button Size="ButtonSize.Small" @onclick="OpenInbox">See its replies</Button>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Dismiss" title="Dismiss" @onclick="() => _liveDismissed = true">
                        <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
                    </Button>
                </div>
            </section>
        }

        @* The page's sections, words only, at reading size. *@
        <Tabs Label="Agent sections" Variant="TabsVariant.Underline" Class="agent-detail__tabs is-sections">
            @foreach (var tab in CurrentTabs)
            {
                var current = tab;
                <Tab Selected="@(_activeTab == tab.Id)" OnClick="() => _activeTab = current.Id">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">@tab.Label</Typography>
                </Tab>
            }
        </Tabs>

        @if (_activeTab == "overview")
        {
            @* Its day: is it doing the work, does it need me, what has it said. *@
            @if (!Feed.Available)
            {
                @* Real mode: no operations feed yet, so there is no day to show. *@
            }
            else if (!agent.IsActive || agent.IsDraft)
            {
                <section class="agent-detail__card agent-detail__quiet">
                    <span class="agent-detail__fact-icon"><Icon Name="IconName.RiPauseCircleFill" Size="IconSize.Md" /></span>
                    <div class="agent-detail__row-text">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@agent.Name isn't answering customers</Typography>
                        <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>Turn it on to see its day here: the conversations it replied to, what it passed to you and the tasks it created.</Typography>
                    </div>
                </section>
            }
            else if (agent.ChannelCount > 0)
            {
                var channel = ChannelFor(agent);
                var today = Feed.Today(agent, channel);
                <section class="agent-detail__today" aria-labelledby="agent-today-title">
                    <header class="agent-detail__section-head">
                        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2" id="agent-today-title">Today</Typography>
                        @* One menu instead of a table per channel, however many it
                           answers on: only for two or more. *@
                        @if (ChannelKeys(agent) is { Count: > 1 } keys)
                        {
                            <FilterPopover Label="@(channel is null ? "All channels" : ChannelStack.NameOf(channel))"
                                           Title="Channel"
                                           Subtitle="@($"Show {agent.Name}'s day on one channel")"
                                           Leading="@(channel is null ? null : ChannelMark(channel))"
                                           AlignEnd
                                           Open="_channelMenu"
                                           OpenChanged="open => _channelMenu = open">
                                <PopoverOption Label="All channels" Active="@(channel is null)" OnSelect="() => PickChannel(null)" />
                                @foreach (var key in keys)
                                {
                                    var current = key;
                                    <PopoverOption Label="@ChannelStack.NameOf(current)" Active="@(channel == current)" Leading="@(ChannelMark(current))" OnSelect="() => PickChannel(current)" />
                                }
                            </FilterPopover>
                        }
                    </header>
                    <div class="agent-detail__stats" aria-label="Today">
                        <RowButton Class="agent-detail__stat" OnClick="OpenInbox" aria-label="@($"{today.Conversations} conversations today. See them in the Inbox.")">
                            <span class="agent-detail__stat-icon is-conversations"><Icon Name="IconName.RiChat3Fill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.Conversations</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Conversations</Typography>
                            </span>
                        </RowButton>
                        <div class="agent-detail__stat">
                            <span class="agent-detail__stat-icon is-answered"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <span class="agent-detail__figure">
                                    <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.AnsweredAlone</Typography>
                                    @if (today.Conversations > 0)
                                    {
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="agent-detail__share">@today.AnsweredShare%</Typography>
                                    }
                                </span>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Answered on its own</Typography>
                            </span>
                        </div>
                        <RowButton Class="agent-detail__stat" OnClick="OpenInbox" aria-label="@($"{today.PassedToTeam} passed to your team. See them in the Inbox.")">
                            <span class="agent-detail__stat-icon is-passed"><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.PassedToTeam</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Passed to your team</Typography>
                                @if (today.TeamReplyMinutes is { } minutes)
                                {
                                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Class="agent-detail__note">Replied in @minutes min on average</Typography>
                                }
                            </span>
                        </RowButton>
                        <RowButton Class="agent-detail__stat" OnClick="OpenTasks" aria-label="@($"{today.TasksCreated} tasks created. See them in Task Requests.")">
                            <span class="agent-detail__stat-icon is-tasks"><Icon Name="IconName.RiTaskFill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.TasksCreated</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Tasks created</Typography>
                            </span>
                        </RowButton>
                    </div>
                </section>

                @if (Feed.Waiting(AiAgentsState.Agents).Where(q => q.AgentName == agent.Name).ToList() is { Count: > 0 } waiting)
                {
                    <section class="agent-detail__needs" aria-labelledby="agent-needs-title">
                        <span class="agent-detail__needs-icon"><Icon Name="IconName.RiQuestionAnswerFill" Size="IconSize.Md" /></span>
                        <div class="agent-detail__row-text">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-needs-title">
                                @(waiting.Count == 1 ? $"1 question {agent.Name} couldn't answer" : $"{waiting.Count} questions {agent.Name} couldn't answer")
                            </Typography>
                            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>“@waiting[0].Question” from @waiting[0].Customer@(waiting.Count > 1 ? $", and {waiting.Count - 1} more" : ""). Answer once and it will know next time.</Typography>
                        </div>
                        <Button Class="ds-no-shrink" @onclick="OpenInbox">Answer</Button>
                    </section>
                }

                <div class="agent-detail__pair">
                    <section class="agent-detail__card" aria-labelledby="agent-recent-title">
                        <header class="agent-detail__card-head">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-recent-title">Recent conversations</Typography>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OpenInbox">
                                <ChildContent>See all in Inbox</ChildContent>
                                <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                            </Button>
                        </header>
                        @{
                            var recent = Feed.Recent(agent, channel);
                        }
                        @if (recent.Count == 0)
                        {
                            <div class="agent-detail__recent-empty">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">No conversations yet</Typography>
                                <span class="agent-detail__recent-hint">
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span" Prose>They'll show here when customers message you on</Typography>
                                    <ChannelStack Channels="@(channel is null ? ChannelKeys(agent) : [channel])" />
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span" Prose>and @agent.Name replies.</Typography>
                                </span>
                            </div>
                        }
                        <ul class="agent-detail__recent">
                            @foreach (var chat in recent)
                            {
                                <li>
                                    <RowButton Class="agent-detail__recent-row" OnClick="OpenInbox">
                                        <ChannelIcon Channel="@chat.Channel" Size="IconSize.Md" />
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="agent-detail__recent-name">@chat.Customer</Typography>
                                        <StatusBadge Tone="@OutcomeTone(chat.Outcome)">@OutcomeText(chat)</StatusBadge>
                                        <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="agent-detail__recent-time">@Ago(chat.MinutesAgo)</Typography>
                                    </RowButton>
                                </li>
                            }
                        </ul>
                    </section>

                    <section class="agent-detail__card" aria-labelledby="agent-week-title">
                        <header class="agent-detail__card-head">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-week-title">Last 7 days</Typography>
                            @{
                                // Seven days even with no figures, so the shape is the same from day one.
                                var week = Feed.Week(agent, channel) is { Count: > 0 } days ? days : (IReadOnlyList<int>)Enumerable.Repeat(0, 7).ToList();
                                var peak = Math.Max(1, week.Max());
                            }
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="agent-detail__muted">@(week.All(n => n == 0) ? "Nothing yet" : "Conversations per day")</Typography>
                        </header>
                        <div class="agent-detail__week" role="img" aria-label="@($"Conversations per day: {string.Join(", ", week.Select((n, i) => $"{DayName(i, week.Count)} {n}"))}")">
                            @for (var i = 0; i < week.Count; i++)
                            {
                                // Copied out: the labels render after the loop has moved on.
                                var count = week[i];
                                var day = DayName(i, week.Count);
                                var isToday = i == week.Count - 1;
                                <div class="agent-detail__day @(isToday ? "is-today" : null)">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span" Class="agent-detail__day-value">@count</Typography>
                                    <span class="agent-detail__day-bar @(count == 0 ? "is-empty" : null)" style="--ds-detail-bar: @(Math.Round(count * 100.0 / peak))%"></span>
                                    <Typography TextStyle="@(isToday ? TextStyle.Small12Semibold : TextStyle.Small12Medium)" As="span" Class="agent-detail__day-name">@day</Typography>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            }

            @* Where it answers, then how it is set up: each row opens the tab where it is set. *@
                @* Where it answers, here rather than a tab of its own: the thing to
                   check before turning it on. *@
                @if (_form is not null)
                {
                    <div class="agent-detail__config agent-detail__where">
                        <AgentBasics Form="_form" Others="OthersThan(agent)" Channels="_channels" Tried="_tried" OnChange="StateHasChanged" ShowIdentity="false" ShowSafety="false" />
                    </div>
                }
                @* One line per tab, each opening it: the page's index, not a copy. *@
                <section class="agent-detail__card agent-detail__setup" aria-labelledby="agent-setup-title">
                    <header class="agent-detail__card-head">
                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-setup-title">How it's set up</Typography>
                    </header>
                    @SetupRow(AgentUseCase.Of(agent.Settings.UseCase)?.Icon ?? AgentRole.Of(agent.Settings.Role).Icon, "Its job", "What it does for your customers, and what it can do.", "job", "Job")
                    @if (Knowledge.Available && _form is not null)
                    {
                        @SetupRow(IconName.RiBookOpenFill, "What it knows", KnowsLine(_form), "knowledge", "Knowledge")
                    }
                    @SetupRow(IconName.RiChatSmile3Fill, "How it talks", $"{ToneWord(agent.Settings.Tone)} tone, {LengthWord(agent.Settings.Length)} replies.", "personality", "Personality")
                    @SetupRow(IconName.RiUserSharedFill, "When it brings you in", $"When it can't help. {AgentBasics.MoneyRule(agent.Settings)}.", "handover", "Handover & safety")
                </section>
        }

        @if (IsConfigTab(_activeTab) && _form is not null)
        {
            <div class="agent-detail__config">
                @switch (_activeTab)
                {
                    case "job":
                        @* What it is: its job and the kind of business, both chosen when it was made. *@
                        <section class="agent-detail__card" aria-label="Its job">
                            <div class="agent-detail__row">
                                <span class="agent-detail__fact-icon"><Icon Name="@(AgentUseCase.Of(_form.Settings.UseCase)?.Icon ?? AgentRole.Of(_form.Settings.Role).Icon)" Size="IconSize.Md" /></span>
                                <div class="agent-detail__row-text">
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@_form.RoleName</Typography>
                                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>Its main job.</Typography>
                                </div>
                                <FilterPopover Label="Change" Title="Its main job" AlignEnd Open="@(_menu == "job")" OpenChanged="JobMenu">
                                    @foreach (var useCase in AgentUseCase.All.Where(item => item.Id != AgentUseCase.Custom || _form.Settings.UseCase == AgentUseCase.Custom))
                                    {
                                        var current = useCase;
                                        <PopoverOption Label="@current.Name" Description="@current.Does" Active="@(_form.Settings.UseCase == current.Id)" OnSelect="() => ChooseUseCase(current)" />
                                    }
                                </FilterPopover>
                            </div>
                            <div class="agent-detail__row">
                                <span class="agent-detail__fact-icon"><Icon Name="IconName.RiStore2Fill" Size="IconSize.Md" /></span>
                                <div class="agent-detail__row-text">
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@(AgentIndustry.Of(_form.Settings.Industry)?.Name ?? "Kind of business not chosen")</Typography>
                                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@($"The kind of business {Business} is.")</Typography>
                                </div>
                                <FilterPopover Label="Change" Title="Kind of business" AlignEnd Open="@(_menu == "industry")" OpenChanged="IndustryMenu">
                                    @foreach (var industry in AgentIndustry.All)
                                    {
                                        var current = industry;
                                        <PopoverOption Label="@current.Name" Description="@current.Examples" Active="@(_form.Settings.Industry == current.Id)" OnSelect="() => ChooseIndustry(current)" />
                                    }
                                </FilterPopover>
                            </div>
                        </section>
                        <AgentJobEditor @ref="_jobEditor" Brief="JobBrief" Name="@_form.DisplayName" Mascot="@_form.Mascot" Settings="_form.Settings" OnChange="StateHasChanged" Fold
                                        UseCase="@_form.Settings.UseCase" CustomJob="@_form.Settings.CustomRole" Industry="@_form.Settings.Industry" Business="@Business" />
                        <section class="agent-detail__group" aria-labelledby="agent-can-title">
                            <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-can-title">What it can do</Typography>
                            <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Actions" ShowAlways="false" />
                        </section>
                        break;
                    case "knowledge":
                        @* The business's knowledge, shared by every agent: what this one uses
                           of it, what its job still needs, and the one way to add to it. *@
                        <section class="agent-detail__group" aria-labelledby="agent-knows-title">
                            <div class="agent-detail__group-row">
                                <div class="agent-detail__group-head">
                                    <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-knows-title">What it knows</Typography>
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@KnowsLine(_form)</Typography>
                                </div>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="ds-no-shrink" @onclick="@(() => Nav.NavigateTo("/dashboard/knowledge"))">
                                    <ChildContent>All business knowledge</ChildContent>
                                    <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                                </Button>
                            </div>
                            @if (Intro.CanAdd)
                            {
                                <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Knowledge" ShowNotes="false" Missing="Not added yet" OnAddKnowledge="Intro.AddMore" />
                            }
                            else
                            {
                                <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Knowledge" ShowNotes="false" Missing="Not added yet" />
                            }
                        </section>
                        break;
                    case "personality":
                        <AgentBasics Form="_form" Others="OthersThan(agent)" Channels="_channels" Tried="_tried" OnChange="StateHasChanged" ShowChannels="false" ShowSafety="false" />
                        <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Talk" MoreOptions />
                        break;
                    case "handover":
                        <section class="agent-detail__group" aria-labelledby="agent-handover-title">
                            <div class="agent-detail__group-head">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-handover-title">When it brings you in</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>It stops replying and passes the customer on, with the reason and a summary of the chat. It always does when a customer asks for a person.</Typography>
                            </div>
                            <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Handoff" ShowAlways="false" ShowWho />
                        </section>
                        <section class="agent-detail__group" aria-labelledby="agent-limits-title">
                            <div class="agent-detail__group-head">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-limits-title">Its limits</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>It only answers from what your business has told it. If it doesn't know something, it says so and checks with you.</Typography>
                            </div>
                            <div class="agent-detail__card agent-detail__limits">
                                <div class="agent-detail__limit">
                                    <Toggle Stretch Checked="@_form.Settings.CanOfferDiscounts" CheckedChanged="v => _form.Settings.CanOfferDiscounts = v" Label="Can offer discounts" Description="Otherwise it asks you first." />
                                </div>
                                <div class="agent-detail__limit">
                                    <Toggle Stretch Checked="@_form.Settings.CanApproveRefunds" CheckedChanged="v => _form.Settings.CanApproveRefunds = v" Label="Can approve refunds" Description="Otherwise it passes refunds to a person." />
                                </div>
                            </div>
                        </section>
                        break;
                }

            </div>
        }

        @* One save bar for the page, at its end, so it stays at the
           window's foot however long the tab (designer, 15 October). *@
        @if (Dirty && (IsConfigTab(_activeTab) || _activeTab == "overview"))
        {
            @SaveBar(agent)
        }
    </main>
}

@if (_form is not null && Briefing.CanTry)
{
    @* What is being edited is what is tested, saved or not. *@
    <AgentTestChat Open="_testing" OnClose="() => _testing = false"
                   Name="@_form.DisplayName" Mascot="@_form.Mascot" Business="@Business"
                   Brief="JobBrief" UseCase="@_form.Settings.UseCase" Industry="@_form.Settings.Industry"
                   OnChangeLine="ChangeLine" />
}


@* Leaving with unsaved changes asks first (tabs keep them): the rail, Back, or closing the tab. *@
<NavigationLock OnBeforeInternalNavigation="OnNavigating" ConfirmExternalNavigation="@(Dirty && !_leaving)" />

<Dialog Open="_confirmingLeave"
        Type="DialogType.Destructive"
        Title="Leave without saving?"
        ConfirmLabel="Leave"
        CancelLabel="Keep editing"
        OnCancel="() => _confirmingLeave = false"
        OnConfirm="Leave">
    <GlyphContent><Icon Name="IconName.RiErrorWarningFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>Your changes to @(_form?.DisplayName ?? "this agent") aren't saved. To keep them, stay and select Save changes.</p>
    </Body>
</Dialog>

@code {
    [Parameter] public string AgentId { get; set; } = string.Empty;

    // ?live=1: just turned on from setup.
    [SupplyParameterFromQuery(Name = "live")] public string? Live { get; set; }

    // ?tab=settings: sent here to change its settings (the card's menu).
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    // ?created=1: just created, as a draft.
    [SupplyParameterFromQuery(Name = "created")] public string? Created { get; set; }

    // ?test=1: "Test Ada" on the dashboard; the test chat opens, once.
    [SupplyParameterFromQuery(Name = "test")] public string? Test { get; set; }

    // ── Its sections ────────────────────────────────────────────────────────

    private static readonly Tab[] TabsB =
    [
        new("overview", "Overview", IconName.RiHome5Fill),
        new("job", "Job", IconName.RiFileTextFill),
        new("knowledge", "Knowledge", IconName.RiBookOpenFill),
        new("personality", "Personality", IconName.RiChatSmile3Fill),
        new("handover", "Handover & safety", IconName.RiUserSharedFill),
    ];

    // Knowledge only where there is a knowledge service to show.
    private IReadOnlyList<Tab> CurrentTabs => TabsB.Where(tab => tab.Id != "knowledge" || Knowledge.Available).ToList();

    private static bool IsConfigTab(string id) => id is "job" or "knowledge" or "personality" or "handover";

    private bool _testing, _createdDismissed, _reading, _openedOnJob, _createdSaid, _testAsked;
    private string? _menu;
    private void JobMenu(bool open) => _menu = open ? "job" : null;
    private void IndustryMenu(bool open) => _menu = open ? "industry" : null;
    private int _siteWaiting;
    private AgentJobEditor? _jobEditor;
    private string? _focusLine;

    // Every agent has a job description here; one set up before job descriptions starts from its description.
    private AgentBrief JobBrief => _form?.Settings.Brief ?? new();

    private void ChooseUseCase(AgentUseCase useCase)
    {
        if (_form is null) return;
        _form.Settings.UseCase = useCase.Id;
        _form.Settings.Role = useCase.Role;
        if (useCase.Role == AgentRoleTemplate.Custom && useCase.Id != AgentUseCase.Custom) _form.Settings.CustomRole = useCase.Name;
        _menu = null;
    }

    private async Task ChooseIndustry(AgentIndustry industry)
    {
        if (_form is null) return;
        _form.Settings.Industry = industry.Id;
        _menu = null;
        await Task.CompletedTask;
    }

    private async Task ReadWebsiteAsync()
    {
        if (_form is null || _reading) return;
        _reading = true;
        try
        {
            await Memory.ReadWebsiteAsync(_form.Settings.Website);
            await CountSiteAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or NotSupportedException)
        {
            Toasts.ShowError("We couldn't read that website. Check the address and try again.");
        }
        finally
        {
            _reading = false;
        }
    }

    // What was found on the website, still waiting for a yes.
    private async Task CountSiteAsync()
    {
        if (_form is null || !Memory.Available) return;
        var site = System.Text.RegularExpressions.Regex.Replace(_form.Settings.Website.Trim(), @"^(https?://)?(www\.)?", string.Empty).TrimEnd('/');
        if (site.Length == 0) { _siteWaiting = 0; return; }
        var snapshot = await Memory.ListAsync();
        _siteWaiting = snapshot.Facts.Count(fact => fact.Source == site && fact.State == Parrot.Web.Features.Dashboard.Knowledge.FactState.ToConfirm);
    }

    // "Change this", from the test chat: its sentence, on Job description.
    private void ChangeLine(string target)
    {
        _testing = false;
        _activeTab = "job";
        _focusLine = target;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLine is { } line && _jobEditor is not null)
        {
            _focusLine = null;
            _jobEditor.Focus(line);
        }
        if (_activeTab == "knowledge" && _countedFor != _formFor)
        {
            _countedFor = _formFor;
            await CountSiteAsync();
            StateHasChanged();
        }
    }

    private string? _countedFor;

    private bool _liveDismissed;
    private string? _appliedTab;

    // Settings: the agent being changed, as it was when last saved, and the
    // knowledge every agent shares.
    private AgentForm? _form;
    private string? _formFor;
    private string _saved = string.Empty;
    private bool _tried;
    private bool _knowledgeApproved;
    private IReadOnlyList<KnowledgeCard> _cards = [];
    private IReadOnlyList<AgentChannelChoice> _channels = [];

    private sealed record Tab(string Id, string Label, IconName Glyph);

    private string _activeTab = "overview";

    // A save or a switch on its way to the store, and a save that failed.
    private bool _saving;
    private bool _switching;
    private string? _saveError;

    // The channel the day is shown for; null is all of them.
    private string? _channel;
    private bool _channelMenu;

    protected override async Task OnInitializedAsync()
    {
        TeachAi.Changed += KnowledgeChanged;
        Intro.Changed += IntroChanged;
        AiAgentsState.Changed += OnAgentsChanged;
        await AiAgentsState.LoadAsync();
        ResetIfNew();
        await LoadKnowledgeAsync();
        // The channels it can answer on are the ones connected now.
        _channels = await Gate.ConnectedAsync();
    }

    private async Task RetryLoadAsync()
    {
        await AiAgentsState.LoadAsync(again: true);
        ResetIfNew();
    }

    private void ResetIfNew()
    {
        if (AiAgentsState.GetAgent(AgentId) is { } agent && _formFor != agent.Id) Reset(agent);
    }

    protected override void OnParametersSet()
    {
        if (TabQuery != _appliedTab)
        {
            _appliedTab = TabQuery;
            // B has no Settings tab: its settings start at the job; a link to a
            // tab it folded in opens where that now lives.
            var asked = TabQuery switch
            {
                "settings" => "job",
                "channels" or "playbooks" => "overview",
                _ => TabQuery,
            };
            if (CurrentTabs.Any(t => t.Id == asked)) _activeTab = asked!;
        }
        ResetIfNew();
        // Just created: said once, as a toast, not a banner over the page.
        if (Created == "1" && !_createdSaid && AiAgentsState.GetAgent(AgentId) is { IsDraft: true } created)
        {
            _createdSaid = true;
            Toasts.Show($"{created.Name} was created as a draft. It won't reply to anyone until you turn it on.");
        }
        if (Test == "1" && !_testAsked && Briefing.CanTry && AiAgentsState.GetAgent(AgentId) is not null)
        {
            _testAsked = true;
            _testing = true;
        }
    }

    // The business dialog closed (something added to the business's knowledge): read it again.
    private void IntroChanged() => _ = InvokeAsync(async () =>
    {
        if (Intro.IsOpen) return;
        await LoadKnowledgeAsync();
        StateHasChanged();
    });

    // "Teach more" closed: read the knowledge again, so the preview answers
    // from what was just taught.
    private void KnowledgeChanged() => _ = InvokeAsync(async () =>
    {
        if (TeachAi.IsOpen) return;
        await LoadKnowledgeAsync();
        StateHasChanged();
    });

    private async Task LoadKnowledgeAsync()
    {
        _knowledgeApproved = !Knowledge.Available || await Knowledge.HasApprovedAsync();
        _cards = Knowledge.Available ? await Knowledge.GetDraftAsync() : [];
        // The business's facts, sorted by topic (the Knowledge page): what the job's gaps are read from.
        try { _facts = Memory.Available ? (await Memory.ListAsync()).Facts : []; }
        catch (HttpRequestException) { _facts = []; }
    }

    private bool KnowledgeReady => !Knowledge.Available || _knowledgeApproved;

    private IReadOnlyList<Parrot.Web.Features.Dashboard.Knowledge.KnowledgeFact> _facts = [];

    // What its job asks about that the business hasn't covered yet: in its
    // facts (the Knowledge page) or in what Teach your AI confirmed.
    private IReadOnlyList<KnowledgeTopic> JobGaps(AgentForm form) =>
        AgentRole.Of(form.Settings.Role).Asks
            .Where(topic => !_facts.Any(fact => fact.Topic == topic && fact.State == Parrot.Web.Features.Dashboard.Knowledge.FactState.Known)
                         && !_cards.Any(card => card.Topic == topic && card.Status == KnowledgeStatus.Confirmed && card.HasContent && card.Source is not null))
            .ToList();

    private string GapLine(AgentForm form, IReadOnlyList<KnowledgeTopic> gaps)
    {
        var names = gaps.Select(GapName).ToList();
        var list = names.Count == 1 ? names[0] : $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]}";
        var job = AgentUseCase.Of(form.Settings.UseCase)?.Name ?? form.RoleName;
        return $"For {Lower(job)}, {form.DisplayName} also needs to know {list}.";
    }

    // Each topic as an owner would say it.
    private static string GapName(KnowledgeTopic topic) => topic switch
    {
        KnowledgeTopic.Products => "what you sell",
        KnowledgeTopic.Prices => "your prices",
        KnowledgeTopic.Delivery => "how delivery works",
        KnowledgeTopic.Payment => "how customers pay",
        KnowledgeTopic.Hours => "when you're open",
        KnowledgeTopic.Returns => "your returns policy",
        KnowledgeTopic.Handover => "who takes over when it can't help",
        _ => "a few more details",
    };

    private static string Lower(string text) => text.Length > 1 && char.IsUpper(text[0]) && char.IsLower(text[1]) ? char.ToLowerInvariant(text[0]) + text[1..] : text;

    private string BusinessLabel => string.IsNullOrWhiteSpace(Business) ? "your business" : Business;

    private IReadOnlyList<KnowledgeTopic> KnowledgeGaps(AiAgent agent)
    {
        var relevant = AgentRole.Of(agent.Settings.Role).Asks;
        return relevant.Where(topic => !_cards.Any(card => card.Topic == topic
            && card.Status == KnowledgeStatus.Confirmed && card.HasContent)).ToList();
    }

    private string KnowledgeReadinessLine(AiAgent agent)
    {
        if (!Knowledge.Available) return $"{agent.Name} can use the knowledge available to your workspace.";
        if (!_knowledgeApproved) return $"Check what we found about {BusinessLabel}, correct anything outdated and add what is missing.";

        var gaps = KnowledgeGaps(agent);
        if (gaps.Count == 0) return $"{agent.Name} can use the business knowledge you already approved. You only need to teach it once.";

        var names = gaps.Select(KnowledgeTopicName).ToList();
        var list = names.Count == 1 ? names[0] : $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]}";
        return $"Your shared knowledge is ready. Adding {list} would make {agent.Name} stronger for this job, but you can do that later.";
    }

    private static string KnowledgeTopicName(KnowledgeTopic topic) => topic switch
    {
        KnowledgeTopic.Products => "what you offer",
        KnowledgeTopic.Prices => "pricing",
        KnowledgeTopic.Delivery => "delivery",
        KnowledgeTopic.Payment => "payment",
        KnowledgeTopic.Hours => "opening hours",
        KnowledgeTopic.Returns => "returns",
        KnowledgeTopic.Handover => "who takes over",
        _ => "a few extra details",
    };

    private Task OpenKnowledgeAsync()
    {
        if (!Knowledge.Available) return Task.CompletedTask;
        if (_knowledgeApproved)
        {
            TeachAi.TeachMore();
            return Task.CompletedTask;
        }
        return TeachAi.RequireAsync(() => Task.CompletedTask);
    }

    private string TurnOnReadinessLine(AiAgent agent) =>
        agent.ChannelCount == 0 ? "Choose where it should answer under Channels."
        : !KnowledgeReady ? "Review and approve your business knowledge first."
        : $"Ready for new matching conversations on {AgentBuilderCopy.ChannelList(agent)}.";

    private string? TurnOnTitle(AiAgent agent) =>
        agent.ChannelCount == 0 ? "Choose where it answers first, on Overview."
        : null;

    // The agent's figures changed, possibly off the circuit's thread (a push
    // from the hub): draw again on it.
    private void OnAgentsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        TeachAi.Changed -= KnowledgeChanged;
        Intro.Changed -= IntroChanged;
        AiAgentsState.Changed -= OnAgentsChanged;
    }

    private string Business => AuthState.CurrentUser?.BusinessName ?? string.Empty;

    private bool Dirty => _form is not null && _form.Snapshot() != _saved;

    private IReadOnlyList<AiAgent> OthersThan(AiAgent agent) => AiAgentsState.Agents.Where(a => a.Id != agent.Id).ToList();

    private string SaveNote(AiAgent agent) =>
        _form is { HasRoleName: false } ? "Name its job."
        : _form is { HasName: false } ? "Give it a name."
        : _form is { Channels.Count: 0 } && agent.IsActive && !agent.IsDraft ? "With no channel chosen, it won't answer anyone."
        : "You have changes that aren't saved.";

    private void Reset(AiAgent agent)
    {
        _form = AgentForm.From(agent);
        _formFor = agent.Id;
        // A job description to edit, even for an agent set up without one (before job descriptions): its description to start.
        _form.Settings.Brief ??= new() { Summary = agent.Description };
        _saved = _form.Snapshot();
        _tried = false;
    }

    // The changes go onto a copy; the agent shown changes only once saved.
    private async Task SaveAsync(AiAgent agent)
    {
        _tried = true;
        if (_form is null || !_form.HasName || !_form.HasRoleName || _saving) return;
        var changed = AiAgentsState.Copy(agent);
        _form.ApplyTo(changed);
        _saving = true;
        _saveError = null;
        try
        {
            await AiAgentsState.SaveAsync(changed);
            _saved = _form.Snapshot();
            _tried = false;
            Toasts.Show($"Saved. {changed.Name} works this way from now on.");
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            _saveError = "We couldn't save your changes. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private bool _confirmingLeave, _leaving;
    private string? _leaveTo;

    // Tabs keep the changes; leaving the page would drop them, so it asks.
    private void OnNavigating(LocationChangingContext context)
    {
        if (!Dirty || _leaving) return;
        context.PreventNavigation();
        _leaveTo = context.TargetLocation;
        _confirmingLeave = true;
    }

    private void Leave()
    {
        _confirmingLeave = false;
        _leaving = true;
        if (_leaveTo is { } to) Nav.NavigateTo(to);
    }

    private void Discard(AiAgent agent)
    {
        _saveError = null;
        Reset(agent);
    }

    private async Task SetLiveAsync(AiAgent agent, bool on)
    {
        if (_switching) return;
        _switching = true;
        try
        {
            await AiAgentsState.SetLiveAsync(agent, on);
            Toasts.Show(on ? $"{agent.Name} is on." : $"{agent.Name} is off. It won't answer customers until you turn it on.");
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            Toasts.ShowError(on ? $"We couldn't turn {agent.Name} on. Try again." : $"We couldn't turn {agent.Name} off. Try again.");
        }
        finally
        {
            _switching = false;
        }
    }

    private static string ToneWord(AgentVoicePreset tone) => tone switch
    {
        AgentVoicePreset.Professional => "Professional",
        AgentVoicePreset.Upbeat => "Upbeat",
        _ => "Warm",
    };

    private static string LengthWord(AgentResponseLength length) => length switch
    {
        AgentResponseLength.Concise => "short",
        AgentResponseLength.Detailed => "detailed",
        _ => "balanced",
    };

    private static string StatusOf(AiAgent agent) => agent.IsDraft ? "Draft" : agent.IsActive ? "On" : "Off";

    private static StatusTone StatusToneOf(AiAgent agent) =>
        agent.IsDraft ? StatusTone.Neutral : agent.IsActive ? StatusTone.Success : StatusTone.Warning;

    // The channels it answers on, in the order owners see them everywhere
    // else; any channel added later follows the ones known today.
    private static IReadOnlyList<string> ChannelKeys(AiAgent agent) =>
        agent.Channels.Where(c => c.IsEnabled)
            .OrderBy(c => AgentBuilderCopy.Channels.ToList().FindIndex(k => string.Equals(k.Key, c.Key, StringComparison.OrdinalIgnoreCase)) is var i and >= 0 ? i : int.MaxValue)
            .Select(c => c.Key.ToLowerInvariant())
            .ToList();

    // The channel picked, while the agent still answers there.
    private string? ChannelFor(AiAgent agent) => _channel is not null && ChannelKeys(agent).Contains(_channel) ? _channel : null;

    private void PickChannel(string? key)
    {
        _channel = key;
        _channelMenu = false;
    }

    private static RenderFragment ChannelMark(string key) => __builder =>
    {
        <ChannelIcon Channel="@key" Size="IconSize.Sm" />
    };

    private string ChannelDetail(AiAgent agent)
    {
        // The Overview already says a draft isn't answering, so the row only names where.
        if (agent.IsDraft && agent.ChannelCount > 0) return $"{AgentBuilderCopy.ChannelList(agent)}.";
        var status = agent.IsDraft && !Capabilities.CanReply ? "A draft: it answers no one yet."
            : agent.IsDraft ? "A draft: it answers no one until you turn it on."
            : agent.IsActive ? "On now." : "Off: it answers no one until you turn it on.";
        // With nowhere to answer, "On now" would contradict the line above it.
        return agent.ChannelCount == 0 ? "Choose where it answers, on Overview." : $"{AgentBuilderCopy.ChannelList(agent)}. {status}";
    }

    private static StatusTone OutcomeTone(ConversationOutcome outcome) => outcome switch
    {
        ConversationOutcome.Answered => StatusTone.Success,
        ConversationOutcome.PassedToTeam => StatusTone.Info,
        _ => StatusTone.Neutral,
    };

    private static string OutcomeText(RecentConversation chat) => chat.Outcome switch
    {
        ConversationOutcome.Answered => "Answered",
        ConversationOutcome.PassedToTeam => "Passed to you",
        _ => $"Task: {chat.Task}",
    };

    private static string Ago(int minutes) =>
        minutes < 1 ? "Just now"
        : minutes < 60 ? $"{minutes} min ago"
        : minutes < 120 ? "1 hr ago"
        : $"{minutes / 60} hrs ago";

    // The week ends today: "Today" last, the six days before it by name.
    private static string DayName(int index, int count) =>
        index == count - 1 ? "Today" : DateTime.Today.AddDays(index - (count - 1)).ToString("ddd");

    // One plain sentence about how the agent works, under its icon.
    // A line of "How it's set up" that opens the tab where it is set.
    // One save bar for every tab with settings. A save that fails keeps every
    // change, and says so in the bar, where the person is looking.
    private RenderFragment SaveBar(AiAgent agent) => __builder =>
    {
        @* What is unsaved on the left; Discard, then Save, on the right. *@
        <footer class="agent-detail__save is-floating">
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="@(_saveError is null ? null : "is-error")" aria-live="polite">@(_saveError ?? SaveNote(agent))</Typography>
            <div class="agent-detail__save-actions">
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" disabled="@_saving" @onclick="() => Discard(agent)">Discard</Button>
                <Button Size="ButtonSize.Large" Busy="_saving" disabled="@(_form is null || !_form.HasName || !_form.HasRoleName)" @onclick="() => SaveAsync(agent)">Save changes</Button>
            </div>
        </footer>
    };

    // "Shared with all your agents.", then what this job still needs, if anything.
    private string KnowsLine(AgentForm form) =>
        Memory.Available && JobGaps(form) is { Count: > 0 } gaps
            ? $"Shared with all your agents. {GapLine(form, gaps)}"
            : "Shared with all your agents.";

    private RenderFragment SetupRow(IconName icon, string title, string detail, string tab, string tabName) => __builder =>
    {
        <RowButton Class="agent-detail__setup-row" OnClick="@(() => _activeTab = tab)" aria-label="@($"{title}. Open {tabName}.")">
            <span class="agent-detail__fact-icon"><Icon Name="@icon" Size="IconSize.Md" /></span>
            <span class="agent-detail__row-text">
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@title</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>@detail</Typography>
            </span>
            <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" Class="agent-detail__setup-go" />
        </RowButton>
    };


    private void BackToAgents() => Nav.NavigateTo("/ai-operations");

    private void OpenInbox() => Nav.NavigateTo("/dashboard/conversations");

    private void OpenTasks() => Nav.NavigateTo("/dashboard/task-requests");
}
