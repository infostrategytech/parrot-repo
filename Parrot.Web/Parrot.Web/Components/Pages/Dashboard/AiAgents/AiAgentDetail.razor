@page "/dashboard/ai-operations/{AgentId}"
@attribute [RequiresAccess(AccessRules.Agents)]
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@using Parrot.Web.Features.Dashboard.AiAgents
@using Microsoft.AspNetCore.Components.Sections
@inject AiAgentsState AiAgentsState
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IBusinessKnowledge Knowledge
@inject AuthState AuthState
@inject AgentGate Gate
@inject IAiOperationsFeed Feed
@inject IAgentCapabilities Capabilities
@inject IJSRuntime JS
@inject Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiState TeachAi
@inject Parrot.Web.Components.Pages.Dashboard.TeachAi.BusinessIntroState Intro
@inject Parrot.Web.Features.Dashboard.Knowledge.IKnowledgeMemory Memory
@inject IAgentBriefing Briefing
@inject JobConversationDrafts Drafts
@inject Parrot.Web.Features.Profile.ProfileClient Profile
@inject BusinessKind Kind
@inject AgentReadiness Readiness
@inject VoiceInterop Voice
@inject Parrot.Web.Features.Dashboard.Team.TeamClient TeamApi
@inject OrientationApi Orientation
@implements IDisposable

@* One agent: who it is and whether it is on, then its day (what it did,
   what it needs from you, what it said), then how it is set up; the figures
   link to where the work is. (Playbooks are parked: see the project's
   playbooks research.)

   Concept B (demo, 13 October 2026): one row of tabs instead of Settings,
   each a part of how it works (Job description, Knowledge, Channels,
   Personality, Handover & safety), with one save bar across them.
   Revised 14 October (designer): the tabs are the page's sections, left
   under the name and pinned as it scrolls; every tab one column at the
   page's width; Test as a customer and Turn on in the header, for a draft
   too, and no checklist (business knowledge comes before the first agent);
   a draft opens on Overview.
   Revised again (designer, after an audit, 14 October): five tabs, each
   thing said once where it is changed. Overview has where it answers;
   Job has its job, its job description and what it can do; Knowledge is
   what it knows, shared with every agent (on its own, so business knowledge
   never reads as part of the job description); Personality; Handover &
   safety has when it brings you in and its limits. No Channels or Playbooks tabs, and no
   word of Playbooks on Overview either (designer). *@

@{
    var agent = AiAgentsState.GetAgent(AgentId);
}

<PageTitle>@(agent?.Name ?? "Agent") · Agents · yára</PageTitle>

@if (!AiAgentsState.IsLoaded && !AiAgentsState.LoadFailed)
{
    <main class="agent-detail">
        <LoadingState Glyph="IconName.RiRobot3Fill" Title="Opening your agent" Description="Loading its day and settings." />
    </main>
}
else if (agent is null && AiAgentsState.LoadFailed)
{
    <main class="agent-detail">
        <EmptyState Glyph="IconName.RiErrorWarningFill"
                    Title="We couldn't load this agent"
                    Description="Check your connection and try again.">
            <Action>
                <Button Busy="AiAgentsState.IsLoading" @onclick="RetryLoadAsync">Try again</Button>
            </Action>
        </EmptyState>
    </main>
}
else if (agent is null)
{
    <main class="agent-detail">
        <EmptyState Glyph="IconName.RiRobot3Fill"
                    Title="Agent not found"
                    Description="This agent does not exist or has been deleted.">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick="BackToAgents">Back to agents</Button>
            </Action>
        </EmptyState>
    </main>
}
else
{
    @* is-demo: the demo's concept switch and theme toggle sit at the window's
       foot, so the floating save bar rises above them there. *@
    <main class="agent-detail">
        <header class="agent-detail__header">
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="agent-detail__back" @onclick="BackToAgents">
                <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                <ChildContent>Back to agents</ChildContent>
            </Button>

            <div class="agent-detail__identity">
                <span class="agent-detail__avatar"><AgentFace Look="@agent.Mascot" Reactive Floating /></span>
                <div class="agent-detail__titles">
                    <div class="agent-detail__name-row">
                        <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@agent.Name</Typography>
                        <StatusBadge Tone="@StatusToneOf(agent)">@StatusOf(agent)</StatusBadge>
                    </div>
                    @* Its job and where it answers, as the channels' marks so any
                       number of them stays one line; the description is in Settings. *@
                    <div class="agent-detail__job">
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Class="agent-detail__lede">
                            @AgentRole.NameOf(agent.Settings) · @(agent.ChannelCount == 0 ? "Not answering anywhere yet" : "Answers on")
                        </Typography>
                        @if (agent.ChannelCount > 0)
                        {
                            <ChannelStack Channels="ChannelKeys(agent)" />
                        }
                    </div>
                </div>
                @* On or off is the one thing an owner does here most; Edit opens Settings.
                   Concept B: Test as a customer and Turn on, always here. *@
                <div class="agent-detail__actions">
                    @if (Briefing.CanTry)
                    {
                        <Button Variant="ButtonVariant.Secondary" disabled="@(!Told(agent))" title="@(Told(agent) ? null : $"Tell {agent.Name} its job first")" @onclick="() => _testing = true">
                            <IconLeft><Icon Name="IconName.RiChat3Fill" /></IconLeft>
                            <ChildContent>Test as a customer</ChildContent>
                        </Button>
                    }
                    @if (agent.IsActive && !agent.IsDraft)
                    {
                        <Button Variant="ButtonVariant.Secondary" Busy="_switching" @onclick="() => SetLiveAsync(agent, false)">Turn off</Button>
                    }
                    else if (Capabilities.CanReply)
                    {
                        <Button disabled="@(agent.ChannelCount == 0 || !Taught(agent))" Busy="_switching"
                                title="@TurnOnTitle(agent)"
                                @onclick="() => SetLiveAsync(agent, true)">Turn on</Button>
                    }
                </div>
            </div>
        </header>

        @* Just turned on from setup: one line, where it is live, and what next. *@
        @if (Live == "1" && agent.IsActive && agent.ChannelCount > 0 && !_liveDismissed && _activeTab == "overview")
        {
            <section class="agent-detail__live" aria-labelledby="agent-live-title">
                <span class="agent-detail__live-icon"><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Md" /></span>
                <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-live-title" Class="agent-detail__live-title">
                    @agent.Name is live on <ChannelStack Channels="ChannelKeys(agent)" />
                </Typography>
                <div class="agent-detail__live-actions">
                    <Button Size="ButtonSize.Small" @onclick="OpenInbox">See its replies</Button>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Dismiss" title="Dismiss" @onclick="() => _liveDismissed = true">
                        <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
                    </Button>
                </div>
            </section>
        }

        @* Concept B: the page's sections, words only, at reading size. Every setting saves itself, quietly
           (designer, 11 November 2026: no Save changes, and no status in a corner); only a failed save says so. *@
        <Tabs Label="Agent sections" Variant="TabsVariant.Underline" Class="agent-detail__tabs is-sections">
            @foreach (var tab in CurrentTabs)
            {
                var current = tab;
                <Tab Selected="@(_activeTab == tab.Id)" OnClick="() => _activeTab = current.Id">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">@tab.Label</Typography>
                </Tab>
            }
        </Tabs>

        @if (_activeTab == "overview")
        {
            @* A draft, getting ready (designer, 19 October 2026): told its job first, then a test, then on. *@
            @if (agent.IsDraft)
            {
                var told = Told(agent);
                bool taught = Taught(agent);
                var progress = Drafts.ProgressOf(agent.Id);
                var onStep = Briefing.CanTry ? 3 : 2;
                <section class="agent-detail__card agent-detail__ready" aria-labelledby="agent-ready-title">
                    <header class="agent-detail__card-head">
                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-ready-title">@($"Get {agent.Name} ready")</Typography>
                    </header>
                    <ol class="agent-detail__ready-steps">
                        @if (OnAiOrientation)
                        {
                            @* Taught by the AI service (owner, 23 November 2026): how far along it is, and the way
                               back into its conversation, which stays open for more once it knows enough. *@
                            OrientationProgress? learned = _orientation;
                            bool done = learned?.Ready == true;
                            <li class="@($"agent-detail__ready-step {(done ? "is-done" : "is-now")}")">
                                <span class="agent-detail__ready-mark" aria-hidden="true">
                                    @if (done) { <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" /> } else { <Typography TextStyle="TextStyle.Small12Semibold" As="span">1</Typography> }
                                </span>
                                <div class="agent-detail__ready-text">
                                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="strong">@($"Tell {agent.Name} its job")</Typography>
                                    @if (learned is not null)
                                    {
                                        <ProgressBar Value="learned.Percent" Label="@OrientationProgressWords.Label(learned, agent.Name)" />
                                    }
                                    else
                                    {
                                        <Typography TextStyle="TextStyle.BodySmallMedium" As="small" Prose>What it does, what it never does, and when it brings you in, one topic at a time.</Typography>
                                    }
                                </div>
                                <Button Variant="@(done ? ButtonVariant.Ghost : ButtonVariant.Primary)" Size="ButtonSize.Small" @onclick="OpenTelling">
                                    @(done ? "Teach more" : learned is { Percent: > 0 } ? "Continue" : "Start")
                                </Button>
                            </li>
                        }
                        else
                        {
                        <li class="@($"agent-detail__ready-step {(told ? "is-done" : "is-now")}")">
                            <span class="agent-detail__ready-mark" aria-hidden="true">
                                @if (told) { <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" /> } else { <Typography TextStyle="TextStyle.Small12Semibold" As="span">1</Typography> }
                            </span>
                            <div class="agent-detail__ready-text">
                                <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="strong">@($"Tell {agent.Name} its job")</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="small" Prose>
                                    @(told ? "Done. Its job description is saved."
                                        : progress is not null ? "You've started. It picks up where you left off."
                                        : "What it does, what it never does, and when it brings you in, one topic at a time.")
                                </Typography>
                            </div>
                            <Button Variant="@(told ? ButtonVariant.Ghost : ButtonVariant.Primary)" Size="ButtonSize.Small" @onclick="@(() => { if (told) _activeTab = "job"; else OpenTelling(); })">
                                @(told ? "Change" : progress is null ? "Start" : "Continue")
                            </Button>
                        </li>
                        }
                        @if (Briefing.CanTry)
                        {
                            var tested = Readiness.Tested(agent.Id);
                            <li class="@($"agent-detail__ready-step {(!told ? "is-later" : tested ? "is-done" : "is-now")}{(told && !tested && _nextLit ? " is-lit" : null)}")">
                                <span class="agent-detail__ready-mark" aria-hidden="true">
                                    @if (tested) { <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" /> } else { <Typography TextStyle="TextStyle.Small12Semibold" As="span">2</Typography> }
                                </span>
                                <div class="agent-detail__ready-text">
                                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="strong">Test as a customer</Typography>
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="small" Prose>@(tested ? $"Done. You've seen how {agent.Name} replies." : $"See how {agent.Name} replies before any customer does.")</Typography>
                                </div>
                                <Button Variant="@(told && !tested ? ButtonVariant.Primary : ButtonVariant.Ghost)" Size="ButtonSize.Small" disabled="@(!told)" @onclick="() => { _nextLit = false; _testing = true; }">@(tested ? "Test again" : "Try it")</Button>
                            </li>
                        }
                        @{ bool turnOnNow = taught && (!Briefing.CanTry || Readiness.Tested(agent.Id)); }
                        <li class="@($"agent-detail__ready-step {(turnOnNow ? "is-now" : "is-later")}")">
                            <span class="agent-detail__ready-mark" aria-hidden="true"><Typography TextStyle="TextStyle.Small12Semibold" As="span">@onStep</Typography></span>
                            <div class="agent-detail__ready-text">
                                <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="strong">Turn it on</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="small" Prose>@TurnOnReadinessLine(agent)</Typography>
                            </div>
                            @if (Capabilities.CanReply)
                            {
                                <Button Variant="@(turnOnNow ? ButtonVariant.Primary : ButtonVariant.Secondary)" Size="ButtonSize.Small" Busy="_switching" disabled="@(agent.ChannelCount == 0 || !taught || !KnowledgeReady)"
                                        @onclick="() => SetLiveAsync(agent, true)">Turn on</Button>
                            }
                        </li>
                    </ol>
                </section>
            }
            @* Its day: is it doing the work, does it need me, what has it said. *@
            @if (Feed.Waiting(AiAgentsState.Agents).Where(q => InboxQuestionLinks.BelongsTo(q, agent, AiAgentsState.Agents)).ToList() is { Count: > 0 } inboxQuestions)
            {
                <section class="agent-detail__needs" aria-labelledby="agent-needs-title">
                    <span class="agent-detail__needs-icon"><Icon Name="IconName.RiQuestionAnswerFill" Size="IconSize.Md" /></span>
                    <div class="agent-detail__row-text">
                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-needs-title">@(inboxQuestions.Count == 1 ? "1 question needs your answer" : $"{inboxQuestions.Count} questions need your answer")</Typography>
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Questions for @agent.Name are handled in Inbox.</Typography>
                    </div>
                    <Button Variant="ButtonVariant.Secondary" Class="ds-no-shrink" @onclick="() => Nav.NavigateTo(InboxQuestionLinks.Review(inboxQuestions, agent.Id))">View in Inbox</Button>
                </section>
            }

            @if (!Feed.Available)
            {
                @* Real mode: no operations feed yet, so there is no day to show. *@
            }
            else if (agent.IsDraft)
            {
                @* A draft has no day yet: the ready card above says what comes next. *@
            }
            else if (!agent.IsActive)
            {
                <section class="agent-detail__card agent-detail__quiet">
                    <span class="agent-detail__fact-icon"><Icon Name="IconName.RiPauseCircleFill" Size="IconSize.Md" /></span>
                    <div class="agent-detail__row-text">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@agent.Name isn't answering customers</Typography>
                        <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@(OnAiOrientation && !Taught(agent) ? NotTaughtLine(agent) : "Turn it on to see its day here: the conversations it replied to, what it passed to you and the tasks it created.")</Typography>
                    </div>
                </section>
            }
            else if (agent.ChannelCount > 0)
            {
                var channel = ChannelFor(agent);
                var today = Feed.Today(agent, channel);
                <section class="agent-detail__today" aria-labelledby="agent-today-title">
                    <header class="agent-detail__section-head">
                        <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2" id="agent-today-title">Today</Typography>
                        @* One menu instead of a table per channel, however many it
                           answers on: only for two or more. *@
                        @if (ChannelKeys(agent) is { Count: > 1 } keys)
                        {
                            <FilterPopover Label="@(channel is null ? "All channels" : ChannelStack.NameOf(channel))"
                                           Title="Channel"
                                           Subtitle="@($"Show {agent.Name}'s day on one channel")"
                                           Leading="@(channel is null ? null : ChannelMark(channel))"
                                           AlignEnd
                                           Open="_channelMenu"
                                           OpenChanged="open => _channelMenu = open">
                                <PopoverOption Label="All channels" Active="@(channel is null)" OnSelect="() => PickChannel(null)" />
                                @foreach (var key in keys)
                                {
                                    var current = key;
                                    <PopoverOption Label="@ChannelStack.NameOf(current)" Active="@(channel == current)" Leading="@(ChannelMark(current))" OnSelect="() => PickChannel(current)" />
                                }
                            </FilterPopover>
                        }
                    </header>
                    <div class="agent-detail__stats" aria-label="Today">
                        <RowButton Class="agent-detail__stat" OnClick="OpenInbox" aria-label="@($"{today.Conversations} conversations today. See them in the Inbox.")">
                            <span class="agent-detail__stat-icon is-conversations"><Icon Name="IconName.RiChat3Fill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.Conversations</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Conversations</Typography>
                            </span>
                        </RowButton>
                        <div class="agent-detail__stat">
                            <span class="agent-detail__stat-icon is-answered"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <span class="agent-detail__figure">
                                    <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.AnsweredAlone</Typography>
                                    @if (today.Conversations > 0)
                                    {
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="agent-detail__share">@today.AnsweredShare%</Typography>
                                    }
                                </span>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Answered on its own</Typography>
                            </span>
                        </div>
                        <RowButton Class="agent-detail__stat" OnClick="OpenInbox" aria-label="@($"{today.PassedToTeam} passed to your team. See them in the Inbox.")">
                            <span class="agent-detail__stat-icon is-passed"><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.PassedToTeam</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Passed to your team</Typography>
                                @if (today.TeamReplyMinutes is { } minutes)
                                {
                                    <Typography TextStyle="TextStyle.Small12Medium" As="small" Class="agent-detail__note">Replied in @minutes min on average</Typography>
                                }
                            </span>
                        </RowButton>
                        <RowButton Class="agent-detail__stat" OnClick="OpenTasks" aria-label="@($"{today.TasksCreated} tasks created. See them in Tasks.")">
                            <span class="agent-detail__stat-icon is-tasks"><Icon Name="IconName.RiTaskFill" Size="IconSize.Md" /></span>
                            <span class="agent-detail__stat-text">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@today.TasksCreated</Typography>
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Tasks created</Typography>
                            </span>
                        </RowButton>
                    </div>
                </section>

                <div class="agent-detail__pair">
                    <section class="agent-detail__card" aria-labelledby="agent-recent-title">
                        <header class="agent-detail__card-head">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-recent-title">Recent conversations</Typography>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OpenInbox">
                                <ChildContent>See all in Inbox</ChildContent>
                                <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                            </Button>
                        </header>
                        @{
                            var recent = Feed.Recent(agent, channel);
                        }
                        @if (recent.Count == 0)
                        {
                            <div class="agent-detail__recent-empty">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">No conversations yet</Typography>
                                <span class="agent-detail__recent-hint">
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span" Prose>They'll show here when customers message you on</Typography>
                                    <ChannelStack Channels="@(channel is null ? ChannelKeys(agent) : [channel])" />
                                    <Typography TextStyle="TextStyle.Small12Medium" As="span" Prose>and @agent.Name replies.</Typography>
                                </span>
                            </div>
                        }
                        <ul class="agent-detail__recent">
                            @foreach (var chat in recent.Take(5))
                            {
                                <li>
                                    <RowButton Class="agent-detail__recent-row" OnClick="OpenInbox">
                                        <ChannelIcon Channel="@chat.Channel" Size="IconSize.Md" />
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="agent-detail__recent-name">@chat.Customer</Typography>
                                        <StatusBadge Tone="@OutcomeTone(chat.Outcome)">@OutcomeText(chat)</StatusBadge>
                                        <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="agent-detail__recent-time">@Ago(chat.MinutesAgo)</Typography>
                                    </RowButton>
                                </li>
                            }
                        </ul>
                    </section>

                    <section class="agent-detail__card" aria-labelledby="agent-week-title">
                        <header class="agent-detail__card-head">
                            <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-week-title">Last 7 days</Typography>
                            @{
                                // Seven days even with no figures, so the shape is the same from day one.
                                var week = Feed.Week(agent, channel) is { Count: > 0 } days ? days : (IReadOnlyList<int>)Enumerable.Repeat(0, 7).ToList();
                                var peak = Math.Max(1, week.Max());
                            }
                            <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="agent-detail__muted">@(week.All(n => n == 0) ? "Nothing yet" : "Conversations per day")</Typography>
                        </header>
                        <div class="agent-detail__week" role="img" aria-label="@($"Conversations per day: {string.Join(", ", week.Select((n, i) => $"{DayName(i, week.Count)} {n}"))}")">
                            @for (var i = 0; i < week.Count; i++)
                            {
                                // Copied out: the labels render after the loop has moved on.
                                var count = week[i];
                                var day = DayName(i, week.Count);
                                var isToday = i == week.Count - 1;
                                <div class="agent-detail__day @(isToday ? "is-today" : null)">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span" Class="agent-detail__day-value">@count</Typography>
                                    <span class="agent-detail__day-bar @(count == 0 ? "is-empty" : null)" style="--ds-detail-bar: @(Math.Round(count * 100.0 / peak))%"></span>
                                    <Typography TextStyle="@(isToday ? TextStyle.Small12Semibold : TextStyle.Small12Medium)" As="span" Class="agent-detail__day-name">@day</Typography>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            }

            @* Where it answers, then how it is set up: each row opens the tab where it is set. *@
                <Parrot.Web.Components.Pages.Dashboard.Tools.AgentTools AgentId="@agent.Id" AgentName="@agent.Name" UseCase="@agent.Settings.UseCase" SummaryOnly />
                @* Where it answers, here rather than a tab of its own: the thing to
                   check before turning it on. *@
                @if (_form is not null)
                {
                    <div class="agent-detail__config agent-detail__where">
                        <AgentBasics Form="_form" Others="OthersThan(agent)" Channels="_channels" Tried="_tried" OnChange="StateHasChanged" ShowIdentity="false" ShowSafety="false" />
                    </div>
                }
                @* One line per tab, each opening it: the page's index, not a copy. Not for a draft
                   (designer, 20 October 2026): getting it ready is all there is to read; the tabs are above. *@
                @if (!agent.IsDraft)
                {
                <section class="agent-detail__card agent-detail__setup" aria-labelledby="agent-setup-title">
                    <header class="agent-detail__card-head">
                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-setup-title">How it's set up</Typography>
                    </header>
                    @SetupRow(AgentUseCase.Of(agent.Settings.UseCase)?.Icon ?? AgentRole.Of(agent.Settings.Role).Icon, "Its job", "What it does for your customers, and what it can do.", "job", "Job")
                    @if (Knowledge.Available && _form is not null)
                    {
                        @SetupRow(IconName.RiBookOpenFill, "What it knows", KnowsLine(_form), "knowledge", "Knowledge")
                    }
                    @SetupRow(IconName.RiChatSmile3Fill, "How it talks", $"{ToneWord(agent.Settings.Tone)} tone, {LengthWord(agent.Settings.Length)} replies.", "personality", "Personality")
                    @SetupRow(IconName.RiUserSharedFill, "When it brings you in", $"When it can't help. {AgentBasics.MoneyRule(agent.Settings)}.", "handover", "Handover & safety")
                </section>
                }
        }

        @if (IsConfigTab(_activeTab) && _form is not null)
        {
            <div class="agent-detail__config">
                @switch (_activeTab)
                {
                    case "job":
                        var toldJob = Told(agent);
                        if (!toldJob)
                        {
                            @* Not told its job yet: it happens in a view of its own (designer, 19 October 2026). *@
                            var kept = Drafts.ProgressOf(agent.Id);
                            <section class="agent-detail__card agent-detail__job-empty">
                                <EmptyState Size="EmptyStateSize.Panel" Glyph="IconName.RiChatSmile3Fill"
                                            Title="@($"{agent.Name} doesn't know its job yet")"
                                            Description="@(kept is not null ? "You've started. It picks up where you left off." : $"Tell {agent.Name} what to do, what never to do, and when to bring you in. A few minutes, one topic at a time.")">
                                    <Action>
                                        <Button @onclick="OpenTelling">@(kept is null ? $"Tell {agent.Name} its job" : "Continue")</Button>
                                    </Action>
                                </EmptyState>
                            </section>
                            <section class="agent-detail__group" aria-labelledby="agent-can-title">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-can-title">What it can do</Typography>
                                <Parrot.Web.Components.Pages.Dashboard.Tools.AgentTools AgentId="@agent.Id" AgentName="@agent.Name" UseCase="@agent.Settings.UseCase" />
                            </section>
                        }
                        else
                        {
                            @* Its job (designer, 20 October 2026): what it does, read as one summary, and one way to
                               change it, telling it in its own view, where the change shows before it goes in. *@
                            <section class="agent-detail__card agent-detail__job-card" aria-labelledby="agent-job-title">
                                <header class="agent-detail__job-head">
                                    <span class="agent-detail__fact-icon"><Icon Name="@(AgentUseCase.Of(_form.Settings.UseCase)?.Icon ?? AgentRole.Of(_form.Settings.Role).Icon)" Size="IconSize.Md" /></span>
                                    <div class="agent-detail__row-text">
                                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="agent-job-title">@($"{agent.Name}'s job")</Typography>
                                        <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@_form.RoleName</Typography>
                                    </div>
                                    <div class="agent-detail__job-actions">
                                        @if (_canSpeak)
                                        {
                                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" aria-pressed="@(_hearing ? "true" : "false")" @onclick="HearJobAsync">
                                                <IconLeft><Icon Name="@(_hearing ? IconName.RiStopFill : IconName.RiPlayFill)" /></IconLeft>
                                                <ChildContent>@(_hearing ? "Stop" : "Hear it")</ChildContent>
                                            </Button>
                                        }
                                        <Button Size="ButtonSize.Small" @onclick="() => OpenUpdateAsync()">
                                            <IconLeft><Icon Name="IconName.RiPencilFill" /></IconLeft>
                                            <ChildContent>@($"Update {agent.Name}'s job")</ChildContent>
                                        </Button>
                                    </div>
                                </header>
                                @* A long job reads as its first lines, with Show all (designer, 2 November 2026), so
                                   what it can do stays in view; hearing it, or a change just made, shows all of it. *@
                                @{ var clamped = !_jobOpen && !_hearing && _freshLines.Count == 0; }
                                <div class="@(clamped ? "agent-detail__job-body is-clamped" : "agent-detail__job-body")">
                                    @JobSummary(JobBrief, _freshLines, null, aloud: true)
                                    @if ((_jobOverflows || _jobOpen) && !_hearing && _freshLines.Count == 0)
                                    {
                                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="agent-detail__job-more" aria-expanded="@(_jobOpen ? "true" : "false")" @onclick="() => _jobOpen = !_jobOpen">@(_jobOpen ? "Show less" : "Show all")</Button>
                                    }
                                </div>
                            </section>
                            <section class="agent-detail__group" aria-labelledby="agent-can-title">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-can-title">What it can do</Typography>
                                <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Actions" ShowAlways="false" />
                                @* Its tools are things it can do too, so they're listed here, not as a section of their own (designer, 2 November 2026). *@
                                <Parrot.Web.Components.Pages.Dashboard.Tools.AgentTools AgentId="@agent.Id" AgentName="@agent.Name" UseCase="@agent.Settings.UseCase" />
                            </section>
                        }
                        break;
                    case "knowledge":
                        @* The business's knowledge, shared by every agent: what this one uses
                           of it, what its job still needs, and the one way to add to it. *@
                        <section class="agent-detail__group" aria-labelledby="agent-knows-title">
                            <div class="agent-detail__group-row">
                                <div class="agent-detail__group-head">
                                    <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-knows-title">What it knows</Typography>
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@KnowsLine(_form)</Typography>
                                </div>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="ds-no-shrink" @onclick="@(() => Nav.NavigateTo("/dashboard/knowledge"))">
                                    <ChildContent>All business knowledge</ChildContent>
                                    <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                                </Button>
                            </div>
                            @if (Intro.CanAdd)
                            {
                                <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Knowledge" ShowNotes="false" Missing="Not added yet" OnAddKnowledge="Intro.AddMore" />
                            }
                            else
                            {
                                <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Knowledge" ShowNotes="false" Missing="Not added yet" />
                            }
                        </section>
                        break;
                    case "personality":
                        <AgentBasics Form="_form" Others="OthersThan(agent)" Channels="_channels" Tried="_tried" OnChange="StateHasChanged" ShowChannels="false" ShowSafety="false" />
                        <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Talk" MoreOptions />
                        break;
                    case "handover":
                        <section class="agent-detail__group" aria-labelledby="agent-handover-title">
                            <div class="agent-detail__group-head">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-handover-title">@(Solo ? "When it brings you in" : "When it brings in your team")</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>It stops replying and passes the customer on, with the reason and a summary of the chat. It always does when a customer asks for a person.</Typography>
                            </div>
                            <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" Only="AgentTopic.Handoff" ShowAlways="false" ShowWho
                                           Team="_handoverTeam" CanInvite="@(AuthState.CurrentUser?.IsOwner == true)" />
                        </section>
                        <section class="agent-detail__group" aria-labelledby="agent-limits-title">
                            <div class="agent-detail__group-head">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2" id="agent-limits-title">Its limits</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@($"It only answers from what your business has told it. If it doesn't know something, it says so and checks with {(Solo ? "you" : "your team")}.")</Typography>
                            </div>
                            @* Asking first goes to whoever it brings in (above), so who decides is set in one place. *@
                            <div class="agent-detail__card agent-detail__limits">
                                <div class="agent-detail__limit">
                                    <Toggle Stretch Checked="@_form.Settings.CanOfferDiscounts" CheckedChanged="v => _form.Settings.CanOfferDiscounts = v" Label="Can offer discounts" Description="@($"Otherwise it asks {AsksWho} first.")" />
                                </div>
                                <div class="agent-detail__limit">
                                    <Toggle Stretch Checked="@_form.Settings.CanApproveRefunds" CheckedChanged="v => _form.Settings.CanApproveRefunds = v" Label="Can approve refunds" Description="@($"Otherwise it passes refunds to {AsksWho}.")" />
                                </div>
                            </div>
                        </section>
                        break;
                }

            </div>
        }

    </main>
}

@if (_form is not null && AiAgentsState.GetAgent(AgentId) is { } telling)
{
    var told = Told(telling);
    <FocusView Open="_telling" Title="@ViewTitle(telling)" OnClose="() => CloseViewAsync(telling)" Busy="_saving" Class="agent-detail__telling">
        <Center>
            @if (!_toldNow && _jobView != JobView.Update)
            {
                <SectionOutlet SectionName="@TellTopics" />
            }
        </Center>
        <ChildContent>
            @if (_toldNow && told)
            {
                @* The end (designer, 19 October 2026): it knows its job. What it will do, in its job
                   description's own sentences (still what they're approving), and the way on. *@
                <section class="agent-detail__told" aria-labelledby="agent-told-title">
                    @* Given its job: it arrives at Done, a success (designer, 10 November 2026), with its
                       green tick and the happy turn once its face is in. *@
                    <div class="agent-detail__told-face" aria-hidden="true">
                        <AgentFace Look="@telling.Mascot" State="PresenceAvatarState.Done" Reactive Floating Celebrate CueDelay="320" />
                    </div>
                    <Typography TextStyle="TextStyle.HeadingH2Bold" As="h2" id="agent-told-title">@KnowsTitle(telling)</Typography>
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose Class="agent-detail__told-lede">@($"Here's what you told {telling.Name}:")</Typography>
                    @{ var toldLines = JobBrief.Sentences() ?? []; }
                    <ul class="agent-detail__told-list">
                        @foreach (var (sentence, index) in toldLines.Take(ToldShown).Select((sentence, index) => (sentence, index)))
                        {
                            <li style="@($"--ds-told-at: {index}")">
                                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose>@sentence</Typography>
                            </li>
                        }
                    </ul>
                    @if (toldLines.Count > ToldShown)
                    {
                        @* The rest are in its job description, a click away. *@
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="agent-detail__told-more" style="@($"--ds-told-at: {ToldShown}")" @onclick="@(() => FinishTelling("job"))">@($"And {toldLines.Count - ToldShown} more, in its job description")</Button>
                    }
                    @if (_toldNote is { Length: > 0 } note)
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="agent-detail__told-note">@note</Typography>
                    }
                    <div class="agent-detail__told-actions">
                        @* On to its Overview: the next step waits there, lit (designer, 20 October 2026). *@
                        <Button Size="ButtonSize.Large" @onclick="SeeWhatsNext">See what's next</Button>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Large" @onclick="@(() => FinishTelling("job"))">Change something</Button>
                    </div>
                </section>
            }
            else if (_jobView == JobView.Update)
            {
                @* Updating it (designer, 20 October 2026): its job now, to talk about, and its main job, to change
                   by telling it its new one; then what's changed, shown before it goes in. *@
                <div class="agent-detail__update-now">
                    <div class="agent-detail__update-head">
                        <Typography TextStyle="TextStyle.Small12Semibold" As="h3" Class="agent-detail__update-label">Its job now</Typography>
                        <FilterPopover Label="@($"Main job: {_form.RoleName}")" Title="Its main job" Subtitle="@($"Pick a new one and {telling.Name} asks you about it. Its job stays as it is until you finish.")" AlignEnd Open="@(_menu == "job")" OpenChanged="JobMenu">
                            @foreach (var useCase in AgentUseCase.All.Where(item => item.Id != AgentUseCase.Custom || _form.Settings.UseCase == AgentUseCase.Custom))
                            {
                                var current = useCase;
                                <PopoverOption Label="@current.Name" Active="@(_form.Settings.UseCase == current.Id)" OnSelect="() => StartNewJob(current)" />
                            }
                        </FilterPopover>
                    </div>
                    @JobSummary(JobBrief, [], _focusLine)
                </div>
                <AgentJobEditor @key="@($"update-{telling.Id}")" Brief="JobBrief" Name="@_form.DisplayName" Mascot="@_form.Mascot" Settings="_form.Settings" OnChange="StateHasChanged"
                                UseCase="@_form.Settings.UseCase" CustomJob="@_form.Settings.CustomRole" Industry="@(_form.Settings.Industry ?? Kind.Id)" Business="@Business"
                                HideSummary OnUpdated="update => JobUpdatedAsync(telling, update)" />
            }
            else
            {
            var newJob = _jobView == JobView.NewJob && _newSettings is not null;
            var settings = newJob ? _newSettings! : _form.Settings;
            if (!told || newJob)
            {
                <div class="agent-detail__job-intro">
                    <Typography TextStyle="TextStyle.HeadingH2Bold" As="h2">@(newJob ? $"{Greeting}. Let's talk about my new job." : $"{Greeting}, I'm {telling.Name}.") <span class="agent-detail__job-ask">@JobAsk(settings.UseCase)</span></Typography>
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose Class="agent-detail__job-lede">@(newJob ? "Until we finish, my job stays as it is." : "One topic at a time. Leave whenever you like.")</Typography>
                </div>
            }
            @if (Knowledge is OrientationBusinessKnowledge && !newJob)
            {
                @* With the AI service's orientation on, the same conversation runs on the AI itself:
                   its ElevenLabs call, its typed answers and its question cards. Once the AI says
                   it knows enough, Turn on is right there; the AI being ready stands in for "told". *@
                <OmniJobConversation @key="@($"omni-{telling.Id}")" AgentId="@telling.Id" Name="@_form.DisplayName" Mascot="@_form.Mascot">
                    <WhenReady>
                        @if (Capabilities.CanReply && !(telling.IsActive && !telling.IsDraft))
                        {
                            <Button Size="ButtonSize.Small" Busy="_switching" disabled="@(telling.ChannelCount == 0)"
                                    @onclick="() => TurnOnFromTellingAsync(telling)">@($"Turn on {telling.Name}")</Button>
                            @* Said, not only on hover: a phone has no hover. *@
                            @if (telling.ChannelCount == 0)
                            {
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">Choose where it answers first, on Overview.</Typography>
                            }
                        }
                    </WhenReady>
                </OmniJobConversation>
            }
            else
            {
            <AgentJobEditor @key="@(newJob ? $"new-{settings.UseCase}" : $"tell-{telling.Id}")" Brief="@(settings.Brief ?? JobBrief)" Name="@_form.DisplayName" Mascot="@_form.Mascot" Settings="settings" OnChange="StateHasChanged"
                            UseCase="@settings.UseCase" CustomJob="@settings.CustomRole" Industry="@(settings.Industry ?? Kind.Id)" Business="@Business"
                            DraftKey="@(newJob ? null : telling.Id)" OnWritten="noted => newJob ? NewJobToldAsync(telling, noted) : JobToldAsync(telling, noted)"
                            TopicsSection="@TellTopics" HideSummary />
            }
            }
        </ChildContent>
    </FocusView>
}

@if (_form is not null && Briefing.CanTry)
{
    @* What is being edited is what is tested, saved or not. *@
    <AgentTestChat Open="_testing" OnClose="() => _testing = false"
                   Name="@_form.DisplayName" Mascot="@_form.Mascot" Business="@Business"
                   Brief="JobBrief" UseCase="@_form.Settings.UseCase" Industry="@(_form.Settings.Industry ?? Kind.Id)"
                   OnChangeLine="ChangeLine" OnReplied="() => Readiness.MarkTested(AgentId)" />
}


@* Leaving saves a change still waiting first; only one that can't be saved (no name, no connection) asks. *@
<NavigationLock OnBeforeInternalNavigation="OnNavigatingAsync" ConfirmExternalNavigation="@(Dirty && !_leaving)" />

<Dialog Open="_confirmingLeave"
        Type="DialogType.Destructive"
        Title="Leave without saving?"
        ConfirmLabel="Leave"
        CancelLabel="Keep editing"
        OnCancel="() => _confirmingLeave = false"
        OnConfirm="Leave">
    <GlyphContent><Icon Name="IconName.RiErrorWarningFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>@(_autosave == Autosave.Blocked ? $"{BlockedNote} Your last change to {_form?.DisplayName ?? "this agent"} isn't saved yet." : $"Your last change to {_form?.DisplayName ?? "this agent"} couldn't be saved. Stay to try again.")</p>
    </Body>
</Dialog>

@* A live agent with no channel left would stop answering everyone: the one change that asks first. *@
<Dialog Open="_confirmingNoChannel"
        Type="DialogType.Destructive"
        Title="@($"Stop {(_form?.DisplayName ?? "it")} answering everywhere?")"
        ConfirmLabel="Stop answering"
        CancelLabel="Keep a channel"
        OnCancel="KeepChannels"
        OnConfirm="ConfirmNoChannelAsync">
    <GlyphContent><Icon Name="IconName.RiErrorWarningFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>With no channel, it won't answer any customer until you choose one again.</p>
    </Body>
</Dialog>

@code {
    [Parameter] public string AgentId { get; set; } = string.Empty;

    // ?live=1: just turned on from setup.
    [SupplyParameterFromQuery(Name = "live")] public string? Live { get; set; }

    // ?tab=settings: sent here to change its settings (the card's menu).
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    // ?created=1: just created in Concept B's flow, as a draft.
    [SupplyParameterFromQuery(Name = "created")] public string? Created { get; set; }

    // ?test=1: "Test Ada" on the dashboard; the test chat opens, once.
    [SupplyParameterFromQuery(Name = "test")] public string? Test { get; set; }

    // Telling it its job, in the view of its own: opened only from Start (Overview) or the Job tab, never by itself.
    private bool _telling;

    // What the view is doing: telling it its job the first time, updating it, or telling it a new main job.
    private enum JobView { Tell, Update, NewJob }
    private JobView _jobView = JobView.Tell;

    // A new main job being told: its settings, kept apart until it's finished (closing leaves everything as it was).
    private AgentSettings? _newSettings;

    // The last update, for its Undo, and the sentences it added, lit for a moment in the summary.
    private AgentJobEditor.JobUpdate? _lastUpdate;
    private IReadOnlyCollection<string> _freshLines = [];

    // Hear it: its job description read aloud, each sentence reached lighting in turn.
    private bool _canSpeak, _hearing, _jobOpen, _jobOverflows;
    // Show all only when the job runs past its four lines at the width it has now (designer, 3 November 2026).
    private IJSObjectReference? _textFit;
    private int _readKey;
    private ElementReference _summaryText;
    private VoiceSpeech? _speech;
    private DotNetObjectReference<AiAgentDetail>? _self;

    // ── Its sections ────────────────────────────────────────────────────────

    private static readonly Tab[] TabsB =
    [
        new("overview", "Overview", IconName.RiHome5Fill),
        new("job", "Job", IconName.RiFileTextFill),
        new("knowledge", "Knowledge", IconName.RiBookOpenFill),
        new("personality", "Personality", IconName.RiChatSmile3Fill),
        new("handover", "Handover & safety", IconName.RiUserSharedFill),
    ];

    // Knowledge only where there is a knowledge service to show.
    private IReadOnlyList<Tab> CurrentTabs => TabsB.Where(tab => tab.Id != "knowledge" || Knowledge.Available).ToList();

    private static bool IsConfigTab(string id) => id is "job" or "knowledge" or "personality" or "handover";

    private bool _testing, _createdDismissed, _reading, _openedOnJob, _createdSaid, _testAsked;
    private string? _menu;
    private void JobMenu(bool open) => _menu = open ? "job" : null;
    private int _siteWaiting;
    // A sentence to change, from the test chat ("Change this"): marked in its job now, in the update view.
    private string? _focusLine;

    // Every agent has a job description here; one set up in Concept A starts from its description.
    private AgentBrief JobBrief => _form?.Settings.Brief ?? new();

    // A new main job, from the update view: it's told its new job, its own topics, on a copy of its settings with
    // no job description yet; finished, that copy becomes its settings. Until then nothing about it changes.
    private void StartNewJob(AgentUseCase useCase)
    {
        _menu = null;
        if (_form is null || useCase.Id == _form.Settings.UseCase) return;
        var settings = _form.Settings.Copy();
        settings.UseCase = useCase.Id;
        settings.Role = useCase.Role;
        if (useCase.Role == AgentRoleTemplate.Custom && useCase.Id != AgentUseCase.Custom) settings.CustomRole = useCase.Name;
        settings.Brief = new AgentBrief();
        _newSettings = settings;
        _focusLine = null;
        _jobView = JobView.NewJob;
    }

    private async Task ReadWebsiteAsync()
    {
        if (_form is null || _reading) return;
        _reading = true;
        try
        {
            await Memory.ReadWebsiteAsync(_form.Settings.Website);
            await CountSiteAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or NotSupportedException)
        {
            Toasts.ShowError("We couldn't read that website. Check the address and try again.");
        }
        finally
        {
            _reading = false;
        }
    }

    // What was found on the website, still waiting for a yes.
    private async Task CountSiteAsync()
    {
        if (_form is null || !Memory.Available) return;
        var site = System.Text.RegularExpressions.Regex.Replace(_form.Settings.Website.Trim(), @"^(https?://)?(www\.)?", string.Empty).TrimEnd('/');
        if (site.Length == 0) { _siteWaiting = 0; return; }
        var snapshot = await Memory.ListAsync();
        _siteWaiting = snapshot.Facts.Count(fact => fact.Source == site && fact.State == Parrot.Web.Features.Dashboard.Knowledge.FactState.ToConfirm);
    }

    // "Change this", from the test chat: the update view, that sentence marked in its job now.
    private async Task ChangeLine(string target)
    {
        _testing = false;
        _activeTab = "job";
        await OpenUpdateAsync(target);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        ScheduleAutosave();
        if (firstRender)
        {
            try { _canSpeak = (await Voice.CapabilitiesAsync()).Speak; StateHasChanged(); }
            catch (JSException) { }
        }
        // Measured where it's cut to four lines, so Show all only appears when there's more to read.
        if (_activeTab == "job" && !_jobOpen && !_hearing && _freshLines.Count == 0)
        {
            try
            {
                _textFit ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/text-fit.js");
                var overflows = await _textFit.InvokeAsync<bool>("overflows", _summaryText, "p");
                if (overflows != _jobOverflows) { _jobOverflows = overflows; StateHasChanged(); }
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
        if (_activeTab == "knowledge" && _countedFor != _formFor)
        {
            _countedFor = _formFor;
            await CountSiteAsync();
            StateHasChanged();
        }
    }

    private string? _countedFor;

    private bool _liveDismissed;
    private string? _appliedTab;

    // Settings: the agent being changed, as it was when last saved, and the
    // knowledge every agent shares.
    private AgentForm? _form;
    private string? _formFor;
    private string _saved = string.Empty;
    private bool _tried;
    private bool _knowledgeApproved;
    private IReadOnlyList<KnowledgeCard> _cards = [];
    private IReadOnlyList<AgentChannelChoice> _channels = [];

    private sealed record Tab(string Id, string Label, IconName Glyph);

    private string _activeTab = "overview";

    // A save or a switch on its way to the store, and a save that failed.
    private bool _saving;
    private bool _switching;
    private string? _saveError;

    // The channel the day is shown for; null is all of them.
    private string? _channel;
    private bool _channelMenu;

    protected override async Task OnInitializedAsync()
    {
        TeachAi.Changed += KnowledgeChanged;
        Intro.Changed += IntroChanged;
        Readiness.Changed += OnAgentsChanged;
        await Kind.ReadAsync();
        AiAgentsState.Changed += OnAgentsChanged;
        Drafts.Changed += OnAgentsChanged;
        await AiAgentsState.LoadAsync();
        ResetIfNew();
        await LoadKnowledgeAsync();
        // The channels it can answer on are the ones connected now.
        _channels = await Gate.ConnectedAsync();
        try { _firstName = (await Profile.GetAsync()).FirstName?.Trim(); }
        catch (HttpRequestException) { }
        _handoverTeam = await HandoverTeam.LoadAsync(TeamApi, AuthState);
    }

    // The people it can bring in (designer, 10 November 2026): the owner alone, or the team.
    private HandoverTeam? _handoverTeam;
    private bool Solo => _handoverTeam?.Solo ?? true;

    // Who it asks before a discount or refund: whoever it brings in.
    private string AsksWho => _form is null ? "you" : Solo ? "you" : HandoverRouting.Phrase(_form.Settings, false, _handoverTeam) switch
    {
        "anyone on your team" => "your team",
        var who => who.Replace(", shared evenly", ""),
    };

    // "Hi Ada" when the profile has a first name, "Hi" when it doesn't.
    private string? _firstName;
    private string Greeting => _firstName is { Length: > 0 } name ? $"Hi {name}" : "Hi";

    // Told its job: a job description, written and approved (an agent from before job descriptions has its description).
    private static bool Told(AiAgent agent) => agent.Settings.Brief is { IsEmpty: false } || (agent.Settings.Brief is null && !string.IsNullOrWhiteSpace(agent.Description));

    // Orientation runs on the AI service: it keeps what it learns, so no job description is saved
    // here, and it says when the agent knows enough to be turned on (owner, 23 November 2026).
    private bool OnAiOrientation => Knowledge is OrientationBusinessKnowledge;

    // The AI service's progress for the agent shown, read on opening it and when its conversation closes.
    private OrientationProgress? _orientation;
    private string? _orientationFor;

    // Knows enough to be turned on. On the AI service, its word stands in for "told". Not known (not
    // read yet, or the read failed) holds nothing back: the service refuses if it isn't ready, and says why.
    private bool Taught(AiAgent agent) => OnAiOrientation ? _orientation?.CanActivate != false : Told(agent);

    private string NotTaughtLine(AiAgent agent) => OnAiOrientation && _orientation is { } progress
