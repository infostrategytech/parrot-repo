        _ => "balanced",
    };

    private static string StatusOf(AiAgent agent) => agent.IsDraft ? "Draft" : agent.IsActive ? "On" : "Off";

    private static StatusTone StatusToneOf(AiAgent agent) =>
        agent.IsDraft ? StatusTone.Neutral : agent.IsActive ? StatusTone.Success : StatusTone.Warning;

    // The channels it answers on, in the order owners see them everywhere
    // else; any channel added later follows the ones known today.
    private static IReadOnlyList<string> ChannelKeys(AiAgent agent) =>
        agent.Channels.Where(c => c.IsEnabled)
            .OrderBy(c => AgentBuilderCopy.Channels.ToList().FindIndex(k => string.Equals(k.Key, c.Key, StringComparison.OrdinalIgnoreCase)) is var i and >= 0 ? i : int.MaxValue)
            .Select(c => c.Key.ToLowerInvariant())
            .ToList();

    // The channel picked, while the agent still answers there.
    private string? ChannelFor(AiAgent agent) => _channel is not null && ChannelKeys(agent).Contains(_channel) ? _channel : null;

    private void PickChannel(string? key)
    {
        _channel = key;
        _channelMenu = false;
    }

    private static RenderFragment ChannelMark(string key) => __builder =>
    {
        <ChannelIcon Channel="@key" Size="IconSize.Sm" />
    };

    private string ChannelDetail(AiAgent agent)
    {
        // Concept B: the Overview already says a draft isn't answering, so the row only names where.
        if (agent.IsDraft && agent.ChannelCount > 0) return $"{AgentBuilderCopy.ChannelList(agent)}.";
        var status = agent.IsDraft && !Capabilities.CanReply ? "A draft: it answers no one yet."
            : agent.IsDraft ? "A draft: it answers no one until you turn it on."
            : agent.IsActive ? "On now." : "Off: it answers no one until you turn it on.";
        // With nowhere to answer, "On now" would contradict the line above it.
        return agent.ChannelCount == 0 ? "Choose where it answers, on Overview." : $"{AgentBuilderCopy.ChannelList(agent)}. {status}";
    }

    private static StatusTone OutcomeTone(ConversationOutcome outcome) => outcome switch
    {
        ConversationOutcome.Answered => StatusTone.Success,
        ConversationOutcome.PassedToTeam => StatusTone.Info,
        _ => StatusTone.Neutral,
    };

    private static string OutcomeText(RecentConversation chat) => chat.Outcome switch
    {
        ConversationOutcome.Answered => "Answered",
        ConversationOutcome.PassedToTeam => "Passed to you",
        _ => $"Task: {chat.Task}",
    };

    private static string Ago(int minutes) =>
        minutes < 1 ? "Just now"
        : minutes < 60 ? $"{minutes} min ago"
        : minutes < 120 ? "1 hr ago"
        : $"{minutes / 60} hrs ago";

    // The week ends today: "Today" last, the six days before it by name.
    private static string DayName(int index, int count) =>
        index == count - 1 ? "Today" : DateTime.Today.AddDays(index - (count - 1)).ToString("ddd");

    // One plain sentence about how the agent works, under its icon.
    // A line of "How it's set up" that opens the tab where it is set (Concept B).
    // One save bar for every tab with settings. A save that fails keeps every
    // change, and says so in the bar, where the person is looking.
    // "Shared with all your agents.", then what this job still needs, if anything.
    private string KnowsLine(AgentForm form) =>
        Memory.Available && JobGaps(form) is { Count: > 0 } gaps
            ? $"Shared with all your agents. {GapLine(form, gaps)}"
            : "Shared with all your agents.";

    private RenderFragment SetupRow(IconName icon, string title, string detail, string tab, string tabName) => __builder =>
    {
        <RowButton Class="agent-detail__setup-row" OnClick="@(() => _activeTab = tab)" aria-label="@($"{title}. Open {tabName}.")">
            <span class="agent-detail__fact-icon"><Icon Name="@icon" Size="IconSize.Md" /></span>
            <span class="agent-detail__row-text">
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@title</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>@detail</Typography>
            </span>
            <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" Class="agent-detail__setup-go" />
        </RowButton>
    };


    private void BackToAgents() => Nav.NavigateTo("/dashboard/ai-operations");

    private void OpenInbox() => Nav.NavigateTo("/dashboard/inbox");

    private void OpenTasks() => Nav.NavigateTo("/dashboard/tasks");
}
