@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

@* The flow: a trigger node, one node per step joined by connectors, and an
   "Add step" control with its picker. Each step kind keeps its own accent so
   a long flow can be read by colour. *@

<div class="playbook-canvas" @onclick:stopPropagation="true">
    <div class="playbook-canvas__flow">
        <button type="button"
                class="@(IsTriggerSelected ? "playbook-node playbook-node--trigger is-selected" : "playbook-node playbook-node--trigger")"
                @onclick="() => OnTriggerSelected.InvokeAsync()">
            <div class="playbook-node__row">
                <span class="playbook-node__label">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">How customers start this flow</Typography>
                    <Icon Name="IconName.RiInformationFill" Size="IconSize.Inherit" Class="playbook-node__hint" />
                </span>
                <StatusBadge Tone="@(TriggerPhrases > 0 ? StatusTone.Success : StatusTone.Warning)" Glyph="@(TriggerPhrases > 0 ? IconName.RiCheckFill : null)">
                    @TriggerPhrases phrases added
                </StatusBadge>
            </div>
            <Typography TextStyle="TextStyle.Small12Regular" As="span" Class="playbook-node__type">Trigger</Typography>
        </button>

        @foreach (var step in Playbook.Steps)
        {
            var stepId = step.Id;
            var kind = Kind(step.Type);
            <div class="playbook-canvas__connector"></div>
            <div class="playbook-node playbook-node--step playbook-node--@kind.Modifier @(SelectedStepId == stepId ? "is-selected" : null)"
                 role="button"
                 tabindex="0"
                 aria-pressed="@((SelectedStepId == stepId).ToString().ToLowerInvariant())"
                 @onclick="() => OnStepSelected.InvokeAsync(stepId)"
                 @onkeydown="e => OnNodeKey(e, stepId)">
                <div class="playbook-node__row">
                    <span class="playbook-node__label">
                        <span class="playbook-node__glyph"><Icon Name="@kind.Glyph" Size="IconSize.Sm" /></span>
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">@kind.Label</Typography>
                    </span>
                    <span @onclick:stopPropagation="true">
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.Small"
                                Class="playbook-node__remove"
                                aria-label="@($"Remove {kind.Label}")"
                                @onclick="() => OnStepRemoved.InvokeAsync(stepId)">
                            <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
                        </Button>
                    </span>
                </div>
                <Typography TextStyle="TextStyle.Small12Regular" As="span" Class="playbook-node__type">@kind.Subtype</Typography>
            </div>
        }

        <div class="playbook-canvas__connector"></div>
        <div class="playbook-canvas__add">
            <Button Variant="ButtonVariant.Secondary" @onclick="() => OnToggleStepPicker.InvokeAsync()">
                <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                <ChildContent>Add step</ChildContent>
            </Button>
            @if (ShowStepPicker)
            {
                <div class="playbook-canvas__picker" role="menu" aria-label="Step types">
                    @foreach (var kind in StepKinds)
                    {
                        var current = kind;
                        <PopoverOption Label="@current.Label" OnSelect="() => OnAddStepOfType.InvokeAsync(current.Type)">
                            <Leading>
                                <span class="playbook-canvas__picker-glyph playbook-canvas__picker-glyph--@current.Modifier"><Icon Name="@current.Glyph" Size="IconSize.Sm" /></span>
                            </Leading>
                        </PopoverOption>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Playbook Playbook { get; set; } = default!;
    [Parameter] public string SelectedStepId { get; set; } = string.Empty;
    [Parameter] public bool ShowStepPicker { get; set; }
    [Parameter] public int TriggerPhrases { get; set; } = 10;
    [Parameter] public bool IsTriggerSelected { get; set; }
    [Parameter] public EventCallback OnTriggerSelected { get; set; }
    [Parameter] public EventCallback<string> OnStepSelected { get; set; }
    [Parameter] public EventCallback<string> OnStepRemoved { get; set; }
    [Parameter] public EventCallback<string> OnAddStepOfType { get; set; }
    [Parameter] public EventCallback OnToggleStepPicker { get; set; }

    public sealed record StepKind(string Type, string Modifier, string Label, string Subtype, IconName Glyph);

    public static readonly StepKind[] StepKinds =
    [
        new("AskQuestion", "question", "Ask question", "Ask customer for data", IconName.RiQuestionAnswerFill),
        new("SelectFromCatalog", "catalog", "Select from catalog", "Let customer choose item", IconName.RiShoppingBag3Fill),
        new("SendNotification", "notification", "Send notification", "Send a message to customer", IconName.RiSendPlaneFill),
        new("CollectPayment", "payment", "Collect payment", "Request payment", IconName.RiPriceTag3Fill),
        new("UpdateContact", "contact", "Update contact", "Update the contact record", IconName.RiContactsBook3Fill),
        new("Wait", "wait", "Wait", "Pause the process", IconName.RiTimeFill),
        new("CheckCondition", "condition", "Check a condition", "Branch based on data", IconName.RiArrowUpDownFill),
        new("EndProcess", "end", "End process", "Complete the playbook", IconName.RiCheckboxCircleFill)
    ];

    public static StepKind Kind(string type) => StepKinds.FirstOrDefault(k => k.Type == type) ?? StepKinds[0];

    private async Task OnNodeKey(KeyboardEventArgs args, string stepId)
    {
        if (args.Key is "Enter" or " ") await OnStepSelected.InvokeAsync(stepId);
    }
}
