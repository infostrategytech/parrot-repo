@page "/dashboard/ai-agents/{AgentId}/builder"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AiAgentsState AiAgentsState
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Parrot's supervisor / sub-agent / tool canvas, driven by js/agent-builder.js.
   The chrome around it (top bar, context bar, mascot gallery) is Blazor and
   wears Aurora's dress; the canvas itself is rendered by the script into the
   host below, so its styles reach it through ::deep. *@

<PageTitle>Builder · @_agentName · OmniAI</PageTitle>

<div class="abc-page">
    <header class="abc-topbar">
        <div class="abc-topbar-left">
            <button type="button" class="abc-back" @onclick="BackToAgent">
                <Icon Name="IconName.RiArrowLeftLine" Size="IconSize.Md" />
            </button>
            <span class="abc-topbar-icon"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" /></span>
            <nav class="abc-topbar-breadcrumb" aria-label="Breadcrumb">
                <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="abc-topbar-section">AI Agents</Typography>
                <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="abc-topbar-sep">/</Typography>
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="abc-topbar-title">@_agentName</Typography>
                <StatusBadge Tone="StatusTone.Warning">Draft</StatusBadge>
            </nav>
        </div>
        <div class="abc-topbar-right">
            <div class="abc-tab-group" role="tablist" aria-label="Builder views">
                <button type="button" role="tab" aria-selected="@((_view == "builder").ToString().ToLowerInvariant())" class="@(_view == "builder" ? "is-active" : null)" @onclick='() => SetView("builder")'>
                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">Builder</Typography>
                </button>
                <button type="button" role="tab" aria-selected="@((_view == "mascot").ToString().ToLowerInvariant())" class="@(_view == "mascot" ? "is-active" : null)" @onclick='() => SetView("mascot")'>
                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">Mascot states</Typography>
                </button>
            </div>
            <Button Variant="ButtonVariant.Secondary" @onclick="ValidateCanvas">
                <IconLeft><Icon Name="IconName.RiCheckboxCircleFill" /></IconLeft>
                <ChildContent>Validate</ChildContent>
            </Button>
            <Button>
                <IconLeft><Icon Name="IconName.RiCheckFill" /></IconLeft>
                <ChildContent>Test &amp; Save</ChildContent>
            </Button>
        </div>
    </header>

    <div class="abc-contextbar">
        <Icon Name="IconName.RiBookOpenFill" Size="IconSize.Sm" Class="abc-contextbar-glyph" />
        <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="abc-contextbar-title">Billing &amp; Refunds</Typography>
        <Typography TextStyle="TextStyle.Small12Regular" As="span" Class="abc-contextbar-type">playbook</Typography>
        <span class="abc-contextbar-div"></span>
        <Typography TextStyle="TextStyle.Small12Regular" As="span" Class="abc-contextbar-count">Canvas</Typography>
        <div class="abc-contextbar-status">
            <span class="abc-live-dot"></span>
            <Typography TextStyle="TextStyle.Small12Regular" As="span">Pip is guiding you</Typography>
        </div>
    </div>

    <div class="abc-view-area">
        @if (_view == "builder")
        {
            <div id="@_canvasHostId" class="abc-canvas-host"></div>
        }

        @if (_view == "mascot")
        {
            <div class="abc-mascot-view">
                <div class="abc-mascot-content">
                    <Typography TextStyle="TextStyle.HeadingH2Bold" As="h2" Class="abc-mascot-hero-title">Meet Pip — the build guide</Typography>
                    <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="abc-mascot-hero-sub">
                        Pip lives in the corner of the canvas and reacts to what you do. A breathing idle keeps the app alive, curiosity follows your cursor, and small reactions celebrate progress or flag issues — never alarming, always friendly.
                    </Typography>

                    <div class="abc-mascot-grid">
                        @foreach (var (pose, tone, name, desc) in _mascotPoses)
                        {
                            <article class="abc-mascot-card">
                                <div class="abc-mascot-card-preview abc-mascot-card-preview--@pose">
                                    <div class="abc-mascot-pip-wrap">
                                        @((MarkupString)PipSvg(pose))
                                    </div>
                                </div>
                                <div class="abc-mascot-card-info">
                                    <div class="abc-mascot-card-header">
                                        <span class="abc-mascot-dot abc-mascot-dot--@tone"></span>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@name</Typography>
                                    </div>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="abc-mascot-pose-desc">@desc</Typography>
                                </div>
                            </article>
                        }
                    </div>

                    <section class="abc-mascot-guide-card">
                        <div class="abc-mascot-guide-pip">
                            @((MarkupString)PipSvg("greet"))
                        </div>
                        <div class="abc-mascot-guide-body">
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Questionnaire guide</Typography>
                            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="abc-mascot-guide-sub">
                                Pip turns configuration into a plain-language conversation. Each question appears in a speech bubble with tappable answers — no jargon, no empty form fields.
                            </Typography>
                            <div class="abc-mascot-guide-bubble">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="span">Where should billing answers come from?</Typography>
                                <div class="abc-mascot-guide-opts">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span" Class="abc-mascot-opt">Knowledge base</Typography>
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span" Class="abc-mascot-opt">Live system</Typography>
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span" Class="abc-mascot-opt">A human agent</Typography>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string AgentId { get; set; } = string.Empty;

    private string _view = "builder";
    private string _agentName = "Atlas";
    private string _canvasHostId = string.Empty;
    private IJSObjectReference? _module;
    private bool _canvasInitialized;

    // Pose, tone (an accent token family), name, description.
    private static readonly (string pose, string tone, string name, string desc)[] _mascotPoses =
    [
        ("idle",      "teal",   "Idle",      "Gentle breathing loop, occasional blink, and a slow head tilt every few seconds so it never feels frozen."),
        ("curious",   "brand",  "Curious",   "Head tilts and eyes track the cursor or the hovered node — Pip is paying attention to what you're doing."),
        ("happy",     "green",  "Happy",     "A quick bounce and wing-flap when you connect nodes or finish a step. Celebratory, then settles back."),
        ("concerned", "red",    "Concerned", "A soft, worried look when validation flags an issue — brows lower and eyes half-close. Gentle, never alarming."),
    ];

    protected override void OnInitialized()
    {
        _canvasHostId = "abc-cv-host-" + Guid.NewGuid().ToString("N")[..8];
        var agent = AiAgentsState.GetAgent(AgentId);
        if (agent is not null) _agentName = agent.Name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/agent-builder.js");
        if (_view == "builder") await InitCanvas();
    }

    private async Task InitCanvas()
    {
        if (_module is null || _canvasInitialized) return;
        _canvasInitialized = true;
        await _module.InvokeVoidAsync("init", _canvasHostId);
    }

    private async Task SetView(string view)
    {
        _view = view;
        _canvasInitialized = false;
        StateHasChanged();
        if (view == "builder")
        {
            await Task.Yield();
            await InitCanvas();
        }
    }

    private async Task ValidateCanvas()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("validate", _canvasHostId);
    }

    private void BackToAgent() => Nav.NavigateTo($"/dashboard/ai-agents/{AgentId}");

    // Pip's drawing, as agent-builder.js draws it: an illustration, so it
    // keeps its own colours like a brand mark.
    private static string PipSvg(string pose) => $"""
        <svg class="abc-pip-svg abc-pip-svg--{pose}" viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg">
          <path d="M30 95 Q22 112 36 118 Q50 112 64 118 Q78 112 70 95" fill="#4C1D95"/>
          <ellipse cx="50" cy="82" rx="28" ry="24" fill="#6D28D9"/>
          <path d="M24 74 Q12 90 24 106 Q32 90 40 82" fill="#5B21B6"/>
          <path d="M76 74 Q88 90 76 106 Q68 90 60 82" fill="#5B21B6"/>
          <circle cx="50" cy="44" r="26" fill="#7C3AED"/>
          <ellipse cx="45" cy="51" rx="15" ry="12" fill="#F5F0FF"/>
          <path d="M38 51 L28 57 L39 60 Z" fill="#D97706"/>
          <circle cx="42" cy="42" r="8" fill="white"/>
          <circle cx="43" cy="42" r="5" fill="#1F2937"/>
          <circle cx="41.5" cy="40.5" r="1.8" fill="white"/>
          <ellipse cx="57" cy="51" rx="9" ry="6" fill="rgba(251,191,36,.35)"/>
          <path d="M44 20 Q42 11 47 7 Q53 12 51 22" fill="#8B5CF6"/>
          <path d="M52 18 Q52 9 57 5 Q62 11 58 22" fill="#A78BFA"/>
          <path d="M42 106 L38 114 M42 106 L44 114 M42 106 L47 112" stroke="#7C3AED" stroke-width="2.2" stroke-linecap="round" fill="none"/>
          <path d="M58 106 L54 114 M58 106 L60 114 M58 106 L63 112" stroke="#7C3AED" stroke-width="2.2" stroke-linecap="round" fill="none"/>
        </svg>
        """;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _canvasHostId); }
            catch (JSDisconnectedException) { /* page already unloaded */ }
            catch (JSException) { /* page already unloaded */ }
            await _module.DisposeAsync();
        }
    }
}
