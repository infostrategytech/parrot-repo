@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@inject AuroraInterop Interop

@* Aurora's guided AI agent builder: seven steps from a role template to
   activation, drawn full-page in place of the operations list.

   Parrot keeps only the identity (name, description, mascot) and the channel
   choice. Everything else — role, knowledge, boundaries, voice and the test
   runs — lives in the draft for this session and is reported back to the page
   at each step so it can show Aurora's toasts and, at the end, write the agent. *@

<main class="builder-main">
    <header class="builder-header">
        <button type="button" class="builder-back" @onclick="OnCancel">
            <Icon Name="IconName.RiArrowLeftLine" Size="IconSize.Md" />
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">Back to agents</Typography>
        </button>
        <div class="builder-heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">AI Agent Builder</Typography>
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>
                @(Agent is null ? "Create an AI teammate in plain language." : $"Set up {Agent.Name} in plain language.") Your agent stays in draft until you test and activate it.
            </Typography>
        </div>
        <span class="builder-draft-state">
            <i></i>
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">@DraftStateLabel</Typography>
        </span>
    </header>

    <div class="builder-layout">
        <aside class="builder-steps" aria-label="Agent setup progress">
            <header>
                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Setup progress</Typography>
                <Typography TextStyle="TextStyle.Small10Regular" As="span">7 steps available</Typography>
            </header>
            <ol>
                @foreach (var item in Steps)
                {
                    var number = item.Number;
                    var available = StepAvailable(number);
                    var active = number == _step;
                    var complete = number < _step;
                    <li class="@(active ? "is-active" : null) @(complete ? "is-complete" : null) @(!available ? "is-locked" : null)">
                        <button type="button" disabled="@(!available)" @onclick="() => GoTo(number)">
                            <span>
                                @if (complete)
                                {
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                }
                                else if (!available)
                                {
                                    <Icon Name="IconName.RiLockFill" Size="IconSize.Sm" />
                                }
                                else
                                {
                                    <Icon Name="@item.Icon" Size="IconSize.Sm" />
                                }
                            </span>
                            <div>
                                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@item.Label</Typography>
                                <Typography TextStyle="TextStyle.Small10Regular" As="small">@item.Helper</Typography>
                            </div>
                        </button>
                    </li>
                }
            </ol>
            <div class="builder-knowledge-status">
                <span><Icon Name="IconName.RiBookOpenFill" Size="IconSize.Sm" /></span>
                <div>
                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Business knowledge</Typography>
                    <Typography TextStyle="TextStyle.Small10Regular" As="small">
                        @(Knowledge.Sources.Count == 1 ? "1 source" : $"{Knowledge.Sources.Count} sources") · readiness not tracked yet
                    </Typography>
                </div>
            </div>
        </aside>

        <section class="builder-content">
            @if (_step == 1)
            {
                <header class="builder-step-header">
                    <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 1 of 7</Typography>
                    <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">What should this agent help with?</Typography>
                    <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Choose the closest role. We’ll pre-fill a sensible starting point that you can change.</Typography>
                </header>
                <div class="role-template-grid">
                    @foreach (var template in RoleTemplates)
                    {
                        var current = template;
                        var selected = _draft.RoleTemplate == current.Id;
                        <button type="button"
                                aria-pressed="@selected.ToString().ToLowerInvariant()"
                                class="@(selected ? "is-selected" : null)"
                                @onclick="() => SelectRole(current)">
                            <span><Icon Name="@current.Icon" Size="IconSize.Md" /></span>
                            <div>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@current.Name</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@current.Helper</Typography>
                            </div>
                            <i>
                                @if (selected)
                                {
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Md" />
                                }
                            </i>
                        </button>
                    }
                </div>
                <div class="builder-guidance">
                    <Icon Name="IconName.RiSparkling2Fill" Size="IconSize.Md" />
                    <div>
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">A starting point, not a restriction</Typography>
                        <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>You can change responsibilities, knowledge and escalation rules before this agent speaks to anyone.</Typography>
                    </div>
                </div>
                <footer class="builder-footer">
                    <Button @onclick="() => GoTo(2)">
                        <ChildContent>Continue to identity</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                    </Button>
                </footer>
            }
            else if (_step == 2)
            {
                <form @onsubmit="SaveIdentity" @onsubmit:preventDefault="true">
                    <header class="builder-step-header">
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 2 of 7</Typography>
                        <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Give your agent a clear identity</Typography>
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Use a short name and explain the outcome this teammate should own.</Typography>
                    </header>
                    <div class="builder-fields">
                        <div class="builder-field">
                            <Input FloatingLabel="Agent name"
                                   HelperText="A short, human name that teammates can remember."
                                   @bind-Value="_draft.Name"
                                   maxlength="32"
                                   required
                                   autofocus />
                        </div>
                        <div class="builder-field">
                            <Input FloatingLabel="Role title"
                                   @bind-Value="_draft.Role"
                                   maxlength="80"
                                   required />
                        </div>
                        <label class="builder-field builder-field--full builder-textarea">
                            <Typography TextStyle="TextStyle.Small12Semibold" As="span">What should this agent help customers achieve?</Typography>
                            <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                                      maxlength="240"
                                      rows="4"
                                      required
                                      placeholder="Describe the outcome in one or two sentences."
                                      value="@_draft.Description"
                                      @oninput="e => _draft.Description = e.Value?.ToString() ?? string.Empty"></textarea>
                            <Typography TextStyle="TextStyle.Small10Regular" As="small" Class="builder-count">@_draft.Description.Length/240</Typography>
                        </label>
                        <fieldset class="builder-field builder-field--full">
                            <Typography TextStyle="TextStyle.Small12Semibold" As="legend">Appearance</Typography>
                            <Typography TextStyle="TextStyle.Small10Regular" As="p">Choose a mascot to represent your agent.</Typography>
                            <div class="avatar-tone-options">
                                @foreach (var mascot in AgentBuilderCopy.Mascots)
                                {
                                    var current = mascot;
                                    var selected = _draft.Mascot == current;
                                    <button type="button"
                                            aria-label="@current"
                                            aria-pressed="@selected.ToString().ToLowerInvariant()"
                                            class="agent-tone-slate @(selected ? "is-selected" : null)"
                                            @onclick="() => _draft.Mascot = current">
                                        <span><img src="@AgentBuilderCopy.MascotImage(current)" alt="" /></span>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small">@current</Typography>
                                    </button>
                                }
                            </div>
                        </fieldset>
                    </div>
                    <div class="orientation-next-card">
                        <span><Icon Name="IconName.RiBookOpenFill" Size="IconSize.Md" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Next: orient @(string.IsNullOrWhiteSpace(_draft.Name) ? "your agent" : _draft.Name.Trim())</Typography>
                            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>
                                @(string.IsNullOrWhiteSpace(Knowledge.BusinessName)
                                    ? "Connect workspace knowledge and decide what this agent may use."
                                    : $"Connect {Knowledge.BusinessName}'s shared knowledge and decide what this agent may use.")
                            </Typography>
                        </div>
                        <Typography TextStyle="TextStyle.Small10Semibold" As="em">— ready</Typography>
                    </div>
                    <footer class="builder-form-footer">
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => GoTo(1)">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                            <ChildContent>Back</ChildContent>
                        </Button>
                        <Button Type="ButtonType.Submit" disabled="@(!IdentityValid)">
                            <ChildContent>@(Agent is not null ? "Save identity" : "Save as draft")</ChildContent>
                            <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                        </Button>
                    </footer>
                </form>
            }
            else if (_step == 3)
            {
                <div class="knowledge-orientation">
                    <header class="builder-step-header">
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 3 of 7</Typography>
                        <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Orient @DraftName</Typography>
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Choose the business knowledge this agent can use. Add anything important that is still missing.</Typography>
                    </header>

                    <div class="knowledge-orientation-body">
                        <section class="knowledge-business-card">
                            <div class="knowledge-business-mark"><Icon Name="IconName.RiStore2Fill" Size="IconSize.Md" /></div>
                            <div>
                                <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Shared business knowledge</Typography>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">@(string.IsNullOrWhiteSpace(Knowledge.BusinessName) ? "Your workspace" : Knowledge.BusinessName)</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p">—</Typography>
                            </div>
                            <div class="knowledge-readiness">
                                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="strong">—</Typography>
                                <Typography TextStyle="TextStyle.Small10Regular" As="span">Knowledge ready</Typography>
                                <i><b style="width: 0%"></b></i>
                            </div>
                        </section>

                        <section class="knowledge-source-section">
                            <header>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">What can @DraftName use?</Typography>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="p">Select at least one trusted source. You can change this later.</Typography>
                                </div>
                                <Typography TextStyle="TextStyle.Small10Semibold" As="span">@_selectedSourceIds.Count of @Knowledge.Sources.Count selected</Typography>
                            </header>
                            @if (Knowledge.Sources.Count == 0)
                            {
                                <EmptyState Glyph="IconName.RiBookOpenFill"
                                            Size="EmptyStateSize.Panel"
                                            Title="No knowledge sources yet"
                                            Description="Add a website or upload a document below so this agent has something trusted to answer from." />
                            }
                            else
                            {
                                <div class="knowledge-source-list">
                                    @foreach (var source in Knowledge.Sources)
                                    {
                                        var current = source;
                                        var selected = _selectedSourceIds.Contains(current.Id);
                                        <button type="button"
                                                aria-pressed="@selected.ToString().ToLowerInvariant()"
                                                class="@(selected ? "is-selected" : null)"
                                                @onclick="() => ToggleSource(current.Id)">
                                            <span><Icon Name="@(current.Type == "website" ? IconName.RiGlobalFill : IconName.RiFileTextFill)" Size="IconSize.Sm" /></span>
                                            <div>
                                                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@current.Name</Typography>
                                                <Typography TextStyle="TextStyle.Small10Regular" As="small">— verified facts · @current.Type</Typography>
                                            </div>
                                            <i>
                                                @if (selected)
                                                {
                                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Md" />
                                                }
                                            </i>
                                        </button>
                                    }
                                </div>
                            }
                        </section>

                        <section class="add-knowledge-section">
                            <header>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Add anything that is missing</Typography>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="p">Use whichever method is easiest for your business.</Typography>
                                </div>
                            </header>
                            <div class="knowledge-add-actions">
                                <button type="button" @onclick='() => _knowledgeAction = _knowledgeAction == "website" ? null : "website"'>
                                    <span><Icon Name="IconName.RiGlobalFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Add website</Typography>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">Import public business information</Typography>
                                    </div>
                                    <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" />
                                </button>
                                <button type="button" @onclick="PickDocument">
                                    <span><Icon Name="IconName.RiFileTextFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Upload document</Typography>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">PDF, Word, text or catalogue</Typography>
                                    </div>
                                    <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" />
                                </button>
                                <button type="button" disabled>
                                    <span><Icon Name="IconName.RiQuestionAnswerFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Answer quick questions</Typography>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">No unanswered questions</Typography>
                                    </div>
                                    <Icon Name="IconName.RiArrowRightSLine" Size="IconSize.Sm" />
                                </button>
                                <InputFile @ref="_documentInput" OnChange="AddDocument" accept=".pdf,.doc,.docx,.txt,.csv" class="sr-only" />
                            </div>

                            @if (_knowledgeAction == "website")
                            {
                                <form class="knowledge-inline-form" @onsubmit="AddWebsite" @onsubmit:preventDefault="true">
                                    @* Razor reads <Input> as the void HTML element, so the leading
                                       icon travels as a template rather than a child tag. *@
                                    <Input FloatingLabel="Business website"
                                           @bind-Value="_website"
                                           IconLeft="GlobeGlyph"
                                           autofocus />
                                    <Button Type="ButtonType.Submit" disabled="@string.IsNullOrWhiteSpace(_website)">Import website</Button>
                                </form>
                            }
                        </section>
                    </div>

                    <footer class="builder-form-footer">
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => GoTo(2)">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                            <ChildContent>Back</ChildContent>
                        </Button>
                        <Button disabled="@(!_draft.IdentitySaved || _selectedSourceIds.Count == 0)" @onclick="SaveOrientation">
                            <ChildContent>Save orientation</ChildContent>
                            <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                        </Button>
                    </footer>
                </div>
            }
            else if (_step == 4)
            {
                <div class="boundary-builder">
                    <header class="builder-step-header">
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 4 of 7</Typography>
                        <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Set clear boundaries for @DraftName</Typography>
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Choose where this agent can reply, what it may do and exactly when a teammate must take over.</Typography>
                    </header>
                    <div class="boundary-builder-body">
                        <div class="boundary-safety-note">
                            <span><Icon Name="IconName.RiShieldCheckFill" Size="IconSize.Md" /></span>
                            <div>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Safe defaults are always on</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>If a customer asks for a person or the agent is not confident, it stops replying and hands over with a conversation summary.</Typography>
                            </div>
                        </div>

                        <section class="boundary-section">
                            <header>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Where can it respond?</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Select the social inboxes this agent should cover.</Typography>
                                </div>
                                <Typography TextStyle="TextStyle.Small12Semibold" As="span">@_draft.Channels.Count selected</Typography>
                            </header>
                            <div class="boundary-channel-options">
                                @foreach (var channel in BoundaryChannels)
                                {
                                    var current = channel;
                                    var selected = _draft.Channels.Contains(current.Id);
                                    <button type="button"
                                            aria-pressed="@selected.ToString().ToLowerInvariant()"
                                            class="boundary-channel-@current.Id @(selected ? "is-selected" : null)"
                                            @onclick="() => ToggleChannel(current.Id)">
                                        <span><Icon Name="@current.Icon" Size="IconSize.Md" /></span>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@current.Label</Typography>
                                        <i>
                                            @if (selected)
                                            {
                                                <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                            }
                                        </i>
                                    </button>
                                }
                            </div>
                        </section>

                        <section class="boundary-section">
                            <header>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">What can it do?</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Start with everyday tasks. Higher-risk actions are clearly marked.</Typography>
                                </div>
                                <Typography TextStyle="TextStyle.Small12Semibold" As="span">@_draft.AllowedActions.Count allowed</Typography>
                            </header>
                            <div class="permission-options">
                                @foreach (var permission in Permissions)
                                {
                                    var current = permission;
                                    var selected = _draft.AllowedActions.Contains(current.Id);
                                    <button type="button"
                                            aria-pressed="@selected.ToString().ToLowerInvariant()"
                                            class="@(selected ? "is-selected" : null) @(current.Elevated ? "is-elevated" : null)"
                                            @onclick="() => TogglePermission(current.Id)">
                                        <span><Icon Name="@current.Icon" Size="IconSize.Sm" /></span>
                                        <div>
                                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@current.Label</Typography>
                                            <Typography TextStyle="TextStyle.Small12Regular" As="small">@current.Helper</Typography>
                                        </div>
                                        <i>
                                            @if (selected)
                                            {
                                                <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                            }
                                        </i>
                                        @if (current.Elevated)
                                        {
                                            <Typography TextStyle="TextStyle.Small10Semibold" As="em">Higher risk</Typography>
                                        }
                                    </button>
                                }
                            </div>
                        </section>

                        <section class="boundary-section handoff-section">
                            <header>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">When should it hand over?</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">These rules prevent the agent from guessing or continuing a sensitive conversation.</Typography>
                                </div>
                            </header>
                            <div class="handoff-rules">
                                <article class="is-required">
                                    <span><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Customer asks for a person</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Always hand over immediately</Typography>
                                    </div>
                                    <em><Icon Name="IconName.RiLockFill" Size="IconSize.Inherit" /><Typography TextStyle="TextStyle.Small10Semibold" As="span">Required</Typography></em>
                                </article>
                                <article class="is-required">
                                    <span><Icon Name="IconName.RiAlarmWarningFill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Agent confidence is too low</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Hand over instead of making an uncertain claim</Typography>
                                    </div>
                                    <div class="handoff-threshold">
                                        <SelectField FloatingLabel="Below"
                                                     Value="@($"{_draft.ConfidenceThreshold}%")"
                                                     Open='@(_openMenu == "threshold")'
                                                     OpenChanged='@(open => _openMenu = open ? "threshold" : null)'>
                                            @foreach (var threshold in Thresholds)
                                            {
                                                var current = threshold;
                                                <PopoverOption Label="@($"{current}%")"
                                                               Active="@(_draft.ConfidenceThreshold == current)"
                                                               OnSelect="() => { _draft.ConfidenceThreshold = current; _openMenu = null; }" />
                                            }
                                        </SelectField>
                                    </div>
                                </article>
                                <article>
                                    <span><Icon Name="IconName.RiChatSmile3Fill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Customer sounds upset</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Escalate complaints or strongly negative messages</Typography>
                                    </div>
                                    <Toggle AriaLabel="Toggle negative sentiment handoff" Checked="_draft.NegativeSentiment" CheckedChanged="value => _draft.NegativeSentiment = value" />
                                </article>
                                <article>
                                    <span><Icon Name="IconName.RiFlashlightFill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Two answers did not help</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Escalate instead of repeating or trying again</Typography>
                                    </div>
                                    <Toggle AriaLabel="Toggle repeated failure handoff" Checked="_draft.RepeatedFailure" CheckedChanged="value => _draft.RepeatedFailure = value" />
                                </article>
                                <article class="high-value-rule">
                                    <span><Icon Name="IconName.RiPriceTag3Fill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">High-value transaction</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Ask the team before committing above a limit</Typography>
                                    </div>
                                    <Toggle AriaLabel="Toggle high value handoff" Checked="_draft.HighValueTransactions" CheckedChanged="value => _draft.HighValueTransactions = value" />
                                    @if (_draft.HighValueTransactions)
                                    {
                                        <label>
                                            <Typography TextStyle="TextStyle.Small12Regular" As="span">Hand over above</Typography>
                                            <Input FloatingLabel="Amount"
                                                   PrefixText="₦"
                                                   type="number"
                                                   min="0"
                                                   step="5000"
                                                   aria-label="High value transaction threshold in naira"
                                                   Value="@_draft.HighValueThresholdNgn.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                   ValueChanged="value => _draft.HighValueThresholdNgn = int.TryParse(value, out var parsed) ? parsed : 0" />
                                        </label>
                                    }
                                </article>
                            </div>
                        </section>

                        <section class="handoff-destination">
                            <div>
                                <span><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Md" /></span>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Send handoffs to</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">The agent will stop, prepare a summary and route the conversation here.</Typography>
                                </div>
                            </div>
                            <div class="handoff-destination-select">
                                <SelectField FloatingLabel="Handoff destination"
                                             Value="@AgentBuilderCopy.HandoffLabel(_draft.HandoffTarget)"
                                             Open='@(_openMenu == "handoff")'
                                             OpenChanged='@(open => _openMenu = open ? "handoff" : null)'>
                                    @foreach (var target in HandoffTargets)
                                    {
                                        var current = target;
                                        <PopoverOption Label="@AgentBuilderCopy.HandoffLabel(current)"
                                                       Active="@(_draft.HandoffTarget == current)"
                                                       OnSelect="() => { _draft.HandoffTarget = current; _openMenu = null; }" />
                                    }
                                </SelectField>
                            </div>
                        </section>

                        <div class="handoff-outcome">
                            <Icon Name="IconName.RiShieldCheckFill" Size="IconSize.Sm" />
                            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>
                                <strong class="@TextStyle.Small12Semibold.ToClassName()">When a rule is triggered:</strong> @DraftName stops customer replies, shares the reason and conversation summary, then waits for a teammate.
                            </Typography>
                        </div>
                    </div>
                    <footer class="builder-form-footer">
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => GoTo(3)">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                            <ChildContent>Back</ChildContent>
                        </Button>
                        <Button disabled="@(!_draft.IdentitySaved || _draft.Channels.Count == 0 || _draft.AllowedActions.Count == 0)" @onclick="SaveBoundaries">
                            <ChildContent>Save boundaries</ChildContent>
                            <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                        </Button>
                    </footer>
                </div>
            }
            else if (_step == 5)
            {
                <div class="voice-builder">
                    <header class="builder-step-header">
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 5 of 7</Typography>
                        <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Shape how @DraftName sounds</Typography>
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Choose a natural communication style and preview how it will feel to a customer.</Typography>
                    </header>
                    <div class="voice-builder-body">
                        <div class="voice-settings">
                            <section class="voice-section">
                                <header>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Choose a communication style</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">This becomes the default tone across every social channel.</Typography>
                                </header>
                                <div class="voice-preset-options">
                                    @foreach (var preset in VoicePresets)
                                    {
                                        var current = preset;
                                        var selected = _draft.VoicePreset == current.Id;
                                        <button type="button"
                                                aria-pressed="@selected.ToString().ToLowerInvariant()"
                                                class="@(selected ? "is-selected" : null)"
                                                @onclick="() => _draft.VoicePreset = current.Id">
                                            <span><Icon Name="@current.Icon" Size="IconSize.Md" /></span>
                                            <div>
                                                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@current.Label</Typography>
                                                <Typography TextStyle="TextStyle.Small12Regular" As="small">@current.Helper</Typography>
                                                <Typography TextStyle="TextStyle.Small12Regular" As="em">“@current.Sample”</Typography>
                                            </div>
                                            <i>
                                                @if (selected)
                                                {
                                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                                }
                                            </i>
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="voice-section voice-tuning">
                                <header>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Fine-tune the replies</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Keep these simple. The agent will adapt naturally to each conversation.</Typography>
                                </header>
                                <div class="voice-choice-group">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Response length</Typography>
                                    <div>
                                        @foreach (var option in ResponseLengths)
                                        {
                                            var current = option;
                                            var selected = _draft.ResponseLength == current.Id;
                                            <button type="button" aria-pressed="@selected.ToString().ToLowerInvariant()" class="@(selected ? "is-selected" : null)" @onclick="() => _draft.ResponseLength = current.Id">
                                                <Typography TextStyle="TextStyle.Small12Semibold" As="b">@current.Label</Typography>
                                                <Typography TextStyle="TextStyle.Small10Regular" As="small">@current.Helper</Typography>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="voice-choice-group">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Emoji use</Typography>
                                    <div>
                                        @foreach (var option in EmojiOptions)
                                        {
                                            var current = option;
                                            var selected = _draft.EmojiUsage == current.Id;
                                            <button type="button" aria-pressed="@selected.ToString().ToLowerInvariant()" class="@(selected ? "is-selected" : null)" @onclick="() => _draft.EmojiUsage = current.Id">
                                                <Typography TextStyle="TextStyle.Small12Semibold" As="b">@current.Label</Typography>
                                                <Typography TextStyle="TextStyle.Small10Regular" As="small">@current.Helper</Typography>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <article class="voice-name-rule">
                                    <span><Icon Name="IconName.RiContactsBook3Fill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Use the customer’s first name</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Personalise naturally when the name is available</Typography>
                                    </div>
                                    <Toggle AriaLabel="Toggle customer name personalisation" Checked="_draft.UseCustomerName" CheckedChanged="value => _draft.UseCustomerName = value" />
                                </article>
                            </section>

                            <section class="voice-section voice-language-rules">
                                <header>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Give it a few words to follow</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Write one greeting and flag language your business would never use.</Typography>
                                </header>
                                <label class="voice-greeting">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">Default greeting</Typography>
                                    <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                                              maxlength="160"
                                              rows="3"
                                              value="@_draft.Greeting"
                                              @oninput="e => _draft.Greeting = e.Value?.ToString() ?? string.Empty"></textarea>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">Use <b class="@TextStyle.Small10Semibold.ToClassName()">{first_name}</b> to personalise · @_draft.Greeting.Length/160</Typography>
                                </label>
                                <div class="voice-avoid">
                                    <Typography TextStyle="TextStyle.Small12Semibold" As="span">Phrases to avoid <em class="@TextStyle.Small10Medium.ToClassName()">Optional</em></Typography>
                                    <div class="avoid-phrase-input">
                                        <Input FloatingLabel="e.g. Calm down"
                                               @bind-Value="_avoidPhraseInput"
                                               maxlength="40"
                                               @onkeydown="OnAvoidPhraseKeyDown" />
                                        <Button Variant="ButtonVariant.Secondary" disabled="@(string.IsNullOrWhiteSpace(_avoidPhraseInput) || _draft.AvoidPhrases.Count >= 6)" @onclick="AddAvoidPhrase">Add phrase</Button>
                                    </div>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">These help the agent avoid language that feels wrong for your brand.</Typography>
                                </div>
                                @if (_draft.AvoidPhrases.Count > 0)
                                {
                                    <div class="avoid-phrase-list">
                                        @foreach (var phrase in _draft.AvoidPhrases)
                                        {
                                            var current = phrase;
                                            <button type="button" aria-label="@($"Remove {current}")" @onclick="() => _draft.AvoidPhrases.Remove(current)">
                                                <Typography TextStyle="TextStyle.Small10Semibold" As="span">@current</Typography>
                                                <Icon Name="IconName.RiCloseFill" Size="IconSize.Inherit" />
                                            </button>
                                        }
                                    </div>
                                }
                            </section>
                        </div>

                        <aside class="voice-preview">
                            <header>
                                <div>
                                    <span><Icon Name="IconName.RiWhatsappFill" Size="IconSize.Sm" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Customer preview</Typography>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">WhatsApp · Live example</Typography>
                                    </div>
                                </div>
                                <Typography TextStyle="TextStyle.Small10Semibold" As="em">@SelectedVoice.Label</Typography>
                            </header>
                            <div class="voice-preview-thread">
                                <div class="preview-customer-message">
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Hi, when will my order arrive?</Typography>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">10:42 AM</Typography>
                                </div>
                                <div class="preview-agent-row">
                                    <span class="agent-tone-slate"><img src="@AgentBuilderCopy.MascotImage(_draft.Mascot)" alt="" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="b">@DraftName</Typography>
                                        <div class="preview-agent-message">
                                            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@PreviewGreeting</Typography>
                                            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@PreviewDetail@PreviewEmoji</Typography>
                                            <Typography TextStyle="TextStyle.Small10Regular" As="small">10:42 AM</Typography>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <footer>
                                <Icon Name="IconName.RiSparkling2Fill" Size="IconSize.Sm" />
                                <Typography TextStyle="TextStyle.Small10Regular" As="span" Prose>This preview demonstrates tone only. Answers will still come from approved business knowledge.</Typography>
                            </footer>
                        </aside>
                    </div>
                    <footer class="builder-form-footer">
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => GoTo(4)">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                            <ChildContent>Back</ChildContent>
                        </Button>
                        <Button disabled="@(!_draft.IdentitySaved || _draft.Greeting.Trim().Length < 10)" @onclick="SaveVoice">
                            <ChildContent>Save voice &amp; tone</ChildContent>
                            <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                        </Button>
                    </footer>
                </div>
            }
            else if (_step == 6)
            {
                <div class="agent-test-builder">
                    <header class="builder-step-header">
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 6 of 7</Typography>
                        <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Test @DraftName before going live</Typography>
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Try realistic customer messages and confirm the agent answers safely—or hands over when it should.</Typography>
                    </header>
                    <div class="agent-test-body">
                        <aside class="test-scenarios">
                            <header>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Test scenarios</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Complete the three required safety checks.</Typography>
                                </div>
                                <span class="@(_draft.TestStatus == AgentTestStatus.Passed ? "is-passed" : null)">
                                    <Typography TextStyle="TextStyle.Small12Bold" As="span">@CompletedRequiredCount/3</Typography>
                                </span>
                            </header>
                            <div class="test-progress">
                                <i><b style="width: @(CompletedRequiredCount * 100 / 3)%"></b></i>
                                <Typography TextStyle="TextStyle.Small10Regular" As="small">
                                    @(_draft.TestStatus == AgentTestStatus.Passed
                                        ? "Required tests passed"
                                        : $"{3 - CompletedRequiredCount} required test{(3 - CompletedRequiredCount == 1 ? "" : "s")} left")
                                </Typography>
                            </div>
                            <div class="test-scenario-list">
                                @foreach (var scenario in TestScenarios)
                                {
                                    var current = scenario;
                                    var selected = _testScenarioId == current.Id;
                                    var complete = _draft.CompletedTestScenarioIds.Contains(current.Id);
                                    <button type="button"
                                            aria-pressed="@selected.ToString().ToLowerInvariant()"
                                            class="@(selected ? "is-selected" : null) @(complete ? "is-complete" : null)"
                                            @onclick="() => SelectTestScenario(current)">
                                        <span><Icon Name="@current.Icon" Size="IconSize.Sm" /></span>
                                        <div>
                                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@current.Label</Typography>
                                            <Typography TextStyle="TextStyle.Small10Regular" As="small">@current.Helper</Typography>
                                        </div>
                                        @if (complete)
                                        {
                                            <i><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" /></i>
                                        }
                                        else if (current.Required)
                                        {
                                            <Typography TextStyle="TextStyle.Small10Semibold" As="em" Class="ds-overline">Required</Typography>
                                        }
                                    </button>
                                }
                            </div>
                            <div class="test-safety-note">
                                <Icon Name="IconName.RiShieldCheckFill" Size="IconSize.Sm" />
                                <Typography TextStyle="TextStyle.Small10Regular" As="p" Prose>This is a private sandbox. No customer will receive these messages.</Typography>
                            </div>
                        </aside>

                        <section class="test-sandbox">
                            <header>
                                <div>
                                    <span class="agent-tone-slate"><img src="@AgentBuilderCopy.MascotImage(_draft.Mascot)" alt="" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Testing @DraftName</Typography>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">@(_testResult is null ? "Private simulation" : _testResult.Handoff ? "Safe handoff triggered" : "Safe answer produced")</Typography>
                                    </div>
                                </div>
                                @if (_testResult is not null)
                                {
                                    <em class="@(_testResult.Handoff ? "is-handoff" : "is-answer")">
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="span">@(_testResult.Handoff ? "Handed over" : "Answered safely")</Typography>
                                    </em>
                                }
                            </header>

                            <div class="test-conversation">
                                @if (_testResult is null)
                                {
                                    <div class="test-empty">
                                        <span><Icon Name="IconName.RiFlashlightFill" Size="IconSize.Lg" /></span>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Ready for a test message</Typography>
                                        <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>Select a scenario or write your own message, then run the test.</Typography>
                                    </div>
                                }
                                else
                                {
                                    <div class="test-customer-bubble">
                                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@_testResult.CustomerMessage</Typography>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">Test customer · Now</Typography>
                                    </div>
                                    @if (!_testResult.Handoff && _testResult.Reply is not null)
                                    {
                                        <div class="test-agent-row">
                                            <span class="agent-tone-slate"><img src="@AgentBuilderCopy.MascotImage(_draft.Mascot)" alt="" /></span>
                                            <div>
                                                <Typography TextStyle="TextStyle.Small10Semibold" As="b">@DraftName</Typography>
                                                <article>
                                                    <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@_testResult.Reply</Typography>
                                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">AI test response · Not sent</Typography>
                                                </article>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="test-handoff-card">
                                            <span><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Md" /></span>
                                            <div>
                                                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Handed over to @AgentBuilderCopy.HandoffLabel(_testResult.HandoffTarget)</Typography>
                                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@_testResult.Reason. The agent stopped before replying and prepared the conversation context.</Typography>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="test-composer">
                                <label for="agent-test-message" class="@TextStyle.Small12Semibold.ToClassName()">Customer message</label>
                                <div>
                                    <textarea id="agent-test-message"
                                              class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                                              maxlength="400"
                                              rows="2"
                                              placeholder="Write a realistic customer message…"
                                              value="@_testMessage"
                                              @oninput="e => { _testMessage = e.Value?.ToString() ?? string.Empty; _testResult = null; }"></textarea>
                                    <Button Size="ButtonSize.Small" aria-label="Run agent test" disabled="@(_testMessage.Trim().Length < 4)" @onclick="RunTest">
                                        <ChildContent>Run test</ChildContent>
                                        <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                                    </Button>
                                </div>
                                <Typography TextStyle="TextStyle.Small10Regular" As="small">@_testMessage.Length/400 · Nothing will be sent</Typography>
                            </div>

                            @if (_testResult is not null)
                            {
                                <section class="test-evidence">
                                    <header>
                                        <div>
                                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Why this is safe</Typography>
                                            <Typography TextStyle="TextStyle.Small12Regular" As="p">See what the agent used and which rules were applied.</Typography>
                                        </div>
                                        <div>
                                            <Typography TextStyle="TextStyle.HeadingH4Semibold" As="strong">—</Typography>
                                            <Typography TextStyle="TextStyle.Small10Regular" As="span">Confidence</Typography>
                                        </div>
                                    </header>
                                    <div class="test-confidence">
                                        <i><b class="@(_testResult.Handoff ? "is-handoff" : null)" style="width: 0%"></b></i>
                                        <Typography TextStyle="TextStyle.Small10Regular" As="small">
                                            @(_testResult.Handoff
                                                ? $"Below the {_draft.ConfidenceThreshold}% answer threshold or a mandatory handoff"
                                                : $"Above the {_draft.ConfidenceThreshold}% answer threshold")
                                        </Typography>
                                    </div>
                                    <div class="test-check-list">
                                        @foreach (var check in _testResult.Checks)
                                        {
                                            <article>
                                                <span class="@(check.Handoff ? "is-handoff" : null)">
                                                    <Icon Name="@(check.Handoff ? IconName.RiUserSharedFill : IconName.RiCheckboxCircleFill)" Size="IconSize.Sm" />
                                                </span>
                                                <div>
                                                    <Typography TextStyle="TextStyle.Small10Semibold" As="strong">@check.Label</Typography>
                                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">@check.Detail</Typography>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </section>
                    </div>
                    <footer class="builder-form-footer">
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => GoTo(5)">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                            <ChildContent>Back</ChildContent>
                        </Button>
                        <Button disabled="@(_draft.TestStatus != AgentTestStatus.Passed)" @onclick="() => GoTo(7)">
                            <ChildContent>Continue to activation</ChildContent>
                            <IconRight><Icon Name="IconName.RiArrowRightSLine" /></IconRight>
                        </Button>
                    </footer>
                </div>
            }
            else
            {
                <div class="activation-builder">
                    <header class="builder-step-header">
                        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Step 7 of 7</Typography>
                        <Typography TextStyle="TextStyle.HeadingH2Semibold" As="h2">Review and activate @DraftName</Typography>
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>Everything is ready. Confirm how this agent will work before it joins your social inbox.</Typography>
                    </header>
                    <div class="activation-body">
                        <section class="activation-ready-hero">
                            <span><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Lg" /></span>
                            <div>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Ready to meet customers</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@DraftName has approved knowledge, clear boundaries and passed every required safety test.</Typography>
                            </div>
                            <Typography TextStyle="TextStyle.Small10Semibold" As="em">7 of 7 complete</Typography>
                        </section>

                        <div class="activation-review-grid">
                            <section class="activation-review-card identity-review">
                                <header>
                                    <span class="agent-tone-slate"><img src="@AgentBuilderCopy.MascotImage(_draft.Mascot)" alt="" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Identity</Typography>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">@DraftName</Typography>
                                    </div>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                </header>
                                <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@_draft.Role</Typography>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@_draft.Description</Typography>
                            </section>

                            <section class="activation-review-card">
                                <header>
                                    <span><Icon Name="IconName.RiBookOpenFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Business knowledge</Typography>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">@ReviewSources.Count trusted source@(ReviewSources.Count == 1 ? "" : "s")</Typography>
                                    </div>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                </header>
                                <div class="activation-detail-list">
                                    @foreach (var source in ReviewSources.Take(3))
                                    {
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="span">@source.Name</Typography>
                                    }
                                    @if (ReviewSources.Count > 3)
                                    {
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="span">+@(ReviewSources.Count - 3) more</Typography>
                                    }
                                </div>
                            </section>

                            <section class="activation-review-card">
                                <header>
                                    <span><Icon Name="IconName.RiGlobalFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Social coverage</Typography>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">@_draft.Channels.Count channel@(_draft.Channels.Count == 1 ? "" : "s")</Typography>
                                    </div>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                </header>
                                <div class="activation-channel-list">
                                    @foreach (var channel in BoundaryChannels.Where(c => _draft.Channels.Contains(c.Id)))
                                    {
                                        <span class="activation-channel-@channel.Id">
                                            <Icon Name="@channel.Icon" Size="IconSize.Inherit" />
                                            <Typography TextStyle="TextStyle.Small10Semibold" As="span">@channel.Label</Typography>
                                        </span>
                                    }
                                </div>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@_draft.AllowedActions.Count customer tasks allowed</Typography>
                            </section>

                            <section class="activation-review-card">
                                <header>
                                    <span><Icon Name="IconName.RiShieldCheckFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Safety &amp; handoff</Typography>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Protected by clear rules</Typography>
                                    </div>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                </header>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>
                                    Hands over below <strong class="@TextStyle.Small12Semibold.ToClassName()">@_draft.ConfidenceThreshold% confidence</strong> and whenever a customer asks for a person.
                                </Typography>
                                <div class="activation-inline-detail">
                                    <Icon Name="IconName.RiUserSharedFill" Size="IconSize.Inherit" />
                                    <Typography TextStyle="TextStyle.Small10Semibold" As="span">@AgentBuilderCopy.HandoffLabel(_draft.HandoffTarget)</Typography>
                                </div>
                            </section>

                            <section class="activation-review-card">
                                <header>
                                    <span><Icon Name="IconName.RiChatSmile3Fill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Voice &amp; tone</Typography>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">@SelectedVoice.Label</Typography>
                                    </div>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                </header>
                                <div class="activation-detail-list">
                                    <Typography TextStyle="TextStyle.Small10Semibold" As="span">@(ResponseLengths.First(o => o.Id == _draft.ResponseLength).Label) replies</Typography>
                                    <Typography TextStyle="TextStyle.Small10Semibold" As="span">@(EmojiOptions.First(o => o.Id == _draft.EmojiUsage).Label) emoji use</Typography>
                                    @if (_draft.UseCustomerName)
                                    {
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="span">Uses first names</Typography>
                                    }
                                </div>
                            </section>

                            <section class="activation-review-card">
                                <header>
                                    <span><Icon Name="IconName.RiFlashlightFill" Size="IconSize.Md" /></span>
                                    <div>
                                        <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="ds-overline">Safety testing</Typography>
                                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Required tests passed</Typography>
                                    </div>
                                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                                </header>
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>
                                    3 of 3 required scenarios complete across <strong class="@TextStyle.Small12Semibold.ToClassName()">@_draft.TestRunCount total test run@(_draft.TestRunCount == 1 ? "" : "s")</strong>.
                                </Typography>
                            </section>
                        </div>

                        <section class="activation-launch-card">
                            <div>
                                <span><Icon Name="IconName.RiSparkling2Fill" Size="IconSize.Md" /></span>
                                <div>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">What happens after activation?</Typography>
                                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose>@DraftName will begin handling new matching conversations on the selected social channels. Existing conversations stay with their current owner.</Typography>
                                </div>
                            </div>
                            <ul>
                                <li><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" /><Typography TextStyle="TextStyle.Small10Regular" As="span" Prose>Human takeover stays available from every conversation</Typography></li>
                                <li><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" /><Typography TextStyle="TextStyle.Small10Regular" As="span" Prose>You can deactivate the agent anytime from AI Operations</Typography></li>
                            </ul>
                        </section>
                    </div>
                    <footer class="builder-form-footer activation-footer">
                        <Button Variant="ButtonVariant.Secondary" @onclick="() => GoTo(6)">
                            <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                            <ChildContent>Back to testing</ChildContent>
                        </Button>
                        <div>
                            <Typography TextStyle="TextStyle.Small10Regular" As="span">Starts with new conversations only</Typography>
                            <Button disabled="@(_draft.TestStatus != AgentTestStatus.Passed)" @onclick="Activate">
                                <ChildContent>Activate @DraftName</ChildContent>
                                <IconRight><Icon Name="IconName.RiCheckboxCircleFill" /></IconRight>
                            </Button>
                        </div>
                    </footer>
                </div>
            }
        </section>
    </div>
</main>

@code {
    /// <summary>The Parrot agent being edited, or null to create one.</summary>
    [Parameter] public AiAgent? Agent { get; set; }

    [Parameter, EditorRequired] public AgentKnowledgeWorkspace Knowledge { get; set; } = new();

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<AgentSetupDraft> OnIdentitySaved { get; set; }
    [Parameter] public EventCallback<AgentSetupDraft> OnOrientationSaved { get; set; }
    [Parameter] public EventCallback<AgentSetupDraft> OnBoundariesSaved { get; set; }
    [Parameter] public EventCallback<AgentSetupDraft> OnVoiceSaved { get; set; }
    [Parameter] public EventCallback<AgentSetupDraft> OnTestUpdated { get; set; }
    [Parameter] public EventCallback<AgentSetupDraft> OnActivated { get; set; }

    // ── Static copy ──────────────────────────────────────────────────────

    private sealed record RoleTemplate(AgentRoleTemplate Id, string Name, string Role, string Description, string Helper, IconName Icon);
    private sealed record BuilderStep(int Number, string Label, string Helper, IconName Icon);
    private sealed record PermissionOption(AgentPermission Id, string Label, string Helper, IconName Icon, bool Elevated = false);
    private sealed record ChannelOption(string Id, string Label, IconName Icon);
    private sealed record VoicePresetOption(AgentVoicePreset Id, string Label, string Helper, string Sample, IconName Icon);
    private sealed record ChoiceOption<T>(T Id, string Label, string Helper);
    private sealed record TestScenario(AgentTestScenarioId Id, string Label, string Helper, string Message, IconName Icon, bool Required = false);

    private static readonly RoleTemplate[] RoleTemplates =
    [
        new(AgentRoleTemplate.Sales, "Sales & growth", "Sales & growth specialist", "Qualifies enquiries, recommends the right offer and helps customers move confidently toward purchase.", "Leads, recommendations and follow-up", IconName.RiShoppingBag3Fill),
        new(AgentRoleTemplate.Support, "Customer support", "Customer care specialist", "Answers support questions with empathy, explains policies and escalates sensitive cases early.", "Questions, complaints and resolutions", IconName.RiCustomerService2Fill),
        new(AgentRoleTemplate.Orders, "Orders & products", "Orders & product specialist", "Answers product questions, checks availability and keeps customers updated on their orders.", "Availability, delivery and tracking", IconName.RiTruckFill),
        new(AgentRoleTemplate.Custom, "Build my own", "", "", "Start with a blank role for your workflow", IconName.RiSparkling2Fill)
    ];

    private static readonly BuilderStep[] Steps =
    [
        new(1, "Choose a role", "Pick a starting point", IconName.RiStore2Fill),
        new(2, "Identity", "Name and purpose", IconName.RiRobot3Fill),
        new(3, "Business knowledge", "Orient your agent", IconName.RiBookOpenFill),
        new(4, "Boundaries", "Actions and handoff", IconName.RiShieldCheckFill),
        new(5, "Voice", "How it communicates", IconName.RiChatSmile3Fill),
        new(6, "Test", "Try real questions", IconName.RiFlashlightFill),
        new(7, "Activate", "Review and go live", IconName.RiCheckboxCircleFill)
    ];

    private static readonly PermissionOption[] Permissions =
    [
        new(AgentPermission.AnswerQuestions, "Answer business questions", "Use approved knowledge to respond", IconName.RiQuestionAnswerFill),
        new(AgentPermission.RecommendProducts, "Recommend products", "Suggest relevant products or services", IconName.RiShoppingBag3Fill),
        new(AgentPermission.LookUpOrders, "Look up order status", "Read order and delivery information", IconName.RiSearchEyeFill),
        new(AgentPermission.CollectDetails, "Collect customer details", "Ask for contact or order information", IconName.RiContactsBook3Fill),
        new(AgentPermission.CreateDiscounts, "Create discounts", "Offer an approved discount", IconName.RiPriceTag3Fill, Elevated: true),
        new(AgentPermission.ApproveRefunds, "Approve refunds", "Approve refunds within your limit", IconName.RiRefund2Fill, Elevated: true)
    ];

    private static readonly Dictionary<AgentRoleTemplate, AgentPermission[]> PermissionDefaults = new()
    {
        [AgentRoleTemplate.Sales] = [AgentPermission.AnswerQuestions, AgentPermission.RecommendProducts, AgentPermission.CollectDetails],
        [AgentRoleTemplate.Support] = [AgentPermission.AnswerQuestions, AgentPermission.LookUpOrders, AgentPermission.CollectDetails],
        [AgentRoleTemplate.Orders] = [AgentPermission.AnswerQuestions, AgentPermission.LookUpOrders, AgentPermission.CollectDetails],
        [AgentRoleTemplate.Custom] = [AgentPermission.AnswerQuestions]
    };

    private static readonly AgentHandoffTarget[] HandoffTargets =
    [
        AgentHandoffTarget.GeneralTeam, AgentHandoffTarget.SalesTeam, AgentHandoffTarget.SupportTeam, AgentHandoffTarget.WorkspaceAdmins
    ];

    private static readonly int[] Thresholds = [60, 70, 75, 80];

    private static readonly ChannelOption[] BoundaryChannels =
    [
        new("whatsapp", "WhatsApp", IconName.RiWhatsappFill),
        new("instagram", "Instagram", IconName.RiInstagramFill),
        new("facebook", "Facebook", IconName.RiFacebookCircleFill)
    ];

    private static readonly VoicePresetOption[] VoicePresets =
    [
        new(AgentVoicePreset.Warm, "Warm & human", "Calm, caring and easy to talk to", "I’m happy to help you sort that out.", IconName.RiChatSmile3Fill),
        new(AgentVoicePreset.Professional, "Clear & professional", "Direct, composed and dependable", "I can help you resolve this efficiently.", IconName.RiShieldCheckFill),
        new(AgentVoicePreset.Upbeat, "Friendly & upbeat", "Bright, encouraging and energetic", "Great choice — let’s find the best option!", IconName.RiSparkling2Fill)
    ];

    private static readonly ChoiceOption<AgentResponseLength>[] ResponseLengths =
    [
        new(AgentResponseLength.Concise, "Brief", "1–2 short sentences"),
        new(AgentResponseLength.Balanced, "Balanced", "Enough detail to be useful"),
        new(AgentResponseLength.Detailed, "Detailed", "Step-by-step when needed")
    ];

    private static readonly ChoiceOption<AgentEmojiUsage>[] EmojiOptions =
    [
        new(AgentEmojiUsage.None, "None", "Text only"),
        new(AgentEmojiUsage.Light, "Light", "Only when natural"),
        new(AgentEmojiUsage.Expressive, "Expressive", "More social and lively")
    ];

    private static readonly TestScenario[] TestScenarios =
    [
        new(AgentTestScenarioId.BusinessQuestion, "Business information", "Checks an approved factual answer", "Do you deliver to customers outside Lagos?", IconName.RiQuestionAnswerFill, Required: true),
        new(AgentTestScenarioId.HumanRequest, "Customer asks for a human", "Checks the mandatory handoff", "I would like to speak with a person, please.", IconName.RiUserSharedFill, Required: true),
        new(AgentTestScenarioId.UnknownQuestion, "Answer is not known", "Checks that the agent will not guess", "Can you deliver catering for 40 people to Abeokuta next Tuesday?", IconName.RiAlarmWarningFill, Required: true),
        new(AgentTestScenarioId.OrderStatus, "Order status", "Checks task permissions and policy", "Where is order AD-1048?", IconName.RiTruckFill),
        new(AgentTestScenarioId.Custom, "Write your own", "Try any realistic customer message", "", IconName.RiChatSmile3Fill)
    ];

    private static readonly RenderFragment GlobeGlyph = @<Icon Name="IconName.RiGlobalFill" Size="IconSize.Sm" />;

    // ── State ────────────────────────────────────────────────────────────

    private int _step = 1;
    private AgentSetupDraft _draft = new();
    private readonly List<string> _selectedSourceIds = new();
    private string? _knowledgeAction;
    private string? _website;
    private InputFile? _documentInput;
    private string? _openMenu;
    private string? _avoidPhraseInput;
    private AgentTestScenarioId _testScenarioId = AgentTestScenarioId.BusinessQuestion;
    private string _testMessage = TestScenarios[0].Message;
    private AgentTestResult? _testResult;

    private string DraftName => string.IsNullOrWhiteSpace(_draft.Name) ? "your agent" : _draft.Name.Trim();

    private bool IdentityValid =>
        !string.IsNullOrWhiteSpace(_draft.Name) && !string.IsNullOrWhiteSpace(_draft.Role) && !string.IsNullOrWhiteSpace(_draft.Description);

    private string DraftStateLabel => _draft.TestStatus switch
    {
        AgentTestStatus.Passed => "Tests passed",
        AgentTestStatus.InProgress => "Testing",
        _ when _draft.VoiceStatus == AgentSectionStatus.Ready => "Voice ready",
        _ when _draft.BoundaryStatus == AgentSectionStatus.Ready => "Boundaries ready",
        _ when _draft.OrientationStatus == AgentOrientationStatus.Ready => "Knowledge ready",
        _ => "Draft"
    };

    private VoicePresetOption SelectedVoice => VoicePresets.First(p => p.Id == _draft.VoicePreset);

    private string PreviewGreeting =>
        System.Text.RegularExpressions.Regex.Replace(_draft.Greeting, @"\{first_name\}", _draft.UseCustomerName ? "Amaka" : "there", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private string PreviewDetail => _draft.ResponseLength switch
    {
        AgentResponseLength.Concise => "Your order is on the way and should arrive tomorrow.",
        AgentResponseLength.Detailed => "Your order is on the way. It left our Lagos hub this morning and should arrive tomorrow between 10am and 2pm. I can also share the tracking link.",
        _ => "Your order left our Lagos hub this morning and should arrive tomorrow. I can share the tracking link if you’d like."
    };

    private string PreviewEmoji => _draft.EmojiUsage switch
    {
        AgentEmojiUsage.None => "",
        AgentEmojiUsage.Expressive => " ✨😊",
        _ => " 🙂"
    };

    private static readonly AgentTestScenarioId[] RequiredScenarioIds =
        TestScenarios.Where(s => s.Required).Select(s => s.Id).ToArray();

    private int CompletedRequiredCount => RequiredScenarioIds.Count(id => _draft.CompletedTestScenarioIds.Contains(id));

    private List<AgentKnowledgeSource> ReviewSources =>
        Knowledge.Sources.Where(source => _draft.KnowledgeSourceIds.Contains(source.Id)).ToList();

    protected override void OnInitialized()
    {
        var template = RoleTemplates.First(t => t.Id == AgentRoleTemplate.Support);
        _draft = new AgentSetupDraft
        {
            AgentId = Agent?.Id,
            IdentitySaved = Agent is not null,
            Name = Agent?.Name ?? string.Empty,
            Role = template.Role,
            Description = Agent?.Description ?? template.Description,
            Mascot = Agent?.Mascot ?? "Nova",
            AllowedActions = PermissionDefaults[AgentRoleTemplate.Support].ToList()
        };
        if (Agent is not null)
        {
            var enabled = Agent.Channels.Where(c => c.IsEnabled).Select(c => c.Key.ToLowerInvariant()).ToList();
            if (enabled.Count > 0) _draft.Channels = enabled;
        }
        _draft.Greeting = DefaultGreeting();
        _selectedSourceIds.AddRange(Knowledge.Sources.Select(s => s.Id));
        _step = Agent is null ? 1 : 2;
    }

    private string DefaultGreeting() =>
        $"Hi {{first_name}}, I’m {(string.IsNullOrWhiteSpace(_draft.Name) ? "your assistant" : _draft.Name.Trim())}. How can I help today?";

    private bool StepAvailable(int number) => number switch
    {
        <= 2 => true,
        3 => _draft.IdentitySaved,
        4 => _draft.IdentitySaved && _draft.OrientationStatus != AgentOrientationStatus.NotStarted,
        5 => _draft.IdentitySaved && _draft.BoundaryStatus == AgentSectionStatus.Ready,
        6 => _draft.IdentitySaved && _draft.VoiceStatus == AgentSectionStatus.Ready,
        7 => _draft.IdentitySaved && _draft.TestStatus == AgentTestStatus.Passed,
        _ => false
    };

    private void GoTo(int number)
    {
        if (StepAvailable(number)) _step = number;
    }

    // ── Step 1–2 ─────────────────────────────────────────────────────────

    private void SelectRole(RoleTemplate template)
    {
        _draft.RoleTemplate = template.Id;
        _draft.Role = template.Role;
        _draft.Description = template.Description;
        if (_draft.BoundaryStatus == AgentSectionStatus.NotStarted)
            _draft.AllowedActions = PermissionDefaults[template.Id].ToList();
    }

    private async Task SaveIdentity()
    {
        if (!IdentityValid) return;
        _draft.Name = _draft.Name.Trim();
        _draft.Role = _draft.Role.Trim();
        _draft.Description = _draft.Description.Trim();
        _draft.IdentitySaved = true;
        if (_draft.VoiceStatus == AgentSectionStatus.NotStarted) _draft.Greeting = DefaultGreeting();
        await OnIdentitySaved.InvokeAsync(_draft);
        _step = 3;
    }

    // ── Step 3 ───────────────────────────────────────────────────────────

    private void ToggleSource(string id)
    {
        if (!_selectedSourceIds.Remove(id)) _selectedSourceIds.Add(id);
    }

    private void AddWebsite()
    {
        var url = _website?.Trim();
        if (string.IsNullOrEmpty(url)) return;
        var source = new AgentKnowledgeSource { Name = url, Type = "website" };
        Knowledge.Sources.Add(source);
        _selectedSourceIds.Add(source.Id);
        _website = null;
        _knowledgeAction = null;
    }

    private async Task PickDocument()
    {
        if (_documentInput?.Element is { } element) await Interop.ClickAsync(element);
    }

    private void AddDocument(InputFileChangeEventArgs args)
    {
        var file = args.File;
        var source = new AgentKnowledgeSource { Name = file.Name, Type = "document" };
        Knowledge.Sources.Add(source);
        _selectedSourceIds.Add(source.Id);
    }

    private async Task SaveOrientation()
    {
        if (!_draft.IdentitySaved || _selectedSourceIds.Count == 0) return;
        _draft.KnowledgeSourceIds = _selectedSourceIds.ToList();
        // Aurora's rule: two or more trusted sources count as ready.
        _draft.OrientationStatus = _selectedSourceIds.Count >= 2 ? AgentOrientationStatus.Ready : AgentOrientationStatus.InProgress;
        await OnOrientationSaved.InvokeAsync(_draft);
        _step = 4;
    }

    // ── Step 4 ───────────────────────────────────────────────────────────

    private void ToggleChannel(string id)
    {
        if (!_draft.Channels.Remove(id)) _draft.Channels.Add(id);
    }

    private void TogglePermission(AgentPermission id)
    {
        if (!_draft.AllowedActions.Remove(id)) _draft.AllowedActions.Add(id);
    }

    private async Task SaveBoundaries()
    {
        if (!_draft.IdentitySaved || _draft.Channels.Count == 0 || _draft.AllowedActions.Count == 0) return;
        _draft.BoundaryStatus = AgentSectionStatus.Ready;
        await OnBoundariesSaved.InvokeAsync(_draft);
        if (_draft.VoiceStatus == AgentSectionStatus.NotStarted) _draft.Greeting = DefaultGreeting();
        _step = 5;
    }

    // ── Step 5 ───────────────────────────────────────────────────────────

    private void OnAvoidPhraseKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") AddAvoidPhrase();
    }

    private void AddAvoidPhrase()
    {
        var phrase = _avoidPhraseInput?.Trim();
        if (string.IsNullOrEmpty(phrase) || _draft.AvoidPhrases.Count >= 6) return;
        if (_draft.AvoidPhrases.Any(item => string.Equals(item, phrase, StringComparison.CurrentCultureIgnoreCase))) return;
        _draft.AvoidPhrases.Add(phrase);
        _avoidPhraseInput = null;
    }

    private async Task SaveVoice()
    {
        if (!_draft.IdentitySaved || _draft.Greeting.Trim().Length < 10) return;
        _draft.Greeting = _draft.Greeting.Trim();
        _draft.VoiceStatus = AgentSectionStatus.Ready;
        await OnVoiceSaved.InvokeAsync(_draft);
        _step = 6;
    }

    // ── Step 6 ───────────────────────────────────────────────────────────

    private void SelectTestScenario(TestScenario scenario)
    {
        _testScenarioId = scenario.Id;
        _testMessage = scenario.Message;
        _testResult = null;
    }

    // Parrot has no answer engine to put behind the sandbox, so a run is
    // resolved by the draft's own handoff rules: the mandatory rules Aurora
    // always applies, plus the permissions chosen in step 4. Every run hands
    // over — with no approved knowledge there is nothing safe to answer from.
    private async Task RunTest()
    {
        var message = _testMessage.Trim();
        if (!_draft.IdentitySaved || message.Length < 4) return;

        var lookUpAllowed = _draft.AllowedActions.Contains(AgentPermission.LookUpOrders);
        var hasSources = _draft.KnowledgeSourceIds.Count > 0;

        string reason;
        AgentTestCheck[] checks;
        switch (_testScenarioId)
        {
            case AgentTestScenarioId.HumanRequest:
                reason = "The customer asked for a person";
                checks =
                [
                    new AgentTestCheck("Customer asked for a person", "Mandatory handoff rule applied", true),
                    new AgentTestCheck("Reply held back", "No answer was sent before handing over", false)
                ];
                break;
            case AgentTestScenarioId.OrderStatus when !lookUpAllowed:
                reason = "Looking up orders is not an allowed action";
                checks =
                [
                    new AgentTestCheck("Permission checked", "Order look-up is not in this agent's allowed actions", true),
                    new AgentTestCheck("No guess made", "The agent did not invent an order status", false)
                ];
                break;
            case AgentTestScenarioId.OrderStatus:
                reason = "No order record is connected to answer from";
                checks =
                [
                    new AgentTestCheck("Permission checked", "Order look-up is an allowed action", false),
                    new AgentTestCheck("Confidence below threshold", $"Below the {_draft.ConfidenceThreshold}% answer threshold", true)
                ];
                break;
            default:
                reason = hasSources ? "No approved source covers this question" : "No approved knowledge source is connected";
                checks =
                [
                    new AgentTestCheck("Did not guess", "No claim was made without an approved source", false),
                    new AgentTestCheck("Confidence below threshold", $"Below the {_draft.ConfidenceThreshold}% answer threshold", true)
                ];
                break;
        }

        _testResult = new AgentTestResult
        {
            ScenarioId = _testScenarioId,
            Handoff = true,
            CustomerMessage = message,
            Reason = reason,
            HandoffTarget = _draft.HandoffTarget,
            Checks = checks
        };

        if (!_draft.CompletedTestScenarioIds.Contains(_testScenarioId)) _draft.CompletedTestScenarioIds.Add(_testScenarioId);
        _draft.TestRunCount++;
        _draft.TestStatus = CompletedRequiredCount == RequiredScenarioIds.Length ? AgentTestStatus.Passed : AgentTestStatus.InProgress;
        await OnTestUpdated.InvokeAsync(_draft);
    }

    // ── Step 7 ───────────────────────────────────────────────────────────

    private async Task Activate()
    {
        if (!_draft.IdentitySaved || _draft.TestStatus != AgentTestStatus.Passed) return;
        await OnActivated.InvokeAsync(_draft);
    }
}
