@page "/dashboard/ai-agents/{AgentId}/orientation"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@inject NavigationManager Nav
@inject AiAgentsState AiAgentsState
@inject AuroraInterop Interop
@implements IDisposable

@* Parrot's first-day orientation chat: a scripted conversation that fills an
   agent profile as it goes. No Aurora screen exists for it, so it wears
   Aurora's setup-card and conversation dress — the composer, bubbles and
   profile checklist follow the builder's sandbox and step rail. *@

@{
    var agent = AiAgentsState.GetAgent(AgentId);
}

<PageTitle>Orientation · @(agent?.Name ?? "Agent") · OmniAI</PageTitle>

@if (agent is null)
{
    <main class="orientation">
        <EmptyState Glyph="IconName.RiRobot3Fill"
                    Title="Agent not found"
                    Description="This agent does not exist or has been deleted.">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick='() => Nav.NavigateTo("/dashboard/ai-agents")'>Back to agents</Button>
            </Action>
        </EmptyState>
    </main>
}
else
{
    <main class="orientation">
        <header class="orientation__bar">
            <button type="button" class="orientation__back" @onclick="Exit">
                <Icon Name="IconName.RiArrowLeftLine" Size="IconSize.Md" />
                <Typography TextStyle="TextStyle.Small12Semibold" As="span">Back to @agent.Name</Typography>
            </button>
            <div class="orientation__bar-actions">
                <Button Variant="ButtonVariant.Secondary" @onclick="Exit">Save &amp; exit</Button>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Close orientation" @onclick="Exit">
                    <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
                </Button>
            </div>
        </header>

        <div class="orientation__body">
            <section class="orientation__chat">
                <header class="orientation__strip">
                    <span class="orientation__avatar agent-tone-slate">
                        <img src="@AgentBuilderCopy.MascotImage(agent.Mascot)" alt="" />
                    </span>
                    <div class="orientation__strip-text">
                        <div class="orientation__strip-row">
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@agent.Name</Typography>
                            <StatusBadge Tone="@(_phase == "activated" ? StatusTone.Success : StatusTone.Brand)">
                                @(_phase == "activated" ? "Active" : "First day · in orientation")
                            </StatusBadge>
                        </div>
                        <Typography TextStyle="TextStyle.Small12Regular" As="small">Getting to know the part of work it will own</Typography>
                    </div>
                </header>

                <div class="orientation__messages" @ref="_messagesElement">
                    @foreach (var msg in _messages)
                    {
                        @if (msg.Role == "divider")
                        {
                            <div class="orientation__divider">
                                <span></span>
                                <Typography TextStyle="TextStyle.Small10Semibold" As="em" Class="ds-overline">@msg.Text</Typography>
                                <span></span>
                            </div>
                        }
                        else if (msg.Role == "agent")
                        {
                            <div class="orientation__row orientation__row--agent">
                                <span class="orientation__bubble-avatar agent-tone-slate">
                                    <img src="@AgentBuilderCopy.MascotImage(agent.Mascot)" alt="" />
                                </span>
                                <div class="orientation__bubble orientation__bubble--agent">
                                    <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@msg.Text</Typography>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="orientation__row orientation__row--user">
                                <div class="orientation__bubble orientation__bubble--user">
                                    <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@msg.Text</Typography>
                                </div>
                            </div>
                        }
                    }

                    @if (_typing)
                    {
                        <div class="orientation__row orientation__row--agent" aria-live="polite" aria-label="@($"{agent.Name} is typing")">
                            <span class="orientation__bubble-avatar agent-tone-slate">
                                <img src="@AgentBuilderCopy.MascotImage(agent.Mascot)" alt="" />
                            </span>
                            <div class="orientation__typing">
                                @* The brand's Typing loader: the agent is composing a reply. *@
                                <CadenceLoader Kind="CadenceLoaderKind.Typing" Size="24" />
                            </div>
                        </div>
                    }
                </div>

                <div class="orientation__dock">
                    @if (_showChoices && CurrentStep is { } cur)
                    {
                        <div class="orientation__choices">
                            @if (!_isMulti && cur.Defaults.Length > 0)
                            {
                                <button type="button" class="orientation__suggested" @onclick="() => ChooseSingle(cur.Defaults[0])">
                                    <Typography TextStyle="TextStyle.Small10Semibold" As="em" Class="ds-overline">Suggested</Typography>
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose>@cur.Defaults[0]</Typography>
                                </button>
                            }
                            @if (!string.IsNullOrEmpty(cur.Helper))
                            {
                                <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="orientation__helper">@cur.Helper</Typography>
                            }
                            <div class="orientation__chips">
                                @foreach (var chip in _isMulti ? cur.Defaults.Concat(cur.Chips) : cur.Chips)
                                {
                                    var label = chip;
                                    var sel = _selected.Contains(label);
                                    <button type="button"
                                            class="@(sel ? "orientation__chip is-selected" : "orientation__chip")"
                                            aria-pressed="@sel.ToString().ToLowerInvariant()"
                                            @onclick="() => { if (_isMulti) ToggleChip(label); else _ = ChooseSingle(label); }">
                                        @if (sel)
                                        {
                                            <Icon Name="IconName.RiCheckFill" Size="IconSize.Inherit" />
                                        }
                                        <Typography TextStyle="TextStyle.Small12Semibold" As="span">@label</Typography>
                                    </button>
                                }
                            </div>
                            @if (_isMulti)
                            {
                                var canConfirm = _selected.Count > 0;
                                <Button Class="orientation__confirm" disabled="@(!canConfirm)" @onclick="ConfirmMulti">
                                    @(canConfirm ? $"Looks good — continue with {_selected.Count}" : "Select at least one")
                                </Button>
                            }
                        </div>
                    }

                    @if (_phase == "review")
                    {
                        <div class="orientation__review">
                            <Button @onclick="Activate">
                                <IconLeft><Icon Name="IconName.RiCheckFill" /></IconLeft>
                                <ChildContent>Activate agent</ChildContent>
                            </Button>
                            <Button Variant="ButtonVariant.Secondary" @onclick="() => _ = TestAgent()">
                                <IconLeft><Icon Name="IconName.RiPlayFill" /></IconLeft>
                                <ChildContent>Test agent</ChildContent>
                            </Button>
                        </div>
                    }

                    @if (_phase == "activated")
                    {
                        <div class="orientation__activated">
                            <span><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Md" /></span>
                            <Typography TextStyle="TextStyle.Small12Semibold" As="p" Prose>@agent.Name is live and ready to help your customers.</Typography>
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="() => _ = TestAgent()">Run a quick test</Button>
                        </div>
                    }

                    <div class="@(_inputDisabled ? "orientation__composer is-disabled" : "orientation__composer")">
                        <input class="@TextStyle.BodySmallRegular.ToClassName()"
                               placeholder="@_inputPlaceholder"
                               aria-label="Your answer"
                               disabled="@_inputDisabled"
                               value="@_inputValue"
                               @oninput="e => _inputValue = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="OnKeyDown" />
                        <Button Size="ButtonSize.Small" aria-label="Send" disabled="@_inputDisabled" @onclick="() => _ = Send()">
                            <IconLeft><Icon Name="IconName.RiSendPlaneFill" /></IconLeft>
                        </Button>
                    </div>
                </div>
            </section>

            <aside class="orientation__profile" aria-label="Agent profile">
                <header class="orientation__profile-head">
                    <div class="orientation__profile-row">
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Agent profile</Typography>
                        <StatusBadge Tone="@(_phase == "activated" ? StatusTone.Success : StatusTone.Brand)">
                            @(_phase == "activated" ? "Active" : "In orientation")
                        </StatusBadge>
                    </div>
                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Filling in as you talk — @DoneCount of 6 captured</Typography>
                    <div class="orientation__progress" role="progressbar" aria-valuenow="@DoneCount" aria-valuemin="0" aria-valuemax="6">
                        <i style="width: @(ProgressPct.ToString("F0"))%"></i>
                    </div>
                </header>

                @{ var pendingOrder = 0; }
                @foreach (var sec in ProfileSections)
                {
                    <section class="@(sec.Done ? "orientation__section is-done" : "orientation__section")">
                        <header>
                            <span class="orientation__section-icon"><Icon Name="@sec.Glyph" Size="IconSize.Sm" /></span>
                            <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@sec.Label</Typography>
                            @if (sec.Done)
                            {
                                <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" Class="orientation__section-check" />
                            }
                        </header>

                        @if (sec.Done && !string.IsNullOrEmpty(sec.TextValue))
                        {
                            <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="orientation__section-text">@sec.TextValue</Typography>
                        }
                        @if (sec.Done && sec.ListValues is { Count: > 0 })
                        {
                            <ul class="orientation__section-list">
                                @foreach (var item in sec.ListValues)
                                {
                                    <li><i></i><Typography TextStyle="TextStyle.Small12Regular" As="span" Prose>@item</Typography></li>
                                }
                            </ul>
                        }
                        @if (!sec.Done)
                        {
                            @* Placeholders pulse in sequence down the whole rail,
                               not just within one section. *@
                            var order = pendingOrder;
                            pendingOrder += 2;
                            <div class="orientation__section-pending">
                                <Skeleton Width="90%" Order="@order" />
                                <Skeleton Width="60%" Order="@(order + 1)" />
                            </div>
                        }
                    </section>
                }
            </aside>
        </div>
    </main>
}

@code {
    [Parameter] public string AgentId { get; set; } = string.Empty;

    // ── Data model ──────────────────────────────────────────────────────────────
    record ChatMessage(string Role, string Text);

    record OrientationStep(
        string Field, string Type, string AgentText,
        string[] Defaults, string[] Chips, string Helper = "");

    record ProfileSection(
        string Label, IconName Glyph, bool Done,
        string? TextValue = null, List<string>? ListValues = null);

    static readonly OrientationStep[] Script =
    {
        new("org", "single",
            "Hi — I'm so glad to be joining the team! Think of this as my first day, and you're showing me the ropes.\n\nFirst, help me picture the bigger picture: what kind of organization am I joining?",
            new[] { "We're an online retail store — customers shop with us across web and WhatsApp, and we pride ourselves on fast, friendly support." },
            new[] { "B2B / wholesale supplier", "Service-based business", "Marketplace with many sellers" }),

        new("role", "single",
            "Wonderful — now I know who we are and who we're here for.\n\nNext, what part of the work would you like me to own?",
            new[] { "Front-line customer support — answer questions and resolve order & refund issues" },
            new[] { "Sales & lead qualification", "Appointment booking", "Billing & payments" }),

        new("tasks", "multi",
            "I love that — customer support is exactly where I shine.\n\nWhich day-to-day tasks should I handle? Pick as many as you like — I've checked the ones I'd suggest starting with.",
            new[] { "Answer product & FAQ questions", "Track & update order status", "Process refunds and returns" },
            new[] { "Qualify and route new leads", "Collect customer feedback", "Book callbacks with the team" },
            "Tap to add or remove a task."),

        new("knowledge", "multi",
            "Got it — I'll handle those with real care.\n\nNow, where should I learn the answers from? Point me to your sources of truth and I'll study them closely.",
            new[] { "Help Center articles", "Refund & returns policy", "Product catalog" },
            new[] { "Past WhatsApp conversations", "Shipping & delivery FAQ", "Internal team wiki" },
            "These become my knowledge base."),

        new("escalation", "multi",
            "Perfect — I want to know my limits too, so customers always feel looked after.\n\nWhen should I pause and bring in a human teammate?",
            new[] { "Customer is upset or frustrated", "Refund above $200", "Customer asks for a person" },
            new[] { "Legal or complaint mentioned", "Payment dispute / chargeback", "Anything I'm unsure about" },
            "I'll hand off smoothly whenever these come up."),

        new("success", "multi",
            "That makes sense — I'll always know when to tag someone in.\n\nLast one, and it's my favourite: how will we know I'm doing a great job?",
            new[] { "First reply under 1 minute", "CSAT above 90%", "Resolve 70% without a human" },
            new[] { "Reduce the response backlog", "Higher repeat-customer rate" },
            "These are the goals I'll work towards.")
    };

    // ── State ───────────────────────────────────────────────────────────────────
    readonly List<ChatMessage> _messages = new();
    int _step = -1;
    string _phase = "chat";
    bool _typing;
    readonly List<string> _selected = new();
    string _inputValue = string.Empty;
    bool _isTesting;
    readonly CancellationTokenSource _cts = new();
    ElementReference _messagesElement;

    // Profile fields
    string? _profOrg, _profRole;
    List<string>? _profTasks, _profKnowledge, _profEscalation, _profSuccess;

    // ── Computed ─────────────────────────────────────────────────────────────────
    bool _showChoices => _phase == "chat" && _step >= 0 && !_typing;
    OrientationStep? CurrentStep => _step >= 0 && _step < Script.Length ? Script[_step] : null;
    bool _isMulti => CurrentStep?.Type == "multi";
    bool _inputDisabled => _typing || _phase != "chat" || _step < 0;

    string _inputPlaceholder => _phase switch
    {
        "review"    => "Review the profile, then activate me →",
        "activated" => "I'm live — run a test above",
        _ when _isMulti => "Add your own…",
        _ => "Type your answer…"
    };

    int DoneCount => new[]
    {
        !string.IsNullOrEmpty(_profOrg),
        !string.IsNullOrEmpty(_profRole),
        _profTasks is { Count: > 0 },
        _profKnowledge is { Count: > 0 },
        _profEscalation is { Count: > 0 },
        _profSuccess is { Count: > 0 }
    }.Count(x => x);

    double ProgressPct => DoneCount * 100.0 / 6;

    IEnumerable<ProfileSection> ProfileSections => new[]
    {
        new ProfileSection("About the organization", IconName.RiBuilding2Fill,
            !string.IsNullOrEmpty(_profOrg), TextValue: _profOrg),

        new ProfileSection("Role & scope", IconName.RiUser3Fill,
            !string.IsNullOrEmpty(_profRole), TextValue: _profRole),

        new ProfileSection("Key tasks & playbook", IconName.RiTaskFill,
            _profTasks is { Count: > 0 }, ListValues: _profTasks),

        new ProfileSection("Knowledge sources", IconName.RiBookOpenFill,
            _profKnowledge is { Count: > 0 }, ListValues: _profKnowledge),

        new ProfileSection("Escalation rules", IconName.RiShieldCheckFill,
            _profEscalation is { Count: > 0 }, ListValues: _profEscalation),

        new ProfileSection("Success criteria", IconName.RiBarChartBoxFill,
            _profSuccess is { Count: > 0 }, ListValues: _profSuccess)
    };

    // ── Lifecycle ────────────────────────────────────────────────────────────────
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = StartOrientation();
    }

    async Task StartOrientation()
    {
        try
        {
            await Task.Delay(650, _cts.Token);
            await AskStep(0);
        }
        catch (OperationCanceledException) { }
    }

    // ── Chat engine ──────────────────────────────────────────────────────────────
    async Task AskStep(int index)
    {
        _typing = true;
        await InvokeAsync(StateHasChanged);
        try { await Task.Delay(1000, _cts.Token); }
        catch (OperationCanceledException) { return; }

        _typing = false;
        _step = index;
        _selected.Clear();
        if (Script[index].Type == "multi")
            _selected.AddRange(Script[index].Defaults);
        _messages.Add(new("agent", Script[index].AgentText));
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    async Task Advance(string displayText, object value)
    {
        _messages.Add(new("user", displayText));
        SetProfile(Script[_step].Field, value);
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();

        var next = _step + 1;
        if (next < Script.Length)
        {
            await AskStep(next);
        }
        else
        {
            _typing = true;
            await InvokeAsync(StateHasChanged);
            try { await Task.Delay(1100, _cts.Token); }
            catch (OperationCanceledException) { return; }

            _typing = false;
            _phase = "review";
            _step = Script.Length;
            _messages.Add(new("agent",
                "Amazing — I think I've got everything I need for day one!\n\nTake a look at my profile on the right. When it feels right, activate me and I'll get started. I can't wait to start helping your customers."));
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
    }

    void SetProfile(string field, object value)
    {
        switch (field)
        {
            case "org":        _profOrg        = value as string; break;
            case "role":       _profRole       = value as string; break;
            case "tasks":      _profTasks      = value as List<string>; break;
            case "knowledge":  _profKnowledge  = value as List<string>; break;
            case "escalation": _profEscalation = value as List<string>; break;
            case "success":    _profSuccess    = value as List<string>; break;
        }
    }

    async Task ChooseSingle(string label) => await Advance(label, label);

    void ToggleChip(string label)
    {
        if (_selected.Contains(label)) _selected.Remove(label);
        else _selected.Add(label);
        StateHasChanged();
    }

    async Task ConfirmMulti()
    {
        if (_selected.Count == 0) return;
        var cur = Script[_step];
        var all = cur.Defaults.Concat(cur.Chips).ToList();
        var ordered = all.Where(x => _selected.Contains(x)).ToList();
        var extras  = _selected.Where(x => !all.Contains(x)).ToList();
        var final   = ordered.Concat(extras).ToList();
        await Advance(string.Join(",  ", final), final);
    }

    async Task Send()
    {
        var text = _inputValue.Trim();
        if (string.IsNullOrEmpty(text) || _phase != "chat" || _step < 0 || _typing) return;

        _inputValue = string.Empty;
        if (_isMulti)
        {
            if (!_selected.Contains(text)) _selected.Add(text);
            StateHasChanged();
        }
        else
        {
            await Advance(text, text);
        }
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    async Task Activate()
    {
        _phase = "activated";
        _messages.Add(new("agent",
            "Thank you — I won't let you down. I'm switching on now and watching the channels.\n\nWhenever you want, send me a test message and see how I respond."));
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    async Task TestAgent()
    {
        if (_isTesting) return;
        _isTesting = true;
        _messages.Add(new("divider", "Quick test"));
        _messages.Add(new("user", "Hi, I'd like a refund for order #4821 — it arrived damaged."));
        _typing = true;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
        try { await Task.Delay(1300, _cts.Token); }
        catch (OperationCanceledException) { return; }

        _typing = false;
        _messages.Add(new("agent",
            "I'm so sorry your order arrived damaged — that's never the experience we want for you. I can absolutely start a refund for order #4821 right away.\n\nCould you confirm the email address on the order so I can pull it up?"));
        _isTesting = false;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    // The same scroll the inbox timeline uses, through AuroraInterop, in
    // place of the page-specific hook in app.js.
    async Task ScrollToBottom()
    {
        try { await Interop.ScrollToBottomAsync(_messagesElement); }
        catch (JSException) { /* the page is being torn down */ }
        catch (InvalidOperationException) { /* not rendered yet */ }
    }

    void Exit() => Nav.NavigateTo($"/dashboard/ai-agents/{AgentId}");

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
