@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

@* Name-and-describe before saving, in Aurora's Dialog. *@

<Dialog Open="Open"
        Title="Name your playbook"
        ConfirmLabel="Save playbook"
        ConfirmDisabled="@string.IsNullOrWhiteSpace(_name)"
        OnConfirm="Confirm"
        OnCancel="OnCancel">
    <GlyphContent><Icon Name="IconName.RiBookOpenFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>Give this playbook a name and description so you can easily identify what this automation does.</p>
        <div class="save-playbook__fields">
            <Input FloatingLabel="Playbook name"
                   HelperText="e.g. Order food, Book appointment"
                   @bind-Value="_name"
                   maxlength="80" />
            <label class="save-playbook__description">
                <Typography TextStyle="TextStyle.Small12Medium" As="span">Description <em>(Optional)</em></Typography>
                <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                          rows="4"
                          placeholder="Handles customer food orders by collecting item selection, quantity, delivery details, and sending an order confirmation."
                          value="@_desc"
                          @oninput="e => _desc = e.Value?.ToString() ?? string.Empty"></textarea>
            </label>
        </div>
    </Body>
</Dialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string InitialName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<PlaybookSaveArgs> OnSave { get; set; }

    private string? _name;
    private string _desc = string.Empty;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        // Seed the name each time the dialog opens, never while it is being typed in.
        if (Open && !_wasOpen)
        {
            _name = InitialName;
            _desc = string.Empty;
        }
        _wasOpen = Open;
    }

    private async Task Confirm() => await OnSave.InvokeAsync(new PlaybookSaveArgs(_name ?? string.Empty, _desc));
}
