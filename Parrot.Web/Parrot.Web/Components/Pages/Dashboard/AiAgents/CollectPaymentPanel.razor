@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<div class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Amount source</Typography>
    <div class="step-segments" role="radiogroup" aria-label="Amount source">
        <button type="button"
                role="radio"
                aria-checked="@((Step.AmountSource == "Fixed").ToString().ToLowerInvariant())"
                class="@(Step.AmountSource == "Fixed" ? "step-segment is-active" : "step-segment")"
                @onclick='() => Step.AmountSource = "Fixed"'>
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">Fixed amount</Typography>
        </button>
        <button type="button"
                role="radio"
                aria-checked="@((Step.AmountSource == "FromCollected").ToString().ToLowerInvariant())"
                class="@(Step.AmountSource == "FromCollected" ? "step-segment is-active" : "step-segment")"
                @onclick='() => Step.AmountSource = "FromCollected"'>
            <Typography TextStyle="TextStyle.Small12Semibold" As="span">From collected data</Typography>
        </button>
    </div>
</div>

@if (Step.AmountSource != "FromCollected")
{
    <Input FloatingLabel="Amount"
           PrefixText="₦"
           type="number"
           min="0"
           Value="@Step.PaymentAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
           ValueChanged="value => Step.PaymentAmount = decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0" />
}

<SelectField FloatingLabel="Payment provider"
             Value="@Step.PaymentProvider"
             Open="_providerOpen"
             OpenChanged="open => _providerOpen = open">
    @foreach (var provider in new[] { "Paystack", "Flutterwave", "Stripe" })
    {
        var current = provider;
        <PopoverOption Label="@current" Active="@(Step.PaymentProvider == current)"
                       OnSelect="async () => { Step.PaymentProvider = current; _providerOpen = false; await OnChanged.InvokeAsync(); }" />
    }
</SelectField>

<label class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Success message</Typography>
    <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
              rows="3"
              placeholder="Message shown after successful payment"
              value="@Step.SuccessMessage"
              @oninput="e => Step.SuccessMessage = e.Value?.ToString() ?? string.Empty"></textarea>
</label>

<label class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Failure message</Typography>
    <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
              rows="3"
              placeholder="Message shown after failed payment"
              value="@Step.FailureMessage"
              @oninput="e => Step.FailureMessage = e.Value?.ToString() ?? string.Empty"></textarea>
</label>

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _providerOpen;
}
