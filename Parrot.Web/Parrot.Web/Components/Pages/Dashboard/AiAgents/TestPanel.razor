@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

@* A sandbox conversation for the playbook, drawn like the builder's test
   sandbox: customer bubbles in brand on the right, bot bubbles on card. *@

<aside class="test-panel" aria-label="Test conversation" @onclick:stopPropagation="true">
    <header class="test-panel__head">
        <div class="test-panel__title">
            <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2">Test</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="span">Private simulation · nothing is sent</Typography>
        </div>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Close test panel" @onclick="() => OnClose.InvokeAsync()">
            <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
        </Button>
    </header>
    <div class="test-panel__messages">
        @foreach (var msg in _testMessages)
        {
            @if (msg.IsUser)
            {
                <div class="test-panel__row test-panel__row--user">
                    <div class="test-panel__bubble test-panel__bubble--user">
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@msg.Text</Typography>
                    </div>
                </div>
            }
            else
            {
                <div class="test-panel__row test-panel__row--bot">
                    <span class="test-panel__avatar"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" /></span>
                    <div class="test-panel__bubble test-panel__bubble--bot">
                        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@msg.Text</Typography>
                    </div>
                </div>
            }
        }
    </div>
    <div class="test-panel__composer">
        <input class="@TextStyle.BodySmallRegular.ToClassName()"
               placeholder="Type a message..."
               aria-label="Test message"
               value="@_testInput"
               @oninput="e => _testInput = e.Value?.ToString() ?? string.Empty"
               @onkeydown="OnKeyDown" />
        <Button Size="ButtonSize.Small" aria-label="Send test message" disabled="@string.IsNullOrWhiteSpace(_testInput)" @onclick="SendMessage">
            <IconLeft><Icon Name="IconName.RiSendPlaneFill" /></IconLeft>
        </Button>
    </div>
</aside>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _testInput = string.Empty;
    private readonly List<TestMessage> _testMessages = new()
    {
        new TestMessage { Text = "2 plates of Jollof Rice with chicken and a Pepsi", IsUser = true },
        new TestMessage { Text = "Got it! So that's:\n• Jollof Rice x2\n• Chicken x1\n• Pepsi x1\nWould you like anything else?", IsUser = false },
        new TestMessage { Text = "No, that's all. Make the jollof extra spicy please", IsUser = true },
        new TestMessage { Text = "Noted — extra spicy Jollof Rice. Your total comes to ₦7,000. Should I go ahead and place this order?", IsUser = false },
    };

    private record TestMessage { public string Text { get; init; } = string.Empty; public bool IsUser { get; init; } }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SendMessage();
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_testInput)) return;
        _testMessages.Add(new TestMessage { Text = _testInput, IsUser = true });
        _testInput = string.Empty;
    }
}
