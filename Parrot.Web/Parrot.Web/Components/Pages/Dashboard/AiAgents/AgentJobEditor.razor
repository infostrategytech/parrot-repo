@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@implements IAsyncDisposable
@using Parrot.SharedComponents.Services
@using Microsoft.AspNetCore.Components.Sections
@using Parrot.Web.Features.Dashboard.AiAgents
@inject IAgentBriefing Briefing
@inject IJobInterview Interview
@inject JobConversationDrafts Drafts
@inject Parrot.Web.Features.Dashboard.Knowledge.IKnowledgeMemory Memory
@inject VoiceInterop Voice
@inject AuroraInterop Interop

@* An agent's job description, the way you would brief a new assistant
   (Concept B, 13 October 2026), as one conversation (designer and team, 15
   October 2026): talking and typing both land in the same chat, the agent's
   words on the left (said aloud while they talk, each word lighting as it is
   said), the owner's on the right (filling in as they talk), and they can
   switch between talking and typing at any point (the box and the mic sit
   together; Type instead carries what was heard into the box). The start is
   the orb and the two ways in; once it starts, a small bar at the foot says
   whose turn it is, and the light along the card's edges stays.

   Before the first job description, the conversation goes through topics
   (IJobInterview's sections for the job, e.g. Refunds), shown as a quiet
   line of words at the top, never as a bar or a count, and marked in the
   chat by a divider. Their job, in their own words, is approved first (it
   is the job description's starting point), then each topic is a conversation first (designer, 16
   October 2026): the agent asks what it still needs, one question at a time,
   aloud or typed, and they answer either way; then what it gathered comes up
   to approve, docked where the box is (like Claude's questions), and nothing
   else can happen until it's approved. A topic already covered by something
   said earlier shows as done, and when it's reached the agent says so and
   brings its approval straight up. Nothing is decided for them: every topic
   is approved by the owner; "Skip this question" (a chip above the box, as
   in Teach your AI) leaves a question open for the approval. Answers go where they belong: sentences of the
   job description, its settings, the business's knowledge.

   Knowing they're done talking: Done, a pause (a short bar they can stop by
   talking), or "that's all". Typing: Enter, or Send. Not sure what to say: a
   ready-made job description for the job, then a check of what it assumed.

   Adding to one already written: the same chat, briefly; nothing goes in
   without a yes (what changes, and any rule it replaces; a question it leaves
   open is asked); its settings follow the job description, and Undo puts both
   back. Notes under the job description fade after a few seconds. *@

<div class="job-editor">
    @* Once its job description is written, that is what matters: talking to add more gets smaller,
       and on the agent's page (Fold) it waits behind "Add to it" in the job description's header. *@
    @if (!Folded)
    {
    <section class="@CardClass" aria-label="@($"Talk to {Name}")" @ref="_card">
        <VoiceAura @ref="_aura" State="AuraState" />
        @if (!InConversation)
        {
            @* The start: the orb in a stage of its own (room to swell), what to do, and the two ways in. *@
            <div class="job-editor__stage">
                <VoiceOrb @ref="_orb" State="OrbState" Round Class="job-editor__orb" />
            </div>
            <div class="job-editor__voice-text">
                <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="p" role="status">@StartTitle</Typography>
                @if (StartHint is { } hint)
                {
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="job-editor__muted">@hint</Typography>
                }
            </div>
            <div class="job-editor__ways">
                @if (_phase == Phase.Speaking)
                {
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" @onclick="SkipSpeechAsync">@(_reading ? "Stop" : "Skip")</Button>
                }
                else if (_phase != Phase.Thinking)
                {
                    <div class="job-editor__start">
                        <Button Size="ButtonSize.Large" disabled="@(!_canTalk)" @onclick="() => OpenAsync(voice: true)">
                            <IconLeft><Icon Name="IconName.RiMicFill" /></IconLeft>
                            <ChildContent>Talk to me</ChildContent>
                        </Button>
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" @onclick="() => OpenAsync(voice: false)">
                            <IconLeft><Icon Name="IconName.RiKeyboardFill" /></IconLeft>
                            <ChildContent>Type</ChildContent>
                        </Button>
                    </div>
                    @if (!HasSummary)
                    {
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="job-editor__suggest" @onclick="SuggestAsync">Not sure what to say? Start me with a ready-made job description</Button>
                    }
                }
            </div>
        }
        else
        {
            @if (Topics.Count > 0 && TopicsSection is { } topicsSection)
            {
                @* Where the page shows how far a task has got (a full-screen view's bar). *@
                <SectionContent SectionName="@topicsSection"><TopicTrail Items="Topics" Label="What we'll talk about" Bar /></SectionContent>
            }
            else if (Topics.Count > 0)
            {
                <div class="job-editor__topics">
                    <TopicTrail Items="Topics" Label="What we'll talk about" />
                </div>
            }
            <div class="job-editor__log" role="log" aria-label="@($"You and {Name}")" @ref="_thread">
                <ol class="job-editor__thread">
                    @foreach (var message in _messages)
                    {
                        @Bubble(message)
                    }
                    @if (_phase is Phase.Listening or Phase.Finishing && (_said.Length > 0 || _interim.Length > 0))
                    {
                        @* What they're saying, filling in as they talk; the unfinished part quieter. *@
                        <li class="job-editor__msg is-owner is-live">
                            <div class="job-editor__bubble">
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@_said<span class="job-editor__interim">@(_said.Length > 0 && _interim.Length > 0 ? " " : null)@_interim</span></Typography>
                            </div>
                        </li>
                    }
                    @if (_phase == Phase.Thinking)
                    {
                        <li class="job-editor__msg is-agent">
                            <img src="@AgentBuilderCopy.MascotImage(Mascot)" alt="" />
                            <div class="job-editor__bubble is-typing" aria-label="@($"{Name} is thinking")"><i></i><i></i><i></i></div>
                        </li>
                    }
                </ol>
            </div>
            @if (CanSkip || CanFinishUpdate)
            {
                @* Suggested replies, as in Teach your AI: chips above the box, under what it asked. *@
                <div class="job-editor__replies">
                    @if (CanSkip)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="SkipQuestionAsync">Skip this question</Button>
                    }
                    @if (CanFinishUpdate)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="FinishUpdateAsync">That's all</Button>
                    }
                </div>
            }
            <div class="job-editor__foot">
                @* One floating box for the conversation (as in Teach your AI): the box, or the voice bar; and
                   an approval grows out of it in their place, as Claude's questions take its input's place. *@
                <div class="@($"job-editor__dock{(Docked ? " is-asking" : null)}")" role="@(Docked ? "region" : null)" aria-label="@(Docked ? "Approve" : null)">
                    @if (Docked)
                    {
                        @Approval
                    }
                    else
                    {
                        @Foot
                    }
                </div>
            </div>
        }
        @if (_voiceNotice is not null)
        {
            <InlineError Tone="InlineErrorTone.Warning" Message="@_voiceNotice" OnDismiss="() => _voiceNotice = null" />
        }
    </section>
    }

    @* Its job description: only once they've finished, appearing as it is written, to read before going on. *@
    @if (HasSummary && !HidingSummary)
    {
        <section class="job-editor__brief" aria-labelledby="@($"{_id}-job")" aria-busy="@(_writing || _stream.Count > 0 ? "true" : "false")" tabindex="-1" @ref="_summarySection">
            <div class="job-editor__brief-head">
                <div class="job-editor__brief-title">
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h3" id="@($"{_id}-job")">My job description</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="job-editor__muted">What I do, what I never do, and when I call you. Read it through, and change anything that isn't right.</Typography>
                </div>
                @* Its actions together, on the right. *@
                <span class="job-editor__brief-actions">
                @if (Fold && !_writing && _stream.Count == 0)
                {
                    @* The talking card, for one addition: open, or put away again. *@
                    <Button Variant="@(Folded ? ButtonVariant.Primary : ButtonVariant.Secondary)" Size="ButtonSize.Small" aria-expanded="@(Folded ? "false" : "true")"
                            disabled="@(_phase != Phase.Idle || InConversation)" @onclick="ToggleFold">
                        <IconLeft><Icon Name="@(Folded ? IconName.RiAddFill : IconName.RiCloseFill)" /></IconLeft>
                        <ChildContent>@(Folded ? "Add to it" : "Close")</ChildContent>
                    </Button>
                }
                @if (_canSpeak && !_writing && _stream.Count == 0)
                {
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" aria-pressed="@(_reading ? "true" : "false")" disabled="@(Brief.IsEmpty || InConversation || (_phase != Phase.Idle && !_reading))" @onclick="HearAsync">
                        <IconLeft><Icon Name="@(_reading ? IconName.RiStopFill : IconName.RiPlayFill)" /></IconLeft>
                        <ChildContent>@(_reading ? "Stop" : "Hear it")</ChildContent>
                    </Button>
                }
                </span>
            </div>
            @if (_writing)
            {
                <div class="job-editor__writing">
                    <Skeleton Width="100%" Order="0" />
                    <Skeleton Width="94%" Order="1" />
                    <Skeleton Width="88%" Order="2" />
                    <Skeleton Width="56%" Order="3" />
                </div>
            }
            else if (_stream.Count > 0)
            {
                <div class="job-editor__streaming">
                    <Typography TextStyle="TextStyle.BodyDefaultMedium" As="p" Prose>
                        @foreach (var sentence in _stream)
                        {
                            <span>@(sentence + " ")</span>
                        }
                    </Typography>
                </div>
            }
            else
            {
                <TextArea @ref="_summary" Value="@Brief.Summary" ValueChanged="SetSummaryAsync" AriaLabel="@($"{Name}'s job description")"
                          TextStyle="TextStyle.BodyDefaultMedium" Rows="5" AutoGrow MaxLength="2000"
                          Class="@(_fresh ? "is-new" : null)" />
            }
            @if (_readyQuestions.Count > 0 && _stream.Count == 0 && !_writing)
            {
                @* A ready-made one: what it assumed, to check. *@
                <QuestionForm Title="Just to be sure" Subtitle="I started from a typical job description. Here's what I assumed; change anything that isn't right."
                              Questions="_readyQuestions" Answers="_readyAnswers" Review SubmitLabel="@(_readyChanged ? "Update my job description" : "Looks right")"
                              Busy="_formBusy" OnChange="ReadyChanged" OnSubmit="ReadyCheckedAsync" Class="job-editor__ready" />
            }
            @if (_noted is { } noted && _stream.Count == 0 && !_writing)
            {
                @* Read, then gone: it fades after a few seconds, and waits while the pointer is on it. *@
                <div class="@($"job-editor__noted{(NotedFade.Leaving ? " is-leaving" : null)}")" role="status"
                     @onmouseenter="NotedFade.Hold" @onmouseleave="() => NotedFade.Start(NotedAgainSeconds, () => _noted = null)">
                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>@noted</Typography>
                </div>
            }
            @* Just updated, with Undo for a moment; it fades too, and waits while the pointer or the keyboard is on it. *@
            @if (_added.Count > 0)
            {
                <div class="@($"job-editor__added{(AddedFade.Leaving ? " is-leaving" : null)}")" role="status"
                     @onmouseenter="AddedFade.Hold" @onfocusin="AddedFade.Hold"
                     @onmouseleave="() => AddedFade.Start(NotedAgainSeconds, ClearAdded)" @onfocusout="() => AddedFade.Start(NotedAgainSeconds, ClearAdded)">
                    <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>Updated my job description.</Typography>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="UndoAsync">Undo</Button>
                </div>
            }
        </section>
    }
</div>

@code {
    /// <summary>The job description, changed in place. Empty until the owner has told it its job.</summary>
    [Parameter, EditorRequired] public AgentBrief Brief { get; set; } = new();

    /// <summary>The agent's name, as the owner talks to it ("Talk to Ada").</summary>
    [Parameter] public string Name { get; set; } = "your agent";

    /// <summary>Its look, beside its messages in the conversation.</summary>
    [Parameter] public string Mascot { get; set; } = "Nova";

    // What its job description is written from, with what the owner says.
    [Parameter] public string? UseCase { get; set; }
    [Parameter] public string? CustomJob { get; set; }
    [Parameter] public string? Industry { get; set; }
    [Parameter] public string Business { get; set; } = string.Empty;

    [Parameter] public EventCallback OnChange { get; set; }

    /// <summary>The agent's settings, for what its follow-ups decide (when to bring the owner in, discounts, tone). Optional.</summary>
    [Parameter] public AgentSettings? Settings { get; set; }

    /// <summary>What the follow-ups decided, for a host that sets its settings later (creating an agent resets them to the job's defaults first).</summary>
    [Parameter] public EventCallback<Action<AgentSettings>> OnSettings { get; set; }

    /// <summary>
    /// The agent's page: once there is a job description, the talking card
    /// folds away behind "Add to it" in its header, and folds again once
    /// something is added (designer, 14 October 2026). Creating an agent
    /// keeps the card open.
    /// </summary>
    [Parameter] public bool Fold { get; set; }

    /// <summary>
    /// The agent being told its job, once it exists (its page): each approved topic is kept
    /// for it, so leaving and coming back picks up at the next topic.
    /// </summary>
    [Parameter] public string? DraftKey { get; set; }

    /// <summary>
    /// Its first job description is written and approved: the agent's page keeps it at once.
    /// With it, what it noted that the job description doesn't show (how it will sound, what it saved).
    /// </summary>
    [Parameter] public EventCallback<string?> OnWritten { get; set; }

    /// <summary>The page's own place for the topics (a SectionOutlet, as a full-screen view's bar); null keeps them in the chat.</summary>
    [Parameter] public string? TopicsSection { get; set; }

    /// <summary>
    /// No job description written out here: the page shows its own (a full-screen view, ending on its own
    /// moment or going back to the job's summary). It still shows while a ready-made one waits for its "Just to be sure".
    /// </summary>
    [Parameter] public bool HideSummary { get; set; }

    /// <summary>A change approved (added, or said another way): what it was before, for the page's Undo, and what changed.</summary>
    [Parameter] public EventCallback<JobUpdate> OnUpdated { get; set; }

    public sealed record JobUpdate(AgentBrief Before, AgentBriefRules? RulesBefore, IReadOnlyList<string> Added, IReadOnlyList<string> Replaced);

    private bool HidingSummary => HideSummary && !_readyMade && _readyQuestions.Count == 0;

    private bool _unfolded;

    // Folded only while nothing is happening: a conversation, or a voice note, keeps it open.
    private bool Folded => Fold && HasSummary && !_unfolded && _phase == Phase.Idle && !InConversation && _recording is null && !_recordingStarting;

    private void ToggleFold() => _unfolded = !_unfolded;

    // Idle: the start, or the conversation waiting for the owner (the box at the foot).
    // Asking: a topic's check waits. Checking: what an addition changes waits.
    private enum Phase { Idle, Speaking, Listening, Finishing, Thinking, Note, Asking, Checking }

    // After a pause, how long before their turn is sent (a bar they see, and can stop by talking).
    private const int PauseSeconds = 3;

    // How fast a written job description appears, sentence by sentence.
    private const int StreamMs = 260;

    // It asks at most this many questions in a topic; anything left waits in its approval.
    private const int MostAskedInTopic = 3;

    // A ready-made one's check never holds more than this many questions.
    private const int MostOnForm = 4;

    // How long the notes under the job description stay, and again after the pointer leaves them.
    private const int NotedSeconds = 8;
    private const int NotedAgainSeconds = 4;

    // ── The conversation ───────────────────────────────────────────────────

    private enum Who { Agent, Owner, Topic }

    // One message: the agent's words (or a topic's check, or what an addition changes), the owner's, or a topic's divider.
    private sealed class Message
    {
        public required Who Who { get; init; }
        public string Text { get; init; } = string.Empty;
        public TopicCheck? Check { get; init; }
        public bool Change { get; init; }
    }

    // A topic's check: its questions, what is known to show picked, and, once confirmed, what was given.
    private sealed class TopicCheck
    {
        public required JobSection Section { get; init; }
        public required IReadOnlyList<FormQuestion> Questions { get; init; }
        public required string Title { get; init; }
        public string? Subtitle { get; init; }
        public IReadOnlyDictionary<string, FormAnswer>? Answers { get; set; }
        public IReadOnlyDictionary<string, FormAnswer>? Draft { get; set; }
        public bool Done { get; set; }
        public int Version { get; set; }
    }

    private readonly List<Message> _messages = [];
    private Message? _speaking;
    private bool _voice;

    private bool InConversation => _messages.Count > 0;

    // A question waiting for its answer (typed or said): it can be skipped, and is left open in the approval.
    private bool CanSkip => ((Interviewing && _voiceAsk is not null) || (HasSummary && _changeAsk is not null)) && _phase is Phase.Idle or Phase.Listening or Phase.Finishing;

    // Updating it, with something to change and nothing asked: the approval, when they've said it all.
    private bool CanFinishUpdate => HasSummary && _change is null && _changeAsk is null && (_pendingAdded.Count > 0 || _pendingReplaced.Count > 0)
        && _phase is Phase.Idle or Phase.Listening or Phase.Finishing;

    // An approval waiting where the box is: it takes the foot until it's approved.
    private bool Docked => (_phase == Phase.Checking && _change is not null) || (_phase == Phase.Asking && CurrentCheck is not null);

    // ── Getting to know the job (before its first job description) ──────────

    // Only for the first job description, and only with something to ask with.
    private bool Interviewing => Interview.Available && !HasSummary;

    // Their own words about the job (the job description is written from them), and what they said
    // later, during a topic: read for answers, not copied into the job description.
    private string _told = string.Empty, _later = string.Empty;
    private readonly Dictionary<string, FormAnswer> _answers = [];
    private readonly HashSet<string> _asked = [];
    private readonly HashSet<string> _confirmed = [];
    private JobReading? _job;
    private JobAsk? _voiceAsk;
    private IReadOnlyList<JobSection> _sections = [];
    // 0: their job, in their words; then each of the job's topics in turn.
    private int _topicAt, _askedHere;
    private bool _stopAsking, _closingHeard, _formBusy;
    private string? _noted;

    // A conversation left halfway: what it had reached, kept at each approval (JobConversationDrafts).
    private sealed record Kept(List<Message> Messages, string Told, string Later, Dictionary<string, FormAnswer> Answers,
        HashSet<string> Asked, HashSet<string> Confirmed, JobReading? Job, IReadOnlyList<JobSection> Sections, int TopicAt);
    private Kept? _resume;

    // The topic it will pick up at.
    private string? ResumeAt => _resume is { } kept ? kept.Sections.Skip(kept.TopicAt).Select(section => section.Title).FirstOrDefault() : null;

    // Each approval kept as it happens (designer, 19 October 2026): leave now, and it picks up at the next topic.
    private void KeepProgress()
    {
        if (DraftKey is null) return;
        var next = Math.Min(_topicAt, _sections.Count);
        var topics = new List<TopicTrailItem> { new("Your job", TopicState.Done) };
        topics.AddRange(_sections.Select((section, index) => new TopicTrailItem(section.Title,
            _confirmed.Contains(section.Id) ? TopicState.Done : index == next ? TopicState.Current : TopicState.Upcoming)));
        Drafts.Keep(DraftKey, new Kept([.. _messages], _told, _later, new(_answers), [.. _asked], [.. _confirmed], _job, _sections, _topicAt),
            new JobConversationDrafts.Progress(topics, _sections.Skip(next).Select(section => section.Title).FirstOrDefault()));
    }

    // Coming back: the conversation as it was, then the next topic.
    private async Task ResumeAsync(Kept kept)
    {
        _resume = null;
        _messages.Clear();
        _messages.AddRange(kept.Messages);
        _told = kept.Told;
        _later = kept.Later;
        _answers.Clear();
        foreach (var (id, answer) in kept.Answers) _answers[id] = answer;
        _asked.Clear();
        _asked.UnionWith(kept.Asked);
        _confirmed.Clear();
        _confirmed.UnionWith(kept.Confirmed);
        _job = kept.Job;
        _sections = kept.Sections;
        _topicAt = kept.TopicAt;
        var next = _sections.Skip(_topicAt).Select(section => section.Title).FirstOrDefault();
        _messages.Add(new Message { Who = Who.Agent, Text = next is null ? "Welcome back." : $"Welcome back. Let's carry on with {LowerFirst(next)}." });
        _speaking = null;
        await NextTopicAsync();
    }

    private JobSection? CurrentSection => _topicAt >= 1 && _topicAt <= _sections.Count ? _sections[_topicAt - 1] : null;

    private IReadOnlyList<TopicTrailItem> Topics =>
        !Interviewing || _sections.Count == 0 ? [] :
        [
            new TopicTrailItem("Your job", _topicAt == 0 ? TopicState.Current : TopicState.Done),
            .. _sections.Select((section, index) => new TopicTrailItem(section.Title,
                _confirmed.Contains(section.Id) ? TopicState.Done
                : index + 1 == _topicAt ? TopicState.Current
                : Complete(section) ? TopicState.Done
                : TopicState.Upcoming)),
        ];

    // ── Adding to it: read, shown, then added on a yes ─────────────────────
    private AgentBriefUpdate? _change;
    private JobAsk? _changeAsk;
    private bool _changeTalked;
    // What the last addition replaced, and the settings before it (Undo).
    private IReadOnlyList<string> _replaced = [];
    private AgentBriefRules? _rulesBefore;

    // The question being asked aloud, an interview's or an addition's.
    private JobAsk? CurrentAsk => _voiceAsk ?? (_change is not null ? _changeAsk : null);

    private Phase _phase;
    private string _said = string.Empty, _interim = string.Empty, _typed = string.Empty;
    private string? _agentLine, _voiceNotice, _select;
    private int _countdown, _pauseRun;
    private bool _reading, _canTalk, _canRecord, _canSpeak, _shown, _fresh, _writing, _speakPending, _scrollToSummary, _scrollToCard, _focusType;
    private readonly List<string> _stream = [];
    private Func<Task>? _afterSpeech;
    private CancellationTokenSource? _pause;
    private string _threadShown = string.Empty;

    // The last thing added, and the job description before it (Undo).
    private IReadOnlyList<string> _added = [];
    private AgentBrief? _before;

    private readonly string _id = "job-editor-" + Guid.NewGuid().ToString("N")[..8];
    private TextArea? _summary, _typeBox;
    private ElementReference _summarySection, _caption, _thread, _card;

    private VoiceOrb? _orb;
    private VoiceAura? _aura;
    private DotNetObjectReference<AgentJobEditor>? _self;
    private IAsyncDisposable? _listen, _mic;
    private VoiceSpeech? _speech;
    private VoiceNoteRecording? _recorder;
    private VoiceRecording? _recording;
    private bool _recordingStarting;
    private int _recordSeconds;
    private CancellationTokenSource? _recordClock;

    // After a ready-made job description: what it assumed, to check, and whether anything was changed.
    private IReadOnlyList<FormQuestion> _readyQuestions = [];
    private IReadOnlyDictionary<string, FormAnswer>? _readyAnswers;
    private bool _readyChanged, _readyMade;

    private Fading? _notedFade, _addedFade;
    private Fading NotedFade => _notedFade ??= new(() => InvokeAsync(StateHasChanged));
    private Fading AddedFade => _addedFade ??= new(() => InvokeAsync(StateHasChanged));

    // It stays once it has been shown, even while its text is cleared to rewrite it.
    private bool HasSummary => _shown || !Brief.IsEmpty;

    private string CardClass =>
        $"job-editor__voice is-{_phase.ToString().ToLowerInvariant()}"
        + (InConversation ? (Topics.Count > 0 ? " is-talking" : " is-talking is-short") : HasSummary ? " is-compact" : null)
        + (Docked ? " is-docked" : null);

    private IReadOnlyList<ElementReference> LevelTargets =>
        _orb is null ? [] : _aura is null ? [_orb.Element] : [_orb.Element, _aura.Element];

    private VoiceState OrbState => _phase switch
    {
        Phase.Speaking => VoiceState.Speaking,
        Phase.Listening or Phase.Finishing => VoiceState.Listening,
        Phase.Thinking => VoiceState.Thinking,
        _ => VoiceState.Idle,
    };

    // The light along the card's edges: only while a voice turn is happening.
    private VoiceState? AuraState => _phase is Phase.Speaking or Phase.Listening or Phase.Finishing || (_phase == Phase.Thinking && _voice) ? OrbState : null;

    private string StartTitle => _phase switch
    {
        Phase.Speaking when _reading => "Reading my job description",
        Phase.Speaking => "I'm talking",
        Phase.Thinking => "Writing my job description…",
        _ when !_canTalk => "Type, or record a voice note",
        _ when HasSummary => "What's changed?",
        _ when ResumeAt is not null => "Shall we carry on?",
        _ => "Talk to me like a new team member",
    };

    private string? StartHint => _phase switch
    {
        Phase.Speaking or Phase.Thinking => null,
        _ when !_canTalk => "Talking works in Chrome or Edge.",
        _ when HasSummary => "Tell me what to add or do differently. You'll see the change before it goes in.",
        _ when ResumeAt is { } next => $"We'd got to {LowerFirst(next)}. Talk or type, and I'll pick up from there.",
        _ => "Tell me what to do, what never to do, and when to call you.",
    };

    // The bar at the foot, while a voice turn is happening.
    private string BarTitle => _phase switch
    {
        Phase.Speaking => "I'm talking",
        Phase.Listening when _listen is null => "One moment…",
        Phase.Listening => "I'm listening",
        Phase.Finishing => "Got it. Anything else?",
        _ => _writing || _stream.Count > 0 ? "Writing my job description…" : "Thinking…",
    };

    private string? BarHint => _phase switch
    {
        Phase.Listening => "Tap Done, or just pause, when you've finished.",
        Phase.Finishing => "Keep talking if there's more, or say “that's all”.",
        _ => null,
    };

    private string ComposerHint =>
        _voiceAsk is not null || _changeAsk is not null ? "Type your answer…"
        : !Interviewing && HasSummary ? "What's changed?"
        : _topicAt == 0 ? "For example: Answer questions about our prices and delivery. Never give discounts."
        : "Type a message…";

    // Each word, with where it starts in the sentence: the voice shows it on reaching it.
    private static IEnumerable<(string Word, int At)> Spoken(string line)
    {
        var at = 0;
        foreach (var word in line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            var start = line.IndexOf(word, at, StringComparison.Ordinal);
            yield return (word, start);
            at = start + word.Length;
        }
    }

    // ── What the conversation shows ────────────────────────────────────────

    private RenderFragment Bubble(Message message) => __builder =>
    {
        switch (message.Who)
        {
            case Who.Topic:
                @* A new topic, the way a chat marks a new day. *@
                <li class="job-editor__divider">
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">@message.Text</Typography>
                </li>
                break;
            case Who.Owner:
                <li class="job-editor__msg is-owner">
                    <div class="job-editor__bubble">
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@message.Text</Typography>
                    </div>
                </li>
                break;
            default:
                if (message.Text.Length == 0 && message.Check is not { Done: true }) break;
                <li class="job-editor__msg is-agent">
                    <img src="@AgentBuilderCopy.MascotImage(Mascot)" alt="" />
                    <div class="job-editor__reply">
                        @if (message.Text.Length > 0 && message == _speaking && _phase == Phase.Speaking)
                        {
                            @* Said aloud now: each word lights as it is said. *@
                            <div class="job-editor__bubble is-speaking" @ref="_caption">
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
                                    @foreach (var (word, at) in Spoken(message.Text))
                                    {
                                        <span data-at="@at">@(word + " ")</span>
                                    }
                                </Typography>
                            </div>
                        }
                        else if (message.Text.Length > 0)
                        {
                            <div class="job-editor__bubble">
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@message.Text</Typography>
                            </div>
                        }
                        @if (message.Check is { Done: true } check)
                        {
                            @Approved(check)
                        }
                    </div>
                </li>
                break;
        }
    };

    // A topic approved: what was given, to read.
    private RenderFragment Approved(TopicCheck check) => __builder =>
    {
        <div class="job-editor__checked">
            <Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" />
            <div class="job-editor__checked-text">
                <Typography TextStyle="TextStyle.Small12Semibold" As="p">@check.Section.Title</Typography>
                @foreach (var question in check.Questions)
                {
                    if ((check.Draft ?? check.Answers)?.GetValueOrDefault(question.Id) is { IsEmpty: false } given)
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>@question.Question <span class="job-editor__checked-answer">@Said(given)</span></Typography>
                    }
                }
            </div>
        </div>
    };

    // The foot: the box and the mic together; while a voice turn happens, the bar saying whose turn it is.
    private RenderFragment Foot => __builder =>
    {
        if (_phase is Phase.Speaking or Phase.Listening or Phase.Finishing or Phase.Thinking)
        {
            <div class="job-editor__bar">
                <VoiceOrb @ref="_orb" State="OrbState" Round Class="job-editor__bar-orb" />
                <div class="job-editor__bar-text">
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="p" role="status">@BarTitle</Typography>
                    @if (BarHint is { } hint)
                    {
                        <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose Class="job-editor__muted">@hint</Typography>
                    }
                    @if (_phase == Phase.Finishing)
                    {
                        @* The pause running out, as a bar rather than spoken numbers. *@
                        <span class="job-editor__countdown" aria-hidden="true" @key="_pauseRun"><span></span></span>
                    }
                </div>
                <div class="job-editor__bar-actions">
                    @switch (_phase)
                    {
                        case Phase.Speaking:
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="SkipSpeechAsync">Skip</Button>
                            break;
                        case Phase.Listening:
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="TypeInsteadAsync">
                                <IconLeft><Icon Name="IconName.RiKeyboardFill" /></IconLeft>
                                <ChildContent>Type instead</ChildContent>
                            </Button>
                            <Button Size="ButtonSize.Small" @onclick="DoneAsync">
                                <IconLeft><Icon Name="IconName.RiStopFill" /></IconLeft>
                                <ChildContent>Done</ChildContent>
                            </Button>
                            break;
                        case Phase.Finishing:
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" @onclick="KeepTalking">
                                <IconLeft><Icon Name="IconName.RiMicFill" /></IconLeft>
                                <ChildContent>Keep talking</ChildContent>
                            </Button>
                            <Button Size="ButtonSize.Small" @onclick="DoneAsync">Send now</Button>
                            break;
                    }
                </div>
            </div>
        }
        else if (_phase == Phase.Note || _recordingStarting || _recording is not null)
        {
            <VoiceNoteRecording @ref="_recorder" Seconds="_recordSeconds" Recording="_recording"
                                OnDelete="CancelNoteAsync" OnSend="SendNoteAsync" Class="job-editor__recording" />
        }
        else
        {
            @* The box as in Teach your AI and the Inbox: the answer gets the room; under it, Talk for
               a turn aloud, and (as in WhatsApp) the mic for a voice note while there's nothing to send. *@
            <div class="job-editor__composer">
                <TextArea @ref="_typeBox" Value="@_typed" ValueChanged="value => _typed = value ?? string.Empty" AriaLabel="@($"Message {Name}")"
                          Class="job-editor__answer" Placeholder="@ComposerHint" Variant="TextAreaVariant.Plain" TextStyle="TextStyle.BodyDefaultMedium"
                          Rows="2" AutoGrow SubmitOnEnter OnKeyDown="TypeKeyAsync" MaxLength="2000" />
                <footer class="job-editor__composer-foot">
                    <div class="job-editor__composer-tools">
                        @if (!Interviewing)
                        {
                            @* Adding to it: a way out without adding anything. *@
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="LeaveConversation">Cancel</Button>
                        }
                    </div>
                    @if (_canTalk)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" title="Talk instead: the conversation carries on" @onclick="TalkTurnAsync">
                            <IconLeft><Icon Name="IconName.RiVoiceprintFill" /></IconLeft>
                            <ChildContent>Talk</ChildContent>
                        </Button>
                    }
                    @if (_typed.Trim().Length > 0 || !_canRecord)
                    {
                        <Button Size="ButtonSize.Small" aria-label="Send" title="Send" disabled="@(_typed.Trim().Length == 0)" @onclick="SendTypedAsync">
                            <IconLeft><Icon Name="IconName.RiSendPlaneFill" /></IconLeft>
                        </Button>
                    }
                    else
                    {
                        <Button Size="ButtonSize.Small" aria-label="Record a voice note" title="Record a voice note" @onclick="StartNote">
                            <IconLeft><Icon Name="IconName.RiMicFill" /></IconLeft>
                        </Button>
                    }
                </footer>
            </div>
        }
    };

    // An approval, as a popover rising from the box: what an addition changes, or what a topic gathered.
    private RenderFragment Approval => __builder =>
    {
        if (_phase == Phase.Checking && _change is { } change)
        {
            <QuestionForm Title="@ChangeTitle(change)" Subtitle="Have a look before it goes into my job description."
                          Questions="ChangeQuestions" Review Lead="@ChangeLead(change)" Secondary="@ChangeActions"
                          SubmitLabel="@(change.Replaced is { Count: > 0 } ? "Update my job" : "Add it")" Busy="_formBusy" OnSubmit="AddChangeAsync" Class="job-editor__approve" />
        }
        else if (_phase == Phase.Asking && CurrentCheck is { } check)
        {
            <QuestionForm @key="check.Version" Title="@check.Title" Subtitle="@check.Subtitle" Questions="check.Questions" Answers="check.Answers" Review
                          SubmitLabel="@ApproveLabel" Busy="_formBusy" OnChange="answers => CheckChanged(check, answers)"
                          OnSubmit="answers => TopicCheckedAsync(check, answers)" Class="job-editor__approve" />
        }
    };

    // An answer, read back: its choices, then their own words.
    private static string Said(FormAnswer answer)
    {
        var parts = answer.Picked.ToList();
        if (!string.IsNullOrWhiteSpace(answer.Text)) parts.Add(answer.Text.Trim());
        return string.Join(", ", parts);
    }

    protected override async Task OnInitializedAsync()
    {
        _shown = !Brief.IsEmpty;
        if (Interviewing && DraftKey is not null && Drafts.TryGet(DraftKey, out var kept) && kept is Kept resume) _resume = resume;
        try
        {
            var can = await Voice.CapabilitiesAsync();
            _canTalk = can.Listen;
            _canRecord = can.Record;
            _canSpeak = can.Speak;
        }
        catch (JSException) { }
        // The topics, ready before the first word: the conversation shows where it's going.
        if (Interviewing && _resume is { } picking)
        {
            _job = picking.Job;
            _sections = picking.Sections;
        }
        else if (Interviewing)
        {
            try
            {
                _job = await Interview.ReadAsync(Request(string.Empty));
                _sections = _job.Sections ?? [];
            }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The words are on the page: now it can say them, revealing each in step.
        if (_speakPending && _agentLine is { } line)
        {
            _speakPending = false;
            _self ??= DotNetObjectReference.Create(this);
            var caption = !_reading && _speaking is not null ? (ElementReference?)_caption : null;
            try { _speech = await Voice.SpeakAsync(LevelTargets, line, _self, nameof(SpokenAsync), caption); }
            catch (JSException) { await SpokenAsync(); }
        }
        if (_recordingStarting && _recording is null && _recorder is not null)
        {
            try
            {
                _recording = await Voice.RecordNoteAsync(_recorder.Element);
                StartClock();
            }
            catch (JSException) { Blocked(); }
            finally
            {
                _recordingStarting = false;
                StateHasChanged();
            }
        }
        if (_scrollToCard) { _scrollToCard = false; try { await Interop.ScrollIntoViewAsync(_card); } catch (JSException) { } }
        // The newest message in view, as it arrives and as their words fill in.
        if (InConversation)
        {
            var shown = $"{_messages.Count}|{_phase}|{_said.Length}|{_interim.Length}";
            if (shown != _threadShown)
            {
                _threadShown = shown;
                try { await Interop.ScrollToBottomAsync(_thread); } catch (JSException) { }
            }
        }
        if (_scrollToSummary) { _scrollToSummary = false; if (!HidingSummary) try { await Interop.ScrollIntoViewAsync(_summarySection); } catch (JSException) { } }
        // Focus is a nicety: an element just replaced (the box giving way to an approval) must never take the page down.
        if (_select is { } sentence && _summary is not null)
        {
            _select = null;
            try { if (!await _summary.SelectAsync(sentence)) await _summary.FocusAsync(); }
            catch (JSException) { }
        }
        if (_focusType && _typeBox is not null)
        {
            _focusType = false;
            if (!Docked && _phase is Phase.Idle)
            {
                try { await _typeBox.FocusAsync(); }
                catch (JSException) { }
            }
        }
    }

    /// <summary>Selects a sentence of the job description, to change it ("Change this", from a test chat).</summary>
    public void Focus(string sentence)
    {
        _select = sentence;
        StateHasChanged();
    }

    private async Task SetSummaryAsync(string? value)
    {
        Brief.Summary = value ?? string.Empty;
        ClearAdded();
        _fresh = false;
        await OnChange.InvokeAsync();
    }

    // ── The agent speaking ─────────────────────────────────────────────────

    private void Say(string line, Func<Task>? then, bool reading = false)
    {
        _agentLine = line;
        _reading = reading;
        _afterSpeech = then;
        _phase = Phase.Speaking;
        _speakPending = true;
    }

    // The agent's turn in the conversation: shown, and said aloud while they're talking.
    private async Task AgentSaysAsync(string line, Func<Task>? then)
    {
        var message = new Message { Who = Who.Agent, Text = line };
        _messages.Add(message);
        if (_voice && _canSpeak)
        {
            _speaking = message;
            Say(line, then);
            return;
        }
        _speaking = null;
        if (then is not null && _voice) await then();
        else _phase = Phase.Idle;
    }

    [JSInvokable]
    public async Task SpokenAsync()
    {
        if (_speech is not null) { await _speech.DisposeAsync(); _speech = null; }
        if (_phase != Phase.Speaking) return;
        _reading = false;
        _speaking = null;
        var then = _afterSpeech;
        _afterSpeech = null;
        // What comes next (listening) changes the phase itself, once it has started.
        if (then is null) _phase = Phase.Idle;
        else await then();
        await InvokeAsync(StateHasChanged);
    }

    // Skip the agent's words (its question) and go straight on; Stop ends a reading.
    private async Task SkipSpeechAsync()
    {
        if (_speech is not null) { await _speech.DisposeAsync(); _speech = null; }
        await SpokenAsync();
    }

    private async Task StopSpeakingAsync()
    {
        _afterSpeech = null;
        _speaking = null;
        if (_speech is not null) { await _speech.DisposeAsync(); _speech = null; }
        if (_phase == Phase.Speaking) _phase = Phase.Idle;
        _reading = false;
    }

    private async Task HearAsync()
    {
        if (_reading) { await StopSpeakingAsync(); return; }
        if (Brief.IsEmpty) return;
        _speaking = null;
        Say(Brief.Summary, null, reading: true);
    }

    // ── Starting, and switching between talking and typing ─────────────────

    // Talk or Type: the conversation opens with the agent's question (said aloud when talking).
    private async Task OpenAsync(bool voice)
    {
        await StopSpeakingAsync();
        _voiceNotice = null;
        if (voice && !await MicAllowedAsync()) return;
        _voice = voice;
        _said = string.Empty;
        _interim = string.Empty;
        _scrollToCard = true;
        if (Interviewing && _resume is { } kept)
        {
            await ResumeAsync(kept);
            if (!voice) _focusType = true;
            return;
        }
        _messages.Clear();
        if (Interviewing)
        {
            _topicAt = 0;
            _confirmed.Clear();
            if (_sections.Count > 0) _messages.Add(new Message { Who = Who.Topic, Text = "Your job" });
        }
        var opening = HasSummary ? "What's changed? Tell me what to add, or what I should do differently." : $"Hi, I'm {Name}. Tell me about my job: what should I do, what should I never do, and when should I bring you in?";
        await AgentSaysAsync(opening, ListenTurnAsync);
        if (!voice) _focusType = true;
    }

    // The microphone is asked for first, so a refusal is known before anyone waits for the agent.
    private async Task<bool> MicAllowedAsync()
    {
        var permission = "granted";
        try { permission = await Voice.RequestMicAsync(); }
        catch (JSException) { }
        if (permission == "granted") return true;
        _voiceNotice = permission switch
        {
            "none" => "We couldn't find a microphone. You can type instead.",
            "busy" => "Another app is using your microphone. Close it, or type instead.",
            "system" => "Your computer is blocking the browser from the microphone. You can allow it in your system settings, or type instead.",
            _ => "Your microphone is blocked. You can allow it from the icon at the left of the address bar, or type instead.",
        };
        return false;
    }

    // The mic beside the box: their turn aloud from here on; what was typed so far carries over.
    private async Task TalkTurnAsync()
    {
        _voiceNotice = null;
        if (!await MicAllowedAsync()) return;
        _voice = true;
        _said = _typed.Trim().Length > 0 ? Sentence(_typed) : string.Empty;
        _typed = string.Empty;
        _interim = string.Empty;
        await ListenTurnAsync();
    }

    // From talking to typing: what was heard so far goes into the box, and the conversation carries on typed.
    private async Task TypeInsteadAsync()
    {
        _pause?.Cancel();
        await StopListeningAsync();
        var heard = _interim.Trim().Length > 0 ? $"{_said} {Sentence(_interim)}".Trim() : _said.Trim();
        _said = string.Empty;
        _interim = string.Empty;
        _voice = false;
        // Asked about an addition: the same question, to tap or type, in the card.
        if (_change is not null)
        {
            _changeTalked = false;
            ShowChange();
            return;
        }
        _typed = heard;
        _phase = CurrentCheck is not null ? Phase.Asking : Phase.Idle;
        _focusType = true;
    }

    // Enter sends; Shift + Enter starts a new line.
    private async Task TypeKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey) await SendTypedAsync();
    }

    private async Task SendTypedAsync()
    {
        var text = _typed.Trim();
        if (text.Length == 0 || _phase is Phase.Thinking or Phase.Speaking) return;
        _typed = string.Empty;
        _voice = false;
        await OwnerSaidAsync(text);
    }

    // ── Talking ────────────────────────────────────────────────────────────

    // Its turn over, theirs: the bar (and its orb) is shown first, so the orb can follow their voice.
    private async Task ListenTurnAsync()
    {
        _phase = Phase.Listening;
        await InvokeAsync(StateHasChanged);
        try { _mic = await Voice.MicLevelAsync(LevelTargets); }
        catch (JSException) { Blocked(); await InvokeAsync(StateHasChanged); return; }
        await ListenAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ListenAsync()
    {
        _self ??= DotNetObjectReference.Create(this);
        if (_listen is not null) await _listen.DisposeAsync();
        try { _listen = await Voice.ListenAsync(_self, nameof(Heard), nameof(HeardAllAsync), nameof(NotHeardAsync)); }
        catch (JSException) { await StopListeningAsync(); _phase = Phase.Idle; _voiceNotice = "We couldn't start listening. You can type instead."; }
    }

    [JSInvokable]
    public Task Heard(string text)
    {
        if (_phase is not (Phase.Listening or Phase.Finishing)) return Task.CompletedTask;
        _interim = text;
        // Talking again: no countdown.
        if (_phase == Phase.Finishing && text.Trim().Length > 0) { _pause?.Cancel(); _phase = Phase.Listening; }
        return InvokeAsync(StateHasChanged);
    }

    // A sentence said. "That's all" ends it now; otherwise a pause starts the
    // countdown, and it keeps listening in case there is more.
    [JSInvokable]
    public async Task HeardAllAsync(string text)
    {
        if (_phase is not (Phase.Listening or Phase.Finishing)) return;
        _interim = string.Empty;
        var words = text.Trim();
        var closing = Closing.Match(words);
        if (closing.Success) words = words[..closing.Index].Trim().TrimEnd(',', '.');
        if (words.Length > 0) _said = _said.Length == 0 ? Sentence(words) : $"{_said} {Sentence(words)}";
        if (closing.Success) { _closingHeard = true; await FinishAsync(); return; }
        if (_said.Length > 0) StartCountdown();
        await InvokeAsync(StateHasChanged);
        await ListenAsync();
    }

    [JSInvokable]
    public async Task NotHeardAsync(string reason)
    {
        if (_phase is not (Phase.Listening or Phase.Finishing)) return;
        if (reason is "not-allowed" or "service-not-allowed" or "audio-capture" or "network")
        {
            await StopListeningAsync();
            if (reason == "network") { _phase = Phase.Idle; _voiceNotice = "Your connection is too slow for talking right now. You can type instead."; }
            else Blocked();
            await InvokeAsync(StateHasChanged);
            return;
        }
        // Silence, not the end: keep listening (the countdown, if any, carries on).
        await ListenAsync();
    }

    private static readonly System.Text.RegularExpressions.Regex Closing = new(@"(,?\s*\b(that's all|that is all|that's it|that is it|i'm done|i am done|nothing else|done)[.!]?)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static string Sentence(string words)
    {
        var text = words.Trim();
        if (text.Length == 0) return text;
        if (char.IsLower(text[0])) text = char.ToUpperInvariant(text[0]) + text[1..];
        if (!".!?".Contains(text[^1])) text += ".";
        return text;
    }

    private static string LowerFirst(string text) =>
        text.Length > 1 && char.IsUpper(text[0]) && !char.IsUpper(text[1]) ? char.ToLowerInvariant(text[0]) + text[1..] : text;

    private void StartCountdown()
    {
        _pause?.Cancel();
        _pause = new CancellationTokenSource();
        _countdown = PauseSeconds;
        _pauseRun++;
        _phase = Phase.Finishing;
        _ = CountdownAsync(_pause.Token);
    }

    private async Task CountdownAsync(CancellationToken token)
    {
        try
        {
            while (_countdown > 0)
            {
                await Task.Delay(1000, token);
                _countdown--;
            }
            await InvokeAsync(FinishAsync);
        }
        catch (TaskCanceledException) { }
    }

    private void KeepTalking()
    {
        _pause?.Cancel();
        _phase = Phase.Listening;
    }

    private async Task DoneAsync()
    {
        if (_interim.Trim().Length > 0) _said = _said.Length == 0 ? Sentence(_interim) : $"{_said} {Sentence(_interim)}";
        _interim = string.Empty;
        await FinishAsync();
    }

    // Their turn aloud is over: it joins the conversation like a typed message.
    private async Task FinishAsync()
    {
        if (_phase is not (Phase.Listening or Phase.Finishing)) return;
        _pause?.Cancel();
        await StopListeningAsync();
        var said = _said.Trim();
        _said = string.Empty;
        if (_closingHeard) _stopAsking = true;
        _closingHeard = false;
        if (said.Length == 0 && _stopAsking && CanFinishUpdateNow)
        {
            _stopAsking = false;
            await FinishUpdateAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (said.Length == 0)
        {
            _phase = _change is not null ? Phase.Checking : CurrentCheck is not null ? Phase.Asking : Phase.Idle;
            _voiceNotice = "I didn't catch anything. Try again, or type instead.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        await OwnerSaidAsync(said);
        // Ended by a pause or "that's all" rather than a tap: nothing else draws what comes next.
        await InvokeAsync(StateHasChanged);
    }

    // ── Their turn, said or typed ──────────────────────────────────────────

    private async Task OwnerSaidAsync(string text)
    {
        _messages.Add(new Message { Who = Who.Owner, Text = text });
        // Updating it: an answer to what a change left open, more to change, or "that's all".
        if (HasSummary)
        {
            if (_changeAsk is { } gap)
            {
                _changeAsk = null;
                await ThinkAsync();
                var (added, replaced) = await ConcludeIntoPendingAsync(gap, await Interview.HearAsync(gap, text));
                await AnythingElseAsync(added, replaced);
                return;
            }
            if (EndsUpdate.IsMatch(text.Trim())) { await FinishUpdateAsync(); return; }
            await WriteAsync(text, talked: _voice);
            return;
        }
        if (!Interview.Available)
        {
            await WriteAsync(text, talked: _voice);
            return;
        }
        // An answer to the question it just asked; then the next one, or the topic's check.
        if (_voiceAsk is { } ask)
        {
            _voiceAsk = null;
            await ThinkAsync();
            _answers[ask.Id] = await Interview.HearAsync(ask, text);
            await ContinueTopicAsync();
            return;
        }
        // Their own words about the job: read for everything it needs to know, this topic or any other.
        if (_topicAt == 0)
        {
            _told = _told.Length == 0 ? Sentence(text) : $"{_told} {Sentence(text)}";
            await ReadJobAsync();
            ApproveYourJob();
            return;
        }
        // Said while a topic's check waits: read as answers (for any topic), and the check shows them.
        _later = _later.Length == 0 ? Sentence(text) : $"{_later} {Sentence(text)}";
        await ReadJobAsync();
        RefreshCheck();
        _phase = CurrentCheck is not null ? Phase.Asking : Phase.Idle;
    }

    private async Task ThinkAsync()
    {
        _phase = Phase.Thinking;
        await InvokeAsync(StateHasChanged);
    }

    // ── Its topics ─────────────────────────────────────────────────────────

    private JobInterviewRequest Request(string? said = null) =>
        new(UseCase ?? AgentUseCase.Custom, CustomJob, Industry, Business, said ?? _told, new Dictionary<string, FormAnswer>(_answers));

    // Everything they have said, for reading what it knows.
    private string Heard() => _later.Length == 0 ? _told : $"{_told} {_later}";

    private async Task ReadJobAsync()
    {
        await ThinkAsync();
        _job = await Interview.ReadAsync(Request(Heard()));
        // The topics stay as they were when the conversation began.
        if (_sections.Count == 0) _sections = _job.Sections ?? [];
    }

    private bool Answered(string id) =>
        (_answers.TryGetValue(id, out var answer) && !answer.IsEmpty) || (_job?.Known.ContainsKey(id) ?? false);

    // What it understood so far, given and heard: the answers to check.
    private Dictionary<string, FormAnswer> Understood()
    {
        var all = new Dictionary<string, FormAnswer>();
        if (_job is not null)
        {
            foreach (var (id, answer) in _job.Guessed) all[id] = answer;
            foreach (var (id, answer) in _job.Known) all[id] = answer;
        }
        foreach (var (id, answer) in _answers.Where(pair => !pair.Value.IsEmpty)) all[id] = answer;
        return all;
    }

    private IReadOnlyList<JobAsk> AsksIn(JobSection section) =>
        (_job?.Asks ?? []).Where(ask => section.AskIds.Contains(ask.Id)).ToList();

    // Covered by what they said already: what it can't do without is known (or, with nothing it must know, anything is).
    private bool Complete(JobSection section)
    {
        var asks = AsksIn(section);
        var must = asks.Where(ask => ask.Must).ToList();
        return must.Count > 0 ? must.All(ask => Answered(ask.Id)) : asks.Any(ask => Answered(ask.Id));
    }

    // What it still needs to ask in a topic: what it can't do without first, then the rest.
    private JobAsk? NextGap(JobSection section) =>
        AsksIn(section).OrderByDescending(ask => ask.Must)
            .FirstOrDefault(ask => !Answered(ask.Id) && !(_job?.Guessed.ContainsKey(ask.Id) ?? false) && !_asked.Contains(ask.Id));

    private TopicCheck? CurrentCheck => _messages.LastOrDefault(message => message.Check is { Done: false })?.Check;

    // The next topic: a divider, then a conversation about it (unless it's covered already), then its approval.
    private async Task NextTopicAsync()
    {
        _topicAt++;
        _askedHere = 0;
        _stopAsking = false;
        if (CurrentSection is not { } section)
        {
            await FinishInterviewAsync();
            return;
        }
        _messages.Add(new Message { Who = Who.Topic, Text = section.Title });
        if (Complete(section)) { ApproveTopic(section, ahead: true); return; }
        if (NextGap(section) is { } gap) { await AskAsync(gap); return; }
        ApproveTopic(section, ahead: false);
    }

    // A question, in the conversation: said aloud and listened for while they talk; typed, the box waits.
    private async Task AskAsync(JobAsk ask)
    {
        _asked.Add(ask.Id);
        _askedHere++;
        _voiceAsk = ask;
        var message = new Message { Who = Who.Agent, Text = ask.Spoken };
        _messages.Add(message);
        if (_voice && _canSpeak) { _speaking = message; Say(ask.Spoken, ListenTurnAsync); return; }
        _speaking = null;
        if (_voice) { await ListenTurnAsync(); return; }
        _phase = Phase.Idle;
        _focusType = true;
    }

    // After an answer: the next thing it needs to know (unless they've said "that's all"), else the topic's approval.
    private async Task ContinueTopicAsync()
    {
        _job = await Interview.ReadAsync(Request(Heard()));
        if (CurrentSection is not { } section) return;
        if (!_stopAsking && _askedHere < MostAskedInTopic && NextGap(section) is { } gap) { await AskAsync(gap); return; }
        ApproveTopic(section, ahead: false);
    }

    // Your job, approved like every topic: what they told it, in their words, to read or change.
    private static readonly JobSection YourJob = new("job", "Your job", []);
    private const string YourJobAnswer = "job-told";

    private void ApproveYourJob()
    {
        var check = new TopicCheck
        {
            Section = YourJob,
            Questions = [new FormQuestion(YourJobAnswer, "My job, in your words", FormQuestionKind.Text, Placeholder: "What I do, what I never do, and when to bring you in")],
            Answers = new Dictionary<string, FormAnswer> { [YourJobAnswer] = new([], _told) },
            Title = "Your job",
            Subtitle = "Here's my job, as you told me. Change anything that isn't right.",
        };
        ShowApproval("Here's my job, as you told me. Have a look, and approve it below.", check);
    }

    // A topic's approval: what it gathered (lines to read, with Change), anything still open, docked where the box is.
    private void ApproveTopic(JobSection section, bool ahead)
    {
        var asks = AsksIn(section);
        var understood = Understood();
        var open = asks.Any(ask => !understood.ContainsKey(ask.Id));
        var topic = LowerFirst(section.Title);
        var line = ahead
            ? $"You've already told me about {topic}. Have a look, and approve it below."
            : $"Here's what I've got for {topic}. Have a look, and approve it below.";
        var check = new TopicCheck
        {
            Section = section,
            Questions = asks.Select(ask => ask.Form).ToList(),
            Answers = understood.Where(pair => section.AskIds.Contains(pair.Key)).ToDictionary(pair => pair.Key, pair => pair.Value),
            Title = section.Title,
            Subtitle = open ? "Answer what's left, and change anything that isn't right." : "Change anything that isn't right.",
        };
        ShowApproval(line, check);
    }

    // The agent says so (aloud while they're talking), and the approval comes up.
    private void ShowApproval(string line, TopicCheck check)
    {
        var lead = new Message { Who = Who.Agent, Text = line };
        _messages.Add(lead);
        _messages.Add(new Message { Who = Who.Agent, Check = check });
        _formBusy = false;
        _voiceAsk = null;
        if (_voice && _canSpeak)
        {
            _speaking = lead;
            Say(line, () => { _phase = Phase.Asking; return Task.CompletedTask; });
            return;
        }
        _speaking = null;
        _phase = Phase.Asking;
    }

    // More said while a check waits: it shows what it now knows, keeping what they picked.
    private void RefreshCheck()
    {
        if (CurrentCheck is not { } check) return;
        var answers = Understood().Where(pair => check.Section.AskIds.Contains(pair.Key)).ToDictionary(pair => pair.Key, pair => pair.Value);
        foreach (var (id, answer) in check.Draft ?? new Dictionary<string, FormAnswer>())
            if (!answer.IsEmpty && !(_job?.Known.ContainsKey(id) ?? false)) answers[id] = answer;
        check.Answers = answers;
        check.Draft = null;
        check.Version++;
    }

    private void CheckChanged(TopicCheck check, IReadOnlyDictionary<string, FormAnswer> answers) => check.Draft = answers;

    private string ApproveLabel => _topicAt >= _sections.Count ? "Approve and write my job description" : "Approve";

    // Approved: what the form says is the answer (a cleared one too), then the next topic.
    private async Task TopicCheckedAsync(TopicCheck check, IReadOnlyDictionary<string, FormAnswer> answers)
    {
        check.Draft = answers;
        check.Done = true;
        _confirmed.Add(check.Section.Id);
        _voiceAsk = null;
        if (check.Section == YourJob)
        {
            // Their job, as approved: changed, it's read again for what it covers.
            var told = answers.GetValueOrDefault(YourJobAnswer)?.Text?.Trim() ?? string.Empty;
            if (told.Length > 0 && told != _told)
            {
                _told = Sentence(told);
                await ReadJobAsync();
            }
        }
        else foreach (var (id, answer) in answers) _answers[id] = answer;
        KeepProgress();
        await NextTopicAsync();
    }

    // Every topic done: everything understood, where it belongs; then the job description.
    private async Task FinishInterviewAsync()
    {
        _topicAt = _sections.Count + 1;
        _formBusy = true;
        foreach (var (id, answer) in Understood()) _answers.TryAdd(id, answer);
        var outcome = await Interview.ConcludeAsync(Request());
        if (Settings is not null) outcome.Apply(Settings);
        await OnSettings.InvokeAsync(outcome.Apply);
        if (Memory.Available)
        {
            foreach (var fact in outcome.Facts)
            {
                try { await Memory.AddAsync(fact); }
                catch (Exception exception) when (exception is HttpRequestException or NotSupportedException) { }
            }
        }
        _noted = outcome.Noted;
        // What an answer changed is said its new way, not both.
        var kept = AgentBrief.SentencesOf(_told).Where(line => !(outcome.Replaced ?? []).Contains(line));
        var said = string.Join(" ", kept.Concat(outcome.Sentences).Where(part => part.Trim().Length > 0));
        ResetInterview();
        await WriteAsync(said, talked: _voice);
    }

    private void ResetInterview()
    {
        _told = string.Empty;
        _later = string.Empty;
        _answers.Clear();
        _asked.Clear();
        _voiceAsk = null;
        _stopAsking = false;
        _closingHeard = false;
        _formBusy = false;
    }

    private void LeaveConversation()
    {
        ClearChange();
        ResetConversation();
        _phase = Phase.Idle;
    }

    // The conversation put away: back to the start (smaller, once there is a job description).
    private void ResetConversation()
    {
        _messages.Clear();
        _speaking = null;
        _topicAt = 0;
        _confirmed.Clear();
        _threadShown = string.Empty;
        _typed = string.Empty;
    }

    // "Skip this question": on to the next thing it needs, or the topic's approval, where it's left open.
    // (Said and then skipped: what was said still counts.)
    private async Task SkipQuestionAsync()
    {
        _pause?.Cancel();
        await StopListeningAsync();
        var heard = $"{_said} {_interim}".Trim();
        _said = string.Empty;
        _interim = string.Empty;
        if (HasSummary && _changeAsk is { } open)
        {
            _changeAsk = null;
            if (heard.Length > 0)
            {
                _messages.Add(new Message { Who = Who.Owner, Text = Sentence(heard) });
                var (added, replaced) = await ConcludeIntoPendingAsync(open, await Interview.HearAsync(open, heard));
                await AnythingElseAsync(added, replaced);
                return;
            }
            if (!_pendingOpen.Any(ask => ask.Id == open.Id)) _pendingOpen.Add(open);
            await AnythingElseAsync();
            return;
        }
        if (heard.Length > 0) _messages.Add(new Message { Who = Who.Owner, Text = Sentence(heard) });
        if (_voiceAsk is { } ask && heard.Length > 0) _answers[ask.Id] = await Interview.HearAsync(ask, heard);
        _voiceAsk = null;
        await ThinkAsync();
        await ContinueTopicAsync();
    }

    private void Blocked()
    {
        _phase = Phase.Idle;
        _voiceNotice = "Your microphone is blocked. You can allow it from the icon at the left of the address bar, or type instead.";
    }

    private async Task StopListeningAsync()
    {
        if (_listen is not null) { await _listen.DisposeAsync(); _listen = null; }
        if (_mic is not null) { await _mic.DisposeAsync(); _mic = null; }
    }

    // ── Writing it ─────────────────────────────────────────────────────────

    // The first time: written from what they said, appearing sentence by
    // sentence as a real reply arrives. After that: what they said, read, and
    // shown to approve before it goes in.
    private async Task WriteAsync(string said, bool talked = false)
    {
        var first = !HasSummary;
        _phase = Phase.Thinking;
        if (first)
        {
            _shown = true;
            _writing = true;
            _scrollToSummary = true;
        }
        await InvokeAsync(StateHasChanged);
        try
        {
            if (first)
            {
                var written = await Briefing.DraftAsync(new(UseCase ?? AgentUseCase.Custom, CustomJob, Industry, Business, said));
                _writing = false;
                foreach (var sentence in written.Sentences())
                {
                    _stream.Add(sentence);
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(StreamMs);
                }
                _stream.Clear();
                Brief.Summary = written.Summary;
                _fresh = true;
                ClearAdded();
                // The conversation has done its work: the job description is the thing now.
                ResetConversation();
                if (_noted is not null) NotedFade.Start(NotedSeconds, () => _noted = null);
                if (_readyMade) await ShowReadyCheckAsync();
                await OnChange.InvokeAsync();
                if (DraftKey is not null) Drafts.Drop(DraftKey);
                // Written from approved topics (or what was said): the agent's now. A ready-made one waits for its check.
                if (!_readyMade || _readyQuestions.Count == 0) await OnWritten.InvokeAsync(_noted);
                // It says so, aloud when they were talking, and they read it.
                if (_canSpeak && (talked || (_readyMade && _readyQuestions.Count > 0)))
                {
                    _speaking = null;
                    Say(_readyQuestions.Count > 0
                        ? "Here's a ready-made job description. Have a look at what I assumed, and change anything that isn't right."
                        : "Thanks! Here's my job description. Have a read, and change anything that isn't right.", null);
                }
                else _phase = Phase.Idle;
            }
            else
            {
                await NoteChangeAsync(said);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException)
        {
            _writing = false;
            _stream.Clear();
            if (first && Brief.IsEmpty) _shown = false;
            _phase = Phase.Idle;
            _voiceNotice = "We couldn't write that just now. Try again.";
        }
        finally
        {
            _said = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Updating it: everything they want changed, then one approval ───────

    // What they've asked for so far: the job description as it would be, the sentences going in, the ones they
    // take the place of (from the job description as it was), what a change left open (for the approval), and
    // what has been asked already.
    private AgentBrief? _pending;
    private readonly List<string> _pendingAdded = [], _pendingReplaced = [];
    private readonly List<JobAsk> _pendingOpen = [];
    private readonly HashSet<string> _pendingAsked = [];

    private bool CanFinishUpdateNow => HasSummary && _change is null && (_pendingAdded.Count > 0 || _pendingReplaced.Count > 0);

    // A whole message that ends it: "That's all", "No", "Nothing else"...
    private static readonly System.Text.RegularExpressions.Regex EndsUpdate = new(@"^(no|nope|no thanks|no thank you|that's all|that is all|that's it|that is it|nothing else|nothing|i'm done|i am done|done)[.!]?$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // Said: worked into the change so far; what it leaves open asked there and then; then "Anything else?".
    private async Task NoteChangeAsync(string said)
    {
        var update = await Briefing.UnderstandAsync(said, _pending ?? Brief);
        if (update.Added.Count == 0)
        {
            if (_stopAsking && CanFinishUpdateNow) { _stopAsking = false; await FinishUpdateAsync(); return; }
            await AgentSaysAsync(CanFinishUpdateNow ? "I have that already. Anything else?" : "That's in my job description already. Anything else?", ListenTurnAsync);
            if (!_voice) _focusType = true;
            return;
        }
        Merge(update);
        if (Interview.Available)
        {
            JobAsk? gap = null;
            try { gap = await Interview.GapAsync(Request(update.Brief.Summary), update.Added); }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException) { }
            if (gap is not null && !_stopAsking && _pendingAsked.Add(gap.Id))
            {
                _changeAsk = gap;
                await AgentSaysAsync($"{SaidBack(update.Added, update.Replaced)} {gap.Spoken}", ListenTurnAsync);
                if (!_voice) _focusType = true;
                return;
            }
            if (gap is not null && _stopAsking && !_pendingOpen.Any(ask => ask.Id == gap.Id)) _pendingOpen.Add(gap);
        }
        await AnythingElseAsync(update.Added, update.Replaced);
    }

    // Said back, then "Anything else?" (or, after "that's all", the approval).
    private async Task AnythingElseAsync(IReadOnlyList<string>? added = null, IReadOnlyList<string>? replaced = null)
    {
        if (_stopAsking && CanFinishUpdateNow) { _stopAsking = false; await FinishUpdateAsync(); return; }
        _stopAsking = false;
        await AgentSaysAsync(added is { Count: > 0 } ? $"{SaidBack(added, replaced)} Anything else?" : "Okay. Anything else?", ListenTurnAsync);
        if (!_voice) _focusType = true;
    }

    // What it understood, said back: what goes in, and what of the job description as it was it takes the place of.
    private string SaidBack(IReadOnlyList<string> added, IReadOnlyList<string>? replaced)
    {
        var instead = (replaced ?? []).Where(line => Brief.Sentences().Contains(line)).ToList();
        return $"Got it: {Quoted(added)}{(instead.Count > 0 ? $", instead of {Quoted(instead)}" : null)}.";
    }

    private static string Quoted(IEnumerable<string> lines) => string.Join(" ", lines.Select(line => $"“{line.Trim().TrimEnd('.')}”"));

    // Into the change so far, with what it takes the place of: an earlier addition goes (it's said another way
    // now); a sentence from the job description as it was is shown as replaced.
    private void Merge(AgentBriefUpdate update)
    {
        _pending = update.Brief;
        Replace(update.Replaced ?? []);
        foreach (var line in update.Added)
            if (!_pendingAdded.Contains(line)) _pendingAdded.Add(line);
    }

    private void Replace(IEnumerable<string> lines)
    {
        foreach (var line in lines)
            if (!_pendingAdded.Remove(line) && !_pendingReplaced.Contains(line)) _pendingReplaced.Add(line);
    }

    // An answer to what a change left open, worked in (what it replaces goes); an empty one waits on the approval.
    private async Task<(List<string> Added, List<string> Replaced)> ConcludeIntoPendingAsync(JobAsk gap, FormAnswer? answer)
    {
        var added = new List<string>();
        var replaced = new List<string>();
        if (answer is not { IsEmpty: false } || _pending is null)
        {
            if (!_pendingOpen.Any(ask => ask.Id == gap.Id)) _pendingOpen.Add(gap);
            return (added, replaced);
        }
        _pendingOpen.RemoveAll(ask => ask.Id == gap.Id);
        try
        {
            var outcome = await Interview.ConcludeAsync(new(UseCase ?? AgentUseCase.Custom, CustomJob, Industry, Business, _pending.Summary,
                new Dictionary<string, FormAnswer> { [gap.Id] = answer }));
            if (outcome.Replaced is { Count: > 0 } gone)
            {
                _pending = new AgentBrief { Summary = string.Join(" ", _pending.Sentences().Where(line => !gone.Contains(line))) };
                Replace(gone);
                replaced.AddRange(gone);
            }
            foreach (var sentence in outcome.Sentences)
            {
                var more = await Briefing.UnderstandAsync(sentence, _pending);
                Merge(more);
                added.AddRange(more.Added);
                replaced.AddRange(more.Replaced ?? []);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException) { }
        return (added, replaced);
    }

    // "That's all": everything they asked for, together, to approve; what's still open, to answer there.
    private async Task FinishUpdateAsync()
    {
        _pause?.Cancel();
        await StopListeningAsync();
        var heard = $"{_said} {_interim}".Trim();
        _said = string.Empty;
        _interim = string.Empty;
        if (heard.Length > 0 && !EndsUpdate.IsMatch(heard))
        {
            _messages.Add(new Message { Who = Who.Owner, Text = Sentence(heard) });
            var update = await Briefing.UnderstandAsync(heard, _pending ?? Brief);
            if (update.Added.Count > 0) Merge(update);
        }
        if (_changeAsk is { } open)
        {
            if (!_pendingOpen.Any(ask => ask.Id == open.Id)) _pendingOpen.Add(open);
            _changeAsk = null;
        }
        if (_pending is null || !CanFinishUpdateNow)
        {
            await AgentSaysAsync("Okay, nothing to change. My job stays as it is.", null);
            return;
        }
        _change = new AgentBriefUpdate(_pending, [.. _pendingAdded], [.. _pendingReplaced]);
        _changeTalked = _voice;
        ShowChange();
    }

    private void ShowChange()
    {
        _formBusy = false;
        if (_change is not { } change) return;
        var message = _messages.FirstOrDefault(each => each.Change);
        if (message is null)
        {
            message = new Message { Who = Who.Agent, Text = $"{ChangeTitle(change)}, everything together. Have a look, and approve it below.", Change = true };
            _messages.Add(message);
        }
        _phase = Phase.Checking;
        if (_changeTalked && _canSpeak)
        {
            _speaking = message;
            Say(message.Text, () => { _phase = Phase.Checking; return Task.CompletedTask; });
        }
    }

    private static string ChangeTitle(AgentBriefUpdate change) => change.Replaced is { Count: > 0 } ? "Here's what I'll change" : "Here's what I'll add";

    // What a change left open and they skipped: asked again on the approval.
    private IReadOnlyList<FormQuestion> ChangeQuestions => [.. _pendingOpen.Select(ask => ask.Form)];

    // What changes: each sentence going in, and any it takes the place of.
    private RenderFragment ChangeLead(AgentBriefUpdate change) => __builder =>
    {
        <ul class="job-editor__change" aria-label="What changes in my job description">
            @foreach (var sentence in change.Added)
            {
                <li class="is-in">
                    <Icon Name="IconName.RiAddFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose><span class="sr-only">Adding: </span>@sentence</Typography>
                </li>
            }
            @foreach (var sentence in change.Replaced ?? [])
            {
                <li class="is-out">
                    <Icon Name="IconName.RiSubtractFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Instead of <del>@sentence</del></Typography>
                </li>
            }
        </ul>
    };

    private RenderFragment ChangeActions => __builder =>
    {
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@_formBusy" @onclick="CancelChange">Cancel</Button>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" disabled="@_formBusy" @onclick="SayMore">
            <IconLeft><Icon Name="IconName.RiChat3Fill" /></IconLeft>
            <ChildContent>Say more</ChildContent>
        </Button>
    };

    // A yes: it goes in, with the answer to its question, and the settings follow.
    private async Task AddChangeAsync(IReadOnlyDictionary<string, FormAnswer> answers)
    {
        if (_change is null || _pending is null) return;
        _formBusy = true;
        foreach (var gap in _pendingOpen.ToList())
            if (answers.TryGetValue(gap.Id, out var answer) && !answer.IsEmpty) await ConcludeIntoPendingAsync(gap, answer);
        var brief = _pending;
        var added = _pendingAdded.ToList();
        var replaced = _pendingReplaced.ToList();
        _before = Brief.Copy();
        _rulesBefore = Settings is null ? null : AgentBriefRules.Of(Settings);
        Brief.Summary = brief.Summary;
        if (Settings is not null) AgentBriefDefaults.Follow(Settings, added);
        _added = added;
        _replaced = replaced;
        AddedFade.Start(NotedSeconds, ClearAdded);
        _fresh = true;
        // Added: the conversation is put away, and the card folds again, with what was added showing.
        _unfolded = false;
        var before = _before;
        var rulesBefore = _rulesBefore;
        ClearChange();
        ResetConversation();
        _phase = Phase.Idle;
        await OnChange.InvokeAsync();
        if (before is not null) await OnUpdated.InvokeAsync(new(before, rulesBefore, added, replaced));
    }

    private void CancelChange()
    {
        ClearChange();
        ResetConversation();
        _phase = Phase.Idle;
    }

    // Back to the conversation, everything so far kept, to add or change more.
    private void SayMore()
    {
        _change = null;
        _messages.RemoveAll(message => message.Change);
        _messages.Add(new Message { Who = Who.Agent, Text = "What else?" });
        _phase = Phase.Idle;
        _focusType = true;
    }

    private void ClearChange()
    {
        _change = null;
        _changeAsk = null;
        _changeTalked = false;
        _formBusy = false;
        _pending = null;
        _pendingAdded.Clear();
        _pendingReplaced.Clear();
        _pendingOpen.Clear();
        _pendingAsked.Clear();
    }

    // ── A ready-made one ───────────────────────────────────────────────────

    private async Task SuggestAsync()
    {
        _noted = null;
        _readyMade = true;
        try { await WriteAsync(string.Empty); }
        finally { _readyMade = false; }
    }

    // What the ready-made one took for granted (lines to check) and what it
    // couldn't know (questions); only what the job can't do without.
    private async Task ShowReadyCheckAsync()
    {
        if (!Interview.Available) return;
        try
        {
            var reading = await Interview.ReadAsync(Request(Brief.Summary));
            var assumed = reading.Asks.Where(ask => ask.Must && reading.Known.ContainsKey(ask.Id));
            var unknown = reading.Asks.Where(ask => ask.Must && !reading.Known.ContainsKey(ask.Id));
            _readyQuestions = assumed.Concat(unknown).Take(MostOnForm).Select(ask => ask.Form).ToList();
            var answers = new Dictionary<string, FormAnswer>(reading.Guessed);
            foreach (var (id, answer) in reading.Known) answers[id] = answer;
            _readyAnswers = answers;
            _readyChanged = false;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException) { _readyQuestions = []; }
    }

    private void ReadyChanged(IReadOnlyDictionary<string, FormAnswer> answers) =>
        _readyChanged = answers.Any(pair => !SameAnswer(pair.Value, _readyAnswers?.GetValueOrDefault(pair.Key) ?? FormAnswer.None));

    private static bool SameAnswer(FormAnswer one, FormAnswer other) =>
        one.Picked.Order().SequenceEqual(other.Picked.Order()) && (one.Text ?? "").Trim() == (other.Text ?? "").Trim();

    // "Looks right", or what they changed, worked in: each changed answer said its new way.
    private async Task ReadyCheckedAsync(IReadOnlyDictionary<string, FormAnswer> answers)
    {
        var changed = answers.Where(pair => !SameAnswer(pair.Value, _readyAnswers?.GetValueOrDefault(pair.Key) ?? FormAnswer.None))
            .ToDictionary(pair => pair.Key, pair => pair.Value);
        if (changed.Count == 0) { CloseReadyCheck(); await OnWritten.InvokeAsync(_noted); return; }
        _formBusy = true;
        try
        {
            var outcome = await Interview.ConcludeAsync(new(UseCase ?? AgentUseCase.Custom, CustomJob, Industry, Business, Brief.Summary, changed));
            var replaced = (outcome.Replaced ?? []).ToList();
            var rest = new AgentBrief { Summary = string.Join(" ", Brief.Sentences().Where(line => !replaced.Contains(line))) };
            var update = outcome.Sentences.Count == 0 ? new AgentBriefUpdate(rest, []) : await Briefing.UnderstandAsync(string.Join(" ", outcome.Sentences), rest);
            _before = Brief.Copy();
            _rulesBefore = Settings is null ? null : AgentBriefRules.Of(Settings);
            Brief.Summary = update.Brief.Summary;
            if (Settings is not null) { outcome.Apply(Settings); AgentBriefDefaults.Follow(Settings, update.Added); }
            await OnSettings.InvokeAsync(outcome.Apply);
            if (Memory.Available)
                foreach (var fact in outcome.Facts)
                {
                    try { await Memory.AddAsync(fact); }
                    catch (Exception exception) when (exception is HttpRequestException or NotSupportedException) { }
                }
            if (outcome.Noted is { } noted) { _noted = noted; NotedFade.Start(NotedSeconds, () => _noted = null); }
            _added = update.Added.Count > 0 ? update.Added : replaced;
            _replaced = [.. replaced, .. update.Replaced ?? []];
            if (_added.Count > 0) AddedFade.Start(NotedSeconds, ClearAdded);
            _fresh = true;
            await OnChange.InvokeAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or NotSupportedException)
        {
            _voiceNotice = "We couldn't update that just now. Try again.";
        }
        CloseReadyCheck();
        await OnWritten.InvokeAsync(_noted);
    }

    private void CloseReadyCheck()
    {
        _readyQuestions = [];
        _readyAnswers = null;
        _readyChanged = false;
        _formBusy = false;
    }

    private void ClearAdded()
    {
        AddedFade.Stop();
        _added = [];
        _replaced = [];
        _before = null;
        _rulesBefore = null;
    }

    private async Task UndoAsync()
    {
        if (_before is not { } before) return;
        Brief.Summary = before.Summary;
        if (_rulesBefore is { } rules && Settings is not null) rules.Restore(Settings);
        _rulesBefore = null;
        _before = null;
        AddedFade.Stop();
        _added = [];
        _replaced = [];
        await OnChange.InvokeAsync();
    }

    // ── A voice note (where talking live isn't possible) ───────────────────

    private void StartNote()
    {
        _voiceNotice = null;
        _phase = Phase.Note;
        _recordSeconds = 0;
        _recordingStarting = true;
    }

    private void StartClock()
    {
        _recordClock?.Cancel();
        _recordClock = new CancellationTokenSource();
        _ = TickAsync(_recordClock.Token);
    }

    private async Task TickAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                _recordSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task CancelNoteAsync()
    {
        _recordClock?.Cancel();
        _recordingStarting = false;
        _phase = CurrentCheck is not null ? Phase.Asking : Phase.Idle;
        var recording = _recording;
        _recording = null;
        if (recording is not null) await recording.CancelAsync();
    }

    // The note's words go into the box, to check before sending.
    private async Task SendNoteAsync()
    {
        _recordClock?.Cancel();
        var recording = _recording;
        _recording = null;
        _phase = CurrentCheck is not null ? Phase.Asking : Phase.Idle;
        if (recording is null) return;
        var note = await recording.StopAsync();
        if (note.Transcript.Trim().Length == 0)
            _voiceNotice = "We couldn't make out the words in that note. Try again, or type instead.";
        else _typed = _typed.Trim().Length == 0 ? Sentence(note.Transcript) : $"{_typed.Trim()} {Sentence(note.Transcript)}";
        _focusType = true;
    }

    // A line that goes after a few seconds (fading first), and waits while the pointer or keyboard is on it.
    private sealed class Fading(Func<Task> render)
    {
        private CancellationTokenSource? _timer;

        public bool Leaving { get; private set; }

        public void Hold()
        {
            _timer?.Cancel();
            Leaving = false;
        }

        public void Stop() => Hold();

        public void Start(int seconds, Action gone)
        {
            _timer?.Cancel();
            Leaving = false;
            _timer = new CancellationTokenSource();
            _ = RunAsync(seconds, gone, _timer.Token);
        }

        private async Task RunAsync(int seconds, Action gone, CancellationToken token)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(seconds), token);
                Leaving = true;
                await render();
                await Task.Delay(400, token);
                Leaving = false;
                gone();
                await render();
            }
            catch (TaskCanceledException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _notedFade?.Stop();
        _addedFade?.Stop();
        _recordClock?.Cancel();
        _pause?.Cancel();
        await StopListeningAsync();
        await StopSpeakingAsync();
        if (_recording is not null) await _recording.CancelAsync();
        _self?.Dispose();
    }
}
