@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@using System.Globalization
@using System.Text.RegularExpressions
@using Parrot.Web.Components.Pages.Dashboard.TeachAi
@inject AuroraInterop Interop

@* An agent, live, as a customer would meet it: its avatar and name, a
   greeting in its role's words and its tone, and answers from what the
   business taught it, following its rules (money, permissions, when it hands
   over). Every change on the setup screen or its settings shows here at
   once. The demo answers with simple rules; the real one needs an answering
   service (see knowledge-backend-requests). *@

<aside class="agent-preview" aria-label="Preview">
    <div class="agent-preview__phone">
        <header class="agent-preview__head">
            <span class="agent-preview__avatar-wrap">
                <img class="agent-preview__avatar" src="@AgentBuilderCopy.MascotImage(Form.Mascot)" alt="" />
                <i aria-hidden="true"></i>
            </span>
            <span class="agent-preview__who">
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@(Form.HasName ? Form.DisplayName : "Your agent")</Typography>
                <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="agent-preview__muted">@(Form.HasRole ? Form.RoleName : "Choose its job")</Typography>
            </span>
            <StatusBadge Tone="StatusTone.Brand" Glyph="IconName.RiEyeFill">Live preview</StatusBadge>
        </header>

        <div class="agent-preview__chat" aria-live="polite" @ref="_chat">
            @if (_exchanges.Count == 0)
            {
                <div class="agent-preview__welcome">
                    <span><Icon Name="IconName.RiSparkling2Fill" Size="IconSize.Md" /></span>
                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">See how @Form.DisplayName will reply</Typography>
                    <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>Choose a question below or write one like a customer.</Typography>
                </div>
            }
            <div class="agent-preview__thread">
                <div class="agent-preview__msg is-agent">
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@Greeting</Typography>
                </div>
                @foreach (var exchange in _exchanges)
                {
                    <div class="agent-preview__msg is-customer">
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@exchange.Question</Typography>
                    </div>
                    @if (exchange.Reply is { } reply)
                    {
                        <div class="agent-preview__msg is-agent">
                            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@reply.Text</Typography>
                        </div>
                        <Typography TextStyle="TextStyle.Small12Medium" As="small" Class="agent-preview__basis">
                            <Icon Name="@reply.Icon" Size="IconSize.Sm" />
                            @reply.Note
                        </Typography>
                    }
                    else
                    {
                        <div class="agent-preview__msg is-agent is-typing" role="status" aria-label="@($"{Form.DisplayName} is typing")"><i></i><i></i><i></i></div>
                    }
                }
            </div>
        </div>

        @if (Suggestions is { Count: > 0 } suggestions)
        {
            <div class="agent-preview__suggestions">
                @foreach (var suggestion in suggestions)
                {
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" disabled="@_answering" @onclick="() => AskAsync(suggestion)">@suggestion</Button>
                }
            </div>
        }
        <div class="agent-preview__composer">
            <TextArea Value="@_question" ValueChanged="v => _question = v ?? string.Empty" AriaLabel="Ask as a customer"
                      Variant="TextAreaVariant.Plain" Placeholder="Ask what your customers ask…"
                      Rows="1" MaxLength="300" AutoGrow SubmitOnEnter OnKeyDown="AskKeyAsync" />
            <Button Size="ButtonSize.Small" aria-label="Send" title="Send" disabled="@(string.IsNullOrWhiteSpace(_question) || _answering)" @onclick="() => AskAsync(_question)">
                <IconLeft><Icon Name="IconName.RiSendPlaneFill" /></IconLeft>
            </Button>
        </div>
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public AgentForm Form { get; set; } = default!;

    /// <summary>The business's approved knowledge, shared by every agent.</summary>
    [Parameter] public IReadOnlyList<KnowledgeCard> Cards { get; set; } = [];

    [Parameter] public string Business { get; set; } = string.Empty;

    private sealed record PreviewReply(string Text, string Note, IconName Icon);
    private sealed class Exchange(string question)
    {
        public string Question { get; } = question;
        public PreviewReply? Reply { get; set; }
    }

    private static readonly Regex Upset = new(@"\b(?:angry|upset|annoyed|disappointed|terrible|worst|useless|rubbish|frustrat\w*|not happy)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled);
    private static readonly Regex Recommend = new(@"\b(?:recommend\w*|suggest\w*|which (?:one|should)|what should i (?:buy|get)|best)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled);
    private static readonly Regex OrderStatus = new(@"\b(?:where(?:'s| is) my (?:order|package|delivery)|order status|track\w*)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled);
    // An amount of money: "₦80,000", "80k", "80000 naira".
    private static readonly Regex Amount = new(@"₦\s?(\d[\d,]*)(k)?|\b(\d[\d,]*)\s?(k|naira)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private readonly List<Exchange> _exchanges = [];
    private ElementReference _chat;
    private string _question = string.Empty;
    private bool _answering;
    private int _misses;
    private AgentRoleTemplate? _role;

    private AgentSettings Settings => Form.Settings;

    protected override void OnParametersSet()
    {
        // A new job starts the conversation again, as that job would.
        if (_role is not null && _role != Settings.Role)
        {
            _exchanges.Clear();
            _misses = 0;
        }
        _role = Settings.Role;
    }

    // ── How it sounds ───────────────────────────────────────────────────────

    private string Opener => Settings.Tone switch
    {
        AgentVoicePreset.Professional => "Hello.",
        AgentVoicePreset.Upbeat => "Hey there!",
        _ => "Hi!",
    };

    private string Closing => Settings.Length switch
    {
        AgentResponseLength.Concise => string.Empty,
        AgentResponseLength.Detailed => $"I'm happy to tell you more about anything else too. {Form.Role.Closing}",
        _ => Form.Role.Closing,
    };

    // Expressive replies end with a smile; the others keep emoji to the greeting, or none.
    private string Smile(string text) => Settings.Emoji == AgentEmojiUsage.Expressive ? $"{text} 😊" : text;

    private string Greeting
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Settings.Greeting)) return Settings.Greeting.Trim();
            var wave = Settings.Emoji == AgentEmojiUsage.None ? string.Empty : " 👋";
            // No name yet: it greets for the business until it has one.
            var who = (Form.HasName, Business.Length > 0) switch
            {
                (true, true) => $"I'm {Form.DisplayName} from {Business}.",
                (true, false) => $"I'm {Form.DisplayName}.",
                (false, true) => $"Welcome to {Business}.",
                _ => "Welcome.",
            };
            return Smile($"{Opener}{wave} {who} {Form.Role.Opening}");
        }
    }

    // ── Asking ──────────────────────────────────────────────────────────────

    // Questions about what it knows (its job's topics first), then one that tests a rule its job meets.
    private IReadOnlyList<string> Suggestions
    {
        get
        {
            var asked = _exchanges.Select(e => e.Question).ToHashSet();
            var asks = Form.Role.Asks.ToList();
            var known = Cards
                .Where(c => c.Topic is not (KnowledgeTopic.Handover or KnowledgeTopic.Notes) && c.Status == KnowledgeStatus.Confirmed && c.HasContent && Settings.Uses(c.Topic))
                .OrderBy(c => asks.Contains(c.Topic) ? asks.IndexOf(c.Topic) : asks.Count)
                .Select(c => TeachAiConversation.SampleQuestion(c.Topic))
                .Where(q => !asked.Contains(q))
                .ToList();
            var rule = Settings.Role switch
            {
                AgentRoleTemplate.Support => "Can I get a refund?",
                AgentRoleTemplate.Sales => "What do you recommend?",
                AgentRoleTemplate.Orders => "Where is my order?",
                _ => "Can I get a discount?",
            };
            var test = asked.Contains(rule) ? null : rule;
            return known.Take(test is null ? 3 : 2).Concat(test is null ? [] : [test]).ToList();
        }
    }

    private Task AskKeyAsync(KeyboardEventArgs args) =>
        args.Key == "Enter" && !args.ShiftKey && !args.IsComposing ? AskAsync(_question) : Task.CompletedTask;

    private async Task AskAsync(string question)
    {
        if (string.IsNullOrWhiteSpace(question) || _answering) return;
        var exchange = new Exchange(question.Trim());
        _exchanges.Add(exchange);
        _question = string.Empty;
        _answering = true;
        await RenderLatestAsync();
        // A moment to "type", as it will for customers.
        await Task.Delay(700);
        exchange.Reply = Reply(exchange.Question);
        _answering = false;
        await RenderLatestAsync();
    }

    // Keep the latest exchange visible while the composer stays fixed, just
    // like the Inbox. Two animation frames in the shared interop wait for the
    // new bubble to finish laying out before moving the thread.
    private async Task RenderLatestAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await Interop.ScrollToBottomAsync(_chat);
    }

    // ── Answering ───────────────────────────────────────────────────────────

    // What the business taught, with who takes over set for this agent.
    private IReadOnlyList<KnowledgeCard> PreviewCards => Cards
        .Where(c => c.Topic != KnowledgeTopic.Handover && Settings.Uses(c.Topic))
        .Append(new KnowledgeCard(KnowledgeTopic.Handover, AgentBasics.HandoverLabel(Settings), KnowledgeStatus.Confirmed, "you"))
        .ToList();

    private PreviewReply Reply(string question)
    {
        var q = question.ToLowerInvariant();
        if (Settings.HandOverWhenUpset && Upset.IsMatch(q))
            return HandOver("I'm really sorry about this. I'm getting someone from the team to help you right away.", "Upset customers go to a person");
        if (q.Contains("discount"))
            return Settings.CanOfferDiscounts
                ? new(Smile("Let me see what I can do on the price for you."), "You let it offer discounts", IconName.RiShieldCheckFill)
                : HandOver("I can't offer discounts myself, but I'll ask the team for you.", "Discounts go to a person");
        if (q.Contains("refund") && !Settings.CanApproveRefunds)
            return HandOver("I'm sorry about that. I'll pass your refund request to the team so they can sort it out.", "Refunds go to a person");
        if (OrderStatus.IsMatch(q))
            return Settings.CanCheckOrders
                ? new(Smile("Sure, let me check that for you. What's your order number?"), "It checks order status", IconName.RiTruckFill)
                : HandOver("I'll ask the team to check on your order and get back to you.", "Order checks go to a person");
        if (Settings.HandOverBigOrders && LargestAmount(q) >= Settings.BigOrderNaira)
            return HandOver("That's a big order, so I'll bring in someone from the team to help you with it.", $"Orders over ₦{Settings.BigOrderNaira.ToString("N0", CultureInfo.InvariantCulture)} go to a person");
        if (Recommend.IsMatch(q) && Settings.Uses(KnowledgeTopic.Products) && Cards.FirstOrDefault(c => c.Topic == KnowledgeTopic.Products) is { Status: KnowledgeStatus.Confirmed, Text.Length: > 0 } products)
            return Settings.CanRecommend
                ? new(Smile($"{Opener} Happy to help you choose. {products.Text} What are you shopping for?"), "It recommends from what you sell", IconName.RiShoppingBag3Fill)
                : HandOver("Let me get someone from the team to help you choose.", "Recommending goes to a person");

        var answer = TeachAiConversation.AnswerFrom(PreviewCards, question, Closing, Opener);
        if (answer.BasedOn is null)
        {
            // Two in a row it could not answer: a person takes over.
            if (Settings.HandOverAfterMisses && ++_misses >= 2)
            {
                _misses = 0;
                return HandOver("Sorry I couldn't help with that. I'm passing you to someone from the team.", "Two it couldn't answer, so it hands over");
            }
            return new(answer.Text, "Not taught yet, so it checks with you", IconName.RiInformationFill);
        }
        _misses = 0;
        if (answer.BasedOn == KnowledgeTopic.Handover)
            return HandOver(answer.Text, "Hands the chat to a person");
        return new(Smile(answer.Text), $"From what you taught: {TeachAiConversation.Name(answer.BasedOn.Value)}", IconName.RiBookOpenFill);
    }

    // Handing over, with the customer's details first when it may take them.
    private PreviewReply HandOver(string text, string note) => new(
        Settings.CanTakeDetails ? $"{text} Can I have your name and phone number so they can reach you?" : text,
        note,
        IconName.RiUserSharedFill);

    private static long LargestAmount(string text)
    {
        long largest = 0;
        foreach (Match match in Amount.Matches(text))
        {
            var digits = (match.Groups[1].Success ? match.Groups[1].Value : match.Groups[3].Value).Replace(",", "");
            if (!long.TryParse(digits, out var value)) continue;
            var thousands = match.Groups[2].Success || match.Groups[4].Value.Equals("k", StringComparison.OrdinalIgnoreCase);
            largest = Math.Max(largest, thousands ? value * 1000 : value);
        }
        return largest;
    }
}
