@page "/ai-operations"
@page "/dashboard/ai-agents"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@inject AiAgentsState AiAgentsState
@inject NavigationManager Nav
@inject ToastService Toasts
@inject AgentGate AgentGate
@inject IAiOperationsFeed Feed
@inject IBusinessKnowledge Knowledge
@inject Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiState TeachAi
@using Parrot.Web.Features.Dashboard.AiAgents
@using Parrot.Web.Components.Pages.Dashboard.TeachAi
@implements IDisposable

@* AI Operations: the owner's agents and what they need from them, in the
   order an owner asks. Is the AI doing the work (today's numbers)? Is
   anything waiting on me (only when there is)? How is each agent doing? And
   what do they all answer from (the business knowledge)?

   Today's numbers and the waiting questions come from the operations feed:
   sample figures in demo mode; real mode has no feed yet, so they are
   hidden there (see agents-backend-requests). *@

<PageTitle>AI Operations · OmniAI</PageTitle>

@if (_setupOpen)
{
    <AgentSetup OnCancel="CloseSetup" Save="SaveNewAgentAsync" />
}
else
{
    <main class="@($"operations-main {(IsEmpty ? "is-empty" : null)}")">
        <header class="operations-header">
            <div class="operations-heading">
                <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">AI Operations</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Your agents and what they need from you.</Typography>
            </div>
            @if (AiAgentsState.Agents.Count > 0)
            {
                <Button Class="ds-no-shrink" @onclick="CreateAgentAsync">
                    <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                    <ChildContent>Create agent</ChildContent>
                </Button>
            }
        </header>

        @if (Loading)
        {
            <div class="agent-grid" aria-busy="true">
                @for (var index = 0; index < 3; index++)
                {
                    <div class="agent-card-skeleton">
                        <Skeleton Shape="SkeletonShape.Block" Width="var(--ds-skeleton-avatar)" Height="var(--ds-skeleton-avatar)" Order="@(index * 3)" />
                        <Skeleton Shape="SkeletonShape.Block" Height="var(--ds-skeleton-copy)" Order="@(index * 3 + 1)" />
                        <Skeleton Shape="SkeletonShape.Block" Height="var(--ds-skeleton-body)" Order="@(index * 3 + 2)" />
                    </div>
                }
            </div>
        }
        else if (AiAgentsState.LoadFailed)
        {
            <div class="operations-start">
                <section class="operations-empty">
                    <EmptyState Glyph="IconName.RiErrorWarningFill"
                                Size="EmptyStateSize.Page"
                                Title="We couldn't load your agents"
                                Description="Check your connection and try again.">
                        <Action>
                            <Button Busy="AiAgentsState.IsLoading" @onclick="() => AiAgentsState.LoadAsync(again: true)">Try again</Button>
                        </Action>
                    </EmptyState>
                </section>
            </div>
        }
        else if (IsEmpty)
        {
            @* Nothing yet: the way in sits in the middle of the page, in front
               of them, with what their agents will know just under it. *@
            <div class="operations-start">
            <section class="operations-empty">
                <EmptyState Glyph="IconName.RiRobot3Fill"
                            Size="EmptyStateSize.Page"
                            Title="No agents yet"
                            Description="Create an agent to answer your customers and handle routine requests for you.">
                    <Action>
                        <Button @onclick="CreateAgentAsync">
                            <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                            <ChildContent>Create agent</ChildContent>
                        </Button>
                    </Action>
                </EmptyState>
            </section>
            @KnowledgeSummary
            </div>
        }
        else
        {
            @* Today, at a glance: is the AI doing the work? Shown once an agent is on. *@
            @if (Feed.Available && LiveAgents.Count > 0)
            {
                <section class="operations-stats" aria-label="Today">
                    <div class="operations-stat">
                        <span class="operations-stat__icon is-conversations"><Icon Name="IconName.RiChat3Fill" Size="IconSize.Md" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@Totals.Conversations</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Conversations today</Typography>
                        </div>
                    </div>
                    <div class="operations-stat">
                        <span class="operations-stat__icon is-answered"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Md" /></span>
                        <div>
                            <span class="operations-stat__figure">
                                <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@Totals.AnsweredAlone</Typography>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="span" Class="operations-stat__share">@Totals.AnsweredShare%</Typography>
                            </span>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Answered by your agents</Typography>
                        </div>
                    </div>
                    <div class="operations-stat">
                        <span class="operations-stat__icon is-passed"><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Md" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@Totals.PassedToTeam</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Passed to your team</Typography>
                            @if (Totals.TeamReplyMinutes is { } minutes)
                            {
                                <Typography TextStyle="TextStyle.Small12Medium" As="small" Class="operations-stat__note">Replied in @minutes min on average</Typography>
                            }
                        </div>
                    </div>
                    <div class="operations-stat">
                        <span class="operations-stat__icon is-tasks"><Icon Name="IconName.RiTaskFill" Size="IconSize.Md" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong">@Totals.TasksCreated</Typography>
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">Tasks created</Typography>
                        </div>
                    </div>
                </section>
            }

            @* The one thing to act on. Only there when something is waiting. *@
            @if (Waiting.Count > 0)
            {
                <section class="operations-needs" aria-labelledby="operations-needs-title">
                    <span class="operations-needs__icon"><Icon Name="IconName.RiQuestionAnswerFill" Size="IconSize.Md" /></span>
                    <div class="operations-needs__text">
                        <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="operations-needs-title">@WaitingTitle</Typography>
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@WaitingLine</Typography>
                    </div>
                    <Button Class="ds-no-shrink" @onclick="ReviewWaiting">Review</Button>
                </section>
            }

            <section class="operations-agents" aria-labelledby="operations-agents-title">
                <header class="operations-section-head">
                    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="h2" id="operations-agents-title">Your agents</Typography>
                    @* Sorting through them only helps once there are many. *@
                    @if (AiAgentsState.Agents.Count > ManyAgents)
                    {
                        <div class="operations-tools">
                            <SegmentedControl TValue="AgentFilter" Label="Show agents" Options="FilterOptions" Value="_filter" ValueChanged="v => _filter = v" />
                            <SearchField Value="@_search" ValueChanged="v => _search = v ?? string.Empty" Placeholder="Search agents" AriaLabel="Search agents" />
                        </div>
                    }
                </header>

                <div class="agent-grid">
                    @foreach (var agent in FilteredAgents)
                    {
                        var current = agent;
                        <AgentCard Agent="current"
                                   Today="@Feed.Today(current)"
                                   ShowToday="Feed.Available"
                                   Busy="@(_busyAgentId == current.Id)"
                                   OnOpen="() => OpenAgent(current)"
                                   OnConfigure="() => OpenSettings(current)"
                                   OnDelete="() => _pendingDelete = current"
                                   OnStatusChange="() => ChangeStatusAsync(current)" />
                    }
                </div>
                @if (FilteredAgents.Count == 0)
                {
                    <div class="operations-empty">
                        <EmptyState Glyph="IconName.RiSearch2Fill" Size="EmptyStateSize.Panel" Title="No agents found" Description="Try a different search or show all agents." />
                    </div>
                }
            </section>
        }

        @if (AiAgentsState.IsLoaded && !IsEmpty && !AiAgentsState.IsLoading)
        {
            @KnowledgeSummary
        }
    </main>
}

@* What every agent answers from: the business knowledge from "Tell us about…".
   Blue is knowledge, wherever it shows. *@
@code {
    private RenderFragment KnowledgeSummary => __builder =>
    {
        if (Knowledge.Available)
        {
            <section class="operations-knowledge" aria-labelledby="operations-knowledge-title">
                <span class="operations-knowledge__icon"><Icon Name="IconName.RiBookOpenFill" Size="IconSize.Md" /></span>
                <div class="operations-knowledge__text">
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2" id="operations-knowledge-title">What your agents know</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@KnowledgeLine</Typography>
                </div>
                <Button Variant="ButtonVariant.Secondary" Class="ds-no-shrink" @onclick="UpdateKnowledgeAsync">@(_knowledgeApproved ? "Update" : "Start")</Button>
            </section>
        }
    };

    // Until the agents have been read once, the page shows the loading cards
    // rather than "No agents yet".
    private bool Loading => AiAgentsState.IsLoading || (!AiAgentsState.IsLoaded && !AiAgentsState.LoadFailed);

    private bool IsEmpty => AiAgentsState.IsLoaded && !AiAgentsState.IsLoading && AiAgentsState.Agents.Count == 0;
}

<Dialog Open="@(_pendingDelete is not null)"
        Type="DialogType.Destructive"
        Title="@($"Delete {_pendingDelete?.Name ?? ""}?")"
        ConfirmLabel="Delete agent"
        CancelLabel="Keep agent"
        BusyLabel="Deleting…"
        Busy="@(_pendingDelete is not null && _busyAgentId == _pendingDelete.Id)"
        OnConfirm="ConfirmDeleteAsync"
        OnCancel="() => _pendingDelete = null">
    <GlyphContent><Icon Name="IconName.RiDeleteBin6Fill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>It has never replied to a customer. Deleting it can't be undone.</p>
    </Body>
</Dialog>

@code {
    private enum AgentFilter { All, On, Off, Draft }

    private AgentFilter _filter = AgentFilter.All;
    private string _search = string.Empty;
    private string? _busyAgentId;
    private AiAgent? _pendingDelete;

    // A new agent is set up on one screen; an existing one is changed on its
    // page, under Settings.
    private bool _setupOpen;

    // Filters and search show only once there are more agents than this.
    private const int ManyAgents = 6;

    private List<AiAgent> LiveAgents => AiAgentsState.Agents.Where(a => a.IsActive && !a.IsDraft).ToList();

    private AgentToday Totals => AgentToday.Sum(LiveAgents.Select(agent => Feed.Today(agent)));

    private IReadOnlyList<WaitingQuestion> Waiting => Feed.Waiting(AiAgentsState.Agents);

    private string WaitingTitle => Waiting.Count == 1
        ? "1 question your agents couldn't answer"
        : $"{Waiting.Count} questions your agents couldn't answer";

    private string WaitingLine
    {
        get
        {
            var first = Waiting[0];
            var more = Waiting.Count > 1 ? $", and {Waiting.Count - 1} more" : "";
            return $"“{first.Question}” from {first.Customer}{more}. Answer once and they'll know next time.";
        }
    }

    // Drafts are frontend only for now (saved on the setup screen, never turned on).
    private IReadOnlyList<SegmentedOption<AgentFilter>> FilterOptions =>
    [
        new(AgentFilter.All, $"All {AiAgentsState.Agents.Count}"),
        new(AgentFilter.On, $"On {LiveAgents.Count}"),
        new(AgentFilter.Off, $"Off {AiAgentsState.Agents.Count(agent => !agent.IsActive && !agent.IsDraft)}"),
        new(AgentFilter.Draft, $"Drafts {AiAgentsState.Agents.Count(agent => agent.IsDraft)}"),
    ];

    // ── What your agents know ───────────────────────────────────────────────
    private bool _knowledgeApproved;
    private IReadOnlyList<KnowledgeCard> _knowledge = [];

    private string KnowledgeLine
    {
        get
        {
            if (!_knowledgeApproved) return "Tell us about your business, so your agents answer the way you would.";
            var core = _knowledge.Where(c => c.Topic != KnowledgeTopic.Notes).ToList();
            var covered = core.Count(c => c.Status == KnowledgeStatus.Confirmed && c.HasContent);
            var missing = core.Where(c => !(c.Status == KnowledgeStatus.Confirmed && c.HasContent))
                .Select(c => TeachAiConversation.Name(c.Topic)).ToList();
            var line = $"{covered} of {core.Count} topics covered";
            if (missing.Count == 0) return $"{line}. Everything they need to answer your customers.";
            var names = missing.Count == 1 ? missing[0] : $"{string.Join(", ", missing[..^1])} and {missing[^1]}";
            return $"{line}. Still missing: {names}.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TeachAi.Changed += OnTeachAiChanged;
        await Task.WhenAll(AiAgentsState.LoadAsync(), LoadKnowledgeAsync());
    }

    private async Task LoadKnowledgeAsync()
    {
        if (!Knowledge.Available) return;
        _knowledgeApproved = await Knowledge.HasApprovedAsync();
        _knowledge = _knowledgeApproved ? await Knowledge.GetDraftAsync() : [];
    }

    // Closed after adding to it: show what the agents know now.
    private void OnTeachAiChanged()
    {
        if (TeachAi.IsOpen) return;
        _ = InvokeAsync(async () =>
        {
            await LoadKnowledgeAsync();
            StateHasChanged();
        });
    }

    private Task UpdateKnowledgeAsync()
    {
        if (_knowledgeApproved)
        {
            TeachAi.TeachMore();
            return Task.CompletedTask;
        }
        return TeachAi.RequireAsync(() => Task.CompletedTask);
    }

    public void Dispose() => TeachAi.Changed -= OnTeachAiChanged;

    // The questions wait in the inbox, where the agent asks them.
    private void ReviewWaiting() => Nav.NavigateTo("/dashboard/conversations");

    private List<AiAgent> FilteredAgents
    {
        get
        {
            // With only a few, every agent shows: there is no filter on screen.
            if (AiAgentsState.Agents.Count <= ManyAgents) return AiAgentsState.Agents.ToList();
            var query = _search.Trim();
            return AiAgentsState.Agents.Where(agent =>
                _filter switch
                {
                    AgentFilter.On => agent.IsActive && !agent.IsDraft,
                    AgentFilter.Off => !agent.IsActive && !agent.IsDraft,
                    AgentFilter.Draft => agent.IsDraft,
                    _ => true
                }
                && (query.Length == 0
                    || $"{agent.Name} {agent.Description} {string.Join(" ", agent.Playbooks.Select(p => p.Title))}"
                        .Contains(query, StringComparison.CurrentCultureIgnoreCase))
            ).ToList();
        }
    }

    // ?new=1: sent here to create an agent (from the dashboard or Business
    // setup, after "Teach your AI"), so setup opens straight away.
    [SupplyParameterFromQuery(Name = "new")] public string? New { get; set; }

    // Checked again on every arrival with ?new=1 (from another page, from
    // this one, or typed), so nothing skips the gate.
    private bool _newHandled;

    protected override async Task OnParametersSetAsync()
    {
        if (New != "1") { _newHandled = false; return; }
        if (_newHandled) return;
        _newHandled = true;
        await CreateAgentAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Drop ?new=1, so a refresh or Back does not open setup again.
        if (New == "1" && _newHandled) Nav.NavigateTo("/ai-operations", replace: true);
    }

    // A new agent needs a connected channel, then knowledge the business has
    // approved: "Connect a channel first", or "Teach your AI", opens before setup.
    private Task CreateAgentAsync() => AgentGate.RequireAsync(() =>
    {
        _setupOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    });

    private void OpenAgent(AiAgent agent) => Nav.NavigateTo($"/ai-operations/{agent.Id}");

    private void OpenSettings(AiAgent agent) => Nav.NavigateTo($"/ai-operations/{agent.Id}?tab=settings");

    private void CloseSetup() => _setupOpen = false;

    // Turned on: its page, which says where it is live. A draft: back here,
    // with the Drafts filter on when there are enough agents to have one.
    // A save that fails keeps setup open with everything entered, and says so.
    private async Task<string?> SaveNewAgentAsync(AiAgent agent)
    {
        AiAgent saved;
        try
        {
            saved = await AiAgentsState.CreateAsync(agent);
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            return $"We couldn't save {agent.Name}. Check your connection and try again.";
        }
        _setupOpen = false;
        if (saved.IsDraft)
        {
            _filter = AgentFilter.Draft;
            Toasts.Show($"{saved.Name} is saved as a draft. Turn it on when you're ready.");
            return null;
        }
        Nav.NavigateTo($"/ai-operations/{saved.Id}?live=1");
        return null;
    }

    private async Task ChangeStatusAsync(AiAgent agent)
    {
        if (_busyAgentId is not null) return;
        // A draft is turned on for the first time.
        var on = agent.IsDraft || !agent.IsActive;
        _busyAgentId = agent.Id;
        try
        {
            await AiAgentsState.SetLiveAsync(agent, on);
            Toasts.Show(on ? $"{agent.Name} is on." : $"{agent.Name} is off. It won't answer customers until you turn it on.");
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            Toasts.ShowError(on ? $"We couldn't turn {agent.Name} on. Try again." : $"We couldn't turn {agent.Name} off. Try again.");
        }
        finally
        {
            _busyAgentId = null;
        }
    }

    // A delete that fails leaves the dialog open, so it can be tried again.
    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is not { } agent || _busyAgentId is not null) return;
        _busyAgentId = agent.Id;
        try
        {
            await AiAgentsState.DeleteAsync(agent);
            _pendingDelete = null;
            Toasts.Show($"{agent.Name} was deleted.");
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            Toasts.ShowError($"We couldn't delete {agent.Name}. Try again.");
        }
        finally
        {
            _busyAgentId = null;
        }
    }
}
