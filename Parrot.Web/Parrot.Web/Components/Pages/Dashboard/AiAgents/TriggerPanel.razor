@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<aside class="trigger-panel" aria-label="Trigger settings" @onclick:stopPropagation="true">
    <header class="trigger-panel__head">
        <div class="trigger-panel__title">
            <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2">Trigger</Typography>
            <StatusBadge Tone="@(Playbook.TriggerPhrases.Count > 0 ? StatusTone.Success : StatusTone.Warning)"
                         Glyph="@(Playbook.TriggerPhrases.Count > 0 ? IconName.RiCheckFill : IconName.RiErrorWarningFill)">
                @(Playbook.TriggerPhrases.Count > 0 ? "Configured" : "Incomplete")
            </StatusBadge>
        </div>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" aria-label="Close panel" @onclick="() => OnClose.InvokeAsync()">
            <IconLeft><Icon Name="IconName.RiCloseFill" /></IconLeft>
        </Button>
    </header>
    <div class="trigger-panel__body">
        <div class="trigger-panel__field">
            <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline trigger-panel__label">Example phrases</Typography>
            <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="trigger-panel__hint">Type phrases your customers would say to trigger this flow</Typography>
            <div class="trigger-panel__input-row">
                <Input FloatingLabel="e.g. I want to buy food, can I order rice"
                       @bind-Value="_newPhrase"
                       @onkeydown="HandleKeyDown" />
                <Button Variant="ButtonVariant.Secondary" disabled="@string.IsNullOrWhiteSpace(_newPhrase)" @onclick="AddPhrase">Add</Button>
            </div>
            @if (Playbook.TriggerPhrases.Count == 0)
            {
                <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="trigger-panel__hint trigger-panel__hint--warn">Add at least 1 example phrase</Typography>
            }
        </div>
        @if (Playbook.TriggerPhrases.Count > 0)
        {
            <div class="trigger-panel__chips">
                @foreach (var phrase in Playbook.TriggerPhrases)
                {
                    var p = phrase;
                    <button type="button" class="trigger-panel__chip" aria-label="@($"Remove {p}")" @onclick="() => RemovePhrase(p)">
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@p</Typography>
                        <Icon Name="IconName.RiCloseFill" Size="IconSize.Inherit" />
                    </button>
                }
            </div>
        }
    </div>
</aside>

@code {
    [Parameter] public Playbook Playbook { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _newPhrase;

    private async Task AddPhrase()
    {
        var trimmed = _newPhrase?.Trim();
        if (!string.IsNullOrEmpty(trimmed) && !Playbook.TriggerPhrases.Contains(trimmed))
        {
            Playbook.TriggerPhrases.Add(trimmed);
            _newPhrase = null;
            await OnChanged.InvokeAsync();
        }
    }

    private async Task RemovePhrase(string phrase)
    {
        Playbook.TriggerPhrases.Remove(phrase);
        await OnChanged.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddPhrase();
    }
}
