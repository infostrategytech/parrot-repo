@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents
@inject IBusinessKnowledge Knowledge
@inject AuthState AuthState
@inject AiAgentsState AiAgentsState
@inject AgentGate Gate
@inject AuroraInterop Interop
@inject Parrot.Web.Components.Pages.Dashboard.TeachAi.TeachAiState TeachAi
@inject Parrot.Web.Features.Dashboard.AiAgents.IAgentCapabilities Capabilities
@inject NavigationManager Nav
@implements IDisposable

@* Setting up an agent on one screen, one question first. Nothing is chosen
   at the start: "What should it do?" is the only thing to answer (usability
   testing, 4 October: owners scan, and a job already chosen and filled in
   left them unsure what to do). It is the same page throughout: the job
   cards on the left and the live preview with its actions on the right are
   there from the start; choosing a job (or, for Build my own, naming it and
   pressing Continue) brings the rest in under the cards: name and look,
   where it answers, how it stays safe, and Advanced settings, closed.
   Nothing moves the page; the new parts fade in where they belong. A job
   sets sensible settings for that kind of agent; it never fills in a name.

   Knowledge is approved once, in Teach your AI, and shared by every agent, so
   nothing here asks for it again. An owner can have several agents, one per
   job: the jobs other agents already do are marked. *@

@* Leaving with something chosen asks first: the rail, Back, or closing the tab. *@
<NavigationLock OnBeforeInternalNavigation="OnNavigating" ConfirmExternalNavigation="@(HasProgress && !_done)" />

<main class="agent-setup" @ref="_top">
    <div class="agent-setup__page">
        <header class="agent-setup__header">
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="RequestLeaveAsync">
                <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                <ChildContent>Back to agents</ChildContent>
            </Button>
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@(Others.Count == 0 ? "Meet your first agent" : "Add an agent")</Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="agent-setup__lede">
                @(Knows ? "It already knows your business. Start by choosing its job." : "Start by choosing its job.")
            </Typography>
        </header>

        <div class="agent-setup__job">
            <AgentRolePicker Form="_form" Others="Others" Tried="_tried" OnChange="RoleChanged"
                             OnContinue="@(_revealed ? default : EventCallback.Factory.Create(this, Continue))" />
        </div>

        @if (_revealed)
        {
            <div class="agent-setup__form">
                <AgentBasics Form="_form" Others="Others" Channels="_channels" Tried="_tried" OnChange="StateHasChanged" />
                <AgentAdvanced Form="_form" Cards="_cards" OnChange="StateHasChanged" />
            </div>
        }

        <aside class="agent-setup__rail" aria-label="Agent preview and setup actions">
            <AgentPreview Form="_form" Cards="_cards" Business="@Business" />
            <footer class="agent-setup__actions">
                @if (_saveError is not null && !_confirmingActivation)
                {
                    <InlineError Message="@_saveError" OnDismiss="() => _saveError = null" />
                }
                <Typography TextStyle="TextStyle.Small12Medium" As="p" Class="agent-setup__muted">@ActionsNote</Typography>
                <div class="agent-setup__action-buttons">
                    @if (Capabilities.CanReply)
                    {
                        <Button Variant="ButtonVariant.Secondary" Busy="@(_saving && !_confirmingActivation)" disabled="@(!_revealed)" @onclick="SaveDraftAsync">Save as draft</Button>
                        <Button disabled="@(!CanTurnOn)" @onclick="ReviewTurnOn">@(_form.HasName ? $"Turn on {_form.DisplayName}" : "Turn on")</Button>
                    }
                    else
                    {
                        @* Agents can't reply yet (IAgentCapabilities), so saving it is the way on. *@
                        <Button Busy="_saving" disabled="@(!_revealed)" @onclick="SaveDraftAsync">Save as draft</Button>
                    }
                </div>
            </footer>
        </aside>
    </div>
</main>

<Dialog Open="_confirmingActivation"
        Title="@($"Turn on {_form.DisplayName}?")"
        Subtitle="One final check before it starts replying."
        Dismissible
        Busy="_saving"
        BusyLabel="Turning it on…"
        ConfirmLabel="@($"Turn on {_form.DisplayName}")"
        OnCancel="CloseActivationReview"
        OnConfirm="ConfirmTurnOnAsync">
    <Body>
        @if (_saveError is not null)
        {
            <InlineError Message="@_saveError" OnDismiss="() => _saveError = null" />
        }
        <div class="agent-setup__review">
            <div class="agent-setup__review-agent">
                <img src="@AgentBuilderCopy.MascotImage(_form.Mascot)" alt="" />
                <span>
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="strong">@_form.DisplayName</Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="span">@_form.RoleName</Typography>
                </span>
            </div>
            <ul>
                <li>
                    <span><Icon Name="IconName.RiChat3Fill" Size="IconSize.Sm" /></span>
                    <div>
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Replies on @SelectedChannelNames</Typography>
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="span">New matching conversations only.</Typography>
                    </div>
                </li>
                @if (Knows)
                {
                    <li>
                        <span class="is-knowledge"><Icon Name="IconName.RiBookOpenFill" Size="IconSize.Sm" /></span>
                        <div>
                            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Uses your approved business knowledge</Typography>
                            <Typography TextStyle="TextStyle.BodySmallMedium" As="span">If it is unsure, it will not guess.</Typography>
                        </div>
                    </li>
                }
                <li>
                    <span><Icon Name="IconName.RiUserSharedFill" Size="IconSize.Sm" /></span>
                    <div>
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Hands difficult conversations to a person</Typography>
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="span" Prose>@AgentBasics.HandoverDetail(_form.Settings)</Typography>
                    </div>
                </li>
            </ul>
        </div>
    </Body>
</Dialog>

<Dialog Open="_confirmingLeave"
        Type="DialogType.Destructive"
        Title="Leave without saving?"
        ConfirmLabel="Leave"
        CancelLabel="Keep editing"
        OnCancel="() => _confirmingLeave = false"
        OnConfirm="LeaveAsync">
    <GlyphContent><Icon Name="IconName.RiErrorWarningFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>@LeaveNote</p>
    </Body>
</Dialog>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>The new agent, turned on or saved as a draft (IsDraft), for the page to add.</summary>
    /// <summary>
    /// Saves the new agent: null when it is saved (the page moves on), or what
    /// went wrong, shown here with everything entered kept.
    /// </summary>
    [Parameter, EditorRequired] public Func<AiAgent, Task<string?>> Save { get; set; } = _ => Task.FromResult<string?>(null);

    private string? _saveError;

    private AgentForm _form = new();
    private IReadOnlyList<KnowledgeCard> _cards = [];
    private IReadOnlyList<AgentChannelChoice> _channels = [];
    private bool _tried;
    private bool _saving;
    private bool _confirmingActivation;
    private ElementReference _top;

    // The details are showing: a job was chosen, or Build my own was named and continued.
    private bool _revealed;

    private string Business => AuthState.CurrentUser?.BusinessName ?? string.Empty;

    // Every agent already set up, drafts too: their jobs, names and avatars are taken.
    private IReadOnlyList<AiAgent> Others => AiAgentsState.Agents;

    // What Teach your AI approved, which the agent answers from. With nothing
    // approved (real mode has no knowledge API yet), nothing claims it knows.
    private bool Knows => Knowledge.Available && _cards.Any(card => card.Status == KnowledgeStatus.Confirmed && card.HasContent);

    // Something chosen or typed, which leaving would lose.
    private bool HasProgress => _form.HasRole || _form.HasName;

    private bool _confirmingLeave;

    // Saved, or leaving on purpose: nothing left to ask about.
    private bool _done;

    // Where the person was going when asked (the rail, Back); null for Back to agents.
    private string? _leaveTo;

    private string LeaveNote =>
        !_revealed ? "What you've chosen here isn't saved."
        : _form.HasName ? $"{_form.DisplayName} isn't saved yet. To keep it, stay and save it as a draft."
        : "This agent isn't saved yet. To keep it, stay and save it as a draft.";

    private async Task RequestLeaveAsync()
    {
        if (!HasProgress) { await OnCancel.InvokeAsync(); return; }
        _leaveTo = null;
        _confirmingLeave = true;
    }

    private void OnNavigating(LocationChangingContext context)
    {
        if (!HasProgress || _done) return;
        context.PreventNavigation();
        _leaveTo = context.TargetLocation;
        _confirmingLeave = true;
    }

    private async Task LeaveAsync()
    {
        _confirmingLeave = false;
        _done = true;
        if (_leaveTo is { } to) Nav.NavigateTo(to);
        else await OnCancel.InvokeAsync();
    }

    private bool CanTurnOn => _revealed && _form.HasRole && _form.HasRoleName && _form.HasName && _form.Channels.Count > 0 && !_saving;

    private string ActionsNote =>
        !_form.HasRole ? "Choose its job to begin."
        : !_revealed ? "Name its job, then continue."
        : !Capabilities.CanReply
            ? !_form.HasRoleName ? "Name its job to save it."
            : !_form.HasName ? "Give it a name to save it."
            : "Save it as a draft. You'll be able to turn it on once agents can reply to customers."
        : !_form.HasRoleName ? "Name its job to turn it on."
        : !_form.HasName ? "Give it a name to turn it on."
        : _channels.Count == 0 ? "Connect a channel before turning it on."
        : _form.Channels.Count == 0 ? "Choose at least one connected channel."
        : "You can change any of this later, on its page.";

    private string SelectedChannelNames
    {
        get
        {
            var names = _channels.Where(channel => _form.Channels.Contains(channel.Key)).Select(channel => channel.Name).ToList();
            return names.Count switch
            {
                0 => "no channels",
                1 => names[0],
                2 => $"{names[0]} and {names[1]}",
                _ => $"{string.Join(", ", names[..^1])} and {names[^1]}"
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TeachAi.Changed += KnowledgeChanged;
        // Read fresh, not from whatever the Channels page last loaded.
        _channels = await Gate.ConnectedAsync();
        _form = AgentForm.Suggested(Others, _channels.Select(channel => channel.Key));
        _cards = await Knowledge.GetDraftAsync();
        // Who takes over comes from Teach your AI; the owner can change it for this agent.
        if (_cards.FirstOrDefault(c => c.Topic == KnowledgeTopic.Handover) is { Status: KnowledgeStatus.Confirmed, Text.Length: > 0 } handover)
            _form.Settings.HandoverTo = handover.Text;
    }

    // Opened from further down the agents page: start at the top.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Interop.ScrollIntoViewAsync(_top);
    }

    // A set job shows the rest straight away; Build my own waits for Continue.
    private void RoleChanged()
    {
        if (_form.HasRole && _form.Settings.Role != AgentRoleTemplate.Custom) _revealed = true;
    }

    private void Continue()
    {
        if (_form.HasRoleName) _revealed = true;
    }

// "Teach more" closed: read the knowledge again, so the preview answers
    // from what was just taught.
    private void KnowledgeChanged() => _ = InvokeAsync(async () =>
    {
        if (TeachAi.IsOpen) return;
        _cards = await Knowledge.GetDraftAsync();
        StateHasChanged();
    });

    public void Dispose() => TeachAi.Changed -= KnowledgeChanged;

    private void ReviewTurnOn()
    {
        _tried = true;
        if (!CanTurnOn) return;
        _confirmingActivation = true;
    }

    private void CloseActivationReview() => _confirmingActivation = false;

    // Stays open if the save fails, with the reason at the top.
    private async Task ConfirmTurnOnAsync()
    {
        if (await SaveAsync(live: true)) _confirmingActivation = false;
    }

    private Task SaveDraftAsync() => SaveAsync(live: false);

    private async Task<bool> SaveAsync(bool live)
    {
        _tried = true;
        if (!_form.HasRole || !_form.HasRoleName || !_form.HasName || (live && _form.Channels.Count == 0) || _saving) return false;
        _saving = true;
        _saveError = null;
        // The page moves on once it is saved, which is not leaving it unsaved.
        _done = true;
        var error = await Save(_form.ToAgent(live));
        _saving = false;
        _saveError = error;
        if (error is not null) _done = false;
        return error is null;
    }
}
