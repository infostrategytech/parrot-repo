@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<label class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Question text</Typography>
    <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
              rows="4"
              placeholder="e.g. what would you like to order"
              value="@Step.QuestionText"
              @oninput="async e => { Step.QuestionText = e.Value?.ToString() ?? string.Empty; await OnChanged.InvokeAsync(); }"></textarea>
</label>

<SelectField FloatingLabel="Response type"
             Value="@ResponseTypeLabel(Step.ResponseType)"
             Open='@(_open == "response")'
             OpenChanged='@(open => _open = open ? "response" : null)'>
    @foreach (var option in ResponseTypes)
    {
        var current = option;
        <PopoverOption Label="@current.Label"
                       Description="@current.Description"
                       Active="@(Step.ResponseType == current.Id)"
                       OnSelect="async () => { Step.ResponseType = current.Id; _open = null; await OnChanged.InvokeAsync(); }" />
    }
</SelectField>

<Input FloatingLabel="Save as"
       HelperText="This name is used to reference this data in later steps"
       Value="@Step.SaveAs"
       ValueChanged="value => Step.SaveAs = value ?? string.Empty" />

<div class="step-row">
    <div class="step-row-text">
        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Required</Typography>
        <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>Customer must answer before moving forward</Typography>
    </div>
    <Toggle AriaLabel="Required" Checked="Step.Required" CheckedChanged="value => Step.Required = value" />
</div>

<div class="step-divider"></div>

@if (Step.ResponseType == "Text")
{
    <Input FloatingLabel="Placeholder"
           HelperText="Hint text shown to customer"
           Value="@Step.Placeholder"
           ValueChanged="value => Step.Placeholder = value ?? string.Empty" />
    <SelectField FloatingLabel="Character limit"
                 Value="@Step.CharacterLimit.ToString()"
                 Open='@(_open == "limit")'
                 OpenChanged='@(open => _open = open ? "limit" : null)'>
        @foreach (var limit in new[] { 1, 50, 100, 200, 500 })
        {
            var current = limit;
            <PopoverOption Label="@current.ToString()" Active="@(Step.CharacterLimit == current)" OnSelect="() => { Step.CharacterLimit = current; _open = null; }" />
        }
    </SelectField>
}

@if (Step.ResponseType == "Quantity")
{
    <div class="step-two-col">
        <SelectField FloatingLabel="Minimum value"
                     Value="@Step.MinValue.ToString()"
                     Open='@(_open == "min")'
                     OpenChanged='@(open => _open = open ? "min" : null)'>
            @foreach (var v in new[] { 1, 2, 5, 10 })
            {
                var current = v;
                <PopoverOption Label="@current.ToString()" Active="@(Step.MinValue == current)" OnSelect="() => { Step.MinValue = current; _open = null; }" />
            }
        </SelectField>
        <SelectField FloatingLabel="Maximum value"
                     Value="@Step.MaxValue.ToString()"
                     Open='@(_open == "max")'
                     OpenChanged='@(open => _open = open ? "max" : null)'>
            @foreach (var v in new[] { 100, 500, 1000, 5000 })
            {
                var current = v;
                <PopoverOption Label="@current.ToString()" Active="@(Step.MaxValue == current)" OnSelect="() => { Step.MaxValue = current; _open = null; }" />
            }
        </SelectField>
    </div>
}

@if (Step.ResponseType == "Amount")
{
    <div class="step-two-col">
        <SelectField FloatingLabel="Currency"
                     Value="@Step.Currency"
                     Open='@(_open == "currency")'
                     OpenChanged='@(open => _open = open ? "currency" : null)'>
            @foreach (var code in new[] { "USD", "EUR", "GBP", "NGN" })
            {
                var current = code;
                <PopoverOption Label="@current" Active="@(Step.Currency == current)" OnSelect="() => { Step.Currency = current; _open = null; }" />
            }
        </SelectField>
        <Input FloatingLabel="Minimum amount"
               type="number"
               min="0"
               Value="@Step.MinAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               ValueChanged="value => Step.MinAmount = decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0" />
    </div>
}

@if (Step.ResponseType is "SingleChoice" or "MultipleChoice")
{
    <div class="step-field">
        <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Options <em>(Min 2)</em></Typography>
        <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="step-hint">
            @(Step.ResponseType == "SingleChoice"
                ? "Add the options customers can choose from. Each option can lead to a different next step in the flow."
                : "Add the options customers can select. Customers can choose more than one option.")
        </Typography>
        @foreach (var opt in Step.Options)
        {
            var option = opt;
            var optIdx = Step.Options.IndexOf(opt) + 1;
            <div class="step-block">
                <div class="step-block-head">
                    <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Option @optIdx</Typography>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="step-block-remove" aria-label="@($"Remove option {optIdx}")" @onclick="() => Step.Options.Remove(option)">
                        <IconLeft><Icon Name="IconName.RiDeleteBin6Fill" /></IconLeft>
                    </Button>
                </div>
                <Input FloatingLabel="Name"
                       Value="@option.Name"
                       ValueChanged="value => option.Name = value ?? string.Empty" />
                @if (Step.ResponseType == "SingleChoice")
                {
                    <SelectField FloatingLabel="Next action"
                                 Value="@NextActionLabel(option.NextAction)"
                                 Open='@(_open == $"next-{option.Id}")'
                                 OpenChanged='@(open => _open = open ? $"next-{option.Id}" : null)'>
                        <PopoverOption Label="Continue to next step" Active='@(option.NextAction == "continue")' OnSelect='() => { option.NextAction = "continue"; _open = null; }' />
                        <PopoverOption Label="Go to another step" Active='@(option.NextAction == "goto")' OnSelect='() => { option.NextAction = "goto"; _open = null; }' />
                        <PopoverOption Label="End flow" Active='@(option.NextAction == "end")' OnSelect='() => { option.NextAction = "end"; _open = null; }' />
                    </SelectField>
                    @if (option.NextAction == "goto")
                    {
                        <SelectField FloatingLabel="Target step"
                                     Value="@TargetStepLabel(option.TargetStep)"
                                     Open='@(_open == $"target-{option.Id}")'
                                     OpenChanged='@(open => _open = open ? $"target-{option.Id}" : null)'>
                            @foreach (var s in Playbook.Steps.Where(s => s.Id != SelectedStepId))
                            {
                                var target = s;
                                <PopoverOption Label="@(string.IsNullOrWhiteSpace(target.QuestionText) ? PlaybookCanvas.Kind(target.Type).Label : target.QuestionText)"
                                               Description="@PlaybookCanvas.Kind(target.Type).Subtype"
                                               Active="@(option.TargetStep == target.Id)"
                                               OnSelect="() => { option.TargetStep = target.Id; _open = null; }" />
                            }
                        </SelectField>
                    }
                }
            </div>
        }
        <Button Variant="ButtonVariant.Secondary" @onclick="() => Step.Options.Add(new StepOption())">
            <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
            <ChildContent>Add option</ChildContent>
        </Button>
    </div>
}

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public Playbook Playbook { get; set; } = default!;
    [Parameter] public string SelectedStepId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _open;

    private sealed record ResponseType(string Id, string Label, string Description);

    private static readonly ResponseType[] ResponseTypes =
    [
        new("Text", "Text", "Free-form text response"),
        new("Quantity", "Quantity", "Numeric value"),
        new("Amount", "Amount", "Currency amount"),
        new("Date", "Date", "Date picker"),
        new("Time", "Time", "Time picker"),
        new("SingleChoice", "Single choice", "Pick one option"),
        new("MultipleChoice", "Multiple choice", "Pick multiple options")
    ];

    private static string ResponseTypeLabel(string id) => ResponseTypes.FirstOrDefault(t => t.Id == id)?.Label ?? string.Empty;

    private static string NextActionLabel(string id) => id switch
    {
        "continue" => "Continue to next step",
        "goto" => "Go to another step",
        "end" => "End flow",
        _ => string.Empty
    };

    private string TargetStepLabel(string id)
    {
        var target = Playbook.Steps.FirstOrDefault(s => s.Id == id);
        if (target is null) return string.Empty;
        return string.IsNullOrWhiteSpace(target.QuestionText) ? PlaybookCanvas.Kind(target.Type).Label : target.QuestionText;
    }
}
