@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<div class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Wait duration</Typography>
    <div class="step-two-col">
        <SelectField FloatingLabel="Duration"
                     Value="@Step.WaitDuration"
                     Open='@(_open == "duration")'
                     OpenChanged='@(open => _open = open ? "duration" : null)'>
            @foreach (var n in new[] { "1", "2", "3", "5", "10", "15", "30", "60" })
            {
                var current = n;
                <PopoverOption Label="@current" Active="@(Step.WaitDuration == current)"
                               OnSelect="async () => { Step.WaitDuration = current; _open = null; await OnChanged.InvokeAsync(); }" />
            }
        </SelectField>
        <SelectField FloatingLabel="Unit"
                     Value="@Step.WaitUnit"
                     Open='@(_open == "unit")'
                     OpenChanged='@(open => _open = open ? "unit" : null)'>
            @foreach (var unit in new[] { "Minutes", "Hours", "Days" })
            {
                var current = unit;
                <PopoverOption Label="@current" Active="@(Step.WaitUnit == current)" OnSelect="() => { Step.WaitUnit = current; _open = null; }" />
            }
        </SelectField>
    </div>
    <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="step-hint">The process will pause for this duration before continuing</Typography>
</div>

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _open;
}
