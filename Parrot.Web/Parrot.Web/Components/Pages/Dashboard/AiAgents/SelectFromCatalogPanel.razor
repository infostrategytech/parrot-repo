@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<div class="step-field">
    <div class="step-row">
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline step-label">Select catalog items</Typography>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="SelectAll">Select all</Button>
    </div>
    <Input FloatingLabel="Search items"
           @bind-Value="_catalogSearch"
           IconLeft="SearchGlyph"
           type="search" />
    <div class="step-catalog-list" role="group" aria-label="Catalog items">
        @foreach (var item in GetFilteredItems())
        {
            var itemName = item;
            var isChecked = Step.SelectedCatalogItems.Contains(itemName);
            <Checkbox Label="@itemName"
                      State="@(isChecked ? CheckboxState.Checked : CheckboxState.Unchecked)"
                      StateChanged="async state => { ToggleItem(itemName, state == CheckboxState.Checked); await OnChanged.InvokeAsync(); }" />
        }
    </div>
</div>

@if (Step.SelectedCatalogItems.Count > 0)
{
    <div class="step-chips">
        @foreach (var tag in Step.SelectedCatalogItems.ToList())
        {
            var tagName = tag;
            <button type="button" class="step-chip" aria-label="@($"Remove {tagName}")"
                    @onclick="async () => { Step.SelectedCatalogItems.Remove(tagName); await OnChanged.InvokeAsync(); }">
                <Typography TextStyle="TextStyle.Small12Medium" As="span">@tagName</Typography>
                <Icon Name="IconName.RiCloseFill" Size="IconSize.Inherit" />
            </button>
        }
    </div>
}

<div class="step-divider"></div>

<div class="step-row">
    <div class="step-row-text">
        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Allow multiple</Typography>
        <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>Customer can select more than one item</Typography>
    </div>
    <Toggle AriaLabel="Allow multiple" Checked="Step.AllowMultiple" CheckedChanged="value => Step.AllowMultiple = value" />
</div>

<div class="step-row">
    <div class="step-row-text">
        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Quantity selector</Typography>
        <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose>Show quantity input for each item</Typography>
    </div>
    <Toggle AriaLabel="Quantity selector" Checked="Step.QuantitySelector" CheckedChanged="value => Step.QuantitySelector = value" />
</div>

@if (Step.QuantitySelector)
{
    <div class="step-two-col">
        <SelectField FloatingLabel="Min quantity"
                     Value="@Step.MinQuantity.ToString()"
                     Open='@(_open == "min")'
                     OpenChanged='@(open => _open = open ? "min" : null)'>
            @foreach (var v in new[] { 1, 2, 3, 5, 10 })
            {
                var current = v;
                <PopoverOption Label="@current.ToString()" Active="@(Step.MinQuantity == current)" OnSelect="() => { Step.MinQuantity = current; _open = null; }" />
            }
        </SelectField>
        <SelectField FloatingLabel="Max quantity"
                     Value="@Step.MaxQuantity.ToString()"
                     Open='@(_open == "max")'
                     OpenChanged='@(open => _open = open ? "max" : null)'>
            @foreach (var v in new[] { 5, 10, 20, 50, 100 })
            {
                var current = v;
                <PopoverOption Label="@current.ToString()" Active="@(Step.MaxQuantity == current)" OnSelect="() => { Step.MaxQuantity = current; _open = null; }" />
            }
        </SelectField>
    </div>
}

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly RenderFragment SearchGlyph = @<Icon Name="IconName.RiSearch2Fill" Size="IconSize.Sm" />;

    private string? _catalogSearch;
    private string? _open;

    private static readonly List<string> CatalogItems = new()
    {
        "Rice", "Chicken", "Plantain", "Fried Yam", "Spaghetti", "Coca Cola"
    };

    private List<string> GetFilteredItems()
    {
        if (string.IsNullOrEmpty(_catalogSearch)) return CatalogItems;
        return CatalogItems.Where(i => i.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ToggleItem(string item, bool add)
    {
        if (add && !Step.SelectedCatalogItems.Contains(item))
            Step.SelectedCatalogItems.Add(item);
        else if (!add)
            Step.SelectedCatalogItems.Remove(item);
    }

    private async Task SelectAll()
    {
        foreach (var item in CatalogItems.Where(i => !Step.SelectedCatalogItems.Contains(i)))
            Step.SelectedCatalogItems.Add(item);
        await OnChanged.InvokeAsync();
    }
}
