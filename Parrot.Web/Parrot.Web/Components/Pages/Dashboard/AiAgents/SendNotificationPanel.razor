@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<Input FloatingLabel="Notification name"
       HelperText="For internal reference only"
       Value="@Step.NotificationName"
       ValueChanged="value => Step.NotificationName = value ?? string.Empty" />

<div class="step-field">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Message content</Typography>
    <div class="step-editor">
        <div class="step-toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" class="step-tool" title="Bold" aria-label="Bold"><Typography TextStyle="TextStyle.Small12Bold" As="span">B</Typography></button>
            <button type="button" class="step-tool step-tool--italic" title="Italic" aria-label="Italic"><Typography TextStyle="TextStyle.Small12Medium" As="span">I</Typography></button>
            <button type="button" class="step-tool step-tool--underline" title="Underline" aria-label="Underline"><Typography TextStyle="TextStyle.Small12Medium" As="span">U</Typography></button>
            <button type="button" class="step-tool step-tool--strike" title="Strikethrough" aria-label="Strikethrough"><Typography TextStyle="TextStyle.Small12Medium" As="span">S</Typography></button>
            <button type="button" class="step-tool" title="Link" aria-label="Link"><Icon Name="IconName.RiLinksFill" Size="IconSize.Sm" /></button>
        </div>
        <textarea class="@TextStyle.BodySmallRegular.ToClassName(prose: true)"
                  rows="5"
                  placeholder="Type your message here..."
                  aria-label="Message content"
                  value="@Step.MessageContent"
                  @oninput="e => Step.MessageContent = e.Value?.ToString() ?? string.Empty"></textarea>
    </div>
</div>

<div class="step-data">
    <Typography TextStyle="TextStyle.Small12Medium" As="span" Class="step-label">Insert dynamic data</Typography>
    <div class="step-data-group">
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Collected information</Typography>
        <div class="step-chips">
            @foreach (var chip in new[] { "Customer Name", "Quantity", "Customer Order", "Delivery Address" })
            {
                var chipVal = chip;
                <button type="button" class="step-data-chip" @onclick="() => InsertData(chipVal)">
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">@chipVal</Typography>
                </button>
            }
        </div>
    </div>
    <div class="step-data-group">
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">System fields</Typography>
        <div class="step-chips">
            @foreach (var chip in new[] { "Reference Number", "Current Date", "Current Time", "Order Counter" })
            {
                var chipVal = chip;
                <button type="button" class="step-data-chip" @onclick="() => InsertData(chipVal)">
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">@chipVal</Typography>
                </button>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Step.MessageContent))
{
    <div class="step-preview">
        <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="ds-overline">Preview message</Typography>
        <div class="step-preview-bubble">
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose>@Step.MessageContent</Typography>
        </div>
    </div>
}

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private void InsertData(string field) => Step.MessageContent += $" {{{field}}}";
}
