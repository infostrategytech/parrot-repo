@namespace Parrot.Web.Components.Pages.Dashboard.AiAgents

<SelectField FloatingLabel="Stage"
             Value="@StageLabel(Step.ContactStage)"
             Open='@(_open == "stage")'
             OpenChanged='@(open => _open = open ? "stage" : null)'>
    @foreach (var stage in Stages)
    {
        var current = stage;
        <PopoverOption Label="@current.Label" Active="@(Step.ContactStage == current.Id)"
                       OnSelect="async () => { Step.ContactStage = current.Id; _open = null; await OnChanged.InvokeAsync(); }" />
    }
</SelectField>

<SelectField FloatingLabel="Tags"
             Value="@TagLabel(Step.ContactTags)"
             Open='@(_open == "tags")'
             OpenChanged='@(open => _open = open ? "tags" : null)'>
    @foreach (var tag in Tags)
    {
        var current = tag;
        <PopoverOption Label="@current.Label" Active="@(Step.ContactTags == current.Id)"
                       OnSelect="() => { Step.ContactTags = current.Id; _open = null; }" />
    }
</SelectField>

@code {
    [Parameter] public PlaybookStep Step { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _open;

    private sealed record Choice(string Id, string Label);

    private static readonly Choice[] Stages =
    [
        new("NewLead", "New lead"),
        new("Interested", "Interested"),
        new("Customer", "Customer"),
        new("VIP", "VIP")
    ];

    private static readonly Choice[] Tags =
    [
        new("VIP", "VIP"),
        new("Returning", "Returning"),
        new("FrequentBuyer", "Frequent buyer")
    ];

    private static string StageLabel(string id) => Stages.FirstOrDefault(s => s.Id == id)?.Label ?? string.Empty;
    private static string TagLabel(string id) => Tags.FirstOrDefault(t => t.Id == id)?.Label ?? string.Empty;
}
