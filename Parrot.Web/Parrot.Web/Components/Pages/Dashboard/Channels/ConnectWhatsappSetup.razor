@page "/dashboard/channels/connect-whatsapp"
@layout DashboardLayout
@implements IDisposable
@inject NavigationManager Nav
@inject IIntegrationsService IntegrationsService
@inject AuthState AuthState
@inject IJSRuntime JS

<div class="cws-page">
    <a class="cws-cancel-link" href="/dashboard/channels">← Back to channels</a>
    <div class="cws-stepper" aria-label="WhatsApp setup progress">
        <div class="cws-step @(_currentStep == 0 ? "cws-step--active" : "cws-step--done")">
            <span class="cws-step-indicator">1</span><span class="cws-step-label">Configure Webhook</span>
        </div>
        <div class="cws-step-divider"></div>
        <div class="cws-step @(_currentStep == 1 ? "cws-step--active" : "")">
            <span class="cws-step-indicator">2</span><span class="cws-step-label">Receive Message</span>
        </div>
        <div class="cws-step-divider"></div>
        <div class="cws-step @(IsReceiving ? "cws-step--done" : "")"><span class="cws-step-indicator">3</span><span class="cws-step-label">Finish</span></div>
    </div>

    <div class="cws-body">
        <section class="cws-panel" aria-busy="@_busy">
            @if (_currentStep == 0)
            {
                <h1 class="cws-panel-title">Configure Webhook</h1>
                <p class="cws-panel-sub">Copy your callback URL and verify token into Meta. Your connection is saved automatically, so you can leave and continue later.</p>
                @if (!AuthState.IsAuthenticated)
                {
                    <p class="cws-panel-sub">Sign in to load your saved connections.</p>
                    <a class="cws-portal-link" href="/login">Sign in</a>
                }
                else if (_setup is null)
                {
                    <p class="cws-panel-sub">@(_busy ? "Preparing your saved connection…" : "Your connection could not be loaded.")</p>
                    <button class="cws-copy-btn" @onclick="LoadAsync" disabled="@_busy">Try again</button>
                }
                else
                {
                    <p class="cws-panel-sub">Connection: <strong>@_setup.Connection.Name</strong></p>
                    <label class="cws-field-label" for="business-account-id">WhatsApp Business Account ID</label>
                    <input id="business-account-id" class="cws-input" @bind="_businessAccountId" maxlength="64" inputmode="numeric" disabled="@IsReceiving" />
                    <label class="cws-field-label" for="phone-number-id">Phone Number ID</label>
                    <input id="phone-number-id" class="cws-input" @bind="_phoneNumberId" maxlength="64" inputmode="numeric" disabled="@IsReceiving" />
                    <p class="cws-token-helper">Copy these IDs from Meta's WhatsApp API Setup page. The Phone Number ID is different from the displayed phone number.</p>
                    @if (!IsReceiving)
                    {
                        <button class="cws-copy-btn" @onclick="SaveAccountAsync" disabled="@_busy">Save account details</button>
                    }
                    <label class="cws-field-label" for="webhook-url">Your webhook URL</label>
                    <div class="cws-copy-row">
                        <input id="webhook-url" class="cws-input" readonly value="@_setup.WebhookUrl" />
                        <button class="cws-copy-btn" @onclick="() => CopyAsync(_setup.WebhookUrl, false)">Copy URL</button>
                    </div>
                    <label class="cws-field-label" for="verify-token">Verify token</label>
                    <div class="cws-copy-row">
                        <input id="verify-token" class="cws-input" readonly value="@_setup.VerifyToken" spellcheck="false" />
                        <button class="cws-copy-btn" @onclick="() => CopyAsync(_setup.VerifyToken, true)">Copy token</button>
                    </div>
                    <p class="cws-token-helper">Use these exact values in Meta. They stay the same when you resume setup.</p>
                    <div class="cws-info-box" role="status">
                        @if (_setup.Connection.DisabledAt.HasValue)
                        {
                            <span>This connection is disabled. Contact support to continue.</span>
                        }
                        else if (IsVerified)
                        {
                            <span>Webhook verified. Your verification request was received successfully.</span>
                        }
                        else
                        {
                            <span>Awaiting verification. Click Verify and save in Meta, then check the status here.</span>
                        }
                    </div>
                    <div class="cws-actions">
                        <button class="cws-copy-btn" @onclick="CheckStatusAsync" disabled="@_busy">Check verification</button>
                        <button class="cws-primary-btn" @onclick="Continue" disabled="@(_busy || !IsVerified || !HasAccount)">Next →</button>
                    </div>
                }
            }
            else
            {
                <h1 class="cws-panel-title">@(IsReceiving ? "Receiving configured" : "Receive a test message")</h1>
                <p class="cws-panel-sub">@(IsReceiving ? "A valid WhatsApp message has been saved for this connection." : "Subscribe to the messages field in Meta, then send a WhatsApp message to your business number from another phone.")</p>
                <div class="cws-info-box" role="status">@(IsReceiving ? "Incoming messages are configured. Sending messages requires separate authorization." : "Waiting for a verified incoming message to be saved. You can leave and resume later.")</div>
                <div class="cws-actions">
                    <button class="cws-copy-btn" @onclick="() => _currentStep = 0">Back</button>
                    <button class="cws-copy-btn" @onclick="CheckStatusAsync" disabled="@_busy">Check for message</button>
                    <a class="cws-primary-btn" href="/dashboard/channels">@(IsReceiving ? "Finish" : "Save and exit")</a>
                </div>
            }
            @if (_busy)
            {
                <p class="cws-panel-sub" role="status">Loading…</p>
            }
            @if (_error is not null)
            {
                <p class="cws-error-text" role="alert">@_error</p>
            }
            @if (_notice is not null)
            {
                <p class="cws-panel-sub" role="status">@_notice</p>
            }
        </section>
        <aside class="cws-guide-panel">
            <h2 class="cws-guide-title">Configure your webhook in Meta</h2>
            <ol class="cws-setup-guide">
                <li>Open your app in Meta Developer Portal and go to WhatsApp → Configuration.</li>
                <li>Edit the webhook and paste your webhook URL into Callback URL.</li>
                <li>Paste the generated token into Verify token.</li>
                <li>Click <strong>Verify and save</strong>, then return here and click <strong>Check verification</strong>.</li>
                <li>Subscribe to the <strong>messages</strong> field for message notifications.</li>
            </ol>
            <a href="https://developers.facebook.com" target="_blank" rel="noopener noreferrer" class="cws-portal-link">Open Meta Developer Portal ↗</a>
        </aside>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private WhatsAppSetup? _setup;
    private string? _error, _notice;
    private bool _busy, _interactive, _disposed;
    private int _currentStep;
    private string _businessAccountId = string.Empty, _phoneNumberId = string.Empty;
    private bool IsReceiving => IsVerified && _setup?.Connection.FirstMessageReceivedAt is not null;
    private bool HasAccount => !string.IsNullOrEmpty(_setup?.Connection.WhatsAppBusinessAccountId) && !string.IsNullOrEmpty(_setup?.Connection.PhoneNumberId);
    private bool IsVerified => _setup?.Connection.WebhookVerifiedAt is not null && _setup.Connection.DisabledAt is null;
    private string Token => AuthState.CurrentUser?.Token ?? throw new InvalidOperationException("Sign in to continue.");

    protected override void OnInitialized() => AuthState.OnChange += AuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        await LoadAsync();
        if (!_disposed) StateHasChanged();
    }

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        _setup = null;
        _currentStep = 0;
        if (_interactive) await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        if (_busy || !AuthState.IsAuthenticated || _disposed) return;
        await RunAsync(async () =>
        {
            _setup = await IntegrationsService.CreateWhatsAppSetupAsync("WhatsApp Business", Token, _lifetime.Token);
            _businessAccountId = _setup.Connection.WhatsAppBusinessAccountId ?? string.Empty;
            _phoneNumberId = _setup.Connection.PhoneNumberId ?? string.Empty;
            if (IsReceiving) _currentStep = 1;
        }, "Could not load your connection. Try again to continue with the same saved connection.");
    }

    private async Task CheckStatusAsync()
    {
        if (_setup is null) return;
        await RunAsync(async () =>
        {
            var connection = await IntegrationsService.GetWhatsAppStatusAsync(_setup.Connection.Id, Token, _lifetime.Token);
            _setup = _setup with { Connection = connection };
            _notice = IsReceiving ? "Message saved. Receiving is configured."
                : IsVerified ? "Webhook verified. Waiting for a test message to be saved."
                : "Verification has not been confirmed. Complete Verify and save in Meta, then check again.";
        }, "Could not check verification. Please try again.");
    }

    private void Continue()
    {
        if (IsVerified && HasAccount && !_busy) { _currentStep = 1; _notice = null; }
    }

    private async Task SaveAccountAsync()
    {
        if (_setup is null) return;
        if (string.IsNullOrWhiteSpace(_businessAccountId) || string.IsNullOrWhiteSpace(_phoneNumberId)
            || !_businessAccountId.All(char.IsAsciiDigit) || !_phoneNumberId.All(char.IsAsciiDigit))
        {
            _error = "Enter the numeric Business Account ID and Phone Number ID from Meta.";
            return;
        }
        await RunAsync(async () =>
        {
            await IntegrationsService.ConfigureWhatsAppAccountAsync(_setup.Connection.Id, _businessAccountId, _phoneNumberId, Token, _lifetime.Token);
            _setup = _setup with { Connection = await IntegrationsService.GetWhatsAppStatusAsync(_setup.Connection.Id, Token, _lifetime.Token) };
            _notice = "Account details saved.";
        }, "Could not save account details. Check the IDs and try again.");
    }

    private async Task RunAsync(Func<Task> action, string failureMessage)
    {
        if (_busy || _disposed) return;
        _busy = true;
        _error = _notice = null;
        try { await action(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (OperationCanceledException) { _error = "The request timed out. Try again to load your saved connection."; }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Sign in again to continue.",
                System.Net.HttpStatusCode.Conflict => "Your connection is unavailable. Contact support to continue.",
                _ => failureMessage,
            };
        }
        catch (System.Text.Json.JsonException) { _error = failureMessage; }
        catch (InvalidOperationException) { _error = "Sign in to continue."; }
        finally { _busy = false; }
    }

    private async Task CopyAsync(string value, bool isToken)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            _notice = isToken ? "Verify token copied." : "Webhook URL copied.";
            _error = null;
        }
        catch (JSException) { _error = "Clipboard access is unavailable. Select the field and copy it manually."; }
    }

    public void Dispose()
    {
        _disposed = true;
        AuthState.OnChange -= AuthChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
