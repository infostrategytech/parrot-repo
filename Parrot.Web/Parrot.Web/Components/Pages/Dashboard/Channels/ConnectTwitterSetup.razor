@page "/dashboard/channels/connect-x"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Channels
@using Parrot.Web.Features.Dashboard.Channels.Models
@inject ChannelsState ChannelsState
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Connect X · OmniAI</PageTitle>

@* Parrot's X setup. It has no backend yet — the three steps are the same
   state-only walk they always were — drawn as Aurora's guided card, with
   Aurora's stand-in for the provider window where the old page showed a
   "redirecting" overlay, and Aurora's success screen at the end. *@

<div class="channels channels--setup">
    @if (_done)
    {
        <ConnectionSuccess Channel="Channel"
                           OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                           OnConnectAnother="Back">
            <Lede>Your channel is now active and ready to receive customer messages.</Lede>
        </ConnectionSuccess>
    }
    else
    {
        <section class="guided">
            <header class="guided__header">
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="GuidedBack">
                    <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                    <ChildContent>@(_step == 0 ? "Cancel" : "Back")</ChildContent>
                </Button>
                <div class="guided__counter">
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">X setup</Typography>
                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Step @(_step + 1) of @Steps.Length</Typography>
                </div>
            </header>

            <div class="guided__progress" role="progressbar" aria-valuenow="@(_step + 1)" aria-valuemin="1" aria-valuemax="@Steps.Length">
                <i style="width: @Percent%"></i>
            </div>

            <div class="guided__body">
                <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@Steps[_step]</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">@Ledes[_step]</Typography>

                @if (_step == 0 && _xConnected)
                {
                    <ul class="guided__requirements">
                        <li>
                            @* The sprite has no X glyph, so this row keeps Parrot's own mark. *@
                            <svg class="guided__x" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                            <span class="guided__requirement-copy">
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong" Prose>&#64;chiomaskitchen</Typography>
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="small" Prose>Permissions: Read messages · Send messages</Typography>
                            </span>
                        </li>
                    </ul>
                }
                else if (_step == 0)
                {
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        Click the button below to open X's authorization page. We'll request
                        permission to read and send direct messages.
                    </Typography>
                }

                <ol class="guided__instructions">
                    @foreach (var (instruction, number) in Numbered(Checks[_step]))
                    {
                        <li>
                            <Typography TextStyle="TextStyle.Small12Bold" As="span" Class="guided__marker">@number</Typography>
                            <div class="guided__instruction">
                                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@instruction</Typography>
                            </div>
                        </li>
                    }
                </ol>
            </div>

            <footer class="guided__footer">
                <Button Variant="ButtonVariant.Secondary" @onclick="Back">Save and exit</Button>

                @if (_step == 0 && !_xConnected)
                {
                    <Button @onclick="() => _showProvider = true">
                        <ChildContent>Continue with X</ChildContent>
                        <IconRight><Icon Name="IconName.RiExternalLinkLine" /></IconRight>
                    </Button>
                }
                else if (_step == 0)
                {
                    <Button @onclick="Step1Next">
                        <ChildContent>Next</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                }
                else if (_step == 1)
                {
                    <Button @onclick="Step2Next">
                        <ChildContent>Next</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                }
                else
                {
                    <Button Busy="@_step3Loading" @onclick="FinalConnect">
                        <ChildContent>Connect</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                }
            </footer>
        </section>
    }
</div>

@if (_showProvider)
{
    <ProviderPopup Channel="Channel"
                   OnCancel="() => _showProvider = false"
                   OnComplete="AuthorizeWithX" />
}

@code {
    private static readonly string[] Steps = ["Authorize App", "Confirm Incoming Messages", "Confirm Outgoing Messages"];

    private static readonly string[] Ledes =
    [
        "Connect your X account to authorize access.",
        "Send a direct message to your account to verify we can receive messages.",
        "We'll send a test message to verify outbound messaging works."
    ];

    private static readonly string[][] Checks =
    [
        [
            "You'll be redirected to X to grant access",
            "Make sure you're logged into the correct account",
            "Both read and write permissions are required"
        ],
        [
            "Send a DM to your account from another account",
            "Make sure your DMs are open to everyone",
            "Wait a few seconds before checking"
        ],
        [
            "A test message will be sent from your account",
            "The message may take a few seconds to deliver",
            "Check your DMs if it doesn't appear immediately"
        ]
    ];

    private int _step;
    private bool _xConnected;
    private bool _showProvider;
    private bool _step3Loading;
    private bool _done;

    private BusinessChannel Channel =>
        ChannelsState.Workspace.Channels.First(c => c.Id == ChannelId.X);

    private int Percent => (int)Math.Round((_step + 1) / (double)Steps.Length * 100);

    private static IEnumerable<(string, int)> Numbered(IEnumerable<string> items) =>
        items.Select((item, index) => (item, index + 1));

    private void AuthorizeWithX()
    {
        _showProvider = false;
        _xConnected = true;
    }

    private void Step1Next()
    {
        _step = 1;
        Toasts.Show("Incoming message detected successfully");
    }

    private void Step2Next()
    {
        _step = 2;
        Toasts.Show("Outbound messaging confirmed reply delivered successfully");
    }

    private async Task FinalConnect()
    {
        _step3Loading = true;
        StateHasChanged();
        await Task.Delay(2000);
        _step3Loading = false;
        ChannelsState.ConnectChannel("twitter", "@chiomaskitchen", "16th May 2026");
        _done = true;
    }

    private void GuidedBack()
    {
        if (_step == 0) Back();
        else _step -= 1;
    }

    private void Back() => Nav.NavigateTo("/dashboard/channels");
}
