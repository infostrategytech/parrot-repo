@namespace Parrot.Web.Components.Pages.Dashboard.Channels
@using Parrot.Web.Features.Dashboard.Channels.Models

@* The live check, shared by both routes.

   A channel is only marked connected once a real message arrives. The manual
   flow used to end on a thinner version of this that never said which number
   to message and never warned against closing the page — so "did it work?" was
   answered differently depending on how the channel was connected. Both end
   here now. *@

<section class="live-test channel-@Channel.Id.ToString().ToLowerInvariant()">
    <span class="live-test__mark"><Icon Name="@Mark" Size="IconSize.Lg" /></span>

    <Typography TextStyle="TextStyle.Small10Semibold" As="small" Class="live-test__eyebrow ds-overline">
        One last check
    </Typography>
    <Typography TextStyle="TextStyle.HeadingH2Bold" As="h1">@Copy.Title</Typography>

    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="live-test__instruction">
        @Copy.From send <strong>Hello</strong> to <strong>@Target</strong>. We’ll confirm when it
        reaches your Parrot inbox.
    </Typography>

    <div class="live-test__status">
        <i class="@(Verified ? "is-verified" : Busy ? "is-listening" : null)" aria-hidden="true"></i>
        <span class="live-test__status-copy">
            <Typography TextStyle="TextStyle.BodySmallBold" As="strong" Prose>
                @(Verified ? "Your message arrived" : Busy ? "Checking for your message…" : "Waiting for your test message")
            </Typography>
            <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>
                A channel is only marked connected once a real message arrives. Do not close this page yet.
            </Typography>
        </span>
    </div>

    @* Three states, so the control itself reports the result: idle, the
       brand's relay dots while the check runs (the Button draws them in its
       icon slot and keeps its label), and a tick that lands before the screen
       moves. The status line above says what the check is doing, so a slow
       one is never a silent wait. *@
    <Button Size="ButtonSize.Large"
            Class="@(Verified ? "live-test__action is-verified" : "live-test__action")"
            Busy="@Busy"
            disabled="@Verified"
            @onclick="OnCheck">
        <ChildContent>
            @(Verified ? "Message received" : "I’ve sent it")
        </ChildContent>
        <IconRight>
            @if (Verified)
            {
                <span class="live-test__tick"><Icon Name="IconName.RiCheckFill" /></span>
            }
            else
            {
                <Icon Name="IconName.RiArrowRightLine" />
            }
        </IconRight>
    </Button>
</section>

@code {
    [Parameter, EditorRequired] public BusinessChannel Channel { get; set; } = default!;

    [Parameter] public bool Busy { get; set; }

    /// <summary>The check has succeeded and the screen is about to change.</summary>
    [Parameter] public bool Verified { get; set; }

    [Parameter] public EventCallback OnCheck { get; set; }

    private MessageTestCopy Copy => ChannelRoutes.Test(Channel.Id);

    /// <summary>
    /// The account name once Meta has handed it back; otherwise a description
    /// of it, because "send Hello to null" helps nobody.
    /// </summary>
    private string Target => Channel.AccountName ?? Copy.Fallback;

    private IconName Mark => Channel.Id switch
    {
        ChannelId.Whatsapp => IconName.RiWhatsappFill,
        ChannelId.Instagram => IconName.RiInstagramFill,
        _ => IconName.RiFacebookCircleFill
    };
}
