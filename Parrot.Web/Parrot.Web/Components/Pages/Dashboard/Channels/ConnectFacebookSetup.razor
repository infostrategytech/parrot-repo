@page "/dashboard/channels/connect-facebook"
@page "/dashboard/channels/connect-facebook-marketplace"
@layout DashboardLayout
@implements IDisposable
@inject IIntegrationsService IntegrationsService
@inject AuthState AuthState
@inject IJSRuntime JS

<div class="cws-page">
    <a class="cws-cancel-link" href="/dashboard/channels">← Back to channels</a>
    <div class="cws-body">
        <section class="cws-panel" aria-busy="@_busy">
            <h1 class="cws-panel-title">Connect Facebook Messenger</h1>
            <p class="cws-panel-sub">Copy these values into Messenger API Settings → Configure webhooks in Meta.</p>
            @if (!AuthState.IsAuthenticated)
            {
                <p>Sign in to prepare your webhook setup.</p>
                <a href="/login">Sign in</a>
            }
            else if (_setup is not null)
            {
                <label class="cws-field-label" for="facebook-callback">Callback URL</label>
                <div class="cws-copy-row">
                    <input class="cws-input" id="facebook-callback" readonly value="@_setup.WebhookUrl" />
                    <button class="cws-copy-btn" @onclick='() => CopyAsync(_setup.WebhookUrl, "Callback URL")'>Copy URL</button>
                </div>
                <label class="cws-field-label" for="facebook-verify">Verify token</label>
                <div class="cws-copy-row">
                    <input class="cws-input" id="facebook-verify" readonly value="@_setup.VerifyToken" spellcheck="false" />
                    <button class="cws-copy-btn" @onclick='() => CopyAsync(_setup.VerifyToken, "Verify token")'>Copy token</button>
                </div>
                <p class="cws-token-helper">Paste both values into Meta, then click Verify and save. This verify token is different from your Page access token.</p>
                <div class="cws-actions">
                    <button class="cws-copy-btn" @onclick="LoadAsync" disabled="@_busy">Check verification</button>
                    @if (_setup.WebhookVerified)
                    {
                        <span class="cws-token-helper">Webhook verified by Meta.</span>
                    }
                </div>
                <a class="cws-primary-btn" href="https://developers.facebook.com/apps/" target="_blank" rel="noopener noreferrer">Open Meta Developer Portal ↗</a>

                <hr />
                <h2 class="cws-panel-title">Connect your Facebook Page</h2>
                <p class="cws-panel-sub">After Meta verifies the webhook, generate a Page access token and save it here.</p>
                <label class="cws-field-label" for="facebook-page-id">Page ID</label>
                <input class="cws-input" id="facebook-page-id" maxlength="64" inputmode="numeric" @bind="_pageId" />
                <label class="cws-field-label" for="facebook-page-name">Page name</label>
                <input class="cws-input" id="facebook-page-name" maxlength="128" @bind="_pageName" />
                <label class="cws-field-label" for="facebook-page-token">Page access token</label>
                <input class="cws-input" id="facebook-page-token" type="password" maxlength="8192"
                       autocomplete="new-password" spellcheck="false" @bind="_accessToken" />
                <p class="cws-token-helper">@(_setup.HasAccessToken ? "A token is saved. Enter a new token only to replace it." : "The token is encrypted before it is stored.")</p>
                <button class="cws-primary-btn" @onclick="SavePageAsync"
                        disabled="@(_busy || !_setup.WebhookVerified || string.IsNullOrWhiteSpace(_pageId) || string.IsNullOrWhiteSpace(_pageName) || string.IsNullOrWhiteSpace(_accessToken))">
                    Save Page connection
                </button>
            }
            else if (_busy)
            {
                <p role="status">Preparing webhook details…</p>
            }
            @if (_error is not null)
            {
                <p role="alert">@_error</p>
                <button class="cws-copy-btn" @onclick="LoadAsync" disabled="@_busy">Try again</button>
            }
            @if (_notice is not null)
            {
                <p role="status">@_notice</p>
            }
        </section>
        <aside class="cws-guide-panel">
            <h2 class="cws-guide-title">Set up Messenger in Meta</h2>
            <ol class="cws-setup-guide">
                <li>Open your app → Messenger → Messenger API Settings.</li>
                <li>Paste the callback URL and verify token shown here.</li>
                <li>Click <strong>Verify and save</strong>. Meta confirms the callback there.</li>
                <li>Under Generate access tokens, connect the Facebook Page you manage.</li>
                <li>Subscribe the Page to the message events your integration needs.</li>
            </ol>
            <p class="cws-panel-sub">This integration is for Facebook Page Messenger inboxes.</p>
        </aside>
    </div>
</div>

@code {
    private FacebookWebhookSetup? _setup;
    private string? _error, _notice;
    private string _pageId = string.Empty, _pageName = string.Empty, _accessToken = string.Empty;
    private bool _busy, _disposed;
    private readonly CancellationTokenSource _lifetime = new();

    protected override void OnInitialized() => AuthState.OnChange += AuthChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await LoadAsync(); if (!_disposed) StateHasChanged(); }
    }
    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        _setup = null;
        _notice = null;
        await LoadAsync();
        StateHasChanged();
    });
    private async Task LoadAsync()
    {
        if (_busy || _disposed || !AuthState.IsAuthenticated) return;
        string? token = AuthState.CurrentUser?.Token;
        if (string.IsNullOrEmpty(token)) return;
        _busy = true;
        _error = null;
        try
        {
            var setup = await IntegrationsService.GetFacebookSetupAsync(token, _lifetime.Token);
            if (!_disposed && AuthState.CurrentUser?.Token == token)
            {
                _setup = setup;
                _pageId = setup.PageId ?? _pageId;
                _pageName = setup.PageName ?? _pageName;
                _notice = setup.WebhookVerified ? "Webhook verification confirmed." : null;
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                ? "Facebook setup is not configured on the API server yet. Ask the administrator to configure the public Facebook webhook address."
                : "Could not load Facebook setup. Check your sign-in and try again.";
        }
        catch (OperationCanceledException) { _error = "The request timed out. Please try again."; }
        catch (System.Text.Json.JsonException) { _error = "Could not read Facebook setup. Please try again."; }
        finally { _busy = false; }
    }
    private async Task SavePageAsync()
    {
        if (_busy || _setup is null) return;
        string? token = AuthState.CurrentUser?.Token;
        if (string.IsNullOrEmpty(token)) return;
        _busy = true;
        _error = _notice = null;
        try
        {
            await IntegrationsService.SaveFacebookPageAsync(_pageId.Trim(), _pageName.Trim(), _accessToken.Trim(), token, _lifetime.Token);
            _accessToken = string.Empty;
            _setup = await IntegrationsService.GetFacebookSetupAsync(token, _lifetime.Token);
            _notice = "Facebook Page connection saved.";
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "Verify the webhook in Meta before saving the Page, or check whether this Page is already connected."
                : "Could not save the Facebook Page connection.";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private async Task CopyAsync(string value, string label)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); _notice = $"{label} copied."; }
        catch (JSException) { _notice = "Select the field and copy it manually; clipboard access is unavailable."; }
    }
    public void Dispose()
    {
        _disposed = true;
        _setup = null;
        _accessToken = string.Empty;
        AuthState.OnChange -= AuthChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
