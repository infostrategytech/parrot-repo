@namespace Parrot.Web.Components.Pages.Dashboard.Channels

@* A picture of Meta Business Settings, with the path highlighted.

   It is drawn rather than screenshotted for two reasons: a screenshot of
   someone else's product goes stale the week they redesign it, and a drawing
   can move — the highlight walking Accounts → Apps → Add is the whole point,
   because that menu is where people get lost.

   Everything inside the window frame is Meta's interface, not ours. *@

<div class="meta-demo">
    <div class="meta-demo__window" role="img" aria-label="@Description" @key="ReplayKey">
        <div class="meta-demo__toolbar">
            <i></i><i></i><i></i>
            <span>business.facebook.com</span>
        </div>

        <div class="meta-demo__productbar">
            <span>Dashboard</span>
            <i></i>
        </div>

        <div class="meta-demo__workspace">
            <nav>
                <small>Frequently used</small>
                <span>Business info</span>
                <span>Users</span>

                <div class="meta-demo__group">
                    <strong class="meta-demo__accounts">Accounts<i>⌃</i></strong>
                    <div>
                        <span>Pages</span>
                        <span>Ad accounts</span>
                        <span class="meta-demo__apps">Apps</span>
                        <span>WhatsApp accounts</span>
                    </div>
                </div>

                <span>Data Sources</span>
            </nav>

            <section>
                <header>
                    <strong>Apps</strong>
                    <div>
                        <i></i>
                        <button type="button" tabindex="-1"><span>＋</span>Add</button>
                    </div>
                </header>

                <div class="meta-demo__empty">
                    <div><i></i><i></i><i></i></div>
                    <strong>No apps added</strong>
                    <span>Add apps to this business portfolio so you can manage all your business assets in one place.</span>
                </div>
            </section>
        </div>

        <span class="meta-demo__cursor" aria-hidden="true"></span>
    </div>

    <p class="meta-demo__caption">
        <span class="meta-demo__dot" aria-hidden="true"></span>
        <Typography TextStyle="TextStyle.Small10Medium" As="span">Follow the moving highlight</Typography>
        <button type="button" class="meta-demo__replay" @onclick="Replay">
            <Icon Name="IconName.RiRefreshLine" />
            <Typography TextStyle="TextStyle.Small10Semibold" As="span">Replay</Typography>
        </button>
    </p>
</div>

@code {
    private const string Description =
        "Animated guide showing where to find the Add app button in Meta Business Settings";

    // Changing the key throws the window away and builds a new one, which is
    // the only reliable way to restart a CSS animation from the beginning.
    private int ReplayKey;

    private void Replay() => ReplayKey++;
}
