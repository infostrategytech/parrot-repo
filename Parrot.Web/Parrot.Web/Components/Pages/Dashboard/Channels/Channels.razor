@page "/dashboard/channels"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Channels
@using global::Grpc.Core
@using Parrot.Web.Features.Dashboard.Channels.Models
@implements IDisposable
@inject ChannelsState ChannelsState
@inject IIntegrationsService IntegrationsService
@inject IMessageVerificationGrpcClient MessageVerification
@inject AuthState AuthState
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IChannelCapabilities Capabilities

<PageTitle>Channels · OmniAI</PageTitle>

@* The landing screen. Each setup flow replaces this view entirely rather than
   opening over it, because an SME halfway through connecting WhatsApp should
   not be looking at the other two channels. Those flows land next. *@

@* Only while it shows: an empty wrapper kept its padding (112px) above
   every setup screen, which pushed each one down the window. *@
@if (Active is null || _view == SetupView.Choice)
{
<div class="channels">
    <header class="channels__header">
        <div class="channels__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Channels</Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="channels__lede">
                Connect and manage the places your customers message you.
            </Typography>
        </div>
    </header>

    @if (_error is not null)
    {
        <InlineError Message="@_error" OnDismiss="() => _error = null" />
    }

    @if (_loading)
    {
        <LoadingState Glyph="IconName.RiLinksFill"
                      Title="Checking your channels"
                      Description="Loading the places your customers message you." />
    }
    else if (_data is null || _data.Channels.Count == 0)
    {
        <EmptyState Glyph="IconName.RiLinksFill"
                    Title="No channels available"
                    Description="Channels will appear here once this workspace has any." />
    }
    else
    {
        <section class="channels__list" aria-label="Available channels">
            @foreach (var channel in _data.Channels)
            {
                <ChannelCard Channel="channel"
                             ActionDisabled="@(_busy || (channel.Status == ChannelStatus.NeedsAttention && channel.Id is not (ChannelId.TikTok or ChannelId.Instagram)))"
                             OnOpen="() => OpenSetupAsync(channel)"
                             OnDisconnect="() => AskDisconnect(channel)"
                             OnStartOver="() => AskRestart(channel)" />
            }
        </section>
    }
</div>
}

@* Choosing a route is modal; everything after it replaces the page, because
   someone halfway through connecting WhatsApp should not be looking at the
   other two channels. *@
@if (Active is { } choosing && _view == SetupView.Choice)
{
    <RouteChoice Channel="choosing"
                 OnChoose="ChooseRouteAsync"
                 OnUseManual="@(Capabilities.CanSetUpManually(choosing.Id) ? EventCallback.Factory.Create(this, UseManualSetup) : default)"
                 OnClose="CloseSetup" />
}

@if (Active is { } prepChannel && _view == SetupView.Preparation && SelectedRoute is { } route)
{
    <div class="channels channels--setup">
        @SetupError
        <RoutePreparation Channel="prepChannel"
                          Route="route"
                          CanChangeRoute="@HasChoice(prepChannel.Id)"
                          @bind-Accepted="_accepted"
                          Busy="_busy"
                          OnBack="BackFromPreparation"
                          OnContinue="BeginProviderHandoffAsync" />
    </div>
}

@* From here the stage the setup has reached drives the screen, not the view
   alone. A reopened setup therefore lands exactly where it stopped. *@
@* Past the last step: the guided flow has no stage for "done", so running
   off the end of the steps is what marks it finished. *@
@if (Active is { } finished && _view == SetupView.Guided && _step >= GuidedSteps.Count)
{
    <div class="channels channels--setup">
        <ConnectionSuccess Channel="finished"
                           OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                           OnConnectAnother="CloseSetup"
                           OnSetUpAgent="SetUpAgent" />
    </div>
}
else if (Active is { } guided && _view == SetupView.Guided && _data is not null)
{
    <div class="channels channels--setup">
        @SetupError
        <GuidedSetup ChannelName="@guided.Name"
                     Started="_guidedStarted"
                     Step="_step"
                     Busy="_busy"
                     OnStart="() => _guidedStarted = true"
                     OnBack="GuidedBack"
                     OnNext="GuidedNextAsync"
                     OnExit="CloseSetup">
            @* A drawing of the provider screen each step describes. Step four
               has none: Meta changes those screens often enough that drawing
               them would be a promise we cannot keep. *@
            <Demo>
                @switch (_step)
                {
                    case 0: <MetaBrowserDemo />; break;
                    case 1: <MetaDetailsDemo />; break;
                    case 2: <MetaUseCaseDemo />; break;
                    case 4: <MetaApiSetupDemo />; break;
                }
            </Demo>
            <ConnectionContent>
                @if (WebhookFor(guided) is { } webhook)
                {
                    <ManualConnection ManualStage="_manualStage"
                                      @bind-OpenSection="_openSection"
                                      Webhook="webhook"
                                      @bind-PhoneNumberId="_phoneNumberId"
                                      @bind-BusinessAccountId="_businessAccountId"
                                      @bind-AccessToken="_accessToken"
                                      @bind-AppSecret="_appSecret"
                                      @bind-Permanent="_permanentToken"
                                      @bind-WebhookConfirmed="_webhookConfirmed"
                                      HasSavedToken="@(guided.Id == ChannelId.Whatsapp && ChannelsState.WhatsAppConnection?.HasAccessToken == true)"
                                      HasSavedAppSecret="@(guided.Id == ChannelId.Whatsapp && ChannelsState.WhatsAppConnection?.HasAppSecret == true)"
                                      Busy="_busy"
                                      OnAdvance="AdvanceManualStageAsync"
                                      OnFinish="FinishManualConnectionAsync"
                                      OnCopy="@(label => Toasts.Show($"{label} copied."))" />
                }
                else
                {
                    @* Parrot issues the callback URL and verify token per
                       connection, so the card cannot draw until one exists. *@
                    <EmptyState Glyph="IconName.RiLinksFill"
                                Size="EmptyStateSize.Panel"
                                Title="Your connection could not be loaded"
                                Description="Try again to continue with the same saved connection.">
                        <Action>
                            <Button Variant="ButtonVariant.Secondary" disabled="@_busy" @onclick="ReloadSetupAsync">Try again</Button>
                        </Action>
                    </EmptyState>
                }
            </ConnectionContent>
            <TestContent>
                <MessageTest Channel="guided" Busy="_checking" Missed="_missed" OnCheck="VerifyAsync" />
            </TestContent>
        </GuidedSetup>
    </div>
}

@if (Active is { } facebook && _view == SetupView.FacebookManual)
{
    <div class="channels channels--setup">
        <FacebookManualSetup Channel="facebook"
                             OnExit="CloseSetup"
                             OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                             OnSetUpAgent="SetUpAgent" />
    </div>
}

@if (Active is { } instagram && _view == SetupView.InstagramManual)
{
    <div class="channels channels--setup">
        <InstagramManualSetup Channel="instagram"
                              OnExit="CloseSetup"
                              OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                              OnSetUpAgent="SetUpAgent" />
    </div>
}

@if (Active is { } tikTok && _view == SetupView.TikTokManual)
{
    <div class="channels channels--setup">
        <TikTokManualSetup Channel="tikTok"
                           StartAtTest="_tikTokStartAtTest"
                           InitialError="@_tikTokError"
                           OnExit="CloseSetup"
                           OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                           OnSetUpAgent="SetUpAgent" />
    </div>
}

@* The provider window sits outside the page wrapper, like the route choice:
   the wrapper eases in on arrival (app.css, page-enter), and a full-screen
   window inside a moving parent is drawn against that parent until the move
   ends, so it jumped from a strip at the top to the middle of the screen. *@
@if (Active is { } popup && _view == SetupView.Flow && DisplayStage == EmbeddedStage.Popup)
{
    <ProviderPopup Channel="popup"
                   Path="popup.Setup.Path"
                   OnCancel="CloseProviderEarlyAsync"
                   OnComplete="CompleteProviderHandoffAsync" />
}
else if (Active is { } flow && _view == SetupView.Flow)
{
    <div class="channels channels--setup">
        @SetupError
        @switch (DisplayStage)
        {
            case EmbeddedStage.Linking:
            case EmbeddedStage.Registering:
            case EmbeddedStage.Subscribing:
                <ConnectingProgress Channel="flow" />
                break;

            case EmbeddedStage.ReadyToTest:
                <MessageTest Channel="flow" Busy="_checking" Missed="_missed" OnCheck="VerifyAsync" />
                break;

            case EmbeddedStage.Connected:
                <ConnectionSuccess Channel="flow"
                                   OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                                   OnConnectAnother="CloseSetup"
                                   OnSetUpAgent="SetUpAgent" />
                break;

            case EmbeddedStage.Failed:
                <SetupFailure Channel="flow"
                              Route="SelectedRoute"
                              OnRetry="RetryAsync"
                              OnBack="CloseSetup" />
                break;
        }
    </div>
}

<Dialog Open="_pendingDisconnect is not null"
        Type="DialogType.Destructive"
        Title="@($"Disconnect {_pendingDisconnect?.Name}?")"
        ConfirmLabel="Disconnect"
        Busy="_busy"
        BusyLabel="Disconnecting…"
        OnCancel="() => _pendingDisconnect = null"
        OnConfirm="DisconnectAsync">
    <GlyphContent><Icon Name="IconName.RiLinksFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>New messages stop arriving and your agents stop replying there. You can reconnect anytime.</p>
    </Body>
</Dialog>

@* Destructive, because a manual setup part-way through is holding credentials
   somebody has typed in by hand. *@
<Dialog Open="_pendingRestart is not null"
        Type="DialogType.Destructive"
        Title="@($"Start {_pendingRestart?.Name} setup over?")"
        ConfirmLabel="Start over"
        Busy="_busy"
        BusyLabel="Clearing…"
        OnCancel="() => _pendingRestart = null"
        OnConfirm="RestartAsync">
    <GlyphContent><Icon Name="IconName.RiRefreshLine" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <p>This clears what you've entered. Nothing is connected yet, so no messages are affected.</p>
    </Body>
</Dialog>

@code {
    /// <summary>
    /// Pacing between the three connecting steps. It exists so the steps can be
    /// read, not because the calls are slow.
    /// </summary>
    private static readonly TimeSpan ProviderStepPacing = TimeSpan.FromMilliseconds(850);

    /// <summary>
    /// A floor under how long the check appears to take. Returning in a blink
    /// reads as though nothing was checked at all.
    /// </summary>
    private static readonly TimeSpan CheckPacing = TimeSpan.FromMilliseconds(2400);

    /// <summary>
    /// The message check polls Parrot's gRPC verification service: a message
    /// sent from a phone takes a few seconds to reach Meta and be relayed, so
    /// one press of the button asks several times before giving up.
    /// </summary>
    private static readonly TimeSpan CheckInterval = TimeSpan.FromSeconds(2);
    private const int CheckAttempts = 10;

    /// <summary>The name Parrot's backend files the WhatsApp connection under.</summary>
    private const string WhatsAppConnectionName = "WhatsApp Business";

    /// <summary>
    /// The stage the screen shows, which is not always the stage the setup
    /// holds. Verifying flips the setup to Connected immediately, and the
    /// re-render that follows would replace the test screen while the check
    /// is still running — so until it ends, the view stays put. Then the
    /// result replaces the test in place.
    /// </summary>
    private EmbeddedStage DisplayStage =>
        Active is null ? EmbeddedStage.Idle
        : _checking && Active.Setup.Stage == EmbeddedStage.Connected
            ? EmbeddedStage.ReadyToTest
            : Active.Setup.Stage;

    /// <summary>
    /// Opened from Parrot's deep link (/dashboard/channels/connect-whatsapp):
    /// the page lands straight in that channel's setup, and leaving it goes
    /// back to the list's own address.
    /// </summary>
    [Parameter] public ChannelId? Resume { get; set; }

    /// <summary>
    /// ?for=agent: sent here by "Connect a channel first". Once a channel is
    /// connected, its success screen leads back to setting up the agent.
    /// </summary>
    [SupplyParameterFromQuery(Name = "for")] public string? For { get; set; }

    /// <summary>
    /// ?tiktok=connected, cancelled or failed (with ?reason=): TikTok sent the owner back from its consent screen.
    /// The setup opens again where they left it, at the test message once connected.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tiktok")] public string? TikTokOutcome { get; set; }

    [SupplyParameterFromQuery(Name = "reason")] public string? TikTokReason { get; set; }

    private bool _tikTokStartAtTest;
    private string? _tikTokError;

    private EventCallback SetUpAgent => For == "agent"
        ? EventCallback.Factory.Create(this, () => Nav.NavigateTo("/ai-operations?new=1"))
        : default;

    /// <summary>The check is running, including the pacing floor above it.</summary>
    private bool _checking;

    /// <summary>The last check found no message: the test says so and offers Check again.</summary>
    private bool _missed;

    private readonly CancellationTokenSource _lifetime = new();

    private ChannelWorkspace? _data;
    private bool _loading = true;
    private bool _busy;
    private bool _disposed;
    private string? _error;
    private BusinessChannel? _pendingDisconnect;

    private BusinessChannel? _pendingRestart;

    private ChannelId? _activeId;
    private SetupView _view = SetupView.None;
    private ChannelSetupMode? _mode;
    private ChannelPath? _chosenPath;
    private EmbeddedStage _stage;
    private string? _failure;
    private bool _accepted;

    // The guided path. _manualStage is the furthest point reached, which is
    // kept in ChannelsState; _openSection is only which section is expanded,
    // so a finished one can always be reopened.
    private bool _guidedStarted;
    private int _step;
    private ManualSetupStage _manualStage = ManualSetupStage.Number;
    private ManualSetupStage _openSection = ManualSetupStage.Number;
    private string? _phoneNumberId;
    private string? _businessAccountId;
    private string? _accessToken;
    private string? _appSecret;
    private bool _permanentToken = true;
    private bool _webhookConfirmed;

    /// <summary>When the test step was reached, so the check only counts messages sent after it.</summary>
    private DateTimeOffset? _testStartedAt;

    private enum SetupView { None, Choice, Preparation, Flow, Guided, FacebookManual, TikTokManual, InstagramManual }

    // The choice of how to connect shows whenever there is more than one way
    // in: several routes, or a route and a manual setup. With one way only,
    // asking would be a screen that exists only to be dismissed.
    private bool HasChoice(ChannelId id) => ChannelRoutes.For(id).Count > 1 || Capabilities.CanSetUpManually(id);

    private BusinessChannel? Active =>
        _activeId is null ? null : _data?.Channels.FirstOrDefault(c => c.Id == _activeId);

    private ChannelRoute? SelectedRoute => Active is null
        ? null
        : ChannelRoutes.Find(Active.Id, _chosenPath ?? Active.Setup.Path);

    private string Token => AuthState.CurrentUser?.Token ?? throw new InvalidOperationException("Sign in to continue.");

    /// <summary>
    /// Errors inside a flow show where the flow is. Aurora's setup screens
    /// carry none of their own, because its server never fails; Parrot's
    /// calls can.
    /// </summary>
    private RenderFragment SetupError => @<text>
        @if (_error is not null)
        {
            <InlineError Message="@_error" OnDismiss="() => _error = null" />
        }
    </text>;

    protected override void OnInitialized()
    {
        AuthState.OnChange += AuthChanged;
        _data = ChannelsState.Workspace;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        if (_disposed) return;
        if (Resume is { } resume && _data?.Channels.FirstOrDefault(c => c.Id == resume) is { } channel)
        {
            await OpenSetupAsync(channel);
        }
        else if (TikTokOutcome is { Length: > 0 } outcome && _data?.Channels.FirstOrDefault(c => c.Id == ChannelId.TikTok) is { } tikTokChannel)
        {
            _tikTokStartAtTest = outcome == "connected";
            _tikTokError = outcome == "failed"
                ? TikTokReason is { Length: > 0 } reason ? reason : "TikTok could not be connected. Try again."
                : outcome == "cancelled" ? "TikTok was not authorized. Select Authorize with TikTok to try again." : null;
            await OpenSetupAsync(tikTokChannel);

            // The outcome has been read; keep a refresh from reading it again.
            Nav.NavigateTo("/dashboard/channels", replace: true);
        }
        StateHasChanged();
    }

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        _accessToken = null;
        _appSecret = null;
        CloseSetup();
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        string? token = AuthState.CurrentUser?.Token;
        if (string.IsNullOrEmpty(token))
        {
            ChannelsState.SetWhatsApp(null);
            ChannelsState.SetFacebook(null);
            ChannelsState.SetTikTok(null);
            ChannelsState.SetInstagram(null);
            Refresh();
            _loading = false;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            try
            {
                var connections = await IntegrationsService.GetWhatsAppConnectionsAsync(token, _lifetime.Token);
                if (_disposed || AuthState.CurrentUser?.Token != token) return;
                ChannelsState.SetWhatsApp(connections.FirstOrDefault(c => c.DisabledAt is null) ?? connections.FirstOrDefault());
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
            catch (HttpRequestException) { _error = "We couldn't load WhatsApp. Try again."; }
            catch (System.Text.Json.JsonException) { _error = "We couldn't load WhatsApp. Try again."; }

            try
            {
                var facebook = await IntegrationsService.GetFacebookSetupAsync(token, _lifetime.Token);
                if (_disposed || AuthState.CurrentUser?.Token != token) return;
                ChannelsState.SetFacebook(facebook);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
            // Not configured on the API server yet: there is no Facebook status
            // to show, which the card already says by being "Not connected".
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable) { }
            catch (HttpRequestException) { _error ??= "We couldn't load Facebook. Try again."; }
            catch (System.Text.Json.JsonException) { _error ??= "We couldn't load Facebook. Try again."; }

            try
            {
                var tikTok = await IntegrationsService.GetTikTokSetupAsync(token, _lifetime.Token);
                if (_disposed || AuthState.CurrentUser?.Token != token) return;
                ChannelsState.SetTikTok(tikTok);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
            // Not configured on the API server yet: the card already says "Not connected".
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable) { }
            catch (HttpRequestException) { _error ??= "We couldn't load TikTok. Try again."; }
            catch (System.Text.Json.JsonException) { _error ??= "We couldn't load TikTok. Try again."; }

            try
            {
                var instagram = await IntegrationsService.GetInstagramSetupAsync(token, _lifetime.Token);
                if (_disposed || AuthState.CurrentUser?.Token != token) return;
                ChannelsState.SetInstagram(instagram);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
            // Not configured on the API server yet: the card says so by being "Not connected".
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable) { }
            catch (HttpRequestException) { _error ??= "We couldn't load Instagram. Try again."; }
            catch (System.Text.Json.JsonException) { _error ??= "We couldn't load Instagram. Try again."; }
        }
        finally
        {
            _busy = false;
            _loading = false;
            Refresh();
        }
    }

    private void Refresh() => _data = ChannelsState.Workspace;

    /// <summary>
    /// Aurora writes progress to the server after every step. Parrot has no
    /// endpoint for it, so the same record is kept in ChannelsState and lives
    /// as long as the circuit does.
    /// </summary>
    private void Persist()
    {
        if (_activeId is not { } id) return;
        ChannelsState.SaveSetup(id, new ChannelSetupState
        {
            Mode = _mode,
            Step = _step,
            ManualStage = _manualStage,
            PhoneNumberId = _phoneNumberId ?? "",
            BusinessAccountId = _businessAccountId ?? "",
            Path = _chosenPath,
            Stage = _stage,
            Failure = _failure
        });
        Refresh();
    }

    private async Task OpenSetupAsync(BusinessChannel channel)
    {
        // Nothing can connect it yet (its card says Coming soon).
        if (!Capabilities.CanUseWindow(channel.Id) && !Capabilities.CanSetUpManually(channel.Id)) return;

        _activeId = channel.Id;
        _accepted = false;
        _chosenPath = null;
        _error = null;
        _missed = false;
        _mode = channel.Setup.Mode;
        _stage = channel.Setup.Stage;
        _failure = channel.Setup.Failure;

        // TikTok has only its own manual setup, which reopens where it stopped (the API knows how far it got).
        if (channel.Id == ChannelId.TikTok)
        {
            _view = SetupView.TikTokManual;
            return;
        }

        // Facebook's and Instagram's manual setups reopen where they stopped (the API knows how far they got).
        if (channel.Id is ChannelId.Facebook or ChannelId.Instagram && channel.Setup.Mode == ChannelSetupMode.Guided)
        {
            _view = channel.Id == ChannelId.Facebook ? SetupView.FacebookManual : SetupView.InstagramManual;
            return;
        }

        // Reopening WhatsApp's guided setup drops back where it stopped.
        if (channel.Id == ChannelId.Whatsapp && (channel.Setup.Mode == ChannelSetupMode.Guided || channel.Status == ChannelStatus.Connected))
        {
            var setup = channel.Setup;
            if (channel.Id == ChannelId.Whatsapp)
            {
                // Every screen from here needs the callback URL and verify token
                // Parrot issued for the connection.
                if (ChannelsState.WhatsAppSetup is null && ChannelsState.WhatsAppConnection is { DisabledAt: null })
                {
                    await RunAsync(EnsureSetupAsync, "We couldn't load your connection. Try again to pick up where you left off.");
                }

                if (channel.Status == ChannelStatus.Connected && ChannelsState.WhatsAppConnection is { } live)
                    setup = ChannelsState.SeedWhatsApp(live) with { Step = GuidedSteps.ConnectionStep };
            }

            _mode = ChannelSetupMode.Guided;
            _step = setup.Step;
            _manualStage = setup.ManualStage;
            _openSection = setup.ManualStage == ManualSetupStage.Complete
                ? ManualSetupStage.Webhook
                : setup.ManualStage;
            _permanentToken = setup.TokenExpiresAt is null;
            _webhookConfirmed = setup.ManualStage == ManualSetupStage.Complete;
            _phoneNumberId = setup.PhoneNumberId;
            _businessAccountId = setup.BusinessAccountId;
            _accessToken = null;
            _appSecret = null;
            _guidedStarted = setup.Step > 0;
            if (_step == GuidedSteps.TestStep) _testStartedAt ??= DateTimeOffset.UtcNow;
            _view = SetupView.Guided;
            Persist();
            return;
        }

        // A setup already past the popup resumes where it stopped.
        if (channel.Setup.Stage is not EmbeddedStage.Idle)
        {
            _chosenPath = channel.Setup.Path;
            if (_stage == EmbeddedStage.ReadyToTest) _testStartedAt ??= DateTimeOffset.UtcNow;
            _view = SetupView.Flow;
            return;
        }

        var routes = ChannelRoutes.For(channel.Id);
        if (HasChoice(channel.Id))
        {
            _view = SetupView.Choice;
        }
        else
        {
            _chosenPath = routes[0].Id;
            _view = SetupView.Preparation;
        }
    }

    private void CloseSetup()
    {
        // A step that saved through the API (Facebook's manual setup) has
        // already updated the state; read it again so the cards show it.
        Refresh();
        _activeId = null;
        _view = SetupView.None;
        _chosenPath = null;
        _accepted = false;
        _accessToken = null;
        _appSecret = null;
        _error = null;
        _missed = false;
        _tikTokStartAtTest = false;
        _tikTokError = null;
        if (Resume is not null) Nav.NavigateTo("/dashboard/channels");
    }

    private Task ChooseRouteAsync(ChannelPath path)
    {
        _chosenPath = path;
        _accepted = false;
        _view = SetupView.Preparation;
        return Task.CompletedTask;
    }

    private void BackFromPreparation()
    {
        if (Active is not null && HasChoice(Active.Id))
        {
            _view = SetupView.Choice;
            _accepted = false;
        }
        else
        {
            CloseSetup();
        }
    }

    // The manual walkthrough is always reachable from the choice screen, not
    // buried behind a failure: Meta fails often enough that the way round it
    // belongs on the first screen.
    //
    // This is where Parrot's connection is created (or the saved one picked
    // up): the manual path is the one Parrot's backend actually implements.
    // WhatsApp's guided setup, or Facebook's and Instagram's own two sections;
    // X has none (designer's decision).
    private async Task UseManualSetup()
    {
        if (Active is { Id: ChannelId.Facebook })
        {
            _view = SetupView.FacebookManual;
            return;
        }
        if (Active is { Id: ChannelId.Instagram })
        {
            _view = SetupView.InstagramManual;
            return;
        }
        if (Active is not { Id: ChannelId.Whatsapp }) return;

        if (!await RunAsync(EnsureSetupAsync, "We couldn't load your connection. Try again to pick up where you left off."))
        {
            return;
        }

        var seed = ChannelsState.WhatsAppConnection is { } connection
            ? ChannelsState.SeedWhatsApp(connection)
            : new ChannelSetupState();

        _mode = ChannelSetupMode.Guided;
        _stage = EmbeddedStage.Idle;
        _failure = null;
        _step = 0;
        _manualStage = seed.ManualStage;
        _openSection = seed.ManualStage == ManualSetupStage.Complete ? ManualSetupStage.Webhook : seed.ManualStage;
        _phoneNumberId = seed.PhoneNumberId;
        _businessAccountId = seed.BusinessAccountId;
        _accessToken = null;
        _appSecret = null;
        _permanentToken = true;
        _webhookConfirmed = seed.ManualStage == ManualSetupStage.Complete;
        _guidedStarted = false;
        _view = SetupView.Guided;
        Persist();
    }

    private void GuidedBack()
    {
        if (_step == 0) _guidedStarted = false;
        else _step = Math.Max(0, _step - 1);
        Persist();
    }

    private Task GuidedNextAsync()
    {
        if (Active is null) return Task.CompletedTask;
        _step += 1;
        if (_step == GuidedSteps.TestStep) _testStartedAt = DateTimeOffset.UtcNow;
        Persist();
        return Task.CompletedTask;
    }

    private async Task AdvanceManualStageAsync(ManualSetupStage next)
    {
        if (Active is null) return;

        // Only the credentials step carries a payload; the others just move
        // the marker. The token is written once and never comes back.
        if (next == ManualSetupStage.Webhook)
        {
            if (ChannelsState.WhatsAppSetup is not { } setup) return;

            var businessAccountId = _businessAccountId?.Trim() ?? "";
            var phoneNumberId = _phoneNumberId?.Trim() ?? "";
            if (businessAccountId.Length == 0 || phoneNumberId.Length == 0
                || !businessAccountId.All(char.IsAsciiDigit) || !phoneNumberId.All(char.IsAsciiDigit))
            {
                _error = "Enter the numeric Business Account ID and Phone Number ID from Meta.";
                return;
            }

            var token = _accessToken;
            var appSecret = _appSecret?.Trim();
            if (!string.IsNullOrEmpty(appSecret) && (appSecret.Length != 32 || !appSecret.All(char.IsAsciiHexDigit)))
            {
                _error = "Enter the App Secret from your Meta app's App settings → Basic: 32 letters and numbers.";
                return;
            }

            var ok = await RunAsync(async cancellation =>
            {
                await IntegrationsService.ConfigureWhatsAppAccountAsync(setup.Connection.Id, businessAccountId, phoneNumberId, Token, cancellation);
                if (!string.IsNullOrWhiteSpace(token))
                {
                    await IntegrationsService.SaveWhatsAppAccessTokenAsync(setup.Connection.Id, token, Token, cancellation);
                }
                if (!string.IsNullOrEmpty(appSecret))
                {
                    await IntegrationsService.SaveWhatsAppAppSecretAsync(setup.Connection.Id, appSecret, Token, cancellation);
                }
                ChannelsState.SetWhatsApp(await IntegrationsService.GetWhatsAppStatusAsync(setup.Connection.Id, Token, cancellation));
            }, "We couldn't save those details. Check the IDs and try again.");

            if (!ok) return;
            _accessToken = null;
            _appSecret = null;
            Toasts.Show("Connection details saved securely.");
        }

        if (Order(next) > Order(_manualStage)) _manualStage = next;
        _openSection = next;
        Persist();
    }

    /// <summary>
    /// Parrot's "Check verification": the webhook only counts once Meta has
    /// actually called it, which the connection's status reports.
    /// </summary>
    private async Task FinishManualConnectionAsync()
    {
        if (Active is null || !_webhookConfirmed) return;
        if (ChannelsState.WhatsAppSetup is not { } setup) return;

        var ok = await RunAsync(async cancellation =>
            ChannelsState.SetWhatsApp(await IntegrationsService.GetWhatsAppStatusAsync(setup.Connection.Id, Token, cancellation)),
            "We couldn't check the verification. Try again.");
        if (!ok) return;

        var connection = ChannelsState.WhatsAppConnection;
        if (connection?.WebhookVerifiedAt is null || connection.DisabledAt is not null)
        {
            _error = connection?.DisabledAt is not null
                ? ChannelsState.DisabledAttention
                : "Verification has not been confirmed. Complete Verify and save in Meta, then check again.";
            return;
        }

        CompleteManualStage();
    }

    private void CompleteManualStage()
    {
        _manualStage = ManualSetupStage.Complete;
        _openSection = ManualSetupStage.Webhook;
        _step += 1;
        _testStartedAt = DateTimeOffset.UtcNow;
        Persist();
        Toasts.Show("Webhook verified.");
    }

    /// <summary>What Meta calls back: only WhatsApp has a manual setup, so only its connection.</summary>
    private ChannelWebhook? WebhookFor(BusinessChannel channel) =>
        channel.Id == ChannelId.Whatsapp ? _data?.Webhook : null;

    private string KeyOf(BusinessChannel channel) => ChannelsState.Channels.First(c => c.Id == channel.Id).Key;

    private static int Order(ManualSetupStage stage) => stage switch
    {
        ManualSetupStage.Number => 0,
        ManualSetupStage.Credentials => 1,
        ManualSetupStage.Webhook => 2,
        _ => 3
    };

    private Task BeginProviderHandoffAsync()
    {
        if (Active is null || _chosenPath is null) return Task.CompletedTask;
        _mode = ChannelSetupMode.Embedded;
        _stage = EmbeddedStage.Popup;
        _failure = null;
        _view = SetupView.Flow;
        Persist();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Meta has handed back the code. The three steps are walked one at a
    /// time with a pause between them, because this is the moment someone has
    /// just handed over access to their business account and a silent wait is
    /// the worst thing to show them. Only the first step is a Parrot call —
    /// the connection is created (or picked up) there; Parrot has no embedded
    /// signup, so the other two are pacing.
    /// </summary>
    private async Task CompleteProviderHandoffAsync()
    {
        if (Active is null) return;

        foreach (var stage in ChannelRoutes.ConnectingStages)
        {
            _stage = stage;
            Persist();
            await InvokeAsync(StateHasChanged);

            if (stage == EmbeddedStage.Linking && Active.Id == ChannelId.Whatsapp
                && !await RunAsync(EnsureSetupAsync, "We couldn't prepare your connection. Try again."))
            {
                _failure = _error;
                _error = null;
                _stage = EmbeddedStage.Failed;
                Persist();
                return;
            }

            await Task.Delay(ProviderStepPacing);
        }

        _stage = EmbeddedStage.ReadyToTest;
        _testStartedAt = DateTimeOffset.UtcNow;
        Persist();
    }

    private Task CloseProviderEarlyAsync()
    {
        if (Active is null) return Task.CompletedTask;
        var provider = ChannelRoutes.Popup(Active.Id).Provider;
        _failure = $"The {provider} window closed early. Nothing was changed.";
        _stage = EmbeddedStage.Failed;
        Persist();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Try again goes back to choosing how to connect, where WhatsApp's manual
    /// setup also lives, so the failure screen needs no third action. A
    /// channel with one route has nothing to choose, so its window reopens.
    /// </summary>
    private Task RetryAsync()
    {
        if (Active is null) return Task.CompletedTask;
        _failure = null;
        if (HasChoice(Active.Id))
        {
            _mode = null;
            _stage = EmbeddedStage.Idle;
            _chosenPath = null;
            _accepted = false;
            Persist();
            _view = SetupView.Choice;
            return Task.CompletedTask;
        }
        _stage = EmbeddedStage.Popup;
        Persist();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The only call that can mark a channel connected, because it is the only
    /// one that proves a real message arrived: Parrot's gRPC message check,
    /// polled for a short while, then the connection's status read back.
    /// </summary>
    private async Task VerifyAsync()
    {
        if (Active is null) return;
        if (Active.Id != ChannelId.Whatsapp)
        {
            await VerifyWindowChannelAsync(Active);
            return;
        }
        if (ChannelsState.WhatsAppSetup is not { } setup) return;

        // The pacing runs alongside the call rather than after it, so a slow
        // server costs nothing extra — the floor only applies when the answer
        // comes back faster than a person can read the spinner.
        _missed = false;
        _checking = true;
        await InvokeAsync(StateHasChanged);
        var pacing = Task.Delay(CheckPacing);
        var received = false;
        var ok = await RunAsync(async cancellation =>
        {
            var since = (_testStartedAt ?? DateTimeOffset.UtcNow).ToUnixTimeSeconds();
            for (var attempt = 0; attempt < CheckAttempts; attempt++)
            {
                var result = await MessageVerification.CheckForMessageAsync(
                    setup.Connection.Id.ToString(), since, "whatsapp", Token, cancellation);
                if (result.Received) { received = true; break; }
                await Task.Delay(CheckInterval, cancellation);
            }

            if (received)
            {
                ChannelsState.SetWhatsApp(await IntegrationsService.GetWhatsAppStatusAsync(setup.Connection.Id, Token, cancellation));
                ChannelsState.MarkWhatsAppVerified();
            }
        }, "We couldn't check for your message. Try again.");
        await pacing;
        _checking = false;

        if (!ok) { await InvokeAsync(StateHasChanged); return; }
        if (!received)
        {
            _missed = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await ConfirmConnectedAsync();
    }

    /// <summary>
    /// Instagram, Facebook and X connected by their window. Only demo mode can
    /// (IChannelCapabilities): the test message "arrives" after the same pause
    /// a real check takes, and the channel is connected for the session under
    /// the business's own handle. When the API can connect one of them, its
    /// window completion and message check replace this.
    /// </summary>
    private async Task VerifyWindowChannelAsync(BusinessChannel channel)
    {
        _checking = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(CheckPacing);
        _checking = false;
        ChannelsState.ConnectChannel(KeyOf(channel), DemoAccount(channel.Id), DateTimeOffset.UtcNow.ToString("O"));
        // Connecting clears the record; put it back, so the flow can show its result.
        Persist();
        await ConfirmConnectedAsync();
    }

    private string DemoAccount(ChannelId id)
    {
        var business = AuthState.CurrentUser?.BusinessName is { Length: > 0 } name ? name.Trim() : "Adire Lagos";
        var handle = "@" + new string(business.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        return id == ChannelId.Facebook ? business : handle;
    }

    // The result replaces the test where it stands, as the answer to "I've
    // sent it": no timed pause and no toast, because the result says it.
    private async Task ConfirmConnectedAsync()
    {
        // The embedded flow is driven by the stage the setup holds, which is
        // now Connected. The guided flow has no such stage, so it steps past
        // the last step to reach its own success screen.
        if (_view == SetupView.Guided) _step = GuidedSteps.Count;
        else _stage = EmbeddedStage.Connected;
        Persist();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Parrot's connection: the saved one if the backend has a live one,
    /// otherwise a new one under the name Parrot files it as. Either way the
    /// answer carries the callback URL and verify token Meta needs.
    /// </summary>
    private async Task EnsureSetupAsync(CancellationToken cancellation)
    {
        var setup = ChannelsState.WhatsAppConnection is { DisabledAt: null } connection
            ? await IntegrationsService.GetWhatsAppSetupAsync(connection.Id, Token, cancellation)
            : await IntegrationsService.CreateWhatsAppSetupAsync(WhatsAppConnectionName, Token, cancellation);
        ChannelsState.SetWhatsAppSetup(setup);
    }

    private Task ReloadSetupAsync() =>
        RunAsync(EnsureSetupAsync, "We couldn't load your connection. Try again to pick up where you left off.");

    /// <summary>Every write goes through here, so busy and error are handled once.</summary>
    private async Task<bool> RunAsync(Func<CancellationToken, Task> call, string failureMessage)
    {
        if (_disposed) return false;
        try
        {
            _busy = true;
            _error = null;
            await call(_lifetime.Token);
            return true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return false; }
        catch (OperationCanceledException)
        {
            _error = "That took too long. Try again.";
            return false;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Sign in again to continue.",
                System.Net.HttpStatusCode.Conflict => "Your connection is unavailable. Contact support to continue.",
                _ => failureMessage,
            };
            return false;
        }
        catch (RpcException ex)
        {
            _error = ex.StatusCode == StatusCode.Unauthenticated
                ? "Your session has expired. Sign in again to continue."
                : failureMessage;
            return false;
        }
        catch (System.Text.Json.JsonException) { _error = failureMessage; return false; }
        catch (InvalidOperationException) { _error = "Sign in to continue."; return false; }
        finally
        {
            _busy = false;
            Refresh();

            // Blazor renders an async handler when it first yields and again
            // when it completes — not at the awaits in between. The connecting
            // screen walks three steps inside one handler, so without this the
            // stages it exists to show are never drawn: the popup closes and
            // the page jumps straight to the message test.
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private void AskDisconnect(BusinessChannel channel) => _pendingDisconnect = channel;

    private void AskRestart(BusinessChannel channel) => _pendingRestart = channel;

    /// <summary>
    /// Start over clears the local progress — the route chosen, the step
    /// reached — and returns to the list of setup options. Parrot's backend
    /// keeps the connection itself, so nothing already saved to Meta is lost.
    /// </summary>
    private void RestartAsync()
    {
        if (_pendingRestart is null) return;
        var name = _pendingRestart.Name;
        ChannelsState.ResetSetup(_pendingRestart.Id);
        _pendingRestart = null;
        Refresh();
        Toasts.Show($"{name} setup was cleared. Choose how you want to connect.");
    }

    /// <summary>
    /// WhatsApp, Facebook, TikTok and Instagram are disabled on Parrot's backend,
    /// so their webhooks stop at once; the others are disconnected in state.
    /// </summary>
    private async Task DisconnectAsync()
    {
        if (_pendingDisconnect is null) return;
        var channel = _pendingDisconnect;
        var key = ChannelsState.Channels.First(c => c.Id == channel.Id).Key;

        var whatsApp = channel.Id == ChannelId.Whatsapp ? ChannelsState.WhatsAppConnection : null;
        var facebook = channel.Id == ChannelId.Facebook && ChannelsState.FacebookSetup is not null;
        var tikTok = channel.Id == ChannelId.TikTok && ChannelsState.TikTokSetup is not null;
        var instagram = channel.Id == ChannelId.Instagram && ChannelsState.InstagramSetup is not null;
        if (whatsApp is not null || facebook || tikTok || instagram)
        {
            if (_busy) return;
            _busy = true;
            try
            {
                var token = AuthState.CurrentUser?.Token ?? "";
                if (whatsApp is not null)
                    await IntegrationsService.DisableWhatsAppAsync(whatsApp.Id, token, _lifetime.Token);
                else if (tikTok)
                    await IntegrationsService.DisableTikTokAsync(token, _lifetime.Token);
                else if (instagram)
                    await IntegrationsService.DisableInstagramAsync(token, _lifetime.Token);
                else
                    await IntegrationsService.DisableFacebookAsync(token, _lifetime.Token);
                ChannelsState.DisconnectChannel(key);
                _pendingDisconnect = null;
                await LoadAsync();
                Toasts.Show($"{channel.Name} was disconnected.");
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
            catch (HttpRequestException)
            {
                _error = "We couldn't disconnect it. Try again.";
                _pendingDisconnect = null;
            }
            finally { _busy = false; }
            return;
        }

        ChannelsState.DisconnectChannel(key);
        _pendingDisconnect = null;
        Refresh();
        Toasts.Show($"{channel.Name} was disconnected.");
    }

    public void Dispose()
    {
        _accessToken = null;
        _appSecret = null;
        _disposed = true;
        AuthState.OnChange -= AuthChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
