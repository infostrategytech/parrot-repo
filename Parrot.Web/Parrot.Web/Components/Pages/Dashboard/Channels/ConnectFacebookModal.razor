@namespace Parrot.Web.Components.Pages.Dashboard.Channels

<ModalShell Visible="true" Title="Connect Facebook Messenger"
            Subtitle="Prepare your Facebook Page webhook in Meta." Size="md"
            ShowCloseButton="true" ShowDivider="true" OnClose="OnCancel">
    <BodyContent>
        <p>You’ll need a Facebook Page you manage and access to your Meta app’s Messenger API Settings.</p>
        <p>Parrot will provide a callback URL and verify token to copy into Meta. Page linking and sending are a separate step.</p>
        <button class="cws-primary-btn" @onclick="OnStartSetup">Configure webhook</button>
    </BodyContent>
</ModalShell>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnStartSetup { get; set; }
}
