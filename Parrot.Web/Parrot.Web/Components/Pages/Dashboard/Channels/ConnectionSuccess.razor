@namespace Parrot.Web.Components.Pages.Dashboard.Channels
@using Parrot.Web.Features.Dashboard.Channels.Models
@inject NavigationManager Nav
@inject ToastService Toasts

@* The end of every route. A real message arrived, so this is the only screen
   in the module allowed to say the channel is connected.

   It replaces the test card where it stands, in the same shape: the channel's
   own mark, now with a tick, and a heading the same size. Focus moves here,
   so a screen reader hears the result.

   Opened from the dashboard (?from=dashboard, Concept B): straight back to
   it with a toast instead, so the owner sees what is next on their list. *@

<section class="connected channel-@Channel.Id.ToString().ToLowerInvariant()"
         tabindex="-1" aria-labelledby="connected-title" @ref="_root">
    <span class="connected__mark">
        <ChannelIcon Channel="@Channel.Id.ToString()" Size="IconSize.Lg" OnBrand />
        <span class="connected__badge"><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Sm" /></span>
    </span>

    <Typography TextStyle="TextStyle.HeadingH2Bold" As="h1" id="connected-title">@Channel.Name is connected</Typography>

    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="connected__lede">
        We received your Hello. New messages sent to
        <strong>@ChannelRoutes.KeepTogether(Channel.AccountName ?? Channel.Name)</strong> will now appear in your inbox.
    </Typography>

    @if (Channel.Attention is { } note)
    {
        @* Connected, with a caveat — a temporary token that will expire, most
           often. Worth saying now rather than when it breaks. *@
        <div class="connected__note">
            <Icon Name="IconName.RiTimeFill" Size="IconSize.Sm" />
            <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>@note</Typography>
        </div>
    }

    @* Sent here to connect a channel for an agent ("Connect a channel first"):
       the way back to it comes first. *@
    <div class="connected__actions">
        @if (OnSetUpAgent.HasDelegate)
        {
            <Button @onclick="OnSetUpAgent">Set up your agent</Button>
        }
        else
        {
            <Button @onclick="OnOpenInbox">Open inbox</Button>
        }
        <Button Variant="ButtonVariant.Secondary" @onclick="OnConnectAnother">Connect another channel</Button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public BusinessChannel Channel { get; set; } = default!;

    [Parameter] public EventCallback OnOpenInbox { get; set; }

    [Parameter] public EventCallback OnConnectAnother { get; set; }

    /// <summary>Set when the person came to connect a channel for an agent.</summary>
    [Parameter] public EventCallback OnSetUpAgent { get; set; }

    private ElementReference _root;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (FromDashboard)
        {
            Toasts.Show($"{Channel.Name} is connected. Here's what's next.");
            Nav.NavigateTo("/dashboard");
            return;
        }
        await _root.FocusAsync(preventScroll: true);
    }

    private bool FromDashboard =>
        new Uri(Nav.Uri).Query.TrimStart('?').Split('&').Contains("from=dashboard");
}
