@namespace Parrot.Web.Components.Pages.Dashboard.Channels
@using Parrot.Web.Features.Dashboard.Channels.Models
@using Parrot.Web.Features.Dashboard.Channels.Services
@inject IChannelCapabilities Capabilities

@* One channel on the landing screen: what it is, where its connection stands,
   and the single next thing to do about it. *@

<article class="channel-card channel-@Channel.Id.ToString().ToLowerInvariant()">
    <span class="channel-card__mark">
        <ChannelIcon Channel="@Channel.Id.ToString()" Size="IconSize.Lg" OnBrand />
    </span>

    <div class="channel-card__copy">
        <div class="channel-card__title">
            <Typography TextStyle="TextStyle.BodyDefaultBold" As="h2" Prose>@Channel.Name</Typography>
            <Typography TextStyle="TextStyle.Small10Semibold" As="span" Class="@StatusClass">@StatusLabel</Typography>
        </div>

        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="channel-card__description">
            @Channel.Description
        </Typography>

        <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose Class="channel-card__meta">
            @MetaLine
        </Typography>
    </div>

    <div class="channel-card__actions">
        @if (IsConnected)
        {
            @if (Capabilities.CanDisconnect(Channel.Id))
            {
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OnDisconnect">Disconnect</Button>
            }
            <span class="channel-card__ready">
                <Icon Name="IconName.RiCheckFill" Size="IconSize.Sm" />
                <Typography TextStyle="TextStyle.Small12Semibold" As="span">Ready</Typography>
            </span>
        }
        else if (!Available)
        {
            @* Nothing to start yet: no button, so nothing pretends to connect. *@
        }
        else
        {
            @* A half-finished setup is locked to the route it started on, so
               without this there is no way back to the other two — you would
               have to finish a method you have already decided against. *@
            @if (InProgress)
            {
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="OnStartOver">
                    Start over
                </Button>
            }

            @* Secondary, not Primary: the card action is an outlined white
               pill, not a filled brand button. Size, padding, height and
               hover are all the design system's — the only thing this page
               adds is a floor on the width. *@
            <Button Variant="ButtonVariant.Secondary" Class="channel-card__action" disabled="@ActionDisabled" @onclick="OnOpen">
                <ChildContent>@ActionLabel</ChildContent>
                <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
            </Button>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public BusinessChannel Channel { get; set; } = default!;

    [Parameter] public EventCallback OnOpen { get; set; }

    [Parameter] public EventCallback OnDisconnect { get; set; }

    /// <summary>Abandons a half-finished setup so another route can be chosen.</summary>
    [Parameter] public EventCallback OnStartOver { get; set; }

    /// <summary>
    /// Parrot only: a WhatsApp connection the backend has disabled cannot be
    /// set up again from here, so the action stays but does nothing.
    /// </summary>
    [Parameter] public bool ActionDisabled { get; set; }

    private bool IsConnected => Channel.Status == ChannelStatus.Connected;

    /// <summary>Something can connect it now: its window, or a manual setup. Otherwise it is coming soon.</summary>
    private bool Available => Capabilities.CanUseWindow(Channel.Id) || Capabilities.CanSetUpManually(Channel.Id);
    private bool NeedsAttention => Channel.Status == ChannelStatus.NeedsAttention;

    /// <summary>Started but not finished. Worth saying, because it changes the button.</summary>
    private bool InProgress => !IsConnected && !NeedsAttention && Channel.Setup.Mode is not null;


    private string StatusLabel =>
        IsConnected ? "Connected"
        : !Available ? "Coming soon"
        : NeedsAttention ? "Needs attention"
        : InProgress ? "Setup in progress"
        : "Not connected";

    private string StatusClass =>
        IsConnected ? "channel-card__status is-connected"
        : NeedsAttention ? "channel-card__status is-attention"
        : "channel-card__status is-not-connected";

    /// <summary>
    /// The most useful line for where this channel actually stands: what is
    /// wrong, or which account is live, or what setup will cost you.
    /// </summary>
    private string? MetaLine =>
        NeedsAttention ? Channel.Attention
        : IsConnected ? Channel.AccountName
        : !Available ? "You'll be able to connect it here soon."
        : Channel.Id == ChannelId.Whatsapp && Capabilities.CanUseWindow(Channel.Id)
            ? "Connect with Facebook · about 5 minutes"
            : Channel.GuidedMinutes > 0
                ? $"You'll need: {Channel.Requirement} · about {Channel.GuidedMinutes} minutes"
                : $"You'll need: {Channel.Requirement}";

    private string ActionLabel =>
        NeedsAttention ? "Fix connection"
        : InProgress ? "Continue setup"
        : "Start setup";
}
