@page "/dashboard/channels/connect-instagram"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Channels
@using Parrot.Web.Features.Dashboard.Channels.Models
@inject ChannelsState ChannelsState
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Connect Instagram · OmniAI</PageTitle>

@* Parrot's Instagram setup. It has no backend yet — the two steps are the
   same state-only walk they always were — drawn as Aurora's guided card, with
   Aurora's stand-in for the provider window where the old page showed a
   "redirecting" overlay, and Aurora's success screen at the end. *@

<div class="channels channels--setup">
    @if (_done)
    {
        <ConnectionSuccess Channel="Channel"
                           OnOpenInbox="@(() => Nav.NavigateTo("/dashboard/conversations"))"
                           OnConnectAnother="Back">
            <Lede>Your channel is now active and ready to receive customer messages.</Lede>
        </ConnectionSuccess>
    }
    else
    {
        <section class="guided">
            <header class="guided__header">
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="GuidedBack">
                    <IconLeft><Icon Name="IconName.RiArrowLeftLine" /></IconLeft>
                    <ChildContent>@(_step == 0 ? "Cancel" : "Back")</ChildContent>
                </Button>
                <div class="guided__counter">
                    <Typography TextStyle="TextStyle.Small12Medium" As="span">Instagram setup</Typography>
                    <Typography TextStyle="TextStyle.Small12Semibold" As="strong">Step @(_step + 1) of @Steps.Length</Typography>
                </div>
            </header>

            <div class="guided__progress" role="progressbar" aria-valuenow="@(_step + 1)" aria-valuemin="1" aria-valuemax="@Steps.Length">
                <i style="width: @Percent%"></i>
            </div>

            <div class="guided__body">
                <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">@Steps[_step]</Typography>

                @if (_step == 0)
                {
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        Connect your Instagram account to authorize access.
                    </Typography>

                    @if (_igConnected)
                    {
                        <ul class="guided__requirements">
                            <li>
                                <Icon Name="IconName.RiInstagramFill" Size="IconSize.Md" Class="guided__instagram" />
                                <span class="guided__requirement-copy">
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong" Prose>&#64; Chioma J. Udeze</Typography>
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="small" Prose>Instagram Business Account</Typography>
                                </span>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                            Click the button below to open Meta's authorization page. You'll be asked to grant
                            permissions for messaging access.
                        </Typography>
                    }

                    <ol class="guided__instructions">
                        @foreach (var (instruction, number) in Numbered(_igConnected ? ConnectedChecks : SignInChecks))
                        {
                            <li>
                                <Typography TextStyle="TextStyle.Small12Bold" As="span" Class="guided__marker">@number</Typography>
                                <div class="guided__instruction">
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>@instruction</Typography>
                                </div>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        We need to confirm your account is a Business or Creator account.
                    </Typography>
                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="guided__lede">
                        Instagram messaging requires a Business or Creator account linked to a Facebook
                        Page. Click below to verify your account type.
                    </Typography>

                    <ol class="guided__instructions">
                        @foreach (var (instruction, number) in Numbered(VerifyChecks))
                        {
                            <li>
                                <Typography TextStyle="TextStyle.Small12Bold" As="span" Class="guided__marker">@number</Typography>
                                <div class="guided__instruction">
                                    <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>
                                        <Emphasis Text="@instruction" />
                                    </Typography>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>

            <footer class="guided__footer">
                <Button Variant="ButtonVariant.Secondary" @onclick="Back">Save and exit</Button>

                @if (_step == 0 && !_igConnected)
                {
                    <Button @onclick="() => _showProvider = true">
                        <ChildContent>Continue to Meta</ChildContent>
                        <IconRight><Icon Name="IconName.RiExternalLinkLine" /></IconRight>
                    </Button>
                }
                else if (_step == 0)
                {
                    <Button @onclick="Step1Next">
                        <ChildContent>Next</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                }
                else if (_step2Verified)
                {
                    <Button @onclick="ConnectInstagram">
                        <ChildContent>Connect</ChildContent>
                        <IconRight><Icon Name="IconName.RiArrowRightLine" /></IconRight>
                    </Button>
                }
                else
                {
                    <Button Busy="@_step2Loading" @onclick="VerifyAccountType">
                        <ChildContent>Verify account type</ChildContent>
                        <IconRight><Icon Name="IconName.RiCheckFill" /></IconRight>
                    </Button>
                }
            </footer>
        </section>
    }
</div>

@if (_showProvider)
{
    <ProviderPopup Channel="Channel"
                   OnCancel="() => _showProvider = false"
                   OnComplete="SignInWithInstagram" />
}

@code {
    private static readonly string[] Steps = ["Sign in to Instagram", "Verify Account Type"];

    private static readonly string[] SignInChecks =
    [
        "Make sure you're logged into the correct Meta account",
        "You need an Instagram Business account, not Personal",
        "Grant all requested permissions for full functionality"
    ];

    private static readonly string[] ConnectedChecks =
    [
        "Make sure you're logged into the correct Instagram account",
        "You'll be redirected to Meta for authorization",
        "Grant all requested permissions for full functionality"
    ];

    private static readonly string[] VerifyChecks =
    [
        "Your Instagram must be a Business or Creator account",
        "It must be linked to a Facebook Page",
        "You can switch from Personal in Instagram settings → **Account** → **Switch to Professional**"
    ];

    private int _step;
    private bool _igConnected;
    private bool _showProvider;
    private bool _step2Loading;
    private bool _step2Verified;
    private bool _done;

    private BusinessChannel Channel =>
        ChannelsState.Workspace.Channels.First(c => c.Id == ChannelId.Instagram);

    private int Percent => (int)Math.Round((_step + 1) / (double)Steps.Length * 100);

    private static IEnumerable<(string, int)> Numbered(IEnumerable<string> items) =>
        items.Select((item, index) => (item, index + 1));

    private void SignInWithInstagram()
    {
        _showProvider = false;
        _igConnected = true;
        Toasts.Show("Instagram account connected");
    }

    private void Step1Next() => _step = 1;

    private async Task VerifyAccountType()
    {
        _step2Loading = true;
        StateHasChanged();
        await Task.Delay(2000);
        _step2Loading = false;
        _step2Verified = true;
        Toasts.Show("Business account confirmed messaging is available");
    }

    private async Task ConnectInstagram()
    {
        ChannelsState.ConnectChannel("instagram", "@chiomajudeze", "15th May 2026");
        await Task.Delay(200);
        _done = true;
    }

    private void GuidedBack()
    {
        if (_step == 0) Back();
        else _step -= 1;
    }

    private void Back() => Nav.NavigateTo("/dashboard/channels");
}
