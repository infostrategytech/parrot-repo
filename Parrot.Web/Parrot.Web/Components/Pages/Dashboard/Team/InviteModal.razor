@namespace Parrot.Web.Components.Pages.Dashboard.Team

@* An invitation, in Aurora's Dialog. The role picks the permissions; each
   one is a real Checkbox so it can be adjusted before the invite goes. *@

<Dialog Open="true"
        Title="Invite team member"
        ConfirmLabel="Send invitation"
        ConfirmDisabled="@(!_canSend)"
        OnConfirm="HandleSend"
        OnCancel="OnCancel">
    <GlyphContent><Icon Name="IconName.RiUserAddFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="invite__lede">
            They will receive an email invitation to join your workspace.
        </Typography>

        <div class="invite__form">
            <Input FloatingLabel="Full name" @bind-Value="_fullName" maxlength="80" required />
            <Input FloatingLabel="Email address" Type="email" @bind-Value="_email" required />

            <SelectField FloatingLabel="Workspace role"
                         Value="@(string.IsNullOrEmpty(_selectedRole) ? null : _selectedRole)"
                         Open="_roleOpen"
                         OpenChanged="@(open => _roleOpen = open)">
                @foreach (var role in WorkspaceRoles.All)
                {
                    <PopoverOption Label="@role"
                                   Active="@(_selectedRole == role)"
                                   OnSelect="() => SelectRole(role)" />
                }
            </SelectField>
        </div>

        <section class="invite__permissions">
            <Typography TextStyle="TextStyle.Small12Semibold" As="h3">Role permissions</Typography>
            @if (string.IsNullOrEmpty(_selectedRole))
            {
                <Typography TextStyle="TextStyle.Small12Regular" As="p" Prose Class="invite__placeholder">
                    Select a role to define permissions.
                </Typography>
            }
            else
            {
                <div class="invite__permission-list">
                    @foreach (var perm in _permissions)
                    {
                        <Checkbox State="@(perm.Enabled ? CheckboxState.Checked : CheckboxState.Unchecked)"
                                  StateChanged="@(state => perm.Enabled = state == CheckboxState.Checked)"
                                  Label="@perm.Label" />
                    }
                </div>
            }
        </section>
    </Body>
</Dialog>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TeamMember> OnSend { get; set; }

    string _fullName = string.Empty;
    string _email = string.Empty;
    string _selectedRole = string.Empty;
    bool _roleOpen;
    List<RolePermission> _permissions = [];

    bool _canSend => !string.IsNullOrWhiteSpace(_fullName)
        && !string.IsNullOrWhiteSpace(_email)
        && !string.IsNullOrEmpty(_selectedRole);

    void SelectRole(string role)
    {
        _selectedRole = role;
        _permissions = WorkspaceRoles.GetPermissions(_selectedRole);
        _roleOpen = false;
    }

    async Task HandleSend()
    {
        if (!_canSend) return;
        var member = new TeamMember
        {
            Id = Guid.NewGuid().ToString(),
            FullName = _fullName,
            Email = _email,
            Role = _selectedRole
        };
        await OnSend.InvokeAsync(member);
    }
}
