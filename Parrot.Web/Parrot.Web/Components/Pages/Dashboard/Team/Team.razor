@page "/dashboard/team"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Team
@using Parrot.Web.Components.Pages.Dashboard.Team

<PageTitle>Team · OmniAI</PageTitle>

@* The people in the workspace. Same page frame as Aurora's Products page:
   a heading with its action, then an empty state or a table. *@

<div class="team">
    <header class="team__header">
        <div class="team__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Team</Typography>
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="team__lede">
                Invite your team to help manage conversations and monitor activity.
            </Typography>
        </div>

        <div class="team__actions">
            <Button @onclick="OpenInvite">
                <IconLeft><Icon Name="IconName.RiUserAddFill" /></IconLeft>
                <ChildContent>Invite team member</ChildContent>
            </Button>
        </div>
    </header>

    @if (_members.Count == 0)
    {
        <EmptyState Glyph="IconName.RiTeamFill"
                    Title="No team members yet"
                    Description="Invite your team to help manage conversations and monitor activity.">
            <Action>
                <Button @onclick="OpenInvite">
                    <IconLeft><Icon Name="IconName.RiUserAddFill" /></IconLeft>
                    <ChildContent>Add team member</ChildContent>
                </Button>
            </Action>
        </EmptyState>
    }
    else
    {
        <section class="team__table-wrap">
            <div class="team__table" role="table" aria-label="Team members">
                <div class="team__table-head" role="row">
                    @foreach (var column in Columns)
                    {
                        <Typography TextStyle="TextStyle.Small10Semibold"
                                    As="span"
                                    Class="ds-overline"
                                    role="columnheader">@column</Typography>
                    }
                </div>

                <div class="team__table-body">
                    @foreach (var member in _members)
                    {
                        <article class="team-row" role="row">
                            <div class="team-row__name" role="cell">
                                <PetalAvatar Seed="@member.Id" Initials="@Initials.From(member.FullName)" Size="AvatarSize.Sm" />
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong" Prose>@member.FullName</Typography>
                            </div>
                            <Typography TextStyle="TextStyle.Small12Regular" As="span" Prose Class="team-row__email" role="cell">
                                @member.Email
                            </Typography>
                            <div class="team-row__role" role="cell">
                                <StatusBadge Tone="StatusTone.Brand">@member.Role</StatusBadge>
                            </div>
                            <div class="team-row__status" role="cell">
                                <StatusBadge Tone="StatusTone.Warning" Glyph="IconName.RiMailFill">Invited</StatusBadge>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
</div>

@if (_showInvite)
{
    <InviteModal OnCancel="CloseInvite" OnSend="HandleInviteSent" />
}

@code {
    private static readonly string[] Columns = ["Name", "Email", "Workspace role", "Status"];

    List<TeamMember> _members = [];
    bool _showInvite;

    void OpenInvite() => _showInvite = true;
    void CloseInvite() => _showInvite = false;

    void HandleInviteSent(TeamMember member)
    {
        _members.Add(member);
        _showInvite = false;
    }
}
