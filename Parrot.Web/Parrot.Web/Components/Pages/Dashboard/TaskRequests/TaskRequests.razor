@page "/dashboard/tasks"
@page "/dashboard/tasks/{TaskId}"
@attribute [RequiresAccess(AccessRules.Tasks)]
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.TaskRequests
@using Parrot.Web.Features.Dashboard.TaskRequests
@using Parrot.Web.Features.Dashboard.AiAgents.State
@implements IDisposable
@inject ITaskStore Store
@inject AiAgentsState Agents
@inject Parrot.Web.Services.UserClock Clock
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Tasks · yára</PageTitle>

@* Tasks (designer, 20 October 2026): one list of what needs doing for customers, like a ticket queue.
   An agent raises a task when a conversation needs a person (an order to confirm, a quote to send);
   anyone on the team can add one. The title says the action, so the list reads as a to-do list.
   Nothing leaves the list on its own: a task stays where it is until someone moves it.
   The views are drawn as Products & Services and Settings draw theirs; Mine and Unassigned only appear
   once the business has a team. *@
<main class="tasks">
    <header class="tasks__header">
        <div class="tasks__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Tasks</Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="tasks__lede">
                What needs doing for your customers, raised by your agents or added by your team.
            </Typography>
        </div>
        @if (Store.Available)
        {
            <Button @onclick="() => _creating = true">
                <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                <ChildContent>New task</ChildContent>
            </Button>
        }
    </header>

    @if (!Store.Available)
    {
        @* Real mode until the backend keeps tasks: said plainly, nothing made up. *@
        <DataTable Label="Tasks">
            <Message>
                <EmptyState Glyph="IconName.RiClipboardFill"
                            Title="Tasks are on the way"
                            Description="When an agent needs you to act on a conversation, such as an order to confirm or a quote to send, it will show here, with anything your team adds." />
            </Message>
        </DataTable>
    }
    else if (_tasks is null && _loadError is not null)
    {
        <DataTable Label="Tasks">
            <Message>
                <EmptyState Glyph="IconName.RiAlertFill" Title="Your tasks couldn't be loaded" Description="Check your connection and try again.">
                    <Action><Button Variant="ButtonVariant.Secondary" @onclick="RetryAsync">Try again</Button></Action>
                </EmptyState>
            </Message>
        </DataTable>
    }
    else if (_tasks is null)
    {
        <DataTable Label="Tasks">
            <Message><LoadingState Glyph="IconName.RiClipboardFill" Title="Getting your tasks" /></Message>
        </DataTable>
    }
    else
    {
        @if (CustomerScope.Count > 0)
        {
            <div class="tasks__customer-scope">
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p">Tasks for @ScopeName</Typography>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="ClearCustomerScope">Clear customer filter</Button>
            </div>
        }
        <section class="tasks__controls">
            <Tabs Label="Which tasks" Variant="TabsVariant.Tray">
                @foreach (var view in Views)
                {
                    var current = view;
                    <Tab Selected="@(_view == current)" Count="@InView(current).Count().ToString()" OnClick="() => Show(current)">
                        <Typography TextStyle="TextStyle.Small12Medium" As="span">@ViewLabel(current)</Typography>
                    </Tab>
                }
            </Tabs>
            <div class="tasks__tools">
                <SearchField Value="@_search" ValueChanged="value => { _search = value ?? string.Empty; _page = 1; }"
                             Placeholder="Search tasks or customers" AriaLabel="Search tasks" Class="tasks__search" />
                <FilterPopover Label="@(_kind is { } kind ? TaskWords.Label(kind) : "All types")"
                               Title="Type" Subtitle="What the task is about" AlignEnd
                               Open='@(_openMenu == "kind")' OpenChanged="@(open => _openMenu = open ? "kind" : null)">
                    <PopoverOption Label="All types" Active="_kind is null" OnSelect="() => PickKind(null)" />
                    @foreach (var kind in TaskWords.Kinds)
                    {
                        var current = kind;
                        @* Filtering, not choosing: the type names are enough here.
                           NewTaskDialog keeps the descriptions, because picking a
                           type for a new task is a choice with a consequence. *@
                        <PopoverOption Label="@TaskWords.Label(current)"
                                       Active="@(_kind == current)" OnSelect="() => PickKind(current)">
                            <Leading><TaskKindMark Kind="current" Small /></Leading>
                        </PopoverOption>
                    }
                </FilterPopover>
                @if (HasTeam)
                {
                    <FilterPopover Label="@(_person?.Name ?? "Anyone")" Title="Assignee" Subtitle="Who is on it" AlignEnd
                                   Open='@(_openMenu == "person")' OpenChanged="@(open => _openMenu = open ? "person" : null)">
                        <PopoverOption Label="Anyone" Active="_person is null" OnSelect="() => PickPerson(null)" />
                        @foreach (var member in _team)
                        {
                            var current = member;
                            <PopoverOption Label="@(current.Id == Store.Me.Id ? $"{current.Name} (you)" : current.Name)"
                                           Active="@(_person?.Id == current.Id)" OnSelect="() => PickPerson(current)">
                                <Leading><PetalAvatar Seed="@current.Id" Initials="@Initials.From(current.Name)" Size="AvatarSize.Sm" /></Leading>
                            </PopoverOption>
                        }
                    </FilterPopover>
                }
            </div>
        </section>

        @if (Shown.Count == 0)
        {
            <DataTable Label="@ViewLabel(_view)" Notice="@(_loadError is null ? null : LoadErrorNotice)">
                <Message>
                @if (Filtering)
                {
                    <EmptyState Size="EmptyStateSize.Panel" Glyph="IconName.RiSearch2Fill" Title="No tasks match"
                                Description="Try other words, or clear the filters.">
                        <Action><Button Variant="ButtonVariant.Secondary" @onclick="ClearFilters">Clear filters</Button></Action>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Size="EmptyStateSize.Panel" Glyph="@EmptyGlyph" Title="@EmptyTitle" Description="@EmptyText" />
                }
                </Message>
            </DataTable>
        }
        else
        {
            <DataTable Label="@ViewLabel(_view)" Notice="@(_loadError is null ? null : LoadErrorNotice)">
                <ChildContent>
                    <TaskRow Head Team="TeamForRows" Me="Store.Me" />
                    @foreach (var task in Shown.Skip((CurrentPage - 1) * PageSize).Take(PageSize))
                    {
                        <TaskRow Item="task" Now="_now" Zone="Clock.Zone" Look="@TaskWords.AgentLook(task, Agents.Agents)"
                                 Team="TeamForRows" Me="Store.Me"
                                 Open="@(task.Id == TaskId)" Fresh="@(task.Id == _fresh)"
                                 MenuOpen="@(_openMenu == "state-" + task.Id)"
                                 MenuOpenChanged="@(open => _openMenu = open ? "state-" + task.Id : null)"
                                 AssignOpen="@(_openMenu == "assign-" + task.Id)"
                                 AssignOpenChanged="@(open => _openMenu = open ? "assign-" + task.Id : null)"
                                 OnOpen="() => OpenTask(task)" OnState="state => SetStateAsync(task, state)"
                                 OnAssign="person => AssignAsync(task, person)"
                                 StatusBusy="@_saving.Contains("state-" + task.Id)" AssignBusy="@_saving.Contains("assign-" + task.Id)" />
                    }
                </ChildContent>
                @* The count, always; the pages when there are more than one. *@
                <Footer><Pagination Page="CurrentPage" PageChanged="page => _page = page" Total="Shown.Count" PageSize="PageSize" AriaLabel="Pages of tasks" /></Footer>
            </DataTable>
        }
    }
</main>

<TaskPanel Item="Selected" Now="_now" Team="TeamForRows"
           Look="@(Selected is { } open ? TaskWords.AgentLook(open, Agents.Agents) : null)"
           OnClose="ClosePanel" />

<NewTaskDialog Open="_creating" OnClose="() => _creating = false" OnCreated="CreatedAsync" />

@code {
    private enum View { All, Mine, Unassigned, Waiting, Closed }
    private const int PageSize = 25;

    /// <summary>The task whose panel is open, from the route.</summary>
    [Parameter] public string? TaskId { get; set; }
    [SupplyParameterFromQuery(Name = "conversation")] public string[]? ConversationIds { get; set; }
    [SupplyParameterFromQuery(Name = "customer")] public string? CustomerName { get; set; }
    /// <summary>A link can open a view: "?view=mine" from the bell's "3 tasks have been assigned to you".</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewName { get; set; }
    private string? _viewKey;
    private HashSet<string> CustomerScope { get; set; } = [];
    private string ScopeName => string.IsNullOrWhiteSpace(CustomerName) ? "this customer" : CustomerName;
    private string ScopedListUrl => CustomerTaskScope.Url(ScopeName, CustomerScope);
    private string? _scopeKey;

    private IReadOnlyList<TaskRequest>? _tasks;
    private IReadOnlyList<TaskPerson> _team = [];
    private DateTime _now = DateTime.UtcNow;
    private View _view = View.All;
    private string _search = string.Empty;
    private TaskKind? _kind;
    private TaskPerson? _person;
    private string? _openMenu;
    private bool _creating;
    private string? _fresh;
    private int _page = 1;
    private int CurrentPage => Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(Shown.Count / (double)PageSize)));

    /// <summary>Two people or more: a team, so tasks can be given to someone.</summary>
    private bool HasTeam => _team.Count > 1;
    private IReadOnlyList<TaskPerson> TeamForRows => HasTeam ? _team : [];

    private IEnumerable<View> Views => HasTeam
        ? [View.All, View.Mine, View.Unassigned, View.Waiting, View.Closed]
        : [View.All, View.Waiting, View.Closed];

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        Clock.Changed += OnClockChanged;
        if (!Store.Available) return;
        // Without the team, assigning stays hidden; the tasks still show.
        try { _team = await Store.TeamAsync(); }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception)) { _team = []; }
        await LoadAsync();
        // The agents' looks, for the tasks they raised.
        try { await Agents.LoadAsync(); }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception)) { }
    }

    // "Today" is the person's today: their browser says which zone that is.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Clock.ReadAsync();
    }

    protected override void OnParametersSet()
    {
        CustomerScope = (ConversationIds ?? []).Where(id => !string.IsNullOrWhiteSpace(id)).ToHashSet();
        var key = string.Join("|", CustomerScope.Order());
        if (_scopeKey != key) { _scopeKey = key; _page = 1; }
        // Only when the link's view changes, so a tab the person picks afterwards stays picked. A view this
        // workspace doesn't show (Mine without a team) leaves the page on All.
        if (_viewKey != ViewName)
        {
            _viewKey = ViewName;
            if (Enum.TryParse<View>(ViewName, true, out var linked) && Views.Contains(linked)) { _view = linked; _page = 1; }
        }
        // A task opened by its link shows in a view that has it.
        if (Selected is { } task && !InView(_view).Contains(task)) _view = task.IsClosed ? View.Closed : View.All;
    }

    // A list that can't be read says so, with Try again; one that can't be refreshed keeps what's showing.
    private string? _loadError;

    private async Task LoadAsync()
    {
        try
        {
            _tasks = await Store.ListAsync();
            _loadError = null;
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            _loadError = "The list couldn't be refreshed. Check your connection and try again.";
        }
        _now = DateTime.UtcNow;
    }

    private Task RetryAsync()
    {
        _loadError = null;
        return LoadAsync();
    }

    private RenderFragment LoadErrorNotice => @<InlineError Message="@_loadError">
        <Action><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="RetryAsync">Try again</Button></Action>
    </InlineError>;

    private void OnStoreChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    private TaskRequest? Selected => TaskId is null ? null : _tasks?.FirstOrDefault(t => t.Id == TaskId);

    private IEnumerable<TaskRequest> InView(View view) => (_tasks ?? [])
        .Where(task => CustomerScope.Count == 0 || task.Customer?.ConversationId is { } id && CustomerScope.Contains(id))
        .Where(t => view switch
    {
        View.All => t.IsOpen,
        View.Mine => t.IsOpen && t.Assignee?.Id == Store.Me.Id,
        View.Unassigned => t.IsOpen && t.Assignee is null,
        View.Waiting => t.State == TaskState.Waiting,
        _ => t.IsClosed,
    });

    private static string ViewLabel(View view) => view switch
    {
        View.All => "All open",
        View.Mine => "Mine",
        View.Unassigned => "Unassigned",
        View.Waiting => "Waiting on customer",
        _ => "Closed",
    };

    private bool Filtering => _search.Trim().Length > 0 || _kind is not null || _person is not null || CustomerScope.Count > 0;

    // What needs acting on first, then urgent, then what's late or due soonest, then the oldest: first
    // come, first served, so a task nobody has touched rises rather than sinks. Closed shows the latest first.
    private IReadOnlyList<TaskRequest> Shown
    {
        get
        {
            var query = _search.Trim();
            var tasks = InView(_view).Where(t => (_kind is null || t.Kind == _kind) && (_person is null || t.Assignee?.Id == _person.Id) &&
                (query.Length == 0 || $"{t.Title} {t.Customer?.Name} {t.RaisedBy} {t.Assignee?.Name} {t.Id} {t.Summary}".Contains(query, StringComparison.CurrentCultureIgnoreCase)));
            return _view == View.Closed
                ? tasks.OrderByDescending(t => t.LastActivityAt).ToList()
                : tasks.OrderBy(t => t.NeedsAction ? 0 : 1).ThenBy(t => t.Urgent ? 0 : 1).ThenBy(t => t.DueAt ?? DateTime.MaxValue).ThenBy(t => t.RaisedAt).ToList();
        }
    }

    private IconName EmptyGlyph => _view == View.Closed ? IconName.RiCheckboxCircleFill : IconName.RiClipboardFill;

    private string EmptyTitle => _view switch
    {
        View.All => "Nothing to do right now",
        View.Mine => "Nothing on your list",
        View.Unassigned => "Everything has someone on it",
        View.Waiting => "Not waiting on anyone",
        _ => "Nothing closed yet",
    };

    private string EmptyText => _view switch
    {
        View.All => "When an agent needs you to act on a conversation, or someone adds a task, it shows here.",
        View.Mine => "Tasks given to you show here.",
        View.Unassigned => "New tasks nobody has taken on show here.",
        View.Waiting => "When you've asked a customer something and are waiting to hear back, set the task to Waiting on customer.",
        _ => "Done and cancelled tasks are kept here.",
    };

    private void Show(View view)
    {
        _view = view;
        _openMenu = null;
        _page = 1;
    }

    private void PickKind(TaskKind? kind)
    {
        _kind = kind;
        _openMenu = null;
        _page = 1;
    }

    private void PickPerson(TaskPerson? person)
    {
        _person = person;
        _openMenu = null;
        _page = 1;
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _kind = null;
        _person = null;
        if (CustomerScope.Count > 0) ClearCustomerScope();
    }

    private void ClearCustomerScope() => Nav.NavigateTo("/dashboard/tasks");

    private void OpenTask(TaskRequest task)
    {
        _openMenu = null;
        var query = Nav.ToAbsoluteUri(ScopedListUrl).Query;
        Nav.NavigateTo($"/dashboard/tasks/{Uri.EscapeDataString(task.Id)}{query}");
    }

    private void ClosePanel() => Nav.NavigateTo(ScopedListUrl);

    // Changes saving now, by row and kind ("state-OM-10987"): their menus wait until it's done.
    private readonly HashSet<string> _saving = [];

    // A change saved, or said that it wasn't, with Try again (designer, 21 October 2026). Nothing on screen
    // changes until the server has it, so a failure leaves the task as it was.
    private async Task<bool> SaveAsync(string key, Func<Task> change, string failed, Func<Task> retry)
    {
        if (!_saving.Add(key)) return false;
        try
        {
            await change();
            return true;
        }
        catch (Exception exception) when (AiAgentsState.IsFailure(exception))
        {
            Toasts.Show(new ToastMessage(failed, "Check your connection and try again.", ToastStatus.Error, "Try again", () => _ = InvokeAsync(retry)));
            return false;
        }
        finally
        {
            _saving.Remove(key);
        }
    }

    // From the row's status menu. A task that moves to another view says where it went, with Undo.
    private async Task SetStateAsync(TaskRequest task, TaskState state)
    {
        _openMenu = null;
        var before = task.State;
        if (before == state) return;
        if (!await SaveAsync("state-" + task.Id, () => Store.SetStateAsync(task.Id, state),
                TaskWords.StateFailed(state, task.IsClosed), () => SetStateAsync(task, state))) return;
        var moved = state switch
        {
            TaskState.Done => "Marked done.",
            TaskState.Cancelled => "Cancelled.",
            TaskState.Waiting => "Moved to Waiting on customer.",
            _ when before is TaskState.Done or TaskState.Cancelled => "Opened again.",
            _ => null,
        };
        if (moved is not null)
            Toasts.Show(new ToastMessage(moved, ActionLabel: "Undo", OnAction: () => _ = InvokeAsync(() => UndoStateAsync(task, before))));
    }

    private Task UndoStateAsync(TaskRequest task, TaskState before) =>
        SaveAsync("state-" + task.Id, () => Store.SetStateAsync(task.Id, before), "Couldn't undo that.", () => UndoStateAsync(task, before));

    private Task UndoAssignAsync(TaskRequest task, TaskPerson? before) =>
        SaveAsync("assign-" + task.Id, () => Store.AssignAsync(task.Id, before), "Couldn't undo that.", () => UndoAssignAsync(task, before));

    private async Task AssignAsync(TaskRequest task, TaskPerson? person)
    {
        _openMenu = null;
        var before = task.Assignee;
        if (before?.Id == person?.Id) return;
        if (!await SaveAsync("assign-" + task.Id, () => Store.AssignAsync(task.Id, person),
                TaskWords.AssignFailed(person, Store.Me.Id), () => AssignAsync(task, person))) return;
        var said = person is null ? "Unassigned." : person.Id == Store.Me.Id ? "It's yours." : $"Given to {person.Name}.";
        Toasts.Show(new ToastMessage(said, ActionLabel: "Undo", OnAction: () => _ = InvokeAsync(() => UndoAssignAsync(task, before))));
    }

    private async Task CreatedAsync(TaskRequest task)
    {
        _creating = false;
        await LoadAsync();
        ClearFilters();
        _view = View.All;
        _fresh = task.Id;
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Clock.Changed -= OnClockChanged;
    }
}
