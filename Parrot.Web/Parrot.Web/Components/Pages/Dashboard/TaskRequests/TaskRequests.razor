@page "/dashboard/task-requests"
@page "/dashboard/task-requests/{RequestId}"
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.TaskRequests
@using Parrot.Web.Features.Dashboard.TaskRequests
@implements IDisposable
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Task Requests · OmniAI</PageTitle>

@* Aurora's #task-requests?request=OM-12031 is Parrot's
   /dashboard/task-requests/TR-001: the same page, with that request's panel
   open. One component serves both routes so opening a row never remounts the
   list behind the panel. *@

<div class="task-requests">
    <header class="task-requests__header">
        <div class="task-requests__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Task Requests</Typography>
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="task-requests__lede">
                See what needs to be done, who owns it and what the customer is waiting for.
            </Typography>
        </div>
        @* Requests reach Parrot from conversations; there is no way to add
           one by hand yet, so the door is drawn but not open. *@
        <Button disabled title="Requests are created from conversations">
            <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
            <ChildContent>New task request</ChildContent>
        </Button>
    </header>

    <section class="task-request-summary" aria-label="Task request summary">
        <article>
            <span><Icon Name="IconName.RiFileList3Fill" Size="IconSize.Md" /></span>
            <div>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">@OpenCount</Typography>
                <Typography TextStyle="TextStyle.Small12Medium" As="small">Open requests</Typography>
            </div>
        </article>
        @* An em dash rather than a zero where Parrot keeps no count: a zero
           would read as a real count of none. *@
        <article>
            <span><Icon Name="IconName.RiTeamFill" Size="IconSize.Md" /></span>
            <div>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">—</Typography>
                <Typography TextStyle="TextStyle.Small12Medium" As="small">Unassigned</Typography>
            </div>
        </article>
        <article>
            <span><Icon Name="IconName.RiTimeFill" Size="IconSize.Md" /></span>
            <div>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">—</Typography>
                <Typography TextStyle="TextStyle.Small12Medium" As="small">Due soon</Typography>
            </div>
        </article>
        <article>
            <span><Icon Name="IconName.RiCheckboxCircleFill" Size="IconSize.Md" /></span>
            <div>
                <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">@CompletedCount</Typography>
                <Typography TextStyle="TextStyle.Small12Medium" As="small">Completed</Typography>
            </div>
        </article>
    </section>

    <section class="task-request-toolbar">
        <label class="task-request-search">
            <Icon Name="IconName.RiSearch2Fill" Size="IconSize.Sm" />
            <input class="@TextStyle.Small12Regular.ToClassName()"
                   type="search"
                   placeholder="Search request, customer or item"
                   aria-label="Search task requests"
                   value="@_search"
                   @oninput="OnSearchInput" />
        </label>

        <FilterPopover Label="@(_status ?? "All statuses")"
                       Title="Status"
                       Subtitle="Where the work has reached"
                       Open='@(_openMenu == "status")'
                       OpenChanged="@(open => _openMenu = open ? "status" : null)">
            <PopoverOption Label="All statuses"
                           Description="Every task request"
                           Active="_status is null"
                           OnSelect="() => SelectStatus(null)" />
            @foreach (var status in TaskRequestPresentation.Statuses)
            {
                <PopoverOption Label="@status"
                               Active="@(_status == status)"
                               OnSelect="() => SelectStatus(status)" />
            }
        </FilterPopover>

        @* Aurora filters by teammate and request type. Parrot has neither, but
           it does know which channel a request came in on and which agent
           captured it — the two filters the previous page offered. *@
        <FilterPopover Label="@TaskRequestPresentation.ChannelFilterLabel(_channel)"
                       Title="Channel"
                       Subtitle="Where the request came in"
                       Open='@(_openMenu == "channel")'
                       OpenChanged="@(open => _openMenu = open ? "channel" : null)">
            <PopoverOption Label="All channels"
                           Description="Every connected channel"
                           Active="_channel is null"
                           OnSelect="() => SelectChannel(null)" />
            @foreach (var option in TaskRequestPresentation.Channels)
            {
                <PopoverOption Label="@option.Label"
                               Active="@(_channel == option.Value)"
                               OnSelect="() => SelectChannel(option.Value)" />
            }
        </FilterPopover>

        <FilterPopover Label="@TaskRequestPresentation.AgentFilterLabel(_agent)"
                       Title="AI agent"
                       Subtitle="Which agent captured the request"
                       Open='@(_openMenu == "agent")'
                       OpenChanged="@(open => _openMenu = open ? "agent" : null)">
            <PopoverOption Label="All agents"
                           Description="Every agent"
                           Active="_agent is null"
                           OnSelect="() => SelectAgent(null)" />
            @foreach (var option in TaskRequestPresentation.Agents)
            {
                <PopoverOption Label="@option.Label"
                               Active="@(_agent == option.Value)"
                               OnSelect="() => SelectAgent(option.Value)" />
            }
        </FilterPopover>
    </section>

    @if (VisibleItems.Count == 0)
    {
        <EmptyState Glyph="IconName.RiSearch2Fill"
                    Title="No matching task requests"
                    Description="Try another search or clear your filters.">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick="ClearFilters">Clear filters</Button>
            </Action>
        </EmptyState>
    }
    else
    {
        <section class="task-request-table-wrap">
            <div class="task-request-table" role="table" aria-label="Task Requests">
                <div class="task-request-table-head" role="row">
                    @foreach (var column in Columns)
                    {
                        <Typography TextStyle="TextStyle.Small10Semibold"
                                    As="span"
                                    Class="ds-overline"
                                    role="columnheader">@column</Typography>
                    }
                </div>

                <div class="task-request-table-body">
                    @foreach (var item in PagedItems)
                    {
                        <TaskRequestRow Item="item"
                                        Open="@(Selected?.Id == item.Id)"
                                        MenuOpen="@(_openMenu == "assign-" + item.Id)"
                                        MenuOpenChanged="@(open => _openMenu = open ? "assign-" + item.Id : null)"
                                        OnOpen="() => OpenRequest(item)" />
                    }
                </div>
            </div>

            <footer class="task-request-table-footer">
                <Typography TextStyle="TextStyle.Small12Regular" As="span">
                    Showing @FirstShown–@LastShown of @VisibleItems.Count
                </Typography>
                <div>
                    <Button Variant="ButtonVariant.Secondary"
                            Size="ButtonSize.Small"
                            disabled="@(CurrentPage == 1)"
                            @onclick="() => _page = Math.Max(1, CurrentPage - 1)">Previous</Button>
                    <Typography TextStyle="TextStyle.Small12Regular" As="span">
                        Page @CurrentPage of @TotalPages
                    </Typography>
                    <Button Variant="ButtonVariant.Secondary"
                            Size="ButtonSize.Small"
                            disabled="@(CurrentPage == TotalPages)"
                            @onclick="() => _page = Math.Min(TotalPages, CurrentPage + 1)">Next</Button>
                </div>
            </footer>
        </section>
    }
</div>

<TaskRequestPanel Item="Selected"
                  OnClose="ClosePanel"
                  OnStatusSelected="SetStatus" />

@code {
    private const int PageSize = 25;

    private static readonly string[] Columns =
        ["Items", "Customer", "Payment", "Due", "Assigned to", "Waiting on", "Next step"];

    private readonly Debouncer _searchDebounce = new();

    // Parrot's data. The list is the same static collection the previous
    // page read and wrote, so a status change here is visible everywhere.
    private readonly List<TaskRequest> _requests = TaskRequestsData.All;

    private string _search = "";
    private string _appliedSearch = "";
    private string? _status;
    private string? _channel;
    private string? _agent;
    private int _page = 1;
    private string? _openMenu;

    /// <summary>The request whose panel is open, from the route.</summary>
    [Parameter] public string? RequestId { get; set; }

    private TaskRequest? Selected => RequestId is null
        ? null
        : _requests.FirstOrDefault(r => r.RequestId == RequestId);

    private int OpenCount => _requests.Count(r => r.Status == TaskRequestPresentation.Pending);
    private int CompletedCount => _requests.Count(r => r.Status == TaskRequestPresentation.Completed);

    // Filtering is done in the browser, exactly as React does it.
    private IReadOnlyList<TaskRequest> VisibleItems
    {
        get
        {
            var query = _appliedSearch.Trim();
            return _requests.Where(item =>
                (_status is null || item.Status == _status) &&
                (_channel is null || item.Channel == _channel) &&
                (_agent is null || item.AiAgent == _agent) &&
                (query.Length == 0 || Searchable(item).Contains(query, StringComparison.CurrentCultureIgnoreCase))
            ).ToList();
        }
    }

    private static string Searchable(TaskRequest item) =>
        $"{item.RequestId} {item.Item} {item.CustomerName} {string.Join(' ', item.Items)}";

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(VisibleItems.Count / (double)PageSize));
    private int CurrentPage => Math.Min(_page, TotalPages);
    private IEnumerable<TaskRequest> PagedItems => VisibleItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private int FirstShown => VisibleItems.Count == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int LastShown => Math.Min(CurrentPage * PageSize, VisibleItems.Count);

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? "";
        // Filtering happens locally, so the debounce is only to stop the list
        // re-rendering on every keystroke.
        await _searchDebounce.RunAsync(() =>
        {
            _appliedSearch = _search;
            _page = 1;
            return InvokeAsync(StateHasChanged);
        });
    }

    private void SelectStatus(string? status)
    {
        _status = status;
        _page = 1;
        _openMenu = null;
    }

    private void SelectChannel(string? channel)
    {
        _channel = channel;
        _page = 1;
        _openMenu = null;
    }

    private void SelectAgent(string? agent)
    {
        _agent = agent;
        _page = 1;
        _openMenu = null;
    }

    private void ClearFilters()
    {
        _search = "";
        _appliedSearch = "";
        _status = null;
        _channel = null;
        _agent = null;
        _page = 1;
    }

    private void OpenRequest(TaskRequest item)
    {
        _openMenu = null;
        Nav.NavigateTo($"/dashboard/task-requests/{Uri.EscapeDataString(item.RequestId)}");
    }

    private void ClosePanel()
    {
        _openMenu = null;
        Nav.NavigateTo("/dashboard/task-requests");
    }

    // The same in-memory write the previous page made from its row menu
    // ("Mark as completed", "Cancel request"), reached from the panel instead.
    private void SetStatus(string status)
    {
        if (Selected is not { } item) return;
        item.Status = status;
        Toasts.Show($"{item.RequestId} is now {status.ToLowerInvariant()}.");
    }

    public void Dispose() => _searchDebounce.Dispose();
}
