@namespace Parrot.Web.Components.Pages.Dashboard.TaskRequests
@using Parrot.Web.Features.Dashboard.TaskRequests

@* One request. The whole row opens the panel, so it carries the pointer; the
   controls inside (assignee, view details) stop the click before it gets
   here — React did the same with a closest("button") check. *@

<article class="@(Open ? "task-request-row is-open" : "task-request-row")" role="row" @onclick="OnOpen">
    <div class="task-request-title" role="cell">
        @* Parrot does not classify a request as an order, booking or issue, so
           the kind box takes the module's own glyph in its default tint. *@
        <span class="request-kind"><Icon Name="IconName.RiTaskFill" Size="IconSize.Sm" /></span>
        <div>
            <Typography TextStyle="TextStyle.Small10Semibold" As="em">@Item.AiAgent</Typography>
            <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@Item.Item</Typography>
            <Typography TextStyle="TextStyle.Small12Medium" As="small">@Item.RequestId</Typography>
        </div>
    </div>

    <div class="task-request-customer" role="cell">
        <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@Item.CustomerName</Typography>
        @if (!string.IsNullOrWhiteSpace(Item.Channel))
        {
            <Typography TextStyle="TextStyle.Small10Regular" As="small">
                <span class="@TaskRequestPresentation.ChannelClass(Item.ChannelIcon)" aria-hidden="true">
                    <Icon Name="@TaskRequestPresentation.ChannelGlyph(Item.ChannelIcon)" />
                </span>
                @Item.Channel
            </Typography>
        }
    </div>

    @* Parrot knows the amount, not whether it has been paid. The figure sits
       where Aurora puts the payment state; the second line says so. *@
    <div class="task-request-payment" role="cell">
        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@Item.Amount</Typography>
        <Typography TextStyle="TextStyle.Small10Regular" As="small">Payment not tracked</Typography>
    </div>

    @* No due date on a Parrot request — the em dash is Aurora's own reading of "none". *@
    <Typography TextStyle="TextStyle.Small12Regular" As="time" Class="task-request-due" role="cell">—</Typography>

    <div class="task-request-assignee" role="cell" @onclick:stopPropagation="true">
        @* The same menu React puts on every row, over an empty roster: Parrot
           has no teammates to hand a request to yet, so the only choice is the
           one already made. *@
        <FilterPopover Label="Unassigned"
                       Title="Assign to"
                       Subtitle="Who owns the next action"
                       Open="@MenuOpen"
                       OpenChanged="MenuOpenChanged">
            <PopoverOption Label="Unassigned" Active="true" OnSelect="@(() => MenuOpenChanged.InvokeAsync(false))" />
        </FilterPopover>
    </div>

    <div class="task-request-owner" role="cell">
        <Typography TextStyle="TextStyle.Small12Semibold" As="span">—</Typography>
    </div>

    <div class="task-request-row-action" role="cell" @onclick:stopPropagation="true">
        @* Nothing on a Parrot request can be finished in one tap, so the row
           falls back to opening the details, exactly as React does when a
           request has no next step. *@
        <button type="button"
                class="task-request-row__view"
                aria-label="@($"View details for {Item.RequestId}")"
                @onclick="OnOpen">
            <Icon Name="IconName.RiEyeFill" Size="IconSize.Sm" />
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public TaskRequest Item { get; set; } = default!;

    /// <summary>This row's request is the one open in the panel.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>The assignee menu is open. Owned by the page so one menu closes another.</summary>
    [Parameter] public bool MenuOpen { get; set; }

    [Parameter] public EventCallback<bool> MenuOpenChanged { get; set; }

    [Parameter] public EventCallback OnOpen { get; set; }
}
