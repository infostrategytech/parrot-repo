@page "/dashboard/insights"
@attribute [RequiresAccess(AccessRules.Insights)]
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.QaInsights
@using Parrot.Web.Components.Pages.Dashboard.QaInsights

<PageTitle>Insights · yára</PageTitle>

@* QA and conversation insight. The summary is Aurora's stat strip; the two
   panels beneath are its cards. Every colour on the donut is a status token,
   because sentiment is a state, not a series. *@

<div class="insights">
    <header class="insights__header">
        <div class="insights__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Insights</Typography>
            <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="insights__lede">
                How your AI agents and your team are handling conversations, and how customers feel about it.
            </Typography>
        </div>

        <div class="insights__actions">
            <Button Variant="ButtonVariant.Secondary">
                <IconLeft><Icon Name="IconName.RiCalendarCheckFill" /></IconLeft>
                <ChildContent>Date range</ChildContent>
            </Button>
        </div>
    </header>

    <section class="insights__summary" aria-label="Conversation summary">
        @foreach (var card in _statCards)
        {
            <article class="stat-tile">
                <div class="stat-tile__body">
                    <div class="stat-tile__top">
                        <Typography TextStyle="TextStyle.Small12Medium" As="small" Prose>@card.Title</Typography>
                        <StatusBadge Tone="@(card.ChangePositive ? StatusTone.Success : StatusTone.Danger)">@card.Change</StatusBadge>
                    </div>
                    <Typography TextStyle="TextStyle.HeadingH2Semibold" As="strong" Prose>@card.Value</Typography>
                    <Typography TextStyle="TextStyle.Small10Regular" As="p" Prose Class="stat-tile__note">@card.Sub</Typography>
                </div>
            </article>
        }
    </section>

    <div class="insights__panels">
        <section class="insights__card">
            <header class="insights__card-header">
                <Typography TextStyle="TextStyle.BodyDefaultBold" As="h2">AI vs human performance</Typography>
                <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose>Key metrics at a glance</Typography>
            </header>

            <div class="insights__performance">
                <article class="insights__performer">
                    <header>
                        <span class="insights__performer-icon"><Icon Name="IconName.RiRobot3Fill" Size="IconSize.Sm" /></span>
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">AI agent performance</Typography>
                    </header>
                    <dl>
                        @foreach (var row in _aiRows)
                        {
                            <div>
                                <Typography TextStyle="TextStyle.Small12Regular" As="dt">@row.Label</Typography>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="dd">@row.Value</Typography>
                            </div>
                        }
                    </dl>
                </article>

                <article class="insights__performer">
                    <header>
                        <span class="insights__performer-icon"><Icon Name="IconName.RiUser3Fill" Size="IconSize.Sm" /></span>
                        <Typography TextStyle="TextStyle.BodySmallSemibold" As="h3">Human performance</Typography>
                    </header>
                    <dl>
                        @foreach (var row in _humanRows)
                        {
                            <div>
                                <Typography TextStyle="TextStyle.Small12Regular" As="dt">@row.Label</Typography>
                                <Typography TextStyle="TextStyle.BodySmallSemibold" As="dd">@row.Value</Typography>
                            </div>
                        }
                    </dl>
                </article>
            </div>

            <aside class="insights__aside">
                <Icon Name="IconName.RiFlashlightFill" Size="IconSize.Sm" />
                <Typography TextStyle="TextStyle.Small12Medium" As="p" Prose>
                    Human intervention improves resolution rates by 12.3% for complex custom requests,
                    while AI maintains high efficiency for standardized flows.
                </Typography>
            </aside>
        </section>

        <section class="insights__card">
            <header class="insights__card-header insights__card-header--split">
                <Typography TextStyle="TextStyle.BodyDefaultBold" As="h2">Customer sentiment</Typography>
                <div class="insights__sentiment-headline">
                    <Typography TextStyle="TextStyle.HeadingH3Semibold" As="strong">@PositivePercent%</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="span">Positive</Typography>
                </div>
            </header>

            <div class="insights__donut-wrap">
                <svg viewBox="0 0 120 120" class="insights__donut" role="img" aria-label="Customer sentiment breakdown">
                    <circle class="insights__ring" cx="60" cy="60" r="46" />
                    @{
                        double offset = 0;
                    }
                    @for (var i = 0; i < _sentimentSlices.Count; i++)
                    {
                        var slice = _sentimentSlices[i];
                        var length = Circumference * slice.Percent / 100;
                        <circle class="@SliceClass(i)"
                                cx="60" cy="60" r="46"
                                stroke-dasharray="@Fmt(length) @Fmt(Circumference)"
                                stroke-dashoffset="@Fmt(-offset)"
                                transform="rotate(-90 60 60)" />
                        offset += length;
                    }
                </svg>
            </div>

            <ul class="insights__legend">
                @for (var i = 0; i < _sentimentSlices.Count; i++)
                {
                    var slice = _sentimentSlices[i];
                    <li>
                        <span class="insights__legend-dot @SliceClass(i)" aria-hidden="true"></span>
                        <Typography TextStyle="TextStyle.Small12Regular" As="span" Prose>@slice.Label</Typography>
                        <Typography TextStyle="TextStyle.Small12Semibold" As="strong">@slice.Percent%</Typography>
                    </li>
                }
            </ul>
        </section>
    </div>
</div>

@code {
    private const double Circumference = 2 * Math.PI * 46;

    private readonly List<StatCard> _statCards =
    [
        new("Total Conversations", "4,281", "All handled across channels.", "+12.5%", true),
        new("AI Resolution Rate", "84.2%", "Resolved without human intervention.","+ 4.1%", true),
        new("Human Takeover Rate", "11.8%", "Escalated to manual control.", "-2.4%", false),
        new("Tasks Created", "1,592", "Requests generated from flows.", "+18.7%", true),
        new("Goal achieved", "3,912", "Customers completed intended action.","+ 12.5%",true),
        new("Unresolved", "172", "Closed without achieving goal.", "+4s", false),
    ];

    private readonly List<PerformanceRow> _aiRows =
    [
        new("Resolution Rate:", "84.2%"),
        new("Avg Sentiment Score", "4.4/5"),
        new("Goal Completion", "91.8%"),
    ];

    private readonly List<PerformanceRow> _humanRows =
    [
        new("Resolution Rate:", "84.2%"),
        new("Avg Sentiment Score", "4.4/5"),
        new("Goal Completion", "91.8%"),
    ];

    private readonly List<SentimentSlice> _sentimentSlices =
    [
        new("Positive Sentiment", "#22C55E", 78),
        new("Neutral Sentiment", "#D1D5DB", 16),
        new("Negativee Sentiment", "#EF4444", 6),
    ];

    private double PositivePercent => _sentimentSlices.Count > 0 ? _sentimentSlices[0].Percent : 0;

    // The slice colours come from the status tokens by position — positive,
    // neutral, negative — never from the hex the data carries.
    private static string SliceClass(int index) => index switch
    {
        0 => "insights__slice insights__slice--positive",
        1 => "insights__slice insights__slice--neutral",
        _ => "insights__slice insights__slice--negative"
    };

    private static string Fmt(double value) => value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
}
