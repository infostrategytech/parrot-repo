@namespace Parrot.Web.Components.Pages.Dashboard.Contacts
@inject AuroraInterop Interop

@* Import, in Aurora's Dialog. The file input is hidden because no styling
   makes a native one match the product; the dropzone forwards a click to it
   the way Aurora's Products page does for its CSV import. Only the file's
   name travels — nothing is uploaded anywhere yet. *@

<Dialog Open="Visible"
        Title="Import contacts"
        ConfirmLabel="Import contacts"
        OnConfirm="OnCancel"
        OnCancel="OnCancel">
    <GlyphContent><Icon Name="IconName.RiUploadCloud2Fill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="import__lede">
            Upload a CSV file to add multiple customers to your CRM.
        </Typography>

        <div class="import__template">
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">
                <IconLeft><Icon Name="IconName.RiFileTextFill" /></IconLeft>
                <ChildContent>Download template</ChildContent>
            </Button>
            <Typography TextStyle="TextStyle.Small12Regular" As="small" Prose Class="import__hint">
                Template columns: Name, Phone, Email, Stage
            </Typography>
        </div>

        <InputFile @ref="_fileInput" OnChange="HandleFile" accept=".csv" class="sr-only" />
        <button type="button" class="@(string.IsNullOrEmpty(_fileName) ? "import__dropzone" : "import__dropzone is-ready")" @onclick="PickFile">
            <span class="import__dropzone-icon">
                <Icon Name="@(string.IsNullOrEmpty(_fileName) ? IconName.RiUploadCloud2Fill : IconName.RiCheckFill)" Size="IconSize.Md" />
            </span>
            @if (string.IsNullOrEmpty(_fileName))
            {
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">Click to upload a CSV file</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="small">or drag and drop</Typography>
            }
            else
            {
                <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@_fileName</Typography>
                <Typography TextStyle="TextStyle.Small12Regular" As="small">Click to choose a different file</Typography>
            }
        </button>
    </Body>
</Dialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private InputFile? _fileInput;
    private string _fileName = string.Empty;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible) _fileName = string.Empty;
        _wasVisible = Visible;
    }

    private async Task PickFile()
    {
        if (_fileInput?.Element is { } element) await Interop.ClickAsync(element);
    }

    private void HandleFile(InputFileChangeEventArgs e)
    {
        _fileName = e.File?.Name ?? string.Empty;
    }
}
