@namespace Parrot.Web.Components.Pages.Dashboard.Contacts
@using Parrot.Web.Services
@using Parrot.Web.Features.Dashboard.Customers
@using Parrot.Web.Components.Pages.Dashboard.Conversations
@inject CustomerClient CustomerClient

@* Adding a customer by hand (designer, 21 October 2026): their name, where they message you and how they
   appear there, and an email if you have one. No stage or tag. Saved through the customers API. The server
   doesn't yet join someone added here to their conversation when they first write (customers-backend-requests,
   request 1), nor stop a second customer with the same number (request 4): someone who already messages you
   from that number or username is found here first, and opened instead. *@
<Dialog Open="Visible"
        Title="Add customer"
        Subtitle="Someone you want to keep track of or message."
        ConfirmLabel="Add customer"
        BusyLabel="Adding"
        Busy="_saving"
        OnConfirm="SaveAsync"
        OnCancel="CloseAsync">
    <GlyphContent><Icon Name="IconName.RiUserAddFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <div class="add-customer">
            <Input FloatingLabel="Their name" @bind-Value="_name" maxlength="120"
                   Error="@(_tried && _name.Trim().Length == 0)" HelperText="@(_tried && _name.Trim().Length == 0 ? "Add their name." : null)" />

            <SelectField FloatingLabel="Where they message you" Value="@ChannelName(_channel)"
                         Open="_channelOpen" OpenChanged="open => _channelOpen = open">
                @foreach (var channel in Channels)
                {
                    var current = channel;
                    <PopoverOption Label="@ChannelName(current)" Active="@(_channel == current)" OnSelect="() => PickChannel(current)">
                        <Leading><ChannelGlyph Channel="@current" Compact /></Leading>
                    </PopoverOption>
                }
            </SelectField>

            @if (_channel == "whatsapp")
            {
                <Input FloatingLabel="WhatsApp number" Type="tel" @bind-Value="_handle" maxlength="20"
                       Error="@(PhoneProblem is not null)" HelperText="@(PhoneProblem ?? PhoneHint)" />
            }
            else
            {
                <Input FloatingLabel="@HandleLabel(_channel)" @bind-Value="_handle" maxlength="120" HelperText="@HandleHint(_channel)" />
            }

            <Input FloatingLabel="Email (optional)" Type="email" @bind-Value="_email" maxlength="200"
                   Error="@(EmailProblem is not null)" HelperText="@EmailProblem" />

            @if (Existing is { } existing)
            {
                <InlineError Tone="InlineErrorTone.Warning" Message="@($"{existing.Name} already messages you from this {(_channel == "whatsapp" ? "number" : "username")}.")">
                    <Action>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="() => OnExisting.InvokeAsync(existing)">@($"Open {existing.Name}")</Button>
                    </Action>
                </InlineError>
            }

            @if (_error is not null)
            {
                <InlineError Message="@_error" />
            }
        </div>
    </Body>
</Dialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Added: the page reloads its list and says so.</summary>
    [Parameter] public EventCallback<CustomerDetailDto> OnAdded { get; set; }

    /// <summary>They're already a customer: the page opens their details instead.</summary>
    [Parameter] public EventCallback<CustomerListItemDto> OnExisting { get; set; }

    private static readonly string[] Channels = ["whatsapp", "instagram", "facebook", "tiktok"];

    private string _name = "", _handle = "", _email = "", _channel = "whatsapp";
    private bool _channelOpen, _tried, _saving, _wasVisible;
    private string? _error;
    // Someone found with the number or username as it was typed when Add customer was pressed.
    private (string Key, CustomerListItemDto Customer)? _existing;

    protected override void OnParametersSet()
    {
        // Each time it opens, it starts empty.
        if (Visible && !_wasVisible)
        {
            _name = _handle = _email = "";
            _channel = "whatsapp";
            _tried = _saving = false;
            _error = null;
            _existing = null;
        }
        _wasVisible = Visible;
    }

    // Only a WhatsApp number is checked as one: a username is left as typed.
    private string? PhoneProblem => _tried && _channel == "whatsapp" && _handle.Trim().Length > 0 ? CustomerImport.Phone(_handle).Problem : null;
    // As people write it (0803 555 1234); a local number says what it will be saved as.
    private string PhoneHint => CustomerImport.Phone(_handle) is { Local: true, Number: { } saved }
        ? $"Saved as {CustomerImport.Display(saved)}."
        : "Such as 0803 555 1234, or with the country code.";

    private string? EmailProblem => _tried && _email.Trim().Length > 0 && !CustomerImport.IsEmail(_email) ? "That email doesn't look right." : null;

    // Shown while the number or username is still the one that was found.
    private CustomerListItemDto? Existing =>
        _existing is { } found && found.Key == Key(_channel == "whatsapp" ? CustomerImport.Phone(_handle).Number : null, _handle.Trim().Length > 0 ? _handle : null)
            ? found.Customer : null;

    private string? Key(string? phone, string? handle) =>
        _channel == "whatsapp" ? phone?.TrimStart('+') : handle?.Trim().TrimStart('@').ToLowerInvariant();

    // Someone who already messages you from this number or username, as their channel shows them. A Facebook
    // profile link can't be matched, and a check that can't run never stops the add.
    private async Task<CustomerListItemDto?> ExistingAsync(string? phone, string? handle)
    {
        if (_channel == "facebook" || Key(phone, handle) is not { Length: > 0 } key) return null;
        try
        {
            var page = await CustomerClient.ListAsync(key, null, _channel, 0, 20, CancellationToken.None);
            return page.Items.FirstOrDefault(item => item.Identities.Any(identity => identity.Platform == _channel && (_channel == "whatsapp"
                ? identity.Sender.TrimStart('+') == key
                : string.Equals(identity.Username?.TrimStart('@'), key, StringComparison.OrdinalIgnoreCase))));
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private void PickChannel(string channel)
    {
        _channel = channel;
        _handle = "";
        _channelOpen = false;
    }

    private async Task SaveAsync()
    {
        _tried = true;
        if (_name.Trim().Length == 0 || PhoneProblem is not null || EmailProblem is not null) return;
        var phone = _channel == "whatsapp" ? CustomerImport.Phone(_handle).Number : null;
        var handle = _channel != "whatsapp" && _handle.Trim().Length > 0 ? _handle.Trim() : null;
        _saving = true;
        _error = null;
        try
        {
            if (await ExistingAsync(phone, handle) is { } existing)
            {
                _existing = (Key(phone, handle)!, existing);
                return;
            }
            _existing = null;
            var added = await CustomerClient.CreateAsync(new CreateCustomerDto(
                _name.Trim(),
                _email.Trim().Length > 0 ? _email.Trim() : null,
                phone,
                null,
                null,
                phone is not null || handle is not null ? _channel : null,
                handle), CancellationToken.None);
            await OnAdded.InvokeAsync(added);
        }
        catch (ApiException exception)
        {
            _error = exception.UserMessage;
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = "They couldn't be added. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private Task CloseAsync() => _saving ? Task.CompletedTask : OnClose.InvokeAsync();

    private static string ChannelName(string channel) => channel == "facebook" ? "Messenger" : ChannelLinks.PlatformName(channel);

    private static string HandleLabel(string channel) => channel switch
    {
        "instagram" => "Instagram username (optional)",
        "facebook" => "Facebook profile link (optional)",
        "tiktok" => "TikTok username (optional)",
        _ => "How they appear there (optional)",
    };

    private static string HandleHint(string channel) => channel switch
    {
        "instagram" => "Such as @adireLagos.",
        "facebook" => "Such as facebook.com/adire.lagos.",
        "tiktok" => "Such as @adireLagos.",
        _ => "",
    };
}
