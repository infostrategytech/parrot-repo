@namespace Parrot.Web.Components.Pages.Dashboard.Contacts

@* A new contact, in Aurora's Dialog. Channel is chosen first; the matching
   identifier field appears based on what was picked. *@

<Dialog Open="Visible"
        Title="Add customer"
        ConfirmLabel="Save contact"
        ConfirmDisabled="@string.IsNullOrWhiteSpace(_contact.Name)"
        OnConfirm="HandleSave"
        OnCancel="OnCancel">
    <GlyphContent><Icon Name="IconName.RiUserAddFill" Size="IconSize.Md" /></GlyphContent>
    <Body>
        <Typography TextStyle="TextStyle.BodySmallMedium" As="p" Prose Class="contact-form__lede">
            Create a new contact for a customer you want to track or message.
        </Typography>

        <div class="contact-form">
            <div class="contact-form__full">
                <Input FloatingLabel="Full name" @bind-Value="_contact.Name" maxlength="80" required />
            </div>
            <div class="contact-form__full">
                <Input FloatingLabel="Email address" Type="email" HelperText="Optional" @bind-Value="_contact.Email" />
            </div>
            <div class="contact-form__full">
                <SelectField FloatingLabel="Channel"
                             Value="@ChannelLabel(_contact.ChannelPlatform)"
                             Open="@(_openMenu == "channel")"
                             OpenChanged="@(open => _openMenu = open ? "channel" : null)">
                    @foreach (ChannelOption ch in Channels)
                    {
                        string chKey = ch.Key;
                        <PopoverOption Label="@ch.Label"
                                       Active="@(_contact.ChannelPlatform == chKey)"
                                       OnSelect="() => SelectChannel(chKey)" />
                    }
                </SelectField>
            </div>
            @if (_contact.ChannelPlatform == "whatsapp")
            {
                <div class="contact-form__full">
                    <Input FloatingLabel="Phone number"
                           Type="tel"
                           HelperText="Include country code, e.g. +2348012345678"
                           @bind-Value="_contact.Phone" />
                </div>
            }
            else if (_contact.ChannelPlatform is "instagram" or "facebook" or "tiktok")
            {
                <div class="contact-form__full">
                    <Input FloatingLabel="@HandleLabel(_contact.ChannelPlatform)"
                           HelperText="@HandleHint(_contact.ChannelPlatform)"
                           @bind-Value="_contact.ChannelIdentifier" />
                </div>
            }
            <SelectField FloatingLabel="Stage"
                         Value="@(string.IsNullOrEmpty(_contact.Stage) ? null : ContactCopy.Stage(_contact.Stage))"
                         Open="@(_openMenu == "stage")"
                         OpenChanged="@(open => _openMenu = open ? "stage" : null)">
                @foreach (string stage in Stages)
                {
                    string sv = stage;
                    <PopoverOption Label="@ContactCopy.Stage(sv)"
                                   Active="@(_contact.Stage == sv)"
                                   OnSelect="() => SelectStage(sv)" />
                }
            </SelectField>
            <SelectField FloatingLabel="Tag"
                         Value="@(string.IsNullOrEmpty(_tag) ? null : _tag)"
                         Open="@(_openMenu == "tag")"
                         OpenChanged="@(open => _openMenu = open ? "tag" : null)">
                @foreach (string tag in Tags)
                {
                    string tv = tag;
                    <PopoverOption Label="@tv"
                                   Active="@(_tag == tv)"
                                   OnSelect="() => SelectTag(tv)" />
                }
            </SelectField>
        </div>
    </Body>
</Dialog>

@code {
    private static readonly string[] Stages = ["New Lead", "Interested", "Customer", "Vip"];
    private static readonly string[] Tags = ["Business", "Consumer", "New client", "Returning client", "VIP", "VVIP"];

    private sealed record ChannelOption(string Key, string Label);
    private static readonly ChannelOption[] Channels =
    [
        new("whatsapp", "WhatsApp"),
        new("instagram", "Instagram"),
        new("facebook", "Messenger"),
        new("tiktok", "TikTok"),
    ];

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<Contact> OnSave { get; set; }

    private Contact _contact = new();
    private string _tag = string.Empty;
    private string? _openMenu;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _contact = new Contact();
            _tag = string.Empty;
            _openMenu = null;
        }
        _wasVisible = Visible;
    }

    private void SelectChannel(string channel)
    {
        _contact.ChannelPlatform = channel;
        _contact.Phone = string.Empty;
        _contact.ChannelIdentifier = string.Empty;
        _openMenu = null;
    }

    private void SelectStage(string stage)
    {
        _contact.Stage = stage;
        _openMenu = null;
    }

    private void SelectTag(string tag)
    {
        _tag = tag;
        _openMenu = null;
    }

    private static string? ChannelLabel(string? platform) => platform switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Messenger",
        "tiktok" => "TikTok",
        _ => null,
    };

    private static string HandleLabel(string? platform) => platform switch
    {
        "instagram" => "Instagram handle or profile URL",
        "facebook" => "Facebook profile URL",
        "tiktok" => "TikTok username or profile URL",
        _ => "Channel identifier",
    };

    private static string HandleHint(string? platform) => platform switch
    {
        "instagram" => "@username or instagram.com/username",
        "facebook" => "facebook.com/username or profile URL",
        "tiktok" => "@username or tiktok.com/@username",
        _ => "A username or profile URL",
    };

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(_contact.Name)) return;
        if (!string.IsNullOrWhiteSpace(_tag))
            _contact.Tags.Add(_tag);
        await OnSave.InvokeAsync(_contact);
    }
}
