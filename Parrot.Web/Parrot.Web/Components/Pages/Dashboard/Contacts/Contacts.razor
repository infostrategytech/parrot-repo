    private void SelectStage(string val) { _stageFilter = val; _openDropdown = null; _page = 1; }
    private void SelectChannel(string val) { _channelFilter = val; _openDropdown = null; _page = 1; }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _page = 1;
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _stageFilter = string.Empty;
        _channelFilter = string.Empty;
        _page = 1;
    }

