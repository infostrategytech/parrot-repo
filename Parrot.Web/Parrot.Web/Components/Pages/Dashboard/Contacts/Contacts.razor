@page "/dashboard/contacts"
@attribute [RequiresAccess(AccessRules.Customers)]
@layout DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.Contacts
@implements IAsyncDisposable
@using Parrot.Web.Components.Pages.Dashboard.Contacts
@using Parrot.Web.Services
@using Parrot.Web.Services.Realtime
@using Parrot.Web.Features.Dashboard.TaskRequests
@using Parrot.Web.Components.Pages.Dashboard.TaskRequests
@inject CustomerClient CustomerClient
@inject RealtimeClient Realtime
@inject ITaskStore Tasks
@inject UserClock Clock
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Customers · OmniAI</PageTitle>

@* The customer list. Layout follows Aurora's Products page: content capped
   and centred, search and the channel filter on the right, and a grid table
   whose columns are fixed so every row lines up. Each customer shows what's
   open for them, and their panel adds a task (designer, 27 October 2026). *@

<div class="contacts">
    <header class="contacts__header">
        <div class="contacts__heading">
            <Typography TextStyle="TextStyle.HeadingH1Bold" As="h1">Customers</Typography>
            <Typography TextStyle="TextStyle.BodySmallRegular" As="p" Prose Class="contacts__lede">
                Everyone who has messaged your business, and anyone you've added or imported.
            </Typography>
        </div>

        <div class="contacts__actions">
            <Button Variant="ButtonVariant.Secondary" @onclick="() => _showImport = true">
                <IconLeft><Icon Name="IconName.RiUploadCloud2Fill" /></IconLeft>
                <ChildContent>Import customers</ChildContent>
            </Button>
            <Button @onclick="() => _showAdd = true">
                <IconLeft><Icon Name="IconName.RiAddFill" /></IconLeft>
                <ChildContent>Add customer</ChildContent>
            </Button>
        </div>
    </header>

    <section class="contacts__controls">
        <div class="contacts__search">
            <Icon Name="IconName.RiSearch2Fill" Size="IconSize.Sm" />
            <input class="@TextStyle.BodySmallRegular.ToClassName()"
                   type="search"
                   placeholder="Search by name, number or username"
                   aria-label="Search customers"
                   value="@_search"
                   @oninput="OnSearchInput" />
        </div>

        <FilterPopover Label="@ChannelLabel"
                       Title="Channels"
                       Subtitle="Filter by where they message you"
                       Open='@(_openDropdown == "channel")'
                       OpenChanged="@(open => _openDropdown = open ? "channel" : null)">
            @foreach (var opt in _channelOptions)
            {
                var val = opt.Value;
                <PopoverOption Label="@opt.Label"
                               Active="@(_channelFilter == val)"
                               OnSelect="() => SelectChannel(val)" />
            }
        </FilterPopover>
    </section>

    @if (_error is not null)
    {
        <EmptyState Glyph="IconName.RiAlertFill"
                    Title="Something went wrong"
                    Description="@_error">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick="LoadAsync">Retry</Button>
            </Action>
        </EmptyState>
    }
    else if (_loading)
    {
        <div class="contacts__loading" aria-busy="true" aria-label="Loading customers"></div>
    }
    else if (_total == 0)
    {
        <EmptyState Glyph="IconName.RiSearch2Fill"
                    Title="No matching customers"
                    Description="Try a different search or clear one of the filters.">
            <Action>
                <Button Variant="ButtonVariant.Secondary" @onclick="ClearFilters">Clear filters</Button>
            </Action>
        </EmptyState>
    }
    else
    {
        <section class="contacts__table-wrap">
            <div class="contacts__table" role="table" aria-label="Customers">
                <div class="contacts__table-head" role="row">
                    @foreach (var column in Columns)
                    {
                        <Typography TextStyle="TextStyle.Small10Semibold"
                                    As="span"
                                    Class="ds-overline"
                                    role="columnheader">@column</Typography>
                    }
                </div>

                <div class="contacts__table-body">
                    @foreach (Contact contact in _contacts)
                    {
                        <ContactRow Contact="contact" OpenTasks="OpenTasksFor(contact)" Now="_now" Zone="Clock.Zone" OnOpen="() => OpenDetail(contact)" />
                    }
                </div>
            </div>

            <footer class="contacts__pagination">
                <Typography TextStyle="TextStyle.Small12Regular" As="span">
                    Showing @PageStart–@PageEnd of @_total
                </Typography>
                <div class="contacts__pagination-controls">
                    <Button Variant="ButtonVariant.Secondary"
                            Size="ButtonSize.Small"
                            disabled="@(CurrentPage == 1)"
                            @onclick="() => GoToPage(Math.Max(1, CurrentPage - 1))">Previous</Button>
                    <Typography TextStyle="TextStyle.Small12Regular" As="span">
                        Page @CurrentPage of @TotalPages
                    </Typography>
                    <Button Variant="ButtonVariant.Secondary"
                            Size="ButtonSize.Small"
                            disabled="@(CurrentPage == TotalPages)"
                            @onclick="() => GoToPage(Math.Min(TotalPages, CurrentPage + 1))">Next</Button>
                </div>
            </footer>
        </section>
    }
</div>

<AddContactModal Visible="_showAdd" OnCancel="CloseModals" OnSave="HandleAddContact" />
<ImportContactModal Visible="_showImport" OnClose="CloseModals" />
<ContactDetailPanel Contact="_selectedContact" OnClose="CloseDetail" Behind="_taskOpen"
                    OnAddTask="() => _taskOpen = true" OnPreview="item => _panelMedia = item" />

@* Over the panel, not inside it: the panel scrolls and slides, and would confine them to itself. *@
<MediaViewer Item="_panelMedia" OnClose="() => _panelMedia = null" />
@if (_selectedContact is { } forTask)
{
    <NewTaskDialog Open="_taskOpen" Customer="TaskCustomerFor(forTask)" OnClose="() => _taskOpen = false" OnCreated="TaskAddedAsync" />
}

@code {
    // The last one is the View button's, which needs no name.
    private static readonly string[] Columns = ["Customer", "Channels", "Last message", "Open tasks", "Orders", ""];

    private bool _showAdd;
    private bool _showImport;
    private Contact? _selectedContact;
    private string _search = string.Empty;
    private string _channelFilter = string.Empty;
    private string? _openDropdown;
    private int _page = 1;
    private const int PageSize = 15;

    private List<Contact> _contacts = [];
    private int _total;
    private bool _loading;
    private string? _error;

    private record FilterOption(string Value, string Label);

    private List<FilterOption> _channelOptions =
    [
        new("", "All channels"),
        new("whatsapp", "WhatsApp"),
        new("instagram", "Instagram"),
        new("facebook", "Messenger"),
        new("tiktok", "TikTok"),
    ];

    private string ChannelLabel => _channelOptions.FirstOrDefault(o => o.Value == _channelFilter)?.Label ?? "All channels";

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));
    private int CurrentPage => Math.Min(_page, TotalPages);
    private int PageStart => _total == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int PageEnd => Math.Min(CurrentPage * PageSize, _total);

    // Their open tasks, for the Open tasks column; null while tasks can't be kept.
    private IReadOnlyList<TaskRequest>? _openTasks;
    private DateTime _now = DateTime.UtcNow;
    private bool _taskOpen;
    private MediaViewerItem? _panelMedia;

    protected override async Task OnInitializedAsync()
    {
        Realtime.MessageReceived += OnMessageReceived;
        Realtime.Reconnected += OnReconnected;
        Tasks.Changed += OnTasksChanged;
        Clock.Changed += OnClockChanged;
        await Task.WhenAll(LoadAsync(), LoadTasksAsync());
        await Realtime.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Clock.ReadAsync();
    }

    private async Task LoadTasksAsync()
    {
        if (!Tasks.Available) return;
        try { _openTasks = [.. (await Tasks.ListAsync()).Where(task => !task.IsClosed)]; }
        // The column says "—" rather than the page failing over a count.
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
    }

    private int? OpenTasksFor(Contact contact)
    {
        if (_openTasks is null) return null;
        var conversations = contact.ConversationIds;
        var unlinked = contact.Identities.Count == 0 ? contact.Name : null;
        return _openTasks.Count(task => TaskWords.IsFor(task, conversations, unlinked));
    }

    // A new task is for the conversation they last wrote in, so it shows in the inbox beside it.
    private static TaskCustomer TaskCustomerFor(Contact contact) => contact.Primary is { } primary
        ? new(contact.Name, primary.Platform, ContactCopy.Handle(primary), $"{primary.ConnectionId}:{primary.Sender}")
        : new(contact.Name, contact.ChannelPlatform ?? "", contact.ChannelIdentifier is { Length: > 0 } reach ? reach : null);

    private Task TaskAddedAsync(TaskRequest task)
    {
        _taskOpen = false;
        Toasts.Show(new ToastMessage("Task added.", ActionLabel: "View", OnAction: () => Nav.NavigateTo($"/dashboard/tasks/{Uri.EscapeDataString(task.Id)}")));
        return Task.CompletedTask;
    }

    private void OnTasksChanged() => _ = InvokeAsync(async () => { await LoadTasksAsync(); StateHasChanged(); });

    private void OnClockChanged() => _ = InvokeAsync(() => { _now = DateTime.UtcNow; StateHasChanged(); });

    private async Task SelectChannel(string val)
    {
        _channelFilter = val;
        _openDropdown = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        _search = string.Empty;
        _channelFilter = string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            int skip = (CurrentPage - 1) * PageSize;
            CustomerPageDto page = await CustomerClient.ListAsync(
                _search.Length > 0 ? _search : null,
                null,
                _channelFilter.Length > 0 ? _channelFilter : null,
                skip, PageSize, CancellationToken.None);
            _contacts = [.. page.Items.Select(ToContact)];
            _total = page.Total;
            _now = DateTime.UtcNow;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = "Could not load customers. Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static Contact ToContact(CustomerListItemDto dto) => new()
    {
        Id = dto.Id,
        Name = dto.Name,
        Stage = dto.Stage,
        Tags = dto.Tags,
        LastSeenAt = dto.LastSeenAt,
        LastInteractionChannel = dto.LastSeenChannel ?? string.Empty,
        HasWhatsApp = dto.Identities.Any(i => i.Platform == "whatsapp"),
        HasInstagram = dto.Identities.Any(i => i.Platform == "instagram"),
        WhatsAppNumber = dto.Identities.FirstOrDefault(i => i.Platform == "whatsapp")?.Sender ?? string.Empty,
        InstagramHandle = dto.Identities.FirstOrDefault(i => i.Platform == "instagram")?.Username ?? string.Empty,
        Identities = [.. dto.Identities.Select(i => new ContactIdentity(i.ConnectionId, i.Platform, i.Sender, i.Username))],
        // Phone/ChannelPlatform/ChannelIdentifier are not in the list DTO; they load when the detail panel opens.
    };

    private void OpenDetail(Contact c) => _selectedContact = c;
    private void CloseDetail() { _selectedContact = null; _taskOpen = false; }
    private void CloseModals() { _showAdd = false; _showImport = false; }

    private async Task HandleAddContact(Contact draft)
    {
        try
        {
            await CustomerClient.CreateAsync(new CreateCustomerDto(
                draft.Name,
                string.IsNullOrWhiteSpace(draft.Email) ? null : draft.Email,
                string.IsNullOrWhiteSpace(draft.Phone) ? null : draft.Phone,
                string.IsNullOrWhiteSpace(draft.Stage) ? null : draft.Stage,
                draft.Tags.Count > 0 ? draft.Tags : null,
                string.IsNullOrWhiteSpace(draft.ChannelPlatform) ? null : draft.ChannelPlatform,
                string.IsNullOrWhiteSpace(draft.ChannelIdentifier) ? null : draft.ChannelIdentifier), CancellationToken.None);
            CloseModals();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = ex.Message;
        }
    }

    private Task OnMessageReceived(Parrot.Application.Messaging.StoredMessage message) =>
        InvokeAsync(async () =>
        {
            // Outgoing replies are not new customers — skip them.
            if (message.Outgoing) return;

            // If this sender is already in the list, nothing to do.
            bool known = _contacts.Any(c =>
                c.Identities.Any(i =>
                    i.ConnectionId == message.ConnectionId &&
                    i.Sender == message.Sender));
            if (known) return;

            // New sender — reload so the new customer row appears.
            await LoadAsync();
        });

    private Task OnReconnected() => InvokeAsync(LoadAsync);

    public ValueTask DisposeAsync()
    {
        Realtime.MessageReceived -= OnMessageReceived;
        Realtime.Reconnected -= OnReconnected;
        Tasks.Changed -= OnTasksChanged;
        Clock.Changed -= OnClockChanged;
        return ValueTask.CompletedTask;
    }
}
