@namespace Parrot.Web.Components.Pages.Dashboard.Contacts
@implements IAsyncDisposable
@inject AuroraInterop Interop
@inject Parrot.Web.Services.CustomerClient CustomerClient
@using Parrot.Web.Services

@* A customer, in a panel over the list. The frame is Aurora's editor drawer
   (a card lifted off the right edge, focus trapped and returned) and the
   contents are Aurora's Customer 360 panel bound to what Parrot knows about
   a contact. *@

@if (Contact is not null)
{
    <div class="panel-backdrop" @onmousedown="OnClose">
        <aside class="customer-panel"
               aria-label="Customer 360"
               tabindex="-1"
               @ref="_card"
               @onkeydown="OnKeyDown"
               @onmousedown:stopPropagation="true">
            <header class="customer-panel__header">
                <div>
                    <Typography TextStyle="TextStyle.BodyDefaultSemibold" As="h2">Customer 360</Typography>
                    <Typography TextStyle="TextStyle.Small12Regular" As="p">Everything you know about this customer</Typography>
                </div>
                <button type="button" aria-label="Close Customer 360" title="Close Customer 360" @onclick="OnClose">
                    <Icon Name="IconName.RiCloseFill" Size="IconSize.Sm" />
                </button>
            </header>

            <section class="customer-profile">
                <PetalAvatar Seed="@Contact.Id.ToString()" Initials="@Initials.From(Contact.Name)" Size="AvatarSize.Lg" />
                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h3">@Contact.Name</Typography>
                <div>
                    @if (!string.IsNullOrEmpty(Contact.Stage))
                    {
                        <StatusBadge Tone="@ContactCopy.StageTone(Contact.Stage)">@ContactCopy.Stage(Contact.Stage)</StatusBadge>
                    }
                    @foreach (var tag in Contact.Tags)
                    {
                        <StatusBadge Tone="StatusTone.Neutral">@tag</StatusBadge>
                    }
                </div>
            </section>

            <div class="customer-panel__scroll">
                <section class="customer-metrics" aria-label="Customer value">
                    @* Parrot holds the request count only; the other two slots keep
                       Aurora's em dash until there is a value behind them. *@
                    <div><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">—</Typography><Typography TextStyle="TextStyle.Small10Regular" As="span">Lifetime value</Typography></div>
                    <div><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@Contact.OrderCount</Typography><Typography TextStyle="TextStyle.Small10Regular" As="span">Requests</Typography></div>
                    <div><Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">—</Typography><Typography TextStyle="TextStyle.Small10Regular" As="span">Conversations</Typography></div>
                </section>

                @if (!string.IsNullOrWhiteSpace(Contact.Email) || !string.IsNullOrWhiteSpace(Contact.Phone))
                {
                    <ContactSection Title="Contact">
                        <div class="customer-contact-list">
                            @if (!string.IsNullOrWhiteSpace(Contact.Email))
                            {
                                <button type="button" @onclick='() => CopyAsync("email", Contact.Email)'>
                                    <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
                                    <span><small>Email</small><strong>@Contact.Email</strong></span>
                                    <Icon Name="@(_copied == "email" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                                </button>
                            }
                            @if (!string.IsNullOrWhiteSpace(Contact.Phone))
                            {
                                <button type="button" @onclick='() => CopyAsync("phone", Contact.Phone)'>
                                    <Icon Name="IconName.RiPhoneFill" Size="IconSize.Sm" />
                                    <span><small>Phone</small><strong>@Contact.Phone</strong></span>
                                    <Icon Name="@(_copied == "phone" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                                </button>
                            }
                        </div>
                    </ContactSection>
                }

                <ContactSection Title="Stage">
                    <SelectField FloatingLabel="Stage"
                                 Value="@ContactCopy.Stage(_stage)"
                                 Open="@(_openPanelMenu == "stage")"
                                 OpenChanged="@(open => _openPanelMenu = open ? "stage" : null)"
                                 Disabled="@_stageSaving">
                        @foreach (string s in Stages)
                        {
                            string sv = s;
                            <PopoverOption Label="@ContactCopy.Stage(sv)"
                                           Active="@(_stage == sv)"
                                           OnSelect="() => SelectStageAsync(sv)" />
                        }
                    </SelectField>
                    @if (_stageError is not null)
                    {
                        <Typography TextStyle="TextStyle.Small10Regular" As="p" Class="customer-field-error">@_stageError</Typography>
                    }
                </ContactSection>

                <ContactSection Title="Tags" Count="@(_tags.Count == 0 ? null : _tags.Count)">
                    <div class="customer-tags">
                        @if (_tags.Count > 0)
                        {
                            <div class="customer-tags__list">
                                @foreach (string tag in _tags.ToList())
                                {
                                    string t = tag;
                                    <span class="customer-tags__chip">
                                        <Typography TextStyle="TextStyle.Small12Regular" As="span">@t</Typography>
                                        <button type="button"
                                                aria-label="@($"Remove {t}")"
                                                disabled="@_tagsSaving"
                                                @onclick="() => RemoveTagAsync(t)">
                                            <Icon Name="IconName.RiCloseFill" Size="IconSize.Sm" />
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        <div class="customer-tags__add">
                            <Input FloatingLabel="New tag" @bind-Value="_newTag" maxlength="64" />
                            <Button Variant="ButtonVariant.Secondary"
                                    Size="ButtonSize.Small"
                                    Disabled="@(string.IsNullOrWhiteSpace(_newTag) || _tagsSaving)"
                                    @onclick="AddTagAsync">Add</Button>
                        </div>
                        @if (_tagsError is not null)
                        {
                            <Typography TextStyle="TextStyle.Small10Regular" As="p" Class="customer-field-error">@_tagsError</Typography>
                        }
                    </div>
                </ContactSection>

                <ContactSection Title="Connected identities" Count="@(Contact.Identities.Count == 0 ? null : Contact.Identities.Count)">
                    <div class="customer-identities">
                        @foreach (ContactIdentity identity in Contact.Identities)
                        {
                            string platformName = ChannelLinks.PlatformName(identity.Platform);
                            string cssClass = $"customer-identities__mark customer-identities__mark--{identity.Platform}";
                            IconName icon = IdentityIcon(identity.Platform);
                            string display = identity.Username is { Length: > 0 } ? identity.Username : identity.Sender;
                            <div>
                                <span class="@cssClass">
                                    <Icon Name="@icon" Size="IconSize.Sm" Label="@platformName" />
                                </span>
                                <span>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@display</Typography>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">@platformName</Typography>
                                </span>
                            </div>
                        }
                        @if (Contact.Identities.Count == 0 && !string.IsNullOrWhiteSpace(Contact.ChannelIdentifier))
                        {
                            <div>
                                <span class="customer-identities__mark">
                                    <Icon Name="IconName.RiLinksFill" Size="IconSize.Sm" />
                                </span>
                                <span>
                                    <Typography TextStyle="TextStyle.BodySmallSemibold" As="strong">@Contact.ChannelIdentifier</Typography>
                                    <Typography TextStyle="TextStyle.Small10Regular" As="small">Channel identifier</Typography>
                                </span>
                            </div>
                        }
                    </div>
                    <div class="customer-identities__link">
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">
                            <IconLeft><Icon Name="IconName.RiLinksFill" /></IconLeft>
                            <ChildContent>Link another account</ChildContent>
                        </Button>
                    </div>
                </ContactSection>

                <ContactSection Title="Recent task requests">
                    <Typography TextStyle="TextStyle.Small12Regular" As="p" Class="customer-empty">No task requests yet.</Typography>
                </ContactSection>

                <div class="customer-since">
                    <Icon Name="IconName.RiTimeFill" Size="IconSize.Sm" />
                    <Typography TextStyle="TextStyle.Small10Regular" As="span">
                        Last interaction @Contact.LastInteraction via @ContactCopy.Channel(Contact.LastInteractionChannel)
                    </Typography>
                </div>
            </div>
        </aside>
    </div>
}

@code {
    private static readonly string[] Stages = ["New Lead", "Interested", "Customer", "Vip"];

    [Parameter] public Contact? Contact { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Contact> OnUpdated { get; set; }

    private ElementReference _card;
    private IAsyncDisposable? _trap;
    private bool _wasOpen;
    private string? _copied;

    // Stage editing
    private string _stage = string.Empty;
    private bool _stageSaving;
    private string? _stageError;
    private string? _openPanelMenu;

    // Tag editing
    private List<string> _tags = [];
    private string _newTag = string.Empty;
    private bool _tagsSaving;
    private string? _tagsError;

    private Guid? _loadedId;

    protected override void OnParametersSet()
    {
        if (Contact?.Id != _loadedId)
        {
            _loadedId = Contact?.Id;
            _stage = Contact?.Stage ?? string.Empty;
            _tags = Contact is not null ? [.. Contact.Tags] : [];
            _newTag = string.Empty;
            _copied = null;
            _stageError = null;
            _tagsError = null;
            _openPanelMenu = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool open = Contact is not null;
        if (open && !_wasOpen)
        {
            _wasOpen = true;
            await _card.FocusAsync();
            _trap = await Interop.TrapFocusAsync(_card);
        }
        else if (!open && _wasOpen)
        {
            _wasOpen = false;
            await ReleaseTrapAsync();
        }
    }

    private async Task SelectStageAsync(string stage)
    {
        _openPanelMenu = null;
        if (stage == _stage) return;
        string previous = _stage;
        _stage = stage;
        _stageSaving = true;
        _stageError = null;
        StateHasChanged();
        try
        {
            CustomerDetailDto updated = await CustomerClient.UpdateStageAsync(Contact!.Id, stage, CancellationToken.None);
            await OnUpdated.InvokeAsync(ApplyDetail(Contact, updated));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _stage = previous;
            _stageError = ex.Message;
        }
        finally
        {
            _stageSaving = false;
        }
    }

    private async Task RemoveTagAsync(string tag)
    {
        await SaveTagsAsync([.. _tags.Where(t => t != tag)]);
    }

    private async Task AddTagAsync()
    {
        string tag = _newTag.Trim();
        if (tag.Length == 0 || _tags.Contains(tag, StringComparer.OrdinalIgnoreCase)) return;
        await SaveTagsAsync([.. _tags, tag]);
        if (_tagsError is null) _newTag = string.Empty;
    }

    private async Task SaveTagsAsync(List<string> newTags)
    {
        _tagsSaving = true;
        _tagsError = null;
        StateHasChanged();
        try
        {
            CustomerDetailDto updated = await CustomerClient.UpdateTagsAsync(Contact!.Id, newTags, CancellationToken.None);
            _tags = [.. updated.Tags];
            await OnUpdated.InvokeAsync(ApplyDetail(Contact, updated));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _tagsError = ex.Message;
        }
        finally
        {
            _tagsSaving = false;
        }
    }

    private static Contact ApplyDetail(Contact contact, CustomerDetailDto dto) => new()
    {
        Id = contact.Id,
        Name = dto.Name,
        Email = dto.Email ?? string.Empty,
        Stage = dto.Stage,
        Tags = dto.Tags,
        Identities = contact.Identities,
        HasWhatsApp = contact.HasWhatsApp,
        HasInstagram = contact.HasInstagram,
        WhatsAppNumber = contact.WhatsAppNumber,
        InstagramHandle = contact.InstagramHandle,
        LastInteraction = contact.LastInteraction,
        LastInteractionChannel = contact.LastInteractionChannel,
        OrderCount = contact.OrderCount,
        Orders = contact.Orders,
    };

    private static IconName IdentityIcon(string platform) => platform switch
    {
        "whatsapp" => IconName.RiWhatsappFill,
        "instagram" => IconName.RiInstagramFill,
        "tiktok" => IconName.RiTiktokFill,
        _ => IconName.RiFacebookCircleFill,
    };

    private async Task CopyAsync(string which, string value)
    {
        await Interop.CopyAsync(value);
        _copied = which;
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await OnClose.InvokeAsync();
    }

    private async Task ReleaseTrapAsync()
    {
        if (_trap is null) return;
        IAsyncDisposable trap = _trap;
        _trap = null;
        await trap.DisposeAsync();
    }

    public async ValueTask DisposeAsync() => await ReleaseTrapAsync();
}
