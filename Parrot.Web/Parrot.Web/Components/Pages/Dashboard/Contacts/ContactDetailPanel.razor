@namespace Parrot.Web.Components.Pages.Dashboard.Contacts
@implements IAsyncDisposable
@inject AuroraInterop Interop
@inject Parrot.Web.Services.CustomerClient CustomerClient
@inject NavigationManager Nav
@using System.Globalization
@using Parrot.Web.Services
@using Parrot.Web.Components.Pages.Dashboard.Conversations
@using Parrot.Web.Components.Pages.Dashboard.TaskRequests

@* A customer, in a panel over the list. The frame is Aurora's editor drawer (a card lifted off the right
   edge, focus trapped and returned); the contents are the inbox's customer details, so a customer reads
   the same wherever they are opened: who they are, what's open for them, how to reach them and what they
   have sent, then their conversation one tap away (designer, 27 October 2026). *@

@if (Contact is not null)
{
    <div class="@($"panel-backdrop {(Behind ? "is-behind" : null)}")" @onmousedown="OnClose">
        <aside class="customer-panel"
               aria-label="Customer details"
               tabindex="-1"
               @ref="_card"
               @onkeydown="OnKeyDown"
               @onmousedown:stopPropagation="true">
            <header class="customer-panel__header">
                <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h2">Customer details</Typography>
                <button type="button" aria-label="Close customer details" title="Close customer details" @onclick="OnClose">
                    <Icon Name="IconName.RiCloseFill" Size="IconSize.Sm" />
                </button>
            </header>

            <div class="customer-panel__scroll">
                <section class="customer-profile">
                    <PetalAvatar Seed="@Contact.Id.ToString()" Initials="@Initials.From(Contact.Name)" Size="AvatarSize.Lg" />
                    <Typography TextStyle="TextStyle.HeadingH4Semibold" As="h3">@Contact.Name</Typography>
                    @if (Primary is { } primary)
                    {
                        <div>
                            <ChannelGlyph Channel="@primary.Platform" Compact />
                            <Typography TextStyle="TextStyle.Small12Medium" As="span">@ChannelLinks.PlatformName(primary.Platform)</Typography>
                            @if (ContactCopy.Handle(primary) is { } handle)
                            {
                                <span aria-hidden="true">·</span>
                                <Typography TextStyle="TextStyle.Small12Regular" As="span">@handle</Typography>
                            }
                        </div>
                        @* Their own chat app, one tap away, under who they are rather than as a section of its own. *@
                        @if (ChannelLinks.For(primary.Platform, primary.Sender, null, primary.Username) is { } link)
                        {
                            <a class="customer-profile__platform" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@($"{link.ButtonLabel} (opens in a new tab)")">
                                <Typography TextStyle="TextStyle.Small12Medium" As="span">@link.ButtonLabel</Typography>
                                <Icon Name="IconName.RiArrowRightLine" Size="IconSize.Sm" />
                            </a>
                        }
                    }
                </section>

                <CustomerTasks ConversationIds="Contact.ConversationIds" UnlinkedName="@(Contact.Identities.Count == 0 ? Contact.Name : null)"
                               CustomerName="@Contact.Name" OnAddTask="OnAddTask" />

                <CustomerSection Title="Details">
                    <div class="customer-contact-list">
                        @* Each contact row copies its value; the whole row is intentionally the control. *@
                        @if (Email is { } email)
                        {
                            <RowButton aria-label="@($"Copy email {email}")" OnClick='() => CopyAsync("email", email)'>
                                <Icon Name="IconName.RiMailFill" Size="IconSize.Sm" />
                                <span><small>Email</small><strong>@email</strong></span>
                                <Icon Name="@(_copied == "email" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                            </RowButton>
                        }
                        @if (Phone is { } phone)
                        {
                            <RowButton aria-label="@($"Copy phone {phone}")" OnClick='() => CopyAsync("phone", phone)'>
                                <Icon Name="IconName.RiPhoneFill" Size="IconSize.Sm" />
                                <span><small>Phone</small><strong>@phone</strong></span>
                                <Icon Name="@(_copied == "phone" ? IconName.RiCheckFill : IconName.RiFileCopyFill)" Size="IconSize.Sm" />
                            </RowButton>
                        }
                        <div>
                            <Icon Name="IconName.RiMessage2Fill" Size="IconSize.Sm" />
                            <span><small>Last message</small><strong>@(Contact.LastSeenAt is { } seen ? DateTimeLabel(seen) : "None yet")</strong></span>
                        </div>
                    </div>
                </CustomerSection>

                @if (Primary is { } from)
                {
                    <CustomerMedia ConnectionId="from.ConnectionId" Sender="@from.Sender" CustomerName="@Contact.Name"
                                   Seed="@Contact.Id.ToString()" Initials="@Initials.From(Contact.Name)" OnPreview="OnPreview" />
                }
            </div>

            @if (Primary is { } conversation)
            {
                <footer class="customer-panel__footer">
                    <Button @onclick="() => OpenConversation(conversation)">
                        <IconLeft><Icon Name="IconName.RiMessage2Fill" /></IconLeft>
                        <ChildContent>Open conversation</ChildContent>
                    </Button>
                </footer>
            }
        </aside>
    </div>
}

@code {
    [Parameter] public Contact? Contact { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Add a task for this customer: the page opens its own form, over the whole app rather than inside this panel.</summary>
    [Parameter] public EventCallback OnAddTask { get; set; }

    /// <summary>A picture was chosen: the page opens it full screen, outside this scrolling panel.</summary>
    [Parameter] public EventCallback<MediaViewerItem> OnPreview { get; set; }

    /// <summary>A dialog is open over it (a new task): the panel steps under it.</summary>
    [Parameter] public bool Behind { get; set; }

    private ElementReference _card;
    private IAsyncDisposable? _trap;
    private bool _wasOpen;
    private string? _copied;

    // The list carries no email or phone; they are read when the panel opens.
    private CustomerDetailDto? _detail;
    private Guid? _loadedId;

    private ContactIdentity? Primary => Contact?.Primary;
    private string? Email => _detail?.Email is { Length: > 0 } email ? email : null;
    // WhatsApp's sender is the customer's number; on TikTok and Facebook it is an opaque id, not a phone.
    private string? Phone => _detail?.Phone is { Length: > 0 } phone ? phone
        : Contact?.Identities.FirstOrDefault(identity => identity.Platform == "whatsapp") is { } whatsapp ? ContactCopy.Handle(whatsapp) : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Contact?.Id == _loadedId) return;
        _loadedId = Contact?.Id;
        _detail = null;
        _copied = null;
        if (Contact is not { } contact) return;
        try
        {
            var detail = await CustomerClient.GetAsync(contact.Id, CancellationToken.None);
            if (_loadedId == contact.Id) _detail = detail;
        }
        // The details are a nicety: without them the panel still shows the rest.
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool open = Contact is not null;
        if (open && !_wasOpen)
        {
            _wasOpen = true;
            await _card.FocusAsync();
            _trap = await Interop.TrapFocusAsync(_card);
        }
        else if (!open && _wasOpen)
        {
            _wasOpen = false;
            await ReleaseTrapAsync();
        }
    }

    private void OpenConversation(ContactIdentity identity) =>
        Nav.NavigateTo($"/dashboard/conversations/{Uri.EscapeDataString($"{identity.ConnectionId}:{identity.Sender}")}");

    private async Task CopyAsync(string field, string value)
    {
        await Interop.CopyAsync(value);
        _copied = field;
        await Task.Delay(1400);
        if (_copied == field) _copied = null;
    }

    private static string DateTimeLabel(DateTime date) => date.ToLocalTime().ToString("d MMM yyyy, h:mm tt", CultureInfo.InvariantCulture);

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !Behind) await OnClose.InvokeAsync();
    }

    private async Task ReleaseTrapAsync()
    {
        if (_trap is null) return;
        IAsyncDisposable trap = _trap;
        _trap = null;
        await trap.DisposeAsync();
    }

    public async ValueTask DisposeAsync() => await ReleaseTrapAsync();
}
