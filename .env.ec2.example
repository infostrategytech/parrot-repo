# Settings for docker-compose.ec2.yml. Copy to .env on the server and fill in
# every value; compose refuses to start while a required one is missing.
# Generate each secret with:  openssl rand -hex 32
# (hex only: a ';' or a space in a password would break a connection string).

# ---- Where the app is served ------------------------------------------------
# Three DNS names, each with an A record pointing at this server.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
GRPC_DOMAIN=grpc.example.com
# https needs the certificate described at the top of docker-compose.ec2.yml.
# http serves the same routes with no TLS, for a first smoke test only.
PUBLIC_SCHEME=https

# ---- Secrets ----------------------------------------------------------------
# Used when the database volume is first created. On a server that already has
# data, this must be the password that database was created with.
POSTGRES_PASSWORD=
# Signs every session token. 32 characters or more.
JWT_SECRET=
MINIO_ROOT_USER=parrot
MINIO_ROOT_PASSWORD=
# The catalog service's database roles, created on first start.
CATALOG_MIGRATOR_PASSWORD=
CATALOG_WRITER_PASSWORD=
CATALOG_READER_PASSWORD=
CATALOG_RELAY_PASSWORD=

# The certificate that encrypts stored WhatsApp and Facebook credentials. Keep
# it outside the checkout, and keep using the same file for the life of the
# data. To make one:
#   sudo mkdir -p /etc/parrot && cd /etc/parrot
#   sudo openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
#     -subj "/CN=parrot-data-protection" -keyout dp.key -out dp.crt
#   sudo openssl pkcs12 -export -inkey dp.key -in dp.crt \
#     -out data-protection.pfx -passout pass:THE_PASSWORD_BELOW
#   sudo rm dp.key dp.crt && sudo chmod 644 data-protection.pfx
DATA_PROTECTION_CERTIFICATE_FILE=/etc/parrot/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# ---- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Parrot
# Only the default: the FeatureFlags row RequireEmailVerification (seeded on, at
# startup) decides. false lets people sign up without confirming their address,
# for a deployment whose SMTP settings above cannot deliver mail.
REQUIRE_EMAIL_VERIFICATION=true

# ---- Integrations (each may stay empty until it is used) --------------------
# Google sign-in. Authorised redirect URI: https://<API_DOMAIN>/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta. The webhook URLs the app shows are built from API_DOMAIN.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
# Business profile enrichment.
ANTHROPIC_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# The AI orchestrator (Omni-AI). It shares JWT_SECRET with the API and reads
# the stack's Kafka. Off: agents are saved as drafts and never answer.
OMNI_AI_ENABLED=false
OMNI_AI_BASE_URL=http://omni-ai:8000

# ---- Optional ---------------------------------------------------------------
# Image uploads go to the bundled MinIO unless these point at a real S3 bucket.
# For Amazon S3 set STORAGE_SERVICE_URL to empty (the line present, no value).
#STORAGE_SERVICE_URL=
#STORAGE_BUCKET=my-bucket
#STORAGE_REGION=us-east-1
#STORAGE_PUBLIC_BASE_URL=https://my-bucket.s3.us-east-1.amazonaws.com
#STORAGE_ACCESS_KEY=
#STORAGE_SECRET_KEY=
# Customers' pictures and files go to a second bucket that must never be public.
#STORAGE_MEDIA_BUCKET=my-bucket-private
# Copy customers' files in the background (messages.media) instead of before the message is stored.
# Leave off until the inbox refreshes a thread when a file finishes loading.
#DEFER_INBOUND_MEDIA=false
# Send agents' pictures and files in the background (messages.outbound) instead of before the request answers.
#DEFER_FILE_SENDS=false

# Memory caps for the two hungriest stores; raise them on a larger instance.
#MONGO_CACHE_GB=0.5
#KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
