# Copy this file to .env.docker and change the values if desired.
# docker-compose.local.yml has development defaults, so this file is optional.
POSTGRES_PASSWORD=parrot_dev_password
JWT_SECRET=parrot-local-development-secret-change-me

# Set a public HTTPS API/tunnel URL when configuring the webhook in Meta.
WHATSAPP_WEBHOOK_BASE_URL=http://localhost:5222
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret

# Real credentials are needed only to exercise Google sign-in.
GOOGLE_CLIENT_ID=local-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-placeholder

# Save each connection's WhatsApp access token and account IDs in the Channels setup page.
