@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<PageTitle>Not found · OmniAI</PageTitle>

<div class="not-found">
    <EmptyState Glyph="IconName.RiSearchEyeFill"
                Title="That page is not here"
                Description="The link may be from an older version of the app, or the item may have been removed.">
        <Action>
            <Button Variant="ButtonVariant.Secondary" @onclick="@(() => Nav.NavigateTo("/dashboard/conversations"))">
                Go to the inbox
            </Button>
        </Action>
    </EmptyState>
</div>
